 CellLabel->"In[3]:=",
 CellID->226833854,ExpressionUUID->"7dfa98e9-05e5-472f-9898-26df08dd41c4"],

Cell["This constructs a modified Qi-Wu-Zhang model", "ExampleText",
 CellChangeTimes->{{3.8488937732707853`*^9, 3.848893786635746*^9}, {
  3.848893838258828*^9, 3.8488938475716667`*^9}, {3.848894817709978*^9, 
  3.8488948360699005`*^9}},
 CellID->129563622,ExpressionUUID->"897a5f1c-5bc0-4758-80de-fea81208e9f2"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "HQWZ", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"HQWZ", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"kx_", ",", "ky_"}], "}"}], ",", 
    RowBox[{"{", "M_", "}"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sin", "[", "kx", "]"}], ",", 
     RowBox[{"Sin", "[", "ky", "]"}], ",", 
     RowBox[{"M", "-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Cos", "[", "kx", "]"}], "+", 
        RowBox[{"Cos", "[", "ky", "]"}]}], ")"}]}]}], "}"}], ".", 
   RowBox[{"PauliMatrix", "[", 
    RowBox[{"Range", "[", "3", "]"}], "]"}]}]}]}], "Input",
 CellChangeTimes->{{3.8488937895920935`*^9, 3.8488938197245607`*^9}, {
  3.848893853022169*^9, 3.848893929941546*^9}, {3.8488939667499905`*^9, 
  3.848893970764954*^9}, {3.8488942275662575`*^9, 3.8488943168381057`*^9}, {
  3.848894803981759*^9, 3.848894809678508*^9}, {3.848894844289544*^9, 
  3.8488948482786674`*^9}},
 CellLabel->"In[45]:=",
 CellID->532933989,ExpressionUUID->"4fe38875-dd4f-4252-a4dc-4a784adb4221"],

Cell[TextData[{
 "This evaluates the Berry curvature of the model above with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["M",
    FontSlant->"Italic"], "=", 
   RowBox[{"-", "1"}]}]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "1d67e6d7-ee1b-4b6c-8133-82d22bc3ac96"],
 " at the \[CapitalGamma] point and with one band occupied (",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n",
     FontSlant->"Italic"], "F"], "=", "1"}]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "f11c132d-b78c-4fcd-ac16-07d4b98e580e"],
 ")"
}], "ExampleText",
 CellChangeTimes->{{3.8488949256782436`*^9, 3.8488950020857353`*^9}, {
  3.848895594789983*^9, 3.848895604904991*^9}},
 CellID->32212198,ExpressionUUID->"cb377ca2-c450-4e9b-b57b-60f191a21392"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"M", ",", "nF", ",", "\[CapitalOmega]"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"M", ",", "nF"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalOmega]", "[", "vk_", "]"}], ":=", 
  RowBox[{"BerryCurvature", "[", 
   RowBox[{"vk", ",", 
    RowBox[{
     RowBox[{"HQWZ", "[", 
      RowBox[{"#", ",", 
       RowBox[{"{", "M", "}"}]}], "]"}], "&"}], ",", "nF"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"\[CapitalOmega]", "[", 
  RowBox[{"{", 
   RowBox[{".0", ",", ".0"}], "}"}], "]"}]}], "Input",
 CellChangeTimes->{{3.8488939945770288`*^9, 3.848894043909783*^9}, 
   3.848894104431424*^9, {3.848894345942481*^9, 3.8488943515024924`*^9}, {
   3.8488947871494684`*^9, 3.8488947922383194`*^9}, {3.8488948941982255`*^9, 
   3.8488949143833556`*^9}, {3.848895007295065*^9, 3.848895023417175*^9}, {
   3.848895193543301*^9, 3.8488952209019823`*^9}},
 CellLabel->"In[56]:=",
 CellID->771853870,ExpressionUUID->"1669af5f-6b55-461f-8e7b-b17606f6ca88"],

Cell[BoxData[
 RowBox[{"-", "0.05555555555555536`"}]], "Output",
 CellChangeTimes->{3.8488940444354167`*^9, 3.8488941075551615`*^9, 
  3.8488943524896107`*^9, 3.848894792780263*^9, 3.8488949151403537`*^9, 
  3.8488950245032434`*^9, 3.848895221305981*^9},
 CellLabel->"Out[59]=",
 CellID->18576078,ExpressionUUID->"93492339-640c-4aac-8ab2-cc0f5c3c51cf"]
}, Open  ]],

Cell[TextData[{
 "We know that the above state is a Chern insulator with a Chern number ",
 Cell[BoxData[
  RowBox[{"\[ScriptCapitalC]", "=", "1"}]], "InlineFormula",ExpressionUUID->
  "a9dcdf50-149b-4564-865e-079dd390aeb1"],
 ", and codes below approximates the corresponding result"
}], "ExampleText",
 CellChangeTimes->{{3.848895033397382*^9, 3.8488951134780607`*^9}, {
  3.8488983368177214`*^9, 3.8488983383692474`*^9}},
 CellID->685608477,ExpressionUUID->"44021321-5465-4565-86cd-10765d797b71"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nmesh", "=", "500"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vkmesh", "=", 
   RowBox[{"Tuples", "[", 
    RowBox[{
     RowBox[{"Subdivide", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1."}], "\[Pi]"}], ",", "\[Pi]", ",", "nmesh"}], "]"}], 
     ",", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalOmega]data", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"Append", "[", 
      RowBox[{"vk", ",", 
       RowBox[{"\[CapitalOmega]", "[", "vk", "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"vk", ",", "vkmesh"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot3D", "[", "\[CapitalOmega]data", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  FractionBox["1", 
   RowBox[{"2", "\[Pi]"}]], 
  SuperscriptBox[
   RowBox[{"(", 
    FractionBox[
     RowBox[{"2", "\[Pi]"}], 
     RowBox[{"nmesh", "+", "1"}]], ")"}], "2"], 
  RowBox[{"Total", "[", 
   RowBox[{"\[CapitalOmega]data", "\[LeftDoubleBracket]", 
    RowBox[{";;", ",", "3"}], "\[RightDoubleBracket]"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.84889412424214*^9, 3.8488941937105885`*^9}, {
  3.848894357877348*^9, 3.84889441163758*^9}, {3.8488944982296057`*^9, 
  3.848894540501956*^9}, {3.8488946432938695`*^9, 3.8488946454299717`*^9}, {
  3.8488946799177313`*^9, 3.848894701686273*^9}, {3.8488947416864185`*^9, 
  3.848894782102495*^9}, {3.848894880830982*^9, 3.8488948838621864`*^9}, {
  3.848895175745426*^9, 3.848895187806005*^9}, {3.8488952318381376`*^9, 
  3.848895232589952*^9}, {3.8488982901701736`*^9, 3.848898385218398*^9}},
 CellLabel->"In[11]:=",
 CellID->155520695,ExpressionUUID->"8652f40b-95cd-44eb-a5c3-5a80035fb14a"],

