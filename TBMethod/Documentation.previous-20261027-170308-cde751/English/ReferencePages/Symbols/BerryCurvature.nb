Cell[CellGroupData[{

Cell["BerryCurvature", "ObjectName",
 CellID->104750138,ExpressionUUID->"d0829a54-df7d-42bc-a8ad-d57e0bda5ab0"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6b9b6543-f432-4b10-824a-38250cf04c31"],
 Cell[BoxData[
  RowBox[{"BerryCurvature", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox[
       SubscriptBox["k", "x"],
       FontSlant->"Italic"], ",", " ", 
      StyleBox[
       SubscriptBox["k", "y"],
       FontSlant->"Italic"]}], "}"}], ",", " ", 
    StyleBox["H",
     FontSlant->"Italic"], ",", " ", 
    SubscriptBox[
     StyleBox["n",
      FontSlant->"Italic"], "F"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "350963c7-8e78-4d63-bf02-d43443ea170b"],
 " calculates the Berry curvature ",
 Cell[BoxData[
  StyleBox["\[CapitalOmega]",
   FontSlant->"Italic"]], "InlineFormula",ExpressionUUID->
  "c651998f-809c-4c3b-b4da-d28a19045c0b"],
 " for a (at least locally) gapped Bloch Hamiltonian ",
 Cell[BoxData[
  StyleBox["H",
   FontSlant->"Italic"]], "InlineFormula",ExpressionUUID->
  "4e7815b6-05c7-4bf8-84e3-1985a93ddc88"],
 " at the lattice momentum point ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox[
     SubscriptBox["k", "x"],
     FontSlant->"Italic"], ",", 
    StyleBox[
     SubscriptBox["k", "y"],
     FontSlant->"Italic"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "804d942a-9690-43ea-8d2f-0ddb6376e89d"],
 " in the first Brillouin zone, with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n",
    FontSlant->"Italic"], "F"]], "InlineFormula",ExpressionUUID->
  "aaceda69-1053-4496-bb09-90dd74af7ff4"],
 " states occupied."
}], "Usage",
 CellChangeTimes->{{3.84889356242402*^9, 3.8488935715713778`*^9}},
 CellID->40067621,ExpressionUUID->"d51ffeee-8781-46a4-b2de-8e6852ac5fcc"],

Cell[TextData[{
 "The Bloch Hamiltonian is a map ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["H",
     FontSlant->"Italic"], 
    StyleBox[":",
     FontSlant->"Plain"], 
    StyleBox[" ",
     FontSlant->"Plain"], 
    SuperscriptBox[
     StyleBox[
      TemplateBox[{},
       "Reals"],
      FontSlant->"Plain"], "2"]}], "\[Rule]", " ", 
   SuperscriptBox[
    FormBox[
     TemplateBox[{},
      "Complexes"],
     TraditionalForm], 
    RowBox[{
     StyleBox["n",
      FontSlant->"Italic"], " ", "\[Times]", " ", 
     StyleBox["n",
      FontSlant->"Italic"]}]]}]], "InlineFormula",ExpressionUUID->
  "f7ef3a6b-41c4-41e7-8777-d7b95832637a"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n",
    FontSlant->"Italic"], 
   StyleBox["\[Element]",
    FontSlant->"Plain"], 
   SuperscriptBox[
    StyleBox["\[DoubleStruckCapitalZ]",
     FontSlant->"Plain"], "+"]}]], "InlineFormula",ExpressionUUID->
  "3dd87052-e76b-472c-bfd5-d475a22fa136"],
 " is the band number."
}], "Notes",
 CellChangeTimes->{
  3.8488935811531334`*^9, {3.84889551839277*^9, 3.848895566928236*^9}},
 CellID->221447166,ExpressionUUID->"c4288469-22bb-4bd2-a769-3dff1cf5edd3"]
}, Open  ]],

