Cell["\<\
The first association entry is the onsite block and receives no phase factor. \
Supply one representative of each reverse-hopping pair among the remaining \
entries.\
\>", "Notes",
 CellID->456590038,ExpressionUUID->"65d13da2-bafc-b546-b225-611c2ae9eafb"],

Cell["\<\
The phase convention uses the negative displacement\[Dash]momentum dot \
product. Hermitian-conjugate reverse hoppings are added automatically, as \
shown in the formula below.\
\>", "Notes",
 CellID->1734975772,ExpressionUUID->"8bd27872-78dd-794e-ada7-cd24988affd0"],

Cell[TextData[{
 "With one orientation supplied for each nonzero displacement, the convention \
is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"H", "(", "k", ")"}], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["H", "0"], "+", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", "1"}], "M"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"exp", "(", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", 
            RowBox[{
             SubscriptBox["R", "j"], ".", "k"}]}], ")"}], " ", 
          SubscriptBox["H", 
           SubscriptBox["R", "j"]]}], "+", 
         RowBox[{
          RowBox[{"exp", "(", 
           RowBox[{"\[ImaginaryI]", " ", 
            RowBox[{
             SubscriptBox["R", "j"], ".", "k"}]}], ")"}], " ", 
          TemplateBox[{
            RowBox[{"(", 
              SubscriptBox["H", 
               SubscriptBox["R", "j"]], ")"}]},
           "ConjugateTranspose"]}]}], ")"}]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "a5e0d170-726b-104c-810b-b9c8e39b764c"]
}], "Notes",
 CellID->436546904,ExpressionUUID->"7dba557c-83f3-1e4f-9d75-a14848730eec"]
}, Closed]],

