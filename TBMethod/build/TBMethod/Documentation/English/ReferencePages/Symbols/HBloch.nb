Cell["\<\
The first association entry is the onsite block and receives no phase factor. \
Supply one representative of each reverse-hopping pair among the remaining \
entries.\
\>", "Notes",
 CellID->833778179,ExpressionUUID->"63d8ff8a-d722-744d-883c-92a58089282e"],

Cell["\<\
The phase convention uses the negative displacement\[Dash]momentum dot \
product. Hermitian-conjugate reverse hoppings are added automatically, as \
shown in the formula below.\
\>", "Notes",
 CellID->1309970293,ExpressionUUID->"c9bccc33-14cc-9a4e-b8f6-f05d52560513"],

Cell[TextData[{
 "With one orientation supplied for each nonzero displacement, the convention \
is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"H", "(", "k", ")"}], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["H", "0"], "+", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", "1"}], "M"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"exp", "(", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", 
            RowBox[{
             SubscriptBox["R", "j"], ".", "k"}]}], ")"}], " ", 
          SubscriptBox["H", 
           SubscriptBox["R", "j"]]}], "+", 
         RowBox[{
          RowBox[{"exp", "(", 
           RowBox[{"\[ImaginaryI]", " ", 
            RowBox[{
             SubscriptBox["R", "j"], ".", "k"}]}], ")"}], " ", 
          TemplateBox[{
            RowBox[{"(", 
              SubscriptBox["H", 
               SubscriptBox["R", "j"]], ")"}]},
           "ConjugateTranspose"]}]}], ")"}]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "2e6a29aa-a445-b048-9a40-7a28118c538c"]
}], "Notes",
 CellID->1669970690,ExpressionUUID->"d11f1d0c-3d66-b742-8917-407a84ba4cd1"]
}, Closed]],

