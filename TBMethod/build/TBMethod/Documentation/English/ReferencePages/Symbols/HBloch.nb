Cell[TextData[{
 Cell[BoxData[
  RowBox[{"HBloch", "[", 
   RowBox[{
    StyleBox["k",
     FontWeight->"Bold",
     FontSlant->"Italic"], ",", " ", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{
       SubscriptBox[
        StyleBox["a",
         FontWeight->"Bold",
         FontSlant->"Italic"], "0"], "\[Rule]", 
       SubscriptBox[
        StyleBox["h",
         FontSlant->"Italic"], "00"]}], ",", 
      RowBox[{
       SubscriptBox[
        StyleBox["a",
         FontWeight->"Bold",
         FontSlant->"Italic"], "1"], "\[Rule]", 
       SubscriptBox[
        StyleBox["h",
         FontSlant->"Italic"], "10"]}], ",", "...", ",", 
      RowBox[{
       SubscriptBox[
        StyleBox["a",
         FontWeight->"Bold",
         FontSlant->"Italic"], 
        StyleBox["i",
         FontSlant->"Italic"]], "\[Rule]", 
       SubscriptBox[
        StyleBox["h",
         FontSlant->"Italic"], 
        StyleBox[
         RowBox[{
          StyleBox["i",
           FontSlant->"Italic"], "0"}]]]}], ",", "..."}], 
     "\[RightAssociation]"}]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a23cf544-771d-9f43-9e9f-80d993ae838f"],
 " constructs the reciprocal-space Bloch Hamiltonian matrix."
}], "ExampleText",
 CellID->153566697,ExpressionUUID->"528d79ab-fd2c-6e4e-baa1-4b00df396379"],

Cell[TextData[{
 "Vector ",
 Cell[BoxData[
  StyleBox["k",
   FontWeight->"Bold",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "818a9e41-3419-c045-ad07-e71c17db27cd"],
 " has the same dimension as those of lattice vectors ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a",
    FontWeight->"Bold",
    FontSlant->"Italic"], "i"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9361c3dc-5156-4443-a3b2-a7473d33022e"],
 "s."
}], "ExampleText",
 CellID->80053754,ExpressionUUID->"3470f0b4-2722-4346-8406-46a7c249dcca"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a",
     FontWeight->"Bold",
     FontSlant->"Italic"], "0"], "=", 
   StyleBox["0",
    FontWeight->"Bold"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2a10e6f5-f2a2-8248-970d-2edca01fbba8"],
 " is the zero vector, and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["h",
    FontSlant->"Italic"], "00"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c7f247a8-ba00-3743-9f73-3948c7200284"],
 " is the Hermitian intra-primitive-cell hopping matrix."
}], "ExampleText",
 CellID->35926267,ExpressionUUID->"3c7dd378-8154-e949-a9dd-f9049cb79079"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a",
     FontWeight->"Bold",
     FontSlant->"Italic"], 
    StyleBox["i",
     FontSlant->"Italic"]], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["i",
      FontSlant->"Italic"], "\[NotEqual]", "0"}], ")"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cc7804fc-d4de-4345-8e98-dee72920586f"],
 "s are the corresponding lattice vectors for neighbor cells, and the \
inter-cell hopping matrices ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["h",
    FontSlant->"Italic"], 
   StyleBox[
    RowBox[{
     StyleBox["i",
      FontSlant->"Italic"], "0"}]]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4f8e0cac-4914-2449-8953-68397ca4b4fa"],
 "s are usually non-Hermitian."
}], "ExampleText",
 CellID->71249355,ExpressionUUID->"aee4ae67-8062-0742-b636-1e2ae3ad093a"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a",
     FontWeight->"Bold",
     FontSlant->"Italic"], 
    StyleBox["i",
     FontSlant->"Italic"]], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["i",
      FontSlant->"Italic"], "\[NotEqual]", "0"}], ")"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0febb9b6-3ee1-0848-978f-9b919e5c4e8d"],
 "s can be divide into two groups so that for any ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a",
    FontWeight->"Bold",
    FontSlant->"Italic"], 
   StyleBox["i",
    FontSlant->"Italic"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "61a05bf2-c983-ba4c-964a-7b775025aa55"],
 " in one group, its addition inverse ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a",
     FontWeight->"Bold",
     FontSlant->"Italic"], 
    RowBox[{
     StyleBox["i",
      FontSlant->"Italic"], "'"}]], "=", 
   RowBox[{"-", 
    SubscriptBox[
     StyleBox["a",
      FontWeight->"Bold",
      FontSlant->"Italic"], 
     StyleBox["i",
      FontSlant->"Italic"]]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f5c00063-14d4-1e4d-8729-7da9b8a27ab8"],
 " is in the other group. And for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HBloch"]], "paclet:TBMethod/ref/HBloch", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d4187be7-ea4c-0146-9bc2-e63ad8539cae"],
 " only one of those two groups of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a",
    FontWeight->"Bold",
    FontSlant->"Italic"], 
   StyleBox["i",
    FontSlant->"Italic"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ef38ab7b-d2e9-be45-bb32-a43a432e1982"],
 "s should be included, because the constituents for the inverse vectors are \
to be automatically taken care of by ",
 ButtonBox["ConjugateTranspose",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/ConjugateTranspose"],
 "."
}], "ExampleText",
 CellID->64487330,ExpressionUUID->"c1ffd6e7-142c-c943-9e00-25707d5ee572"]
}, Closed]]
}, Open  ]],

