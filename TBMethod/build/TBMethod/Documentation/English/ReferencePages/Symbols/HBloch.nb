Cell["\<\
The first association entry is the onsite block and receives no phase factor. \
Supply one representative of each reverse-hopping pair among the remaining \
entries.\
\>", "Notes",
 CellID->833778179,ExpressionUUID->"243d1c94-7e93-1c4f-9e73-abb28a7074f5"],

Cell["\<\
The phase convention uses the negative displacement\[Dash]momentum dot \
product. Hermitian-conjugate reverse hoppings are added automatically, as \
shown in the formula below.\
\>", "Notes",
 CellID->1309970293,ExpressionUUID->"a8b4a1cb-88de-334c-8691-dcfb726ec018"],

Cell[TextData[{
 "With one orientation supplied for each nonzero displacement, the convention \
is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"H", "(", "k", ")"}], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["H", "0"], "+", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", "1"}], "M"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"exp", "(", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", 
            RowBox[{
             SubscriptBox["R", "j"], ".", "k"}]}], ")"}], " ", 
          SubscriptBox["H", 
           SubscriptBox["R", "j"]]}], "+", 
         RowBox[{
          RowBox[{"exp", "(", 
           RowBox[{"\[ImaginaryI]", " ", 
            RowBox[{
             SubscriptBox["R", "j"], ".", "k"}]}], ")"}], " ", 
          TemplateBox[{
            RowBox[{"(", 
              SubscriptBox["H", 
               SubscriptBox["R", "j"]], ")"}]},
           "ConjugateTranspose"]}]}], ")"}]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "13904051-36d3-004f-b87b-b362bbeb00d8"]
}], "Notes",
 CellID->1669970690,ExpressionUUID->"270b4246-248d-c549-b17b-2b96953e6d77"]
}, Closed]],

