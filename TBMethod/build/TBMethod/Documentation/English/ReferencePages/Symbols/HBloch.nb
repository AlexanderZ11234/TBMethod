Cell[TextData[{
 Cell[BoxData[
  RowBox[{"HBloch", "[", 
   RowBox[{
    StyleBox["k",
     FontWeight->"Bold",
     FontSlant->"Italic"], ",", " ", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{
       SubscriptBox[
        StyleBox["a",
         FontWeight->"Bold",
         FontSlant->"Italic"], "0"], "\[Rule]", 
       SubscriptBox[
        StyleBox["h",
         FontSlant->"Italic"], "00"]}], ",", 
      RowBox[{
       SubscriptBox[
        StyleBox["a",
         FontWeight->"Bold",
         FontSlant->"Italic"], "1"], "\[Rule]", 
       SubscriptBox[
        StyleBox["h",
         FontSlant->"Italic"], "10"]}], ",", "...", ",", 
      RowBox[{
       SubscriptBox[
        StyleBox["a",
         FontWeight->"Bold",
         FontSlant->"Italic"], 
        StyleBox["i",
         FontSlant->"Italic"]], "\[Rule]", 
       SubscriptBox[
        StyleBox["h",
         FontSlant->"Italic"], 
        StyleBox[
         RowBox[{
          StyleBox["i",
           FontSlant->"Italic"], "0"}]]]}], ",", "..."}], 
     "\[RightAssociation]"}]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8a4f0a9b-db7a-7a45-8857-0eefdd77ce7c"],
 " constructs the reciprocal-space Bloch Hamiltonian matrix."
}], "ExampleText",
 CellID->153566697,ExpressionUUID->"d3c6d0f5-a336-494f-aad1-ecd38c14fd7a"],

Cell[TextData[{
 "Vector ",
 Cell[BoxData[
  StyleBox["k",
   FontWeight->"Bold",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "10ea8a04-1e0f-a54e-bf01-5f7a5858a2ff"],
 " has the same dimension as those of lattice vectors ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a",
    FontWeight->"Bold",
    FontSlant->"Italic"], "i"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6ad559a5-f965-6945-8910-d124f39489dd"],
 "s."
}], "ExampleText",
 CellID->80053754,ExpressionUUID->"00a221f9-e9b4-914a-8c9c-367837ee7965"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a",
     FontWeight->"Bold",
     FontSlant->"Italic"], "0"], "=", 
   StyleBox["0",
    FontWeight->"Bold"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d87904dd-d863-9048-9a0e-00d4c8b480f4"],
 " is the zero vector, and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["h",
    FontSlant->"Italic"], "00"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bc4c7886-82e0-2846-91b1-3ca4da212226"],
 " is the Hermitian intra-primitive-cell hopping matrix."
}], "ExampleText",
 CellID->35926267,ExpressionUUID->"b1b8692e-7a8c-9b47-927d-7aace2dad5cc"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a",
     FontWeight->"Bold",
     FontSlant->"Italic"], 
    StyleBox["i",
     FontSlant->"Italic"]], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["i",
      FontSlant->"Italic"], "\[NotEqual]", "0"}], ")"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5a580c8a-6ab8-2b47-bd54-62f2145816d6"],
 "s are the corresponding lattice vectors for neighbor cells, and the \
inter-cell hopping matrices ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["h",
    FontSlant->"Italic"], 
   StyleBox[
    RowBox[{
     StyleBox["i",
      FontSlant->"Italic"], "0"}]]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "08562ef3-6673-dc44-8d1c-bbe856207468"],
 "s are usually non-Hermitian."
}], "ExampleText",
 CellID->71249355,ExpressionUUID->"a5348692-17f6-3b45-b9b8-1f59fda74969"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a",
     FontWeight->"Bold",
     FontSlant->"Italic"], 
    StyleBox["i",
     FontSlant->"Italic"]], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["i",
      FontSlant->"Italic"], "\[NotEqual]", "0"}], ")"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a3671630-fc16-2543-81f8-565d43400fe1"],
 "s can be divide into two groups so that for any ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a",
    FontWeight->"Bold",
    FontSlant->"Italic"], 
   StyleBox["i",
    FontSlant->"Italic"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "34f87fce-df8c-6949-ba75-7fbeff0d2f3b"],
 " in one group, its addition inverse ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a",
     FontWeight->"Bold",
     FontSlant->"Italic"], 
    RowBox[{
     StyleBox["i",
      FontSlant->"Italic"], "'"}]], "=", 
   RowBox[{"-", 
    SubscriptBox[
     StyleBox["a",
      FontWeight->"Bold",
      FontSlant->"Italic"], 
     StyleBox["i",
      FontSlant->"Italic"]]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "218a575a-a5e3-0046-b000-7e6df4c97b2c"],
 " is in the other group. And for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HBloch"]], "paclet:TBMethod/ref/HBloch", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ad37a9e9-8735-bb41-b0ac-2a586e9f34eb"],
 " only one of those two groups of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a",
    FontWeight->"Bold",
    FontSlant->"Italic"], 
   StyleBox["i",
    FontSlant->"Italic"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6629eb29-47f9-ca49-b23e-e37d1c586126"],
 "s should be included, because the constituents for the inverse vectors are \
to be automatically taken care of by ",
 ButtonBox["ConjugateTranspose",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/ConjugateTranspose"],
 "."
}], "ExampleText",
 CellID->64487330,ExpressionUUID->"6d49f980-5039-0c4f-8b67-6ed099d068ea"]
}, Closed]]
}, Open  ]],

