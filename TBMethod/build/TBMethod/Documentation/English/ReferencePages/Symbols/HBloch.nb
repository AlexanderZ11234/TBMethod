Cell[TextData[{
 Cell[BoxData[
  RowBox[{"HBloch", "[", 
   RowBox[{
    StyleBox["k",
     FontWeight->"Bold",
     FontSlant->"Italic"], ",", " ", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{
       SubscriptBox[
        StyleBox["a",
         FontWeight->"Bold",
         FontSlant->"Italic"], "0"], "\[Rule]", 
       SubscriptBox[
        StyleBox["h",
         FontSlant->"Italic"], "00"]}], ",", 
      RowBox[{
       SubscriptBox[
        StyleBox["a",
         FontWeight->"Bold",
         FontSlant->"Italic"], "1"], "\[Rule]", 
       SubscriptBox[
        StyleBox["h",
         FontSlant->"Italic"], "10"]}], ",", "...", ",", 
      RowBox[{
       SubscriptBox[
        StyleBox["a",
         FontWeight->"Bold",
         FontSlant->"Italic"], 
        StyleBox["i",
         FontSlant->"Italic"]], "\[Rule]", 
       SubscriptBox[
        StyleBox["h",
         FontSlant->"Italic"], 
        StyleBox[
         RowBox[{
          StyleBox["i",
           FontSlant->"Italic"], "0"}]]]}], ",", "..."}], 
     "\[RightAssociation]"}]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c526d183-cbf4-bf40-96e2-e8a1c9332f9c"],
 " constructs the reciprocal-space Bloch Hamiltonian matrix."
}], "ExampleText",
 CellID->153566697,ExpressionUUID->"c5d7178b-d494-3f49-b1bf-387276c3bd59"],

Cell[TextData[{
 "Vector ",
 Cell[BoxData[
  StyleBox["k",
   FontWeight->"Bold",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a3fec9bc-16d4-0c4c-bc5c-f9de38a75584"],
 " has the same dimension as those of lattice vectors ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a",
    FontWeight->"Bold",
    FontSlant->"Italic"], "i"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "94bc12d3-676b-ae4a-8e23-ac6f5c2c7f1e"],
 "s."
}], "ExampleText",
 CellID->80053754,ExpressionUUID->"f47d3dd3-716e-ac41-bc0f-bf1eb23717f6"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a",
     FontWeight->"Bold",
     FontSlant->"Italic"], "0"], "=", 
   StyleBox["0",
    FontWeight->"Bold"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "745999f3-2fce-5844-a404-f4089cf38eb7"],
 " is the zero vector, and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["h",
    FontSlant->"Italic"], "00"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "999b913f-a9f2-114f-b144-70923f43a3a3"],
 " is the Hermitian intra-primitive-cell hopping matrix."
}], "ExampleText",
 CellID->35926267,ExpressionUUID->"11982e99-98d3-b548-b2c9-10b80c414283"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a",
     FontWeight->"Bold",
     FontSlant->"Italic"], 
    StyleBox["i",
     FontSlant->"Italic"]], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["i",
      FontSlant->"Italic"], "\[NotEqual]", "0"}], ")"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "94e95cd8-679c-b44f-9cd8-5524f87ff2ea"],
 "s are the corresponding lattice vectors for neighbor cells, and the \
inter-cell hopping matrices ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["h",
    FontSlant->"Italic"], 
   StyleBox[
    RowBox[{
     StyleBox["i",
      FontSlant->"Italic"], "0"}]]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "145dd226-a97e-684a-aaee-398dc124228c"],
 "s are usually non-Hermitian."
}], "ExampleText",
 CellID->71249355,ExpressionUUID->"57752208-5a39-2d4a-b774-110356a9218c"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a",
     FontWeight->"Bold",
     FontSlant->"Italic"], 
    StyleBox["i",
     FontSlant->"Italic"]], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["i",
      FontSlant->"Italic"], "\[NotEqual]", "0"}], ")"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6da8e3fe-65ec-cd48-b773-b639c37f5c19"],
 "s can be divide into two groups so that for any ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a",
    FontWeight->"Bold",
    FontSlant->"Italic"], 
   StyleBox["i",
    FontSlant->"Italic"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2e88f97d-ca86-b943-aa15-3236e47e1b26"],
 " in one group, its addition inverse ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a",
     FontWeight->"Bold",
     FontSlant->"Italic"], 
    RowBox[{
     StyleBox["i",
      FontSlant->"Italic"], "'"}]], "=", 
   RowBox[{"-", 
    SubscriptBox[
     StyleBox["a",
      FontWeight->"Bold",
      FontSlant->"Italic"], 
     StyleBox["i",
      FontSlant->"Italic"]]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0ecd0ec0-4131-ce49-b299-2fe75e3712f9"],
 " is in the other group. And for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HBloch"]], "paclet:TBMethod/ref/HBloch", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "05a8913b-bad3-ec4e-83a0-83286db32eb8"],
 " only one of those two groups of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a",
    FontWeight->"Bold",
    FontSlant->"Italic"], 
   StyleBox["i",
    FontSlant->"Italic"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8f6b53c4-10fe-3a4a-a03d-9d2d2a6db9b0"],
 "s should be included, because the constituents for the inverse vectors are \
to be automatically taken care of by ",
 ButtonBox["ConjugateTranspose",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/ConjugateTranspose"],
 "."
}], "ExampleText",
 CellID->64487330,ExpressionUUID->"3a0820e4-d568-3a4b-a0bc-becedfc1f023"]
}, Closed]]
}, Open  ]],

