Cell[TextData[{
 Cell[BoxData[
  RowBox[{"HBloch", "[", 
   RowBox[{
    StyleBox["k",
     FontWeight->"Bold",
     FontSlant->"Italic"], ",", " ", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{
       SubscriptBox[
        StyleBox["a",
         FontWeight->"Bold",
         FontSlant->"Italic"], "0"], "\[Rule]", 
       SubscriptBox[
        StyleBox["h",
         FontSlant->"Italic"], "00"]}], ",", 
      RowBox[{
       SubscriptBox[
        StyleBox["a",
         FontWeight->"Bold",
         FontSlant->"Italic"], "1"], "\[Rule]", 
       SubscriptBox[
        StyleBox["h",
         FontSlant->"Italic"], "10"]}], ",", "...", ",", 
      RowBox[{
       SubscriptBox[
        StyleBox["a",
         FontWeight->"Bold",
         FontSlant->"Italic"], 
        StyleBox["i",
         FontSlant->"Italic"]], "\[Rule]", 
       SubscriptBox[
        StyleBox["h",
         FontSlant->"Italic"], 
        StyleBox[
         RowBox[{
          StyleBox["i",
           FontSlant->"Italic"], "0"}]]]}], ",", "..."}], 
     "\[RightAssociation]"}]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e6e04a5b-3301-e54c-b264-6573f5ed3f4c"],
 " constructs the reciprocal-space Bloch Hamiltonian matrix."
}], "ExampleText",
 CellID->153566697,ExpressionUUID->"2ee5b420-a97c-ee4d-8289-0e3fdaf7a2d1"],

Cell[TextData[{
 "Vector ",
 Cell[BoxData[
  StyleBox["k",
   FontWeight->"Bold",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "16307150-ffc3-5941-a4cb-6b8e2b349b82"],
 " has the same dimension as those of lattice vectors ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a",
    FontWeight->"Bold",
    FontSlant->"Italic"], "i"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dfa6712c-b275-6b40-9670-9b70beaf78e8"],
 "s."
}], "ExampleText",
 CellID->80053754,ExpressionUUID->"a6203ab2-cd27-124c-a9d7-ad58a978200c"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a",
     FontWeight->"Bold",
     FontSlant->"Italic"], "0"], "=", 
   StyleBox["0",
    FontWeight->"Bold"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a8d5c4e1-22ba-7d44-b843-3206c39c5247"],
 " is the zero vector, and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["h",
    FontSlant->"Italic"], "00"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6bbc03fe-f832-3046-bfd3-3c910e28af33"],
 " is the Hermitian intra-primitive-cell hopping matrix."
}], "ExampleText",
 CellID->35926267,ExpressionUUID->"ddebb2f7-7f39-f849-835d-d94a611ff354"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a",
     FontWeight->"Bold",
     FontSlant->"Italic"], 
    StyleBox["i",
     FontSlant->"Italic"]], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["i",
      FontSlant->"Italic"], "\[NotEqual]", "0"}], ")"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9a20173b-0ff3-c643-8b0e-f643c780a8b3"],
 "s are the corresponding lattice vectors for neighbor cells, and the \
inter-cell hopping matrices ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["h",
    FontSlant->"Italic"], 
   StyleBox[
    RowBox[{
     StyleBox["i",
      FontSlant->"Italic"], "0"}]]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "14d713e9-9b51-3146-a663-fe5833f8ebdb"],
 "s are usually non-Hermitian."
}], "ExampleText",
 CellID->71249355,ExpressionUUID->"e9c1e946-6b1a-5448-949d-0cb83a7845a0"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a",
     FontWeight->"Bold",
     FontSlant->"Italic"], 
    StyleBox["i",
     FontSlant->"Italic"]], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["i",
      FontSlant->"Italic"], "\[NotEqual]", "0"}], ")"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1062f34a-aff2-614a-8642-e65740ee9a5d"],
 "s can be divide into two groups so that for any ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a",
    FontWeight->"Bold",
    FontSlant->"Italic"], 
   StyleBox["i",
    FontSlant->"Italic"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a6682d2a-f30d-8343-b8f1-baab0cdd2293"],
 " in one group, its addition inverse ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a",
     FontWeight->"Bold",
     FontSlant->"Italic"], 
    RowBox[{
     StyleBox["i",
      FontSlant->"Italic"], "'"}]], "=", 
   RowBox[{"-", 
    SubscriptBox[
     StyleBox["a",
      FontWeight->"Bold",
      FontSlant->"Italic"], 
     StyleBox["i",
      FontSlant->"Italic"]]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6bf06dbf-d1d9-aa4b-a9b6-952e31de01fc"],
 " is in the other group. And for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HBloch"]], "paclet:TBMethod/ref/HBloch", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dd64f095-1185-bc47-93cb-57246dee5320"],
 " only one of those two groups of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a",
    FontWeight->"Bold",
    FontSlant->"Italic"], 
   StyleBox["i",
    FontSlant->"Italic"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fe523d6e-97fb-e84b-839a-cf323b1cea83"],
 "s should be included, because the constituents for the inverse vectors are \
to be automatically taken care of by ",
 ButtonBox["ConjugateTranspose",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/ConjugateTranspose"],
 "."
}], "ExampleText",
 CellID->64487330,ExpressionUUID->"85294d5c-95c4-d243-ab1a-869adf5c3015"]
}, Closed]]
}, Open  ]],

