Cell["\<\
The first association entry is the onsite block and receives no phase factor. \
Supply one representative of each reverse-hopping pair among the remaining \
entries.\
\>", "Notes",
 CellID->1063927082,ExpressionUUID->"a4f03771-d580-6240-a9e5-95b345009a2d"],

Cell["\<\
The phase convention uses the negative displacement\[Dash]momentum dot \
product. Hermitian-conjugate reverse hoppings are added automatically.\
\>", "Notes",
 CellID->1352718576,ExpressionUUID->"e49b2168-74c5-e749-a8e7-8f9ac7f7b541"],

Cell[TextData[{
 "With one orientation supplied for each nonzero displacement, the convention \
is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"H", "(", "k", ")"}], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["H", "0"], "+", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", "1"}], "M"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"exp", "(", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", 
            RowBox[{
             SubscriptBox["R", "j"], ".", "k"}]}], ")"}], " ", 
          SubscriptBox["H", 
           SubscriptBox["R", "j"]]}], "+", 
         RowBox[{
          RowBox[{"exp", "(", 
           RowBox[{"\[ImaginaryI]", " ", 
            RowBox[{
             SubscriptBox["R", "j"], ".", "k"}]}], ")"}], " ", 
          TemplateBox[{
            RowBox[{"(", 
              SubscriptBox["H", 
               SubscriptBox["R", "j"]], ")"}]},
           "ConjugateTranspose"]}]}], ")"}]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "02874f33-f963-5644-8cc4-391f49551775"]
}], "Notes",
 CellID->814598719,ExpressionUUID->"9f5b84c3-3fc1-c246-acc6-a368c59812ee"]
}, Closed]],

