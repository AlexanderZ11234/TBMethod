Cell["\<\
The first association entry is the onsite block and receives no phase factor. \
Supply one representative of each reverse-hopping pair among the remaining \
entries.\
\>", "Notes",
 CellID->962751297,ExpressionUUID->"2dba5351-26ca-664b-8c3b-a96d39107867"],

Cell["\<\
The phase convention uses the negative displacement\[Dash]momentum dot \
product. Hermitian-conjugate reverse hoppings are added automatically, as \
shown in the formula below.\
\>", "Notes",
 CellID->452190850,ExpressionUUID->"8885e8ef-3ea5-d342-9d40-605d4f5619bd"],

Cell[TextData[{
 "With one orientation supplied for each nonzero displacement, the convention \
is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"H", "(", "k", ")"}], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["H", "0"], "+", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", "1"}], "M"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"exp", "(", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", 
            RowBox[{
             SubscriptBox["R", "j"], ".", "k"}]}], ")"}], " ", 
          SubscriptBox["H", 
           SubscriptBox["R", "j"]]}], "+", 
         RowBox[{
          RowBox[{"exp", "(", 
           RowBox[{"\[ImaginaryI]", " ", 
            RowBox[{
             SubscriptBox["R", "j"], ".", "k"}]}], ")"}], " ", 
          TemplateBox[{
            RowBox[{"(", 
              SubscriptBox["H", 
               SubscriptBox["R", "j"]], ")"}]},
           "ConjugateTranspose"]}]}], ")"}]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "3b397ca6-c29a-504d-84b7-fb64adc2a03d"]
}], "Notes",
 CellID->436387893,ExpressionUUID->"1ac13296-069d-4043-8555-7ab0e4db3525"]
}, Closed]],

