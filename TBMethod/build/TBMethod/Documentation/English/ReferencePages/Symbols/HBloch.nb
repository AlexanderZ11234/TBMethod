Cell[TextData[{
 Cell[BoxData[
  RowBox[{"HBloch", "[", 
   RowBox[{
    StyleBox["k",
     FontWeight->"Bold",
     FontSlant->"Italic"], ",", " ", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{
       SubscriptBox[
        StyleBox["a",
         FontWeight->"Bold",
         FontSlant->"Italic"], "0"], "\[Rule]", 
       SubscriptBox[
        StyleBox["h",
         FontSlant->"Italic"], "00"]}], ",", 
      RowBox[{
       SubscriptBox[
        StyleBox["a",
         FontWeight->"Bold",
         FontSlant->"Italic"], "1"], "\[Rule]", 
       SubscriptBox[
        StyleBox["h",
         FontSlant->"Italic"], "10"]}], ",", "...", ",", 
      RowBox[{
       SubscriptBox[
        StyleBox["a",
         FontWeight->"Bold",
         FontSlant->"Italic"], 
        StyleBox["i",
         FontSlant->"Italic"]], "\[Rule]", 
       SubscriptBox[
        StyleBox["h",
         FontSlant->"Italic"], 
        StyleBox[
         RowBox[{
          StyleBox["i",
           FontSlant->"Italic"], "0"}]]]}], ",", "..."}], 
     "\[RightAssociation]"}]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "47c87bb1-83a0-5c49-b64f-170897194427"],
 " constructs the reciprocal-space Bloch Hamiltonian matrix."
}], "ExampleText",
 CellID->153566697,ExpressionUUID->"365cd1b5-4426-df42-9c9a-109938715770"],

Cell[TextData[{
 "Vector ",
 Cell[BoxData[
  StyleBox["k",
   FontWeight->"Bold",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7b4fc0f6-6ad9-a240-bcfe-53ba7d186578"],
 " has the same dimension as those of lattice vectors ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a",
    FontWeight->"Bold",
    FontSlant->"Italic"], "i"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1ba0d8fb-cc83-5147-b648-eda441303bb0"],
 "s."
}], "ExampleText",
 CellID->80053754,ExpressionUUID->"902fef98-a43d-3046-b570-2ff873405115"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a",
     FontWeight->"Bold",
     FontSlant->"Italic"], "0"], "=", 
   StyleBox["0",
    FontWeight->"Bold"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "33d2b294-033e-4942-8ac0-3c4db24b137c"],
 " is the zero vector, and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["h",
    FontSlant->"Italic"], "00"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d19c9d26-5b2e-df45-b60d-bdd89efc9bb7"],
 " is the Hermitian intra-primitive-cell hopping matrix."
}], "ExampleText",
 CellID->35926267,ExpressionUUID->"0bd3d4a7-a46d-4543-b0a8-f5a1cb451726"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a",
     FontWeight->"Bold",
     FontSlant->"Italic"], 
    StyleBox["i",
     FontSlant->"Italic"]], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["i",
      FontSlant->"Italic"], "\[NotEqual]", "0"}], ")"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e39f7741-42f2-7344-954d-77b2e63e1124"],
 "s are the corresponding lattice vectors for neighbor cells, and the \
inter-cell hopping matrices ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["h",
    FontSlant->"Italic"], 
   StyleBox[
    RowBox[{
     StyleBox["i",
      FontSlant->"Italic"], "0"}]]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "943c841c-b6c5-6748-88d5-48760dd77349"],
 "s are usually non-Hermitian."
}], "ExampleText",
 CellID->71249355,ExpressionUUID->"28953213-a7b2-524b-8ae0-41738f3e1613"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a",
     FontWeight->"Bold",
     FontSlant->"Italic"], 
    StyleBox["i",
     FontSlant->"Italic"]], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["i",
      FontSlant->"Italic"], "\[NotEqual]", "0"}], ")"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bbdfd83f-a676-7645-9c52-f3d0f53ce673"],
 "s can be divide into two groups so that for any ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a",
    FontWeight->"Bold",
    FontSlant->"Italic"], 
   StyleBox["i",
    FontSlant->"Italic"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5a1593e6-3f93-b94c-9db1-e7d907211480"],
 " in one group, its addition inverse ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a",
     FontWeight->"Bold",
     FontSlant->"Italic"], 
    RowBox[{
     StyleBox["i",
      FontSlant->"Italic"], "'"}]], "=", 
   RowBox[{"-", 
    SubscriptBox[
     StyleBox["a",
      FontWeight->"Bold",
      FontSlant->"Italic"], 
     StyleBox["i",
      FontSlant->"Italic"]]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "819699d2-bb19-aa49-bd92-5beedb4038f4"],
 " is in the other group. And for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HBloch"]], "paclet:TBMethod/ref/HBloch", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3e849ed4-b326-7847-a846-cc176b64b5d5"],
 " only one of those two groups of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a",
    FontWeight->"Bold",
    FontSlant->"Italic"], 
   StyleBox["i",
    FontSlant->"Italic"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "41c9c186-b813-024a-9828-cebae83cfc1f"],
 "s should be included, because the constituents for the inverse vectors are \
to be automatically taken care of by ",
 ButtonBox["ConjugateTranspose",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/ConjugateTranspose"],
 "."
}], "ExampleText",
 CellID->64487330,ExpressionUUID->"173baa56-a632-c242-a45a-fc683079712c"]
}, Closed]]
}, Open  ]],

