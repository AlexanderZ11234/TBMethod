Cell["\<\
weightedData is momentum-major, with dimensions {numberOfSamples, \
numberOfBands, 2}; the final pair is {energy, weight}. This is the \
single-state-function output of BandDataWithWeight.\
\>", "Notes",
 CellID->1274312726,ExpressionUUID->"bb36df98-db52-e447-9803-4a07817087b9"],

Cell["\<\
Weights are globally rescaled for vertex colors; the legend reports their \
original minimum and maximum.\
\>", "Notes",
 CellID->1033786322,ExpressionUUID->"a6593a05-a1ac-924a-9025-6c3ce397dda6"],

Cell["\<\
Options include Joined -> True, ColorFunction, \"LegendPosition\" -> Right, \
\"LegendTickDigits\" -> {3, 4}, and graphics/legend options.\
\>", "Notes",
 CellID->872234313,ExpressionUUID->"6e3cef39-0cfb-a94d-a147-703e3b80b892"]
}, Closed]],

