Cell["\<\
The broadening matrix is formed from the sum of the supplied contacts. At \
finite artificial broadening, this contact-induced density need not equal the \
full density from the imaginary part of the retarded resolvent.\
\>", "Notes",
 CellID->1448406224,ExpressionUUID->"5220b0d0-2881-5e46-bf10-7c036b6c894e"],

Cell[TextData[{
 "For site block ",
 Cell[BoxData[
  FormBox[
   TagBox["a",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "ef237449-378b-f74c-bedb-12257224c419"],
 " and internal projector ",
 Cell[BoxData[
  FormBox[
   TagBox["P",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "50729799-7ca2-614f-b150-e4a49285b573"],
 ", the contact-induced density is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[Rho]", "a"], "\[LongEqual]", 
     FractionBox[
      RowBox[{"Tr", "[", 
       RowBox[{"P", ".", 
        RowBox[{"(", 
         SubscriptBox[
          RowBox[{"G", ".", "\[CapitalGamma]", ".", 
           TemplateBox[{"G"},
            "ConjugateTranspose"]}], 
          RowBox[{"{", 
           RowBox[{"a", ",", "a"}], "}"}]], ")"}]}], "]"}], 
      RowBox[{"2", " ", "\[Pi]"}]]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "d0aed894-effb-d845-b01b-29154187bace"]
}], "Notes",
 CellID->549854619,ExpressionUUID->"93e851c9-eb40-8d44-81cd-fb15393dcb78"]
}, Closed]],

