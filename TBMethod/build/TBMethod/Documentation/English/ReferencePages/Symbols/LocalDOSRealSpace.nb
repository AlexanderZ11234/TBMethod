Cell["\<\
The broadening matrix is formed from the sum of the supplied contacts. At \
finite artificial broadening, this contact-induced density need not equal the \
full density from the imaginary part of the retarded resolvent.\
\>", "Notes",
 CellID->434940544,ExpressionUUID->"55458203-6d78-a54c-99b4-5a350c9aceb5"],

Cell[TextData[{
 "For site block ",
 Cell[BoxData[
  FormBox[
   TagBox["a",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "cd6008ed-f3e4-5947-b2da-2ad2772d3d5f"],
 " and internal projector ",
 Cell[BoxData[
  FormBox[
   TagBox["P",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "877da652-cca6-d34b-a460-965ecf193303"],
 ", the contact-induced density is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[Rho]", "a"], "\[LongEqual]", 
     FractionBox[
      RowBox[{"Tr", "[", 
       RowBox[{"P", ".", 
        RowBox[{"(", 
         SubscriptBox[
          RowBox[{"G", ".", "\[CapitalGamma]", ".", 
           TemplateBox[{"G"},
            "ConjugateTranspose"]}], 
          RowBox[{"{", 
           RowBox[{"a", ",", "a"}], "}"}]], ")"}]}], "]"}], 
      RowBox[{"2", " ", "\[Pi]"}]]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "667f13ca-e665-9049-8862-781dc5bbaa9f"]
}], "Notes",
 CellID->1699798895,ExpressionUUID->"01e45f08-0c11-8d46-a4b8-24c2eae2978e"]
}, Closed]],

