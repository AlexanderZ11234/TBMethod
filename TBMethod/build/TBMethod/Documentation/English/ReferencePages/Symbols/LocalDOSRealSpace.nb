Cell["\<\
The broadening matrix is formed from the sum of the supplied contacts. At \
finite artificial broadening, this contact-induced density need not equal the \
full density from the imaginary part of the retarded resolvent.\
\>", "Notes",
 CellID->1013106031,ExpressionUUID->"fc5ce509-baa2-eb48-b4ba-74b5b769e512"],

Cell[TextData[{
 "For site block ",
 Cell[BoxData[
  FormBox[
   TagBox["a",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "89d5ebb0-7819-7c4c-82c5-e37b38ff6d1f"],
 " and internal projector ",
 Cell[BoxData[
  FormBox[
   TagBox["P",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "8ec85a3e-1f90-f047-b740-04588224d49a"],
 ", the contact-induced density is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[Rho]", "a"], "\[LongEqual]", 
     FractionBox[
      RowBox[{"Tr", "[", 
       RowBox[{"P", ".", 
        RowBox[{"(", 
         SubscriptBox[
          RowBox[{"G", ".", "\[CapitalGamma]", ".", 
           TemplateBox[{"G"},
            "ConjugateTranspose"]}], 
          RowBox[{"{", 
           RowBox[{"a", ",", "a"}], "}"}]], ")"}]}], "]"}], 
      RowBox[{"2", " ", "\[Pi]"}]]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "82789a50-e213-e447-9a38-271860b6df93"]
}], "Notes",
 CellID->1581965202,ExpressionUUID->"c5ec2726-38fa-084b-98b4-be09b04678e6"]
}, Closed]],

