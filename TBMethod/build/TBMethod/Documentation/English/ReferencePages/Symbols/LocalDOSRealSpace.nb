Cell["\<\
The broadening matrix is formed from the sum of the supplied contacts. At \
finite artificial broadening, this contact-induced density need not equal the \
full density from the imaginary part of the retarded resolvent.\
\>", "Notes",
 CellID->434940544,ExpressionUUID->"a2d1fd28-b6e8-b848-967e-2c15829b4b2f"],

Cell[TextData[{
 "For site block ",
 Cell[BoxData[
  FormBox[
   TagBox["a",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "b19e1b15-b5af-7349-bc93-9cb325e0c587"],
 " and internal projector ",
 Cell[BoxData[
  FormBox[
   TagBox["P",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "5a6de364-c31c-034d-8089-18fec2a71a6c"],
 ", the contact-induced density is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[Rho]", "a"], "\[LongEqual]", 
     FractionBox[
      RowBox[{"Tr", "[", 
       RowBox[{"P", ".", 
        RowBox[{"(", 
         SubscriptBox[
          RowBox[{"G", ".", "\[CapitalGamma]", ".", 
           TemplateBox[{"G"},
            "ConjugateTranspose"]}], 
          RowBox[{"{", 
           RowBox[{"a", ",", "a"}], "}"}]], ")"}]}], "]"}], 
      RowBox[{"2", " ", "\[Pi]"}]]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "cd860999-26f8-1144-a37a-d92ddd732e0e"]
}], "Notes",
 CellID->1699798895,ExpressionUUID->"77148de0-2c4b-4449-b13b-d607b4a4be88"]
}, Closed]],

