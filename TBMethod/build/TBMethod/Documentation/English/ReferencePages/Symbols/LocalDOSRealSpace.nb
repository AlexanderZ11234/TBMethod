Cell["\<\
The broadening matrix is formed from the sum of the supplied contacts. At \
finite artificial broadening, this contact-induced density need not equal the \
full density from the imaginary part of the retarded resolvent.\
\>", "Notes",
 CellID->220158629,ExpressionUUID->"a3adb854-725e-ee4a-9903-52f7804f9cfe"],

Cell[TextData[{
 "For site block a and internal projector P, the contact-induced density is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[Rho]", "a"], "\[LongEqual]", 
     FractionBox[
      RowBox[{"Tr", "[", 
       RowBox[{"P", ".", 
        RowBox[{"(", 
         SubscriptBox[
          RowBox[{"G", ".", "\[CapitalGamma]", ".", 
           TemplateBox[{"G"},
            "ConjugateTranspose"]}], 
          RowBox[{"{", 
           RowBox[{"a", ",", "a"}], "}"}]], ")"}]}], "]"}], 
      RowBox[{"2", " ", "\[Pi]"}]]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "d80b630e-f812-f04d-8a81-aea6966a6ce9"]
}], "Notes",
 CellID->1188796995,ExpressionUUID->"9b3a82de-ac0c-7049-bdfe-3fcccb28f0b9"]
}, Closed]],

