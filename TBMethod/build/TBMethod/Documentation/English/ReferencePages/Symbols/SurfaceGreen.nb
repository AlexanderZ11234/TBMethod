  FontSlant->"Plain",ExpressionUUID->"88fad40e-6f33-424f-a29c-a7930ecefcf2"],
 "."
}], "Notes",
 CellID->1117641494,ExpressionUUID->"57b1efa0-675a-ac48-81f4-c009c1099e23"],

