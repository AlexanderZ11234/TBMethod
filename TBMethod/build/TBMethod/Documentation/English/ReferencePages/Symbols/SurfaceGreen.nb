Cell[TextData[{
 "For retarded boundary conditions, use a complex energy ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7d330848-65f7-d845-9d7a-f8a47747c32c"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Im", "(", "z", ")"}], ">", "0"}], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "4cc9aa58-0183-0546-8f1a-9d5edfb737ba"],
 "."
}], "Notes",
 CellID->521869274,ExpressionUUID->"e1ab7630-e4cd-4a40-a6f2-ff4826f75efc"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["h0", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5b5aefaf-94f6-fe4a-a794-9533df7e46d0"],
 " is the onsite block, and ",
 Cell[BoxData[
  StyleBox["h1", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4a96c6cb-3fac-c846-8c0a-03440be787f0"],
 " couples neighboring principal layers. The optional reverse coupling ",
 Cell[BoxData[
  StyleBox["h1upper", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "44b4f3fb-96c5-2e4e-a48c-8f296c5472c1"],
 " defaults to ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["h1", "TI"]},
   "ConjugateTranspose"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "83b85a5f-40a7-e142-a21a-257a8e8dc4f3"],
 "."
}], "Notes",
 CellID->2099493439,ExpressionUUID->"50884cd4-1215-1142-abae-c7426368e86b"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["mode", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "36248988-12cd-134c-90e8-120127ab5605"],
 " argument is required: ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cd489696-d75a-2344-b494-597a1c499df1"],
 " uses iterative decimation; ",
 Cell[BoxData["2"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6f9fe121-c91f-644d-84eb-66b6dfbbc7eb"],
 " and ",
 Cell[BoxData["3"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6f8e1d20-6da6-3f4b-99f6-8a7913eeb114"],
 " use transfer matrices; ",
 Cell[BoxData["4"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8cc2d014-2c2d-5540-904f-d1a639af601c"],
 " and ",
 Cell[BoxData["5"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f99b009d-0492-9747-b4f1-ad70f5a624b8"],
 " regularize the hopping by singular value decomposition."
}], "Notes",
 CellID->514891894,ExpressionUUID->"477fa121-5706-ae4c-80fc-31c0e64ae0ee"],

Cell[TextData[{
 "Modes ",
 Cell[BoxData["2"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "44be6826-6b2b-c243-91fe-bbdfe380f59d"],
 " and ",
 Cell[BoxData["4"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "06f7b83b-a89c-4040-b0bd-3952c005b9aa"],
 " invert a hopping block. Modes ",
 Cell[BoxData["3"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b280dfb8-0754-704e-ab95-49321c4f9ce2"],
 " and ",
 Cell[BoxData["5"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2a0bbb4a-17de-964f-8b3d-268cc803084d"],
 " use a generalized eigenproblem."
}], "Notes",
 CellID->132384878,ExpressionUUID->"bfcc1f10-f1b3-3e42-97a2-9cf08fef6040"],

Cell[TextData[{
 "The string-named option ",
 Cell[BoxData[
  RowBox[{"\"\<\[Delta]SVD\>\"", "\[Rule]", "1.*^-7"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a18a0e4c-660f-6d49-b962-4a6e56397530"],
 " sets the relative singular-value floor in modes ",
 Cell[BoxData["4"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6d8478b0-56d5-c743-aefe-e09068ff8a4e"],
 " and ",
 Cell[BoxData["5"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0e3df4b1-2453-d241-a461-c5fd5cbba587"],
 "."
}], "Notes",
 CellID->971957590,ExpressionUUID->"5f7a7a50-e70e-a245-810f-3246d801cf2e"],

Cell[TextData[{
 "With the default Hermitian-conjugate reverse coupling, the surface matrix \
satisfies",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["g", "s"], "(", "z", ")"}], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{"(", 
         RowBox[{
           RowBox[{"z", " ", "\[DoubleStruckCapitalI]"}], "-", 
           SubscriptBox["h", "0"], "-", 
           RowBox[{
             SubscriptBox["h", "1"], ".", 
             RowBox[{
               SubscriptBox["g", "s"], "(", "z", ")"}], ".", 
             TemplateBox[{
               RowBox[{"(", 
                 SubscriptBox["h", "1"], ")"}]}, "ConjugateTranspose", 
              SyntaxForm -> SuperscriptBox]}]}], ")"}]},
      "Inverse"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "168cd83b-f5ea-0347-9d2e-f080a897bb8f"]
}], "Notes",
 CellID->1440010226,ExpressionUUID->"88241d0c-1857-a840-9f24-f9124cfcbdb7"]
}, Closed]],

