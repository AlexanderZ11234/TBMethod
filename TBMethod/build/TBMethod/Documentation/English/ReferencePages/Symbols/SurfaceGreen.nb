Cell["\<\
Use a complex energy with positive imaginary part for retarded boundary \
conditions.\
\>", "Notes",
 CellID->1351239797,ExpressionUUID->"fe90fcd8-0936-db43-ba4e-7be07f12e360"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["h0", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "66355af0-c502-9440-b563-0fe7ff1dc36e"],
 " is the onsite block and ",
 Cell[BoxData[
  StyleBox["h1", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "587e36de-971b-ac46-b727-b75ab381882b"],
 " couples neighboring principal layers. The optional ",
 Cell[BoxData[
  StyleBox["h1upper", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b0b34718-b2ba-2045-9d0a-0ce9cd45aae7"],
 " defaults to ",
 Cell[BoxData[
  TemplateBox[{"h1"},
   "ConjugateTranspose"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "50db5602-73b6-d54a-ae25-f323d9e967f3"],
 "."
}], "Notes",
 CellID->1376040609,ExpressionUUID->"3045abe6-63e8-f845-953d-f1d72a940023"],

Cell[TextData[{
 "The implementation requires an explicit ",
 Cell[BoxData[
  StyleBox["mode", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "42841143-3326-2243-82ca-001f2e055f2b"],
 ": ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6e9620e7-c0fb-3846-8e85-cb5052d9a3de"],
 " uses iterative decimation; ",
 Cell[BoxData["2"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e2697cd2-3c26-0246-bb20-28d333d6b3a3"],
 " and ",
 Cell[BoxData["3"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7711188d-6daf-e04f-9549-10d1e28758c3"],
 " use transfer matrices; ",
 Cell[BoxData["4"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e4e7235a-3b19-2b42-8846-10868387d271"],
 " and ",
 Cell[BoxData["5"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b9e96f18-9eb8-594d-bf70-d89eaf2db8de"],
 " regularize the hopping by singular value decomposition."
}], "Notes",
 CellID->1794468570,ExpressionUUID->"2f3f3d4a-3783-d347-80a5-59de631cf0b1"],

Cell[TextData[{
 "Modes ",
 Cell[BoxData["2"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cd1dd157-1059-cd40-8a10-e8294a6f559c"],
 " and ",
 Cell[BoxData["4"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4139e65c-b0c8-804a-a3d0-eca4146434f5"],
 " invert a hopping block. Modes ",
 Cell[BoxData["3"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "04324cd9-5385-1d47-a04d-27a013e78fa2"],
 " and ",
 Cell[BoxData["5"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "96cc6c5c-e3d1-0c47-8629-7237112f428f"],
 " use a generalized eigenproblem."
}], "Notes",
 CellID->1862782617,ExpressionUUID->"7d8ce76d-5e05-ba46-bd27-bee6d89d1af5"],

Cell[TextData[{
 "The string option ",
 Cell[BoxData["\"\<\[Delta]SVD\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "47853032-bb5c-ae43-a958-d8132f9f02bb"],
 " defaults to ",
 Cell[BoxData["1.*^-7"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4183a136-48c9-f84f-a83e-813a18be2608"],
 " and affects modes ",
 Cell[BoxData["4"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "522ac2e4-bfbe-c34b-bdf7-34f127f2cca2"],
 " and ",
 Cell[BoxData["5"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "00ed6714-b3ec-3745-b8ab-f823bd89ef25"],
 "."
}], "Notes",
 CellID->2011542549,ExpressionUUID->"bdd9b306-4b97-2940-9ba3-5c59d4f184fa"],

Cell[TextData[{
 "With the default Hermitian-conjugate reverse coupling, the surface matrix \
satisfies",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["g", "s"], "(", "z", ")"}], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{"(", 
         RowBox[{
           RowBox[{"z", " ", "\[DoubleStruckCapitalI]"}], "-", 
           SubscriptBox["h", "0"], "-", 
           RowBox[{
             SubscriptBox["h", "1"], ".", 
             RowBox[{
               SubscriptBox["g", "s"], "(", "z", ")"}], ".", 
             TemplateBox[{
               RowBox[{"(", 
                 SubscriptBox["h", "1"], ")"}]}, "ConjugateTranspose", 
              SyntaxForm -> SuperscriptBox]}]}], ")"}]},
      "Inverse"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "9f526871-cdde-1841-b191-b200a3b80dd7"]
}], "Notes",
 CellID->1913997510,ExpressionUUID->"88804a0f-5584-2048-8250-ce26ba844486"]
}, Closed]],

