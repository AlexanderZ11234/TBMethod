Cell[TextData[{
 "For retarded boundary conditions, use a complex energy ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "09b7a050-ef73-7043-8d46-8954002eb55a"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Im", "(", "z", ")"}], ">", "0"}], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "bc416c95-8fef-e140-877c-eb71eb32cd6f"],
 "."
}], "Notes",
 CellID->217173207,ExpressionUUID->"8a995d32-1f03-b84f-9b8c-105ba83e2c13"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["h0", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "aac8df5c-a387-2944-b17e-40764ba7f0dd"],
 " is the onsite block, and ",
 Cell[BoxData[
  StyleBox["h1", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cd194d41-035c-4348-b848-c76fbbe4820f"],
 " couples neighboring principal layers. The optional reverse coupling ",
 Cell[BoxData[
  StyleBox["h1upper", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8ad9cd58-0fe1-234d-a5cf-ac7eafa8d982"],
 " defaults to ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["h1", "TI"]},
   TemplateBox[{
     Cell[
      TextData["ConjugateTranspose"]], "paclet:ref/ConjugateTranspose"}, 
    "RefLink", BaseStyle -> {"InlineFormula"}]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a036562e-33d9-2546-be57-33eac51ce6ea"],
 "."
}], "Notes",
 CellID->1785473580,ExpressionUUID->"ca8c77ee-5b6a-154b-8844-8725843ca1c9"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["mode", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5bcbaeda-4129-ff48-b759-6d3bcb9f8288"],
 " argument is required: ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b1bf479c-003f-0748-9786-cfcbdda4b558"],
 " uses iterative decimation; ",
 Cell[BoxData["2"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dd33209e-f46d-7c4b-aa6c-ebf3045044f6"],
 " and ",
 Cell[BoxData["3"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "102a61cc-1131-834f-8a57-be2646b71496"],
 " use transfer matrices; ",
 Cell[BoxData["4"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a971259a-8142-cb44-82b5-c096b968d55e"],
 " and ",
 Cell[BoxData["5"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "40498672-17ce-694a-a31f-1fd16089ac2d"],
 " regularize the hopping by singular value decomposition."
}], "Notes",
 CellID->1732112656,ExpressionUUID->"7f8c902b-1b1a-6846-8d79-ae86b342b6bf"],

Cell[TextData[{
 "Modes ",
 Cell[BoxData["2"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ed15caa2-542c-5a40-a8d0-bf7245631b72"],
 " and ",
 Cell[BoxData["4"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2e4cb9de-f81b-ff44-8b5f-349fc6ad5ab1"],
 " invert a hopping block. Modes ",
 Cell[BoxData["3"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f28fd214-d046-c845-a2a4-2136ad6b8879"],
 " and ",
 Cell[BoxData["5"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a0c7b32d-0218-9146-b04f-530a07314590"],
 " use a generalized eigenproblem."
}], "Notes",
 CellID->838558182,ExpressionUUID->"c8718edf-408f-da4e-a984-b9eb79a6e5f6"],

Cell[TextData[{
 "The string-named option ",
 Cell[BoxData[
  RowBox[{"\"\<\[Delta]SVD\>\"", "\[Rule]", "1.*^-7"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d79813f5-7b72-ab4a-b566-91836b542025"],
 " sets the relative singular-value floor in modes ",
 Cell[BoxData["4"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3ab090ee-2048-c343-ab9f-958fbdc1668a"],
 " and ",
 Cell[BoxData["5"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "316781a3-14e1-ae40-aa7a-cb2d1f5dd6c4"],
 "."
}], "Notes",
 CellID->1289535088,ExpressionUUID->"43cd3c3c-7f8d-764e-8172-73b2dc4ff528"],

Cell[TextData[{
 "With the default Hermitian-conjugate reverse coupling, the surface matrix \
satisfies",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["g", "s"], "(", "z", ")"}], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{"(", 
         RowBox[{
           RowBox[{"z", " ", "\[DoubleStruckCapitalI]"}], "-", 
           SubscriptBox["h", "0"], "-", 
           RowBox[{
             SubscriptBox["h", "1"], ".", 
             RowBox[{
               SubscriptBox["g", "s"], "(", "z", ")"}], ".", 
             TemplateBox[{
               RowBox[{"(", 
                 SubscriptBox["h", "1"], ")"}]}, "ConjugateTranspose", 
              SyntaxForm -> SuperscriptBox]}]}], ")"}]},
      "Inverse"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "cb5d5360-55a9-8c48-a59d-4d647af3545d"]
}], "Notes",
 CellID->1343745964,ExpressionUUID->"584688c8-5f0f-3c41-9b32-71e73b1339f3"]
}, Closed]],

