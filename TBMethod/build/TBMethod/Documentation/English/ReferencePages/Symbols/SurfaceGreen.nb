Cell[TextData[{
 "For retarded boundary conditions, use a complex energy ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "61d9384a-3145-1e45-865f-8224fb957d8d"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Im", "(", "z", ")"}], ">", "0"}], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "da1451e6-c60a-c04c-8c6f-457f6c8c8723"],
 "."
}], "Notes",
 CellID->521869274,ExpressionUUID->"ea700ce7-d888-b04f-8aba-bb5f5a32ec52"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["h0", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b3500cf6-5ba3-5946-b5b7-b5e7fe0d3ceb"],
 " is the onsite block, and ",
 Cell[BoxData[
  StyleBox["h1", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "82e42631-1284-6d47-bc3a-0855bde402ce"],
 " couples neighboring principal layers. The optional reverse coupling ",
 Cell[BoxData[
  StyleBox["h1upper", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8411acaf-7049-fc4c-9f0a-912248eeedea"],
 " defaults to ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["h1", "TI"]},
   "ConjugateTranspose"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "03eb2cbf-2386-3e40-af12-86a2e7d9dfdc"],
 "."
}], "Notes",
 CellID->2099493439,ExpressionUUID->"fd6ad296-8f26-f848-bb14-8d4f057c27c4"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["mode", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ec2f1e79-5eeb-d24d-a3cf-7d1c37731bba"],
 " argument is required: ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c389f907-1086-2e4e-84a9-20eb61c886ba"],
 " uses iterative decimation; ",
 Cell[BoxData["2"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "05080c02-99db-2c4f-830f-42fb3049cabc"],
 " and ",
 Cell[BoxData["3"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6dd9e100-dc04-f244-a943-4d95d7664ecc"],
 " use transfer matrices; ",
 Cell[BoxData["4"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fb11890e-f478-6f4f-9cc8-e2c813087ce6"],
 " and ",
 Cell[BoxData["5"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cc87915c-e7e0-6845-9462-28129d1b84ac"],
 " regularize the hopping by singular value decomposition."
}], "Notes",
 CellID->514891894,ExpressionUUID->"0f4106aa-99a0-a148-be6f-cb4ea57d2273"],

Cell[TextData[{
 "Modes ",
 Cell[BoxData["2"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "90a016f0-c4e5-2a49-809d-8ac342413c35"],
 " and ",
 Cell[BoxData["4"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "af882bf3-edee-5b4c-b3ff-ef4f2510bdde"],
 " invert a hopping block. Modes ",
 Cell[BoxData["3"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "72cb778f-af18-014f-8465-1471660c600a"],
 " and ",
 Cell[BoxData["5"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "766ce3d1-b953-2548-8183-c361b0cb1bc6"],
 " use a generalized eigenproblem."
}], "Notes",
 CellID->132384878,ExpressionUUID->"55a1b384-6c0e-9f49-9186-e3a6a823b5b4"],

Cell[TextData[{
 "The string-named option ",
 Cell[BoxData[
  RowBox[{"\"\<\[Delta]SVD\>\"", "\[Rule]", "1.*^-7"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "49ea2cf3-1ec2-f84a-9c27-615bd1e67c74"],
 " sets the relative singular-value floor in modes ",
 Cell[BoxData["4"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1a1ee0a6-cc20-c248-a5b4-929ff611141a"],
 " and ",
 Cell[BoxData["5"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "70542e82-528a-8147-8ad2-e4184a45d52e"],
 "."
}], "Notes",
 CellID->971957590,ExpressionUUID->"27ec5b8d-32d6-5442-aec7-cab5aeceb0a8"],

Cell[TextData[{
 "With the default Hermitian-conjugate reverse coupling, the surface matrix \
satisfies",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["g", "s"], "(", "z", ")"}], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{"(", 
         RowBox[{
           RowBox[{"z", " ", "\[DoubleStruckCapitalI]"}], "-", 
           SubscriptBox["h", "0"], "-", 
           RowBox[{
             SubscriptBox["h", "1"], ".", 
             RowBox[{
               SubscriptBox["g", "s"], "(", "z", ")"}], ".", 
             TemplateBox[{
               RowBox[{"(", 
                 SubscriptBox["h", "1"], ")"}]}, "ConjugateTranspose", 
              SyntaxForm -> SuperscriptBox]}]}], ")"}]},
      "Inverse"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "a5bd6d33-4337-ef46-9914-42efc59e2d90"]
}], "Notes",
 CellID->1440010226,ExpressionUUID->"d191c3fe-654c-7b4b-9ca6-ac40637cd155"]
}, Closed]],

