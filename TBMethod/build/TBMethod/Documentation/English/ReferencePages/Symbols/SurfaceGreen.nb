Cell[TextData[{
 "With the default Hermitian-conjugate reverse coupling, the surface matrix \
satisfies",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["g", "s"], "(", "z", ")"}], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{"(", 
         RowBox[{
           RowBox[{"z", " ", "\[DoubleStruckCapitalI]"}], "-", 
           SubscriptBox["h", "0"], "-", 
           RowBox[{
             SubscriptBox["h", "1"], ".", 
             RowBox[{
               SubscriptBox["g", "s"], "(", "z", ")"}], ".", 
             TemplateBox[{
               RowBox[{"(", 
                 SubscriptBox["h", "1"], ")"}]}, "ConjugateTranspose", 
              SyntaxForm -> SuperscriptBox]}]}], ")"}]},
      "Inverse"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "ee21128d-3430-d24f-b98a-00102aaf69d9"]
}], "Notes",
 CellID->1659549200,ExpressionUUID->"1b2b9e7e-c5c3-5742-8745-915c1eeb2467"]
}, Closed]],

