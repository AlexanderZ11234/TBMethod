 " supplied internally."
}], "Notes",
 CellID->2042240001,ExpressionUUID->"1a4d6d59-0c37-e048-aeb4-a1ca5ae6f593"],

Cell[TextData[{
 "If the eigenvalues of the occupied-subspace Wilson product are denoted by \
",
 Cell[BoxData[
  FormBox[
   TagBox["\[Lambda]",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "e4fd3ff3-779f-5242-87f9-82cf3f973ca2"],
 ", the normalization used here is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[Nu]", "j"], "\[LongEqual]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"arg", "(", 
        RowBox[{
         SubscriptBox["\[Lambda]", "j"], "(", "W", ")"}], ")"}], "\[Pi]"]}]}],
    
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "b7e36c04-8806-9440-a1de-7a2215202619"]
}], "Notes",
 CellID->1768337914,ExpressionUUID->"44eaccd7-ba0f-2a4d-b61f-f5c70305813d"]
}, Closed]],

