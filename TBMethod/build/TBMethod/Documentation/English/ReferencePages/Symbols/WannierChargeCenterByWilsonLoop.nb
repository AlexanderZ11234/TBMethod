  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "99382b12-3697-a340-8e84-9abdf8559303"],
 " supplied internally."
}], "Notes",
 CellID->962715813,ExpressionUUID->"110e7257-1f8e-f446-8e56-39e2bf29f2e6"],

Cell[TextData[{
 "If the eigenvalues of the occupied-subspace Wilson product are denoted by \
",
 Cell[BoxData[
  FormBox[
   TagBox["\[Lambda]",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "c5ceacf4-42d3-284c-af87-920bca403118"],
 ", the normalization used here is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[Nu]", "j"], "\[LongEqual]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"arg", "(", 
        RowBox[{
         SubscriptBox["\[Lambda]", "j"], "(", "W", ")"}], ")"}], "\[Pi]"]}]}],
    
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "e6530c2d-ed46-794b-8fa2-c4929bd4330c"]
}], "Notes",
 CellID->1942392625,ExpressionUUID->"c4d2f7dd-ae95-9b44-9e90-39c7246a057a"]
}, Closed]],

