Cell[TextData[{
 Cell[BoxData[
  RowBox[{"h", "[", "k", "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ab5376f5-420e-9146-9874-6e87cba01d70"],
 " returns a Hermitian Hamiltonian. The ",
 Cell[BoxData[
  StyleBox["nOccupied", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a691b4eb-8c49-e442-ad85-95c84ec15c54"],
 " lowest-energy eigenstates are retained after sorting at each sample."
}], "Notes",
 CellID->645587549,ExpressionUUID->"d9ee6054-a3c4-3f4a-adcd-96c6680a33c8"],

Cell["\<\
The path is closed internally by connecting the final occupied subspace back \
to the first; a repeated endpoint is optional.\
\>", "Notes",
 CellID->699459212,ExpressionUUID->"bf2d940d-4940-fd43-91fd-077ab62d815d"],

Cell[TextData[{
 "The package uses a normalization of ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox["1", "\[Pi]"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b9c39745-31b9-fd4f-b5b1-d7ad91690b63"],
 " for the eigenphases. This differs by a factor of two from conventions \
expressed in units of ",
 Cell[BoxData[
  RowBox[{"2", " ", "\[Pi]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1309a1b3-0454-aa4a-b2db-9ca5f05e2937"],
 "."
}], "Notes",
 CellID->1479852884,ExpressionUUID->"e263e51e-ca6c-f440-8d1c-5e141e224d9a"],

Cell["\<\
A separated occupied subspace and a sufficiently dense path are needed for a \
stable result.\
\>", "Notes",
 CellID->1887541298,ExpressionUUID->"0da6179f-e172-e046-92f8-f00c5f1c3b40"],

Cell[TextData[{
 Cell[BoxData[
