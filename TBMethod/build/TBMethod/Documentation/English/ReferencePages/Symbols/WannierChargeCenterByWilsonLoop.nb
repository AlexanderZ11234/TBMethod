Cell[TextData[{
 "If the eigenvalues of the occupied-subspace Wilson product are denoted by \
lambda, the normalization used here is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[Nu]", "j"], "\[LongEqual]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"arg", "(", 
        RowBox[{
         SubscriptBox["\[Lambda]", "j"], "(", "W", ")"}], ")"}], "\[Pi]"]}]}],
    
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "15c65a13-1ade-bb46-87d2-caefa4cfdc1d"]
}], "Notes",
 CellID->861106048,ExpressionUUID->"a5220da8-bf52-7446-bca6-3695a6b56603"]
}, Closed]],

