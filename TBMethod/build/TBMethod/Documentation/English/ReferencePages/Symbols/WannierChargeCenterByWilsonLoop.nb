Cell["\<\
The path is closed internally by connecting the final occupied subspace back \
to the first; a repeated endpoint is optional.\
\>", "Notes",
 CellID->562497456,ExpressionUUID->"e2e7054d-f0fd-e94b-b4b1-c26e5dc2d3ff"],

Cell[TextData[{
 "The package multiplies eigenphases by ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"-", 
     FractionBox["1", "\[Pi]"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "5d8294d8-3df8-9444-b5b7-131793e98e64"],
 ", as shown below. This differs by a factor of two from conventions \
expressed in units of ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"2", " ", "\[Pi]"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "305dc1dc-e64a-0b45-bb8a-55380038b196"],
 "."
}], "Notes",
 CellID->1620805162,ExpressionUUID->"f241ca32-8686-774b-a50f-321fca9e6fb0"],

Cell["\<\
A separated occupied subspace and a sufficiently dense path are needed for a \
stable result.\
\>", "Notes",
 CellID->1674627728,ExpressionUUID->"f75da125-b069-4d47-acde-9d9eec19397d"],

Cell[TextData[{
 "Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigensystem"]], "paclet:ref/Eigensystem"},
