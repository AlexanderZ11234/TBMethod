Cell[TextData[{
 Cell[BoxData[
  RowBox[{"h", "[", "k", "]"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"d0549508-ceda-e448-a751-9706f1a559dc"],
 " returns a Hermitian Hamiltonian. The ",
 Cell[BoxData[
  StyleBox["nOccupied", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a9e1f8f7-7440-504d-a30b-5cacf1f51972"],
 " lowest-energy eigenstates are retained after sorting at each sample."
}], "Notes",
 CellID->543986997,ExpressionUUID->"9d2f4b68-2586-a846-ac08-38d963353f03"],

Cell["\<\
The path is closed internally by connecting the final occupied subspace back \
to the first; a repeated endpoint is optional.\
\>", "Notes",
 CellID->1934854595,ExpressionUUID->"92db9bd3-4d04-3c4a-910a-c7063eb11c6a"],

Cell[TextData[{
 "The package multiplies eigenphases by ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"-", 
     FractionBox["1", "\[Pi]"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "b7f1f655-082f-8a4d-86cf-dfbbc65552d5"],
 ", as shown below. This differs by a factor of two from conventions \
expressed in units of ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"2", " ", "\[Pi]"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "ed59e14b-d2fa-844e-b81c-5ac7f648a52c"],
 "."
}], "Notes",
 CellID->810167198,ExpressionUUID->"07a1b9a5-e941-7c4f-8a63-a67013370e4c"],

Cell["\<\
A separated occupied subspace and a sufficiently dense path are needed for a \
stable result.\
\>", "Notes",
 CellID->418491758,ExpressionUUID->"5a9b2d6b-5df3-0f41-9259-ae3d0006305b"],

Cell[TextData[{
 "Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigensystem"]], "paclet:ref/Eigensystem"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  ScriptLevel->0,
