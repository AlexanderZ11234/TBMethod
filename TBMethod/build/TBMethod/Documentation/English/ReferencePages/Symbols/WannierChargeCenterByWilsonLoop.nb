     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1.`"}], ",", "0.`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.`", ",", "1.`"}], "}"}]}], "}"}]}], ";", 
