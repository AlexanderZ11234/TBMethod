  RowBox[{"Method", " ", "->", " ", "\"\<Direct\>\""}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"cb6cc0d4-575f-2c4d-8ef9-6bc56ee45dbe"],
 " supplied internally."
}], "Notes",
 CellID->1849767001,ExpressionUUID->"552b8f4e-9339-8e48-a0d3-e41cd27ea3a6"],

Cell[TextData[{
 "If the eigenvalues of the occupied-subspace Wilson product are denoted by \
",
 Cell[BoxData[
  FormBox[
   TagBox["\[Lambda]",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "5a222892-ca68-674d-a6cc-2c98841a1ff2"],
 ", the normalization used here is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[Nu]", "j"], "\[LongEqual]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"arg", "(", 
        RowBox[{
         SubscriptBox["\[Lambda]", "j"], "(", "W", ")"}], ")"}], "\[Pi]"]}]}],
    
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "c26ee368-00d9-e241-93ae-40da71a4fdf1"]
}], "Notes",
 CellID->117510810,ExpressionUUID->"d6227807-0069-204c-a6b8-e48a7a9dc6bd"]
}, Closed]],

