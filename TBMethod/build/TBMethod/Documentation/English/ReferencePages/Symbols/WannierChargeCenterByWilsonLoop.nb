Cell["\<\
The path is closed internally by connecting the final occupied subspace back \
to the first; a repeated endpoint is optional.\
\>", "Notes",
 CellID->1024512658,ExpressionUUID->"2ec3d904-d82e-4541-91d1-9b3d50c4efc3"],

Cell[TextData[{
 "The package multiplies eigenphases by ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"-", 
     FractionBox["1", "\[Pi]"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "1490feff-f965-4c46-8502-9b268baf21be"],
 ", as shown below. This differs by a factor of two from conventions \
expressed in units of ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"2", " ", "\[Pi]"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "75a46de2-1aba-3147-a7c9-b193412f2cd4"],
 "."
}], "Notes",
 CellID->364618833,ExpressionUUID->"9ac7393a-a31b-414c-be2c-83144f3d6721"],

Cell["\<\
A separated occupied subspace and a sufficiently dense path are needed for a \
stable result.\
\>", "Notes",
 CellID->1777556786,ExpressionUUID->"b2949497-4d76-9c4e-ac4a-4e6b5e85fd7f"],

Cell[TextData[{
 "Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigensystem"]], "paclet:ref/Eigensystem"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
