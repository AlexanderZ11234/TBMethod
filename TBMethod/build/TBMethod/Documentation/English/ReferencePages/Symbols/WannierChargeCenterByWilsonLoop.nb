  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "85eaea61-320b-6b43-bc17-ad024203c5b5"],
 " supplied internally."
}], "Notes",
 CellID->2042240001,ExpressionUUID->"d1f83b2f-b07d-5e4a-83b7-211151d85d5c"],

Cell[TextData[{
 "If the eigenvalues of the occupied-subspace Wilson product are denoted by \
",
 Cell[BoxData[
  FormBox[
   TagBox["\[Lambda]",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "570b283f-4311-5346-8a75-c81f45196215"],
 ", the normalization used here is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[Nu]", "j"], "\[LongEqual]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"arg", "(", 
        RowBox[{
         SubscriptBox["\[Lambda]", "j"], "(", "W", ")"}], ")"}], "\[Pi]"]}]}],
    
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "96fe39df-5496-984d-8cf6-8b0cea42d6dc"]
}], "Notes",
 CellID->1768337914,ExpressionUUID->"ca131a62-6f2d-0042-97fa-6d32ccbe3fb5"]
}, Closed]],

