Cell[TextData[{
 "The default labels are ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "0"}], "}"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"f5566a60-a6a1-7745-aa06-f528ca3f6b11"],
 "; the default boundary condition is ",
