Cell[TextData[{
 Cell[BoxData[
  StyleBox["basis", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "58c2b884-2e74-1f42-833c-eb5c5285621f"],
 " is a list of two side vectors. Each sampled point is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["i", "TI"], ",", 
     StyleBox["j", "TI"]}], "}"}], ".", 
   StyleBox["basis", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3795f32f-9566-0848-b7f6-d3ee7658ec77"],
 ", with ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3070c84a-8ce1-094b-82fc-b065265a7663"],
 " and ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4a3f6489-ef1a-0243-9f65-eab9028bbd70"],
 " running from ",
 Cell[BoxData["0."], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e2509bd8-6643-bc48-b26c-05f07ee9df9f"],
 " to ",
 Cell[BoxData["1."], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f16c949f-508b-2044-9e44-9536e58686b1"],
 " in steps ",
 Cell[BoxData[
  FractionBox["1.", 
   StyleBox["m", "TI"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "080b29ba-277e-2e43-9cf0-224e2c41ff30"],
 " and ",
 Cell[BoxData[
  FractionBox["1.", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d936eadd-aaa8-f54e-a651-7bc36ef3cc08"],
 "."
}], "Notes",
 CellID->1820801519,ExpressionUUID->"36cf49aa-64db-4c4e-bb31-c9eb25ece391"],

Cell[TextData[{
 "Use positive integers ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "74b60ec8-7f1b-a448-a0d9-475a7cba745a"],
 " and ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9f2fa3c4-d870-a840-99b0-2814f7c95070"],
 ". Input patterns allow integers but do not explicitly reject zero or \
negative values."
}], "Notes",
 CellID->1841338725,ExpressionUUID->"cfcc897a-89db-d84f-a8a0-07dded27803d"],

Cell[TextData[{
 "Returns an array of dimensions ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     StyleBox["m", "TI"], "+", "1"}], ",", 
    RowBox[{
     StyleBox["n", "TI"], "+", "2"}], ",", 
    StyleBox["coordinateDimension", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e4e0734a-4ddb-6a4a-bd92-1bdad07cf7e5"],
 ". The first sample of each row is appended again to close that loop."
}], "Notes",
 CellID->572879572,ExpressionUUID->"570388ee-824c-b44e-a0c9-edf4ebc575f9"],

