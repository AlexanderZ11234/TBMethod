Cell[TextData[{
 Cell[BoxData[
  StyleBox["basis", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0f87f839-eb12-e64b-baf2-e0aadcf37816"],
 " is a list of two side vectors. Each sampled point is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["i", "TI"], ",", 
     StyleBox["j", "TI"]}], "}"}], ".", 
   StyleBox["basis", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "39ff8b03-9372-5f40-8988-0da40e2a40c6"],
 ", with ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ebafcf03-633a-694d-88fc-8e832ddc9e25"],
 " and ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "67e6d58b-7dd7-834f-969b-34c289c84d7a"],
 " running from ",
 Cell[BoxData["0."], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a67a0562-e697-e443-9c86-0fc29bdab9b8"],
 " to ",
 Cell[BoxData["1."], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e3517c83-8c12-6b42-9ae0-9b2d536d44a6"],
 " in steps ",
 Cell[BoxData[
  FractionBox["1.", 
   StyleBox["m", "TI"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "79d5f7e4-4041-b94b-9f51-f4616b71cfeb"],
 " and ",
 Cell[BoxData[
  FractionBox["1.", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "eb5b68b2-ac1b-044c-9769-08ced62af3ee"],
 "."
}], "Notes",
 CellID->1820801519,ExpressionUUID->"19078403-14cb-2f42-8031-cd133df29422"],

Cell[TextData[{
 "Use positive integers ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e04d6e67-0949-ce4c-bb85-9675d5dd7199"],
 " and ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7b3b01ae-3871-5247-a792-2db3395a1a31"],
 ". Input patterns allow integers but do not explicitly reject zero or \
negative values."
}], "Notes",
 CellID->1841338725,ExpressionUUID->"2b03620d-727b-8941-9976-433969902f0c"],

Cell[TextData[{
 "Returns an array of dimensions ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     StyleBox["m", "TI"], "+", "1"}], ",", 
    RowBox[{
     StyleBox["n", "TI"], "+", "2"}], ",", 
    StyleBox["coordinateDimension", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "814fc46b-70c2-d54f-b46d-106245b82954"],
 ". The first sample of each row is appended again to close that loop."
}], "Notes",
 CellID->572879572,ExpressionUUID->"47c4b393-33f5-5547-b814-72a3a87a6e35"],

