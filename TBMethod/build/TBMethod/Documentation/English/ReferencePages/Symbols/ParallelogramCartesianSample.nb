Cell[TextData[{
 Cell[BoxData[
  StyleBox["basis", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "108a0fdf-ba76-4a4c-8142-3c0e371f0594"],
 " is a list of two side vectors. Each sampled point is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["i", "TI"], ",", 
     StyleBox["j", "TI"]}], "}"}], ".", 
   StyleBox["basis", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ec0e1b3a-76ed-a14d-8bec-aa2f2df9585b"],
 ", with ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "68306193-8ecb-b24b-9608-40516159b42c"],
 " and ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "72074593-8ba7-6f45-bfc5-2ce3f654a15c"],
 " running from ",
 Cell[BoxData["0."], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bc677f2f-5740-c44a-bd72-350b22d6293a"],
 " to ",
 Cell[BoxData["1."], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8504fe75-a4e2-504f-b30f-98ae22d5c516"],
 " in steps ",
 Cell[BoxData[
  FractionBox["1.", 
   StyleBox["m", "TI"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a9556c32-e27b-e741-96f4-221e266efff5"],
 " and ",
 Cell[BoxData[
  FractionBox["1.", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4fc05d2a-021b-b84f-9aea-cffbcb63d10f"],
 "."
}], "Notes",
 CellID->233998153,ExpressionUUID->"c525f1c1-8a1c-dd44-ae9e-4234bfef1d33"],

Cell[TextData[{
 "Use positive integers ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c7b0bbe2-25d2-6d47-b63c-173e7edabfed"],
 " and ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7cd08e04-19f8-bd45-872f-29e60c7cedca"],
 ". Input patterns allow integers but do not explicitly reject zero or \
negative values."
}], "Notes",
 CellID->1290025516,ExpressionUUID->"31375619-7c9a-d843-a0f6-4998e53b0789"],

Cell[TextData[{
 "Returns an array of dimensions ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     StyleBox["m", "TI"], "+", "1"}], ",", 
    RowBox[{
     StyleBox["n", "TI"], "+", "2"}], ",", 
    StyleBox["coordinateDimension", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0a5dac22-3c60-1f40-816d-f093668f1886"],
 ". The first sample of each row is appended again to close that loop."
}], "Notes",
 CellID->159925705,ExpressionUUID->"33a1ec27-d7e9-f84f-8140-96b574546320"],

