Cell[TextData[{
 Cell[BoxData[
  StyleBox["basis", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7bf45c6a-bd5b-3940-b348-11e4790fd3d9"],
 " is a list of two side vectors. Each sampled point is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["i", "TI"], ",", 
     StyleBox["j", "TI"]}], "}"}], ".", 
   StyleBox["basis", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "88e82be9-980d-8e48-b33e-7576359afb50"],
 ", with ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f2db2114-35b3-0b4b-84a8-8856cee8275a"],
 " and ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8212d7c9-a8f1-e84f-a9de-7db708e2a1b8"],
 " running from ",
 Cell[BoxData["0."], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4cf0f708-4070-1c4c-a019-35f0fab43fed"],
 " to ",
 Cell[BoxData["1."], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bef3a4ea-d92a-ec4a-9760-0a54c96429da"],
 " in steps ",
 Cell[BoxData[
  FractionBox["1.", 
   StyleBox["m", "TI"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bd179f2e-927f-9444-9e9a-175fe74b5967"],
 " and ",
 Cell[BoxData[
  FractionBox["1.", 
   StyleBox["n", "TI"]]], "InlineFormula",
