negative values."
}], "Notes",
 CellID->1841338725,ExpressionUUID->"cd469d2f-e702-3f4e-ba07-17bc3c0c8d4d"],

Cell[TextData[{
 "Returns an array of dimensions ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     StyleBox["m", "TI"], "+", "1"}], ",", 
    RowBox[{
     StyleBox["n", "TI"], "+", "2"}], ",", 
    StyleBox["coordinateDimension", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "86896253-2c09-8742-9a5c-d43aab001fa7"],
 ". The first sample of each row is appended again to close that loop."
}], "Notes",
 CellID->572879572,ExpressionUUID->"bc9b7c0f-519f-114b-8005-0c94adae13ce"],

