  "5178e2d6-c76e-6249-9926-2e9b5c1713b5"],
 "."
}], "Notes",
 CellID->1820801519,ExpressionUUID->"7275db3e-0948-3445-9a53-81d480323425"],

Cell[TextData[{
 "Use positive integers ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c5c3d410-d61c-134c-b69c-011d64ba860b"],
 " and ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9f6e96f1-4c74-be4f-a83d-6a2250089851"],
