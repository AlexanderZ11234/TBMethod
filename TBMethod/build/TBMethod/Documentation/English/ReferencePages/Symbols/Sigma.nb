Cell[TextData[{
 "The implementation returns a zero sparse matrix when ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["v", "TI"], 
     TemplateBox[{}, 
      StyleBox["Frobenius", "TI"], 
      InterpretationFunction -> ("\"Frobenius\""& )]},
    StyleBox["Norm2", "TI"]], "<", 
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Im"]], "paclet:ref/Im"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    StyleBox["z", "TI"], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9844ea76-06a1-634b-bbb8-a25e0bd37c48"],
 ". Use a positive broadening sufficiently small relative to the interface \
coupling."
}], "Notes",
 CellID->1008883225,ExpressionUUID->"77567f28-9f35-1a4b-b381-3bc932f66096"],

Cell[TextData[{
 "For an ordinary Hermitian interface, the self-energy is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"\[CapitalSigma]", "(", "z", ")"}], "\[LongEqual]", 
     RowBox[{"V", ".", 
      RowBox[{
       SubscriptBox["g", "s"], "(", "z", ")"}], ".", 
      TemplateBox[{"V"},
       "ConjugateTranspose"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "fd9721f9-95a0-fb4a-b194-02da86ac48ec"]
}], "Notes",
 CellID->474679225,ExpressionUUID->"abcca86d-6aaa-314a-9df4-797a1dc135f3"]
}, Closed]],

