Cell[TextData[{
 "The implementation returns a zero sparse matrix when ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["v", "TI"], 
     TemplateBox[{}, "Frobenius", 
      InterpretationFunction -> ("\"Frobenius\""& )]},
    "Norm2"], "<", 
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Im"]], "paclet:ref/Im"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    StyleBox["z", "TI"], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "82db8db7-634f-254e-b95e-c765923b895a"],
 ". Use a positive broadening sufficiently small relative to the interface \
coupling."
}], "Notes",
 CellID->1636845328,ExpressionUUID->"b5f7cbc3-f06d-b048-bb62-f6666040c034"],

Cell[TextData[{
 "For an ordinary Hermitian interface, the self-energy is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"\[CapitalSigma]", "(", "z", ")"}], "\[LongEqual]", 
     RowBox[{"V", ".", 
      RowBox[{
       SubscriptBox["g", "s"], "(", "z", ")"}], ".", 
      TemplateBox[{"V"},
       "ConjugateTranspose"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "b2ddfb8f-aa9f-8f4f-b930-61f339653b70"]
}], "Notes",
 CellID->1053615207,ExpressionUUID->"b20e8e09-a982-e24b-9181-0396ee45f898"]
}, Closed]],

