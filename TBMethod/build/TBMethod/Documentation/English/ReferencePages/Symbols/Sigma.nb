Cell[TextData[{
 "The implementation returns a zero sparse matrix when ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["v", "TI"], 
     TemplateBox[{}, "Frobenius", 
      InterpretationFunction -> ("\"Frobenius\""& )]},
    "Norm2"], "<", 
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Im"]], "paclet:ref/Im"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    StyleBox["z", "TI"], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4949a4ba-e68f-c34c-ab57-8472afc01e21"],
 ". Use a positive broadening sufficiently small relative to the interface \
coupling."
}], "Notes",
 CellID->1636845328,ExpressionUUID->"a1332097-c290-eb49-9368-87076dd628c7"],

Cell[TextData[{
 "For an ordinary Hermitian interface, the self-energy is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"\[CapitalSigma]", "(", "z", ")"}], "\[LongEqual]", 
     RowBox[{"V", ".", 
      RowBox[{
       SubscriptBox["g", "s"], "(", "z", ")"}], ".", 
      TemplateBox[{"V"},
       "ConjugateTranspose"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "aa016312-6490-274f-8e9e-a10b1717fd08"]
}], "Notes",
 CellID->1053615207,ExpressionUUID->"4572349d-4b3a-d848-a2f7-2fdc610300ea"]
}, Closed]],

