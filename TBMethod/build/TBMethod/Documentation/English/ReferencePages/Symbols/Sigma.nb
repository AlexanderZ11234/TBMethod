Cell[TextData[{
 "The current implementation returns a zero sparse matrix when ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"v", 
     TemplateBox[{}, "Frobenius", 
      InterpretationFunction -> ("\"Frobenius\""& )]},
    "Norm2"], "<", 
   RowBox[{"Im", "[", "z", "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b0ff72d4-44be-b64a-84e2-39b989e17d06"],
 ". Use a positive broadening sufficiently small relative to the interface \
coupling."
}], "Notes",
 CellID->805831218,ExpressionUUID->"5a61240a-7995-2045-982b-9545fc45f596"],

Cell[TextData[{
 "For an ordinary Hermitian interface, the self-energy is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"\[CapitalSigma]", "(", "z", ")"}], "\[LongEqual]", 
     RowBox[{"V", ".", 
      RowBox[{
       SubscriptBox["g", "s"], "(", "z", ")"}], ".", 
      TemplateBox[{"V"},
       "ConjugateTranspose"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "3402b11a-5963-ed4b-9567-c34125fa6f33"]
}], "Notes",
 CellID->1781743099,ExpressionUUID->"cf9ab4a3-8588-2648-aaf2-8088b9e8ac50"]
}, Closed]],

