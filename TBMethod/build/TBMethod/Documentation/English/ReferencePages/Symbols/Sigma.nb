Cell[TextData[{
 "The implementation returns a zero sparse matrix when ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"Norm", "[", 
    RowBox[{"v", ",", " ", "\"\<Frobenius\>\""}], "]"}], " ", "<", " ", 
   RowBox[{"Im", "[", "z", "]"}]}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"d4e29d4e-dc35-1448-8bc2-8be3daf7ad38"],
 ". Use a positive broadening sufficiently small relative to the interface \
coupling."
}], "Notes",
 CellID->436824892,ExpressionUUID->"35484d9f-de38-0244-8d6d-bbd5de790b5b"],

Cell[TextData[{
 "For an ordinary Hermitian interface, the self-energy is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"\[CapitalSigma]", "(", "z", ")"}], "\[LongEqual]", 
     RowBox[{"V", ".", 
      RowBox[{
       SubscriptBox["g", "s"], "(", "z", ")"}], ".", 
      TemplateBox[{"V"},
       "ConjugateTranspose"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "13ecccbb-160d-7848-8819-797d80fecbe8"]
}], "Notes",
 CellID->1446678083,ExpressionUUID->"21e5c269-1767-0c46-a812-1efa9b2b2095"]
}, Closed]],

