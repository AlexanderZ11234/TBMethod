Cell[TextData[{
 "At complex energy, the two interface factors contain the same ",
 Cell[BoxData[
  FormBox[
   TagBox["z",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "8a904f6c-115e-6d48-956c-7cea0543bf1d"],
 ":",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"\[CapitalSigma]", "(", "z", ")"}], "\[LongEqual]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"V", "-", 
        RowBox[{"z", " ", "S"}]}], ")"}], ".", 
      RowBox[{
       SubscriptBox["g", "s"], "(", "z", ")"}], ".", 
      RowBox[{"(", 
       RowBox[{
        TemplateBox[{"V"},
         "ConjugateTranspose"], "-", 
        RowBox[{"z", " ", 
         TemplateBox[{"S"},
          "ConjugateTranspose"]}]}], ")"}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "1be4fda8-5f53-f541-ae30-1cbc78af8ad2"]
}], "Notes",
 CellID->546351578,ExpressionUUID->"6abdd376-f059-9d41-bde6-bb88a552b1fd"]
}, Closed]],

