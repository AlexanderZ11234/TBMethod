Cell[TextData[{
 "At complex energy, the two interface factors contain the same z:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"\[CapitalSigma]", "(", "z", ")"}], "\[LongEqual]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"V", "-", 
        RowBox[{"z", " ", "S"}]}], ")"}], ".", 
      RowBox[{
       SubscriptBox["g", "s"], "(", "z", ")"}], ".", 
      RowBox[{"(", 
       RowBox[{
        TemplateBox[{"V"},
         "ConjugateTranspose"], "-", 
        RowBox[{"z", " ", 
         TemplateBox[{"S"},
          "ConjugateTranspose"]}]}], ")"}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "569de292-b76c-0149-acf6-a7237a50b4e9"]
}], "Notes",
 CellID->380730066,ExpressionUUID->"8ddf1752-8c84-5b44-8199-212ddf726b4b"]
}, Closed]],

