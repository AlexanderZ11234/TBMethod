Cell[TextData[{
 "At complex energy, the two interface factors contain the same ",
 Cell[BoxData[
  FormBox[
   TagBox["z",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "d0a2473e-8cc0-6e47-8947-5074a1926930"],
 ":",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"\[CapitalSigma]", "(", "z", ")"}], "\[LongEqual]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"V", "-", 
        RowBox[{"z", " ", "S"}]}], ")"}], ".", 
      RowBox[{
       SubscriptBox["g", "s"], "(", "z", ")"}], ".", 
      RowBox[{"(", 
       RowBox[{
        TemplateBox[{"V"},
         "ConjugateTranspose"], "-", 
        RowBox[{"z", " ", 
         TemplateBox[{"S"},
          "ConjugateTranspose"]}]}], ")"}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "3465f36f-60ac-f048-b727-22a62a7ee768"]
}], "Notes",
 CellID->903915518,ExpressionUUID->"aafaacf5-435b-1b41-bb6a-da30d61d21d2"]
}, Closed]],

