Cell[TextData[{
 "At complex energy, the two interface factors contain the same ",
 Cell[BoxData[
  FormBox[
   TagBox["z",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "3c9fdf2b-8658-2a4b-9273-49be21543c45"],
 ":",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"\[CapitalSigma]", "(", "z", ")"}], "\[LongEqual]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"V", "-", 
        RowBox[{"z", " ", "S"}]}], ")"}], ".", 
      RowBox[{
       SubscriptBox["g", "s"], "(", "z", ")"}], ".", 
      RowBox[{"(", 
       RowBox[{
        TemplateBox[{"V"},
         "ConjugateTranspose"], "-", 
        RowBox[{"z", " ", 
         TemplateBox[{"S"},
          "ConjugateTranspose"]}]}], ")"}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "539c73d7-5ca6-ca48-abdc-1e7cf3f39bc4"]
}], "Notes",
 CellID->625189262,ExpressionUUID->"df425119-af33-344f-885b-128f1cce9523"]
}, Closed]],

