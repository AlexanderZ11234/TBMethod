  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"e9da13c3-5608-1940-b494-b7eafcd99dac"],
