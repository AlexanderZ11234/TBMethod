Cell[TextData[{
 Cell[BoxData[
  StyleBox["matrixModulation", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ebee2e4b-7f99-c946-a30e-acbe988145c9"],
 " is a periodic matrix-valued function of a dimensionless angle. Its \
dimensions are inferred by evaluating ",
 Cell[BoxData[
  RowBox[{
   StyleBox["matrixModulation", "TI"], "[", "0.123", "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "716d348e-1bc9-b641-a2b4-87805fa7bed2"],
 "."
}], "Notes",
 CellID->1331243715,ExpressionUUID->"aa485d1f-506c-fc4a-8192-82eb9dc59cd0"],

Cell[TextData[{
 "Returns two rank-4 tensors with axes ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["internalRow", "TI"], ",", 
    StyleBox["internalColumn", "TI"], ",", 
    StyleBox["photonRow", "TI"], ",", 
    StyleBox["photonColumn", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b8f4d4da-ba03-a149-9bd9-20c60f6bf347"],
 ". Photon indices run from ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"-", "m"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "9d745f16-7336-c44f-8947-db038d480553"],
 " through ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2e1c145f-0c01-f84d-b1ac-193c3830c54a"],
 "."
}], "Notes",
 CellID->697144935,ExpressionUUID->"785839a3-146a-074f-90c3-e2f519b633e1"],

Cell[TextData[{
 "For distinct sites, the first tensor contains Fourier coefficients at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["columnIndex", "TI"], "-", 
   StyleBox["rowIndex", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c0786aa8-2ed8-8f44-bcf6-e835810b3dba"],
 " and the second is zero. For coincident sites, the first is the \
internal/photon identity tensor and the second includes the Fourier tensor \
and a diagonal photon-energy shift of ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"-", "n"}], " ", "\[Omega]"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "1bd2de90-eaa4-9d4c-9bbd-c1134ff42cb1"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TagBox["n",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "a28270ef-2a41-1b44-85d8-ba7c7fd56297"],
 " is the photon index."
}], "Notes",
 CellID->839114285,ExpressionUUID->"6aeb09dd-c3b9-444d-970b-c6c0c27f3b29"],

Cell[TextData[{
 "Coincidence is detected using a distance threshold of ",
 Cell[BoxData["0.00001"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "29ac7c5b-2345-1641-ad5a-0fc788d21e10"],
 ". Combine the tensors with ",
 Cell[BoxData[
