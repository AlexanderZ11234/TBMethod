Cell[TextData[{
 Cell[BoxData[
  StyleBox["matrixModulation", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ffc1ea54-e7c3-bc4f-98ca-59c48a903a51"],
 " is a periodic matrix-valued function of a dimensionless angle. Its \
dimensions are inferred by evaluating ",
 Cell[BoxData[
  RowBox[{
   StyleBox["matrixModulation", "TI"], "[", "0.123", "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e71539d4-c164-5a43-b553-46eb4c8a5117"],
 "."
}], "Notes",
 CellID->1565103609,ExpressionUUID->"c76035f1-969d-b348-bdd6-b1191b6ff1c8"],

Cell[TextData[{
 "Returns two rank-4 tensors with axes ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["internalRow", "TI"], ",", 
    StyleBox["internalColumn", "TI"], ",", 
    StyleBox["photonRow", "TI"], ",", 
    StyleBox["photonColumn", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bb40bc94-b2a3-d84d-94fa-503d491d4c18"],
 ". Photon indices run from ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"-", "m"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "d80335cd-a391-2d41-9815-bc21d2f6c4dc"],
 " through ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1d30254e-d00a-6647-b890-fb9eed34904a"],
 "."
}], "Notes",
 CellID->123957955,ExpressionUUID->"e75279d4-8d54-1942-91f3-9f75a3863d27"],

Cell[TextData[{
 "For distinct sites, the first tensor contains Fourier coefficients at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["columnIndex", "TI"], "-", 
   StyleBox["rowIndex", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2cdd259e-9ec2-0e48-b020-6bbf18e5ca6c"],
 " and the second is zero. For coincident sites, the first is the \
internal/photon identity tensor and the second includes the Fourier tensor \
and a diagonal photon-energy shift of ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"-", "n"}], " ", "\[Omega]"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "21eabd65-edc2-9a43-b399-fbab87f67390"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TagBox["n",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "cb0799cf-460f-1f44-a4dc-958a79d0b0ee"],
 " is the photon index."
}], "Notes",
 CellID->1061837692,ExpressionUUID->"bbaa69f1-464a-7142-b466-91cbc1c42fde"],

Cell[TextData[{
 "Coincidence is detected using a distance threshold of ",
 Cell[BoxData["0.00001"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "efd2630a-ab8b-7c4f-99ed-8454914e8020"],
 ". Combine the tensors with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PhotonDressTensor"]], "paclet:TBMethod/ref/PhotonDressTensor", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b1549593-de59-f44c-a1ff-7982d756c739"],
 "."
}], "Notes",
 CellID->1180924330,ExpressionUUID->"a549d0d3-f178-344f-bc26-2954711745b0"],

