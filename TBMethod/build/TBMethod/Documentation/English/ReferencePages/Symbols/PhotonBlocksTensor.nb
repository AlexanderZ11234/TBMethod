Cell[TextData[{
 Cell[BoxData[
  StyleBox["matrixModulation", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "04c86e66-068b-2449-ad71-b4d1eb20bcd4"],
 " is a periodic matrix-valued function of a dimensionless angle. Its \
dimensions are inferred by evaluating ",
 Cell[BoxData[
  RowBox[{"matrixModulation", "[", "0.123", "]"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"e0b828a8-f15f-294c-a8ef-060cca274721"],
 "."
}], "Notes",
 CellID->1235804875,ExpressionUUID->"270ea38c-a3b5-3140-9b56-bc7cb5c3d63d"],

Cell[TextData[{
 "Returns two rank-4 tensors with axes ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
   "internalRow", ",", " ", "internalColumn", ",", " ", "photonRow", ",", " ",
     "photonColumn"}], "}"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"f8674914-7e1e-e449-a97e-e7b55c736554"],
 ". Photon indices run from ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"-", "m"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "b08e470a-a0aa-7e42-a206-891d06136b16"],
 " through ",
 Cell[BoxData[
  StyleBox["m", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c7392973-b921-b94e-9b53-48d43d180002"],
 "."
}], "Notes",
 CellID->1099064888,ExpressionUUID->"efae1b26-3f98-1f46-858f-61b0f73cbf5f"],

Cell[TextData[{
 "For distinct sites, the first tensor contains Fourier coefficients at ",
 Cell[BoxData[
  RowBox[{"columnIndex", " ", "-", " ", "rowIndex"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"22fd0171-51d8-c14f-9e63-868d5b7608d4"],
 " and the second is zero. For coincident sites, the first is the \
internal/photon identity tensor and the second includes the Fourier tensor \
and a diagonal photon-energy shift of ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"-", "n"}], " ", "\[Omega]"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "77aed18d-cddb-f64e-a275-539f2e643de6"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TagBox["n",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "d7e93962-ce09-7a48-be70-c2176e346915"],
 " is the photon index."
}], "Notes",
 CellID->358952522,ExpressionUUID->"40ff1050-cacd-a24f-831f-91eeed70ec4c"],

Cell[TextData[{
 "Coincidence is detected using a distance threshold of ",
