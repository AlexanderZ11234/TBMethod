Partition a three-site chain into one-site layers and construct its blocks.\
\>", "ExampleText",
 CellID->807862906,ExpressionUUID->"3615fd35-fa67-384c-8d1d-f7b70247bebb"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1144709224,ExpressionUUID->"5624635f-6306-ea4e-9e0b-276a4abba2da"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ParallelNeeds", "[", "\"\<TBMethod`\>\"", "]"}], ";", 
  RowBox[{"layers", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"1", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"0.`", ",", "0.`"}], "}"}], "}"}]}], ",", 
     RowBox[{"2", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1.`", ",", "0.`"}], "}"}], "}"}]}], ",", 
     RowBox[{"3", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"2.`", ",", "0.`"}], "}"}], "}"}]}]}], "]"}]}], ";", 
  RowBox[{"hop", "=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rf", ",", "ri"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          TemplateBox[{
            RowBox[{"rf", "-", "ri"}]},
           "Norm"], "<", "0.001`"}], ",", "0.`", ",", 
         RowBox[{"-", "1.`"}]}], "]"}], "}"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"result", "=", 
   RowBox[{"ParallelHCSRDiagOffDiagBlocks", "[", 
    RowBox[{"layers", ",", "hop", ",", "1.01`"}], "]"}]}], ";", 
  "result"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->1810506236,ExpressionUUID->"efab0559-3a33-bc40-85c7-1920dab4f29e"],

