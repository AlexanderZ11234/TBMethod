  "d08abe4f-2ae3-b244-b971-4a2ee9bddfbb"],
 ", ",
 Cell[BoxData["15"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "814f1b36-1a6e-d84a-9a43-b40a39654a74"],
 ", or ",
 Cell[BoxData["19"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "06b935c9-67fe-dd46-868e-899beba237a9"],
 ". Their arrangement must provide the representative cells required by the \
