  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c6d28342-0c8d-594d-8cac-cf294e158902"],
 ", ",
 Cell[BoxData["7"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
