Cell[TextData[{
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4aa4694c-84db-1d4c-af90-2c9c1e79d908"],
 " and ",
 Cell[BoxData[
  StyleBox["boundaryDirection", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "14e458ca-2d2e-5a48-9db4-3f6ff7928e39"],
 " are two- or three-component vectors. Cells are grouped by the norm of \
their displacement projected onto ",
 Cell[BoxData[
  StyleBox["boundaryDirection", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0d1cff6d-edb0-2e4e-bf9b-61698eb91290"],
 ", then ordered by displacement norm within each group."
}], "Notes",
 CellID->628755215,ExpressionUUID->"1ba5b0ae-403a-7747-b09d-0e447a87bc0c"],

Cell[TextData[{
 "The implementation accepts cell associations of lengths ",
 Cell[BoxData["4"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "091eaabc-0795-d341-b459-befff1ff3fc2"],
 ", ",
 Cell[BoxData["7"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
