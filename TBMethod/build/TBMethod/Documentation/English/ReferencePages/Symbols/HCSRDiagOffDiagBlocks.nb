Cell[BoxData[
 RowBox[{
  RowBox[{"layers", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"1", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"0.`", ",", "0.`"}], "}"}], "}"}]}], ",", 
     RowBox[{"2", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1.`", ",", "0.`"}], "}"}], "}"}]}], ",", 
     RowBox[{"3", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"2.`", ",", "0.`"}], "}"}], "}"}]}]}], "]"}]}], ";", 
  RowBox[{"hop", "=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rf", ",", "ri"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          TemplateBox[{
            RowBox[{"rf", "-", "ri"}]},
           "Norm"], "<", "0.001`"}], ",", "0.`", ",", 
         RowBox[{"-", "1.`"}]}], "]"}], "}"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"result", "=", 
   RowBox[{"HCSRDiagOffDiagBlocks", "[", 
    RowBox[{"layers", ",", "hop", ",", "1.01`"}], "]"}]}], ";", 
  "result"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->894230447,ExpressionUUID->"13c3d99c-d8f2-b84f-b2b8-6cf33124df3a"],

