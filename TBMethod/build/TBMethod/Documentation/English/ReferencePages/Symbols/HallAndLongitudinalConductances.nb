  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9a7d536e-5100-0244-bda6-d4619bedf534"],
 " applies. Zero or nonnumeric resistance pairs cannot be converted \
meaningfully."
}], "Notes",
 CellID->1165545688,ExpressionUUID->"7c4598fd-9565-f04c-a882-c12533234484"],

Cell[TextData[{
 "The conversion applied to the resistance pair is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["\[Sigma]", "xy"], ",", 
       SubscriptBox["\[Sigma]", "xx"]}], "}"}], "\[LongEqual]", 
     FractionBox[
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         SubscriptBox["R", "H"]}], ",", 
        SubscriptBox["R", "L"]}], "}"}], 
      RowBox[{
       SubsuperscriptBox["R", "H", "2"], "+", 
       SubsuperscriptBox["R", "L", "2"]}]]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "1c4b8a59-086f-eb49-8d68-01c8a0979e62"]
}], "Notes",
 CellID->1303169301,ExpressionUUID->"8eeaff31-ce0e-954d-9e0f-3353adb35ce0"]
}, Closed]],

