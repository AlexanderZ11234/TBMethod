Cell[TextData[{
 "The conversion applied to the resistance pair is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["\[Sigma]", "xy"], ",", 
       SubscriptBox["\[Sigma]", "xx"]}], "}"}], "\[LongEqual]", 
     FractionBox[
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         SubscriptBox["R", "H"]}], ",", 
        SubscriptBox["R", "L"]}], "}"}], 
      RowBox[{
       SubsuperscriptBox["R", "H", "2"], "+", 
       SubsuperscriptBox["R", "L", "2"]}]]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "03f36594-9008-4d40-b7ac-032eb1c7f622"]
}], "Notes",
 CellID->1303169301,ExpressionUUID->"87fb9f09-6cd9-c64b-ba79-fa4a9565b65a"]
}, Closed]],

