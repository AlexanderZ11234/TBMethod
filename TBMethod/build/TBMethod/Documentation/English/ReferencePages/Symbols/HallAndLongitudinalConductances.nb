Cell[TextData[{
 "The conversion applied to the resistance pair is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["\[Sigma]", "xy"], ",", 
       SubscriptBox["\[Sigma]", "xx"]}], "}"}], "\[LongEqual]", 
     FractionBox[
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         SubscriptBox["R", "H"]}], ",", 
        SubscriptBox["R", "L"]}], "}"}], 
      RowBox[{
       SubsuperscriptBox["R", "H", "2"], "+", 
       SubsuperscriptBox["R", "L", "2"]}]]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "3c0a4a36-dfda-864e-a7d0-1e062e3f17ad"]
}], "Notes",
 CellID->649477282,ExpressionUUID->"e2f26924-f3bc-2444-b0c8-40750537e185"]
}, Closed]],

