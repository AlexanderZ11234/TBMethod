Cell[TextData[{
 "The conversion applied to the resistance pair is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["\[Sigma]", "xy"], ",", 
       SubscriptBox["\[Sigma]", "xx"]}], "}"}], "\[LongEqual]", 
     FractionBox[
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         SubscriptBox["R", "H"]}], ",", 
        SubscriptBox["R", "L"]}], "}"}], 
      RowBox[{
       SubsuperscriptBox["R", "H", "2"], "+", 
       SubsuperscriptBox["R", "L", "2"]}]]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "1b831f3b-4f75-804f-b644-95a1cbead10a"]
}], "Notes",
 CellID->635070969,ExpressionUUID->"5a548785-9a48-3b4f-b9e4-59de96b3f935"]
}, Closed]],

