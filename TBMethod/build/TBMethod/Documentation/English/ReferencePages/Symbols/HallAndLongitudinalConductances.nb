 CellID->246974084,ExpressionUUID->"fdf04b36-793c-3b4b-a512-83af76c9c94d"],

Cell[TextData[{
 "The same ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LUDecomposition"]], "paclet:ref/LUDecomposition"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "29ff2832-2aae-9d48-b58f-affaa40245f4"],
 " compatibility limitation as in ",
