 CellID->246974084,ExpressionUUID->"55eeb272-a684-ac47-9175-70ecc8bb7bab"],

Cell[TextData[{
 "The same ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LUDecomposition"]], "paclet:ref/LUDecomposition"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dcfa46fc-8d6a-4249-bfea-28c23259f2f1"],
 " compatibility limitation as in ",
