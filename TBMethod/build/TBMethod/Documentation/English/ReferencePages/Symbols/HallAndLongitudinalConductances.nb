Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->341370439,ExpressionUUID->"1e6d1040-6dc5-1945-a1d0-25db00e6307b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"z", "=", 
   RowBox[{"0.2`", "\[VeryThinSpace]", "+", 
    RowBox[{"0.01`", " ", "\[ImaginaryI]"}]}]}], ";", 
  RowBox[{"hRing", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"i", "-", "j"}], ",", "5"}], "]"}], "\[Equal]", "1"}], ",", 
       
       RowBox[{"-", 
        RowBox[{"Exp", "[", 
         RowBox[{"0.2`", " ", "\[ImaginaryI]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"j", "-", "i"}], ",", "5"}], "]"}], "\[Equal]", "1"}], ",", 
       
       RowBox[{"-", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "0.2`"}], " ", "\[ImaginaryI]"}], "]"}]}], ",", "True",
        ",", "0.`"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "5"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"blocks", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"hRing", ",", "hRing"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.3`"}], " ", 
       RowBox[{"IdentityMatrix", "[", "5", "]"}]}], "}"}]}], "}"}]}], ";", 
  RowBox[{"leads", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", "0.`", "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"-", "1.`"}], "}"}], "}"}], ",", 
       RowBox[{"List", "/@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "0.5`"}], " ", 
          RowBox[{"UnitVector", "[", 
           RowBox[{"5", ",", "j"}], "]"}]}], ")"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "5"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"r", "=", 
   RowBox[{"HallAndLongitudinalResistances", "[", 
    RowBox[{"z", ",", "blocks", ",", "leads", ",", 
     RowBox[{"\"\<SigmaMode\>\"", "\[Rule]", "1"}]}], "]"}]}], ";", 
  RowBox[{"result", "=", 
   RowBox[{"HallAndLongitudinalConductances", "[", 
    RowBox[{"z", ",", "blocks", ",", "leads", ",", 
     RowBox[{"\"\<SigmaMode\>\"", "\[Rule]", "1"}]}], "]"}]}], ";", 
  "result"}]], "Input",
 CellLabel->"In[2]:=",
