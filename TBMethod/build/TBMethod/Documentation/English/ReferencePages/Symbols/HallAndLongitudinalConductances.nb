Cell[TextData[{
 "The conversion applied to the resistance pair is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["\[Sigma]", "xy"], ",", 
       SubscriptBox["\[Sigma]", "xx"]}], "}"}], "\[LongEqual]", 
     FractionBox[
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         SubscriptBox["R", "H"]}], ",", 
        SubscriptBox["R", "L"]}], "}"}], 
      RowBox[{
       SubsuperscriptBox["R", "H", "2"], "+", 
       SubsuperscriptBox["R", "L", "2"]}]]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "1bdd4550-ec17-db4a-a0d0-9d58fd232cd1"]
}], "Notes",
 CellID->769332842,ExpressionUUID->"7425c84a-0adf-cc4f-90f1-905bb764062a"]
}, Closed]],

