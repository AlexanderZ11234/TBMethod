Cell["\<\
A trivial chiral Hamiltonian with identity polar factor has zero Bott \
expression.\
\>", "ExampleText",
 CellID->935892015,ExpressionUUID->"caabc15b-8fbf-de47-a8f9-327e52f35f40"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->235469769,ExpressionUUID->"b3191a5a-7683-894d-b9b6-c7d59bacbd1e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"points", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.`", ",", "0.`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.5`", ",", "0.`"}], "}"}]}], "}"}]}], ";", 
  RowBox[{"chiral", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "3", "]"}], ",", 
     RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}]}], ";", 
  RowBox[{"h0", "=", 
   RowBox[{"N", "[", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "1", "]"}], ",", 
      RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}], "]"}]}], ";", 
  RowBox[{"generator", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], " ", 
     RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "&"}]}], ";", 
  RowBox[{"result", "=", 
   RowBox[{
    RowBox[{"BottIndex", "[", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", "points", ",", "chiral",
       ",", "generator"}], "]"}], "[", "h0", "]"}]}], ";", 
  "result"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->1151756478,ExpressionUUID->"f72a6d9e-cf3f-3543-bbad-78ae34979e96"],

