Cell[TextData[{
 "The curried setup converts each point to lattice coordinates using ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LinearSolve"]], "paclet:ref/LinearSolve"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "[", 
   RowBox[{
    TemplateBox[{
      StyleBox["unitBasis", "TI"]},
     "Transpose"], ",", 
    StyleBox["point", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9823d17f-e661-1341-84b4-69f3b8919135"],
 ". The coordinate-dependent ",
 Cell[BoxData[
  StyleBox["generator", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "be21e468-baf8-214d-9486-b04275e1908d"],
 " must return a matrix."
}], "Notes",
 CellID->964787833,ExpressionUUID->"2e8f1d0d-13f1-3d4b-b8cf-14cf89c1d277"],

Cell[TextData[{
 "The Hamiltonian is transformed to the sorted eigenbasis of ",
 Cell[BoxData[
  StyleBox["chiralOperator", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "16fb31ef-a144-2a40-81d2-3ea7e55d6daa"],
 ". The extracted square off-diagonal block has dimension ",
 Cell[BoxData[
  RowBox[{"2", " ", 
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Length"]], "paclet:ref/Length"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    StyleBox["points", "TI"], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "723a626b-8b31-444b-b135-decd2182fedd"],
 ", so the intended full Hamiltonian dimension is ",
 Cell[BoxData[
  RowBox[{"4", " ", 
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Length"]], "paclet:ref/Length"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    StyleBox["points", "TI"], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "790f81c0-4337-964c-9695-de5ed159f3bb"],
 "."
}], "Notes",
 CellID->584931601,ExpressionUUID->"01507df5-7ba5-c64b-a36a-6cf243d98272"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SingularValueDecomposition"]], 
    "paclet:ref/SingularValueDecomposition"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bf59cd1c-0e15-0345-9cef-42472e47e90d"],
 " of this block supplies its unitary polar factor. The coordinate unitary is \
assembled from block-diagonal matrices of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MatrixExp"]], "paclet:ref/MatrixExp"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "[", 
   RowBox[{"2", " ", 
    StyleBox["\[Pi]", "TI"], " ", "\[ImaginaryI]", " ", 
    RowBox[{
     StyleBox["generator", "TI"], "[", 
     StyleBox["coord", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "488623be-4943-e742-bee2-f89d772f825b"],
 "."
}], "Notes",
 CellID->1662175858,ExpressionUUID->"00cb7363-afd7-2943-8fe3-71b509ebbab7"],

Cell[TextData[{
 "A list of generators returns one value per generator and uses ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ParallelTable"]], "paclet:ref/ParallelTable"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fcfa8323-5f6a-084b-a44c-0be15ade90d2"],
 " to construct the coordinate blocks."
}], "Notes",
 CellID->1276499139,ExpressionUUID->"3a4dd4ec-e5dc-4c4a-980d-5ca04a354f71"],

Cell["\<\
The single-generator example uses a gapped trivial chiral model and runs \
serially. A physical invariant requires compatible chiral sectors, generator \
dimensions, boundary conditions, and a nonsingular relevant block.\
\>", "Notes",
 CellID->343227520,ExpressionUUID->"b117bcd5-04a9-e145-a6d5-f11eb9d8e634"],

Cell[TextData[{
 "For the polar-unitary off-diagonal block ",
 Cell[BoxData[
  FormBox[
   TagBox["Q",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "e9e9c133-8079-e445-b91c-02cd4b058659"],
 " and the position unitary ",
 Cell[BoxData[
  FormBox[
   TagBox["M",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "7afae1f6-d92c-e944-9ea1-a13cb5cb07db"],
 ", the implemented expression is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"B", "\[LongEqual]", 
     FractionBox[
      RowBox[{"Tr", "[", 
       RowBox[{"MatrixLog", "[", 
        RowBox[{"M", ".", "Q", ".", 
         TemplateBox[{"M"},
          "ConjugateTranspose"], ".", 
         TemplateBox[{"Q"},
          "ConjugateTranspose"]}], "]"}], "]"}], 
      RowBox[{"2", " ", "\[Pi]", " ", "\[ImaginaryI]"}]]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "9be30158-c5e3-0a4c-801e-f56be2b680f4"]
}], "Notes",
 CellID->1710664003,ExpressionUUID->"8ef02b0b-199d-d548-a17b-ec323f7f8c2a"]
}, Closed]],

