 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->156476923,ExpressionUUID->"6d4f30e4-c613-024b-94d6-54b7da4ea628"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"points", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.", ",", "0."}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.5", ",", "0."}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"chiral", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "3", "]"}], ",", 
     RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h0", "=", 
   RowBox[{"N", "[", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "1", "]"}], ",", 
      RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"generator", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], " ", 
     RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "&"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"BottIndex", "[", 
   RowBox[{
    RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", "points", ",", "chiral", ",",
     "generator"}], "]"}], "[", "h0", "]"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->1733511892,ExpressionUUID->"da41f500-bec6-d74d-b4cf-f13c0d810889"],

