Cell[TextData[{
 "The curried setup converts points to lattice coordinates using ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LinearSolve"]], "paclet:ref/LinearSolve"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d018553e-2158-0745-9474-292fb25a4203"],
 ". The coordinate-dependent generator must return a matrix."
}], "Notes",
 CellID->553445824,ExpressionUUID->"828504b8-4136-9e40-b25a-1b3c920f0f5b"],

Cell[TextData[{
 "The Hamiltonian is transformed to the sorted eigenbasis of ",
 Cell[BoxData[
  StyleBox["chiralOperator", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7577f2d9-ec90-e74a-911a-0c92e8157f95"],
 ". The extracted square off-diagonal block has dimension ",
 Cell[BoxData[
  RowBox[{"2", " ", 
   RowBox[{"Length", "[", "points", "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f2a65272-054a-e248-87fb-adeb41b40761"],
 ", so the intended full Hamiltonian dimension is ",
 Cell[BoxData[
  RowBox[{"4", " ", 
   RowBox[{"Length", "[", "points", "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e2f43a10-7f35-dd4e-a22c-e3039623fdd1"],
 "."
}], "Notes",
 CellID->456582489,ExpressionUUID->"3de97b11-4dd4-5b41-b281-ada57db21ccc"],

Cell["\<\
A singular-value decomposition of this block supplies its unitary polar \
factor. The coordinate unitary is assembled from block-diagonal matrix \
exponentials of the generator.\
\>", "Notes",
 CellID->580535452,ExpressionUUID->"08880957-c73d-9a4a-8b28-b8f3bf25b668"],

Cell[TextData[{
 "A list of generators returns one value per generator and uses ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ParallelTable"]], "paclet:ref/ParallelTable"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "01a98824-aa44-ed48-8aa8-42e017101342"],
 " to construct the coordinate blocks."
}], "Notes",
 CellID->1266302299,ExpressionUUID->"408c4dca-835c-1d46-acfe-e7672e8b9dbb"],

Cell["\<\
The single-generator example uses a gapped trivial chiral model and runs \
serially. A physical invariant requires compatible chiral sectors, generator \
dimensions, boundary conditions, and a nonsingular relevant block.\
\>", "Notes",
 CellID->375731042,ExpressionUUID->"335aa15e-1a0b-a547-8aed-f3bab77b415b"],

Cell[TextData[{
 "For the polar-unitary off-diagonal block Q and the position unitary M, the \
implemented expression is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"B", "\[LongEqual]", 
     FractionBox[
      RowBox[{"Tr", "[", 
       RowBox[{"MatrixLog", "[", 
        RowBox[{"M", ".", "Q", ".", 
         TemplateBox[{"M"},
          "ConjugateTranspose"], ".", 
         TemplateBox[{"Q"},
          "ConjugateTranspose"]}], "]"}], "]"}], 
      RowBox[{"2", " ", "\[Pi]", " ", "\[ImaginaryI]"}]]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "9c7458d9-8c9d-9c4e-b174-c4e67f61a33b"]
}], "Notes",
 CellID->421304330,ExpressionUUID->"8f6c9fdc-97e8-074f-adf7-7c7fb3e999bc"]
}, Closed]],

