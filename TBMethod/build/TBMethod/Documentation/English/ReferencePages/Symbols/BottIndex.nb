Cell[TextData[{
 "The curried setup converts each point to lattice coordinates using ",
 Cell[BoxData[
  RowBox[{"LinearSolve", "[", 
   RowBox[{
    RowBox[{"Transpose", "[", "unitBasis", "]"}], ",", " ", "point"}], "]"}]],
   "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"d73a7a95-4fc1-7a47-afc6-74bf41f4f5a0"],
 ". The coordinate-dependent ",
 Cell[BoxData[
  StyleBox["generator", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "119d156d-b161-1e49-ae1f-186d0f981d68"],
 " must return a matrix."
}], "Notes",
 CellID->388024790,ExpressionUUID->"dcb27b7a-757b-2b47-ba5f-21f665e75359"],

Cell[TextData[{
 "The Hamiltonian is transformed to the sorted eigenbasis of ",
 Cell[BoxData[
  StyleBox["chiralOperator", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ad465d1f-3e14-9a46-82ed-d2db32f34180"],
 ". The extracted square off-diagonal block has dimension ",
 Cell[BoxData[
  RowBox[{"2", " ", 
   RowBox[{"Length", "[", "points", "]"}]}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"01d7bdab-957b-2340-9b4f-63e7f99f7d4d"],
 ", so the intended full Hamiltonian dimension is ",
 Cell[BoxData[
  RowBox[{"4", " ", 
   RowBox[{"Length", "[", "points", "]"}]}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"97566268-1bb3-2c45-89ed-dd56387b16c1"],
 "."
}], "Notes",
 CellID->367338999,ExpressionUUID->"f42bbe88-fcf8-3c45-9881-13eccd51aa85"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SingularValueDecomposition"]], 
    "paclet:ref/SingularValueDecomposition"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6c1a83eb-6bab-e04e-9349-ee38c6af6656"],
 " of this block supplies its unitary polar factor. The coordinate unitary is \
assembled from block-diagonal matrices of ",
 Cell[BoxData[
  RowBox[{"MatrixExp", "[", 
   RowBox[{"2", " ", "Pi", " ", "I", " ", 
    RowBox[{"generator", "[", "coord", "]"}]}], "]"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"90ad786a-d0c9-ca42-9db7-03fbae0c42c2"],
 "."
}], "Notes",
 CellID->1329815141,ExpressionUUID->"5eb85099-b5eb-1645-bcac-16ce775c0dda"],

Cell[TextData[{
 "A list of generators returns one value per generator and uses ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ParallelTable"]], "paclet:ref/ParallelTable"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e101097e-86eb-f140-add6-c082227d0ca3"],
 " to construct the coordinate blocks."
}], "Notes",
 CellID->1766703645,ExpressionUUID->"47bf2e28-0b7c-9e43-bcff-2d19a685e54f"],

Cell["\<\
The single-generator example uses a gapped trivial chiral model and runs \
serially. A physical invariant requires compatible chiral sectors, generator \
dimensions, boundary conditions, and a nonsingular relevant block.\
\>", "Notes",
 CellID->239823423,ExpressionUUID->"00cbab4b-23d7-a042-b126-bfea3557af36"],

Cell[TextData[{
 "For the polar-unitary off-diagonal block ",
 Cell[BoxData[
  FormBox[
   TagBox["Q",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "b531f319-ca6c-0646-a1ab-2bf741bfce24"],
 " and the position unitary ",
 Cell[BoxData[
  FormBox[
   TagBox["M",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "55143914-c595-e641-a7b3-d04a45d74e1f"],
 ", the implemented expression is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"B", "\[LongEqual]", 
     FractionBox[
      RowBox[{"Tr", "[", 
       RowBox[{"MatrixLog", "[", 
        RowBox[{"M", ".", "Q", ".", 
         TemplateBox[{"M"},
          "ConjugateTranspose"], ".", 
         TemplateBox[{"Q"},
          "ConjugateTranspose"]}], "]"}], "]"}], 
      RowBox[{"2", " ", "\[Pi]", " ", "\[ImaginaryI]"}]]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "7cff0e5f-17d3-404b-8568-c31dcac9b0a6"]
}], "Notes",
 CellID->1563035306,ExpressionUUID->"5b78d866-2d51-fb4c-b368-7d338e29d204"]
}, Closed]],

