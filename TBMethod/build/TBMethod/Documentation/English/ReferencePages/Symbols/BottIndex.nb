Cell[TextData[{
 "The curried setup converts each point to lattice coordinates using ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LinearSolve"]], "paclet:ref/LinearSolve"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "[", 
   RowBox[{
    TemplateBox[{
      StyleBox["unitBasis", "TI"]},
     "Transpose"], ",", 
    StyleBox["point", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7e307d2a-c745-7b48-8879-204c1200be29"],
 ". The coordinate-dependent ",
 Cell[BoxData[
  StyleBox["generator", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3246fcf5-8e3f-c64a-9f11-3b8934cca5d7"],
 " must return a matrix."
}], "Notes",
 CellID->964787833,ExpressionUUID->"8ea89c70-2355-9343-ac7b-96afcbba111e"],

Cell[TextData[{
 "The Hamiltonian is transformed to the sorted eigenbasis of ",
 Cell[BoxData[
  StyleBox["chiralOperator", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0bac77f0-819f-6a47-93f9-bd0424eb88e5"],
 ". The extracted square off-diagonal block has dimension ",
 Cell[BoxData[
  RowBox[{"2", " ", 
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Length"]], "paclet:ref/Length"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    StyleBox["points", "TI"], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "58693d02-ebeb-b748-af04-7705b4d442c0"],
 ", so the intended full Hamiltonian dimension is ",
 Cell[BoxData[
  RowBox[{"4", " ", 
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Length"]], "paclet:ref/Length"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    StyleBox["points", "TI"], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dc8f2c3b-655e-e04a-9952-a2298ce34b5d"],
 "."
}], "Notes",
 CellID->584931601,ExpressionUUID->"dcf84fb5-f1bf-d141-8e84-a4615cf83964"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SingularValueDecomposition"]], 
    "paclet:ref/SingularValueDecomposition"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7c060117-e874-054c-b7ee-f12d0cc0f489"],
 " of this block supplies its unitary polar factor. The coordinate unitary is \
assembled from block-diagonal matrices of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MatrixExp"]], "paclet:ref/MatrixExp"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "[", 
   RowBox[{"2", " ", 
    StyleBox["\[Pi]", "TI"], " ", "\[ImaginaryI]", " ", 
    RowBox[{
     StyleBox["generator", "TI"], "[", 
     StyleBox["coord", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c7b100e6-1add-b94c-9533-345d5816a8c2"],
 "."
}], "Notes",
 CellID->1662175858,ExpressionUUID->"77a9755b-ee8e-d841-9c9d-8357bbfa54a8"],

Cell[TextData[{
 "A list of generators returns one value per generator and uses ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ParallelTable"]], "paclet:ref/ParallelTable"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1d14bcf4-a1a7-6b4a-b793-461da3898d1c"],
 " to construct the coordinate blocks."
}], "Notes",
 CellID->1276499139,ExpressionUUID->"06227530-cd0c-1d4f-af69-e8542908cd66"],

Cell["\<\
The single-generator example uses a gapped trivial chiral model and runs \
serially. A physical invariant requires compatible chiral sectors, generator \
dimensions, boundary conditions, and a nonsingular relevant block.\
\>", "Notes",
 CellID->343227520,ExpressionUUID->"8140eb19-09b0-744f-b08c-9500545eb94e"],

Cell[TextData[{
 "For the polar-unitary off-diagonal block ",
 Cell[BoxData[
  FormBox[
   TagBox["Q",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "57eb2352-b201-914b-a1aa-45b62d462872"],
 " and the position unitary ",
 Cell[BoxData[
  FormBox[
   TagBox["M",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "f914609e-5419-8c45-b709-3207aee85c6e"],
 ", the implemented expression is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"B", "\[LongEqual]", 
     FractionBox[
      RowBox[{"Tr", "[", 
       RowBox[{"MatrixLog", "[", 
        RowBox[{"M", ".", "Q", ".", 
         TemplateBox[{"M"},
          "ConjugateTranspose"], ".", 
         TemplateBox[{"Q"},
          "ConjugateTranspose"]}], "]"}], "]"}], 
      RowBox[{"2", " ", "\[Pi]", " ", "\[ImaginaryI]"}]]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "f99acff8-6157-6f4b-821f-e2214f239118"]
}], "Notes",
 CellID->1710664003,ExpressionUUID->"913b7fa2-dbdb-364e-9ea9-ba3ec46b33fc"]
}, Closed]],

