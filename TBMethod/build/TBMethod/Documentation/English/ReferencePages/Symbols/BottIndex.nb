Cell[TextData[{
 "The curried setup converts each point to lattice coordinates using ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LinearSolve"]], "paclet:ref/LinearSolve"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "[", 
   RowBox[{
    TemplateBox[{
      StyleBox["unitBasis", "TI"]},
     "Transpose"], ",", 
    StyleBox["point", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bb1fa813-eed1-524e-835a-0498b46e3e7e"],
 ". The coordinate-dependent ",
 Cell[BoxData[
  StyleBox["generator", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "315e6c81-9bfe-9042-9f31-d9c8d89a56e5"],
 " must return a matrix."
}], "Notes",
 CellID->964787833,ExpressionUUID->"9c46686d-1440-de4e-9f96-d8b4896637c1"],

Cell[TextData[{
 "The Hamiltonian is transformed to the sorted eigenbasis of ",
 Cell[BoxData[
  StyleBox["chiralOperator", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b731e4fa-f718-1940-b83b-2cecd608fd50"],
 ". The extracted square off-diagonal block has dimension ",
 Cell[BoxData[
  RowBox[{"2", " ", 
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Length"]], "paclet:ref/Length"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    StyleBox["points", "TI"], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f8791bc1-5cff-7a41-8527-bc38211f01bc"],
 ", so the intended full Hamiltonian dimension is ",
 Cell[BoxData[
  RowBox[{"4", " ", 
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Length"]], "paclet:ref/Length"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    StyleBox["points", "TI"], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "acea5933-1b16-f647-8962-35057749c7b3"],
 "."
}], "Notes",
 CellID->584931601,ExpressionUUID->"9e19acdf-7b30-2248-80c6-dcfa4d7557fd"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SingularValueDecomposition"]], 
    "paclet:ref/SingularValueDecomposition"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "58af4f7b-14df-c747-baa4-85063ea6560f"],
 " of this block supplies its unitary polar factor. The coordinate unitary is \
assembled from block-diagonal matrices of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MatrixExp"]], "paclet:ref/MatrixExp"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "[", 
   RowBox[{"2", " ", 
    StyleBox["\[Pi]", "TI"], " ", "\[ImaginaryI]", " ", 
    RowBox[{
     StyleBox["generator", "TI"], "[", 
     StyleBox["coord", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b883a83f-d97c-0d49-b943-b632b82ab942"],
 "."
}], "Notes",
 CellID->1662175858,ExpressionUUID->"025e7f2f-d799-1340-bc16-79922e02b5e2"],

Cell[TextData[{
 "A list of generators returns one value per generator and uses ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ParallelTable"]], "paclet:ref/ParallelTable"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e4bcf63a-f153-9344-a06b-98718b192ea9"],
 " to construct the coordinate blocks."
}], "Notes",
 CellID->1276499139,ExpressionUUID->"67f0de3a-ad92-fa44-bc0d-2ad45755e82c"],

Cell["\<\
The single-generator example uses a gapped trivial chiral model and runs \
serially. A physical invariant requires compatible chiral sectors, generator \
dimensions, boundary conditions, and a nonsingular relevant block.\
\>", "Notes",
 CellID->343227520,ExpressionUUID->"65797131-681e-2c43-b42a-ea729355be06"],

Cell[TextData[{
 "For the polar-unitary off-diagonal block ",
 Cell[BoxData[
  FormBox[
   TagBox["Q",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "1466b334-9d77-6548-a0df-6d813f83eacd"],
 " and the position unitary ",
 Cell[BoxData[
  FormBox[
   TagBox["M",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "547b3a82-3648-854e-bc88-f77486d35fde"],
 ", the implemented expression is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"B", "\[LongEqual]", 
     FractionBox[
      RowBox[{"Tr", "[", 
       RowBox[{"MatrixLog", "[", 
        RowBox[{"M", ".", "Q", ".", 
         TemplateBox[{"M"},
          "ConjugateTranspose"], ".", 
         TemplateBox[{"Q"},
          "ConjugateTranspose"]}], "]"}], "]"}], 
      RowBox[{"2", " ", "\[Pi]", " ", "\[ImaginaryI]"}]]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "40db77bd-ca2c-3e43-a57a-0f381be1bed9"]
}], "Notes",
 CellID->1710664003,ExpressionUUID->"1ecd2129-3537-a343-8370-ab2236cea880"]
}, Closed]],

