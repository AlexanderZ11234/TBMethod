Cell[TextData[{
 "The curried setup converts each point to lattice coordinates using ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LinearSolve"]], "paclet:ref/LinearSolve"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "[", 
   RowBox[{
    TemplateBox[{
      StyleBox["unitBasis", "TI"]},
     TemplateBox[{
       Cell[
        TextData["Transpose"]], "paclet:ref/Transpose"}, "RefLink", 
      BaseStyle -> {"InlineFormula"}]], ",", 
    StyleBox["point", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1bf4d99e-804b-a74b-a0f1-c3f03785b039"],
 ". The coordinate-dependent ",
 Cell[BoxData[
  StyleBox["generator", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6d4ea3a2-abe0-ad44-bfba-302cd6cf40d7"],
 " must return a matrix."
}], "Notes",
 CellID->1998836784,ExpressionUUID->"51b2b5d1-948a-f545-9031-822a473952bf"],

Cell[TextData[{
 "The Hamiltonian is transformed to the sorted eigenbasis of ",
 Cell[BoxData[
  StyleBox["chiralOperator", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2d9e5b72-57a6-d74a-a761-2c9b0ee64e66"],
 ". The extracted square off-diagonal block has dimension ",
 Cell[BoxData[
  RowBox[{"2", " ", 
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Length"]], "paclet:ref/Length"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    StyleBox["points", "TI"], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f8bde016-76db-7147-9f55-1e33c05439ab"],
 ", so the intended full Hamiltonian dimension is ",
 Cell[BoxData[
  RowBox[{"4", " ", 
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Length"]], "paclet:ref/Length"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    StyleBox["points", "TI"], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a9ef5375-35b1-5c4f-92d3-d16fd6380772"],
 "."
}], "Notes",
 CellID->1522476355,ExpressionUUID->"cc14bea8-25ef-464d-aa4b-39010527888f"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SingularValueDecomposition"]], 
    "paclet:ref/SingularValueDecomposition"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5bc3195b-8347-c046-8375-e74a9179d072"],
 " of this block supplies its unitary polar factor. The coordinate unitary is \
assembled from block-diagonal matrices of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MatrixExp"]], "paclet:ref/MatrixExp"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "[", 
   RowBox[{"2", " ", 
    StyleBox["\[Pi]", "TI"], " ", "\[ImaginaryI]", " ", 
    RowBox[{
     StyleBox["generator", "TI"], "[", 
     StyleBox["coord", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f0e5f27b-0257-b14a-8858-543edcc57477"],
 "."
}], "Notes",
 CellID->182781040,ExpressionUUID->"d9d3b371-7568-274c-b89e-12c073ff6dba"],

Cell[TextData[{
 "A list of generators returns one value per generator and uses ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ParallelTable"]], "paclet:ref/ParallelTable"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6b68cd2a-9d0e-2b43-b81a-47c7529f626e"],
 " to construct the coordinate blocks."
}], "Notes",
 CellID->1007918922,ExpressionUUID->"c5f9da75-5760-a541-a86e-1001c0d609ed"],

Cell["\<\
The single-generator example uses a gapped trivial chiral model and runs \
serially. A physical invariant requires compatible chiral sectors, generator \
dimensions, boundary conditions, and a nonsingular relevant block.\
\>", "Notes",
 CellID->546042159,ExpressionUUID->"35f3ca32-ee00-0b40-aae7-f3391bd13fe2"],

Cell[TextData[{
 "For the polar-unitary off-diagonal block ",
 Cell[BoxData[
  FormBox[
   TagBox["Q",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "13cf77ca-d499-1247-9f14-dc02ba0e59a1"],
 " and the position unitary ",
 Cell[BoxData[
  FormBox[
   TagBox["M",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "01159c59-eb6c-e144-929c-01472bd38ba5"],
 ", the implemented expression is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"B", "\[LongEqual]", 
     FractionBox[
      RowBox[{"Tr", "[", 
       RowBox[{"MatrixLog", "[", 
        RowBox[{"M", ".", "Q", ".", 
         TemplateBox[{"M"},
          "ConjugateTranspose"], ".", 
         TemplateBox[{"Q"},
          "ConjugateTranspose"]}], "]"}], "]"}], 
      RowBox[{"2", " ", "\[Pi]", " ", "\[ImaginaryI]"}]]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "55c3f673-2399-9d4a-8b10-bbc436813847"]
}], "Notes",
 CellID->1732854156,ExpressionUUID->"9cbb9610-1e0e-cc48-af99-b8e1adba4637"]
}, Closed]],

