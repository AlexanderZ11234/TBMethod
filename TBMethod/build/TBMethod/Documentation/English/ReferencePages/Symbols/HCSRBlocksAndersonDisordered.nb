Cell["\<\
Returns a list of n CSR block pairs; n defaults to 1. The input \
representation requires nonempty diagonal- and lower-block lists.\
\>", "Notes",
 CellID->701246538,ExpressionUUID->"7f8048fd-b6da-8d41-a1f9-a0a8b9a83a20"],

Cell[TextData[{
 "Each disorder channel adds ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KroneckerProduct"]], "paclet:ref/KroneckerProduct"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "57a01cd2-4e93-b64c-9e1a-88590cd825ea"],
 "[siteDiagonalRandomMatrix, internalMatrix] to every diagonal block. Site \
amplitudes are independently uniform in [-width/2,width/2]. Lower \
off-diagonal blocks are preserved."
}], "Notes",
 CellID->756988548,ExpressionUUID->"fd310b89-44d1-9c4f-aca1-fa7d8a5a1821"],

Cell["\<\
For several channels, widths and internalMatrices must have the same length. \
All internal matrices should have the same dimension compatible with the site \
ordering.\
\>", "Notes",
 CellID->438148090,ExpressionUUID->"6798df87-0f16-a74b-a63f-39b9adab6863"],

Cell["\<\
Set SeedRandom, optionally inside BlockRandom, when reproducible disorder \
examples or tests are needed.\
\>", "Notes",
 CellID->518687129,ExpressionUUID->"0214b0ee-ec6b-e044-b1fb-cf27c83aaece"]
}, Closed]],

