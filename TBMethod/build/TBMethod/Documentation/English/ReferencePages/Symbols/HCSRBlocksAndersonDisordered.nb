Cell[TextData[{
 "Returns a list of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b182128e-5e43-1647-aca9-ec11c3fbefe8"],
 " scattering-region block pairs; ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cdfde59a-b1d1-f249-98a4-39f82788acdf"],
