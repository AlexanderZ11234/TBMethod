Cell[TextData[{
 "Returns a list of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "28fe8bb0-eba9-df48-9813-1f3c28111e34"],
 " scattering-region block pairs; ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b3eb8d82-4e47-074f-85a1-f394b2918417"],
 " defaults to ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6f5a0290-ab94-c74a-8c9f-9750f23668ac"],
 ". The input representation requires nonempty diagonal- and lower-block \
lists."
}], "Notes",
 CellID->1400439078,ExpressionUUID->"533b1872-44d7-2c45-89c3-9dcf23ae4896"],

Cell[TextData[{
 "Each disorder channel adds ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["KroneckerProduct"]], "paclet:ref/KroneckerProduct"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "[", 
   RowBox[{
    StyleBox["siteDiagonalRandomMatrix", "TI"], ",", 
    StyleBox["internalMatrix", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7cc36d54-509f-2540-aee9-2d1384df3bc2"],
 " to every diagonal block. Site amplitudes are independently sampled from \
the continuous uniform distribution specified by ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomReal"]], "paclet:ref/RandomReal"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       StyleBox["width", "TI"], "2"]}], ",", 
     FractionBox[
      StyleBox["width", "TI"], "2"]}], "}"}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2abce752-6803-5a4c-9cd7-ab86a2d95045"],
 ". Lower off-diagonal blocks are preserved."
}], "Notes",
 CellID->810674417,ExpressionUUID->"93b400ab-bab3-e343-a26d-a4c65de65eff"],

Cell[TextData[{
 "For several channels, ",
 Cell[BoxData[
  StyleBox["widths", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b71b3d89-8208-af46-92d6-4b98c3311bdb"],
 " and ",
 Cell[BoxData[
  StyleBox["internalMatrices", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "441b2524-9070-3047-bbe1-54a44ef8addc"],
 " must have the same length. All internal matrices should have the same \
dimension compatible with the site ordering."
}], "Notes",
 CellID->1262669055,ExpressionUUID->"21406328-c6c6-2a46-80f1-82db828ae0e1"],

Cell[TextData[{
