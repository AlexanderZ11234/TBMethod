Cell["\<\
Returns a list of n CSR block pairs; n defaults to 1. The input \
representation requires nonempty diagonal- and lower-block lists.\
\>", "Notes",
 CellID->1788366394,ExpressionUUID->"9062e66d-328e-384f-83a2-0f49ce74bd44"],

Cell["\<\
Each disorder channel adds KroneckerProduct[siteDiagonalRandomMatrix, \
internalMatrix] to every diagonal block. Site amplitudes are independently \
uniform in [-width/2,width/2]. Lower off-diagonal blocks are preserved.\
\>", "Notes",
 CellID->1228358518,ExpressionUUID->"0dbe5413-8c6b-f44f-802a-640b1cc64527"],

Cell["\<\
For several channels, widths and internalMatrices must have the same length. \
All internal matrices should have the same dimension compatible with the site \
ordering.\
\>", "Notes",
 CellID->1683125966,ExpressionUUID->"beb710c3-fb22-5d41-b012-c90b0ba9ed66"],

Cell["\<\
Set SeedRandom, optionally inside BlockRandom, when reproducible disorder \
examples or tests are needed.\
\>", "Notes",
 CellID->754756332,ExpressionUUID->"d6a93c9f-c59f-ef40-8906-7054ba9a3ab9"]
}, Closed]],

