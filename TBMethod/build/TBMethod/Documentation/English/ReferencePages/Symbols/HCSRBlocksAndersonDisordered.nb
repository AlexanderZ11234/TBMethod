Cell[TextData[{
 "Returns a list of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3c87dd3e-bb17-1d4d-9b4f-e316f2554b34"],
