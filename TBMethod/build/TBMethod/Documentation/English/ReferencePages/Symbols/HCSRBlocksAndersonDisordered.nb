}], "Notes",
 CellID->1208942273,ExpressionUUID->"0e87fa16-5908-2e47-bb3c-3ec938ea42c9"],

Cell[TextData[{
 "Each disorder channel adds ",
 Cell[BoxData[
  RowBox[{"KroneckerProduct", "[", 
   RowBox[{"siteDiagonalRandomMatrix", ",", " ", "internalMatrix"}], "]"}]], 
  "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"fc2a4ae7-2a80-de4f-8e23-d8a4cbac5bf6"],
 " to every diagonal block. Site amplitudes are independently sampled from \
the continuous uniform distribution specified by ",
 Cell[BoxData[
  RowBox[{"RandomReal", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "width"}], "/", "2"}], ",", " ", 
     RowBox[{"width", "/", "2"}]}], "}"}], "]"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"eb5fe6d2-3f9d-1744-af19-35fca398c4a5"],
 ". Lower off-diagonal blocks are preserved."
}], "Notes",
 CellID->358040862,ExpressionUUID->"4c183a49-8d39-6047-8da9-28c2e6ce18b0"],

Cell[TextData[{
 "For several channels, ",
 Cell[BoxData[
  StyleBox["widths", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7ab6a368-e620-8c4a-8aff-caf49e04d114"],
 " and ",
 Cell[BoxData[
  StyleBox["internalMatrices", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6710be79-60cf-4a44-8857-912e27ad6efd"],
 " must have the same length. All internal matrices should have the same \
dimension compatible with the site ordering."
}], "Notes",
 CellID->680981404,ExpressionUUID->"61e2248c-73e5-ef4e-ab62-35e60f828233"],

