  FontFamily->"Source Sans Pro",ExpressionUUID->
  "343ecf85-f1f1-0a4f-9cf7-70ba6e3545e2"],
 ". The input representation requires nonempty diagonal- and lower-block \
lists."
}], "Notes",
 CellID->1400439078,ExpressionUUID->"b570fc62-587a-eb40-b6b4-d557c2cc0a20"],

Cell[TextData[{
 "Each disorder channel adds ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["KroneckerProduct"]], "paclet:ref/KroneckerProduct"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "[", 
   RowBox[{
    StyleBox["siteDiagonalRandomMatrix", "TI"], ",", 
    StyleBox["internalMatrix", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ba4b5c44-31c7-4c40-b5a6-b48b47c00c18"],
 " to every diagonal block. Site amplitudes are independently sampled from \
the continuous uniform distribution specified by ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomReal"]], "paclet:ref/RandomReal"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       StyleBox["width", "TI"], "2"]}], ",", 
     FractionBox[
      StyleBox["width", "TI"], "2"]}], "}"}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "33f70f79-c437-054a-8840-eac203fdabd7"],
 ". Lower off-diagonal blocks are preserved."
}], "Notes",
 CellID->810674417,ExpressionUUID->"bcfa71cc-6b8f-2b4d-b0b2-236737f3d81f"],

Cell[TextData[{
 "For several channels, ",
 Cell[BoxData[
  StyleBox["widths", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "31c56165-1d64-d945-bd54-0725620e0c80"],
 " and ",
 Cell[BoxData[
  StyleBox["internalMatrices", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4aa5dcfc-2857-9440-83d1-61ee0ee68cb1"],
 " must have the same length. All internal matrices should have the same \
dimension compatible with the site ordering."
}], "Notes",
 CellID->1262669055,ExpressionUUID->"0715c33d-032b-b245-a13e-91b0dce68b15"],

