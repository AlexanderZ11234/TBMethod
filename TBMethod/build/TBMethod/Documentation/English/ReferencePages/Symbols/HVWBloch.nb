Cell[TextData[{
 "The second-derivative tensor is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["W", 
       RowBox[{"{", 
        RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}]], "(", "k", ")"}], "\[LongEqual]", 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[PartialD]", "2"], 
       RowBox[{"H", "(", "k", ")"}]}], 
      RowBox[{
       RowBox[{"\[PartialD]", 
        SubscriptBox["k", "\[Alpha]"]}], "\[ThinSpace]", 
       RowBox[{"\[PartialD]", 
        SubscriptBox["k", "\[Beta]"]}]}],
      MultilineFunction->None]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "0dc1033d-47e1-514a-a789-5b9b0f4666b8"]
}], "Notes",
 CellID->710856029,ExpressionUUID->"bdffae0a-b5f2-f147-80cf-7f36b6457da8"]
}, Closed]],

