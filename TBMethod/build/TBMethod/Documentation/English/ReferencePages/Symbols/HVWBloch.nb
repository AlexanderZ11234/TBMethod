Cell[TextData[{
 "The second-derivative tensor is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["W", 
       RowBox[{"{", 
        RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}]], "(", "k", ")"}], "\[LongEqual]", 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[PartialD]", "2"], 
       RowBox[{"H", "(", "k", ")"}]}], 
      RowBox[{
       RowBox[{"\[PartialD]", 
        SubscriptBox["k", "\[Alpha]"]}], "\[ThinSpace]", 
       RowBox[{"\[PartialD]", 
        SubscriptBox["k", "\[Beta]"]}]}],
      MultilineFunction->None]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "a1d070d7-5108-3248-b5ba-91e03436c829"]
}], "Notes",
 CellID->298305175,ExpressionUUID->"523b0b92-33de-f442-a01f-6c0b8d40f4cb"]
}, Closed]],

