Cell[TextData[{
 "The second-derivative tensor is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["W", 
       RowBox[{"{", 
        RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}]], "(", "k", ")"}], "\[LongEqual]", 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[PartialD]", "2"], 
       RowBox[{"H", "(", "k", ")"}]}], 
      RowBox[{
       RowBox[{"\[PartialD]", 
        SubscriptBox["k", "\[Alpha]"]}], "\[ThinSpace]", 
       RowBox[{"\[PartialD]", 
        SubscriptBox["k", "\[Beta]"]}]}],
      MultilineFunction->None]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "97fe55b2-457b-a742-a6ba-7c5c93766f2a"]
}], "Notes",
 CellID->1127199707,ExpressionUUID->"7f3e205f-f161-624c-81af-8b9e20b83f81"]
}, Closed]],

