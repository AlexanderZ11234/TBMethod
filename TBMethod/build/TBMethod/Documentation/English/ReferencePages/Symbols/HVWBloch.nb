Cell[TextData[{
 "The second-derivative tensor is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["W", 
       RowBox[{"{", 
        RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}]], "(", "k", ")"}], "\[LongEqual]", 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[PartialD]", "2"], 
       RowBox[{"H", "(", "k", ")"}]}], 
      RowBox[{
       RowBox[{"\[PartialD]", 
        SubscriptBox["k", "\[Alpha]"]}], "\[ThinSpace]", 
       RowBox[{"\[PartialD]", 
        SubscriptBox["k", "\[Beta]"]}]}],
      MultilineFunction->None]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "02c13894-eaff-aa47-bcc2-de3bcb6d4be3"]
}], "Notes",
 CellID->1127199707,ExpressionUUID->"b2bf4848-5c86-8e4b-9529-c9456558368d"]
}, Closed]],

