Cell[TextData[{
 "The second-derivative tensor is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["W", 
       RowBox[{"{", 
        RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}]], "(", "k", ")"}], "\[LongEqual]", 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[PartialD]", "2"], 
       RowBox[{"H", "(", "k", ")"}]}], 
      RowBox[{
       RowBox[{"\[PartialD]", 
        SubscriptBox["k", "\[Alpha]"]}], "\[ThinSpace]", 
       RowBox[{"\[PartialD]", 
        SubscriptBox["k", "\[Beta]"]}]}],
      MultilineFunction->None]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "533dd8f3-ff38-5849-abc4-765b678ee641"]
}], "Notes",
 CellID->1136922352,ExpressionUUID->"d65c0110-6afc-4849-8bce-aedd5de31319"]
}, Closed]],

