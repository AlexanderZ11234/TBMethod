Cell["\<\
The output uses the same row-vector convention. Matching and distinct basis \
vectors satisfy the duality relation below.\
\>", "Notes",
 CellID->565517535,ExpressionUUID->"fe3dcc88-1996-bd4a-8b9b-f5cc5bca9aea"],

Cell["\<\
The two-dimensional implementation embeds the basis in three dimensions and \
removes the auxiliary direction.\
\>", "Notes",
 CellID->872880672,ExpressionUUID->"73b7642e-ecb9-7f45-9b36-27f682a6d3c2"],

Cell[TextData[{
 "Writing the input and output basis vectors as rows of ",
 Cell[BoxData[
  FormBox[
   TagBox["A",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "4570411a-9088-bb47-bd80-14575f112c1e"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox["B",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "9027e747-7c82-8b44-b45f-ae65ebfa0ba7"],
 ", respectively,",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"A", ".", 
      TemplateBox[{"B"},
       "Transpose"]}], "\[LongEqual]", 
     RowBox[{"2", " ", "\[Pi]", " ", "\[DoubleStruckCapitalI]"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "692b9646-a9a0-cc40-aa70-ebf3b9cb1793"]
}], "Notes",
 CellID->453631765,ExpressionUUID->"ca5f90e1-025c-4d41-9eda-964272acd346"]
}, Closed]],

