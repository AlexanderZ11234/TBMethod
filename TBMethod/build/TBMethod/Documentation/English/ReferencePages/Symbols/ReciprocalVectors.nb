Cell["\<\
The output uses the same row-vector convention. Matching and distinct basis \
vectors satisfy the duality relation below.\
\>", "Notes",
 CellID->133085853,ExpressionUUID->"dbc8cad2-f4f9-e54f-9e4d-9c516f871aa6"],

Cell["\<\
The two-dimensional implementation embeds the basis in three dimensions and \
removes the auxiliary direction.\
\>", "Notes",
 CellID->851042939,ExpressionUUID->"c65ef6d6-f213-f046-9372-a0026a70bb9d"],

Cell[TextData[{
 "Writing the input and output basis vectors as rows of ",
 Cell[BoxData[
  FormBox[
   TagBox["A",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "c3df3d61-54eb-484c-a593-56c7da0926aa"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox["B",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "f16f102b-dc1b-cf4b-bdf3-c4c4bc109f8a"],
 ", respectively,",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"A", ".", 
      TemplateBox[{"B"},
       "Transpose"]}], "\[LongEqual]", 
     RowBox[{"2", " ", "\[Pi]", " ", "\[DoubleStruckCapitalI]"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "7b749735-0cdb-9f44-bbc4-3dac566eca1e"]
}], "Notes",
 CellID->1665504958,ExpressionUUID->"aff7c123-ecf7-7e47-864e-cdd13a962871"]
}, Closed]],

