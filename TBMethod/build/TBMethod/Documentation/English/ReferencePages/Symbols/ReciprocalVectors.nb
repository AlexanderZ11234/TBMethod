Cell["\<\
basis is a nonsingular 2 by 2 or 3 by 3 matrix whose rows are real-space \
lattice vectors.\
\>", "Notes",
 CellID->961432545,ExpressionUUID->"25b449f0-71ce-d641-9672-9e3f340121f4"],

Cell["\<\
The returned rows satisfy basis . Transpose[result] == 2 Pi \
IdentityMatrix[Length[basis]].\
\>", "Notes",
 CellID->757544833,ExpressionUUID->"2c6e8a43-c450-5244-bf1c-c544609d74db"],

Cell["\<\
The three-dimensional formula is 2 Pi Inverse[Transpose[basis]]; the \
two-dimensional case embeds the basis in three dimensions and removes the \
auxiliary direction.\
\>", "Notes",
 CellID->1983848907,ExpressionUUID->"788ba39a-32d7-9644-ba06-f7de977ecc6d"]
}, Closed]],

