Cell["\<\
The output uses the same row-vector convention. Matching and distinct basis \
vectors satisfy the duality relation below.\
\>", "Notes",
 CellID->468893423,ExpressionUUID->"01e4ec76-780b-0d48-bf7b-3c6ecce6c7d2"],

Cell["\<\
The two-dimensional implementation embeds the basis in three dimensions and \
removes the auxiliary direction.\
\>", "Notes",
 CellID->387082497,ExpressionUUID->"92071ae5-de3a-a040-9824-217d544893a3"],

Cell[TextData[{
 "Writing the input and output basis vectors as rows of ",
 Cell[BoxData[
  FormBox[
   TagBox["A",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "6be1c5ea-ecb6-f747-bdf9-285dd8d2fddd"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox["B",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "74d91e50-ea4c-8f44-9738-b91fa1d20902"],
 ", respectively,",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"A", ".", 
      TemplateBox[{"B"},
       "Transpose"]}], "\[LongEqual]", 
     RowBox[{"2", " ", "\[Pi]", " ", "\[DoubleStruckCapitalI]"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "898bdb35-49d0-d14c-8e28-e001893881dd"]
}], "Notes",
 CellID->1190833524,ExpressionUUID->"acb2554d-9f8d-2d49-816e-a866ed5d9540"]
}, Closed]],

