Cell["\<\
The output uses the same row-vector convention. Matching and distinct basis \
vectors satisfy the duality relation below.\
\>", "Notes",
 CellID->133085853,ExpressionUUID->"b09916dd-2b34-184a-a9a1-cae4b831a06c"],

Cell["\<\
The two-dimensional implementation embeds the basis in three dimensions and \
removes the auxiliary direction.\
\>", "Notes",
 CellID->851042939,ExpressionUUID->"3133a65a-bc24-3543-8f27-4299827419f9"],

Cell[TextData[{
 "Writing the input and output basis vectors as rows of ",
 Cell[BoxData[
  FormBox[
   TagBox["A",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "ff0e7d0f-d3f9-504e-a6f3-f1badf0aa70b"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox["B",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "bc9f98d6-6265-5142-84a5-636d49535578"],
 ", respectively,",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"A", ".", 
      TemplateBox[{"B"},
       "Transpose"]}], "\[LongEqual]", 
     RowBox[{"2", " ", "\[Pi]", " ", "\[DoubleStruckCapitalI]"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "b173086c-8fa4-ea43-9ce1-659cb98ed652"]
}], "Notes",
 CellID->1665504958,ExpressionUUID->"5e9f4067-2cde-5148-8063-6d5d9aca1aea"]
}, Closed]],

