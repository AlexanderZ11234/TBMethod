Cell[TextData[{
 "For two internal factors, let ",
 Cell[BoxData[
  FormBox[
   TagBox["T",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "ec503932-e0fa-4545-8178-6ab1ef232fb7"],
 " denote the corresponding Pauli or Gell-Mann basis, including its identity \
element. The coefficient association represents",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"M", "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"a", "=", "0"}], 
       RowBox[{
        SubsuperscriptBox["d", "1", "2"], "-", "1"}]], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"b", "=", "0"}], 
        RowBox[{
         SubsuperscriptBox["d", "2", "2"], "-", "1"}]], 
       RowBox[{
        SubscriptBox["c", 
         RowBox[{"{", 
          RowBox[{"a", ",", "b"}], "}"}]], " ", 
        RowBox[{
         SubscriptBox["T", "a"], "\[CircleTimes]", 
         SubscriptBox["T", "b"]}]}]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "db795ffc-3edc-9643-be19-b54f90bdca2d"]
}], "Notes",
 CellID->360232743,ExpressionUUID->"4d427331-e14d-a546-9f88-ee2e7dc45c30"]
}, Closed]],

