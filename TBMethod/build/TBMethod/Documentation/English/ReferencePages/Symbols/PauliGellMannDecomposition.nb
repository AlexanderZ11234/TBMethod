Cell[TextData[{
 "For two internal factors, let ",
 Cell[BoxData[
  FormBox[
   TagBox["T",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "681e935e-6873-264b-b852-f992a3e5546b"],
 " denote the corresponding Pauli or Gell-Mann basis, including its identity \
element. The coefficient association represents",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"M", "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"a", "=", "0"}], 
       RowBox[{
        SubsuperscriptBox["d", "1", "2"], "-", "1"}]], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"b", "=", "0"}], 
        RowBox[{
         SubsuperscriptBox["d", "2", "2"], "-", "1"}]], 
       RowBox[{
        SubscriptBox["c", 
         RowBox[{"{", 
          RowBox[{"a", ",", "b"}], "}"}]], " ", 
        RowBox[{
         SubscriptBox["T", "a"], "\[CircleTimes]", 
         SubscriptBox["T", "b"]}]}]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "c8ff1556-1fb1-4745-bfc6-524affbeddc4"]
}], "Notes",
 CellID->520415275,ExpressionUUID->"31881e5d-93a6-af40-9d48-adb7bdf04e0d"]
}, Closed]],

