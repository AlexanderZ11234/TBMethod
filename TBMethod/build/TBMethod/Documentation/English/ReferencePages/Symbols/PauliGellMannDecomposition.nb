Cell["\<\
dimensions is a list of 2 and/or 3 giving the ordered internal tensor \
factors. Its product must match the square matrix dimension.\
\>", "Notes",
 CellID->663446855,ExpressionUUID->"836609ac-fe0a-e04b-b189-cdb6e0217748"],

Cell["\<\
Returns an association indexVector -> coefficient, using indices 0 through 3 \
for a dimension-2 factor and 0 through 8 for a dimension-3 factor. Zero \
entries are omitted by the sparse representation.\
\>", "Notes",
 CellID->804467955,ExpressionUUID->"c6dfe942-08ff-4c4a-b256-e2a992787575"],

Cell[TextData[{
 "Index 0 denotes the identity in either factor. Coefficients are simplified \
with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FullSimplify"]], "paclet:ref/FullSimplify"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "64b26e9e-9eb0-c54d-b4dd-88feed5aa592"],
 "."
}], "Notes",
 CellID->297317520,ExpressionUUID->"8127a871-69f8-8543-9abd-1588e59d89da"],

Cell[TextData[{
 "For two internal factors, let T denote the corresponding Pauli or Gell-Mann \
basis, including its identity element. The coefficient association represents",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"M", "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"a", "=", "0"}], 
       RowBox[{
        SubsuperscriptBox["d", "1", "2"], "-", "1"}]], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"b", "=", "0"}], 
        RowBox[{
         SubsuperscriptBox["d", "2", "2"], "-", "1"}]], 
       RowBox[{
        SubscriptBox["c", 
         RowBox[{"{", 
          RowBox[{"a", ",", "b"}], "}"}]], " ", 
        RowBox[{
         SubscriptBox["T", "a"], "\[CircleTimes]", 
         SubscriptBox["T", "b"]}]}]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "f1081b89-2870-fa4e-a7ed-6209121c8c3b"]
}], "Notes",
 CellID->826889461,ExpressionUUID->"010b3ce5-ddaa-6448-ba76-a883d12842e1"]
}, Closed]],

