Cell[TextData[{
 "For two internal factors, let ",
 Cell[BoxData[
  FormBox[
   TagBox["T",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "70ea6513-bed5-9643-ab87-e4c90ab35f4a"],
 " denote the corresponding Pauli or Gell-Mann basis, including its identity \
element. The coefficient association represents",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"M", "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"a", "=", "0"}], 
       RowBox[{
        SubsuperscriptBox["d", "1", "2"], "-", "1"}]], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"b", "=", "0"}], 
        RowBox[{
         SubsuperscriptBox["d", "2", "2"], "-", "1"}]], 
       RowBox[{
        SubscriptBox["c", 
         RowBox[{"{", 
          RowBox[{"a", ",", "b"}], "}"}]], " ", 
        RowBox[{
         SubscriptBox["T", "a"], "\[CircleTimes]", 
         SubscriptBox["T", "b"]}]}]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "37cc85e0-7efc-9e45-beb6-51a275a5fcc8"]
}], "Notes",
 CellID->1206843542,ExpressionUUID->"cdb92431-91b7-7240-bd3c-e94e56d8414a"]
}, Closed]],

