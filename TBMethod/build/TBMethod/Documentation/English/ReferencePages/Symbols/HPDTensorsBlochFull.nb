Cell["\<\
n is a nonnegative integer. The output list has n+1 elements; element p+1 \
contains the rank-p momentum-derivative tensor, ending in two matrix indices.\
\
\>", "Notes",
 CellID->751858482,ExpressionUUID->"a505fd75-5714-5140-bb87-0b41543bb193"],

Cell["\<\
The order-zero element is the Hamiltonian. No hbar factors are inserted.\
\>", "Notes",
 CellID->541633362,ExpressionUUID->"baa76cc0-76a2-ce44-bcb6-685226bdf27d"],

Cell["\<\
Every directed hopping displacement must be present in the association.\
\>", "Notes",
 CellID->1914756560,ExpressionUUID->"e2f607b5-c7e7-2340-988c-715b8bfc5a06"]
}, Closed]],

