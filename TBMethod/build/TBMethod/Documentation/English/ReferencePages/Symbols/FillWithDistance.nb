 Cell[BoxData[
  StyleBox["tolerance", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "008e3cc2-af25-514f-87e4-b0674036dba7"],
 " is ",
 Cell[BoxData["0.00001"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5b82720f-42d8-e145-9c36-b8a4fa0421a6"],
 "; the first matching branch wins."
}], "Notes",
 CellID->676272485,ExpressionUUID->"1e50ce60-0636-3f44-923d-5e1d466d87e7"],

Cell[TextData[{
 "If no branch matches, returns a zero array of the first matrix shape. ",
