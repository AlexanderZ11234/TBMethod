Cell[TextData[{
 "A branch is selected when ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     TemplateBox[{
       RowBox[{"d", "-", "shellDistance"}]},
      "Abs"], "<", "tolerance"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "8aab11a3-7334-1344-a11e-11181de12c83"],
