Cell[TextData[{
 "A branch is selected when ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     TemplateBox[{
       RowBox[{"d", "-", "shellDistance"}]},
      "Abs"], "<", "tolerance"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "7ba7c70a-c283-9641-a2e8-5e031b1ba660"],
 ". The default ",
 Cell[BoxData[
  StyleBox["tolerance", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "de19c8a2-07b0-c647-8606-08d3cde6e4a3"],
 " is ",
 Cell[BoxData["0.00001"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "39f52e27-5f9d-bc43-b0fc-e1ebfd15dc96"],
 "; the first matching branch wins."
}], "Notes",
 CellID->435767930,ExpressionUUID->"2b505526-e15e-1740-a69b-3b0b5ee5eef6"],

Cell[TextData[{
 "If no branch matches, returns a zero array of the first matrix shape. ",
