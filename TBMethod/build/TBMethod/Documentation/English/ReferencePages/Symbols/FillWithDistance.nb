Cell[TextData[{
 "A branch is selected when ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     TemplateBox[{
       RowBox[{"d", "-", "shellDistance"}]},
      "Abs"], "<", "tolerance"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "3c907176-c7c4-9545-8ecc-fc09eb0e01a6"],
