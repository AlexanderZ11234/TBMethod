Calculate two extremal energies and their inverse participation ratios in \
parallel.\
\>", "ExampleText",
 CellID->1970479020,ExpressionUUID->"03fbc9ac-683d-eb48-89b5-992bbb585942"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->606569972,ExpressionUUID->"7044a99e-92f7-2d47-a227-ebbb541dbc28"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"$KernelCount", "\[Equal]", "0"}], ",", 
    RowBox[{"LaunchKernels", "[", "2", "]"}]}], "]"}], ";", 
  RowBox[{"ParallelNeeds", "[", "\"\<TBMethod`\>\"", "]"}], ";", 
  RowBox[{"Clear", "[", "h", "]"}], ";", 
  RowBox[{
   RowBox[{"h", "[", "k_", "]"}], ":=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "4.`"}], "-", "k"}], ",", 
      RowBox[{"-", "2.`"}], ",", "1.`", ",", 
      RowBox[{"5.`", "\[VeryThinSpace]", "+", "k"}]}], "}"}], "]"}]}], ";", 
  RowBox[{"DistributeDefinitions", "[", "h", "]"}], ";", 
  RowBox[{"result", "=", 
   RowBox[{"ParallelBandDataWithWeight", "[", 
    RowBox[{"h", ",", 
     RowBox[{"{", 
      RowBox[{"0.`", ",", "0.5`"}], "}"}], ",", "2"}], "]"}]}], ";", 
  "result"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->1097328357,ExpressionUUID->"658e04a0-286d-be42-b97e-4a74ab8951bf"],

Cell[BoxData[
