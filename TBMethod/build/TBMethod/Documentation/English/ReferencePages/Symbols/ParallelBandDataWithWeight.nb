     RowBox[{
      RowBox[{
       RowBox[{"-", "4."}], "-", "k"}], ",", 
      RowBox[{"-", "2."}], ",", "1.", ",", 
      RowBox[{"5.", "\[VeryThinSpace]", "+", "k"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DistributeDefinitions", "[", "h", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ParallelBandDataWithWeight", "[", 
  RowBox[{"h", ",", 
   RowBox[{"{", 
    RowBox[{"0.", ",", "0.5"}], "}"}], ",", 
   RowBox[{"Method", "\[Rule]", "\"\<Direct\>\""}]}], "]"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->1868489109,ExpressionUUID->"e03220c7-06ca-d84a-8353-312015f2d403"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4.`"}], ",", "1.`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "2.`"}], ",", "1.`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1.`", ",", "1.`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"5.`", ",", "1.`"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
