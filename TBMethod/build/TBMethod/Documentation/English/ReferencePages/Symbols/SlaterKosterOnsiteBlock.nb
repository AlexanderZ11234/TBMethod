Cell[TextData[{
 "The d-orbital order used by the companion hopping implementation is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    SubscriptBox["d", 
     RowBox[{"x", " ", "y"}]],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
