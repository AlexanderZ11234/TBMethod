Cell["\<\
Includes two spin components for each orbital, giving dimensions 8 for sp and \
18 for spd. The s-orbital spin block is zero.\
\>", "Notes",
 CellID->1945885581,ExpressionUUID->"92062853-3aca-4748-a408-8f13070ccd53"],

Cell["\<\
The orbital ordering matches SlaterKosterHoppingBlock; each orbital is \
followed immediately by its two spin components.\
\>", "Notes",
 CellID->521060825,ExpressionUUID->"3c0c8b60-68a1-2344-9c8f-f655d15b077c"],

Cell[TextData[{
 "The supplied p and d coefficients multiply the explicit orbital matrices \
tensored with Pauli spin matrices. Choose the coefficients according to this \
convention when comparing with a convention that writes spin as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PauliMatrix"]], "paclet:ref/PauliMatrix"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "65e3ae5d-1723-0847-bab8-8f3b3032381f"],
 "/2."
}], "Notes",
 CellID->788127887,ExpressionUUID->"2d361c07-b14d-e640-9283-a69d2d1528c8"]
}, Closed]],

