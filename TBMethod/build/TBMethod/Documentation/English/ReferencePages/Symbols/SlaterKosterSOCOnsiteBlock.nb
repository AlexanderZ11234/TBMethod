Cell[TextData[{
 "Includes two spin components for each orbital, giving dimension ",
 Cell[BoxData["8"], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"4d5690d2-50c0-8448-b466-f2ca8e081ab8"],
 " for ",
 Cell[BoxData["\"\<sp\>\""], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"c5be0130-c9a0-5c4d-9e94-ad10044f7053"],
 " and ",
 Cell[BoxData["18"], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"c30bd4ea-bab5-3548-95de-cd8f7ab4797b"],
 " for ",
 Cell[BoxData["\"\<spd\>\""], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"3b86486f-05c0-fc47-a030-dada20351852"],
 ". The s-orbital spin block is zero."
}], "Notes",
 CellID->2061955574,ExpressionUUID->"72a71cba-7006-f34f-bad2-b9eaf7f58914"],

Cell[TextData[{
 "The orbital ordering matches ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SlaterKosterHoppingBlock"]], 
    "paclet:TBMethod/ref/SlaterKosterHoppingBlock", "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2d54a207-afd2-184e-be82-7866e08c5548"],
 ". Each orbital is followed immediately by its two spin components."
}], "Notes",
 CellID->622900051,ExpressionUUID->"31b71127-1441-1f45-ae59-5f816661ca28"],

Cell[TextData[{
 "The supplied p and d coefficients multiply explicit orbital matrices \
tensored with Pauli spin matrices. Choose the coefficients according to this \
convention when comparing with spin matrices written as ",
 Cell[BoxData[
  FormBox[
   TagBox[
    FractionBox[
     SubscriptBox["\[Sigma]", "a"], "2"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "8649e5ab-6e65-9840-b228-b96a65490777"],
 ", or ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"PauliMatrix", "[", "a", "]"}], "/", "2"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"9fc1c1fb-be55-3141-a000-71d5454227f7"],
 " in Wolfram Language syntax."
}], "Notes",
 CellID->2010009879,ExpressionUUID->"1e90c679-1f33-434c-b9a5-81153663dbad"]
}, Closed]],

