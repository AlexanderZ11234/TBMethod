Cell["\<\
Project a static lead with three photon sectors down to its two internal \
states.\
\>", "ExampleText",
 CellID->1963982279,ExpressionUUID->"2cb93e3c-df43-1848-8b84-000b3473380e"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1657365712,ExpressionUUID->"55772878-b188-fb4a-804d-d3671c665645"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"h0", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "3", "]"}], ",", 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}]}], ";", 
  RowBox[{"h1", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"PauliMatrix", "[", "0", "]"}], "5"]}], ",", 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}]}], ";", 
  RowBox[{"v", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"PauliMatrix", "[", "0", "]"}], "2"]}], ",", 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}]}], ";", 
  RowBox[{"csrBlocks", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"h0", ",", "h0"}], "}"}], ",", 
     RowBox[{"{", "h1", "}"}]}], "}"}]}], ";", 
  RowBox[{"result", "=", 
   RowBox[{
    RowBox[{"HLeadBlocksFloquetDownfold", "[", 
     RowBox[{"10.`", ",", "1", ",", "csrBlocks"}], "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"h0", ",", "h1", ",", "v"}], "}"}], "]"}]}], ";", 
  "result"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->1087907389,ExpressionUUID->"037263ec-ff1c-c643-8866-e76a35d08ac8"],

