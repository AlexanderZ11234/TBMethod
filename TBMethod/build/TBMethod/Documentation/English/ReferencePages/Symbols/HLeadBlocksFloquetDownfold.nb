Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"h0", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "3", "]"}], ",", 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h1", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"PauliMatrix", "[", "0", "]"}], "5"]}], ",", 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"v", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"PauliMatrix", "[", "0", "]"}], "2"]}], ",", 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"csrBlocks", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"h0", ",", "h0"}], "}"}], ",", 
     RowBox[{"{", "h1", "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"HLeadBlocksFloquetDownfold", "[", 
   RowBox[{"10.", ",", "1", ",", "csrBlocks"}], "]"}], "[", 
  RowBox[{"{", 
   RowBox[{"h0", ",", "h1", ",", "v"}], "}"}], "]"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->172854719,ExpressionUUID->"32932707-f88d-dd41-b3f1-038ccf474ce9"],

