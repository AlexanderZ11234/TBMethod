Cell[TextData[{
 "Projects the lead onsite block ",
 Cell[BoxData["h0"], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"5184a404-c96f-8d45-b4a5-eb2f64459034"],
 " and intercell block ",
 Cell[BoxData["h1"], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"0bb06fa4-d636-1843-9516-6f858f91128a"],
 " onto their photon-zero sectors. Projects the scattering-region-to-lead \
coupling ",
 Cell[BoxData["v"], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"e0357c7a-894c-f847-bf4f-88fd12fe124b"],
 " onto photon zero on both sides."
}], "Notes",
 CellID->1290905338,ExpressionUUID->"cd24a8c1-b95d-d64f-84bf-efba58b0bcf6"],

Cell[TextData[{
 "Input matrices use internal-major, photon-minor ordering with ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"2", " ", "m"}], "+", "1"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "2f8e2dfe-0c4b-bf48-a9cd-0c40d691643f"],
 " photon sectors. The result is the three-element lead block list for the \
reduced space."
}], "Notes",
 CellID->248754276,ExpressionUUID->"ac0e3f7e-ca32-dc43-bd56-281d8450d018"],

Cell[TextData[{
 "The options are ",
 Cell[BoxData[
  RowBox[{"\"\<ExpansionOrder\>\"", " ", "->", " ", "1"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"52aad501-77e9-9e41-a0f8-38c48814b4a7"],
 " and ",
 Cell[BoxData[
  RowBox[{"\"\<MicromotionCorrection\>\"", " ", "->", " ", "False"}]], 
  "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"7291d6e2-03fc-c544-a041-96aa48bbdf44"],
 ". The coupling correction is applied only when the order is ",
 Cell[BoxData["2"], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"8ccd2265-b561-4a41-b00f-2bddcde69b6c"],
 " and micromotion correction is ",
 Cell[BoxData["True"], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"4e10b67f-3186-4d4c-8e3b-f8ab415466e5"],
 ". ",
 Cell[BoxData[
  StyleBox["csrBlocks", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c66b6899-1bdd-404a-8329-5dd59c185825"],
 " supplies the extended scattering-region blocks used by that correction."
}], "Notes",
 CellID->1056443731,ExpressionUUID->"e0cfb9d7-d792-5247-89e5-a44325fe4036"],

Cell["\<\
The default behavior is projection. Use the effective-Hamiltonian routines \
when van Vleck corrections to the Hamiltonian blocks themselves are required.\
\
\>", "Notes",
 CellID->938671418,ExpressionUUID->"4267f65c-78c9-194b-8a98-2eb7b3b7ba95"]
}, Closed]],

