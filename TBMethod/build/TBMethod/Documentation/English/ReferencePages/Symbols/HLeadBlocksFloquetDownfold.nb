Cell[TextData[{
 "Projects the lead onsite block ",
 Cell[BoxData[
  StyleBox["h0", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "96df5114-005f-9440-a96f-95430b0f50be"],
 " and intercell block ",
 Cell[BoxData[
  StyleBox["h1", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d66386b9-cd75-c847-9d42-f070e0d04dfc"],
 " onto their photon-zero sectors. Projects the scattering-region-to-lead \
coupling ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "10e190c1-b842-6e4d-81dc-aeb20600b708"],
 " onto photon zero on both sides."
}], "Notes",
 CellID->1374124735,ExpressionUUID->"61b0bc04-d58a-084f-956d-aebe85976d33"],

Cell[TextData[{
 "Input matrices use internal-major, photon-minor ordering with ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"2", " ", "m"}], "+", "1"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "514b5200-8287-5c4a-82e3-9fbe670ead43"],
 " photon sectors. The result is the three-element lead block list for the \
reduced space."
}], "Notes",
 CellID->223562227,ExpressionUUID->"abcc5b0e-a9ff-d046-8955-295b060982a6"],

Cell[TextData[{
 "The options are ",
 Cell[BoxData[
  RowBox[{"\"\<ExpansionOrder\>\"", "\[Rule]", "1"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "33ab2390-2d32-3947-bd1d-ac5e7f83d0e6"],
 " and ",
 Cell[BoxData[
  RowBox[{"\"\<MicromotionCorrection\>\"", "\[Rule]", 
   TemplateBox[{
     Cell[
      TextData["False"]], "paclet:ref/False"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f39d2cdf-b686-ec4c-b6b3-9907f4aa4c81"],
 ". The coupling correction is applied only when the order is ",
 Cell[BoxData["2"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "303225ea-e8a7-4d42-b622-d6dc0c83c119"],
 " and micromotion correction is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5678dfa9-2135-a04b-88bd-96e95f6a1327"],
 ". ",
 Cell[BoxData[
  StyleBox["csrBlocks", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8442654e-09fd-8e41-a2f1-21c605c63186"],
 " supplies the extended scattering-region blocks used by that correction."
}], "Notes",
 CellID->1916914075,ExpressionUUID->"9571e7eb-07fe-4b41-91b1-532f8978ad69"],

Cell["\<\
The default behavior is projection. Use the effective-Hamiltonian routines \
when van Vleck corrections to the Hamiltonian blocks themselves are required.\
\
\>", "Notes",
 CellID->194227000,ExpressionUUID->"9b915416-39bb-1f43-9cd7-4cee7869ec0c"]
}, Closed]],

