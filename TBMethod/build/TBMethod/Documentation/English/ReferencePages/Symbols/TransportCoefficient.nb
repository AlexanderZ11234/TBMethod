Cell["\<\
Different self-energy matrices select the transmission branch.\
\>", "Notes",
 CellID->1881046227,ExpressionUUID->"43f63694-c7ee-144a-b2e4-6cb3f1c80784"],

Cell["\<\
Equal self-energy matrices select reflection, including a channel-rank \
correction. Distinct physical contacts with identical matrices therefore need \
care.\
\>", "Notes",
 CellID->1811843434,ExpressionUUID->"0c2b3724-1eed-7f46-90fb-af0238d4638b"],

Cell["zero is the tolerance used in the channel-rank calculation.", "Notes",
 CellID->960889205,ExpressionUUID->"239e5cea-fa72-6a43-9b63-8b5842e46cae"]
}, Closed]],

