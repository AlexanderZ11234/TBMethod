Cell["\<\
The shift uses the arithmetic mean of the coordinates, with equal weight for \
every supplied site.\
\>", "Notes",
 CellID->630296920,ExpressionUUID->"88cdafce-3711-344b-a3f1-72a97cdd5a87"],

Cell[TextData[{
 "Accepts a list of coordinate lists or labeled coordinate ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Rule"]], "paclet:ref/Rule"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c92583f4-56aa-4745-aed2-6786969cef47"],
 " expressions. Rule labels are preserved."
}], "Notes",
 CellID->1364553089,ExpressionUUID->"371ec823-59d3-5649-a3ab-4e16a19bb982"],

Cell[TextData[{
 "The site centroid is shifted to the origin:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SuperscriptBox[
      SubscriptBox["r", "j"], "\[Prime]",
      MultilineFunction->None], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["r", "j"], "-", 
      FractionBox[
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], "N"], 
        SubscriptBox["r", "i"]}], "N"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "d3047f8d-17e1-7f43-9e6b-4fc601043068"]
}], "Notes",
 CellID->1905272625,ExpressionUUID->"2abb00f7-fb6a-6d43-aa71-7e4341db2f3d"]
}, Closed]],

