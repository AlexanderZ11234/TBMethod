Cell["\<\
The shift uses the arithmetic mean of the coordinates, with equal weight for \
every supplied site.\
\>", "Notes",
 CellID->1824594074,ExpressionUUID->"5b6f6b05-d78f-a844-9c6a-c8e991f23687"],

Cell[TextData[{
 "Accepts a list of coordinate lists or labeled coordinate ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Rule"]], "paclet:ref/Rule"},
   "RefLink",
