Cell["\<\
The shift uses the arithmetic mean of the coordinates, with equal weight for \
every supplied site.\
\>", "Notes",
 CellID->1824594074,ExpressionUUID->"f9fdfdab-0936-6e45-a2eb-0960e13fd242"],

Cell[TextData[{
 "Accepts a list of coordinate lists or labeled coordinate ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Rule"]], "paclet:ref/Rule"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bd945c27-53d0-d542-acc7-f7c5e99febff"],
 " expressions. Rule labels are preserved."
}], "Notes",
 CellID->434557377,ExpressionUUID->"78eac54c-c220-8a4b-8119-cae80f81dc93"],

Cell[TextData[{
 "The site centroid is shifted to the origin:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SuperscriptBox[
      SubscriptBox["r", "j"], "\[Prime]",
      MultilineFunction->None], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["r", "j"], "-", 
      FractionBox[
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], "N"], 
        SubscriptBox["r", "i"]}], "N"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "6fe4448f-1c6b-214e-92d4-08881e577316"]
}], "Notes",
 CellID->816018165,ExpressionUUID->"5febd363-b148-d044-9698-5e86d5d13455"]
}, Closed]],

