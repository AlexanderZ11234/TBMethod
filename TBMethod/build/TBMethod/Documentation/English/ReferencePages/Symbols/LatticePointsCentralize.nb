Cell["\<\
Subtracts the arithmetic mean of the coordinates from every point. This is a \
point centroid, with equal weight for every supplied site.\
\>", "Notes",
 CellID->1842953133,ExpressionUUID->"4cd9053a-6d40-5a40-8992-01181ca40a20"],

Cell["\<\
Accepts a list of coordinate lists or label -> coordinates rules. The rule \
labels are preserved.\
\>", "Notes",
 CellID->1103512646,ExpressionUUID->"bda200de-6165-5b4c-aa55-061895b0e152"]
}, Closed]],

