Cell["\<\
The shift uses the arithmetic mean of the coordinates, with equal weight for \
every supplied site.\
\>", "Notes",
 CellID->796851649,ExpressionUUID->"62edeef9-0cd4-9c44-9ccd-00fdfd113c53"],

Cell["\<\
Accepts a list of coordinate lists or labeled coordinate rules. Rule labels \
are preserved.\
\>", "Notes",
 CellID->460972199,ExpressionUUID->"193a552b-4e10-fc44-a757-94aa3b62870a"],

Cell[TextData[{
 "The site centroid is shifted to the origin:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SuperscriptBox[
      SubscriptBox["r", "j"], "\[Prime]",
      MultilineFunction->None], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["r", "j"], "-", 
      FractionBox[
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], "N"], 
        SubscriptBox["r", "i"]}], "N"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "44268ef5-1536-9441-bb30-bf1a41e9c0e3"]
}], "Notes",
 CellID->175868248,ExpressionUUID->"19237691-dcb8-d243-9481-a3f73cbc174b"]
}, Closed]],

