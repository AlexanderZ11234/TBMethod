Cell[TextData[{
 "The site centroid is shifted to the origin:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SuperscriptBox[
      SubscriptBox["r", "j"], "\[Prime]",
      MultilineFunction->None], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["r", "j"], "-", 
      FractionBox[
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], "N"], 
        SubscriptBox["r", "i"]}], "N"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "417d8f28-1669-b042-a334-fd3b21733590"]
}], "Notes",
 CellID->1421980437,ExpressionUUID->"b44b28b5-e47f-a84e-839f-8920ce158872"]
}, Closed]],

