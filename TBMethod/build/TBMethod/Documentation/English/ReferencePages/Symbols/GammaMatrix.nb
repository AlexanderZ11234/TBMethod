Cell[TextData[{
 "For two indices, the construction is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"\[CapitalGamma]", "(", 
      RowBox[{"i", ",", "j"}], ")"}], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["\[Sigma]", "i"], "\[CircleTimes]", 
      SubscriptBox["\[Sigma]", "j"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
