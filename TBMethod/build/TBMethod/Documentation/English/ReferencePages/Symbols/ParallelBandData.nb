Cell["\<\
Evaluate a small band grid in parallel and compare it with the expected \
energies.\
\>", "ExampleText",
 CellID->1791918698,ExpressionUUID->"eb83db1a-29b1-734f-8ef1-7abee887cd2a"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->191228444,ExpressionUUID->"9359b4b4-3854-f24f-baa6-c51ba7d967c3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"$KernelCount", "\[Equal]", "0"}], ",", 
    RowBox[{"LaunchKernels", "[", "2", "]"}]}], "]"}], ";", 
  RowBox[{"ParallelNeeds", "[", "\"\<TBMethod`\>\"", "]"}], ";", 
  RowBox[{"Clear", "[", "h", "]"}], ";", 
  RowBox[{
   RowBox[{"h", "[", "k_", "]"}], ":=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "1.`"}], "-", "k"}], ",", 
      RowBox[{"1.`", "\[VeryThinSpace]", "+", "k"}]}], "}"}], "]"}]}], ";", 
  RowBox[{"DistributeDefinitions", "[", "h", "]"}], ";", 
  RowBox[{"result", "=", 
   RowBox[{"ParallelBandData", "[", 
    RowBox[{"h", ",", 
     RowBox[{"{", 
      RowBox[{"0.`", ",", "0.5`", ",", "1.`"}], "}"}]}], "]"}]}], ";", 
  "result"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->709725030,ExpressionUUID->"5a0d3c50-90f9-2948-ab8e-e7b700ce10aa"],

Cell[BoxData[
 RowBox[{"{", 
