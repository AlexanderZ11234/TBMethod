Cell["\<\
Uses ParallelMap over samples and otherwise follows BandData, including its \
band-by-sample output arrangement and generalized-overlap forms.\
\>", "Notes",
 CellID->927123588,ExpressionUUID->"f60ed175-7a46-874b-9e7e-ceb8867bff77"],

Cell["\<\
Load TBMethod on the subkernels with ParallelNeeds[\"TBMethod`\"] and make \
any user-defined model available there.\
\>", "Notes",
 CellID->1306337711,ExpressionUUID->"975f5457-5c0f-7f44-b8c3-c7a239fed1d4"],

Cell["\<\
Eigenvalues are sorted independently at each sample; Method -> \"Direct\" is \
supplied internally.\
\>", "Notes",
 CellID->1128117344,ExpressionUUID->"9457a1b9-82de-2640-b8a7-b4e0c258ca5c"],

Cell["\<\
The example launches two kernels only if no kernels are already running.\
\>", "Notes",
 CellID->1936279583,ExpressionUUID->"88715f95-faeb-3a4b-8b52-43059a8a7571"]
}, Closed]],

