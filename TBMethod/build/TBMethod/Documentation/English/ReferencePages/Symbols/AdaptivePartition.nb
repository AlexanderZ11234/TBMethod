Cell[TextData[{
 "Starts from scattering sites within ",
 Cell[BoxData[
  StyleBox["distance", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d6795726-fcea-7448-92b3-f732a121af55"],
 " of ",
 Cell[BoxData[
  StyleBox["leadContactPoints", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dbe8d7ae-0a4c-df47-b137-0461bbd453a9"],
 " and expands through geometric nearest-neighbor connections."
}], "Notes",
 CellID->161975985,ExpressionUUID->"14b0d09b-cb35-7947-9597-15108422ec60"],

Cell["\<\
Returns an association of point lists ordered from the deepest reachable \
layer to the lead-contact layer. Preserve this order when constructing \
scattering-region blocks.\
\>", "Notes",
 CellID->1755072335,ExpressionUUID->"64987add-1f5a-d749-9dc6-d952c7f8c9cd"],

Cell["\<\
Only the component reachable from the lead contacts is included. Verify that \
the total returned site count equals the intended scattering-region site \
count.\
\>", "Notes",
 CellID->753707919,ExpressionUUID->"28e94726-e45b-bc4e-8fac-237cceba6a29"],

Cell[TextData[{
 "Coordinates may be labeled with ",
