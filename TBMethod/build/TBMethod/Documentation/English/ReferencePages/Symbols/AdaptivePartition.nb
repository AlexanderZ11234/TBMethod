  TemplateBox[{
    Cell[
     TextData["Rule"]], "paclet:ref/Rule"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a85faf31-d0f5-f443-8739-a2f60f4db427"],
 " expressions; the geometric search uses their coordinate values."
}], "Notes",
 CellID->611523879,ExpressionUUID->"761019bf-6146-b348-a167-a73e154c60cf"]
}, Closed]],

