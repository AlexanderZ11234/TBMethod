Cell["\<\
Starts from scattering sites within distance of leadContactPoints and expands \
through geometric nearest-neighbor connections.\
\>", "Notes",
 CellID->1788331618,ExpressionUUID->"6672b620-0580-7f43-8691-800521ebb565"],

Cell["\<\
Returns an association of point lists ordered from the deepest reachable \
layer to the lead-contact layer. Preserve this order when constructing CSR \
blocks.\
\>", "Notes",
 CellID->272888297,ExpressionUUID->"7878f218-1f73-d742-99ba-c72a41ff0b40"],

Cell["\<\
Only the component reachable from the lead contacts is included. Verify that \
the total returned site count equals the intended scattering-region site \
count.\
\>", "Notes",
 CellID->1661042586,ExpressionUUID->"0c6b21c7-b791-d74f-b50c-9c26d0da288c"],

Cell["\<\
Coordinates may be labeled with rules; the geometric search uses their \
coordinate values.\
\>", "Notes",
 CellID->1129243268,ExpressionUUID->"014871c4-96f9-4041-98f7-edd3c23b9ed9"]
}, Closed]],

