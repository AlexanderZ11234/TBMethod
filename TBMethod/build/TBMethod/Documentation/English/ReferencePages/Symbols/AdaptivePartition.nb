  TemplateBox[{
    Cell[
     TextData["Rule"]], "paclet:ref/Rule"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e686db8b-8344-1540-af19-acddf988f03b"],
 " expressions; the geometric search uses their coordinate values."
}], "Notes",
