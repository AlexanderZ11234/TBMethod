Cell[TextData[{
 "Starts from scattering sites within ",
 Cell[BoxData[
  StyleBox["distance", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7d415d0a-74a9-b846-abf2-f6504500927c"],
 " of ",
 Cell[BoxData[
  StyleBox["leadContactPoints", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "19417de3-cf48-1e41-b630-3ca5e76cefdd"],
 " and expands through geometric nearest-neighbor connections."
}], "Notes",
 CellID->161975985,ExpressionUUID->"2b1cc049-0c69-ec4a-94cc-57967f726f6f"],

Cell["\<\
Returns an association of point lists ordered from the deepest reachable \
layer to the lead-contact layer. Preserve this order when constructing \
scattering-region blocks.\
\>", "Notes",
 CellID->1755072335,ExpressionUUID->"02e1dc34-f136-904a-9253-20951d29a4c5"],

Cell["\<\
Only the component reachable from the lead contacts is included. Verify that \
the total returned site count equals the intended scattering-region site \
count.\
\>", "Notes",
 CellID->753707919,ExpressionUUID->"ccb36255-9411-6247-b0bd-7f48750561b1"],

Cell[TextData[{
 "Coordinates may be labeled with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Rule"]], "paclet:ref/Rule"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0e1b571e-2d23-204e-80f1-6cc24e49ef6e"],
 " expressions; the geometric search uses their coordinate values."
}], "Notes",
 CellID->611523879,ExpressionUUID->"73ce9717-9b5b-8b4d-8896-97d2c385a0da"]
}, Closed]],

