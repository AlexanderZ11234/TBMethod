Cell[TextData[{
 "The full device resolvent is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["G", "C"], "(", "z", ")"}], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{"(", 
         RowBox[{
           RowBox[{"z", " ", "\[DoubleStruckCapitalI]"}], "-", 
           SubscriptBox["H", "C"], "-", 
           RowBox[{
             UnderoverscriptBox["\[Sum]", 
              RowBox[{"p", "=", "1"}], 
              SubscriptBox["N", "L"]], 
             RowBox[{
               SubscriptBox["\[CapitalSigma]", "p"], "(", "z", ")"}]}]}], 
         ")"}]},
      "Inverse"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "e26bc1f8-3c3f-b041-86ed-c34e9f3da4a7"]
}], "Notes",
 CellID->1078576532,ExpressionUUID->"eda8c7cc-f25f-0c4b-8156-c1f055cd4964"]
}, Closed]],

