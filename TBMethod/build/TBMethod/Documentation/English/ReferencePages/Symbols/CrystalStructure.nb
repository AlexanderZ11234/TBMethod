Cell["\<\
Rows of latticeVectors are the real-space lattice vectors. Each cell \
displacement is cellIndex.latticeVectors.\
\>", "Notes",
 CellID->1316511842,ExpressionUUID->"c89ed1ff-f00c-2d4f-9d05-2735d2ea6239"],

Cell["\<\
cellIndices must be a list of integer or rational vectors. The result is an \
ordered association displacement -> translatedBasis, in the supplied cell \
order.\
\>", "Notes",
 CellID->651020560,ExpressionUUID->"ebf6a99a-b724-d84a-8dbc-95e05ff98cf7"],

Cell["\<\
atomicBasis may contain coordinate lists or label -> coordinates rules. \
Labels are preserved while coordinates are translated. Put the home cell \
first when using the result with HMatricesRealSpace.\
\>", "Notes",
 CellID->170950056,ExpressionUUID->"c10442fe-5aa8-7d4b-bcc4-d9227dde7f7b"]
}, Closed]],

