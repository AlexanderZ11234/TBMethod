Cell[TextData[{
 "The in-plane gauge direction is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"n", "\[LongEqual]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cos", "(", "\[Alpha]", ")"}], ",", 
       RowBox[{"sin", "(", "\[Alpha]", ")"}], ",", "0"}], "}"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "f56f608b-d9a0-754d-9dd6-017ae561e076"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TagBox["\[Alpha]",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "30f96b99-f240-7548-abb0-4452fe32d48c"],
 " is ",
 Cell[BoxData[
  StyleBox["angle", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5fea0339-5b4c-9d49-a65b-0f7c64cf0959"],
 ". Two- or three-component coordinates are accepted; planar points are \
padded with a zero third coordinate."
}], "Notes",
 CellID->1898331836,ExpressionUUID->"941b1692-92cd-294a-9d21-b5c203d5c312"],

Cell[TextData[{
 "For final and initial endpoints ",
 Cell[BoxData[
  FormBox[
   TagBox[
    SubscriptBox["r", "f"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "888033d3-1b33-e24e-ac7c-9d316ccee7ec"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    SubscriptBox["r", "i"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "19296327-f168-5840-a965-ea586c7c8d34"],
 ", respectively, the phase is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"exp", "(", 
     RowBox[{"\[ImaginaryI]", " ", "\[Pi]", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["r", "f"], "-", 
         SubscriptBox["r", "i"]}], ")"}], ".", "n"}], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["r", "f"], "+", 
          SubscriptBox["r", "i"]}], ")"}], "\[Cross]", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", 
          SubscriptBox["B", "z"]}], "}"}]}], ".", "n"}]}], ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "50d1134c-a404-7a46-addc-f5fd946d11d8"],
 ". Inputs must use consistent charge, flux, and length units; no physical \
constants are inserted."
}], "Notes",
 CellID->569640563,ExpressionUUID->"2122d7c7-7a87-2b47-a8ac-4e88d53369b5"],

Cell[TextData[{
 "Reversing the two real endpoint arguments conjugates the phase when ",
 Cell[BoxData[
  StyleBox["Bz", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a7c14bbb-dc03-ef45-a41d-c081abbc6284"],
 " and ",
 Cell[BoxData[
  StyleBox["angle", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "09be4c80-c527-de48-92c4-8f2bb16235de"],
 " are real."
}], "Notes",
 CellID->2037849913,ExpressionUUID->"60ed3502-b4b5-8447-913f-51b1c863e745"]
}, Closed]],

