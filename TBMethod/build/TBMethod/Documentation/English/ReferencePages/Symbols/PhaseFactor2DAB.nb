Cell[TextData[{
 "The in-plane gauge direction is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"n", "\[LongEqual]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cos", "(", "\[Alpha]", ")"}], ",", 
       RowBox[{"sin", "(", "\[Alpha]", ")"}], ",", "0"}], "}"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "8a991b39-b3f3-a745-a3d2-6cd13342d12e"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TagBox["\[Alpha]",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "886910a2-511d-6f48-a633-f23d4bbd4f59"],
 " is ",
 Cell[BoxData[
  StyleBox["angle", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ea70a490-5ee0-5649-ad38-b623179da515"],
 ". Two- or three-component coordinates are accepted; planar points are \
padded with a zero third coordinate."
}], "Notes",
 CellID->1898331836,ExpressionUUID->"584b7298-7d31-a34e-83a6-e8f977909928"],

Cell[TextData[{
 "For final and initial endpoints ",
 Cell[BoxData[
  FormBox[
   TagBox[
    SubscriptBox["r", "f"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "c9383002-e129-004c-ae3d-5b46343a6875"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    SubscriptBox["r", "i"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "185885c0-8ab7-324b-89e3-206b700ffa02"],
 ", respectively, the phase is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"exp", "(", 
     RowBox[{"\[ImaginaryI]", " ", "\[Pi]", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["r", "f"], "-", 
         SubscriptBox["r", "i"]}], ")"}], ".", "n"}], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["r", "f"], "+", 
          SubscriptBox["r", "i"]}], ")"}], "\[Cross]", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", 
          SubscriptBox["B", "z"]}], "}"}]}], ".", "n"}]}], ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "93bf16bd-4f74-b449-a218-26fc31a7b6d7"],
 ". Inputs must use consistent charge, flux, and length units; no physical \
constants are inserted."
}], "Notes",
 CellID->569640563,ExpressionUUID->"bc364182-06c1-0549-8976-a83b34b969db"],

Cell[TextData[{
 "Reversing the two real endpoint arguments conjugates the phase when ",
 Cell[BoxData[
  StyleBox["Bz", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "894d507b-0fd8-6a4f-865b-3e9b8a8a578e"],
 " and ",
 Cell[BoxData[
  StyleBox["angle", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a72ec9bc-fba9-f047-85e2-72d2ad326af5"],
 " are real."
}], "Notes",
 CellID->2037849913,ExpressionUUID->"42612624-5f87-3440-b2e1-d76fec58861a"]
}, Closed]],

