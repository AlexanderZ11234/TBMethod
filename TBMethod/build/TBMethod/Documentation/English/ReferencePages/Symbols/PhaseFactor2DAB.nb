Cell[TextData[{
 "The in-plane gauge direction is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"n", "\[LongEqual]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cos", "(", "\[Alpha]", ")"}], ",", 
       RowBox[{"sin", "(", "\[Alpha]", ")"}], ",", "0"}], "}"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "5503e030-1bae-e84f-8549-24f6cc181686"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TagBox["\[Alpha]",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "7e4a185f-1005-8444-8c7c-3a6683d6c002"],
 " is ",
 Cell[BoxData[
  StyleBox["angle", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f1b80a0e-92c5-c542-9db2-ec79019b1d0f"],
 ". Two- or three-component coordinates are accepted; planar points are \
padded with a zero third coordinate."
}], "Notes",
 CellID->1898331836,ExpressionUUID->"eb831900-f878-fd4d-8ff7-315e0e89e770"],

Cell[TextData[{
 "For final and initial endpoints ",
 Cell[BoxData[
  FormBox[
   TagBox[
    SubscriptBox["r", "f"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "8e2d8fc6-6428-f34b-b763-61ce5a518bad"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    SubscriptBox["r", "i"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "0b1b5554-d9e2-914e-b987-92f1152169df"],
 ", respectively, the phase is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"exp", "(", 
     RowBox[{"\[ImaginaryI]", " ", "\[Pi]", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["r", "f"], "-", 
         SubscriptBox["r", "i"]}], ")"}], ".", "n"}], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["r", "f"], "+", 
          SubscriptBox["r", "i"]}], ")"}], "\[Cross]", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", 
          SubscriptBox["B", "z"]}], "}"}]}], ".", "n"}]}], ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "3d67979c-630b-4a45-8598-a782f7d39219"],
 ". Inputs must use consistent charge, flux, and length units; no physical \
constants are inserted."
}], "Notes",
 CellID->569640563,ExpressionUUID->"61bf6cfc-4a53-6744-81c4-0bf50c7c97f3"],

Cell[TextData[{
 "Reversing the two real endpoint arguments conjugates the phase when ",
 Cell[BoxData[
  StyleBox["Bz", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b759f93b-a99a-f941-9ac8-f832c66d5f66"],
 " and ",
 Cell[BoxData[
  StyleBox["angle", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "90dbed8a-1736-4646-9f9c-810ac788ae4f"],
 " are real."
}], "Notes",
 CellID->2037849913,ExpressionUUID->"c52a87ff-5eb9-6a47-b0dc-80e4231ac87e"]
}, Closed]],

