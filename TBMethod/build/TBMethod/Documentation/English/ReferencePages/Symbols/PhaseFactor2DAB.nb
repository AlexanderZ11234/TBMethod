Cell[TextData[{
 "The in-plane gauge direction is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"n", "\[LongEqual]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cos", "(", "\[Alpha]", ")"}], ",", 
       RowBox[{"sin", "(", "\[Alpha]", ")"}], ",", "0"}], "}"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "f8ac9793-7b39-a04a-9c19-d95798fcf8a5"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TagBox["\[Alpha]",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "70a26928-b5a9-b748-b5a9-41c7c628eb30"],
 " is ",
 Cell[BoxData[
  StyleBox["angle", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e10a08bd-e768-ad41-9a79-11bbbf5a4c40"],
 ". Two- or three-component coordinates are accepted; planar points are \
padded with a zero third coordinate."
}], "Notes",
 CellID->959208491,ExpressionUUID->"ed99883b-e514-ac4e-8f9b-1f6297a39626"],

Cell[TextData[{
 "For final and initial endpoints ",
 Cell[BoxData[
  FormBox[
   TagBox[
    SubscriptBox["r", "f"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "ffb16c14-8753-6c4c-a5eb-461190c5ec2a"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    SubscriptBox["r", "i"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "9467ee94-772e-f647-bcd9-4db4db04998c"],
 ", respectively, the phase is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"exp", "(", 
     RowBox[{"\[ImaginaryI]", " ", "\[Pi]", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["r", "f"], "-", 
         SubscriptBox["r", "i"]}], ")"}], ".", "n"}], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["r", "f"], "+", 
          SubscriptBox["r", "i"]}], ")"}], "\[Cross]", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", 
          SubscriptBox["B", "z"]}], "}"}]}], ".", "n"}]}], ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "ddafcc63-c7b7-c04b-af50-7fc2c6ad9b87"],
 ". Inputs must use consistent charge, flux, and length units; no physical \
constants are inserted."
}], "Notes",
 CellID->497889929,ExpressionUUID->"f408d216-0d08-bc46-ad2c-e7f43aac8b3a"],

Cell[TextData[{
 "Reversing the two real endpoint arguments conjugates the phase when ",
 Cell[BoxData[
  StyleBox["Bz", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dba8b113-eb8e-314a-99b5-0292aa00c953"],
 " and ",
 Cell[BoxData[
  StyleBox["angle", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "357bffa4-0045-5e40-b990-6e4ec2918568"],
 " are real."
}], "Notes",
 CellID->611155283,ExpressionUUID->"1d7e589a-930b-4049-be9e-c9e2548c8307"]
}, Closed]],

