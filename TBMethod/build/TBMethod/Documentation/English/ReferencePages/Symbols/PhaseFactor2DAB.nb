Cell[TextData[{
 "The in-plane gauge direction is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"n", "\[LongEqual]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cos", "(", "\[Alpha]", ")"}], ",", 
       RowBox[{"sin", "(", "\[Alpha]", ")"}], ",", "0"}], "}"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "e5c6a370-a8ad-f042-a44e-ee185ffef48e"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TagBox["\[Alpha]",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "4d5571b8-7f18-0d40-8992-3891cc4d16cf"],
 " is ",
 Cell[BoxData[
  StyleBox["angle", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "39e34f85-0320-b243-b843-b06131b3b726"],
 ". Two- or three-component coordinates are accepted; planar points are \
padded with a zero third coordinate."
}], "Notes",
 CellID->475944981,ExpressionUUID->"6490a8e2-0a98-6d44-b2d8-e57f5bb9bf97"],

Cell[TextData[{
 "For final and initial endpoints ",
 Cell[BoxData[
  FormBox[
   TagBox[
    SubscriptBox["r", "f"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "d72ceb4b-e5d2-5243-a74a-754664412447"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    SubscriptBox["r", "i"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "59cd0af8-bffd-7042-bdb6-6d8f6fb42d2d"],
 ", respectively, the phase is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"exp", "(", 
     RowBox[{"\[ImaginaryI]", " ", "\[Pi]", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["r", "f"], "-", 
         SubscriptBox["r", "i"]}], ")"}], ".", "n"}], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["r", "f"], "+", 
          SubscriptBox["r", "i"]}], ")"}], "\[Cross]", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", 
          SubscriptBox["B", "z"]}], "}"}]}], ".", "n"}]}], ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "6838cd38-3882-a246-bd53-0ed3605b717c"],
 ". Inputs must use consistent charge, flux, and length units; no physical \
constants are inserted."
}], "Notes",
 CellID->697416174,ExpressionUUID->"a75a3b8d-a824-bb47-956c-8957f1db94a0"],

Cell[TextData[{
 "Reversing the two real endpoint arguments conjugates the phase when ",
