Cell["\<\
Uses ParallelTable and the same nonempty real scalar or real-vector samples \
accepted by GlobalBandGap.\
\>", "Notes",
 CellID->1618495349,ExpressionUUID->"e894817b-c1eb-3f4f-ab30-ed9fdd33afa4"],

Cell["\<\
Returns Min[E[n+1,k]] - Max[E[n,k]] over all supplied samples; negative \
values indicate band overlap on that grid.\
\>", "Notes",
 CellID->683322438,ExpressionUUID->"874b8e65-12f5-8945-9969-dc0c5e6d1771"],

Cell["\<\
Load TBMethod on subkernels and distribute model definitions. Eigenvalues \
options are accepted and Method -> \"Direct\" is supplied internally.\
\>", "Notes",
 CellID->506247740,ExpressionUUID->"5e6a4c82-b48f-dc43-97a0-fbc876ffb35f"],

Cell["\<\
The example launches two kernels only if no kernels are already running.\
\>", "Notes",
 CellID->981075952,ExpressionUUID->"dd5b60b3-2e06-5041-b34a-05e712999550"]
}, Closed]],

