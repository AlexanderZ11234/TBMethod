Cell["\<\
Calculate the indirect gap of two commonly shifted bands in parallel.\
\>", "ExampleText",
 CellID->845911540,ExpressionUUID->"1c485ffe-cb92-7040-b424-dd129e99fdbc"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1325851151,ExpressionUUID->"dcfc6ddf-0649-584e-afa2-f16e930fb4e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"$KernelCount", "\[Equal]", "0"}], ",", 
    RowBox[{"LaunchKernels", "[", "2", "]"}]}], "]"}], ";", 
  RowBox[{"ParallelNeeds", "[", "\"\<TBMethod`\>\"", "]"}], ";", 
  RowBox[{"Clear", "[", "h", "]"}], ";", 
  RowBox[{
   RowBox[{"h", "[", "k_", "]"}], ":=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"k", "-", "1.`"}], ",", 
      RowBox[{"k", "+", "1.`"}]}], "}"}], "]"}]}], ";", 
  RowBox[{"DistributeDefinitions", "[", "h", "]"}], ";", 
  RowBox[{"result", "=", 
   RowBox[{"ParallelGlobalBandGap", "[", 
    RowBox[{"h", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.5`"}], ",", "0.`", ",", "0.5`"}], "}"}], ",", "1"}], 
    "]"}]}], ";", "result"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->2013157067,ExpressionUUID->"64802860-64a4-9947-a47b-e47a63abdfa3"],

Cell[BoxData["1.`"], "Output",
 CellLabel->"Out[3]=",
 CellID->662183232,ExpressionUUID->"e2f509fa-9971-c34b-a838-55c5f4f73f7c"]
}, Open  ]]
