Cell["\<\
n is a nonnegative integer. The output list has n+1 elements; element p+1 \
contains the rank-p momentum-derivative tensor, ending in two matrix indices.\
\
\>", "Notes",
 CellID->2038579814,ExpressionUUID->"10fc4ac7-94fc-f54d-9f5f-38305d38c077"],

Cell["\<\
The order-zero element is the Hamiltonian. No hbar factors are inserted.\
\>", "Notes",
 CellID->961547328,ExpressionUUID->"b0a89e6b-fac8-6246-9551-816bb73b3935"],

Cell[TextData[{
 "The first entry is onsite; remaining numeric vector keys must map to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SparseArray"]], "paclet:ref/SparseArray"},
   "RefLink",
