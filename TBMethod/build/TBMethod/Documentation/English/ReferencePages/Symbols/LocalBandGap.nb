}], "Notes",
 CellID->1455462255,ExpressionUUID->"f1dc6502-dfc6-9946-9f66-a139031b599d"],

Cell[TextData[{
 "At each sample, the full eigenvalue list is sorted before the adjacent-band \
difference is formed. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Chop"]], "paclet:ref/Chop"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a2254591-e6fc-7447-a86a-d009b1474df8"],
 " is applied to numerical residues."
}], "Notes",
 CellID->112553543,ExpressionUUID->"9281bf37-a740-c34f-b036-f100c5fb3f3f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["n", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9d143d95-216a-264c-b40d-17d914862000"],
 " must satisfy ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"1", "\[LessEqual]", "n", "<", "dim"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "d9823056-6690-6040-a696-16079cc781a0"],
 ", where ",
 Cell[BoxData[
  StyleBox["dim", "TI",
