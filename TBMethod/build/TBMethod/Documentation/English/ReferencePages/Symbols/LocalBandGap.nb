  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"4b3e381f-ef06-d34d-91b4-c8db6dea742b"],
