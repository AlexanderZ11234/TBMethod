Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", "h", "]"}], ";", 
  RowBox[{
   RowBox[{"h", "[", "k_", "]"}], ":=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"k", "-", "1.`"}], ",", 
      RowBox[{"k", "+", "1.`"}]}], "}"}], "]"}]}], ";", 
  RowBox[{"result", "=", 
   RowBox[{"LocalBandGap", "[", 
    RowBox[{"h", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.5`"}], ",", "0.`", ",", "0.5`"}], "}"}], ",", "1"}], 
    "]"}]}], ";", "result"}]], "Input",
