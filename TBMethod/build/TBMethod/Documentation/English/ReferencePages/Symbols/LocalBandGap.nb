Cell[TextData[{
 Cell[BoxData[
  StyleBox["samples", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4ba00799-e271-5e41-94a8-dc7e6f50f5d6"],
 " must be a nonempty list of real scalar values or real coordinate lists, \
matching ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"{", "__Real", "}"}], "|", "_Real"}], ")"}], ".."}], "}"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "48377f76-9633-1e40-961e-717cba4050d7"],
 ". Exact integer samples do not match this input pattern."
}], "Notes",
 CellID->1255766907,ExpressionUUID->"3afa5621-787e-6a49-9925-8b6b5ae1f179"],

Cell[TextData[{
 "At each sample, the full eigenvalue list is sorted before the adjacent-band \
difference is formed. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Chop"]], "paclet:ref/Chop"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "122ede43-6b7d-144a-ae17-7bccfbf18fbd"],
 " is applied to numerical residues."
}], "Notes",
 CellID->1922543684,ExpressionUUID->"0125da14-aa53-a34a-8c5e-22b366bd56bb"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bf715fdf-b8db-644d-b57a-db8eb5df2d13"],
 " must satisfy ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"1", "\[LessEqual]", "n", "<", "dim"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "f05ea4c2-60f7-3e47-8b54-570c5076d3b7"],
 ", where ",
 Cell[BoxData[
  StyleBox["dim", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f223693a-89fd-8546-b190-3a8de4b7887a"],
 " is the Hamiltonian matrix dimension."
}], "Notes",
 CellID->364713176,ExpressionUUID->"c3d0d4d6-0e3b-1446-bbbb-2092642a874e"],

Cell[TextData[{
 "This is an estimate over the supplied sample points. Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigenvalues"]], "paclet:ref/Eigenvalues"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "04d5a872-565e-e84b-b5dc-209349cf1ff5"],
 " are accepted, with ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Method"]], "paclet:ref/Method"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", "\"\<Direct\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ebf11514-6128-ee46-a6e4-7e8c41571bd0"],
 " supplied internally."
}], "Notes",
 CellID->1925145700,ExpressionUUID->"0d5dd6dd-fcf1-f142-bbb0-f63a6f2f098a"],

Cell[TextData[{
 "For the supplied sample set, the direct gap is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[CapitalDelta]", "direct"], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["Min", 
       RowBox[{"k", "\[Element]", "\[ScriptCapitalK]"}]], "(", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[ExponentialE]", 
         RowBox[{"n", "+", "1"}]], "(", "k", ")"}], "-", 
       RowBox[{
        SubscriptBox["\[ExponentialE]", "n"], "(", "k", ")"}]}], ")"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "4359bc92-9910-954d-ae3a-034063d74d22"]
}], "Notes",
 CellID->2076599254,ExpressionUUID->"80f621de-f14e-0340-8d30-75308620d61e"]
}, Closed]],

