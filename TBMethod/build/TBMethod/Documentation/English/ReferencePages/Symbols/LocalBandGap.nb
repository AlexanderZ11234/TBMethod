}], "Notes",
 CellID->782626941,ExpressionUUID->"85a3c9f5-f48b-a149-93d7-e9360b3eb8f5"],

Cell[TextData[{
 "This is an estimate over the supplied sample points. Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigenvalues"]], "paclet:ref/Eigenvalues"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "125134c7-0a5e-044c-94d7-b5b881941b14"],
 " are accepted, with ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Direct\>\""}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"f0fc2d70-3aba-c14e-b772-33b5483e85df"],
 " supplied internally."
}], "Notes",
 CellID->1961192780,ExpressionUUID->"39ccb3de-5cf9-4844-ae71-0ed9ef8473e9"],

Cell[TextData[{
 "For the supplied sample set, the direct gap is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[CapitalDelta]", "direct"], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["Min", 
       RowBox[{"k", "\[Element]", "\[ScriptCapitalK]"}]], "(", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[ExponentialE]", 
         RowBox[{"n", "+", "1"}]], "(", "k", ")"}], "-", 
       RowBox[{
        SubscriptBox["\[ExponentialE]", "n"], "(", "k", ")"}]}], ")"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "f766f7d3-a2e9-4841-a0aa-9cb4a297883b"]
}], "Notes",
 CellID->2034736066,ExpressionUUID->"59259d34-59d5-d348-864d-7bf341c78270"]
}, Closed]],

