Cell[TextData[{
 Cell[BoxData[
  StyleBox["samples", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "41fa399d-a519-584d-b5c4-c497002badd1"],
 " must be a nonempty list of real scalar values or real coordinate lists, \
matching ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"{", "__Real", "}"}], "|", "_Real"}], ")"}], ".."}], "}"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a42d7c9d-62d6-de41-86ef-722ec52233eb"],
 ". Exact integer samples do not match this input pattern."
}], "Notes",
 CellID->1255766907,ExpressionUUID->"d6c332c8-7eb8-e24b-b8c3-6ee0ede483f3"],

Cell[TextData[{
 "At each sample, the full eigenvalue list is sorted before the adjacent-band \
difference is formed. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Chop"]], "paclet:ref/Chop"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8ab5fb81-6ed9-1b4c-9bb8-ecd9fc12777f"],
 " is applied to numerical residues."
}], "Notes",
 CellID->1922543684,ExpressionUUID->"9d401168-3b55-2c47-a298-f1f5f2f917a2"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b658efc8-9ba9-2b4f-ba07-5829f8b75164"],
 " must satisfy ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"1", "\[LessEqual]", "n", "<", "dim"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "8fbf164a-e5d8-154b-8425-1bacfbf18db4"],
 ", where ",
 Cell[BoxData[
  StyleBox["dim", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "73c830ce-ff5f-8846-9592-0a31669de092"],
 " is the Hamiltonian matrix dimension."
}], "Notes",
 CellID->364713176,ExpressionUUID->"9a1c073d-dfb9-314e-b469-8d27dbe1a892"],

Cell[TextData[{
 "This is an estimate over the supplied sample points. Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigenvalues"]], "paclet:ref/Eigenvalues"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "380d5009-e332-ee42-808e-d2fd82f1c662"],
 " are accepted, with ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Method"]], "paclet:ref/Method"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", "\"\<Direct\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "820d40e2-52d4-4e49-9a05-ca07e6ce8b7d"],
 " supplied internally."
}], "Notes",
 CellID->1925145700,ExpressionUUID->"4e601a3b-6942-e343-92b5-61117ab0cc7b"],

Cell[TextData[{
 "For the supplied sample set, the direct gap is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[CapitalDelta]", "direct"], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["Min", 
       RowBox[{"k", "\[Element]", "\[ScriptCapitalK]"}]], "(", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[ExponentialE]", 
         RowBox[{"n", "+", "1"}]], "(", "k", ")"}], "-", 
       RowBox[{
        SubscriptBox["\[ExponentialE]", "n"], "(", "k", ")"}]}], ")"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "f4a2bcc4-be40-1447-9a36-dfa544b88aa3"]
}], "Notes",
 CellID->2076599254,ExpressionUUID->"d1be6ac8-ac33-ef4c-b7df-3510061e93ac"]
}, Closed]],

