}], "Notes",
 CellID->393025800,ExpressionUUID->"a4a4a91e-23d8-5c44-93f9-d6c6303ef7f8"],

Cell[TextData[{
 "At each sample, the full eigenvalue list is sorted before the adjacent-band \
difference is formed. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Chop"]], "paclet:ref/Chop"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6e4ca63f-503a-924d-92d1-ff01c8a54b30"],
 " is applied to numerical residues."
}], "Notes",
 CellID->441896293,ExpressionUUID->"588c8971-690a-8b4b-a1d3-d4d675b5a91e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3ff88a50-3d98-1543-a742-885b51f94012"],
 " must satisfy ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"1", "\[LessEqual]", "n", "<", "dim"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "aa8bed1a-b7fb-f14a-9615-c1cb9051abf9"],
 ", where ",
 Cell[BoxData[
  StyleBox["dim", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "261f4967-2777-2343-9101-85897f2e86f2"],
 " is the Hamiltonian matrix dimension."
}], "Notes",
 CellID->1122012023,ExpressionUUID->"874a8ff8-5564-f946-945c-087c87a6a17f"],

Cell[TextData[{
 "This is an estimate over the supplied sample points. Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigenvalues"]], "paclet:ref/Eigenvalues"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d19ba309-a1f1-744c-b234-32fd9c1f7a07"],
 " are accepted, with ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Method"]], "paclet:ref/Method"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", "\"\<Direct\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3d480b19-88bc-6d48-a4a8-4012e28b595d"],
 " supplied internally."
}], "Notes",
 CellID->191033537,ExpressionUUID->"827ea263-63e8-d14d-afc4-d3ce48c8c965"],

Cell[TextData[{
 "For the supplied sample set, the direct gap is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[CapitalDelta]", "direct"], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["Min", 
       RowBox[{"k", "\[Element]", "\[ScriptCapitalK]"}]], "(", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[ExponentialE]", 
         RowBox[{"n", "+", "1"}]], "(", "k", ")"}], "-", 
       RowBox[{
        SubscriptBox["\[ExponentialE]", "n"], "(", "k", ")"}]}], ")"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "85bf1a8b-50da-c74e-a920-c69492985ecb"]
}], "Notes",
 CellID->1964053676,ExpressionUUID->"2e90aa31-b93d-6049-9599-13b2895dcf88"]
}, Closed]],

