Cell[TextData[{
 "The cutoff is computed with ",
 Cell[BoxData[
  RowBox[{"Quantile", "[", 
   RowBox[{
    RowBox[{"Flatten", "[", "data", "]"}], ",", " ", "quantile"}], "]"}]], 
  "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"63cb993f-d4c1-0a49-b51b-614b23e944bd"],
 ". Values are clipped to the range ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "c"}], "\[LessEqual]", "x", "\[LessEqual]", "c"}], 
   TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "f07054ce-8c2f-884f-8136-71f478d765ea"],
 ", where ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "a0c61788-73f4-1c4c-8632-f9c9fa7c4cca"],
 " is the cutoff, and then smoothed with ",
 Cell[BoxData[
  RowBox[{"GaussianFilter", "[", 
   RowBox[{"clippedData", ",", " ", "2"}], "]"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"5fbe2ef7-2de5-0943-95a3-a61a1b4bd0d6"],
 "."
}], "Notes",
 CellID->1128654139,ExpressionUUID->"370157b2-4f43-1b48-9647-35b05c31b428"],

Cell[TextData[{
 "Use a numeric array and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "quantile", "\[LessEqual]", "1"}], 
   TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "9e03b45d-893d-2445-9da9-35f95f66676e"],
 ". Signed data whose cutoff is negative require care because the clipping \
bounds are formed directly from that cutoff."
}], "Notes",
 CellID->1325628264,ExpressionUUID->"ca9622d6-f254-0243-9bc6-93149058c192"]
}, Closed]],

