Cell[TextData[{
 "The cutoff is computed with ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Quantile"]], "paclet:ref/Quantile"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "[", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       Cell[
        TextData["Flatten"]], "paclet:ref/Flatten"},
      "RefLink",
      BaseStyle->{"InlineFormula"}], "[", 
     StyleBox["data", "TI"], "]"}], ",", 
    StyleBox["quantile", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f59db795-4f67-ec4c-8085-3627f77fc4a7"],
 ". Values are clipped to the range ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "c"}], "\[LessEqual]", "x", "\[LessEqual]", "c"}], 
   TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "21417d59-5faf-f644-a98f-fbf5b13fbe25"],
 ", where ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "95807ffc-6a28-824e-91c9-d3dc58972baa"],
 " is the cutoff, and then smoothed with ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GaussianFilter"]], "paclet:ref/GaussianFilter"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "[", 
   RowBox[{
    StyleBox["clippedData", "TI"], ",", "2"}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cc0360bb-038c-1640-b93e-004d74762b46"],
 "."
}], "Notes",
 CellID->1993226562,ExpressionUUID->"3776f9c4-98b0-494f-9e98-297055860139"],

Cell[TextData[{
 "Use a numeric array and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "quantile", "\[LessEqual]", "1"}], 
   TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "99397b38-a7db-b84c-b344-50650169d3fd"],
 ". Signed data whose cutoff is negative require care because the clipping \
bounds are formed directly from that cutoff."
}], "Notes",
 CellID->872244305,ExpressionUUID->"2ed3401b-3567-5f49-bd9d-3ccb25641252"]
}, Closed]],

