Cell[TextData[{
 "Computes the selected quantile of Flatten[data], clips values to plus or \
minus that cutoff and applies ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GaussianFilter"]], "paclet:ref/GaussianFilter"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b01af87f-04f5-9346-adfb-b827c87c5a9a"],
 "[..., 2]."
}], "Notes",
 CellID->1009809671,ExpressionUUID->"c3ae69e2-1e56-5b4e-802d-238669f46dc9"],

Cell["\<\
Use a numeric array and a quantile between 0 and 1. Signed data whose cutoff \
is negative require care because the clipping bounds are built directly from \
that cutoff.\
\>", "Notes",
 CellID->804051910,ExpressionUUID->"f4c97bbc-cb39-2b4d-bfc6-81248ca3af79"]
}, Closed]],

