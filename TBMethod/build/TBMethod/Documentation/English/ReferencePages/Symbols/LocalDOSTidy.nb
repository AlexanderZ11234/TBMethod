Cell["\<\
Computes the selected quantile of Flatten[data], clips values to plus or \
minus that cutoff and applies GaussianFilter[..., 2].\
\>", "Notes",
 CellID->412396966,ExpressionUUID->"9caba3cb-c8cf-504f-a3e5-b2edaff13ee3"],

Cell["\<\
Use a numeric array and a quantile between 0 and 1. Signed data whose cutoff \
is negative require care because the clipping bounds are built directly from \
that cutoff.\
\>", "Notes",
 CellID->1441842377,ExpressionUUID->"a5592e10-2d3c-c44e-96a7-8398e8826a3d"]
}, Closed]],

