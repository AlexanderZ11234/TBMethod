Cell[TextData[{
 "The symbolic result uses string heads ",
 Cell[BoxData["\"\<\[Sigma]\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9e2f6eea-0f92-9743-a68d-4d1de5d5c244"],
 " and ",
 Cell[BoxData["\"\<\[Lambda]\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b17066c5-9188-4742-9703-c29687cbda60"],
 " for Pauli and Gell-Mann factors, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CircleTimes"]], "paclet:ref/CircleTimes"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f8548f8e-44c4-1b40-a14e-cdacad5d71fb"],
 " for tensor products. It is not a matrix representation."
}], "Notes",
 CellID->1190818337,ExpressionUUID->"3e3e2ba1-8379-214c-b1bf-1871d9d8672f"]
}, Closed]],

