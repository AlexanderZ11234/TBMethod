Cell[TextData[{
 "The rows of ",
 Cell[BoxData[
  StyleBox["reciprocalBasis", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bf1d85d1-5983-ff4f-bc1b-64b3195283c4"],
 " are reciprocal vectors, and its dimensions must be ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", "2"}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9e8ec621-f245-8d48-92d8-3bc49316be5c"],
 " or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"3", ",", "3"}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6055453d-e272-4a4a-914d-644cf9e416d4"],
 ". Use exact input because ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FirstBrillouinZoneRegion"]], 
    "paclet:TBMethod/ref/FirstBrillouinZoneRegion", "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7bbbe5f2-f9d1-9742-bb96-c6ac827305d0"],
 ", called internally, requires infinite input precision."
}], "Notes",
 CellID->827880704,ExpressionUUID->"17f2cdb2-2a3d-e042-8604-0038f4e388d1"],

Cell[TextData[{
 Cell[BoxData[
