Cell["\<\
The basis is a 2 by 2 or 3 by 3 matrix with rows representing reciprocal \
vectors. Use exact input because FirstBrillouinZoneRegion, called internally, \
requires infinite input precision.\
\>", "Notes",
 CellID->1192288060,ExpressionUUID->"c85462d2-7b01-3b4c-8b20-ae205fcf6b90"],

Cell["\<\
n defaults to 2 and controls the reciprocal lattice points included in the \
Voronoi construction.\
\>", "Notes",
 CellID->1474443510,ExpressionUUID->"b819ec8f-d298-e94b-93cc-7bef8d0771ce"],

Cell[TextData[{
 "The zone boundary is highlighted and reciprocal vectors are drawn as red, \
green, and, in three dimensions, blue arrows. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Show"]], "paclet:ref/Show"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "18d2e979-f970-9846-be78-400e1d3581c7"],
 " options are accepted."
}], "Notes",
