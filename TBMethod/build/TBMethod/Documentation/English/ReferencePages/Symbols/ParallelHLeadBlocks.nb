Cell["\<\
The result is {h0, h1, v}. h0 has rows and columns in leadCell0; h1 has rows \
in leadCell0 and columns in leadCell1; v has rows in the last CSR layer and \
columns in leadCell0.\
\>", "Notes",
 CellID->1692367773,ExpressionUUID->"1bf27b19-12d2-5a47-90e7-bd7553a8bd9b"],

Cell[TextData[{
 "The scattering-region layers are an ordered association; the last layer is \
the lead-contact layer. The underlying hopping cutoff must be a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Real"]], "paclet:ref/Real"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
