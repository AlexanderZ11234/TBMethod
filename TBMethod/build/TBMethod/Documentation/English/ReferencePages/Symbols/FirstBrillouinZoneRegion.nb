Cell[TextData[{
 "Returns the full-dimensional mesh primitive whose centroid has distance \
less than ",
 Cell[BoxData[
  FormBox[
   TagBox[
    FractionBox["1", 
     SuperscriptBox["10", "5"]],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "e75a0cd2-8e7a-be42-8001-d8f29b78944a"],
 " from the origin. For strongly skewed bases, increase ",
