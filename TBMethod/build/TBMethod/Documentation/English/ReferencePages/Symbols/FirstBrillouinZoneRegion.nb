Cell[TextData[{
 "Returns the full-dimensional mesh primitive whose centroid has distance \
less than ",
 Cell[BoxData[
  FormBox[
   TagBox[
    FractionBox["1", 
     SuperscriptBox["10", "5"]],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "2935f760-1f1f-334f-aa6a-b6b77d2c8b79"],
 " from the origin. For strongly skewed bases, increase ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "69e9a8ef-179a-2046-b7bf-aeeacb1a975d"],
 " and check that the zone has converged."
}], "Notes",
 CellID->397213223,ExpressionUUID->"a1179115-00df-1943-8262-aafce8e66698"]
}, Closed]],

