Cell[TextData[{
 "Returns the full-dimensional mesh primitive whose centroid has distance \
less than ",
 Cell[BoxData[
  FormBox[
   TagBox[
    FractionBox["1", 
     SuperscriptBox["10", "5"]],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "efe52ba3-67a9-ce48-bf2a-42cdc936a51b"],
 " from the origin. For strongly skewed bases, increase ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "848d2025-bb91-914b-9c21-ff5eec4f0e7e"],
 " and check that the zone has converged."
}], "Notes",
 CellID->397213223,ExpressionUUID->"75da9198-6e42-3e4a-be5e-ffbe14fab485"]
}, Closed]],

