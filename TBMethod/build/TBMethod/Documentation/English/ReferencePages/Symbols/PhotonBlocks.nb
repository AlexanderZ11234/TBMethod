Cell["\<\
m sets photon indices -m through m; the photon-space dimension is 2 m + 1. \
modulation is a function of a dimensionless periodic angle with period 2 Pi.\
\>", "Notes",
 CellID->304986284,ExpressionUUID->"29acb107-daa1-1945-b5fb-1a84430e59fc"],

Cell["\<\
For distinct sites, returns {FourierModulationMatrix, zeroMatrix}. For \
coincident sites, returns {identityMatrix, FourierModulationMatrix - omega \
DiagonalMatrix[Range[-m,m]]}. Coincidence uses a distance threshold of 1.*^-5.\
\>", "Notes",
 CellID->886855332,ExpressionUUID->"c36db3f6-3840-714a-9ead-fcf869299833"],

Cell["\<\
The matrix entry with photon indices p and q uses the Fourier coefficient at \
q-p. The vector-potential forms use Exp[I amplitude \
(rf-ri).vectorPotential[angle]] on nonzero-length bonds; their onsite \
modulation is zero.\
\>", "Notes",
 CellID->1169001477,ExpressionUUID->"a9d08ab3-b451-4b47-9222-080a564b36a6"],

Cell["\<\
The two-element vector-potential form assumes amplitude 1. Use PhotonDress to \
combine these factors with a bare hopping matrix.\
\>", "Notes",
 CellID->1394105443,ExpressionUUID->"a80336a4-b7ea-c04a-9fbd-afee3bd4f824"],

Cell["\<\
Fourier coefficients are computed symbolically, with a special internal \
Bessel-function treatment of some exponential sine/cosine forms.\
\>", "Notes",
 CellID->1529876339,ExpressionUUID->"2d683ebd-639e-d349-af8c-3b05369281db"],

Cell[TextData[{
 "For scalar modulation, the photon-space matrix entries follow the Fourier \
convention",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["A", 
      RowBox[{"{", 
       RowBox[{"m", ",", "n"}], "}"}]], "\[LongEqual]", 
     FractionBox[
      RowBox[{
       SubsuperscriptBox["\[Integral]", 
        RowBox[{"-", "\[Pi]"}], "\[Pi]"], 
       RowBox[{
        RowBox[{
         RowBox[{"f", "(", "\[Phi]", ")"}], " ", 
         RowBox[{"exp", "(", 
          RowBox[{"\[ImaginaryI]", " ", 
           RowBox[{"(", 
            RowBox[{"m", "-", "n"}], ")"}], " ", "\[Phi]"}], ")"}]}], 
        RowBox[{"\[DifferentialD]", "\[Phi]"}]}]}], 
      RowBox[{"2", " ", "\[Pi]"}]]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "9b86da2e-42e0-b244-9032-3905e1517d64"]
}], "Notes",
 CellID->1178108422,ExpressionUUID->"df69656c-22bd-a244-b5f3-d0f1a801c795"],

Cell[TextData[{
 "The additional photon-energy diagonal has entries",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["D", 
      RowBox[{"{", 
       RowBox[{"m", ",", "n"}], "}"}]], "\[LongEqual]", 
     RowBox[{
      RowBox[{"-", "m"}], " ", "\[Omega]", " ", 
      TemplateBox[{
        RowBox[{"m", ",", "n"}]},
       "KroneckerDeltaSeq"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "77cc52df-fc4e-1d43-a6f2-43f8d17d8322"]
}], "Notes",
 CellID->1325210635,ExpressionUUID->"7cdaa75a-7729-d247-bf15-d0dbd0496fc1"]
}, Closed]],

