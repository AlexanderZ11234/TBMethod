Cell[TextData[{
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d10e8b1f-6c41-b945-9509-d2d01d8d3b6b"],
 " sets photon indices from ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"-", "m"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "48e199a8-bb34-e942-ab6d-ebc5bae401a4"],
 " through ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a7c4efa1-d82e-7d44-b912-caf6303e99a8"],
 "; the photon-space dimension is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"2", " ", "m"}], "+", "1"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "d42bec82-f799-7d47-8f59-bc5037ebcea6"],
 ". ",
 Cell[BoxData[
  StyleBox["modulation", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4a3a5852-9757-594a-b280-9b2dcdb24142"],
 " is a function of a dimensionless angle with period ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"2", " ", "\[Pi]"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "e65eaaeb-e085-3449-8d6b-3a8dd77a6080"],
 "."
}], "Notes",
 CellID->434481244,ExpressionUUID->"d04821f1-1ba4-d74a-b7ce-e638b32f4f09"],

Cell[TextData[{
 "For distinct sites, returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["fourierModulationMatrix", "TI"], ",", 
    StyleBox["zeroMatrix", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e9ccef31-6157-304d-a216-6dec77724098"],
 ". For coincident sites, returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["identityMatrix", "TI"], ",", 
    RowBox[{
     StyleBox["fourierModulationMatrix", "TI"], "-", 
     RowBox[{
      StyleBox["omega", "TI"], " ", 
      RowBox[{
       TemplateBox[{
         Cell[
          TextData["DiagonalMatrix"]], "paclet:ref/DiagonalMatrix"},
        "RefLink",
        BaseStyle->{"InlineFormula"}], "[", 
       RowBox[{
        TemplateBox[{
          Cell[
           TextData["Range"]], "paclet:ref/Range"},
         "RefLink",
         BaseStyle->{"InlineFormula"}], "[", 
        RowBox[{
         RowBox[{"-", 
          StyleBox["m", "TI"]}], ",", 
         StyleBox["m", "TI"]}], "]"}], "]"}]}]}]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d0b50c6d-e196-7748-8e4f-35c79180c3b6"],
 ". Coincidence uses a distance threshold of ",
 Cell[BoxData["0.00001"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c8a49a60-0d7b-924f-802e-355932802806"],
 "."
}], "Notes",
 CellID->353782942,ExpressionUUID->"0e5d34c7-db01-d54c-8d63-0a5887fcfcbd"],

Cell[TextData[{
 "The matrix entry with photon indices ",
 Cell[BoxData[
  FormBox[
   TagBox["p",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "f19c9fb2-a2e9-ad40-adc2-944c21080e22"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox["q",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "ae8aa64b-eb5c-9d41-9295-fe991b599492"],
 " uses the Fourier coefficient at ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"q", "-", "p"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "15d9fd02-d7a6-3445-b2bc-76d4c90ea28b"],
 ". On nonzero-length bonds the vector-potential forms use ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"exp", "(", 
     RowBox[{"\[ImaginaryI]", " ", "A", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["r", "f"], "-", 
         SubscriptBox["r", "i"]}], ")"}], ".", 
       RowBox[{"a", "(", "\[Phi]", ")"}]}]}], ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "6760cf82-d012-f04a-adf2-fc8e6593f369"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TagBox["A",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "4f9d8b3f-7102-484d-a573-012d468d01ef"],
 " is ",
 Cell[BoxData[
  StyleBox["amplitude", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "afafc1c4-4e3c-8748-985f-1213f553d60b"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"a", "(", "\[Phi]", ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "7d1a0440-5bef-554e-a9d3-6f3b835efe6e"],
 " is the supplied vector potential. Their onsite modulation is zero."
}], "Notes",
 CellID->171698440,ExpressionUUID->"1f262598-ee65-4e44-a7ec-fde3200dc84a"],

Cell[TextData[{
 "The two-element vector-potential form assumes amplitude ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3fc4447d-0980-2746-b96b-77accf7326ed"],
 ". Use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PhotonDress"]], "paclet:TBMethod/ref/PhotonDress", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "239cbdee-297e-6b41-8ed7-93983baf71f0"],
 " to combine these factors with a bare hopping matrix."
}], "Notes",
 CellID->185731316,ExpressionUUID->"a88df4ce-bc8a-c144-b33f-c4ef102bf752"],

Cell["\<\
Fourier coefficients are computed symbolically, with a special internal \
Bessel-function treatment of some exponential sine/cosine forms.\
\>", "Notes",
 CellID->459423060,ExpressionUUID->"ae5b19ea-8011-d14b-a721-65d69097bc6e"],

Cell[TextData[{
 "For scalar modulation, the photon-space matrix entries follow the Fourier \
convention",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["A", 
      RowBox[{"{", 
       RowBox[{"m", ",", "n"}], "}"}]], "\[LongEqual]", 
     FractionBox[
      RowBox[{
       SubsuperscriptBox["\[Integral]", 
        RowBox[{"-", "\[Pi]"}], "\[Pi]"], 
       RowBox[{
        RowBox[{
         RowBox[{"f", "(", "\[Phi]", ")"}], " ", 
         RowBox[{"exp", "(", 
          RowBox[{"\[ImaginaryI]", " ", 
           RowBox[{"(", 
            RowBox[{"m", "-", "n"}], ")"}], " ", "\[Phi]"}], ")"}]}], 
        RowBox[{"\[DifferentialD]", "\[Phi]"}]}]}], 
      RowBox[{"2", " ", "\[Pi]"}]]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "531b1e1e-cf9f-3343-965a-66ed6c25e375"]
}], "Notes",
 CellID->2041833739,ExpressionUUID->"425f6c73-54cf-574c-93b8-b48affa9611f"],

Cell[TextData[{
 "The additional photon-energy diagonal has entries",
 "\[LineSeparator]",
 Cell[BoxData[
