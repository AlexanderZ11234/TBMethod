Cell[TextData[{
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0b32955b-a59b-a943-b702-a613c5883050"],
 " sets photon indices from ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"-", "m"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "0d0c191f-5041-9543-8e34-ad8c37111d31"],
 " through ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "08680209-01c3-ae41-80c0-028660345493"],
 "; the photon-space dimension is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"2", " ", "m"}], "+", "1"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "b1f3f5f7-c50d-c342-b5d8-e8311d7c7939"],
 ". ",
 Cell[BoxData[
  StyleBox["modulation", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d6182c47-28d4-024b-8837-5e775fb8eaac"],
 " is a function of a dimensionless angle with period ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"2", " ", "\[Pi]"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "e6d4f4a6-7353-ec4d-adff-35f1761e59c5"],
 "."
}], "Notes",
 CellID->1945641892,ExpressionUUID->"f7fc3e96-3228-af48-b2d8-d354ddfa8e2e"],

Cell[TextData[{
 "For distinct sites, returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["fourierModulationMatrix", "TI"], ",", 
    StyleBox["zeroMatrix", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d1abbcd8-da49-9345-9568-9aa202245fff"],
 ". For coincident sites, returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["identityMatrix", "TI"], ",", 
    RowBox[{
     StyleBox["fourierModulationMatrix", "TI"], "-", 
     RowBox[{
      StyleBox["omega", "TI"], " ", 
      RowBox[{
       TemplateBox[{
         Cell[
          TextData["DiagonalMatrix"]], "paclet:ref/DiagonalMatrix"},
        "RefLink",
        BaseStyle->{"InlineFormula"}], "[", 
       RowBox[{
        TemplateBox[{
          Cell[
           TextData["Range"]], "paclet:ref/Range"},
         "RefLink",
         BaseStyle->{"InlineFormula"}], "[", 
        RowBox[{
         RowBox[{"-", 
          StyleBox["m", "TI"]}], ",", 
         StyleBox["m", "TI"]}], "]"}], "]"}]}]}]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "26231ff3-a20e-8845-ae8a-4823e5f21464"],
 ". Coincidence uses a distance threshold of ",
 Cell[BoxData["0.00001"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cfa0b7f5-263d-3a43-983b-d7a4eb9760db"],
 "."
}], "Notes",
 CellID->183868259,ExpressionUUID->"04b8bf91-4b87-4147-9cbb-26f3be9eb32a"],

Cell[TextData[{
 "The matrix entry with photon indices ",
 Cell[BoxData[
  FormBox[
   TagBox["p",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "0fa0b743-bb6f-1b4a-a13f-f117c96951d4"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox["q",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "2c8a564b-5927-ac44-bc4e-250ddf165695"],
 " uses the Fourier coefficient at ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"q", "-", "p"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "59fb2ffe-1037-3f4b-b23c-9c6d3e10dda7"],
 ". On nonzero-length bonds the vector-potential forms use ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"exp", "(", 
     RowBox[{"\[ImaginaryI]", " ", "A", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["r", "f"], "-", 
         SubscriptBox["r", "i"]}], ")"}], ".", 
       RowBox[{"a", "(", "\[Phi]", ")"}]}]}], ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "cb137b4c-3896-0344-b5fd-4ac7750a4acb"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TagBox["A",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "6458cdaa-6007-9945-b482-cbe370cabae3"],
 " is ",
 Cell[BoxData[
  StyleBox["amplitude", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9634ad86-574e-1243-a174-bf2ddbb61877"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"a", "(", "\[Phi]", ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "14411ed0-5dd5-2241-9181-82b89c240530"],
 " is the supplied vector potential. Their onsite modulation is zero."
}], "Notes",
 CellID->1068187451,ExpressionUUID->"b35dbeda-348e-f241-8852-04fd3eaf0399"],

Cell[TextData[{
 "The two-element vector-potential form assumes amplitude ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "baf79625-cb7d-114e-b61c-b76d8231a1c7"],
 ". Use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PhotonDress"]], "paclet:TBMethod/ref/PhotonDress", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2ef07fea-1c61-3141-8e6b-a70bef41ed23"],
 " to combine these factors with a bare hopping matrix."
}], "Notes",
 CellID->1882469776,ExpressionUUID->"38cedf5b-1c2f-2740-8d5e-09c8c597ebee"],

Cell["\<\
Fourier coefficients are computed symbolically, with a special internal \
Bessel-function treatment of some exponential sine/cosine forms.\
\>", "Notes",
 CellID->1121933977,ExpressionUUID->"a4a932d0-820c-994c-9a59-7d5a15e9f15c"],

Cell[TextData[{
 "For scalar modulation, the photon-space matrix entries follow the Fourier \
convention",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["A", 
      RowBox[{"{", 
       RowBox[{"m", ",", "n"}], "}"}]], "\[LongEqual]", 
     FractionBox[
      RowBox[{
       SubsuperscriptBox["\[Integral]", 
        RowBox[{"-", "\[Pi]"}], "\[Pi]"], 
       RowBox[{
        RowBox[{
         RowBox[{"f", "(", "\[Phi]", ")"}], " ", 
         RowBox[{"exp", "(", 
          RowBox[{"\[ImaginaryI]", " ", 
           RowBox[{"(", 
            RowBox[{"m", "-", "n"}], ")"}], " ", "\[Phi]"}], ")"}]}], 
        RowBox[{"\[DifferentialD]", "\[Phi]"}]}]}], 
      RowBox[{"2", " ", "\[Pi]"}]]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "33a3f40a-263d-df49-b802-6ba125eaa16e"]
}], "Notes",
 CellID->1605166728,ExpressionUUID->"36af34d6-b560-fe49-9dba-cfc43df3a814"],

Cell[TextData[{
 "The additional photon-energy diagonal has entries",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
