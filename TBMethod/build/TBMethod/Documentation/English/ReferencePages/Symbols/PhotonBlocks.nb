Cell["\<\
A cosine modulation couples adjacent photon sectors with Fourier coefficient \
1/2.\
\>", "ExampleText",
 CellID->388395250,ExpressionUUID->"c5eac858-0a23-404d-be48-2860141c0a1f"],

