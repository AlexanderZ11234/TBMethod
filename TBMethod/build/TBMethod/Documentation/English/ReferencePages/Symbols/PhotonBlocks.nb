Cell[TextData[{
 Cell[BoxData[
  StyleBox["m", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "867ac4ef-a611-3a4c-ad21-1d0982e9b2fb"],
 " sets photon indices from ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"-", "m"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "db784ca7-493d-724b-b31c-be344d2aaac6"],
 " through ",
 Cell[BoxData[
  StyleBox["m", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "419ef377-ba92-e54e-81d9-961b334d3709"],
 "; the photon-space dimension is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"2", " ", "m"}], "+", "1"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "cfed394a-eef0-a04b-8aaa-f66679ff4ff4"],
 ". ",
 Cell[BoxData[
  StyleBox["modulation", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "071b98da-a81a-874e-b328-bfcc785df599"],
 " is a function of a dimensionless angle with period ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"2", " ", "\[Pi]"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "5dc7cc04-f908-a348-a957-5c6736343c68"],
 "."
}], "Notes",
 CellID->1492314385,ExpressionUUID->"a79696bd-6750-a648-9937-c1a22257acf4"],

Cell[TextData[{
 "For distinct sites, returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"fourierModulationMatrix", ",", " ", "zeroMatrix"}], "}"}]], 
  "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"4c7cc515-5913-5245-9ac7-2d21f09c2af5"],
 ". For coincident sites, returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"identityMatrix", ",", " ", 
    RowBox[{"fourierModulationMatrix", " ", "-", " ", 
     RowBox[{"omega", " ", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"-", "m"}], ",", " ", "m"}], "]"}], "]"}]}]}]}], "}"}]], 
  "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"7c6e6b3c-d1ac-fc47-9edc-35a766a79df7"],
 ". Coincidence uses a distance threshold of ",
 Cell[BoxData["1.*^-5"], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"622425af-6203-6940-b1da-536b072cdf6c"],
 "."
}], "Notes",
 CellID->802233680,ExpressionUUID->"daf12797-eed7-ff49-883b-32feb7973f36"],

Cell[TextData[{
 "The matrix entry with photon indices ",
 Cell[BoxData[
  FormBox[
   TagBox["p",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "2486ca6c-9d70-be49-9fbb-298f5a328680"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox["q",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "5aae29f7-27ca-8047-8d6c-515850f36f12"],
 " uses the Fourier coefficient at ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"q", "-", "p"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "2d44cdc3-4d04-384f-bb1a-a8beb7d6f20f"],
 ". On nonzero-length bonds the vector-potential forms use ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"exp", "(", 
     RowBox[{"\[ImaginaryI]", " ", "A", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["r", "f"], "-", 
         SubscriptBox["r", "i"]}], ")"}], ".", 
       RowBox[{"a", "(", "\[Phi]", ")"}]}]}], ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "08fe770f-3b7a-274b-8d69-b87faa39fed2"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TagBox["A",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "0af6846f-d30c-9448-b72f-ecec1ba07e80"],
 " is ",
 Cell[BoxData[
  StyleBox["amplitude", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5ebc3892-61f5-5c47-86b8-7514b5ca6402"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"a", "(", "\[Phi]", ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "6877ecc4-1d3d-9146-a982-d180cdedd19b"],
 " is the supplied vector potential. Their onsite modulation is zero."
}], "Notes",
 CellID->493803984,ExpressionUUID->"16950c9d-d8cc-4141-941d-f18829ac6257"],

Cell[TextData[{
 "The two-element vector-potential form assumes amplitude ",
 Cell[BoxData["1"], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"0c3e066a-3a3c-da40-8172-563c9a3fae2b"],
 ". Use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PhotonDress"]], "paclet:TBMethod/ref/PhotonDress", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "48707d78-e364-a24f-a7a3-1fccfb0b8b2f"],
 " to combine these factors with a bare hopping matrix."
}], "Notes",
 CellID->340594639,ExpressionUUID->"c578468e-ca35-8347-a63e-4659a5369608"],

Cell["\<\
Fourier coefficients are computed symbolically, with a special internal \
Bessel-function treatment of some exponential sine/cosine forms.\
\>", "Notes",
 CellID->1783323537,ExpressionUUID->"b3b8f8e5-3fbc-9c4e-bf24-7bface012a0a"],

Cell[TextData[{
 "For scalar modulation, the photon-space matrix entries follow the Fourier \
convention",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["A", 
      RowBox[{"{", 
       RowBox[{"m", ",", "n"}], "}"}]], "\[LongEqual]", 
     FractionBox[
      RowBox[{
       SubsuperscriptBox["\[Integral]", 
        RowBox[{"-", "\[Pi]"}], "\[Pi]"], 
       RowBox[{
        RowBox[{
         RowBox[{"f", "(", "\[Phi]", ")"}], " ", 
         RowBox[{"exp", "(", 
          RowBox[{"\[ImaginaryI]", " ", 
           RowBox[{"(", 
            RowBox[{"m", "-", "n"}], ")"}], " ", "\[Phi]"}], ")"}]}], 
        RowBox[{"\[DifferentialD]", "\[Phi]"}]}]}], 
      RowBox[{"2", " ", "\[Pi]"}]]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
