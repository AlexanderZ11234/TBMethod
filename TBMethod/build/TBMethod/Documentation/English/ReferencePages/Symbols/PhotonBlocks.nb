Cell[TextData[{
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "85d799b7-6c08-2a44-92c0-f4033b6620f0"],
 " sets photon indices from ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"-", "m"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "bf64f7d6-9efb-de44-92d3-e66950200af8"],
 " through ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b7f5e3de-a184-3e4b-bc39-504e1641ec59"],
 "; the photon-space dimension is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"2", " ", "m"}], "+", "1"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "7d337760-4b53-d349-9ca4-72d40d4f220d"],
 ". ",
 Cell[BoxData[
  StyleBox["modulation", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "45dc51cf-7ac5-de43-99fb-cb0bec0e5570"],
 " is a function of a dimensionless angle with period ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"2", " ", "\[Pi]"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "e4fa8d23-a6b5-4a48-877b-1527970c258e"],
 "."
}], "Notes",
 CellID->1945641892,ExpressionUUID->"8cab7c99-c3a1-214e-843d-d0d9bdd2aa03"],

Cell[TextData[{
 "For distinct sites, returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["fourierModulationMatrix", "TI"], ",", 
    StyleBox["zeroMatrix", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "53e7263f-288a-5c42-a7ec-178142e7181d"],
 ". For coincident sites, returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["identityMatrix", "TI"], ",", 
    RowBox[{
     StyleBox["fourierModulationMatrix", "TI"], "-", 
     RowBox[{
      StyleBox["omega", "TI"], " ", 
      RowBox[{
       TemplateBox[{
         Cell[
          TextData["DiagonalMatrix"]], "paclet:ref/DiagonalMatrix"},
        "RefLink",
        BaseStyle->{"InlineFormula"}], "[", 
       RowBox[{
        TemplateBox[{
          Cell[
           TextData["Range"]], "paclet:ref/Range"},
         "RefLink",
         BaseStyle->{"InlineFormula"}], "[", 
        RowBox[{
         RowBox[{"-", 
          StyleBox["m", "TI"]}], ",", 
         StyleBox["m", "TI"]}], "]"}], "]"}]}]}]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a49c46fd-f7b6-4b4a-9d7f-418a36318bf5"],
 ". Coincidence uses a distance threshold of ",
 Cell[BoxData["0.00001"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b4c52261-0ede-a940-be47-5b82905e2364"],
 "."
}], "Notes",
 CellID->183868259,ExpressionUUID->"7502f317-3314-be4e-b51c-34a97a90d061"],

Cell[TextData[{
 "The matrix entry with photon indices ",
 Cell[BoxData[
  FormBox[
   TagBox["p",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "b4da031c-25fc-dc47-a8a8-f4696f4c8f16"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox["q",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "1f612d63-be1b-9643-95cf-4b82f8d75761"],
 " uses the Fourier coefficient at ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"q", "-", "p"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "2b4a955b-90de-5643-852c-f4e38ab9ffef"],
 ". On nonzero-length bonds the vector-potential forms use ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"exp", "(", 
     RowBox[{"\[ImaginaryI]", " ", "A", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["r", "f"], "-", 
         SubscriptBox["r", "i"]}], ")"}], ".", 
       RowBox[{"a", "(", "\[Phi]", ")"}]}]}], ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "961db3a0-f167-954d-8c62-200998938f79"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TagBox["A",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "fe02fe8d-672f-f14f-a17e-cc1c32fa4979"],
 " is ",
 Cell[BoxData[
  StyleBox["amplitude", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cfaede06-9992-6744-8562-b6605eef8859"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"a", "(", "\[Phi]", ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "e1ad2c3f-9459-4c4f-8660-8920b98353e4"],
 " is the supplied vector potential. Their onsite modulation is zero."
}], "Notes",
 CellID->1068187451,ExpressionUUID->"731daa5d-09e5-5f4d-8c1c-28a3efa494f7"],

Cell[TextData[{
 "The two-element vector-potential form assumes amplitude ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2ca71a20-1baa-4343-87e6-76c7a8f0b78d"],
 ". Use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PhotonDress"]], "paclet:TBMethod/ref/PhotonDress", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b1842139-c8c6-2140-a955-dc1991d7d927"],
 " to combine these factors with a bare hopping matrix."
}], "Notes",
 CellID->1882469776,ExpressionUUID->"d9c0d85b-16fc-654e-9347-2a6692c88654"],

Cell["\<\
Fourier coefficients are computed symbolically, with a special internal \
Bessel-function treatment of some exponential sine/cosine forms.\
\>", "Notes",
 CellID->1121933977,ExpressionUUID->"e1c27e1f-d6af-0448-99d9-06e257764141"],

Cell[TextData[{
 "For scalar modulation, the photon-space matrix entries follow the Fourier \
convention",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["A", 
      RowBox[{"{", 
       RowBox[{"m", ",", "n"}], "}"}]], "\[LongEqual]", 
     FractionBox[
      RowBox[{
       SubsuperscriptBox["\[Integral]", 
        RowBox[{"-", "\[Pi]"}], "\[Pi]"], 
       RowBox[{
        RowBox[{
         RowBox[{"f", "(", "\[Phi]", ")"}], " ", 
         RowBox[{"exp", "(", 
          RowBox[{"\[ImaginaryI]", " ", 
           RowBox[{"(", 
            RowBox[{"m", "-", "n"}], ")"}], " ", "\[Phi]"}], ")"}]}], 
        RowBox[{"\[DifferentialD]", "\[Phi]"}]}]}], 
      RowBox[{"2", " ", "\[Pi]"}]]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "d0e7bd31-0b58-e745-b31f-a3ddad0e311e"]
}], "Notes",
 CellID->1605166728,ExpressionUUID->"6b532387-9832-064f-8e50-d2af8064f589"],

Cell[TextData[{
 "The additional photon-energy diagonal has entries",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["D", 
      RowBox[{"{", 
       RowBox[{"m", ",", "n"}], "}"}]], "\[LongEqual]", 
     RowBox[{
      RowBox[{"-", "m"}], " ", "\[Omega]", " ", 
      TemplateBox[{
        RowBox[{"m", ",", "n"}]},
       "KroneckerDeltaSeq"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "b4eb9c84-8224-eb43-9d39-d4873896d018"]
}], "Notes",
