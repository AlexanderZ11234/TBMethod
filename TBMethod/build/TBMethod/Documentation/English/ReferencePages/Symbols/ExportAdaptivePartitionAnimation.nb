  RowBox[{"points", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.", ",", "0."}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.", ",", "1."}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1.", ",", "0."}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1.", ",", "1."}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2.", ",", "0."}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2.", ",", "1."}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"layers", "=", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{
     RowBox[{"Range", "[", "3", "]"}], ",", 
     RowBox[{"Partition", "[", 
      RowBox[{"points", ",", "2"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"destination", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"CreateDirectory", "[", "]"}], ",", "\"\<partition.gif\>\""}], 
     "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ExportAdaptivePartitionAnimation", "[", 
  RowBox[{"points", ",", "layers", ",", "destination", ",", 
