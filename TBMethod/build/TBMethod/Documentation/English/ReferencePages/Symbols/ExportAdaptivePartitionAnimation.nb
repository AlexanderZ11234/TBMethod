\>", "ExampleText",
 CellID->1587183518,ExpressionUUID->"ad573441-d1ee-6840-b6bf-c8e69d4f0b74"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->980610878,ExpressionUUID->"c0267df9-d7ee-4446-8eb1-f259a0633415"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"points", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.`", ",", "0.`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.`", ",", "1.`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1.`", ",", "0.`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1.`", ",", "1.`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2.`", ",", "0.`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2.`", ",", "1.`"}], "}"}]}], "}"}]}], ";", 
  RowBox[{"layers", "=", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{
     RowBox[{"Range", "[", "3", "]"}], ",", 
     RowBox[{"Partition", "[", 
      RowBox[{"points", ",", "2"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"destination", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"CreateDirectory", "[", "]"}], ",", "\"\<partition.gif\>\""}], 
     "}"}], "]"}]}], ";", 
  RowBox[{"result", "=", 
   RowBox[{"ExportAdaptivePartitionAnimation", "[", 
    RowBox[{"points", ",", "layers", ",", "destination", ",", 
     RowBox[{"ImageSize", "\[Rule]", "200"}]}], "]"}]}], ";", 
  "result"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->2005231905,ExpressionUUID->"d554a683-b6bb-814f-95a0-55fc9cf1e3e1"],

