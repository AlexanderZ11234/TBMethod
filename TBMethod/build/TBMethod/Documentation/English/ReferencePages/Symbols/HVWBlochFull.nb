Cell["\<\
Returns {H, V, W}. V[[a]] is the first momentum derivative and W[[a,b]] is \
the second momentum derivative.\
\>", "Notes",
 CellID->1745842271,ExpressionUUID->"37db05c6-627a-eb40-9883-0e9afecfddad"],

Cell["\<\
No factors of hbar are inserted. The Hessian contribution from displacement r \
is -r[[a]] r[[b]] Exp[-I r.k] h.\
\>", "Notes",
 CellID->894498577,ExpressionUUID->"23850c5e-63de-5340-9b13-4c73d30764ad"],

Cell["Requires all directed hoppings explicitly.", "Notes",
 CellID->642123194,ExpressionUUID->"93f1eb0f-4215-5446-bc31-0be524cd60fa"]
}, Closed]],

