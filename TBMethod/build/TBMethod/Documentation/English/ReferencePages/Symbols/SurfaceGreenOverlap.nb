Cell[TextData[{
 "The nonorthogonal lead satisfies the corresponding surface resolvent \
equation",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["g", "s"], "(", "z", ")"}], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{"(", 
         RowBox[{
           RowBox[{"z", " ", 
             SubscriptBox["s", "0"]}], "-", 
           SubscriptBox["h", "0"], "-", 
           RowBox[{
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox["h", "1"], "-", 
                 RowBox[{"z", " ", 
                   SubscriptBox["s", "1"]}]}], ")"}], ".", 
             RowBox[{
               SubscriptBox["g", "s"], "(", "z", ")"}], ".", 
             RowBox[{"(", 
               RowBox[{
                 TemplateBox[{
                   RowBox[{"(", 
                    SubscriptBox["h", "1"], ")"}]}, "ConjugateTranspose", 
                  SyntaxForm -> SuperscriptBox], "-", 
                 RowBox[{"z", " ", 
                   TemplateBox[{
                    RowBox[{"(", 
                    SubscriptBox["s", "1"], ")"}]}, "ConjugateTranspose", 
                    SyntaxForm -> SuperscriptBox]}]}], ")"}]}]}], ")"}]},
      "Inverse"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "f2678a9b-e8b4-1a48-a845-3afa6297a1cd"]
}], "Notes",
 CellID->2028643540,ExpressionUUID->"32aa372f-35e0-2247-bb7b-fa161a81f04b"]
}, Closed]],

