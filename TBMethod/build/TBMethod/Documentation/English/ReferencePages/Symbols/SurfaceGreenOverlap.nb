Cell[TextData[{
 "The nonorthogonal lead satisfies the corresponding surface resolvent \
equation",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["g", "s"], "(", "z", ")"}], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{"(", 
         RowBox[{
           RowBox[{"z", " ", 
             SubscriptBox["s", "0"]}], "-", 
           SubscriptBox["h", "0"], "-", 
           RowBox[{
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox["h", "1"], "-", 
                 RowBox[{"z", " ", 
                   SubscriptBox["s", "1"]}]}], ")"}], ".", 
             RowBox[{
               SubscriptBox["g", "s"], "(", "z", ")"}], ".", 
             RowBox[{"(", 
               RowBox[{
                 TemplateBox[{
                   RowBox[{"(", 
                    SubscriptBox["h", "1"], ")"}]}, "ConjugateTranspose", 
                  SyntaxForm -> SuperscriptBox], "-", 
                 RowBox[{"z", " ", 
                   TemplateBox[{
                    RowBox[{"(", 
                    SubscriptBox["s", "1"], ")"}]}, "ConjugateTranspose", 
                    SyntaxForm -> SuperscriptBox]}]}], ")"}]}]}], ")"}]},
      "Inverse"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "826a9b60-e18d-254c-86c8-9576e5782ba4"]
}], "Notes",
 CellID->1243210473,ExpressionUUID->"39ff72c6-303e-8147-b387-dd31b7188c53"]
}, Closed]],

