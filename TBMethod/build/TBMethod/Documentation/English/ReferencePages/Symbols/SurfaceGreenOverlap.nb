Cell[TextData[{
 "The nonorthogonal lead satisfies the corresponding surface resolvent \
equation",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["g", "s"], "(", "z", ")"}], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{"(", 
         RowBox[{
           RowBox[{"z", " ", 
             SubscriptBox["s", "0"]}], "-", 
           SubscriptBox["h", "0"], "-", 
           RowBox[{
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox["h", "1"], "-", 
                 RowBox[{"z", " ", 
                   SubscriptBox["s", "1"]}]}], ")"}], ".", 
             RowBox[{
               SubscriptBox["g", "s"], "(", "z", ")"}], ".", 
             RowBox[{"(", 
               RowBox[{
                 TemplateBox[{
                   RowBox[{"(", 
                    SubscriptBox["h", "1"], ")"}]}, "ConjugateTranspose", 
                  SyntaxForm -> SuperscriptBox], "-", 
                 RowBox[{"z", " ", 
                   TemplateBox[{
                    RowBox[{"(", 
                    SubscriptBox["s", "1"], ")"}]}, "ConjugateTranspose", 
                    SyntaxForm -> SuperscriptBox]}]}], ")"}]}]}], ")"}]},
      "Inverse"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "ce2cd3d1-b6aa-fb4c-9c40-e6ef562ef1ce"]
}], "Notes",
 CellID->1488110070,ExpressionUUID->"0c1079f4-0bb6-ea44-8ea6-3e101c40d706"]
}, Closed]],

