Cell[TextData[{
 "The nonorthogonal lead satisfies the corresponding surface resolvent \
equation",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["g", "s"], "(", "z", ")"}], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{"(", 
         RowBox[{
           RowBox[{"z", " ", 
             SubscriptBox["s", "0"]}], "-", 
           SubscriptBox["h", "0"], "-", 
           RowBox[{
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox["h", "1"], "-", 
                 RowBox[{"z", " ", 
                   SubscriptBox["s", "1"]}]}], ")"}], ".", 
             RowBox[{
               SubscriptBox["g", "s"], "(", "z", ")"}], ".", 
             RowBox[{"(", 
               RowBox[{
                 TemplateBox[{
                   RowBox[{"(", 
                    SubscriptBox["h", "1"], ")"}]}, "ConjugateTranspose", 
                  SyntaxForm -> SuperscriptBox], "-", 
                 RowBox[{"z", " ", 
                   TemplateBox[{
                    RowBox[{"(", 
                    SubscriptBox["s", "1"], ")"}]}, "ConjugateTranspose", 
                    SyntaxForm -> SuperscriptBox]}]}], ")"}]}]}], ")"}]},
      "Inverse"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "7a649153-7068-f649-af29-2485c0c93cbe"]
}], "Notes",
 CellID->747667840,ExpressionUUID->"d900d2bc-a166-3144-a2e0-4da8df537793"]
}, Closed]],

