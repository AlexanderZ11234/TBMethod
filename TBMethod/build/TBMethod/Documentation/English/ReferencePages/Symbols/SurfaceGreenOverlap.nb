Cell[TextData[{
 "The nonorthogonal lead satisfies the corresponding surface resolvent \
equation",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["g", "s"], "(", "z", ")"}], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{"(", 
         RowBox[{
           RowBox[{"z", " ", 
             SubscriptBox["s", "0"]}], "-", 
           SubscriptBox["h", "0"], "-", 
           RowBox[{
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox["h", "1"], "-", 
                 RowBox[{"z", " ", 
                   SubscriptBox["s", "1"]}]}], ")"}], ".", 
             RowBox[{
               SubscriptBox["g", "s"], "(", "z", ")"}], ".", 
             RowBox[{"(", 
               RowBox[{
                 TemplateBox[{
                   RowBox[{"(", 
                    SubscriptBox["h", "1"], ")"}]}, "ConjugateTranspose", 
                  SyntaxForm -> SuperscriptBox], "-", 
                 RowBox[{"z", " ", 
                   TemplateBox[{
                    RowBox[{"(", 
                    SubscriptBox["s", "1"], ")"}]}, "ConjugateTranspose", 
                    SyntaxForm -> SuperscriptBox]}]}], ")"}]}]}], ")"}]},
      "Inverse"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "a1a40f8e-2ae8-1642-874d-6057e3ee46cd"]
}], "Notes",
 CellID->1243210473,ExpressionUUID->"d729e8dd-84d7-1f47-8d70-9d07d2cf5c84"]
}, Closed]],

