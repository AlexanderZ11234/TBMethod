  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8477010d-bd62-da49-b19e-30edd69df254"],
 " and ",
 Cell[BoxData["2"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "01ebf939-04ed-7441-afdd-3b04b1eb6438"],
 "."
}], "Notes",
 CellID->1819043402,ExpressionUUID->"1126d59e-410a-aa41-9323-392e349a50d2"],

