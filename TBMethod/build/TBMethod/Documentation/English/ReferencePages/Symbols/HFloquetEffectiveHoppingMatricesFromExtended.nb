Cell[TextData[{
 "Accepts an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e2eb11e2-25e0-b246-a905-a0c6f39d468a"],
 " with entries ",
 Cell[BoxData[
  RowBox[{
   StyleBox["displacement", "TI"], "\[Rule]", 
   StyleBox["extendedHoppingMatrix", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "82ef8a82-9560-a143-be38-ca1985a1dbdb"],
 ", or the two-list layered scattering-region block representation. Every \
matrix uses internal-major, photon-minor ordering with ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"2", " ", "m"}], "+", "1"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "ce67b6ae-1c72-624f-bed3-0daacd5f9c9c"],
 " photon sectors."
}], "Notes",
 CellID->870078728,ExpressionUUID->"bd077931-57ee-3b4d-85ec-9611710bfff9"],

Cell["\<\
For displacement associations, block multiplication adds displacement \
vectors. Supply a complete directed-hopping association when needed to \
represent a Hermitian model.\
\>", "Notes",
 CellID->483172806,ExpressionUUID->"75932f21-90a4-c742-9eb3-fe27fd1f5c38"],

Cell[TextData[{
 "For scattering-region input, block multiplication contracts layer indices. \
If the effective result contains nonzero couplings between nonadjacent \
layers, the implementation emits a message and returns ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Failed"]], "paclet:ref/$Failed"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fe038afe-40c0-6b4b-99ae-1311b13a92d8"],
 " because the two-list form cannot represent them."
}], "Notes",
 CellID->342267340,ExpressionUUID->"66da4528-a1db-0744-9412-2cae904414b6"],

Cell[TextData[{
 "The options ",
