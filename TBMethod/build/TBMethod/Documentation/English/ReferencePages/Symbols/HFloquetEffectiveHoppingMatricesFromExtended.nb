Cell["\<\
Downfold a two-layer block-tridiagonal Hamiltonian in the same photon \
ordering.\
\>", "ExampleText",
 CellID->607248877,ExpressionUUID->"2bf9e558-3c88-d54c-8d8e-baedb7d421e9"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1387280760,ExpressionUUID->"7414a272-fc33-fe48-8770-393f5484e432"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"omega", "=", "10."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h0", "=", 
   RowBox[{
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "3", "]"}], ",", 
      RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}], "+", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "0", "]"}], ",", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{
        RowBox[{"-", "omega"}], " ", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "]"}]}], "]"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h1", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"-", 
