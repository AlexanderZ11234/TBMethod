Cell[TextData[{
 "Accepts an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4207d2e6-b509-7c40-b870-81e65c6489a7"],
 " with entries ",
 Cell[BoxData[
  RowBox[{
   StyleBox["displacement", "TI"], "\[Rule]", 
   StyleBox["extendedHoppingMatrix", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bf1fdc3b-3996-b840-a1ce-897d7c0b7ef5"],
 ", or the two-list layered scattering-region block representation. Every \
matrix uses internal-major, photon-minor ordering with ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"2", " ", "m"}], "+", "1"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "e827c1c2-e084-5542-8fb2-54382c11fd94"],
 " photon sectors."
}], "Notes",
 CellID->870078728,ExpressionUUID->"fd2489a3-2810-fc46-8a2f-e91587554bd9"],

Cell["\<\
For displacement associations, block multiplication adds displacement \
vectors. Supply a complete directed-hopping association when needed to \
represent a Hermitian model.\
\>", "Notes",
 CellID->483172806,ExpressionUUID->"57394a31-aabf-924b-9048-1c9cdf00801c"],

Cell[TextData[{
 "For scattering-region input, block multiplication contracts layer indices. \
If the effective result contains nonzero couplings between nonadjacent \
layers, the implementation emits a message and returns ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Failed"]], "paclet:ref/$Failed"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "301c1553-30e6-ca4b-b9bb-0ea808526bd8"],
 " because the two-list form cannot represent them."
}], "Notes",
 CellID->342267340,ExpressionUUID->"eadd3e1d-0409-7c43-877a-856a9679a2dd"],

Cell[TextData[{
 "The options ",
 Cell[BoxData[
  RowBox[{"\"\<ExpansionOrder\>\"", "\[Rule]", "1"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "49141bbc-6be9-0a46-98a2-90a17db3f9d5"],
