}], "Notes",
 CellID->1351751408,ExpressionUUID->"99133cf7-57b0-e040-8cd5-583a51c62a52"],

Cell[TextData[{
 "The site phase is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"exp", "(", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"\[Chi]", "(", 
       RowBox[{"x", ",", "y"}], ")"}]}], ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "5e763587-668a-d340-aec4-8a1d258490e8"],
 ", with ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"\[Chi]", "(", 
      RowBox[{"x", ",", "y"}], ")"}], "\[LongEqual]", 
     RowBox[{"2", " ", "\[Pi]", " ", "B", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", " ", "y", " ", 
         RowBox[{
          SuperscriptBox["sin", "2"], "(", "\[Alpha]", ")"}]}], "+", 
        RowBox[{
         FractionBox["1", "4"], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["x", "2"], "-", 
           SuperscriptBox["y", "2"]}], ")"}], " ", 
         RowBox[{"sin", "(", 
          RowBox[{"2", " ", "\[Alpha]"}], ")"}]}]}], ")"}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "be1ad8cc-a388-b34c-9f20-84c4da4aebfd"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TagBox["\[Alpha]",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "ddff497a-7591-7448-b5ea-d4fff3c092e4"],
 " is ",
 Cell[BoxData[
  StyleBox["angle", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0829bbf3-abe1-2a46-a6d3-faa8c4ebe2a5"],
 "."
}], "Notes",
 CellID->1754560481,ExpressionUUID->"32245fa6-90db-5b4a-8ed8-27cd6341faf0"],

