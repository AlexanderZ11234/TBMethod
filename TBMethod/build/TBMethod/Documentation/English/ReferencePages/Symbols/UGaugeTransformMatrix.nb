Cell[TextData[{
 "The site phase is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"exp", "(", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"\[Chi]", "(", 
       RowBox[{"x", ",", "y"}], ")"}]}], ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "3cf4badc-9730-cd47-8e21-df12214100cb"],
 ", with ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"\[Chi]", "(", 
      RowBox[{"x", ",", "y"}], ")"}], "\[LongEqual]", 
     RowBox[{"2", " ", "\[Pi]", " ", "B", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", " ", "y", " ", 
         RowBox[{
          SuperscriptBox["sin", "2"], "(", "\[Alpha]", ")"}]}], "+", 
        RowBox[{
         FractionBox["1", "4"], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["x", "2"], "-", 
           SuperscriptBox["y", "2"]}], ")"}], " ", 
         RowBox[{"sin", "(", 
          RowBox[{"2", " ", "\[Alpha]"}], ")"}]}]}], ")"}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "26e87480-80e6-2e47-9d31-846748a727ca"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TagBox["\[Alpha]",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "24b11cfc-c936-5e40-92fc-fd6549147f76"],
 " is ",
 Cell[BoxData[
  StyleBox["angle", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bd0359b9-a910-9145-94e2-37c32a37b192"],
 "."
}], "Notes",
 CellID->285357665,ExpressionUUID->"f55dc9ec-641e-964b-a9f9-30fa7aadb4cb"],

