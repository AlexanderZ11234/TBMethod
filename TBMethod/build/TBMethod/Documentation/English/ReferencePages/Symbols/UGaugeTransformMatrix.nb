  FontFamily->"Source Sans Pro",ExpressionUUID->
  "48a983b6-101b-0749-ae3b-1edc6ef0c9d7"],
 ". Each site phase is tensored with the internal identity matrix."
}], "Notes",
 CellID->1351751408,ExpressionUUID->"9013d64f-5393-694d-b871-21c0af98e9e8"],

Cell[TextData[{
 "The site phase is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"exp", "(", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"\[Chi]", "(", 
       RowBox[{"x", ",", "y"}], ")"}]}], ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "6fd88d4c-1ba3-6a45-b922-509ec6fca871"],
 ", with ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"\[Chi]", "(", 
      RowBox[{"x", ",", "y"}], ")"}], "\[LongEqual]", 
     RowBox[{"2", " ", "\[Pi]", " ", "B", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", " ", "y", " ", 
         RowBox[{
          SuperscriptBox["sin", "2"], "(", "\[Alpha]", ")"}]}], "+", 
        RowBox[{
         FractionBox["1", "4"], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["x", "2"], "-", 
           SuperscriptBox["y", "2"]}], ")"}], " ", 
         RowBox[{"sin", "(", 
          RowBox[{"2", " ", "\[Alpha]"}], ")"}]}]}], ")"}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "54e4df51-5795-c04b-ac5c-d8b11d13879b"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TagBox["\[Alpha]",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "7e95c079-cf3c-5f43-b14c-2a5734e1aaa0"],
 " is ",
 Cell[BoxData[
  StyleBox["angle", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "20b09ddd-4824-9c47-a506-73c233982e6d"],
 "."
}], "Notes",
 CellID->1754560481,ExpressionUUID->"149039ac-933a-714e-b423-b82bc7040b5b"],

Cell["\<\
The result uses site-major ordering, with the internal degrees of freedom \
contiguous at each site.\
\>", "Notes",
 CellID->2052677712,ExpressionUUID->"c1afa1bd-9ae6-5f49-8be7-32873f4aac43"]
}, Closed]],

