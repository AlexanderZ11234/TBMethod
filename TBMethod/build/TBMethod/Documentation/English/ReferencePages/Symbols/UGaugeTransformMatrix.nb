Cell[TextData[{
 Cell[BoxData[
  StyleBox["points", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5f9ae9c1-1254-e84a-afac-4459bce2c6ac"],
 " contains two-dimensional coordinate lists or rules of the form ",
