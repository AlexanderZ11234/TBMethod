Cell[TextData[{
 Cell[BoxData[
  StyleBox["points", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3e187a0b-8262-bb44-9c0b-d4ff0226bde0"],
 " contains two-dimensional coordinate lists or rules of the form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["label", "TI"], "\[Rule]", 
