Cell[TextData[{
 Cell[BoxData[
  StyleBox["points", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bfd0c880-11ed-334d-8f2c-7f62258aa56e"],
 " contains two-dimensional coordinate lists or rules of the form ",
