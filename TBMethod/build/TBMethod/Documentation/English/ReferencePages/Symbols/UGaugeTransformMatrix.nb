  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9d6fe1e1-3437-8c49-b1fd-aa29c36921b7"],
 ". Each site phase is tensored with the internal identity matrix."
}], "Notes",
 CellID->1351751408,ExpressionUUID->"e4dfa53b-3a26-664b-965b-a4fbda5a6ffb"],

Cell[TextData[{
 "The site phase is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"exp", "(", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"\[Chi]", "(", 
       RowBox[{"x", ",", "y"}], ")"}]}], ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "0ade2eda-c94b-5e46-984d-b3e719f573a7"],
 ", with ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"\[Chi]", "(", 
      RowBox[{"x", ",", "y"}], ")"}], "\[LongEqual]", 
     RowBox[{"2", " ", "\[Pi]", " ", "B", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", " ", "y", " ", 
         RowBox[{
          SuperscriptBox["sin", "2"], "(", "\[Alpha]", ")"}]}], "+", 
        RowBox[{
         FractionBox["1", "4"], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["x", "2"], "-", 
           SuperscriptBox["y", "2"]}], ")"}], " ", 
         RowBox[{"sin", "(", 
          RowBox[{"2", " ", "\[Alpha]"}], ")"}]}]}], ")"}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "e7235347-0ab3-f34a-aebe-d71b17dc3a56"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TagBox["\[Alpha]",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "5474620e-a269-b142-81ec-5abd11570054"],
 " is ",
 Cell[BoxData[
  StyleBox["angle", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c94c18bd-6df3-9140-8b9e-8ed92922c70e"],
 "."
}], "Notes",
 CellID->1754560481,ExpressionUUID->"dcf1c96f-be7a-3c41-bbf7-fd0a953b04b1"],

Cell["\<\
The result uses site-major ordering, with the internal degrees of freedom \
contiguous at each site.\
\>", "Notes",
 CellID->2052677712,ExpressionUUID->"50501c87-5ffa-2e49-a80b-6a2b3c4c5d9a"]
}, Closed]],

