  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9e30460b-c844-a94b-92d8-449419b815cf"],
 ". Each site phase is tensored with the internal identity matrix."
}], "Notes",
 CellID->1824659702,ExpressionUUID->"8c2c5cde-ee9c-2a47-a888-8f9d91deeddd"],

Cell[TextData[{
 "The site phase is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"exp", "(", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"\[Chi]", "(", 
       RowBox[{"x", ",", "y"}], ")"}]}], ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "1933c5a8-de50-b940-9856-2a2b163f7acc"],
 ", with ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"\[Chi]", "(", 
      RowBox[{"x", ",", "y"}], ")"}], "\[LongEqual]", 
     RowBox[{"2", " ", "\[Pi]", " ", "B", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", " ", "y", " ", 
         RowBox[{
          SuperscriptBox["sin", "2"], "(", "\[Alpha]", ")"}]}], "+", 
        RowBox[{
         FractionBox["1", "4"], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["x", "2"], "-", 
           SuperscriptBox["y", "2"]}], ")"}], " ", 
         RowBox[{"sin", "(", 
          RowBox[{"2", " ", "\[Alpha]"}], ")"}]}]}], ")"}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "e75fdd2e-986e-dd4d-8694-acaa81a7367e"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TagBox["\[Alpha]",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "e591732a-97ce-ec4e-9c24-1f1e1bd0eafe"],
 " is ",
 Cell[BoxData[
  StyleBox["angle", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3f4d6106-e287-cf44-85f7-719d4c035edc"],
 "."
}], "Notes",
 CellID->1578626019,ExpressionUUID->"9cfa157e-bea7-1b4d-ae03-915c2327d9a5"],

Cell["\<\
