Cell[TextData[{
 Cell[BoxData[
  StyleBox["points", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c87a7dc7-7e79-264e-8895-a1107b44f167"],
 " contains two-dimensional coordinate lists or rules of the form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["label", "TI"], "\[Rule]", 
