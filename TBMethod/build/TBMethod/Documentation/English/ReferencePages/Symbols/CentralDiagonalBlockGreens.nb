Cell["\<\
Requires at least two layers and one fewer lower off-diagonal block than \
diagonal blocks.\
\>", "Notes",
 CellID->961577355,ExpressionUUID->"b7edc241-48b8-054c-b02f-e83bd3ceb6ef"],

Cell["\<\
All self-energies act on the final layer. Diagonal Green blocks are returned \
in the original layer order.\
\>", "Notes",
 CellID->1550993933,ExpressionUUID->"ebe61f4a-afe6-6a4f-84bb-aec8c6b0773d"],

Cell["\<\
Upper blocks default to the conjugate transposes of the corresponding lower \
blocks.\
\>", "Notes",
 CellID->151687782,ExpressionUUID->"4f004fd2-a139-1b47-80c5-83b3fae486c9"],

Cell[TextData[{
 "Given the left-connected Green blocks F from the forward recursion, the \
backward recursion is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["G", 
      RowBox[{"{", 
       RowBox[{"j", ",", "j"}], "}"}]], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["F", "j"], "+", 
      RowBox[{
       SubscriptBox["F", "j"], ".", 
       SubscriptBox["H", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"j", "+", "1"}]}], "}"}]], ".", 
       SubscriptBox["G", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"j", "+", "1"}], ",", 
          RowBox[{"j", "+", "1"}]}], "}"}]], ".", 
       SubscriptBox["H", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"j", "+", "1"}], ",", "j"}], "}"}]], ".", 
       SubscriptBox["F", "j"]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "5ad0a7cc-72dd-d145-85c0-c00185566501"]
}], "Notes",
 CellID->1623474945,ExpressionUUID->"61fcc668-7f44-604f-8628-be85945ab5a3"]
}, Closed]],

