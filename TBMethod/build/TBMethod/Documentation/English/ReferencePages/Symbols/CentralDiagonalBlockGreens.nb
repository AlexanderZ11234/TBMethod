Cell["\<\
All self-energies act on the final layer. Diagonal Green blocks are returned \
in the original layer order.\
\>", "Notes",
 CellID->1518269569,ExpressionUUID->"881ac85a-7a21-8b4d-a846-ae27a2724836"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  StyleBox["upperBlocks", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4cf7a225-25a0-4a46-9657-a050894f7052"],
 " is omitted, the upper blocks are ",
 Cell[BoxData[
  RowBox[{"ConjugateTranspose", " ", "/@", " ", "lowerBlocks"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"49c0682b-e778-434c-8745-d254b9daa811"],
 "."
}], "Notes",
 CellID->1247517387,ExpressionUUID->"2ce73bb4-9724-8e41-a689-214346544b25"],

Cell[TextData[{
 "Given the left-connected Green blocks ",
 Cell[BoxData[
  FormBox[
   TagBox["F",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "45f91179-dbbd-7a44-a161-691d78050781"],
 " from the forward recursion, the backward recursion is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["G", 
      RowBox[{"{", 
       RowBox[{"j", ",", "j"}], "}"}]], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["F", "j"], "+", 
      RowBox[{
       SubscriptBox["F", "j"], ".", 
       SubscriptBox["H", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"j", "+", "1"}]}], "}"}]], ".", 
       SubscriptBox["G", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"j", "+", "1"}], ",", 
          RowBox[{"j", "+", "1"}]}], "}"}]], ".", 
       SubscriptBox["H", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"j", "+", "1"}], ",", "j"}], "}"}]], ".", 
       SubscriptBox["F", "j"]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "b2f0d4d0-2510-4b4f-86d6-b54ee4464749"]
}], "Notes",
 CellID->1555961574,ExpressionUUID->"2b995bb9-471e-ea49-b1a4-7c43ac54d5c6"]
}, Closed]],

