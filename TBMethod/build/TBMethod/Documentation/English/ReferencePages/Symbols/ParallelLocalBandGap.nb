Cell["\<\
Calculate a constant direct gap over three samples in parallel.\
\>", "ExampleText",
 CellID->1681169714,ExpressionUUID->"e8fe1e11-7a69-0a43-8bf6-324999c6b689"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1797560625,ExpressionUUID->"dc40044f-453d-9142-815f-fd81cb6b95c4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"$KernelCount", "\[Equal]", "0"}], ",", 
    RowBox[{"LaunchKernels", "[", "2", "]"}]}], "]"}], ";", 
  RowBox[{"ParallelNeeds", "[", "\"\<TBMethod`\>\"", "]"}], ";", 
  RowBox[{"Clear", "[", "h", "]"}], ";", 
  RowBox[{
   RowBox[{"h", "[", "k_", "]"}], ":=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"k", "-", "1.`"}], ",", 
      RowBox[{"k", "+", "1.`"}]}], "}"}], "]"}]}], ";", 
  RowBox[{"DistributeDefinitions", "[", "h", "]"}], ";", 
  RowBox[{"result", "=", 
   RowBox[{"ParallelLocalBandGap", "[", 
    RowBox[{"h", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.5`"}], ",", "0.`", ",", "0.5`"}], "}"}], ",", "1"}], 
    "]"}]}], ";", "result"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->766532455,ExpressionUUID->"2b06a9c2-22bd-d640-98ca-a39b8e273637"],

