Cell["\<\
Uses ParallelTable over the same real scalar or real-vector sample format \
required by LocalBandGap.\
\>", "Notes",
 CellID->1136165809,ExpressionUUID->"23d2a2ad-54cd-b447-ad3b-cabbc2ba3162"],

Cell["\<\
Returns Min[E[n+1,k]-E[n,k]] over the supplied samples, after Chop; n refers \
to sorted eigenvalues.\
\>", "Notes",
 CellID->1384596988,ExpressionUUID->"c5ed7bad-399e-da45-bd44-7e577283ae29"],

Cell["\<\
Load TBMethod and make the model available on subkernels. Eigenvalues options \
are accepted and Method -> \"Direct\" is supplied internally.\
\>", "Notes",
 CellID->1718794761,ExpressionUUID->"5c6b6581-0923-8040-bba1-a0f101054073"],

Cell["\<\
The example launches two kernels only if no kernels are already running.\
\>", "Notes",
 CellID->489565652,ExpressionUUID->"6e4ea67d-fdf2-f141-b5c9-c8259f6d8c7c"]
}, Closed]],

