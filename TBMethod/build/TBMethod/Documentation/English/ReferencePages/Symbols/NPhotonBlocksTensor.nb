Cell[TextData[{
 Cell[BoxData[
  StyleBox["matrixModulation", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a7a59711-9fac-ea49-898c-4a67fc03079d"],
 " is a periodic matrix-valued function of a dimensionless angle. Its \
dimensions are inferred by evaluating ",
 Cell[BoxData[
  RowBox[{"matrixModulation", "[", "0.123", "]"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"82262094-6b9e-f44c-a47b-d46687ff1dab"],
 "."
}], "Notes",
 CellID->223568907,ExpressionUUID->"be7cafa3-3584-6e40-ba24-b2bd8dc80567"],

Cell[TextData[{
 "Returns two rank-4 tensors with axes ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
   "internalRow", ",", " ", "internalColumn", ",", " ", "photonRow", ",", " ",
     "photonColumn"}], "}"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"61bda605-8e35-dd4a-b849-ae72551a3900"],
 ". Photon indices run from ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"-", "m"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "552d489b-dcaa-dd47-9cb8-d3e1dd8a0505"],
 " through ",
 Cell[BoxData[
  StyleBox["m", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bfb5da81-756b-6e4b-a6b4-cd6760c8b809"],
 "."
}], "Notes",
 CellID->807466374,ExpressionUUID->"b40eb714-aced-2c40-a5c4-832f191de37a"],

Cell[TextData[{
 "For distinct sites, the first tensor contains Fourier coefficients at ",
 Cell[BoxData[
  RowBox[{"columnIndex", " ", "-", " ", "rowIndex"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"f78dc7da-d445-594e-8e19-86806124a985"],
 " and the second is zero. For coincident sites, the first is the \
internal/photon identity tensor and the second includes the Fourier tensor \
and a diagonal photon-energy shift of ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"-", "n"}], " ", "\[Omega]"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "805d17c5-f183-b24c-bcee-d6f7a79af2f6"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TagBox["n",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "cf08ae4f-50c1-f04d-9e98-c8a676341a20"],
 " is the photon index."
}], "Notes",
 CellID->1741453013,ExpressionUUID->"13376db7-8028-534e-99c1-ed1eea07bc88"],

Cell[TextData[{
 "Coincidence is detected using a distance threshold of ",
