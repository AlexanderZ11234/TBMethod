Cell[TextData[{
 Cell[BoxData[
  StyleBox["matrixModulation", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7116ea41-869f-f94f-8879-0ca899e72899"],
 " is a periodic matrix-valued function of a dimensionless angle. Its \
dimensions are inferred by evaluating ",
 Cell[BoxData[
  RowBox[{
   StyleBox["matrixModulation", "TI"], "[", "0.123", "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "39f49e2c-a58a-bd42-b124-14688ed0984b"],
 "."
}], "Notes",
 CellID->1228670679,ExpressionUUID->"409540ff-eadf-e64f-9e05-a4e2f4865ecb"],

Cell[TextData[{
 "Returns two rank-4 tensors with axes ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["internalRow", "TI"], ",", 
    StyleBox["internalColumn", "TI"], ",", 
    StyleBox["photonRow", "TI"], ",", 
    StyleBox["photonColumn", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "60e7e057-3acd-1047-8d7a-81e4e42ac0e3"],
 ". Photon indices run from ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"-", "m"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "00562ae6-cd93-774b-ac45-96517caf100b"],
 " through ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cc6fc7bd-41f9-7345-b3e9-db40924bb40f"],
 "."
}], "Notes",
 CellID->615513377,ExpressionUUID->"9c8eb53f-3d39-6944-83c6-887c667cf284"],

Cell[TextData[{
 "For distinct sites, the first tensor contains Fourier coefficients at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["columnIndex", "TI"], "-", 
   StyleBox["rowIndex", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5484bbdf-5a62-7644-99b3-cca0e9a8b501"],
 " and the second is zero. For coincident sites, the first is the \
internal/photon identity tensor and the second includes the Fourier tensor \
and a diagonal photon-energy shift of ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"-", "n"}], " ", "\[Omega]"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "823fcbca-5557-a744-85bc-c3de54ba2c5a"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TagBox["n",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "acb82554-b189-c44d-9db7-5dfa5ba3cadc"],
 " is the photon index."
}], "Notes",
 CellID->1983556313,ExpressionUUID->"42f6d747-b5c0-3840-a195-a50559e662d8"],

Cell[TextData[{
 "Coincidence is detected using a distance threshold of ",
 Cell[BoxData["0.00001"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "94ebc89d-61a3-2943-8a4d-a749106f48c1"],
