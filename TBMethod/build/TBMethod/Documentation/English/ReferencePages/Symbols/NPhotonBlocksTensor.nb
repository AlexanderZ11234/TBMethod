Cell[TextData[{
 Cell[BoxData[
  StyleBox["matrixModulation", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "83e4713e-c652-6f4c-97d9-7a4529ca844c"],
 " is a periodic matrix-valued function of a dimensionless angle. Its \
dimensions are inferred by evaluating ",
 Cell[BoxData[
  RowBox[{
   StyleBox["matrixModulation", "TI"], "[", "0.123", "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "791583a7-2bf4-d743-ac31-de79f1bc9a8a"],
 "."
}], "Notes",
 CellID->1228670679,ExpressionUUID->"a7d43119-81f2-c54e-9db7-5134778ac6bf"],

Cell[TextData[{
 "Returns two rank-4 tensors with axes ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["internalRow", "TI"], ",", 
    StyleBox["internalColumn", "TI"], ",", 
    StyleBox["photonRow", "TI"], ",", 
    StyleBox["photonColumn", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e97a2cb2-3f13-f644-a5b6-ce726e075277"],
 ". Photon indices run from ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"-", "m"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "86921b2f-1097-6f40-be41-2d5da4b95c2a"],
 " through ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "06121c1a-7e4c-ee43-b45f-b6173b47e6f0"],
 "."
}], "Notes",
 CellID->615513377,ExpressionUUID->"b305b659-16b1-1e4e-a937-9a1deb2f14df"],

Cell[TextData[{
 "For distinct sites, the first tensor contains Fourier coefficients at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["columnIndex", "TI"], "-", 
   StyleBox["rowIndex", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "948ec961-66cb-e14e-9829-13a38baae1bb"],
 " and the second is zero. For coincident sites, the first is the \
internal/photon identity tensor and the second includes the Fourier tensor \
and a diagonal photon-energy shift of ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"-", "n"}], " ", "\[Omega]"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "85f906b5-ff7b-a84a-b0a6-d4570f0e1474"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TagBox["n",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "06d989d7-54e0-3645-bdf8-7e892acea386"],
 " is the photon index."
}], "Notes",
 CellID->1983556313,ExpressionUUID->"c2411169-a7b2-d343-90f0-2bfc0f8f6441"],

Cell[TextData[{
 "Coincidence is detected using a distance threshold of ",
