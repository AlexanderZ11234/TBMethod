Cell[TextData[{
 Cell[BoxData[
  StyleBox["crystal", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6dbc7e39-94e8-af4b-a7cd-b6108c7db435"],
 " is a nonempty association of cell translations with site-coordinate lists. \
The coordinates in its first cell supply the basis positions and site \
ordering. Labeled sites of the form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["label", "TI"], "\[Rule]", 
   StyleBox["position", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6c640f0a-9fc4-da44-b5c9-83929eca19bf"],
 " are also accepted."
}], "Notes",
 CellID->802271024,ExpressionUUID->"6d89805d-192c-ea48-b802-7e6790a3c397"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["effectiveHoppings", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e00140ec-7ca9-0f4f-8186-b7a666516c91"],
 " maps displacement vectors to square hopping matrices. Each matrix must \
have equal internal dimension per site and a matrix size divisible by the \
number of basis sites."
}], "Notes",
 CellID->1016644864,ExpressionUUID->"9f4efa5f-c228-5e4c-827a-eda0f82ac8af"],

Cell["\<\
Every supplied displacement is examined, including the zero displacement. The \
matrix is partitioned into site-to-site internal blocks, and only retained \
blocks contribute distances.\
\>", "Notes",
 CellID->1802124139,ExpressionUUID->"cc0ef24a-6d17-6e44-a431-ab3646444a29"],

Cell[TextData[{
 "The string-named option ",
 Cell[BoxData[
  RowBox[{"\"\<ZeroThreshold\>\"", "\[Rule]", "0.00001"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e58aa277-1605-0042-b64e-26e660adf1c8"],
 " is the default. A numeric block is discarded when the largest absolute \
value of its entries is less than or equal to this threshold."
}], "Notes",
 CellID->427449942,ExpressionUUID->"6e4a17b7-fe8b-2649-8cac-78889778aea7"],

Cell[TextData[{
 "For a nonnumeric block, all entries must satisfy ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PossibleZeroQ"]], "paclet:ref/PossibleZeroQ"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "aefcafc3-ddf1-5c44-ac00-78329b8a94a9"],
 " for the block to be discarded. A symbolic entry that cannot be recognized \
as zero keeps its block."
}], "Notes",
 CellID->1180593144,ExpressionUUID->"92a8a455-8f87-2e41-8050-7675727263ac"],

Cell[TextData[{
 "The return value is a nonnegative distance when at least one block is \
retained. An empty hopping association, or one with no retained blocks, \
returns ",
 Cell[BoxData[
  RowBox[{"-", "\[Infinity]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ff3f85ba-88f0-314a-9980-8759a2111ace"],
 "."
}], "Notes",
 CellID->635529244,ExpressionUUID->"affe36d2-edcb-4646-8458-fdb87be7c51d"],

Cell["\<\
The current interface takes no original-hoppings association or original \
distance cutoff. It measures the supplied association directly, including \
bonds within displacement keys that were already present before downfolding.\
\>", "Notes",
 CellID->1339785259,ExpressionUUID->"8012f5c8-02c3-3748-ae0e-1b0ce22f67b6"],

Cell[TextData[{
 "For each retained block from site ",
 Cell[BoxData[
  FormBox[
   TagBox["j",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "6b462a4c-c19c-9b4c-90b9-8ba7cd675cd4"],
 " to site ",
 Cell[BoxData[
  FormBox[
   TagBox["i",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "a1b6cc1b-4ebc-9c47-9264-8054452a1725"],
 ", the distance uses basis-position vectors ",
 Cell[BoxData[
  FormBox[
   TagBox[
    StyleBox[
     SubscriptBox["r", "i"],
     StripOnInput->False,
     FontWeight->"Bold",
     FontSlant->"Italic"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "bba544f4-8fcd-274d-b327-97cd8565cc52"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    StyleBox[
     SubscriptBox["r", "j"],
     StripOnInput->False,
     FontWeight->"Bold",
     FontSlant->"Italic"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "cf83d783-55a7-8d40-b35d-2afa72d855c5"],
 " and displacement ",
 Cell[BoxData[
  FormBox[
   TagBox[
    StyleBox["R",
     StripOnInput->False,
     FontWeight->"Bold",
     FontSlant->"Italic"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "88889b75-670d-1b42-bf12-9c90f716d7f8"],
 ". The result is the maximum of these distances:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["d", 
      RowBox[{"{", 
       RowBox[{"i", ",", "j"}], "}"}]], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{
         StyleBox[
          SubscriptBox["r", "i"], FontWeight -> "Bold", FontSlant -> "Italic",
           StripOnInput -> False], "+", 
         StyleBox[
         "R", FontWeight -> "Bold", FontSlant -> "Italic", StripOnInput -> 
          False], "-", 
         StyleBox[
          SubscriptBox["r", "j"], FontWeight -> "Bold", FontSlant -> "Italic",
           StripOnInput -> False]}]},
      "Norm"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "41f28ebc-b268-7649-9798-49db85467e8d"]
}], "Notes",
 CellID->387888782,ExpressionUUID->"87832fcb-5e50-ad4b-897d-6308fa63f7fa"]
}, Closed]],

