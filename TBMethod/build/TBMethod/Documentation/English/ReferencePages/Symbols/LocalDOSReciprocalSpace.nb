Cell["\<\
The internal projector is applied to each site-diagonal Green block, and the \
contributions are summed over device sites.\
\>", "Notes",
 CellID->162606862,ExpressionUUID->"b1ff2a5c-3238-5242-9a3e-bdcdee5020d7"],

Cell["\<\
The shortest form uses the lead onsite block as the device Hamiltonian.\
\>", "Notes",
 CellID->1410373393,ExpressionUUID->"28dfc926-a331-724e-bc9c-54e51c962def"],

Cell[TextData[{
 "The default ",
 Cell[BoxData[
  StyleBox["mode", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6c66bf7d-826d-9f4a-8b3c-dfeb807fb847"],
 " is ",
 Cell[BoxData["3"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6ae5d8a9-0294-d246-99a4-cad34e54c6e5"],
 "; only ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0c4e4c2f-2b47-f141-b3a8-07bf95b2e66f"],
 ", ",
