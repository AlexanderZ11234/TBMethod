 CellID->762732182,ExpressionUUID->"be10d882-c1d3-304f-831a-5ad50756e2d7"],

Cell["\<\
Returns -(1/Pi) Im of the summed projected site-diagonal Green blocks.\
\>", "Notes",
 CellID->1834049178,ExpressionUUID->"ddadaebf-5b57-964e-bbc5-f14d53efb1d6"],

Cell["\<\
The shortest form uses the lead onsite block as the device Hamiltonian. Only \
modes 1, 2 and 3 are accepted by this wrapper.\
\>", "Notes",
 CellID->878178488,ExpressionUUID->"819548e3-ed9a-da42-adb3-c7743c6d83e4"]
}, Closed]],

