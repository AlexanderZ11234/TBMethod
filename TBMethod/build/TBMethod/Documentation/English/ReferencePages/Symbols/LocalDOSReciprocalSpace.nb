Cell[TextData[{
 "The projected spectral density, summed over the device sites, is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["\[Rho]", "P"], "(", "\[Epsilon]", ")"}], "\[LongEqual]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"Im", "(", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"a", "=", "1"}], 
          SubscriptBox["N", "S"]], 
         RowBox[{"Tr", "[", 
          RowBox[{"P", ".", 
           RowBox[{
            SubscriptBox["G", 
             RowBox[{"{", 
              RowBox[{"a", ",", "a"}], "}"}]], "(", 
            RowBox[{"\[Epsilon]", "+", 
             RowBox[{"\[ImaginaryI]", " ", "\[Eta]"}]}], ")"}]}], "]"}]}], 
        ")"}], "\[Pi]"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "1d561ccf-1cc1-1b47-9122-940e4f006670"]
}], "Notes",
 CellID->701264175,ExpressionUUID->"c5f83941-93ae-3f4c-81ee-b3445dc5c6a7"]
}, Closed]],

