Cell["\<\
The internal projector is applied to each site-diagonal Green block, and the \
contributions are summed over device sites.\
\>", "Notes",
 CellID->1496710216,ExpressionUUID->"cf4c7efc-8f82-cf42-9d46-af5271ab13c9"],

Cell["\<\
The shortest form uses the lead onsite block as the device Hamiltonian.\
\>", "Notes",
 CellID->191698548,ExpressionUUID->"8f14cdb5-b8ad-f84b-b54f-3cb23e5762bb"],

Cell[TextData[{
 "The default ",
 Cell[BoxData[
  StyleBox["mode", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "81766915-21a6-ca40-8d6d-f132a2be719b"],
 " is ",
 Cell[BoxData["3"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "584a492c-c459-f14c-bb8e-116d5bc504c1"],
 "; only ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "540dfde6-5681-de48-a2d0-81f4ce410fea"],
 ", ",
 Cell[BoxData["2"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "489458b1-3765-ce49-8fbe-510874f86e0e"],
 ", and ",
 Cell[BoxData["3"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ea7d6dae-12ad-aa46-9ed4-289ee4f1ec19"],
 " are accepted by this wrapper."
}], "Notes",
 CellID->1025210888,ExpressionUUID->"baf045a3-a886-8247-8c92-87f5edc548e8"],

Cell[TextData[{
 "The projected spectral density, summed over the device sites, is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["\[Rho]", "P"], "(", "\[Epsilon]", ")"}], "\[LongEqual]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"Im", "(", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"a", "=", "1"}], 
          SubscriptBox["N", "S"]], 
         RowBox[{"Tr", "[", 
          RowBox[{"P", ".", 
           RowBox[{
            SubscriptBox["G", 
             RowBox[{"{", 
              RowBox[{"a", ",", "a"}], "}"}]], "(", 
            RowBox[{"\[Epsilon]", "+", 
             RowBox[{"\[ImaginaryI]", " ", "\[Eta]"}]}], ")"}]}], "]"}]}], 
        ")"}], "\[Pi]"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "f0eb3b29-a694-a548-bebe-5cdc67c73b49"]
}], "Notes",
 CellID->273300904,ExpressionUUID->"36a02440-d9ab-884c-9bd0-4b122507f444"]
}, Closed]],

