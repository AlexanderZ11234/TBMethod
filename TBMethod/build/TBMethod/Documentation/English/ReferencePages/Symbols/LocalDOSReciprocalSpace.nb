   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "650d1abc-00ce-914f-b266-18ded268074c"],
 " is ",
 Cell[BoxData["3"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d9cf6e4e-0657-1b4e-96e9-8fd29d045e08"],
 "; only modes ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "620f6672-4949-dc45-bbc3-ca9b07a77b9a"],
 ", ",
 Cell[BoxData["2"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4a212c04-ac37-6c41-b992-b2e4a2cfbc51"],
 ", and ",
 Cell[BoxData["3"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "88bdb301-7935-3348-86eb-06e8c4da4750"],
 " are accepted by this wrapper."
}], "Notes",
 CellID->1179397668,ExpressionUUID->"d24b35bb-33c2-9f47-86d3-4d42acd0c38f"],

Cell[TextData[{
 "The projected spectral density, summed over the device sites, is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["\[Rho]", "P"], "(", "\[Epsilon]", ")"}], "\[LongEqual]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"Im", "(", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"a", "=", "1"}], 
          SubscriptBox["N", "S"]], 
         RowBox[{"Tr", "[", 
          RowBox[{"P", ".", 
           RowBox[{
            SubscriptBox["G", 
             RowBox[{"{", 
              RowBox[{"a", ",", "a"}], "}"}]], "(", 
            RowBox[{"\[Epsilon]", "+", 
             RowBox[{"\[ImaginaryI]", " ", "\[Eta]"}]}], ")"}]}], "]"}]}], 
        ")"}], "\[Pi]"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "d6ef4e4a-880b-624f-8f67-0410a38ebfce"]
}], "Notes",
 CellID->1958810716,ExpressionUUID->"8eb5d8b3-c8ba-1145-b665-a39900d2d6fc"]
}, Closed]],

