 ", and ",
 Cell[BoxData["3"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "33998c73-e6a4-ba4b-938f-e9eeef7b5a68"],
 " are accepted by this wrapper."
}], "Notes",
 CellID->294308261,ExpressionUUID->"5ba483d5-f16b-6142-8512-5f1268295a5b"],

Cell[TextData[{
 "The projected spectral density, summed over the device sites, is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["\[Rho]", "P"], "(", "\[Epsilon]", ")"}], "\[LongEqual]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"Im", "(", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"a", "=", "1"}], 
          SubscriptBox["N", "S"]], 
         RowBox[{"Tr", "[", 
          RowBox[{"P", ".", 
           RowBox[{
            SubscriptBox["G", 
             RowBox[{"{", 
              RowBox[{"a", ",", "a"}], "}"}]], "(", 
            RowBox[{"\[Epsilon]", "+", 
             RowBox[{"\[ImaginaryI]", " ", "\[Eta]"}]}], ")"}]}], "]"}]}], 
        ")"}], "\[Pi]"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "0939356a-1f0b-d342-8abc-00b2d216e48a"]
}], "Notes",
 CellID->241314338,ExpressionUUID->"bd57444a-0e32-dc43-9dcc-291b58cdaa6b"]
}, Closed]],

