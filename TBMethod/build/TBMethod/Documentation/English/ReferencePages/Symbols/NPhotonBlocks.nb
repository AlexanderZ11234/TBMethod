Cell[TextData[{
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fae4a050-a356-df4f-ba37-e8919fcc95ed"],
 " sets photon indices from ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"-", "m"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "587ca3a5-1c6b-0f4d-89b8-040bf978f369"],
 " through ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "69c8746d-adb9-9f44-8f6c-904da4fdfee3"],
 "; the photon-space dimension is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"2", " ", "m"}], "+", "1"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "a52586ff-b466-fe4b-b229-9801fb28f06f"],
 ". ",
 Cell[BoxData[
  StyleBox["modulation", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fe6b791f-d959-ad46-84a3-3766614526e6"],
 " is a function of a dimensionless angle with period ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"2", " ", "\[Pi]"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "2673ea22-c3dd-b04d-82af-ceb10c02580f"],
 "."
}], "Notes",
 CellID->1852611768,ExpressionUUID->"564a20aa-b262-8a41-b472-4b4a7b368f6c"],

Cell[TextData[{
 "For distinct sites, returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["fourierModulationMatrix", "TI"], ",", 
    StyleBox["zeroMatrix", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8763da69-ca7a-6f40-8b1c-a7a0bb47183e"],
 ". For coincident sites, returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["identityMatrix", "TI"], ",", 
    RowBox[{
     StyleBox["fourierModulationMatrix", "TI"], "-", 
     RowBox[{
      StyleBox["omega", "TI"], " ", 
      RowBox[{
       TemplateBox[{
         Cell[
          TextData["DiagonalMatrix"]], "paclet:ref/DiagonalMatrix"},
        "RefLink",
        BaseStyle->{"InlineFormula"}], "[", 
       RowBox[{
        TemplateBox[{
          Cell[
           TextData["Range"]], "paclet:ref/Range"},
         "RefLink",
         BaseStyle->{"InlineFormula"}], "[", 
        RowBox[{
         RowBox[{"-", 
          StyleBox["m", "TI"]}], ",", 
         StyleBox["m", "TI"]}], "]"}], "]"}]}]}]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "11fbca53-e179-6b4f-8945-7f2d2e7f8fce"],
 ". Coincidence uses a distance threshold of ",
 Cell[BoxData["0.00001"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d35a3d8f-6ace-7843-8e79-e9777490db5b"],
 "."
}], "Notes",
 CellID->532591749,ExpressionUUID->"5f2e6622-2d33-0746-8ce8-015a6acfc9ec"],

Cell[TextData[{
 "The matrix entry with photon indices ",
 Cell[BoxData[
  FormBox[
   TagBox["p",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "70d6156e-5683-f04b-909b-8998f3a8ada8"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox["q",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "bab72b0b-19c2-2a45-99d1-5cade2cb7aee"],
 " uses the Fourier coefficient at ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"q", "-", "p"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "b6983336-e4dc-d44f-b41e-0cc4078ee37a"],
 ". On nonzero-length bonds the vector-potential forms use ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"exp", "(", 
     RowBox[{"\[ImaginaryI]", " ", "A", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["r", "f"], "-", 
         SubscriptBox["r", "i"]}], ")"}], ".", 
       RowBox[{"a", "(", "\[Phi]", ")"}]}]}], ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "bef3ec03-c34a-ef46-9885-efe496ecedf6"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TagBox["A",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "47adde20-06ef-2c42-b9c7-6148ac889718"],
 " is ",
 Cell[BoxData[
  StyleBox["amplitude", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0b3088e7-9360-bd44-a09b-b7e9ffa7758c"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"a", "(", "\[Phi]", ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "fa968f9d-acb8-bc40-8484-a08db7a38cbe"],
 " is the supplied vector potential. Their onsite modulation is zero."
}], "Notes",
 CellID->220804949,ExpressionUUID->"089abf1b-45c9-234b-a6f6-20c5765d88e6"],

Cell[TextData[{
 "The two-element vector-potential form assumes amplitude ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cb82ba0c-13be-aa45-8fdd-76ae0e82ae37"],
 ". Use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PhotonDress"]], "paclet:TBMethod/ref/PhotonDress", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "75a17b3f-b725-7d40-8001-45a773d99cb8"],
 " to combine these factors with a bare hopping matrix."
}], "Notes",
 CellID->1582315678,ExpressionUUID->"e63f5a37-bc20-e140-8680-b9ef41a2a57b"],

Cell[TextData[{
 "Fourier coefficients are computed by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NIntegrate"]], "paclet:ref/NIntegrate"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c054472c-bbd7-9246-a8b7-68e28faefce1"],
 ", using ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["AccuracyGoal"]], "paclet:ref/AccuracyGoal"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", "10"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bcf73dde-2db1-6e44-92f2-f22a215c6820"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Method"]], "paclet:ref/Method"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", "\"\<LocalAdaptive\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "115e9b14-6729-1544-8be5-30c0ee155650"],
 ". Other ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NIntegrate"]], "paclet:ref/NIntegrate"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "82843910-bac1-2e49-a112-11282ebbc5d2"],
