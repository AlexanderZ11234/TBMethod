Cell[TextData[{
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bfb9696c-ee55-a94c-8d22-a90f680481a1"],
 " sets photon indices from ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"-", "m"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "897e3980-da7a-494e-b0d3-4a153f29e3cf"],
 " through ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2e15b536-14e8-3d42-8fdb-a9668103a476"],
 "; the photon-space dimension is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"2", " ", "m"}], "+", "1"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "2167b8ce-b78f-1844-81b3-fcaa210d5d22"],
 ". ",
 Cell[BoxData[
  StyleBox["modulation", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "34c59fba-3583-774a-990d-8d0cb0867c04"],
 " is a function of a dimensionless angle with period ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"2", " ", "\[Pi]"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "50d4a329-c511-d343-84d1-57eb0821f030"],
 "."
}], "Notes",
 CellID->1610755216,ExpressionUUID->"df97192a-e80a-1f45-9385-f408eed54524"],

Cell[TextData[{
 "For distinct sites, returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["fourierModulationMatrix", "TI"], ",", 
    StyleBox["zeroMatrix", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4a5838d6-6631-4340-88ee-491d4aebc3ac"],
 ". For coincident sites, returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["identityMatrix", "TI"], ",", 
    RowBox[{
     StyleBox["fourierModulationMatrix", "TI"], "-", 
     RowBox[{
      StyleBox["omega", "TI"], " ", 
      RowBox[{
       TemplateBox[{
         Cell[
          TextData["DiagonalMatrix"]], "paclet:ref/DiagonalMatrix"},
        "RefLink",
        BaseStyle->{"InlineFormula"}], "[", 
       RowBox[{
        TemplateBox[{
          Cell[
           TextData["Range"]], "paclet:ref/Range"},
         "RefLink",
         BaseStyle->{"InlineFormula"}], "[", 
        RowBox[{
         RowBox[{"-", 
          StyleBox["m", "TI"]}], ",", 
         StyleBox["m", "TI"]}], "]"}], "]"}]}]}]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "caa72e6f-fe28-da40-86ec-b294e03563f1"],
 ". Coincidence uses a distance threshold of ",
 Cell[BoxData["0.00001"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "311df39e-4ad0-014e-ae04-55acafe74ad7"],
 "."
}], "Notes",
 CellID->1030110012,ExpressionUUID->"750de85f-819e-824f-96d4-ebad52036645"],

Cell[TextData[{
 "The matrix entry with photon indices ",
 Cell[BoxData[
  FormBox[
   TagBox["p",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "93d4e67c-e4b4-6546-a535-fd284d1990c0"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox["q",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "cb376667-d630-8944-9c0c-5d8a2df619b2"],
 " uses the Fourier coefficient at ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"q", "-", "p"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "c2de7284-b070-6249-99d9-a444092bafb0"],
 ". On nonzero-length bonds the vector-potential forms use ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"exp", "(", 
     RowBox[{"\[ImaginaryI]", " ", "A", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["r", "f"], "-", 
         SubscriptBox["r", "i"]}], ")"}], ".", 
       RowBox[{"a", "(", "\[Phi]", ")"}]}]}], ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "7eedb7da-ee2a-6e4a-93db-692363835414"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TagBox["A",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "ba17e4fc-80e8-1348-9b76-4b77900e471a"],
 " is ",
 Cell[BoxData[
  StyleBox["amplitude", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f4756ea0-3a17-ea41-8c03-69f175765dd9"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"a", "(", "\[Phi]", ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "d7d4f369-7fb4-de44-8506-e3de3fcda687"],
 " is the supplied vector potential. Their onsite modulation is zero."
}], "Notes",
 CellID->1279652575,ExpressionUUID->"d3537908-d252-c543-bd09-bf0683c37a64"],

Cell[TextData[{
 "The two-element vector-potential form assumes amplitude ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3589fa60-0b9e-3b4f-b626-675f8d426aa2"],
 ". Use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PhotonDress"]], "paclet:TBMethod/ref/PhotonDress", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c821b2dd-5ad0-5a4b-b929-d98abbc982ea"],
 " to combine these factors with a bare hopping matrix."
}], "Notes",
 CellID->275377818,ExpressionUUID->"c46d608b-e064-f242-9a0a-33cfa048bf0b"],

Cell[TextData[{
 "Fourier coefficients are computed by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NIntegrate"]], "paclet:ref/NIntegrate"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4026146c-27a4-fc4c-aa6c-0af23c05fd2b"],
 ", using ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["AccuracyGoal"]], "paclet:ref/AccuracyGoal"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", "10"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5d52240c-4980-5d47-9b16-f80d8816f286"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Method"]], "paclet:ref/Method"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", "\"\<LocalAdaptive\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2d1decc6-f2df-d64f-b45c-b3ed79ee719e"],
 ". Other ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NIntegrate"]], "paclet:ref/NIntegrate"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "868a4cea-4a7e-824a-8117-e567356e4332"],
