Cell[TextData[{
 Cell[BoxData[
  StyleBox["m", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2255390a-b0c1-7d42-884b-78dbfb1a3b34"],
 " sets photon indices from ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"-", "m"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "9b5365ef-c2d0-a245-87dd-82ad9766f383"],
 " through ",
 Cell[BoxData[
  StyleBox["m", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8596f163-8ae1-b742-8026-52ab1ebd80ba"],
 "; the photon-space dimension is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"2", " ", "m"}], "+", "1"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "19159c9f-d8db-ac46-a6e6-986eed812177"],
 ". ",
 Cell[BoxData[
  StyleBox["modulation", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e616f41a-a24b-024d-b320-285bf1a49b22"],
 " is a function of a dimensionless angle with period ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"2", " ", "\[Pi]"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "245d5870-836f-c84e-95d3-6f6cc222e49d"],
 "."
}], "Notes",
 CellID->1445293524,ExpressionUUID->"a335dcb1-de9f-9048-a377-ae11dce53fe3"],

Cell[TextData[{
 "For distinct sites, returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"fourierModulationMatrix", ",", " ", "zeroMatrix"}], "}"}]], 
  "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"7ce4eac2-7204-a34c-94ff-a6f9d63daef3"],
 ". For coincident sites, returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"identityMatrix", ",", " ", 
    RowBox[{"fourierModulationMatrix", " ", "-", " ", 
     RowBox[{"omega", " ", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"-", "m"}], ",", " ", "m"}], "]"}], "]"}]}]}]}], "}"}]], 
  "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"ce9efdbb-4411-bb47-9197-35f8674f568e"],
 ". Coincidence uses a distance threshold of ",
 Cell[BoxData["1.*^-5"], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"c8ad36cc-5add-ec45-8145-28e8b99e2629"],
 "."
}], "Notes",
 CellID->183903745,ExpressionUUID->"cd5514d4-d98f-314e-9dc9-d29093544d76"],

Cell[TextData[{
 "The matrix entry with photon indices ",
 Cell[BoxData[
  FormBox[
   TagBox["p",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "b8c0ec9d-bc30-964b-b1bd-a7682f1b3943"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox["q",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "7ee892cf-c8c8-514a-b59b-5d2b45c31b90"],
 " uses the Fourier coefficient at ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"q", "-", "p"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "bde195f7-6334-8c47-bb1d-0ef0652f8345"],
 ". On nonzero-length bonds the vector-potential forms use ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"exp", "(", 
     RowBox[{"\[ImaginaryI]", " ", "A", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["r", "f"], "-", 
         SubscriptBox["r", "i"]}], ")"}], ".", 
       RowBox[{"a", "(", "\[Phi]", ")"}]}]}], ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "76d35d25-0a90-bb4d-b204-f739339992ba"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TagBox["A",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "7984c47d-3ffb-3445-b080-7a999907912e"],
 " is ",
 Cell[BoxData[
  StyleBox["amplitude", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a4f028dd-3260-2341-897d-ca5b6ad3bf2c"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"a", "(", "\[Phi]", ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "81456fa2-7d4f-d642-a179-cc810f36b204"],
 " is the supplied vector potential. Their onsite modulation is zero."
}], "Notes",
 CellID->1006647283,ExpressionUUID->"4be45ada-7fb0-5140-83a5-c0e4b857761c"],

Cell[TextData[{
 "The two-element vector-potential form assumes amplitude ",
