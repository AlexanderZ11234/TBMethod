Cell["\<\
A cosine modulation couples adjacent photon sectors with Fourier coefficient \
1/2.\
\>", "ExampleText",
 CellID->1205419342,ExpressionUUID->"21a03bcd-0c0c-9b4e-a3c1-b8ef1e5b0419"],

