Cell["\<\
latticeVectors must be a 2 by 2 or 3 by 3 matrix with lattice vectors as rows.\
\>", "Notes",
 CellID->1348674796,ExpressionUUID->"e9b14fa5-20ed-b949-9e2f-af442052d7a1"],

Cell["\<\
crystalStructure is an Association from lattice translation vectors to site \
lists; labeled site rules are accepted.\
\>", "Notes",
 CellID->1654898041,ExpressionUUID->"8db3e2e5-27d6-9f4d-a209-52130b2250e2"],

Cell["\<\
cellType is \"Voronoi\" or \"Unit\". cellRange controls the surrounding \
lattice used for cell outlines.\
\>", "Notes",
 CellID->1793633084,ExpressionUUID->"0f74f440-664f-1846-ba83-2bd01161c5c5"],

