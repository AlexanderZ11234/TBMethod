Cell[TextData[{
 "The shared overlap-transform dispatcher can confuse full-device matrix \
pairs of dimensions ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", "2"}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "485e55ac-83ab-ef42-891e-c64fe1fd1ee9"],
 " or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"3", ",", "3"}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "48e7bf9f-de1a-1c47-a3ca-5a1dee1707e7"],
 " with lead-block input. The basic example uses four sites to avoid this \
implementation ambiguity."
}], "Notes",
 CellID->753217971,ExpressionUUID->"faa7d033-3531-aa4f-9714-db07618eca3a"],

Cell[TextData[{
 "The overlap matrix enters the device resolvent as",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["G", "C"], "(", "z", ")"}], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{"(", 
         RowBox[{
           RowBox[{"z", " ", 
             SubscriptBox["S", "C"]}], "-", 
           SubscriptBox["H", "C"], "-", 
           RowBox[{
             UnderoverscriptBox["\[Sum]", 
              RowBox[{"p", "=", "1"}], 
              SubscriptBox["N", "L"]], 
             RowBox[{
               SubscriptBox["\[CapitalSigma]", "p"], "(", "z", ")"}]}]}], 
         ")"}]},
      "Inverse"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "d46ce8f6-5743-b041-93ba-0037fa50b594"]
}], "Notes",
 CellID->630808478,ExpressionUUID->"b9d82f21-d881-b240-91d0-e759e15793b9"]
}, Closed]],

