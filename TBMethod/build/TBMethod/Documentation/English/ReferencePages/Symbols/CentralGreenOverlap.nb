Cell["\<\
The current shared overlap-transform dispatcher can confuse 2 by 2 or 3 by 3 \
full-device matrix pairs with lead-block input. The basic example uses four \
sites to avoid this implementation ambiguity.\
\>", "Notes",
 CellID->1017022745,ExpressionUUID->"7d27c1af-56a5-c740-8f65-e0548286e3e1"],

Cell[TextData[{
 "The overlap matrix enters the device resolvent as",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["G", "C"], "(", "z", ")"}], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{"(", 
         RowBox[{
           RowBox[{"z", " ", 
             SubscriptBox["S", "C"]}], "-", 
           SubscriptBox["H", "C"], "-", 
           RowBox[{
             UnderoverscriptBox["\[Sum]", 
              RowBox[{"p", "=", "1"}], 
              SubscriptBox["N", "L"]], 
             RowBox[{
               SubscriptBox["\[CapitalSigma]", "p"], "(", "z", ")"}]}]}], 
         ")"}]},
      "Inverse"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "1aa08358-4cdc-8b4f-a471-9b1aba705c54"]
}], "Notes",
 CellID->1057804417,ExpressionUUID->"8667e5f5-b2b6-ad40-8e17-ee264d88f1dd"]
}, Closed]],

