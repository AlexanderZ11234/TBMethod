Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"z", "=", 
   RowBox[{"0.2", "\[VeryThinSpace]", "+", 
    RowBox[{"0.1", " ", "\[ImaginaryI]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h", "=", 
   RowBox[{
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"-", "0.5"}], ",", "3"}], "]"}], ",", "1"}], "]"}], "+", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"-", "0.5"}], ",", "3"}], "]"}], ",", 
      RowBox[{"-", "1"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sigma", "=", 
   RowBox[{
    RowBox[{"-", "0.1"}], " ", "\[ImaginaryI]", " ", 
    RowBox[{"IdentityMatrix", "[", "4", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s", "=", 
   RowBox[{
    RowBox[{"IdentityMatrix", "[", "4", "]"}], "+", 
    RowBox[{"0.04", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{"1.", ",", "3"}], "]"}], ",", "1"}], "]"}], "+", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{"1.", ",", "3"}], "]"}], ",", 
         RowBox[{"-", "1"}]}], "]"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"CentralGreenOverlap", "[", 
  RowBox[{"z", ",", 
   RowBox[{"{", 
    RowBox[{"h", ",", "s"}], "}"}], ",", 
