Cell[TextData[{
 "The shared overlap-transform dispatcher can confuse full-device matrix \
pairs of dimensions ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", "2"}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8ac30b14-cd55-2c4d-a737-25e4e3ad0399"],
 " or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"3", ",", "3"}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3558b096-6ff9-2041-a773-d356f705d9f8"],
 " with lead-block input. The basic example uses four sites to avoid this \
implementation ambiguity."
}], "Notes",
 CellID->753217971,ExpressionUUID->"3818d0a2-86ff-1445-9db6-a11d78dec5fc"],

Cell[TextData[{
 "The overlap matrix enters the device resolvent as",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["G", "C"], "(", "z", ")"}], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{"(", 
         RowBox[{
           RowBox[{"z", " ", 
             SubscriptBox["S", "C"]}], "-", 
           SubscriptBox["H", "C"], "-", 
           RowBox[{
             UnderoverscriptBox["\[Sum]", 
              RowBox[{"p", "=", "1"}], 
              SubscriptBox["N", "L"]], 
             RowBox[{
               SubscriptBox["\[CapitalSigma]", "p"], "(", "z", ")"}]}]}], 
         ")"}]},
      "Inverse"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "5ab33a68-9328-7349-838d-1a2c4e120780"]
}], "Notes",
 CellID->630808478,ExpressionUUID->"3552aca5-6ff6-f54e-bb5a-c42764870f1f"]
}, Closed]],

