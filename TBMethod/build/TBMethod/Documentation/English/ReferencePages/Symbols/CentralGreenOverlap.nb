Cell[TextData[{
 "The shared overlap-transform dispatcher can confuse full-device matrix \
pairs of dimensions ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", "2"}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e9917ff1-4b48-9e44-a2ef-f09d30cabbe4"],
 " or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"3", ",", "3"}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1bb34f6c-ed6b-e048-b39d-14a8b2a2e5c5"],
 " with lead-block input. The basic example uses four sites to avoid this \
implementation ambiguity."
}], "Notes",
 CellID->1555653576,ExpressionUUID->"cce7cf9a-c4e6-0847-9118-f3710c3f2302"],

Cell[TextData[{
 "The overlap matrix enters the device resolvent as",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["G", "C"], "(", "z", ")"}], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{"(", 
         RowBox[{
           RowBox[{"z", " ", 
             SubscriptBox["S", "C"]}], "-", 
           SubscriptBox["H", "C"], "-", 
           RowBox[{
             UnderoverscriptBox["\[Sum]", 
              RowBox[{"p", "=", "1"}], 
              SubscriptBox["N", "L"]], 
             RowBox[{
               SubscriptBox["\[CapitalSigma]", "p"], "(", "z", ")"}]}]}], 
         ")"}]},
      "Inverse"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "8227a35e-1302-b544-afbe-80aeceecc301"]
}], "Notes",
 CellID->384969062,ExpressionUUID->"db306d3c-55fb-dd4f-b5c0-183ddee3ab59"]
}, Closed]],

