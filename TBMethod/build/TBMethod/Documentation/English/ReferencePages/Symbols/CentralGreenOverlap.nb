Cell[TextData[{
 "The shared overlap-transform dispatcher can confuse full-device matrix \
pairs of dimensions ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", "2"}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2d7cc94f-06be-5547-a2c8-a08eb7e962ce"],
 " or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"3", ",", "3"}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "90a5b7b7-8566-a545-89fb-470c1f77cf29"],
 " with lead-block input. The basic example uses four sites to avoid this \
implementation ambiguity."
}], "Notes",
 CellID->753217971,ExpressionUUID->"68c267df-ac7b-8f4e-b5f8-88085b7c3f9b"],

Cell[TextData[{
 "The overlap matrix enters the device resolvent as",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["G", "C"], "(", "z", ")"}], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{"(", 
         RowBox[{
           RowBox[{"z", " ", 
             SubscriptBox["S", "C"]}], "-", 
           SubscriptBox["H", "C"], "-", 
           RowBox[{
             UnderoverscriptBox["\[Sum]", 
              RowBox[{"p", "=", "1"}], 
              SubscriptBox["N", "L"]], 
             RowBox[{
               SubscriptBox["\[CapitalSigma]", "p"], "(", "z", ")"}]}]}], 
         ")"}]},
      "Inverse"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "aef4f6c8-b368-1944-bb14-2c8ec23edb67"]
}], "Notes",
 CellID->630808478,ExpressionUUID->"09796fa6-5949-d248-803d-83819fd3a6dd"]
}, Closed]],

