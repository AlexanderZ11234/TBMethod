Cell[TextData[{
 "The shared overlap-transform dispatcher can confuse full-device matrix \
pairs of dimensions ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", " ", "2"}], "}"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"9ce01d77-34dd-a94a-84b7-250cbc9e33ad"],
 " or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"3", ",", " ", "3"}], "}"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"de6c72a1-433d-0b47-b08f-b070adf66e2f"],
 " with lead-block input. The basic example uses four sites to avoid this \
implementation ambiguity."
}], "Notes",
 CellID->1177397126,ExpressionUUID->"fcf71779-9d88-8940-b174-b4e6cfb8764d"],

Cell[TextData[{
 "The overlap matrix enters the device resolvent as",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["G", "C"], "(", "z", ")"}], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{"(", 
         RowBox[{
           RowBox[{"z", " ", 
             SubscriptBox["S", "C"]}], "-", 
           SubscriptBox["H", "C"], "-", 
           RowBox[{
             UnderoverscriptBox["\[Sum]", 
              RowBox[{"p", "=", "1"}], 
              SubscriptBox["N", "L"]], 
             RowBox[{
               SubscriptBox["\[CapitalSigma]", "p"], "(", "z", ")"}]}]}], 
         ")"}]},
      "Inverse"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "dc85cf72-f841-3e4d-a729-ea88de92fabe"]
}], "Notes",
 CellID->1123026424,ExpressionUUID->"403ffe11-0235-dd46-9d88-223cbb9e660d"]
}, Closed]],

