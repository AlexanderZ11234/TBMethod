Cell[TextData[{
 "Both self-energies and ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ccb1defa-651a-9848-848a-6c42d6b71bf2"],
 " must be expressed in the same contact or full-device basis."
}], "Notes",
 CellID->1998499455,ExpressionUUID->"57a1e19c-d670-c844-b38e-b36f677fca4f"],

Cell["\<\
The broadening is formed from the anti-Hermitian part of each self-energy. \
The elementwise imaginary part alone is insufficient for a general matrix.\
\>", "Notes",
 CellID->1678029938,ExpressionUUID->"7ad1a8b1-d99b-4942-b943-15aaeb8ff5ce"],

Cell["\<\
The routine performs no real-part extraction or clipping. Negligible \
numerical imaginary residues may remain.\
\>", "Notes",
 CellID->1812717797,ExpressionUUID->"c1f2907c-00e3-e24d-8e9f-779071914fe6"],

Cell[TextData[{
 "The broadening matrix of contact ",
 Cell[BoxData[
  FormBox[
   TagBox["p",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "692d2708-be53-c74f-8fd9-7a67fee2f983"],
 " is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[CapitalGamma]", "p"], "\[LongEqual]", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[CapitalSigma]", "p"], "-", 
        TemplateBox[{
          RowBox[{"(", 
            SubscriptBox["\[CapitalSigma]", "p"], ")"}]},
         "ConjugateTranspose"]}], ")"}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "81334535-4155-2749-a24f-44e4b40bb0d7"]
}], "Notes",
 CellID->1917040987,ExpressionUUID->"9bb55c50-2763-3140-ba68-30a79e15e98a"],

Cell[TextData[{
 "The transmission convention is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["T", 
      RowBox[{"{", 
       RowBox[{"p", ",", "q"}], "}"}]], "\[LongEqual]", 
     RowBox[{"Tr", "[", 
      RowBox[{
       SubscriptBox["\[CapitalGamma]", "p"], ".", "G", ".", 
       SubscriptBox["\[CapitalGamma]", "q"], ".", 
       TemplateBox[{"G"},
        "ConjugateTranspose"]}], "]"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "2867bf16-c0c0-d342-b696-d3583add284b"]
}], "Notes",
 CellID->341516211,ExpressionUUID->"2956078a-6c79-1a4d-b4cb-10fbf050a7bc"]
}, Closed]],

