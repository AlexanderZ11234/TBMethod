Cell[TextData[{
 "Both self-energies and ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1ad3461d-a10d-4246-a5e6-602302b7a2e0"],
 " must be expressed in the same contact or full-device basis."
}], "Notes",
 CellID->1998499455,ExpressionUUID->"61542733-82c6-2a46-bd39-1e67522a68db"],

Cell["\<\
The broadening is formed from the anti-Hermitian part of each self-energy. \
The elementwise imaginary part alone is insufficient for a general matrix.\
\>", "Notes",
 CellID->1678029938,ExpressionUUID->"229eb1bd-e4c3-7643-8eea-b0a3ae78a88e"],

Cell["\<\
The routine performs no real-part extraction or clipping. Negligible \
numerical imaginary residues may remain.\
\>", "Notes",
 CellID->1812717797,ExpressionUUID->"4404100c-22fa-bc4e-b869-5962e09eb7fc"],

Cell[TextData[{
 "The broadening matrix of contact ",
 Cell[BoxData[
  FormBox[
   TagBox["p",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "28391625-d39d-cf4e-97a9-2902c3cbd6f4"],
 " is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[CapitalGamma]", "p"], "\[LongEqual]", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[CapitalSigma]", "p"], "-", 
        TemplateBox[{
          RowBox[{"(", 
            SubscriptBox["\[CapitalSigma]", "p"], ")"}]},
         "ConjugateTranspose"]}], ")"}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "ce2ab190-3284-6f4e-b9eb-4aa0f6075ae8"]
}], "Notes",
 CellID->1917040987,ExpressionUUID->"b83a797e-309f-2a4e-8cc2-651efd6b6f9e"],

Cell[TextData[{
 "The transmission convention is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["T", 
      RowBox[{"{", 
       RowBox[{"p", ",", "q"}], "}"}]], "\[LongEqual]", 
     RowBox[{"Tr", "[", 
      RowBox[{
       SubscriptBox["\[CapitalGamma]", "p"], ".", "G", ".", 
       SubscriptBox["\[CapitalGamma]", "q"], ".", 
       TemplateBox[{"G"},
        "ConjugateTranspose"]}], "]"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "f0e0831c-e817-e144-b2b9-0249dee3a87a"]
}], "Notes",
 CellID->341516211,ExpressionUUID->"f37f2643-5b0f-3a40-addb-1e8d2889294a"]
}, Closed]],

