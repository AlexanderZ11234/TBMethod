Cell[TextData[{
 "Both self-energies and ",
 Cell[BoxData[
  StyleBox["g", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "afcf5d0d-070e-e049-807a-a6e2ab2f5e7e"],
 " must be expressed in the same contact or full-device basis."
}], "Notes",
 CellID->1268193518,ExpressionUUID->"4d911ef5-8610-fe44-a2b6-608cc7ea4434"],

Cell["\<\
The broadening is formed from the anti-Hermitian part of each self-energy. \
The elementwise imaginary part alone is insufficient for a general matrix.\
\>", "Notes",
 CellID->497077369,ExpressionUUID->"eb099ff8-ba37-184e-a3ec-97afb2f44325"],

Cell["\<\
The routine performs no real-part extraction or clipping. Negligible \
numerical imaginary residues may remain.\
\>", "Notes",
 CellID->1497367251,ExpressionUUID->"94d52cf6-ff1e-764c-8518-1a4097c59e31"],

Cell[TextData[{
 "The broadening matrix of contact ",
 Cell[BoxData[
  FormBox[
   TagBox["p",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "d861eb73-fcb4-0b41-b185-72d1ca830342"],
 " is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[CapitalGamma]", "p"], "\[LongEqual]", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[CapitalSigma]", "p"], "-", 
        TemplateBox[{
          RowBox[{"(", 
            SubscriptBox["\[CapitalSigma]", "p"], ")"}]},
         "ConjugateTranspose"]}], ")"}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "af0de3f4-9a5a-7f47-9f72-ff85d58f95fa"]
}], "Notes",
 CellID->1574186077,ExpressionUUID->"20f8a83b-8c94-9049-95de-44c4c84a6007"],

Cell[TextData[{
 "The transmission convention is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["T", 
      RowBox[{"{", 
       RowBox[{"p", ",", "q"}], "}"}]], "\[LongEqual]", 
     RowBox[{"Tr", "[", 
      RowBox[{
       SubscriptBox["\[CapitalGamma]", "p"], ".", "G", ".", 
       SubscriptBox["\[CapitalGamma]", "q"], ".", 
       TemplateBox[{"G"},
        "ConjugateTranspose"]}], "]"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "2414d9f6-21e8-2547-9401-a25e94fa07d2"]
}], "Notes",
 CellID->1272505860,ExpressionUUID->"4903f551-a32e-bd43-9994-6feb20873c52"]
}, Closed]],

