Cell[TextData[{
 "Both self-energies and ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0d807c64-6e5a-0247-988e-740cee903d8f"],
 " must be expressed in the same contact or full-device basis."
}], "Notes",
 CellID->452975214,ExpressionUUID->"e101da19-a2e6-d94e-97ec-3530468aa55c"],

Cell["\<\
The broadening is formed from the anti-Hermitian part of each self-energy. \
The elementwise imaginary part alone is insufficient for a general matrix.\
\>", "Notes",
 CellID->189979947,ExpressionUUID->"36314ea8-f7d5-1f47-98e6-a404db39262d"],

Cell["\<\
The routine performs no real-part extraction or clipping. Negligible \
numerical imaginary residues may remain.\
\>", "Notes",
 CellID->1723550378,ExpressionUUID->"3b83136a-1937-2641-b2bc-85de56cff090"],

Cell[TextData[{
 "The broadening matrix of contact ",
 Cell[BoxData[
  FormBox[
   TagBox["p",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "bb1feb32-db21-1b4c-be20-d8a1aa695c0e"],
 " is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[CapitalGamma]", "p"], "\[LongEqual]", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[CapitalSigma]", "p"], "-", 
        TemplateBox[{
          RowBox[{"(", 
            SubscriptBox["\[CapitalSigma]", "p"], ")"}]},
         "ConjugateTranspose"]}], ")"}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "255e223d-ce58-164c-b039-247b02a83c41"]
}], "Notes",
 CellID->688727033,ExpressionUUID->"5abe70e2-36ed-524c-af8f-97f9884e8095"],

Cell[TextData[{
 "The transmission convention is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["T", 
      RowBox[{"{", 
       RowBox[{"p", ",", "q"}], "}"}]], "\[LongEqual]", 
     RowBox[{"Tr", "[", 
      RowBox[{
       SubscriptBox["\[CapitalGamma]", "p"], ".", "G", ".", 
       SubscriptBox["\[CapitalGamma]", "q"], ".", 
       TemplateBox[{"G"},
        "ConjugateTranspose"]}], "]"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "150106b8-3efb-1d40-855a-eb5ee868e17a"]
}], "Notes",
 CellID->246419009,ExpressionUUID->"3bfe9698-8165-5f4b-b671-a57725148d13"]
}, Closed]],

