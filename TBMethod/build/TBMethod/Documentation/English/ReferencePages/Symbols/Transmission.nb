Cell[TextData[{
 "Both self-energies and ",
 Cell[BoxData[
  StyleBox["g", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d37dddf9-ecec-0d40-b02d-f21b759b494c"],
 " must be expressed in the same contact or full-device basis."
}], "Notes",
 CellID->1690534066,ExpressionUUID->"28edcf38-1e53-524f-a3d4-f28e26738288"],

Cell["\<\
The broadening is formed from the anti-Hermitian part of each self-energy. \
The elementwise imaginary part alone is insufficient for a general matrix.\
\>", "Notes",
 CellID->635806200,ExpressionUUID->"9d869e3a-3ad9-b649-ab2b-ca572f0d0223"],

Cell["\<\
The routine performs no real-part extraction or clipping. Negligible \
numerical imaginary residues may remain.\
\>", "Notes",
 CellID->559661395,ExpressionUUID->"feb264d0-06ef-9e4d-9690-b55a7c945313"],

Cell[TextData[{
 "The broadening matrix of contact p is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[CapitalGamma]", "p"], "\[LongEqual]", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[CapitalSigma]", "p"], "-", 
        TemplateBox[{
          RowBox[{"(", 
            SubscriptBox["\[CapitalSigma]", "p"], ")"}]},
         "ConjugateTranspose"]}], ")"}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "89b05bab-66d2-0a4c-9d89-e823870fd5e9"]
}], "Notes",
 CellID->1638996148,ExpressionUUID->"f3b8073c-9044-6445-92f0-4ad6729c07a7"],

Cell[TextData[{
 "The transmission convention is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["T", 
      RowBox[{"{", 
       RowBox[{"p", ",", "q"}], "}"}]], "\[LongEqual]", 
     RowBox[{"Tr", "[", 
      RowBox[{
       SubscriptBox["\[CapitalGamma]", "p"], ".", "G", ".", 
       SubscriptBox["\[CapitalGamma]", "q"], ".", 
       TemplateBox[{"G"},
        "ConjugateTranspose"]}], "]"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "f7fbec66-7933-6b45-9f91-898e91edb9eb"]
}], "Notes",
 CellID->1994068379,ExpressionUUID->"f769e025-1480-e742-a2c4-5d099e33fe45"]
}, Closed]],

