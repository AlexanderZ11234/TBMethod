  RowBox[{"{", 
   RowBox[{
    SubscriptBox[
     StyleBox["pt",
      FontSlant->"Italic"], "1"], ",", " ", 
    SubscriptBox[
     StyleBox["pt",
      FontSlant->"Italic"], "2"], ",", " ", "...", ",", " ", 
    StyleBox[
     SubscriptBox["pt", "n"],
     FontSlant->"Italic"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b5d0dfff-bc68-4840-b5c7-1495c5e45e66"],
 " or of ",
