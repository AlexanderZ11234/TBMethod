 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["ind",
       FontSlant->"Italic"], "1"], " ", "\[Rule]", " ", 
     SubscriptBox[
      StyleBox["pt",
       FontSlant->"Italic"], "1"]}], ",", 
    RowBox[{
     SubscriptBox[
      StyleBox["ind",
       FontSlant->"Italic"], "2"], " ", "\[Rule]", " ", 
     SubscriptBox[
      StyleBox["pt",
       FontSlant->"Italic"], "2"]}], ",", " ", "...", ",", " ", 
