Cell[TextData[{
 Cell[BoxData[
  RowBox[{"AttachFreeQ", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["fpts",
       FontSlant->"Italic"], ",", " ", 
      StyleBox["ipts",
       FontSlant->"Italic"]}], "}"}], ",", " ", 
