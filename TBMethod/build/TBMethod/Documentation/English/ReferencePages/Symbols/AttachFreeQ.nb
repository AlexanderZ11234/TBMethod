Cell[TextData[{
 Cell[BoxData[
  RowBox[{"AttachFreeQ", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["fpts",
       FontSlant->"Italic"], ",", " ", 
      StyleBox["ipts",
       FontSlant->"Italic"]}], "}"}], ",", " ", 
    SubscriptBox[
     StyleBox["d",
      FontSlant->"Italic"], "up"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b5375375-d10c-6f45-a88c-0704ee27d54e"],
 " returns ",
 ButtonBox["True",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/True"],
 " if the smallest distance from point set ",
 Cell[BoxData[
  StyleBox["ipts",
   FontSlant->"Italic"]],ExpressionUUID->
  "090529b8-ba54-ec4c-8e0d-cfdc43431e26"],
 StyleBox[" ",
  FontSlant->"Italic"],
 "to point set ",
 Cell[BoxData[
  StyleBox["fpts",
   FontSlant->"Italic"]],ExpressionUUID->
  "7f58fc95-f9b2-124c-9c22-4e3686b1deda"],
 " is larger than the prescribed distance upper limit ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["d",
    FontSlant->"Italic"], "up"]],ExpressionUUID->
  "6ef91e26-ed26-6b4c-905a-bf6393b3500b"],
 "; otherwise returns ",
 ButtonBox["False",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/False"],
 "."
}], "ExampleText",
 CellID->193187148,ExpressionUUID->"ec50ce5e-1f72-6644-8c4e-3a76122fbfaa"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["fpts",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "63b133df-2e93-224f-8468-2fae1ba7ab36"],
 StyleBox[" ",
  FontSlant->"Italic"],
 "and ",
 Cell[BoxData[
  StyleBox["ipts",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "16161a2b-26f9-904a-81d2-90b0f4d0b257"],
 StyleBox[" ",
  FontSlant->"Italic"],
 "should be a ",
 ButtonBox["List",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/List"],
 " of coordinates of points in shape of ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    SubscriptBox[
     StyleBox["pt",
      FontSlant->"Italic"], "1"], ",", " ", 
    SubscriptBox[
     StyleBox["pt",
      FontSlant->"Italic"], "2"], ",", " ", "...", ",", " ", 
    StyleBox[
     SubscriptBox["pt", "n"],
     FontSlant->"Italic"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "40633ca7-9380-bb4c-8a2c-171ce215f8f6"],
 " or of ",
 ButtonBox["Rule",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Rule"],
 "s in the shape of ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["ind",
       FontSlant->"Italic"], "1"], " ", "\[Rule]", " ", 
     SubscriptBox[
      StyleBox["pt",
       FontSlant->"Italic"], "1"]}], ",", 
    RowBox[{
     SubscriptBox[
      StyleBox["ind",
       FontSlant->"Italic"], "2"], " ", "\[Rule]", " ", 
     SubscriptBox[
      StyleBox["pt",
       FontSlant->"Italic"], "2"]}], ",", " ", "...", ",", " ", 
    RowBox[{
     SubscriptBox[
      StyleBox["ind",
       FontSlant->"Italic"], 
      StyleBox["n",
       FontSlant->"Italic"]], " ", "\[Rule]", " ", 
     StyleBox[
      SubscriptBox["pt", "n"],
      FontSlant->"Italic"]}]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4194dd15-a9ee-b34f-a2ac-1f7e7868e0a2"],
 ", where ",
 Cell[BoxData[
  StyleBox[
   SubscriptBox["pt", "i"],
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "511b0c85-aa56-df47-99d3-834c026220b9"],
 " is a ",
 ButtonBox["List",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/List"],
 " of numbers as coordinates and ",
 Cell[BoxData[
  StyleBox[
   SubscriptBox["ind", "i"],
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a78b52ec-f2f7-2443-b7f1-78b076a9fd37"],
 " is the index for the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["i", "th"], TraditionalForm]],ExpressionUUID->
  "1aab875d-8120-064d-84ad-bf0493b12d09"],
