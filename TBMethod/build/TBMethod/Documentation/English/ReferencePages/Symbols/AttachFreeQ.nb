Cell["\<\
Returns True when the neighbor search finds no point pair within the cutoff, \
and False otherwise.\
\>", "Notes",
 CellID->560093855,ExpressionUUID->"b64ab825-df35-bc46-9580-e8d96196bdf9"],

Cell["\<\
The cutoff must have head Real. The geometric search ignores labels in label \
-> coordinates point lists.\
\>", "Notes",
 CellID->593038843,ExpressionUUID->"fbda2243-2521-1140-944a-b5c8358ef3e2"]
}, Closed]],

