  "c1932353-82fd-1340-a79c-d39ca8dc9df2"],
 " returns ",
 ButtonBox["True",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/True"],
 " if the smallest distance from point set ",
 Cell[BoxData[
  StyleBox["ipts",
   FontSlant->"Italic"]],ExpressionUUID->
  "6b5c7675-7ef7-f242-9bc5-ee3c9e32d917"],
 StyleBox[" ",
  FontSlant->"Italic"],
