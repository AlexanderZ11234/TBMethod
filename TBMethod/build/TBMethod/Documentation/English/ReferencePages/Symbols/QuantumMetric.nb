Cell[TextData[{
 Cell[BoxData[
  RowBox[{"h", "[", "k", "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "66629f92-38d6-1646-944d-8dafa7d17ff3"],
 " gives a Hermitian Hamiltonian and ",
 Cell[BoxData[
  RowBox[{"velocities", "[", "k", "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f1160a91-d255-944f-ae2a-a421c7ea66d3"],
 " gives its derivative-matrix list. Alternatively, ",
 Cell[BoxData[
  RowBox[{"hv", "[", "k", "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "544870df-d69a-8242-a11b-71ea246ddc9d"],
 " returns both."
}], "Notes",
 CellID->126206471,ExpressionUUID->"22e559f5-6ae5-d847-b271-8d00da3ce6be"],

Cell[TextData[{
 "The default derivative directions are ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", "1"}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "269ad59f-f580-4b41-91af-61a126895e8e"],
 ", selecting the first diagonal metric component. Direction indices are \
one-based."
}], "Notes",
 CellID->906743874,ExpressionUUID->"c30afd87-a74c-ca48-b82f-6504c201d90f"],

Cell[TextData[{
 "Integer ",
 Cell[BoxData[
  StyleBox["filling", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "09d3ea48-e371-164f-92a2-e834895bf2c2"],
 " counts occupied low-energy states. A real ",
 Cell[BoxData[
  StyleBox["filling", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "36653af9-8393-5841-8d90-88b6a7a0fd32"],
 " is a Fermi energy; use a real number such as ",
 Cell[BoxData["0."], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0483063b-b187-6540-ab5a-4449c9274af4"],
 " to distinguish it from a band count."
}], "Notes",
 CellID->1207978086,ExpressionUUID->"0afcf17a-8311-0045-96ae-4d875fa8e589"],

Cell[TextData[{
 "The optional observable matrix ",
 Cell[BoxData[
  StyleBox["q", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f15f2675-7ae0-eb41-a5f2-9c9a6183786a"],
 " produces the symmetrized current shown below. The special value ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0e32d6b5-7932-4e4a-8231-8dfa3c1c2f88"],
 " gives the ordinary metric."
}], "Notes",
 CellID->1798572828,ExpressionUUID->"20a13959-6d73-e54c-9048-e0bc34f73cac"],

Cell[TextData[{
 "An empty or completely occupied spectrum returns ",
 Cell[BoxData["0."], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9761f5f9-4c8f-dd42-a7a5-77d19fe6c2b9"],
 ". Degeneracies across the filling require care because energy differences \
are squared in the denominator."
}], "Notes",
 CellID->1440199063,ExpressionUUID->"dc96a00c-0e36-6c4f-9f61-bc3d577613d1"],

Cell[TextData[{
 Cell[BoxData[
