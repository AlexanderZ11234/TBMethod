Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"h", ",", "v"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "k_", "]"}], ":=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"k", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], " ", 
      RowBox[{"PauliMatrix", "[", "1", "]"}]}], "+", 
     RowBox[{
      RowBox[{"k", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], " ", 
      RowBox[{"PauliMatrix", "[", "2", "]"}]}], "+", 
     RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"v", "[", "k_", "]"}], ":=", 
   RowBox[{"N", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "1", "]"}], ",", 
      RowBox[{"PauliMatrix", "[", "2", "]"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"QuantumMetric", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"h", ",", "v"}], "}"}], ",", "1"}], "]"}], "[", 
  RowBox[{"{", 
   RowBox[{"0.", ",", "0."}], "}"}], "]"}]}], "Input",
