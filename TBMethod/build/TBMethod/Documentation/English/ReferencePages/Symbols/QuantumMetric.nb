  RowBox[{"{", 
   RowBox[{
    RowBox[{"h", "[", "k", "]"}], ",", " ", 
    RowBox[{"velocities", "[", "k", "]"}]}], "}"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"f7e3a8ad-ca05-134d-b65d-8a0b72d5477c"],
 "."
}], "Notes",
 CellID->416567691,ExpressionUUID->"853775dc-8e77-1949-8f60-93ba4c47b576"],

Cell[TextData[{
 "The default derivative directions are ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "1"}], "}"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"8088f649-e7ed-764e-8cff-f2656ac90558"],
 ", selecting the first diagonal metric component. Direction indices are \
one-based."
}], "Notes",
 CellID->1136883973,ExpressionUUID->"cc7dad56-299b-3a44-b83e-ecc7ff46b914"],

Cell[TextData[{
 "A positive integer ",
 Cell[BoxData[
  StyleBox["filling", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bfc8868f-4003-fa4d-a5e1-382dcfcce678"],
 " counts occupied low-energy states. A real ",
 Cell[BoxData[
  StyleBox["filling", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "97a5d91d-b2d2-8d4a-bfcc-366ea129a2e1"],
 " is a Fermi energy; use a real number such as ",
 Cell[BoxData["0."], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"435a2ffe-3130-9842-881f-b0b81a49ce0e"],
 " to distinguish it from a band count."
}], "Notes",
 CellID->1085601556,ExpressionUUID->"0cbd07c5-a838-144b-ab1b-67ec91ac20bf"],

Cell[TextData[{
 "The optional observable matrix ",
 Cell[BoxData[
  StyleBox["q", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "48aaf3fc-f1d1-3c49-9f5d-070e89fad1a8"],
 " produces the symmetrized current shown below. The special value ",
 Cell[BoxData["1"], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"5bcb467a-4dc4-d542-a113-8b17c66f7654"],
 " gives the ordinary metric."
}], "Notes",
 CellID->396765416,ExpressionUUID->"fc2f0b7a-a252-a44c-801a-d5c16a3c5dfe"],

Cell[TextData[{
 "An empty or completely occupied spectrum returns ",
 Cell[BoxData["0."], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"ee546d8f-15f4-724f-95de-2f3430ba9851"],
 ". Degeneracies across the filling require care because energy differences \
are squared in the denominator."
}], "Notes",
 CellID->2097821362,ExpressionUUID->"68194302-d4ec-a747-ad7f-342c11b6e490"],

