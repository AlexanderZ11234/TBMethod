Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b97f0bcc-36db-0643-921c-16be85d564b0"],
 " returns a Hermitian Hamiltonian and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["velocities", "TI"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "05c89b8b-b977-5b4b-9fa1-ccfc2f236985"],
 " returns its derivative-matrix list. Alternatively, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["hv", "TI"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "df56ac2c-77ca-4947-bf4e-6e267786d8f1"],
 " returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     StyleBox["h", "TI"], "[", 
     StyleBox["k", "TI"], "]"}], ",", 
    RowBox[{
     StyleBox["velocities", "TI"], "[", 
     StyleBox["k", "TI"], "]"}]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "972248a9-555d-5d4f-b42f-f2377e236a93"],
 "."
}], "Notes",
 CellID->414763077,ExpressionUUID->"5b6ab3e4-a646-0548-8c01-a86b578a6d10"],

Cell[TextData[{
 "The default derivative directions are ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", "1"}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fd8b18c9-c208-804e-b2d6-a2612b10ac6e"],
 ", selecting the first diagonal metric component. Direction indices are \
one-based."
}], "Notes",
 CellID->923052976,ExpressionUUID->"ef2b7271-fcc9-974f-93a4-101dfb0ee2ad"],

Cell[TextData[{
 "A positive integer ",
 Cell[BoxData[
  StyleBox["filling", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "69fbe250-2453-8842-8ada-2130c71b43bd"],
 " counts occupied low-energy states. A real ",
 Cell[BoxData[
  StyleBox["filling", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c1e0a73d-1b5a-d843-8189-07b3ea89d4d6"],
 " is a Fermi energy; use a real number such as ",
 Cell[BoxData["0."], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1ace99fe-51b3-6e4c-8524-91174a375d17"],
 " to distinguish it from a band count."
}], "Notes",
 CellID->617522257,ExpressionUUID->"f312d406-9c98-5e4a-8624-a6329f889887"],

Cell[TextData[{
 "The optional observable matrix ",
 Cell[BoxData[
  StyleBox["q", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "99207774-030d-f44b-b2b8-7dc038787fe3"],
 " produces the symmetrized current shown below. The special value ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "78cd9fcc-9385-7f41-8b2e-07c2e42cdcf0"],
 " gives the ordinary metric."
}], "Notes",
 CellID->1763080235,ExpressionUUID->"5d18bdd0-f1b4-3c42-9598-8d903f2a7fcd"],

Cell[TextData[{
 "An empty or completely occupied spectrum returns ",
 Cell[BoxData["0."], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1cc9e75f-8c97-5b49-b30b-10a0c762032e"],
 ". Degeneracies across the filling require care because energy differences \
are squared in the denominator."
}], "Notes",
 CellID->828318854,ExpressionUUID->"141b7491-a764-284c-b08d-a4c53859c159"],

Cell[TextData[{
 "Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigensystem"]], "paclet:ref/Eigensystem"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "51aa196c-235e-c442-b581-10fefac9049a"],
 " are accepted, with ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Method"]], "paclet:ref/Method"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", "\"\<Direct\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b59c68f2-de52-e44f-898e-fc7269dc5e0b"],
 " supplied internally."
}], "Notes",
 CellID->1396012936,ExpressionUUID->"86078bfc-3aa9-c849-b026-95dc03d03bb0"],

Cell[TextData[{
 "With the same occupied-to-unoccupied ordering as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BerryCurvature"]], "paclet:TBMethod/ref/BerryCurvature", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7bac3f0d-95f2-1c45-a3bd-8a6e4700b215"],
 ", the component is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["g", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}]], "\[LongEqual]", 
     RowBox[{"Re", "(", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"n", "=", "1"}], 
        SubscriptBox["N", "occ"]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"m", "=", 
          RowBox[{
           SubscriptBox["N", "occ"], "+", "1"}]}], 
         SubscriptBox["N", "bands"]], 
        FractionBox[
         RowBox[{
          SubscriptBox["j", 
           RowBox[{"{", 
            RowBox[{"\[Alpha]", ",", "m", ",", "n"}], "}"}]], " ", 
          SubscriptBox["v", 
           RowBox[{"{", 
            RowBox[{"\[Beta]", ",", "n", ",", "m"}], "}"}]]}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Epsilon]", "m"], "-", 
            SubscriptBox["\[Epsilon]", "n"]}], ")"}], "2"]]}]}], ")"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "61377d4c-886e-724f-a176-b02a3f49d553"]
}], "Notes",
 CellID->1076402731,ExpressionUUID->"70df757f-34cb-da45-8b74-9f27caa9511c"],

