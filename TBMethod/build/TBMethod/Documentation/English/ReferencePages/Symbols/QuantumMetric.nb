Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "db94a970-6663-f647-84a1-33b1c2a3b26f"],
 " returns a Hermitian Hamiltonian and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["velocities", "TI"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "08910abc-b932-e84c-bff2-cca3a47fe3af"],
 " returns its derivative-matrix list. Alternatively, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["hv", "TI"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d0a26b35-4cf1-974c-9041-89fbf59f4aff"],
 " returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     StyleBox["h", "TI"], "[", 
     StyleBox["k", "TI"], "]"}], ",", 
    RowBox[{
     StyleBox["velocities", "TI"], "[", 
     StyleBox["k", "TI"], "]"}]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4feff376-943a-3e4c-8dc0-55acfd052603"],
 "."
}], "Notes",
 CellID->414763077,ExpressionUUID->"4b22c273-685f-ba46-be3c-df84f99a241e"],

Cell[TextData[{
 "The default derivative directions are ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", "1"}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "707a140e-a9cb-904f-b2cd-8ddea9efe018"],
 ", selecting the first diagonal metric component. Direction indices are \
one-based."
}], "Notes",
 CellID->923052976,ExpressionUUID->"dde78c4f-5143-7a4b-a470-2ad3a186089d"],

Cell[TextData[{
 "A positive integer ",
 Cell[BoxData[
  StyleBox["filling", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7b7dd312-1f3b-994e-8dd2-eeb6bb3a708e"],
 " counts occupied low-energy states. A real ",
 Cell[BoxData[
  StyleBox["filling", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "974ba777-ffca-7243-acad-49081a311f00"],
 " is a Fermi energy; use a real number such as ",
 Cell[BoxData["0."], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0146d873-954d-824c-a7b8-40e919aa8d60"],
 " to distinguish it from a band count."
}], "Notes",
 CellID->617522257,ExpressionUUID->"d684be16-574b-0940-9983-99b3dd56d6d9"],

Cell[TextData[{
 "The optional observable matrix ",
 Cell[BoxData[
  StyleBox["q", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1997acec-e9c6-4343-8899-d0e1866b7d96"],
 " produces the symmetrized current shown below. The special value ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b61b1cbb-1b2e-3943-9104-8a91a40f5c23"],
 " gives the ordinary metric."
}], "Notes",
 CellID->1763080235,ExpressionUUID->"ad42b98e-d2b1-c24c-98e4-7f48d3790bc0"],

Cell[TextData[{
 "An empty or completely occupied spectrum returns ",
 Cell[BoxData["0."], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e431d4fb-fd3c-1444-9602-dc71a13b57b1"],
 ". Degeneracies across the filling require care because energy differences \
are squared in the denominator."
}], "Notes",
 CellID->828318854,ExpressionUUID->"c1d878b6-5d12-0842-8eeb-f287f8a3d601"],

Cell[TextData[{
 "Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigensystem"]], "paclet:ref/Eigensystem"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fd49e653-2a90-e342-bcfe-b61b08dcf41d"],
 " are accepted, with ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Method"]], "paclet:ref/Method"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", "\"\<Direct\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "191a3f3a-d3bd-fe47-9a0f-50f45288c4fe"],
 " supplied internally."
}], "Notes",
 CellID->1396012936,ExpressionUUID->"cd98ceba-3b39-904d-b30a-298b00ccefbc"],

Cell[TextData[{
 "With the same occupied-to-unoccupied ordering as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BerryCurvature"]], "paclet:TBMethod/ref/BerryCurvature", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4133e067-dd84-f742-90a5-e569f46c778c"],
 ", the component is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["g", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}]], "\[LongEqual]", 
     RowBox[{"Re", "(", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"n", "=", "1"}], 
        SubscriptBox["N", "occ"]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"m", "=", 
          RowBox[{
           SubscriptBox["N", "occ"], "+", "1"}]}], 
         SubscriptBox["N", "bands"]], 
        FractionBox[
         RowBox[{
          SubscriptBox["j", 
           RowBox[{"{", 
            RowBox[{"\[Alpha]", ",", "m", ",", "n"}], "}"}]], " ", 
          SubscriptBox["v", 
           RowBox[{"{", 
            RowBox[{"\[Beta]", ",", "n", ",", "m"}], "}"}]]}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Epsilon]", "m"], "-", 
            SubscriptBox["\[Epsilon]", "n"]}], ")"}], "2"]]}]}], ")"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "3915a2a5-06b1-4741-93b5-c2a624c9559b"]
}], "Notes",
