  FontSlant->"Plain",ExpressionUUID->"ba36fa40-5f0e-384c-b0f2-25042ee55b40"],
 " supplied internally."
}], "Notes",
 CellID->1552777495,ExpressionUUID->"80804e28-c63c-2349-a31d-ac7d968b4dd7"],

Cell[TextData[{
 "With the same occupied-to-unoccupied ordering as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BerryCurvature"]], "paclet:TBMethod/ref/BerryCurvature", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9ac008c3-81f8-f34d-89ee-f2f35492bbd3"],
 ", the component is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["g", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}]], "\[LongEqual]", 
     RowBox[{"Re", "(", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"n", "=", "1"}], 
        SubscriptBox["N", "occ"]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"m", "=", 
          RowBox[{
           SubscriptBox["N", "occ"], "+", "1"}]}], 
         SubscriptBox["N", "bands"]], 
        FractionBox[
         RowBox[{
          SubscriptBox["j", 
           RowBox[{"{", 
            RowBox[{"\[Alpha]", ",", "m", ",", "n"}], "}"}]], " ", 
          SubscriptBox["v", 
           RowBox[{"{", 
            RowBox[{"\[Beta]", ",", "n", ",", "m"}], "}"}]]}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Epsilon]", "m"], "-", 
            SubscriptBox["\[Epsilon]", "n"]}], ")"}], "2"]]}]}], ")"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "cd2e1f3e-f30a-a343-a920-0b39738098c2"]
}], "Notes",
 CellID->189049679,ExpressionUUID->"aaabe102-0727-804c-be3f-51cbe522b295"],

Cell[TextData[{
 "The first-direction observable-current insertion is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["j", "\[Alpha]"], "\[LongEqual]", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Q", ".", 
         SubscriptBox["v", "\[Alpha]"]}], "+", 
        RowBox[{
         SubscriptBox["v", "\[Alpha]"], ".", "Q"}]}], ")"}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "a8418a26-6ca0-7c43-b41f-edeadbf56861"]
}], "Notes",
 CellID->1563476642,ExpressionUUID->"ae8259a6-2c00-394e-ad89-40d09d87be28"]
}, Closed]],

