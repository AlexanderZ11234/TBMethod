Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6ee9f75b-8c15-9b4a-8964-5b2e67fcb833"],
 " returns a Hermitian Hamiltonian and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["velocities", "TI"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2c807397-f99f-b644-9367-502aef92fe38"],
 " returns its derivative-matrix list. Alternatively, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["hv", "TI"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8a942664-1ca4-fe48-8bae-306ab86686ab"],
 " returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     StyleBox["h", "TI"], "[", 
     StyleBox["k", "TI"], "]"}], ",", 
    RowBox[{
     StyleBox["velocities", "TI"], "[", 
     StyleBox["k", "TI"], "]"}]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e79f16f5-b64b-5841-966b-9759cf6462a2"],
 "."
}], "Notes",
 CellID->964582843,ExpressionUUID->"87414669-796f-f846-b44c-8ea121da28d4"],

Cell[TextData[{
 "The default derivative directions are ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", "1"}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "858af5df-832c-2143-ad1e-3eac5729bb56"],
 ", selecting the first diagonal metric component. Direction indices are \
one-based."
}], "Notes",
 CellID->221190911,ExpressionUUID->"cdc37253-1d80-6e42-9406-5c1cdc5383ad"],

Cell[TextData[{
 "A positive integer ",
 Cell[BoxData[
  StyleBox["filling", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d9612924-7be4-d143-be86-0dc7f522141b"],
 " counts occupied low-energy states. A real ",
 Cell[BoxData[
  StyleBox["filling", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "784406ff-06ea-ad48-8876-e4f0430cf8ed"],
 " is a Fermi energy; use a real number such as ",
 Cell[BoxData["0."], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a56e29bc-9e34-ff49-b5fb-e1af16d2cce2"],
 " to distinguish it from a band count."
}], "Notes",
 CellID->1682545808,ExpressionUUID->"338557fd-526f-6443-9066-9c83ede365b4"],

Cell[TextData[{
 "The optional observable matrix ",
 Cell[BoxData[
  StyleBox["q", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "509efa0d-87d0-5e4e-bf4a-fd6dfd9f495c"],
 " produces the symmetrized current shown below. The special value ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0b1f31af-09d9-a44d-a572-e398a8c90b70"],
 " gives the ordinary metric."
}], "Notes",
 CellID->1561326449,ExpressionUUID->"64043d7c-3fc4-0c46-9c11-fcf374048914"],

Cell[TextData[{
 "An empty or completely occupied spectrum returns ",
 Cell[BoxData["0."], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ee211356-faf1-3146-a6e2-448225297d77"],
 ". Degeneracies across the filling require care because energy differences \
are squared in the denominator."
}], "Notes",
 CellID->1250063923,ExpressionUUID->"eb11a6b4-f2d0-3949-ad69-35019862d8d2"],

Cell[TextData[{
 "Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigensystem"]], "paclet:ref/Eigensystem"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "16de7309-6085-c547-bd74-956771c48252"],
 " are accepted, with ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Method"]], "paclet:ref/Method"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", "\"\<Direct\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f3fdfb68-9f6c-2e4e-8781-5a4f27f8f7c2"],
 " supplied internally."
}], "Notes",
 CellID->184418988,ExpressionUUID->"23f53265-f660-aa48-b042-4bdfb69acbb6"],

Cell[TextData[{
 "With the same occupied-to-unoccupied ordering as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BerryCurvature"]], "paclet:TBMethod/ref/BerryCurvature", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "406cd82a-f49b-fe47-ab5c-e7498eea0e26"],
 ", the component is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["g", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}]], "\[LongEqual]", 
     RowBox[{"Re", "(", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"n", "=", "1"}], 
        SubscriptBox["N", "occ"]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"m", "=", 
          RowBox[{
           SubscriptBox["N", "occ"], "+", "1"}]}], 
         SubscriptBox["N", "bands"]], 
        FractionBox[
         RowBox[{
          SubscriptBox["j", 
           RowBox[{"{", 
            RowBox[{"\[Alpha]", ",", "m", ",", "n"}], "}"}]], " ", 
          SubscriptBox["v", 
           RowBox[{"{", 
            RowBox[{"\[Beta]", ",", "n", ",", "m"}], "}"}]]}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Epsilon]", "m"], "-", 
            SubscriptBox["\[Epsilon]", "n"]}], ")"}], "2"]]}]}], ")"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
