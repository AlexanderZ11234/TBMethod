Cell["\<\
Find the xx metric component of a massive two-level Dirac model at the origin.\
\>", "ExampleText",
 CellID->1882939760,ExpressionUUID->"1f60023d-dca8-f04f-b13d-667ab49de9f4"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1973569000,ExpressionUUID->"87fe701d-e036-e848-a8cd-d12908b34e52"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"h", ",", "v"}], "]"}], ";", 
  RowBox[{
   RowBox[{"h", "[", "k_", "]"}], ":=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"k", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], " ", 
      RowBox[{"PauliMatrix", "[", "1", "]"}]}], "+", 
     RowBox[{
      RowBox[{"k", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], " ", 
      RowBox[{"PauliMatrix", "[", "2", "]"}]}], "+", 
     RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"v", "[", "k_", "]"}], ":=", 
   RowBox[{"N", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "1", "]"}], ",", 
      RowBox[{"PauliMatrix", "[", "2", "]"}]}], "}"}], "]"}]}], ";", 
  RowBox[{"result", "=", 
   RowBox[{
    RowBox[{"QuantumMetric", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"h", ",", "v"}], "}"}], ",", "1"}], "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"0.`", ",", "0.`"}], "}"}], "]"}]}], ";", "result"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->2020531408,ExpressionUUID->"1585bf7c-a036-dd42-b4db-43e312c6e838"],

