Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f22cb938-abfd-b743-b7cf-91178e17521b"],
 " returns a Hermitian Hamiltonian and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["velocities", "TI"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1ac612d6-2218-8649-9b71-7bffafd00106"],
 " returns its derivative-matrix list. Alternatively, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["hv", "TI"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "228a68d9-e871-6444-acf3-4dc6ad6467d7"],
 " returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     StyleBox["h", "TI"], "[", 
     StyleBox["k", "TI"], "]"}], ",", 
    RowBox[{
     StyleBox["velocities", "TI"], "[", 
     StyleBox["k", "TI"], "]"}]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "602580ba-cd90-124f-85ae-27fcd7a96479"],
 "."
}], "Notes",
 CellID->414763077,ExpressionUUID->"2ef83a4c-0589-914c-aa42-2beb06fdaa6d"],

Cell[TextData[{
 "The default derivative directions are ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", "1"}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2428d5a6-6845-cf47-9422-f1bf70f89359"],
 ", selecting the first diagonal metric component. Direction indices are \
one-based."
}], "Notes",
 CellID->923052976,ExpressionUUID->"324561a9-b219-de45-9793-5559b39647f5"],

Cell[TextData[{
 "A positive integer ",
 Cell[BoxData[
  StyleBox["filling", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "188652f0-9f59-6a40-ad4c-38679d059232"],
 " counts occupied low-energy states. A real ",
 Cell[BoxData[
  StyleBox["filling", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c09bb28e-11b6-6344-975b-e423b453338c"],
 " is a Fermi energy; use a real number such as ",
 Cell[BoxData["0."], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "63c411b5-826b-6b4e-b14a-573e5b12bdc4"],
 " to distinguish it from a band count."
}], "Notes",
 CellID->617522257,ExpressionUUID->"f1687770-7e66-a44b-9e66-24b7b52c3468"],

Cell[TextData[{
 "The optional observable matrix ",
 Cell[BoxData[
  StyleBox["q", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "671976fd-1d5f-0b43-beaa-0d8a0deefef6"],
 " produces the symmetrized current shown below. The special value ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "447ba4ef-36be-844b-aba8-9b16e32d62a6"],
 " gives the ordinary metric."
}], "Notes",
 CellID->1763080235,ExpressionUUID->"bc2ddbdf-d893-064c-8764-e86a0d88e208"],

Cell[TextData[{
 "An empty or completely occupied spectrum returns ",
 Cell[BoxData["0."], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0d9e0479-3b20-5e49-9ad8-20db3c7c626e"],
 ". Degeneracies across the filling require care because energy differences \
are squared in the denominator."
}], "Notes",
 CellID->828318854,ExpressionUUID->"f239d204-31ff-8345-b875-e21e7fdd43b1"],

Cell[TextData[{
 "Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigensystem"]], "paclet:ref/Eigensystem"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1a6485b9-4a1e-4e49-826b-7f0e4b23bde9"],
 " are accepted, with ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Method"]], "paclet:ref/Method"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", "\"\<Direct\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "59e08d6f-beb3-6d4b-a6eb-770f58bfa335"],
 " supplied internally."
}], "Notes",
 CellID->1396012936,ExpressionUUID->"67c4781a-3725-d54c-bbd1-0b80d98c1096"],

Cell[TextData[{
 "With the same occupied-to-unoccupied ordering as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BerryCurvature"]], "paclet:TBMethod/ref/BerryCurvature", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d010e683-cd19-614a-94a8-20202bb2de28"],
 ", the component is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["g", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}]], "\[LongEqual]", 
     RowBox[{"Re", "(", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"n", "=", "1"}], 
        SubscriptBox["N", "occ"]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"m", "=", 
          RowBox[{
           SubscriptBox["N", "occ"], "+", "1"}]}], 
         SubscriptBox["N", "bands"]], 
        FractionBox[
         RowBox[{
          SubscriptBox["j", 
           RowBox[{"{", 
            RowBox[{"\[Alpha]", ",", "m", ",", "n"}], "}"}]], " ", 
          SubscriptBox["v", 
           RowBox[{"{", 
            RowBox[{"\[Beta]", ",", "n", ",", "m"}], "}"}]]}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Epsilon]", "m"], "-", 
            SubscriptBox["\[Epsilon]", "n"]}], ")"}], "2"]]}]}], ")"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "42f1f258-93ab-2949-ac01-e3da9288d49c"]
}], "Notes",
