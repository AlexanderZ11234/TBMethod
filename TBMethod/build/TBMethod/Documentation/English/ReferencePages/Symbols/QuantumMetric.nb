 " options are accepted."
}], "Notes",
 CellID->654402319,ExpressionUUID->"e2487e05-55b8-9846-ae3a-5d8c3f102e5f"],

Cell[TextData[{
 "With the same occupied-to-unoccupied ordering as BerryCurvature, the \
component is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["g", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}]], "\[LongEqual]", 
     RowBox[{"Re", "(", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"n", "=", "1"}], 
        SubscriptBox["N", "occ"]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"m", "=", 
          RowBox[{
           SubscriptBox["N", "occ"], "+", "1"}]}], 
         SubscriptBox["N", "bands"]], 
        FractionBox[
         RowBox[{
          SubscriptBox["j", 
           RowBox[{"{", 
            RowBox[{"\[Alpha]", ",", "m", ",", "n"}], "}"}]], " ", 
          SubscriptBox["v", 
           RowBox[{"{", 
            RowBox[{"\[Beta]", ",", "n", ",", "m"}], "}"}]]}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Epsilon]", "m"], "-", 
            SubscriptBox["\[Epsilon]", "n"]}], ")"}], "2"]]}]}], ")"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "2cb0392b-ac45-fe46-92b6-e57908afd9e8"]
}], "Notes",
