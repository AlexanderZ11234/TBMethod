Cell[TextData[{
 Cell[BoxData[
  RowBox[{"h", "[", "k", "]"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"98231e8b-1e0e-bf4a-9083-7709f63ba24d"],
 " returns a Hermitian Hamiltonian and ",
 Cell[BoxData[
  RowBox[{"velocities", "[", "k", "]"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"0805f38b-256a-9749-9ca5-eb7533ec0029"],
 " returns its derivative-matrix list. Alternatively, ",
 Cell[BoxData[
  RowBox[{"hv", "[", "k", "]"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"952f6e21-9daf-1b4f-a4df-0c570c7ed296"],
