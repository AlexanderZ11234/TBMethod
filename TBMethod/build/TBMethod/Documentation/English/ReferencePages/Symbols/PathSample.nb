  FontFamily->"Source Sans Pro",ExpressionUUID->
  "23e2c625-1255-d34d-861f-3c5eec0b28cb"],
 "."
}], "Notes",
 CellID->1891365747,ExpressionUUID->"b60aed96-f3cf-9742-bacd-de7c6d29c147"],

Cell[TextData[{
 "Returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["samples", "TI"], ",", 
    StyleBox["vertexMarkers", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b8060f37-07e6-2243-b04d-ddb90426fed2"],
 ". Each segment contributes its initial point but omits its endpoint, so \
internal vertices appear once and the last vertex is omitted."
}], "Notes",
 CellID->1639366059,ExpressionUUID->"871a2607-ba4c-554d-8c93-06b575915a03"],

Cell[TextData[{
 Cell[BoxData[
