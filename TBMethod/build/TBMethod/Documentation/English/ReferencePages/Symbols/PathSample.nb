Cell[TextData[{
 Cell[BoxData[
  RowBox[{"PathSample", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["pt",
        FontSlant->"Italic"], "1"], ",", " ", 
      SubscriptBox[
       StyleBox["pt",
        FontSlant->"Italic"], "2"], ",", "...", ",", " ", 
      StyleBox[
       SubscriptBox["pt", "i"],
       FontSlant->"Italic"], ",", "...", ",", 
      StyleBox[
       SubscriptBox["pt", "k"],
       FontSlant->"Italic"]}], "}"}], ",", " ", 
    StyleBox["n",
     FontSlant->"Italic"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "072a71ba-ea2f-074d-bf2d-2ec0ce3479e0"],
 " evenly and length-proportionally samples out coordinates on a path \
consisting of straight line segments with sequentially ",
 Cell[BoxData[
  StyleBox["k",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c5ab1841-8fbe-9f40-a767-37b2fcbb5784"],
 " different node points ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    SubscriptBox[
     StyleBox["pt",
      FontSlant->"Italic"], "1"], ",", " ", 
    SubscriptBox[
     StyleBox["pt",
      FontSlant->"Italic"], "2"], ",", "...", ",", " ", 
    StyleBox[
     SubscriptBox["pt", "i"],
     FontSlant->"Italic"], ",", "...", ",", 
    StyleBox[
     SubscriptBox["pt", "k"],
     FontSlant->"Italic"]}], "}"}]],ExpressionUUID->
  "c9300646-0da3-b840-a15e-38d438f64766"],
 ", where ",
 StyleBox["n",
  FontSlant->"Italic"],
 " is the number of points intended to be sampled on the shortest segment, \
together with a ",
 ButtonBox["List",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/List"],
 " of the ordinal number in the samplings for each node."
}], "ExampleText",
 CellID->427493852,ExpressionUUID->"80a65ba0-faf8-4b49-95ad-1a7dda8232a7"],

Cell[TextData[{
 Cell[BoxData[
