Cell[TextData[{
 Cell[BoxData[
  RowBox[{"PathSample", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["pt",
        FontSlant->"Italic"], "1"], ",", " ", 
      SubscriptBox[
       StyleBox["pt",
        FontSlant->"Italic"], "2"], ",", "...", ",", " ", 
      StyleBox[
       SubscriptBox["pt", "i"],
       FontSlant->"Italic"], ",", "...", ",", 
      StyleBox[
       SubscriptBox["pt", "k"],
       FontSlant->"Italic"]}], "}"}], ",", " ", 
    StyleBox["n",
     FontSlant->"Italic"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "69a740c3-3086-e34b-83aa-a3301ab15971"],
 " evenly and length-proportionally samples out coordinates on a path \
consisting of straight line segments with sequentially ",
 Cell[BoxData[
  StyleBox["k",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b100e35c-0182-c04e-ac7f-3ac4d805423f"],
 " different node points ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    SubscriptBox[
     StyleBox["pt",
      FontSlant->"Italic"], "1"], ",", " ", 
    SubscriptBox[
     StyleBox["pt",
      FontSlant->"Italic"], "2"], ",", "...", ",", " ", 
    StyleBox[
     SubscriptBox["pt", "i"],
     FontSlant->"Italic"], ",", "...", ",", 
    StyleBox[
     SubscriptBox["pt", "k"],
     FontSlant->"Italic"]}], "}"}]],ExpressionUUID->
  "4d7c8810-d0a1-df4d-8df6-4d378a712138"],
 ", where ",
 StyleBox["n",
  FontSlant->"Italic"],
 " is the number of points intended to be sampled on the shortest segment, \
together with a ",
 ButtonBox["List",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/List"],
 " of the ordinal number in the samplings for each node."
}], "ExampleText",
 CellID->427493852,ExpressionUUID->"d19557e0-2e00-3546-a978-a0a2a7e11450"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   SubscriptBox["pt", "i"],
   FontSlant->"Italic"]],ExpressionUUID->
