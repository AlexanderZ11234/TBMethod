Cell[TextData[{
 Cell[BoxData[
  RowBox[{"PathSample", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["pt",
        FontSlant->"Italic"], "1"], ",", " ", 
      SubscriptBox[
       StyleBox["pt",
        FontSlant->"Italic"], "2"], ",", "...", ",", " ", 
      StyleBox[
       SubscriptBox["pt", "i"],
       FontSlant->"Italic"], ",", "...", ",", 
      StyleBox[
       SubscriptBox["pt", "k"],
       FontSlant->"Italic"]}], "}"}], ",", " ", 
    StyleBox["n",
     FontSlant->"Italic"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e958bbc9-583d-824b-a50a-4acd9464f6c1"],
 " evenly and length-proportionally samples out coordinates on a path \
consisting of straight line segments with sequentially ",
 Cell[BoxData[
  StyleBox["k",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3b8ae7e1-2c79-1641-a3d3-cb94b03ef4f1"],
 " different node points ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    SubscriptBox[
     StyleBox["pt",
      FontSlant->"Italic"], "1"], ",", " ", 
    SubscriptBox[
     StyleBox["pt",
      FontSlant->"Italic"], "2"], ",", "...", ",", " ", 
    StyleBox[
     SubscriptBox["pt", "i"],
     FontSlant->"Italic"], ",", "...", ",", 
    StyleBox[
     SubscriptBox["pt", "k"],
     FontSlant->"Italic"]}], "}"}]],ExpressionUUID->
  "a5d1c670-47e9-244a-8409-2c5012dbcc3c"],
 ", where ",
 StyleBox["n",
  FontSlant->"Italic"],
 " is the number of points intended to be sampled on the shortest segment, \
together with a ",
 ButtonBox["List",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/List"],
 " of the ordinal number in the samplings for each node."
}], "ExampleText",
 CellID->427493852,ExpressionUUID->"3f5217ac-2153-ec41-91c3-4491fbaf3e26"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
