Cell["\<\
vertices contains at least three numeric coordinate vectors of the same \
dimension. Consecutive vertices must be distinct; the implementation does not \
handle zero-length segments.\
\>", "Notes",
 CellID->1629074568,ExpressionUUID->"a70ebfdd-8794-df47-b540-b899641e2e54"],

Cell["\<\
nleast is a positive integer giving the number of subdivisions on the \
shortest segment. Other subdivision counts are Floor[nleast \
length/shortestLength].\
\>", "Notes",
 CellID->797064154,ExpressionUUID->"78c31813-fb7d-6247-aae9-2d105ce12f4e"],

Cell["\<\
Returns {samples, vertexMarkers}. Each segment contributes its initial point \
but omits its endpoint, so internal vertices appear once and the last vertex \
is omitted.\
\>", "Notes",
 CellID->1002414994,ExpressionUUID->"8a8854de-2da4-b54b-a617-6948c15b9d97"],

Cell["\<\
vertexMarkers starts at 1. Its last marker is Length[samples] + 1, \
representing the omitted terminal vertex.\
\>", "Notes",
 CellID->501974451,ExpressionUUID->"ffda24f6-533a-5345-953b-060bf873a862"]
}, Closed]],

