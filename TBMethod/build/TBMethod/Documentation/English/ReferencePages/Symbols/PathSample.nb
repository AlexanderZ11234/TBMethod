Cell[TextData[{
 Cell[BoxData[
  RowBox[{"PathSample", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["pt",
        FontSlant->"Italic"], "1"], ",", " ", 
      SubscriptBox[
       StyleBox["pt",
        FontSlant->"Italic"], "2"], ",", "...", ",", " ", 
      StyleBox[
       SubscriptBox["pt", "i"],
       FontSlant->"Italic"], ",", "...", ",", 
      StyleBox[
       SubscriptBox["pt", "k"],
       FontSlant->"Italic"]}], "}"}], ",", " ", 
    StyleBox["n",
     FontSlant->"Italic"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "05e8fc7d-e794-9548-bf31-dee3c28b61fb"],
 " evenly and length-proportionally samples out coordinates on a path \
consisting of straight line segments with sequentially ",
 Cell[BoxData[
  StyleBox["k",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "51b0f2e0-2f5b-8f40-85e7-05883bf36054"],
 " different node points ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    SubscriptBox[
     StyleBox["pt",
      FontSlant->"Italic"], "1"], ",", " ", 
    SubscriptBox[
     StyleBox["pt",
      FontSlant->"Italic"], "2"], ",", "...", ",", " ", 
    StyleBox[
     SubscriptBox["pt", "i"],
     FontSlant->"Italic"], ",", "...", ",", 
    StyleBox[
     SubscriptBox["pt", "k"],
     FontSlant->"Italic"]}], "}"}]],ExpressionUUID->
  "2f508fad-ccb0-5c49-9014-9d17778394a6"],
 ", where ",
 StyleBox["n",
  FontSlant->"Italic"],
 " is the number of points intended to be sampled on the shortest segment, \
together with a ",
 ButtonBox["List",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/List"],
 " of the ordinal number in the samplings for each node."
}], "ExampleText",
