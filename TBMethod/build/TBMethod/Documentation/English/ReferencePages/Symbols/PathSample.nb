Cell[TextData[{
 Cell[BoxData[
  RowBox[{"PathSample", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["pt",
        FontSlant->"Italic"], "1"], ",", " ", 
      SubscriptBox[
       StyleBox["pt",
        FontSlant->"Italic"], "2"], ",", "...", ",", " ", 
      StyleBox[
       SubscriptBox["pt", "i"],
       FontSlant->"Italic"], ",", "...", ",", 
      StyleBox[
       SubscriptBox["pt", "k"],
       FontSlant->"Italic"]}], "}"}], ",", " ", 
    StyleBox["n",
     FontSlant->"Italic"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e620afb6-7a36-504b-ad4d-9cbf7b96f191"],
 " evenly and length-proportionally samples out coordinates on a path \
consisting of straight line segments with sequentially ",
 Cell[BoxData[
  StyleBox["k",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b920a9fa-62af-0047-b30e-c5e7691319a5"],
 " different node points ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    SubscriptBox[
     StyleBox["pt",
      FontSlant->"Italic"], "1"], ",", " ", 
    SubscriptBox[
     StyleBox["pt",
      FontSlant->"Italic"], "2"], ",", "...", ",", " ", 
    StyleBox[
     SubscriptBox["pt", "i"],
     FontSlant->"Italic"], ",", "...", ",", 
    StyleBox[
     SubscriptBox["pt", "k"],
     FontSlant->"Italic"]}], "}"}]],ExpressionUUID->
  "ff4501cc-ebf4-d044-abc3-2816b169d733"],
 ", where ",
 StyleBox["n",
  FontSlant->"Italic"],
 " is the number of points intended to be sampled on the shortest segment, \
together with a ",
 ButtonBox["List",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/List"],
 " of the ordinal number in the samplings for each node."
}], "ExampleText",
 CellID->427493852,ExpressionUUID->"0e6f4a7e-76b3-a449-b999-187f0a9f4202"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   SubscriptBox["pt", "i"],
   FontSlant->"Italic"]],ExpressionUUID->
  "8082f221-6eb9-2e42-b5aa-a52ac68d7bba"],
 "s are typically 2D and 3D points coordinates."
}], "ExampleText",
 CellID->582441303,ExpressionUUID->"ce91b129-4d2e-6449-83e1-a8e532f6c1c1"],

