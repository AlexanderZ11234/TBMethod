Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"omega", "=", "10."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h0", "=", 
   RowBox[{
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "3", "]"}], ",", 
      RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}], "+", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "0", "]"}], ",", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{
        RowBox[{"-", "omega"}], " ", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "]"}]}], "]"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"HFloquetEffectiveBlochMatrixFromExtended", "[", 
   RowBox[{"omega", ",", "1"}], "]"}], "[", "h0", "]"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->493024234,ExpressionUUID->"6ea4ebf4-d50a-2444-aab4-b4f88ca3c8c8"],

