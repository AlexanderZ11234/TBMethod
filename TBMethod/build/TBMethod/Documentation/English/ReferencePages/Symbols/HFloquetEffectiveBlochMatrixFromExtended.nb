Cell["\<\
An undriven two-level Hamiltonian is recovered from its three-sector Floquet \
representation.\
\>", "ExampleText",
 CellID->1676208245,ExpressionUUID->"db0be01e-6197-4043-9178-1f4ce6310065"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->391513386,ExpressionUUID->"fec21975-be17-d041-a05f-795205f1c201"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"omega", "=", "10.`"}], ";", 
  RowBox[{"h0", "=", 
   RowBox[{
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "3", "]"}], ",", 
      RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}], "+", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "0", "]"}], ",", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{
        RowBox[{"-", "omega"}], " ", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "]"}]}], "]"}]}], "]"}]}]}], ";", 
  RowBox[{"result", "=", 
   RowBox[{
    RowBox[{"HFloquetEffectiveBlochMatrixFromExtended", "[", 
     RowBox[{"omega", ",", "1"}], "]"}], "[", "h0", "]"}]}], ";", 
  "result"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->1646590011,ExpressionUUID->"a1a4717a-1b04-2340-8fe8-3b9206f1cf1c"],

