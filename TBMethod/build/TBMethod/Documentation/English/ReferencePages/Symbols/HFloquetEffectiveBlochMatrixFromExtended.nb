Cell[TextData[{
 Cell[BoxData[
  StyleBox["m", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4c24d0ec-8173-3b49-98aa-237f096226d2"],
 " is a nonnegative photon cutoff, with ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"2", " ", "m"}], "+", "1"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "e6d8e6d6-1a67-4844-99c9-3d5a8af42053"],
 " photon states for every internal state. The matrix uses internal-major, \
photon-minor ordering."
}], "Notes",
 CellID->730966128,ExpressionUUID->"63f77ec5-c832-6349-a131-b2100e897228"],

Cell[TextData[{
 "Extracts harmonics through order ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"2", " ", "m"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "fc7b38ae-dd5a-c240-ae18-8648b97076eb"],
 " from the extended matrix. The zero harmonic is the central photon diagonal \
block."
}], "Notes",
 CellID->1858631140,ExpressionUUID->"dcff6712-1a03-9849-b932-63aa154ce198"],

