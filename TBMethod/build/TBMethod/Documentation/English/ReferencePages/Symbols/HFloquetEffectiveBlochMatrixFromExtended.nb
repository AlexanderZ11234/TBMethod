 CellLabel->"In[1]:=",
 CellID->523062114,ExpressionUUID->"e564c06d-282f-9b4f-8413-0ba7f248c356"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"omega", "=", "10."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h0", "=", 
   RowBox[{
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "3", "]"}], ",", 
      RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}], "+", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "0", "]"}], ",", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{
        RowBox[{"-", "omega"}], " ", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "]"}]}], "]"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"HFloquetEffectiveBlochMatrixFromExtended", "[", 
   RowBox[{"omega", ",", "1"}], "]"}], "[", "h0", "]"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->493024234,ExpressionUUID->"cd0aeeea-8468-ea43-9d37-a3c1afcf2ec5"],

