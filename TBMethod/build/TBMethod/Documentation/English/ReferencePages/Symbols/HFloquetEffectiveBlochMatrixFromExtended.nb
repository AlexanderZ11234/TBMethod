Cell[TextData[{
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "01fdb89b-6671-f742-b900-8d3ca52810ba"],
 " is a nonnegative photon cutoff, with ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"2", " ", "m"}], "+", "1"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "5e1c6b63-89f4-e34e-9cdb-52f17e58de2a"],
 " photon states for every internal state. The matrix uses internal-major, \
photon-minor ordering."
}], "Notes",
 CellID->1905633193,ExpressionUUID->"fd41ea18-0e42-574c-b438-2c1f064c54bb"],

Cell[TextData[{
 "Extracts harmonics through order ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"2", " ", "m"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "05f6ecd0-2934-324d-9958-84f16d2a3915"],
 " from the extended matrix. The zero harmonic is the central photon diagonal \
block."
}], "Notes",
 CellID->1537857241,ExpressionUUID->"5f828cb7-1e33-a546-adfe-a35cc15ed6fb"],

Cell[TextData[{
 "The option ",
 Cell[BoxData["\"\<ExpansionOrder\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1d8d9221-749c-c342-a514-1e04f06255c6"],
 " defaults to ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ba0ddd52-1fb3-854a-af39-d6344bd24e7a"],
 " and accepts ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2f14af18-190b-b747-af07-93699902ba20"],
 " or ",
 Cell[BoxData["2"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f026a6dd-0310-254e-a981-e79fb2c7ba58"],
 ". The option ",
 Cell[BoxData["\"\<ReturnComponents\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a296cfc7-67db-a040-905b-656cd12919d5"],
 " defaults to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4970bb39-9e70-fd49-8383-783e140ea3e1"],
 "; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b428d162-3aca-5044-9fab-1c570ab203ff"],
 " returns an association with keys ",
 Cell[BoxData["\"\<Order0\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "afb20a95-1acd-6141-80fc-bb27473efd82"],
 " and ",
