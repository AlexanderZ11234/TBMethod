Cell[TextData[{
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "87257445-e9de-9e43-bb11-a9170daa5b04"],
 " is a nonnegative photon cutoff, with ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"2", " ", "m"}], "+", "1"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "69105997-b66b-724e-96c0-555cd4100dc3"],
 " photon states for every internal state. The matrix uses internal-major, \
photon-minor ordering."
}], "Notes",
 CellID->362104106,ExpressionUUID->"46fffa20-82d4-ee4f-bdae-e7583bea4ffc"],

Cell[TextData[{
 "Extracts harmonics through order ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"2", " ", "m"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "50431d7d-4833-0445-8e35-eacd192f5775"],
 " from the extended matrix. The zero harmonic is the central photon diagonal \
block."
}], "Notes",
 CellID->772177344,ExpressionUUID->"90861e8e-e5ca-1c4d-ad42-f8140d9af73b"],

Cell[TextData[{
 "The option ",
 Cell[BoxData["\"\<ExpansionOrder\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a9a5401d-ef57-e24e-a02f-a01245e7cc20"],
 " defaults to ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "758cf30a-3a9d-9643-a1c2-83cc9eeeebf2"],
 " and accepts ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ef6542d5-a0fa-fd43-8f54-9aa671b54cbc"],
 " or ",
 Cell[BoxData["2"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e413fafd-465f-754b-8b77-28ffef856dd3"],
 ". The option ",
 Cell[BoxData["\"\<ReturnComponents\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0090f2d1-8355-824d-a842-44ada1c2df05"],
 " defaults to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cfb0c08b-9ce5-ed40-afae-b48d45bbb153"],
 "; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fedcd5cb-d72c-f945-a60e-c5c1669b63f5"],
 " returns an association with keys ",
