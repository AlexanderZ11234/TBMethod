Cell[TextData[{
 "The expansion contains denominators ",
 Cell[BoxData[
  FormBox[
   TagBox["\[Omega]",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "fe3312aa-1ef7-d043-82a1-efd1a5698990"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    SuperscriptBox["\[Omega]", "2"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "ddb4722f-9655-cf4e-b5ec-9e1d95f668d4"],
 ", so ",
 Cell[BoxData[
  StyleBox["omega", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "382ca28b-3aa2-604a-a0f6-ae3943cd63bb"],
 " must be nonzero. This high-frequency approximation requires physical \
convergence checks for the chosen driven model."
}], "Notes",
 CellID->1208961699,ExpressionUUID->"46603a9b-cda8-4745-8eec-575ebb15f7dd"],

Cell[TextData[{
 "At first order, the implemented high-frequency expansion is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["H", "eff"], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["H", "0"], "+", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"l", "=", "1"}], 
        SubscriptBox["l", "max"]], 
       FractionBox[
        RowBox[{
         RowBox[{
          SubscriptBox["H", 
           RowBox[{"-", "l"}]], ".", 
          SubscriptBox["H", "l"]}], "-", 
         RowBox[{
          SubscriptBox["H", "l"], ".", 
          SubscriptBox["H", 
           RowBox[{"-", "l"}]]}]}], 
        RowBox[{"l", " ", "\[Omega]"}]]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "365d6767-c834-8f4c-a4af-0f6cc56a46db"]
}], "Notes",
 CellID->255352623,ExpressionUUID->"9e6607ec-7ebf-5a4a-ac9e-026c789ac740"]
}, Closed]],

