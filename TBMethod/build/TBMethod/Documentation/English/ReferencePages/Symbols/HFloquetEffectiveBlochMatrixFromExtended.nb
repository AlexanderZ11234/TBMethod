Cell[TextData[{
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "87b4af0f-801b-2240-a408-3d251a52c609"],
 " is a nonnegative photon cutoff, with ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"2", " ", "m"}], "+", "1"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "757cfa0c-f129-b349-a087-248c8398e036"],
 " photon states for every internal state. The matrix uses internal-major, \
photon-minor ordering."
}], "Notes",
 CellID->1905633193,ExpressionUUID->"b8cdd54d-96f3-4747-8e91-16e6a2e290d4"],

Cell[TextData[{
 "Extracts harmonics through order ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"2", " ", "m"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "bf0913bd-7b08-c146-a34a-2850fc14bf29"],
 " from the extended matrix. The zero harmonic is the central photon diagonal \
block."
}], "Notes",
 CellID->1537857241,ExpressionUUID->"dc92c538-fcaf-5c4b-9399-293b7bb09f85"],

Cell[TextData[{
 "The option ",
 Cell[BoxData["\"\<ExpansionOrder\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a262b481-e27f-6448-b990-155dc2d1a65d"],
 " defaults to ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "53a2d0bb-1c43-414c-a46f-f48f2f7cadf1"],
 " and accepts ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dad3027f-b917-4847-9318-a374190cc5f9"],
 " or ",
 Cell[BoxData["2"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9073a2d2-c7d7-4542-97cb-d0f1e205215c"],
 ". The option ",
 Cell[BoxData["\"\<ReturnComponents\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e59f1746-6336-2548-88e0-4d9bed3dec84"],
 " defaults to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "11b2cc54-2a72-294a-a838-e1eb020b5022"],
 "; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "37e921a5-57e2-124d-b79f-707eeb554bca"],
 " returns an association with keys ",
 Cell[BoxData["\"\<Order0\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9e060e3b-9343-4840-9f80-6191716cfddf"],
 " and ",
