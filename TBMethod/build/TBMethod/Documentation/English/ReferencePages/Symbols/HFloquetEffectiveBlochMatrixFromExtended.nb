Cell[TextData[{
 "The expansion contains denominators ",
 Cell[BoxData[
  FormBox[
   TagBox["\[Omega]",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "8594dd45-9bd4-0141-8545-fad2dca04d28"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    SuperscriptBox["\[Omega]", "2"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "f1505554-c048-d748-a9fa-582917088287"],
 ", so ",
 Cell[BoxData[
  StyleBox["omega", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ff9c12c7-626a-0648-a1e1-4b580ed26374"],
 " must be nonzero. This high-frequency approximation requires physical \
convergence checks for the chosen driven model."
}], "Notes",
 CellID->174682120,ExpressionUUID->"2fbfb541-35f1-f044-a80c-ec64ca34d3e5"],

Cell[TextData[{
 "At first order, the implemented high-frequency expansion is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["H", "eff"], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["H", "0"], "+", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"l", "=", "1"}], 
        SubscriptBox["l", "max"]], 
       FractionBox[
        RowBox[{
         RowBox[{
          SubscriptBox["H", 
           RowBox[{"-", "l"}]], ".", 
          SubscriptBox["H", "l"]}], "-", 
         RowBox[{
          SubscriptBox["H", "l"], ".", 
          SubscriptBox["H", 
           RowBox[{"-", "l"}]]}]}], 
        RowBox[{"l", " ", "\[Omega]"}]]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "a6590efb-0931-9345-bf57-aaadcd1892c1"]
}], "Notes",
 CellID->956325310,ExpressionUUID->"590cbfa1-3ba8-1f4d-ab7d-9044dc7ab36f"]
}, Closed]],

