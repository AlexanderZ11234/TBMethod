Cell[TextData[{
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fce9bdbd-089a-b647-957c-ba6072555611"],
 " is a nonnegative photon cutoff, with ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"2", " ", "m"}], "+", "1"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "1e2aef23-b291-5547-961f-2249d317ea36"],
 " photon states for every internal state. The matrix uses internal-major, \
photon-minor ordering."
}], "Notes",
 CellID->1905633193,ExpressionUUID->"c736fe98-75f5-0344-bed5-052065adb2aa"],

Cell[TextData[{
 "Extracts harmonics through order ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"2", " ", "m"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "248c98ed-816a-274f-b999-19a8573416f1"],
 " from the extended matrix. The zero harmonic is the central photon diagonal \
block."
}], "Notes",
 CellID->1537857241,ExpressionUUID->"8c6ea5fd-0e3d-ea48-ab24-51e581a77478"],

Cell[TextData[{
 "The option ",
 Cell[BoxData["\"\<ExpansionOrder\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e04ec422-0997-a54d-8c22-1ed7aff919c9"],
 " defaults to ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b899d4c0-4917-cf42-b339-78f093daeede"],
 " and accepts ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f0b43cca-1d41-e348-b918-720459630d18"],
 " or ",
 Cell[BoxData["2"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "980abc4a-d901-e546-aaae-5466dc116452"],
 ". The option ",
 Cell[BoxData["\"\<ReturnComponents\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f50770ab-aae5-864e-9fe6-f16a1f596adf"],
 " defaults to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cad12811-ed74-3d4e-ac6e-bcae6a8230d5"],
 "; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "01c976ec-da38-4241-8dd5-82d31298b2ae"],
 " returns an association with keys ",
 Cell[BoxData["\"\<Order0\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ebba5b86-ee2e-0440-9946-d4a7f59ef3ef"],
 " and ",
 Cell[BoxData["\"\<Order1\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "94b8848c-bb55-0840-8df0-6dd8ade65dd4"],
 ", and, at second order, ",
 Cell[BoxData["\"\<Order2Pure\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "756a3ed9-3f5f-a141-bfaf-c8163a098118"],
 " and ",
 Cell[BoxData["\"\<Order2Mixed\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "34f7fd60-fbeb-c542-8f59-d124ed6d33c7"],
 "."
}], "Notes",
 CellID->1597340439,ExpressionUUID->"941e07f9-a076-2f43-bfbb-d4b1edf82761"],

Cell[TextData[{
 "The expansion contains denominators ",
 Cell[BoxData[
  FormBox[
   TagBox["\[Omega]",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "3cb78c75-1a29-834d-ac41-86d26e94bf9a"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    SuperscriptBox["\[Omega]", "2"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "14f2b757-e055-c249-a93f-bab3f97384db"],
 ", so ",
 Cell[BoxData[
  StyleBox["omega", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "33a793aa-98b0-234d-a431-7d682498c896"],
 " must be nonzero. This high-frequency approximation requires physical \
convergence checks for the chosen driven model."
}], "Notes",
 CellID->174682120,ExpressionUUID->"791313e2-62a1-d446-9911-9fdc6df7d207"],

Cell[TextData[{
 "At first order, the implemented high-frequency expansion is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["H", "eff"], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["H", "0"], "+", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"l", "=", "1"}], 
        SubscriptBox["l", "max"]], 
       FractionBox[
        RowBox[{
         RowBox[{
          SubscriptBox["H", 
           RowBox[{"-", "l"}]], ".", 
          SubscriptBox["H", "l"]}], "-", 
         RowBox[{
          SubscriptBox["H", "l"], ".", 
          SubscriptBox["H", 
           RowBox[{"-", "l"}]]}]}], 
        RowBox[{"l", " ", "\[Omega]"}]]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "b1c5d480-6c04-e542-9232-04666b73ed10"]
}], "Notes",
 CellID->956325310,ExpressionUUID->"e42d9737-a735-764c-8326-bec7af7c70c5"]
}, Closed]],

