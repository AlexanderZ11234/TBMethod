Cell[TextData[{
 "The expansion contains denominators ",
 Cell[BoxData[
  FormBox[
   TagBox["\[Omega]",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "74257a08-0428-bd41-99fe-90b7bcf877dc"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    SuperscriptBox["\[Omega]", "2"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "62cfb769-5ad2-b842-aade-f32384ed702e"],
 ", so ",
 Cell[BoxData[
  StyleBox["omega", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4626302b-dece-c84c-b37b-aabe5220c0c6"],
 " must be nonzero. This high-frequency approximation requires physical \
convergence checks for the chosen driven model."
}], "Notes",
 CellID->174682120,ExpressionUUID->"c0e29438-0afb-6e49-8f29-e2b73542e900"],

Cell[TextData[{
 "At first order, the implemented high-frequency expansion is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["H", "eff"], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["H", "0"], "+", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"l", "=", "1"}], 
        SubscriptBox["l", "max"]], 
       FractionBox[
        RowBox[{
         RowBox[{
          SubscriptBox["H", 
           RowBox[{"-", "l"}]], ".", 
          SubscriptBox["H", "l"]}], "-", 
         RowBox[{
          SubscriptBox["H", "l"], ".", 
          SubscriptBox["H", 
           RowBox[{"-", "l"}]]}]}], 
        RowBox[{"l", " ", "\[Omega]"}]]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "a9b5f3ff-6393-7647-8481-341f0af52394"]
}], "Notes",
 CellID->956325310,ExpressionUUID->"35bcbb14-b5f5-2f4c-9255-583243b7ce97"]
}, Closed]],

