Cell[TextData[{
 "The expansion contains denominators ",
 Cell[BoxData[
  FormBox[
   TagBox["\[Omega]",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "cc98d1b1-0315-7540-b5dd-49015afa8af8"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    SuperscriptBox["\[Omega]", "2"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "c5cc750b-8aef-ad42-830b-1715a387fd37"],
 ", so ",
 Cell[BoxData[
  StyleBox["omega", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "03134795-d998-3d4f-ad5a-a3427d26f6a3"],
 " must be nonzero. This high-frequency approximation requires physical \
convergence checks for the chosen driven model."
}], "Notes",
 CellID->400625521,ExpressionUUID->"1891aed9-6463-a648-b86a-17f9d07b6199"],

Cell[TextData[{
 "At first order, the implemented high-frequency expansion is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["H", "eff"], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["H", "0"], "+", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"l", "=", "1"}], 
        SubscriptBox["l", "max"]], 
       FractionBox[
        RowBox[{
         RowBox[{
          SubscriptBox["H", 
           RowBox[{"-", "l"}]], ".", 
          SubscriptBox["H", "l"]}], "-", 
         RowBox[{
          SubscriptBox["H", "l"], ".", 
          SubscriptBox["H", 
           RowBox[{"-", "l"}]]}]}], 
        RowBox[{"l", " ", "\[Omega]"}]]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "2339822b-66d9-f846-8eaf-91c11bfc6605"]
}], "Notes",
 CellID->1373901342,ExpressionUUID->"28275f8c-dfd0-774f-bb43-2e31de11f50a"]
}, Closed]],

