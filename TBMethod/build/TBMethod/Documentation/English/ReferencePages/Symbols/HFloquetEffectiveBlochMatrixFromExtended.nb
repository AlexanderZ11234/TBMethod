Cell["\<\
m is a nonnegative photon cutoff, with 2 m + 1 photon states for every \
internal state. The matrix uses internal-major, photon-minor ordering.\
\>", "Notes",
 CellID->146810760,ExpressionUUID->"a1b55006-b602-ec42-adaa-7b7ff5c37550"],

Cell["\<\
Extracts harmonics through order 2 m from the extended matrix. The zero \
harmonic is the central photon diagonal block.\
\>", "Notes",
 CellID->951620562,ExpressionUUID->"59aead66-f6dd-4640-a896-a0704c3f36a7"],

Cell["\<\
Option \"ExpansionOrder\" is 1 by default and accepts 1 or 2. Option \
\"ReturnComponents\" is False by default; True returns an association with \
\"Order0\", \"Order1\", and, at order 2, \"Order2Pure\" and \"Order2Mixed\" \
contributions.\
\>", "Notes",
 CellID->1993371530,ExpressionUUID->"806f00cf-0e89-b246-b8ac-8aa63d5685cc"],

Cell["\<\
The expansion contains denominators omega and omega^2; use nonzero omega. \
This high-frequency approximation requires physical convergence checks for \
the chosen driven model.\
\>", "Notes",
 CellID->1128188997,ExpressionUUID->"e2b8ab22-c0ae-4642-8a85-375e9760e890"],

Cell[TextData[{
 "At first order, the implemented high-frequency expansion is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["H", "eff"], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["H", "0"], "+", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"l", "=", "1"}], 
        SubscriptBox["l", "max"]], 
       FractionBox[
        RowBox[{
         RowBox[{
          SubscriptBox["H", 
           RowBox[{"-", "l"}]], ".", 
          SubscriptBox["H", "l"]}], "-", 
         RowBox[{
          SubscriptBox["H", "l"], ".", 
          SubscriptBox["H", 
           RowBox[{"-", "l"}]]}]}], 
        RowBox[{"l", " ", "\[Omega]"}]]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "cdc62766-8c70-1f4c-8c8a-78a57ee6a59d"]
}], "Notes",
 CellID->138689395,ExpressionUUID->"1cbc6421-f91f-ba4d-a2d8-8f327c117e63"]
}, Closed]],

