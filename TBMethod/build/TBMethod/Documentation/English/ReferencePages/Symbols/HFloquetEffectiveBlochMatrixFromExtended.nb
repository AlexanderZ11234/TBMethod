Cell["\<\
An undriven two-level Hamiltonian is recovered from its three-sector Floquet \
representation.\
\>", "ExampleText",
 CellID->669708465,ExpressionUUID->"b8e340d9-c07c-f443-abd1-e07e90dfd9fa"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1751581152,ExpressionUUID->"80dd824e-1aa0-5247-a3e2-6ed98bc96cd1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"omega", "=", "10."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h0", "=", 
   RowBox[{
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "3", "]"}], ",", 
      RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}], "+", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "0", "]"}], ",", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{
        RowBox[{"-", "omega"}], " ", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "]"}]}], "]"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"HFloquetEffectiveBlochMatrixFromExtended", "[", 
   RowBox[{"omega", ",", "1"}], "]"}], "[", "h0", "]"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->1942003918,ExpressionUUID->"9138a1b5-408b-4c4a-82ee-383f0e930fa6"],

