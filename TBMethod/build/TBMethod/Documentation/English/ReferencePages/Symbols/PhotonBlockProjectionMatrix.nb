Cell[TextData[{
 "Returns the site/internal identity tensored with the single-sector photon \
projector. Its total matrix dimension is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"N", " ", "internalDimension", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", "m"}], "+", "1"}], ")"}]}],
