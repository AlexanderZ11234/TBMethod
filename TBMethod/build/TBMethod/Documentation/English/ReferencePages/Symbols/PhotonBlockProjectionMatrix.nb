 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"N", " ", "internalDimension", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", "m"}], "+", "1"}], ")"}]}],
