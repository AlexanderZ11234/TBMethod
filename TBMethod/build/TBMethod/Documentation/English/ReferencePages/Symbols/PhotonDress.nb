Cell["\<\
The internal degrees of freedom form the outer tensor factor, and photon \
sectors form the inner factor.\
\>", "Notes",
 CellID->839198056,ExpressionUUID->"f0720fa2-c46a-cd43-bc5b-284d8a967959"],

Cell[TextData[{
 "The scalar photon blocks are combined with the internal hopping matrix as",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["H", "dressed"], "\[LongEqual]", 
     RowBox[{
      RowBox[{"t", "\[CircleTimes]", "A"}], "+", 
      RowBox[{"\[DoubleStruckCapitalI]", "\[CircleTimes]", "B"}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "24fe77b7-1927-034b-8e8f-350c18dea238"]
}], "Notes",
 CellID->937116467,ExpressionUUID->"9b817633-df24-ad4c-9285-ff5aad0a96fd"]
}, Closed]],

