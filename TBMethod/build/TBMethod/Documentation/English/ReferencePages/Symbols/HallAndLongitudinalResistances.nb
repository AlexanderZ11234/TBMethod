Cell["\<\
Compute the resistance pair for a small five-contact ring fixture.\
\>", "ExampleText",
 CellID->782591439,ExpressionUUID->"9da2c964-0d0b-3941-974f-ada19f3e8758"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1045856795,ExpressionUUID->"89483def-4c7b-0c47-9f84-ebb1b774c974"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"z", "=", 
   RowBox[{"0.2", "\[VeryThinSpace]", "+", 
    RowBox[{"0.01", " ", "\[ImaginaryI]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hRing", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"i", "-", "j"}], ",", "5"}], "]"}], "\[Equal]", "1"}], ",", 
       
       RowBox[{"-", 
        RowBox[{"Exp", "[", 
         RowBox[{"0.2", " ", "\[ImaginaryI]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"j", "-", "i"}], ",", "5"}], "]"}], "\[Equal]", "1"}], ",", 
       
       RowBox[{"-", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "0.2"}], " ", "\[ImaginaryI]"}], "]"}]}], ",", "True", 
       ",", "0."}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "5"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"blocks", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"hRing", ",", "hRing"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.3"}], " ", 
       RowBox[{"IdentityMatrix", "[", "5", "]"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"leads", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", "0.", "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"-", "1."}], "}"}], "}"}], ",", 
       RowBox[{"List", "/@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "0.5"}], " ", 
          RowBox[{"UnitVector", "[", 
           RowBox[{"5", ",", "j"}], "]"}]}], ")"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "5"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"HallAndLongitudinalResistances", "[", 
  RowBox[{"z", ",", "blocks", ",", "leads", ",", 
   RowBox[{"\"\<SigmaMode\>\"", "\[Rule]", "1"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->856855337,ExpressionUUID->"157b4b0a-554c-1041-9bee-bb623ecc5c45"],

