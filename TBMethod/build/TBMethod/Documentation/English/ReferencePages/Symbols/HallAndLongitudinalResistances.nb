Cell["\<\
Source and drain must be the first and final leads. The source comments \
describe lead order from left to right and from top to bottom for four-, \
five-, and six-terminal layouts.\
\>", "Notes",
 CellID->2092995480,ExpressionUUID->"8e2d748a-b721-6447-80eb-6336d28dcb41"],

Cell[TextData[{
 "All lead self-energies act on the final device layer. ",
 Cell[BoxData[
  RowBox[{"\"\<SigmaMode\>\"", "\[Rule]", "3"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f1279c6f-5f26-8d4b-922f-cdfc0b79eeb8"],
 " selects the algorithm used by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Sigma"]], "paclet:TBMethod/ref/Sigma", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7a2d4589-7702-c043-a311-4817f6c6b945"],
 "."
}], "Notes",
 CellID->1203852458,ExpressionUUID->"f2b70508-ab9f-194d-8f3a-44c12b61ae0d"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<SigmaTransform\>\"", "\[Rule]", 
   TemplateBox[{
     Cell[
      TextData["Identity"]], "paclet:ref/Identity"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a34ee8fb-4a11-9349-803d-76e3be424b39"],
 " leaves the self-energy list unchanged before the Green-function \
calculation. ",
 Cell[BoxData[
  RowBox[{"\"\<GreenTransform\>\"", "\[Rule]", 
   TemplateBox[{
     Cell[
      TextData["Identity"]], "paclet:ref/Identity"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3e3a73af-8734-db46-9e83-3f4a21c8a302"],
 " leaves the final diagonal Green block unchanged before evaluating \
transmissions."
}], "Notes",
 CellID->1473777614,ExpressionUUID->"dfbd7d15-72ee-ce42-b60a-3ad5e5afce67"],

Cell[TextData[{
 "Returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["RH", "TI"], ",", 
