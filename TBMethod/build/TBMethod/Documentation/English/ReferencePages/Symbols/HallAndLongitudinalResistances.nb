Cell["\<\
Source and drain must be the first and final leads. The source comments \
describe lead order from left to right and from top to bottom for four-, \
five-, and six-terminal layouts.\
\>", "Notes",
 CellID->2092995480,ExpressionUUID->"957c12f0-e9e7-3d48-8cde-c4d78d106155"],

Cell[TextData[{
 "All lead self-energies act on the final device layer. ",
 Cell[BoxData[
  RowBox[{"\"\<SigmaMode\>\"", "\[Rule]", "3"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "64d38993-f0e5-ff49-a26c-d3ec246ef7a7"],
 " selects the algorithm used by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Sigma"]], "paclet:TBMethod/ref/Sigma", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d0cd66a8-b96f-ea4d-b0c5-e8e3923d3836"],
 "."
}], "Notes",
 CellID->1203852458,ExpressionUUID->"75b0255f-dabd-4043-93bb-0518ab58abf0"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<SigmaTransform\>\"", "\[Rule]", 
   TemplateBox[{
     Cell[
      TextData["Identity"]], "paclet:ref/Identity"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1311de11-59cd-ea49-859d-405eef0e750f"],
 " leaves the self-energy list unchanged before the Green-function \
calculation. ",
 Cell[BoxData[
  RowBox[{"\"\<GreenTransform\>\"", "\[Rule]", 
   TemplateBox[{
     Cell[
      TextData["Identity"]], "paclet:ref/Identity"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c48f9fc9-e20c-1647-b1d9-131a4d373cfd"],
 " leaves the final diagonal Green block unchanged before evaluating \
transmissions."
}], "Notes",
 CellID->1473777614,ExpressionUUID->"3bfa1637-b7f4-d943-a8b7-918577b8f099"],

Cell[TextData[{
 "Returns ",
