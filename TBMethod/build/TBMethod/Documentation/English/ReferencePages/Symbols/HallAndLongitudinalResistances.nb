Cell["\<\
Compute the resistance pair for a small five-contact ring fixture.\
\>", "ExampleText",
 CellID->304840723,ExpressionUUID->"11caec92-1d56-3a41-b281-0df150719716"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->745634097,ExpressionUUID->"0f9d88a0-a730-a044-984c-6b8130652731"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"z", "=", 
   RowBox[{"0.2`", "\[VeryThinSpace]", "+", 
    RowBox[{"0.01`", " ", "\[ImaginaryI]"}]}]}], ";", 
  RowBox[{"hRing", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"i", "-", "j"}], ",", "5"}], "]"}], "\[Equal]", "1"}], ",", 
       
       RowBox[{"-", 
        RowBox[{"Exp", "[", 
         RowBox[{"0.2`", " ", "\[ImaginaryI]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"j", "-", "i"}], ",", "5"}], "]"}], "\[Equal]", "1"}], ",", 
       
       RowBox[{"-", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "0.2`"}], " ", "\[ImaginaryI]"}], "]"}]}], ",", "True",
        ",", "0.`"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "5"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"blocks", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"hRing", ",", "hRing"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.3`"}], " ", 
       RowBox[{"IdentityMatrix", "[", "5", "]"}]}], "}"}]}], "}"}]}], ";", 
  RowBox[{"leads", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", "0.`", "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"-", "1.`"}], "}"}], "}"}], ",", 
       RowBox[{"List", "/@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "0.5`"}], " ", 
          RowBox[{"UnitVector", "[", 
           RowBox[{"5", ",", "j"}], "]"}]}], ")"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "5"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"result", "=", 
   RowBox[{"HallAndLongitudinalResistances", "[", 
    RowBox[{"z", ",", "blocks", ",", "leads", ",", 
     RowBox[{"\"\<SigmaMode\>\"", "\[Rule]", "1"}]}], "]"}]}], ";", 
  "result"}]], "Input",
