Cell["\<\
Source and drain must be the first and final leads. The source comments \
describe lead order from left to right and from top to bottom for four-, \
five-, and six-terminal layouts.\
\>", "Notes",
 CellID->891131706,ExpressionUUID->"f7dff91f-26f2-e64c-9b71-0dd66f4448ae"],

Cell[TextData[{
 "All lead self-energies act on the final device layer. ",
 Cell[BoxData[
  RowBox[{"\"\<SigmaMode\>\"", "\[Rule]", "3"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5b7ff0ce-696e-7b4e-a0ef-f4454ff3e1d7"],
 " selects the algorithm used by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Sigma"]], "paclet:TBMethod/ref/Sigma", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9a756ded-12c3-cb4e-aeb3-44bd45b3ca11"],
 "."
}], "Notes",
 CellID->1212335317,ExpressionUUID->"1b511e2d-ae74-4944-b7f7-f785086da11c"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<SigmaTransform\>\"", "\[Rule]", 
   TemplateBox[{
     Cell[
      TextData["Identity"]], "paclet:ref/Identity"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c6e20bb2-7393-dc4b-92a4-996e3ef75301"],
 " leaves the self-energy list unchanged before the Green-function \
calculation. ",
 Cell[BoxData[
  RowBox[{"\"\<GreenTransform\>\"", "\[Rule]", 
   TemplateBox[{
     Cell[
      TextData["Identity"]], "paclet:ref/Identity"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e7aa477f-cb2f-af4a-986c-dfd0f172c086"],
 " leaves the final diagonal Green block unchanged before evaluating \
transmissions."
}], "Notes",
 CellID->515241492,ExpressionUUID->"4bb92c92-7759-4348-860f-f5ceee64b9ff"],

Cell[TextData[{
 "Returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["RH", "TI"], ",", 
    StyleBox["RL", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "166b65af-40a5-d144-8124-3d0b37ebddaa"],
