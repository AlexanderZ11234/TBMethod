Cell["\<\
Compute the resistance pair for a small five-contact ring fixture.\
\>", "ExampleText",
 CellID->1826465409,ExpressionUUID->"fea5788e-f4e0-2645-a59b-1cd3f1cc0d17"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->379459468,ExpressionUUID->"70a4352f-4f15-6149-8b78-256d6bf88753"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"z", "=", 
   RowBox[{"0.2", "\[VeryThinSpace]", "+", 
    RowBox[{"0.01", " ", "\[ImaginaryI]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hRing", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"i", "-", "j"}], ",", "5"}], "]"}], "\[Equal]", "1"}], ",", 
       
       RowBox[{"-", 
        RowBox[{"Exp", "[", 
         RowBox[{"0.2", " ", "\[ImaginaryI]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"j", "-", "i"}], ",", "5"}], "]"}], "\[Equal]", "1"}], ",", 
       
       RowBox[{"-", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "0.2"}], " ", "\[ImaginaryI]"}], "]"}]}], ",", "True", 
       ",", "0."}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "5"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"blocks", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"hRing", ",", "hRing"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.3"}], " ", 
       RowBox[{"IdentityMatrix", "[", "5", "]"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"leads", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", "0.", "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"-", "1."}], "}"}], "}"}], ",", 
       RowBox[{"List", "/@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "0.5"}], " ", 
          RowBox[{"UnitVector", "[", 
           RowBox[{"5", ",", "j"}], "]"}]}], ")"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "5"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"HallAndLongitudinalResistances", "[", 
  RowBox[{"z", ",", "blocks", ",", "leads", ",", 
   RowBox[{"\"\<SigmaMode\>\"", "\[Rule]", "1"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->1222455705,ExpressionUUID->"c4150374-74ff-8f4e-a297-3a28acd949aa"],

