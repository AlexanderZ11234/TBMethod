Cell[TextData[{
 "The scalar-field form embeds the planar endpoints at ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"z", "\[LongEqual]", "0"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "381fc24f-9401-c94e-82f6-379991ac9695"],
 " and places the field along the third direction."
}], "Notes",
 CellID->672588424,ExpressionUUID->"cd42527d-69ef-d243-ba0a-eaeff28c734e"],

Cell["\<\
Inputs must already use mutually consistent charge, flux, and length units. \
No physical constants are inserted.\
\>", "Notes",
 CellID->635828166,ExpressionUUID->"81161d82-5949-6e41-8131-bb8cfc858b39"],

Cell[TextData[{
 "The three-dimensional symmetric-gauge phase convention is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{
       SubscriptBox["r", "f"], ",", 
       SubscriptBox["r", "i"]}], ")"}], "\[LongEqual]", 
     RowBox[{"exp", "(", 
      RowBox[{"\[ImaginaryI]", " ", "\[Pi]", " ", 
       TemplateBox[{
         RowBox[{"{", 
           RowBox[{
             SubscriptBox["r", "f"], ",", "B", ",", 
             SubscriptBox["r", "i"]}], "}"}]},
        "Det"]}], ")"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "03244581-ad08-9543-801d-dbffa6fa219b"]
}], "Notes",
 CellID->589727258,ExpressionUUID->"ee5211f2-523f-1e44-8ed3-5e0ee22e1a16"]
}, Closed]],

