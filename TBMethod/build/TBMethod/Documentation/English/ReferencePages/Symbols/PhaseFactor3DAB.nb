  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "14ce7365-f7f6-df44-a517-dc1e32a8b68d"],
 " and places the field along the third direction."
}], "Notes",
 CellID->1416584646,ExpressionUUID->"3d5095e8-2c8b-474c-9334-6ae82262934d"],

Cell["\<\
Inputs must already use mutually consistent charge, flux, and length units. \
No physical constants are inserted.\
\>", "Notes",
 CellID->1585987631,ExpressionUUID->"b8dc3cba-7736-9a4e-a8ea-84459ef5dc9a"],

Cell[TextData[{
 "The three-dimensional symmetric-gauge phase convention is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{
       SubscriptBox["r", "f"], ",", 
       SubscriptBox["r", "i"]}], ")"}], "\[LongEqual]", 
     RowBox[{"exp", "(", 
      RowBox[{"\[ImaginaryI]", " ", "\[Pi]", " ", 
       TemplateBox[{
         RowBox[{"{", 
           RowBox[{
             SubscriptBox["r", "f"], ",", "B", ",", 
             SubscriptBox["r", "i"]}], "}"}]},
        "Det"]}], ")"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "ac1e28c4-c470-e145-8aff-563e3956939f"]
}], "Notes",
 CellID->1548846963,ExpressionUUID->"edf943d9-879d-9e4c-8fda-87d40b18a75a"]
}, Closed]],

