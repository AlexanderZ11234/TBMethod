Cell["\<\
Inputs must already use mutually consistent charge, flux, and length units. \
No physical constants are inserted.\
\>", "Notes",
 CellID->2016118995,ExpressionUUID->"e73ff589-0ae7-3846-a48b-8a0ca7fc57f2"],

Cell[TextData[{
 "The three-dimensional symmetric-gauge phase convention is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{
       SubscriptBox["r", "f"], ",", 
       SubscriptBox["r", "i"]}], ")"}], "\[LongEqual]", 
     RowBox[{"exp", "(", 
      RowBox[{"\[ImaginaryI]", " ", "\[Pi]", " ", 
       TemplateBox[{
         RowBox[{"{", 
           RowBox[{
             SubscriptBox["r", "f"], ",", "B", ",", 
             SubscriptBox["r", "i"]}], "}"}]},
        "Det"]}], ")"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "f955a6c5-4596-ec4d-9492-b326c3c60bfb"]
}], "Notes",
 CellID->305098780,ExpressionUUID->"a677993d-5cca-0743-8434-42680ac25166"]
}, Closed]],

