Cell["\<\
Inputs must already use mutually consistent charge, flux, and length units. \
No physical constants are inserted.\
\>", "Notes",
 CellID->1323542822,ExpressionUUID->"6bd4af97-e6dd-0a4a-a8a0-21d1d3ad274d"],

Cell[TextData[{
 "The three-dimensional symmetric-gauge phase convention is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{
       SubscriptBox["r", "f"], ",", 
       SubscriptBox["r", "i"]}], ")"}], "\[LongEqual]", 
     RowBox[{"exp", "(", 
      RowBox[{"\[ImaginaryI]", " ", "\[Pi]", " ", 
       TemplateBox[{
         RowBox[{"{", 
           RowBox[{
             SubscriptBox["r", "f"], ",", "B", ",", 
             SubscriptBox["r", "i"]}], "}"}]},
        "Det"]}], ")"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "ad0cc1fc-6220-a441-955d-360814268a1f"]
}], "Notes",
 CellID->1245573788,ExpressionUUID->"09b05a1a-0614-f540-8868-c68ea228485f"]
}, Closed]],

