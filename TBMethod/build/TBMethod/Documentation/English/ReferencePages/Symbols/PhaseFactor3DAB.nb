Cell[TextData[{
 "The scalar-field form embeds the planar endpoints at ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"z", "\[LongEqual]", "0"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "72544410-1599-c442-b779-f27b1e866da6"],
 " and places the field along the third direction."
}], "Notes",
 CellID->540802353,ExpressionUUID->"afab4ebe-9898-734a-9b10-5cee82e49104"],

Cell[TextData[{
 "The implemented sign convention is for electron charge ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"q", "\[LongEqual]", 
     RowBox[{"-", "e"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "62ec038f-4d78-0a4e-b33e-1bf5cc7b69a3"],
 ", with ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"e", ">", "0"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "bcef1839-e54b-0143-bed6-3cbe899e2e60"],
 ". The determinant in the formula below has the final endpoint, field \
vector, and initial endpoint as its rows, in that order."
}], "Notes",
 CellID->123325016,ExpressionUUID->"196a03b7-8433-ac44-bdb0-eadc7ba490a8"],

Cell["\<\
Inputs must already use mutually consistent charge, flux, and length units. \
No additional physical constants are inserted.\
\>", "Notes",
 CellID->1061714274,ExpressionUUID->"1c096f1c-bc11-7f4f-a3fc-260391c86ed3"],

Cell[TextData[{
 "For a real magnetic field and real endpoints, reversing the endpoint order \
or reversing the field gives the complex-conjugate phase. Zero field or \
coincident endpoints give ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "800ebd63-b096-f148-ac02-59137992fba1"],
 "."
}], "Notes",
 CellID->1783113998,ExpressionUUID->"f98db720-2763-5841-b8f5-f9d64f636128"],

Cell[TextData[{
 "The symmetric-gauge phase uses the electron sign convention. Here ",
 Cell[BoxData[
  FormBox[
   TagBox[
    SubscriptBox[
     StyleBox["r",
      StripOnInput->False,
      FontWeight->"Bold",
      FontSlant->"Italic"], 
     StyleBox["f",
      StripOnInput->False,
      FontSlant->"Plain"]],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "36e1e5ab-58c0-ee43-a09b-cad1db257a09"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    SubscriptBox[
     StyleBox["r",
      StripOnInput->False,
      FontWeight->"Bold",
      FontSlant->"Italic"], 
     StyleBox["i",
      StripOnInput->False,
      FontSlant->"Plain"]],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "f4bd59a6-fdd2-3d4f-bc1f-ad74b9bab734"],
 " are the final and initial position vectors, and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    StyleBox["B",
     StripOnInput->False,
     FontWeight->"Bold",
     FontSlant->"Italic"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "5be52b5f-5dce-5b43-be0b-08be69527c4a"],
 " is the magnetic-field vector:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{
       SubscriptBox[
        StyleBox["r",
         StripOnInput->False,
         FontWeight->"Bold",
         FontSlant->"Italic"], 
        StyleBox["f",
         StripOnInput->False,
         FontSlant->"Plain"]], ",", 
       SubscriptBox[
        StyleBox["r",
         StripOnInput->False,
         FontWeight->"Bold",
         FontSlant->"Italic"], 
        StyleBox["i",
         StripOnInput->False,
         FontSlant->"Plain"]]}], ")"}], "\[LongEqual]", 
     RowBox[{"exp", "(", 
      RowBox[{
       RowBox[{"-", 
        StyleBox["\[ImaginaryI]",
         StripOnInput->False,
         FontSlant->"Plain"]}], " ", 
       StyleBox["\[Pi]",
        StripOnInput->False,
        FontSlant->"Plain"], " ", 
       TemplateBox[{
         RowBox[{"{", 
           RowBox[{
             SubscriptBox[
              StyleBox[
              "r", FontWeight -> "Bold", FontSlant -> "Italic", StripOnInput -> 
               False], 
              StyleBox["f", FontSlant -> "Plain", StripOnInput -> False]], 
             ",", 
             StyleBox[
             "B", FontWeight -> "Bold", FontSlant -> "Italic", StripOnInput -> 
              False], ",", 
             SubscriptBox[
              StyleBox[
              "r", FontWeight -> "Bold", FontSlant -> "Italic", StripOnInput -> 
               False], 
              StyleBox["i", FontSlant -> "Plain", StripOnInput -> False]]}], 
           "}"}]},
        "Det"]}], ")"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "794b75b6-b830-ef47-bf7e-76973f2d232e"]
}], "Notes",
 CellID->1317230952,ExpressionUUID->"e02b22e2-c989-c346-a8a4-be19d76dc7a8"]
}, Closed]],

