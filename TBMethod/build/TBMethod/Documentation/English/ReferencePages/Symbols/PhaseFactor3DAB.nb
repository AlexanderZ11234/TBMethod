Cell["\<\
The three-dimensional implementation is Exp[I Pi Det[{rf, B, ri}]]. The \
scalar-field form embeds two-dimensional points in the plane z=0.\
\>", "Notes",
 CellID->553152780,ExpressionUUID->"d0bad29c-5168-d94f-8697-c8ed2b45e977"],

Cell["\<\
Inputs must already use consistent charge, flux, and length units; no \
physical constants are inserted.\
\>", "Notes",
 CellID->1690736049,ExpressionUUID->"70b18543-dea9-c04d-939a-f14b034a99a6"]
}, Closed]],

