Cell[TextData[{
 Cell[BoxData[
  RowBox[{"h", "[", "k", "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5685e911-885c-0042-a0c3-21574a854af3"],
 " returns a Hermitian Hamiltonian. The positive integer ",
 Cell[BoxData[
  StyleBox["nOccupied", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3a7d26e9-9f6f-0042-9eba-6daffa037325"],
 " selects its lowest-energy eigenstates after sorting."
}], "Notes",
 CellID->733972563,ExpressionUUID->"dd3e3241-e94f-af4b-8d6f-dbfae6ed848f"],

