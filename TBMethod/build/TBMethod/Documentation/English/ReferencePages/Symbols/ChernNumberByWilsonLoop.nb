Cell[TextData[{
 Cell[BoxData[
  RowBox[{"h", "[", "k", "]"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"470bd4de-fb8e-ed49-86ca-dc2f1752ae1c"],
 " returns a Hermitian Hamiltonian. The positive integer ",
 Cell[BoxData[
  StyleBox["nOccupied", "TI",
   FontFamily->"Times",
