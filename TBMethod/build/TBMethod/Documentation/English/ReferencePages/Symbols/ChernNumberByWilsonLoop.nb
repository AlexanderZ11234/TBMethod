Cell["\<\
Each plaquette loop is closed internally. Its orientation affects the \
determinant phase and the sign of the returned sum.\
\>", "Notes",
 CellID->880698794,ExpressionUUID->"b321b491-936d-d24d-8db2-56919565710e"],

Cell["\<\
A meaningful Chern estimate requires a consistent oriented covering of the \
relevant closed momentum space and a separated occupied subspace. The \
function does not validate orientation, convergence, or integrality.\
\>", "Notes",
 CellID->1088494747,ExpressionUUID->"6d219445-902e-4244-9a90-8094173ca3f5"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigensystem"]], "paclet:ref/Eigensystem"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "428d7944-fbcf-7540-8c20-78b480fa2a31"],
 " options are accepted, with ",
 Cell[BoxData[
  RowBox[{"Method", "\[Rule]", "\"\<Direct\>\""}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c4aa523b-8a83-254f-a2b5-310e0409e72c"],
 " supplied internally."
}], "Notes",
 CellID->995003794,ExpressionUUID->"7919a485-f4de-9543-a00a-38cde8cf0ec7"],

Cell[TextData[{
 "For each oriented plaquette, let W denote the ordered product of \
occupied-state overlap matrices. The returned sum is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"C", "\[LongEqual]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"p", "=", "1"}], 
         SubscriptBox["N", "P"]], 
        RowBox[{"arg", "(", 
         TemplateBox[{
           SubscriptBox["W", "p"]},
          "Det"], ")"}]}], 
       RowBox[{"2", " ", "\[Pi]"}]]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "8ac0d508-c6ad-1d4a-97d6-2eb2b4f7e067"]
}], "Notes",
 CellID->1208097135,ExpressionUUID->"bd0c48b7-c885-c244-9046-52dec9959ffb"]
}, Closed]],

