  StyleBox["nOccupied", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "79713e8d-4070-4d40-95db-4b9f0df4d89f"],
 " selects its lowest-energy eigenstates after sorting."
}], "Notes",
 CellID->1918164110,ExpressionUUID->"76df0545-f0e1-fd45-8e62-47242f74c37d"],

