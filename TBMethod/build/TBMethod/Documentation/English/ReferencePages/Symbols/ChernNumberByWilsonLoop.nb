Cell["\<\
Each plaquette loop is closed internally. Its orientation affects the \
determinant phase and the sign of the returned sum.\
\>", "Notes",
 CellID->278918765,ExpressionUUID->"cca097bb-5c01-0942-83bb-4c9bdc8046ce"],

Cell["\<\
A meaningful Chern estimate requires a consistent oriented covering of the \
relevant closed momentum space and a separated occupied subspace. The \
function does not validate orientation, convergence, or integrality.\
\>", "Notes",
 CellID->316578328,ExpressionUUID->"a8d184e0-7f58-f148-8519-662af28fbc86"],

Cell[TextData[{
 "Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigensystem"]], "paclet:ref/Eigensystem"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e294c9a9-5320-7548-8daa-af71f0c0500e"],
 " are accepted, with ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Method"]], "paclet:ref/Method"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", "\"\<Direct\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2d767e86-ded7-bf44-a834-b05675e1a8c7"],
 " supplied internally."
}], "Notes",
 CellID->1217641808,ExpressionUUID->"a10a7e79-dacc-d041-b9fb-72025c4c2121"],

Cell[TextData[{
 "For each oriented plaquette, let ",
 Cell[BoxData[
  FormBox[
   TagBox["W",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "97bad515-b703-1c45-95a4-be42642daa77"],
 " denote the ordered product of occupied-state overlap matrices. The \
returned sum is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"C", "\[LongEqual]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"p", "=", "1"}], 
         SubscriptBox["N", "P"]], 
        RowBox[{"arg", "(", 
         TemplateBox[{
           SubscriptBox["W", "p"]},
          "Det"], ")"}]}], 
       RowBox[{"2", " ", "\[Pi]"}]]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "080d6355-0bbc-7b4d-9efe-7ab95ab2e3d6"]
}], "Notes",
 CellID->1907194148,ExpressionUUID->"ceb6f2a3-a8b5-c64e-a35f-e86fa6eae41a"]
}, Closed]],

