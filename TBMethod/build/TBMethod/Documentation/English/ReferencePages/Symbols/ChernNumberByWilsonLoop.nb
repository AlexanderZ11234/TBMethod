Cell["\<\
Each plaquette loop is closed internally. Its orientation affects the \
determinant phase and the sign of the returned sum.\
\>", "Notes",
 CellID->277435572,ExpressionUUID->"8f3cfdcd-3b21-7a49-9a15-58844bc1ca15"],

Cell["\<\
A meaningful Chern estimate requires a consistent oriented covering of the \
relevant closed momentum space and a separated occupied subspace. The \
function does not validate orientation, convergence, or integrality.\
\>", "Notes",
 CellID->1233611759,ExpressionUUID->"2a90338d-e1b5-0a46-9b69-fc5cb5199dc1"],

Cell[TextData[{
 "Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigensystem"]], "paclet:ref/Eigensystem"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "323022f6-a7e9-bd47-9abd-9d1ba81aefd7"],
 " are accepted, with ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Method"]], "paclet:ref/Method"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", "\"\<Direct\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "158b990b-9e33-ee44-befa-eb8cd0929ca7"],
 " supplied internally."
}], "Notes",
 CellID->859100748,ExpressionUUID->"b6bc301d-f5c6-de47-9161-09825cfbf387"],

Cell[TextData[{
 "For each oriented plaquette, let ",
 Cell[BoxData[
  FormBox[
   TagBox["W",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "08be1d68-a55f-2b46-9a02-9dee3da395c8"],
 " denote the ordered product of occupied-state overlap matrices. The \
returned sum is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"C", "\[LongEqual]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"p", "=", "1"}], 
         SubscriptBox["N", "P"]], 
        RowBox[{"arg", "(", 
         TemplateBox[{
           SubscriptBox["W", "p"]},
          "Det"], ")"}]}], 
       RowBox[{"2", " ", "\[Pi]"}]]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "8121d5fa-24fa-d140-a14b-31c9d191bb2d"]
}], "Notes",
 CellID->514161825,ExpressionUUID->"f6521ea4-7565-3342-9148-6c1a020ff53d"]
}, Closed]],

