Cell["\<\
Each plaquette loop is closed internally. Its orientation affects the \
determinant phase and the sign of the returned sum.\
\>", "Notes",
 CellID->277435572,ExpressionUUID->"f58f2b66-741d-3347-8054-2ff5f38036c8"],

Cell["\<\
A meaningful Chern estimate requires a consistent oriented covering of the \
relevant closed momentum space and a separated occupied subspace. The \
function does not validate orientation, convergence, or integrality.\
\>", "Notes",
 CellID->1233611759,ExpressionUUID->"39144342-245b-cd42-a435-ba019dd3fa14"],

Cell[TextData[{
 "Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigensystem"]], "paclet:ref/Eigensystem"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bfbd7dd9-9412-874b-b6d7-34264280d797"],
 " are accepted, with ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Method"]], "paclet:ref/Method"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", "\"\<Direct\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2dc77245-0dae-bb47-8fb8-389cea06b354"],
 " supplied internally."
}], "Notes",
 CellID->859100748,ExpressionUUID->"e302c835-1855-5f46-9b25-13be1d382a22"],

Cell[TextData[{
 "For each oriented plaquette, let ",
 Cell[BoxData[
  FormBox[
   TagBox["W",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "72b621ad-c43a-5340-90aa-45da268dfb50"],
 " denote the ordered product of occupied-state overlap matrices. The \
returned sum is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"C", "\[LongEqual]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"p", "=", "1"}], 
         SubscriptBox["N", "P"]], 
        RowBox[{"arg", "(", 
         TemplateBox[{
           SubscriptBox["W", "p"]},
          "Det"], ")"}]}], 
       RowBox[{"2", " ", "\[Pi]"}]]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "0196793b-3994-e749-b5c1-6433d50868aa"]
}], "Notes",
 CellID->514161825,ExpressionUUID->"7c6b087a-1574-6740-8442-20afe12abc6c"]
}, Closed]],

