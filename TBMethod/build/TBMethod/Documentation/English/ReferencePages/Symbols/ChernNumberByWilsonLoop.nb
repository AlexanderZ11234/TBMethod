Cell["\<\
Each plaquette loop is closed internally. Its orientation affects the \
determinant phase and the sign of the returned sum.\
\>", "Notes",
 CellID->1232483864,ExpressionUUID->"643fb9ce-1b15-5d4b-a7b1-06f9c96beeb2"],

Cell["\<\
A meaningful Chern estimate requires a consistent oriented covering of the \
relevant closed momentum space and a separated occupied subspace. The \
function does not validate orientation, convergence, or integrality.\
\>", "Notes",
 CellID->690192510,ExpressionUUID->"42777283-8f80-df48-ab9b-04c008c7ea80"],

Cell[TextData[{
 "Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigensystem"]], "paclet:ref/Eigensystem"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "98874c44-b19e-0b42-806f-9635199dfa98"],
 " are accepted, with ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Direct\>\""}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"bf904d04-301b-134a-b429-ac1d5cacbc93"],
 " supplied internally."
}], "Notes",
 CellID->1377263459,ExpressionUUID->"a0dde151-aac9-e346-9a9f-8e5e0b735bfa"],

Cell[TextData[{
 "For each oriented plaquette, let ",
 Cell[BoxData[
  FormBox[
   TagBox["W",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "4b25c6c9-bd23-c540-8573-c728a295c53a"],
 " denote the ordered product of occupied-state overlap matrices. The \
returned sum is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"C", "\[LongEqual]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"p", "=", "1"}], 
         SubscriptBox["N", "P"]], 
        RowBox[{"arg", "(", 
         TemplateBox[{
           SubscriptBox["W", "p"]},
          "Det"], ")"}]}], 
       RowBox[{"2", " ", "\[Pi]"}]]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "964b2237-7eb4-364c-b113-1b17505a5bf9"]
}], "Notes",
 CellID->1174964564,ExpressionUUID->"7434b4e4-38f5-1845-94bc-a21d62b6cbfe"]
}, Closed]],

