Cell["\<\
No inverse-hbar factor is inserted. These are momentum derivatives without an \
independently supplied physical-unit conversion.\
\>", "Notes",
 CellID->449779791,ExpressionUUID->"250f008f-ed2e-4a41-8db4-9ddc19bc7311"],

Cell["\<\
The first association entry is onsite. Remaining entries represent one \
orientation of each hopping pair, and their Hermitian conjugates are added.\
\>", "Notes",
 CellID->1791390934,ExpressionUUID->"448d3d20-ca16-6c4f-994e-5993fc393fd9"],

Cell[TextData[{
 "Association values must be ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SparseArray"]], "paclet:ref/SparseArray"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "14ce520d-d083-3a49-8c52-4f36e386b98a"],
 " matrices."
}], "Notes",
 CellID->2014843754,ExpressionUUID->"ba9f3626-49d3-0748-8951-0de69d9afc14"],

Cell[TextData[{
 "The returned derivative matrices use momentum derivatives without an \
additional inverse-hbar factor:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["V", "\[Alpha]"], "(", "k", ")"}], "\[LongEqual]", 
     FractionBox[
      RowBox[{"\[PartialD]", 
       RowBox[{"H", "(", "k", ")"}]}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["k", "\[Alpha]"]}],
      MultilineFunction->None]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "4bf25ca9-5a74-7a40-b1cd-1b6c8ec79929"]
}], "Notes",
 CellID->898554050,ExpressionUUID->"293e3011-7f88-544c-b40b-5f5af1e79722"]
}, Closed]],

