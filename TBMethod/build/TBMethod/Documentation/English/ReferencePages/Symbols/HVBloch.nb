Cell["\<\
The first association entry is onsite. Remaining entries represent one \
orientation of each hopping pair, and their Hermitian conjugates are added.\
\>", "Notes",
 CellID->739601124,ExpressionUUID->"c04041b0-2be5-694d-916a-c3574805ca9c"],

Cell[TextData[{
 "Association values must be ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SparseArray"]], "paclet:ref/SparseArray"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fc0d597f-4676-aa44-94e2-f323ef7503a9"],
 " matrices."
}], "Notes",
 CellID->335932594,ExpressionUUID->"3cb9955f-4c70-6049-b7c0-fc4289558e2e"],

Cell[TextData[{
 "The returned derivative matrices use momentum derivatives without an \
additional ",
 Cell[BoxData[
  FormBox[
   TagBox[
    FractionBox["1", "\[HBar]"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "0086c6d5-b74c-c34a-86b9-f6010f67101c"],
 " factor:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["V", "\[Alpha]"], "(", "k", ")"}], "\[LongEqual]", 
     FractionBox[
      RowBox[{"\[PartialD]", 
       RowBox[{"H", "(", "k", ")"}]}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["k", "\[Alpha]"]}],
      MultilineFunction->None]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "de783cb8-ed77-384f-8d71-95162f3857b8"]
}], "Notes",
 CellID->128178691,ExpressionUUID->"90f2cfa8-da3d-5041-871d-8a2b3ee5bb5b"]
}, Closed]],

