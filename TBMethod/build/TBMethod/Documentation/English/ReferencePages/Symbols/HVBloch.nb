Cell["\<\
The first association entry is onsite. Remaining entries represent one \
orientation of each hopping pair, and their Hermitian conjugates are added.\
\>", "Notes",
 CellID->479762790,ExpressionUUID->"347d4df2-2d0b-a14e-838e-94d4c3f60431"],

Cell[TextData[{
 "Association values must be ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SparseArray"]], "paclet:ref/SparseArray"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1ee4bc47-394f-b34a-b008-f2373827472e"],
 " matrices."
}], "Notes",
 CellID->1757513221,ExpressionUUID->"5b2add99-0f81-cd4b-ba75-e2997cdb2bf7"],

Cell[TextData[{
 "The returned derivative matrices use momentum derivatives without an \
additional ",
 Cell[BoxData[
  FormBox[
   TagBox[
    FractionBox["1", "\[HBar]"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "799999da-8438-ff48-97d0-8dea44ad532b"],
 " factor:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["V", "\[Alpha]"], "(", "k", ")"}], "\[LongEqual]", 
     FractionBox[
      RowBox[{"\[PartialD]", 
       RowBox[{"H", "(", "k", ")"}]}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["k", "\[Alpha]"]}],
      MultilineFunction->None]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "579a0540-6e01-6a45-bcf4-8d19f39e7873"]
}], "Notes",
 CellID->1975633825,ExpressionUUID->"141d430e-ade0-2b47-81ff-b09b7a3ad36c"]
}, Closed]],

