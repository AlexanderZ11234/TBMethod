Cell["\<\
The first association entry is onsite. Remaining entries represent one \
orientation of each hopping pair, and their Hermitian conjugates are added.\
\>", "Notes",
 CellID->108876164,ExpressionUUID->"f6f94207-1c5f-c645-a779-072906986254"],

Cell[TextData[{
 "Association values must be ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SparseArray"]], "paclet:ref/SparseArray"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d1e051ed-9cec-7d4f-af02-54a44e91c590"],
 " matrices."
}], "Notes",
 CellID->1389519263,ExpressionUUID->"7e8884d0-6053-3f49-b549-85b544dd0453"],

Cell[TextData[{
 "The returned derivative matrices use momentum derivatives without an \
additional ",
 Cell[BoxData[
  FormBox[
   TagBox[
    FractionBox["1", "\[HBar]"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "21c000f6-67c1-3040-ae45-e24cb8724df5"],
 " factor:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["V", "\[Alpha]"], "(", "k", ")"}], "\[LongEqual]", 
     FractionBox[
      RowBox[{"\[PartialD]", 
       RowBox[{"H", "(", "k", ")"}]}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["k", "\[Alpha]"]}],
      MultilineFunction->None]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "9e8f02b4-c0d8-0848-bbec-00be75ff4259"]
}], "Notes",
 CellID->947394827,ExpressionUUID->"73a2f75d-5319-9a4e-a6ed-a41afcf877a5"]
}, Closed]],

