Cell["\<\
The first association entry is onsite. Remaining entries represent one \
orientation of each hopping pair, and their Hermitian conjugates are added.\
\>", "Notes",
 CellID->479762790,ExpressionUUID->"19be2d32-44f5-2640-a0bb-f71a8a74ad03"],

Cell[TextData[{
 "Association values must be ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SparseArray"]], "paclet:ref/SparseArray"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c4a64aa4-2f8b-634e-a8fe-6dd25d55ae40"],
 " matrices."
}], "Notes",
 CellID->1757513221,ExpressionUUID->"4de4ff09-69b3-c14e-8226-be84fe930eae"],

Cell[TextData[{
 "The returned derivative matrices use momentum derivatives without an \
additional ",
 Cell[BoxData[
  FormBox[
   TagBox[
    FractionBox["1", "\[HBar]"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "de7d2972-74ac-9441-9cb9-fcd4d37dfd00"],
 " factor:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["V", "\[Alpha]"], "(", "k", ")"}], "\[LongEqual]", 
     FractionBox[
      RowBox[{"\[PartialD]", 
       RowBox[{"H", "(", "k", ")"}]}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["k", "\[Alpha]"]}],
      MultilineFunction->None]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "d70767d9-b05a-3e43-8cd5-7f6eeebcd62d"]
}], "Notes",
 CellID->1975633825,ExpressionUUID->"45dcec65-a9b0-1e49-9a94-1bcbca2fe05d"]
}, Closed]],

