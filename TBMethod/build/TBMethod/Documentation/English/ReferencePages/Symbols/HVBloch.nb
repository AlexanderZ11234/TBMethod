Cell["\<\
Returns {H, V}, with V[[a]] equal to the derivative of H with respect to \
k[[a]]. No factor of 1/hbar is inserted.\
\>", "Notes",
 CellID->1692912473,ExpressionUUID->"e687c050-1f46-4041-9716-ffc8c6a5e18b"],

Cell["Uses Exp[-I r.k] and derivatives -I r[[a]] Exp[-I r.k].", "Notes",
 CellID->1095670397,ExpressionUUID->"d7fd33f0-e36f-7b40-85eb-c8259da47c90"],

Cell["\<\
The first association entry is onsite. Remaining entries represent one half \
of the hoppings; their Hermitian conjugates are added. Values must be \
SparseArray matrices.\
\>", "Notes",
 CellID->1364568293,ExpressionUUID->"f77c7c91-4c1c-514e-82c6-94710dde82b7"]
}, Closed]],

