 RowBox[{
  RowBox[{"layers", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"1", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"0.", ",", "0."}], "}"}], "}"}]}], ",", 
     RowBox[{"2", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
