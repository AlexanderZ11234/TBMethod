Cell[BoxData[
 RowBox[{
  RowBox[{"z", "=", 
   RowBox[{"0.2`", "\[VeryThinSpace]", "+", 
    RowBox[{"0.1`", " ", "\[ImaginaryI]"}]}]}], ";", 
  RowBox[{"diag", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", "0.`", "}"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"{", "0.`", "}"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"{", "0.`", "}"}], "}"}]}], "}"}]}], ";", 
  RowBox[{"lower", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"-", "0.5`"}], "}"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"-", "0.5`"}], "}"}], "}"}]}], "}"}]}], ";", 
  RowBox[{"sigmas", "=", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.1`"}], " ", "\[ImaginaryI]"}], "}"}], "}"}], "}"}]}], ";", 
  RowBox[{"points", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"1", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"0.`", ",", "0.`"}], "}"}], "}"}]}], ",", 
     RowBox[{"2", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1.`", ",", "0.`"}], "}"}], "}"}]}], ",", 
     RowBox[{"3", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"2.`", ",", "0.`"}], "}"}], "}"}]}]}], "]"}]}], ";", 
  RowBox[{"gs", "=", 
   RowBox[{"CentralBlockGreens", "[", 
    RowBox[{"z", ",", 
     RowBox[{"{", 
      RowBox[{"diag", ",", "lower"}], "}"}], ",", "sigmas", 
     ",", "\"\<LCDV\>\""}], "]"}]}], ";", 
  RowBox[{"result", "=", 
   RowBox[{
    RowBox[{"LocalCDV", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", "1.`", "}"}], "}"}], ",", "points"}], "]"}], "[", 
    RowBox[{"gs", ",", "sigmas", ",", 
     RowBox[{"{", 
      RowBox[{"diag", ",", "lower"}], "}"}]}], "]"}]}], ";", 
  "result"}]], "Input",
