Cell[TextData[{
 "Uses the reverse-ordered final Green column from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CentralBlockGreens"]], 
    "paclet:TBMethod/ref/CentralBlockGreens", "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3f0d54d1-3e8b-1d49-991a-27c0a44c7319"],
 " in ",
 Cell[BoxData["\"\<LCDV\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6cabddf4-c9c6-7c41-8e08-fe52ededf883"],
 " mode. The point ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1a2ae6ef-4ba7-0048-af0f-b6970be919ed"],
 " and Hamiltonian blocks use original layer order."
}], "Notes",
 CellID->1774257041,ExpressionUUID->"a86f0bce-7027-824d-b92a-bdc91191f54c"],

Cell["\<\
Returns coordinate\[Dash]vector pairs. Sites with no stored current entries \
may be absent.\
\>", "Notes",
 CellID->652336002,ExpressionUUID->"40118d2c-4826-5a4d-9f5f-9d92457a83af"],

Cell[TextData[{
 "The internal projection must match the degrees of freedom per site. The \
normalization contains a factor of ",
 Cell[BoxData[
  FractionBox["1", "\[Pi]"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "19c0c6c3-f521-654c-9f86-b687510f83a5"],
 "; no explicit charge or hbar factor is inserted."
}], "Notes",
 CellID->1705761465,ExpressionUUID->"fc3f3bc5-edcf-7743-890a-6b1f1a6f8330"],

Cell["\<\
The internal coordinate helper has overlapping input patterns for a device \
containing exactly two sites. Use care with that case in the current \
implementation.\
\>", "Notes",
 CellID->1843386138,ExpressionUUID->"938aefb9-9982-ef41-ae28-453e8960ea1c"],

Cell[TextData[{
 "For one scalar internal state and identity projection, the bond-current \
convention is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["J", 
      RowBox[{"{", 
       RowBox[{"i", ",", "j"}], "}"}]], "\[LongEqual]", 
     FractionBox[
      RowBox[{"Im", "(", 
       RowBox[{
        SubscriptBox["H", 
         RowBox[{"{", 
          RowBox[{"j", ",", "i"}], "}"}]], " ", 
        SubscriptBox[
         RowBox[{"G", ".", "\[CapitalGamma]", ".", 
          TemplateBox[{"G"},
           "ConjugateTranspose"]}], 
         RowBox[{"{", 
          RowBox[{"i", ",", "j"}], "}"}]]}], ")"}], "\[Pi]"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "58c4649d-6e9b-8c46-a051-c3898205aa9e"]
}], "Notes",
 CellID->993716321,ExpressionUUID->"c9fd9d7a-baa3-da42-9297-964f73c54351"],

Cell[TextData[{
 "The vector field weights each bond by its actual displacement:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[ScriptCapitalJ]", "i"], "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"j", "=", "1"}], 
       SubscriptBox["N", "S"]], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["r", "j"], "-", 
         SubscriptBox["r", "i"]}], ")"}], " ", 
       SubscriptBox["J", 
        RowBox[{"{", 
         RowBox[{"i", ",", "j"}], "}"}]]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "4a363f08-4bac-5e4e-8f66-7092e381e85b"]
}], "Notes",
 CellID->2010136773,ExpressionUUID->"514553dd-da70-3c42-9978-2f2223287c4e"]
}, Closed]],

