Cell[TextData[{
 "Uses the reverse-ordered final Green column from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CentralBlockGreens"]], 
    "paclet:TBMethod/ref/CentralBlockGreens", "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4b3100aa-643c-ae45-a17f-87f8405f3ec3"],
 " in ",
 Cell[BoxData["\"\<LCDV\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4198600f-600d-9c4f-862c-95c8c825e113"],
 " mode. The point ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4d95002c-a548-4240-9104-56dba839b282"],
 " and Hamiltonian blocks use original layer order."
}], "Notes",
 CellID->250304435,ExpressionUUID->"55bfd01e-f5f6-f642-8e47-8270c62d1046"],

Cell[TextData[{
 "Returns pairs of the form ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["coordinate", "TI"], ",", 
    StyleBox["vector", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3bdafeff-a0c6-024b-b092-3c42a3ce170c"],
 ". Sites with no stored current entries may be absent."
}], "Notes",
 CellID->1122257432,ExpressionUUID->"b7bcbb0a-1048-854c-8ab2-e8bfc7e964a6"],

Cell[TextData[{
 "The internal ",
 Cell[BoxData[
  StyleBox["projection", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "87674033-84e4-8243-b4c3-0fc685684d73"],
 " must match the degrees of freedom per site. The normalization contains ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "\[Pi]"], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "10f39840-2aa6-b74e-947d-47aa6e470263"],
 "; no explicit charge or ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "faddc9b4-2cbe-1744-877e-46737c7e78b3"],
 " factor is inserted."
}], "Notes",
 CellID->1998930538,ExpressionUUID->"bddfc33d-7a00-0c43-9bd2-b5ec37e47b37"],

Cell["\<\
The internal coordinate helper has overlapping input patterns for a device \
containing exactly two sites. Use care with that case in the current \
implementation.\
\>", "Notes",
 CellID->477771191,ExpressionUUID->"0fc3a4ea-c1ec-ed45-a9e5-71e9258297b6"],

Cell[TextData[{
 "For one scalar internal state and identity projection, the bond-current \
convention is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["J", 
      RowBox[{"{", 
       RowBox[{"i", ",", "j"}], "}"}]], "\[LongEqual]", 
     FractionBox[
      RowBox[{"Im", "(", 
       RowBox[{
        SubscriptBox["H", 
         RowBox[{"{", 
          RowBox[{"j", ",", "i"}], "}"}]], " ", 
        SubscriptBox[
         RowBox[{"G", ".", "\[CapitalGamma]", ".", 
          TemplateBox[{"G"},
           "ConjugateTranspose"]}], 
         RowBox[{"{", 
          RowBox[{"i", ",", "j"}], "}"}]]}], ")"}], "\[Pi]"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "9c61d93f-5273-1b4c-83fb-4a52494f60b8"]
}], "Notes",
 CellID->617921900,ExpressionUUID->"377a4115-1cd0-3d4f-adb7-3b5f0268c448"],

Cell[TextData[{
 "The vector field weights each bond by its actual displacement:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[ScriptCapitalJ]", "i"], "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"j", "=", "1"}], 
       SubscriptBox["N", "S"]], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["r", "j"], "-", 
         SubscriptBox["r", "i"]}], ")"}], " ", 
       SubscriptBox["J", 
        RowBox[{"{", 
         RowBox[{"i", ",", "j"}], "}"}]]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "a03f9332-5224-3649-ac48-403094802a56"]
}], "Notes",
 CellID->1430821638,ExpressionUUID->"5f71d18b-802f-1e46-a661-9950e582a213"]
}, Closed]],

