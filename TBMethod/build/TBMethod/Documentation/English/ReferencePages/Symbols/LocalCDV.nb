Cell[TextData[{
 "Uses the reverse-ordered final Green column from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CentralBlockGreens"]], 
    "paclet:TBMethod/ref/CentralBlockGreens", "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d43cf8ac-c87a-7e42-bfb1-90b5f2cbc192"],
 " in ",
 Cell[BoxData["\"\<LCDV\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a292f103-4ee7-a44c-9e5d-c1330edc2807"],
 " mode. The point ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1ef33c54-f055-bc4e-800c-a8953abc026a"],
 " and Hamiltonian blocks use original layer order."
}], "Notes",
 CellID->1023391171,ExpressionUUID->"3539792f-bd3a-e94e-b5bf-ddace18e81f4"],

Cell[TextData[{
 "Returns pairs of the form ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["coordinate", "TI"], ",", 
    StyleBox["vector", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b6c3414f-f3ac-2943-9eee-5f5b9052e6ae"],
 ". Sites with no stored current entries may be absent."
}], "Notes",
 CellID->1230226648,ExpressionUUID->"37b45313-46af-a640-8a9b-46d25ea89aa0"],

Cell[TextData[{
 "The internal ",
 Cell[BoxData[
  StyleBox["projection", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "917be994-3e5f-6048-b130-dcc03e072e5e"],
 " must match the degrees of freedom per site. The normalization contains ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "\[Pi]"], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "bb6f83ce-0fb9-bb47-bbd8-9853c39af90e"],
 "; no explicit charge or ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "f2a45b2f-0555-e34d-9286-66a35bc93771"],
 " factor is inserted."
}], "Notes",
 CellID->564534629,ExpressionUUID->"2eb46acd-a135-614b-a036-3165a5997bd8"],

Cell["\<\
The internal coordinate helper has overlapping input patterns for a device \
containing exactly two sites. Use care with that case in the current \
implementation.\
\>", "Notes",
 CellID->1314059934,ExpressionUUID->"e61924fd-434b-dd4c-98ce-be2ff1e40263"],

Cell[TextData[{
 "For one scalar internal state and identity projection, the bond-current \
convention is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["J", 
      RowBox[{"{", 
       RowBox[{"i", ",", "j"}], "}"}]], "\[LongEqual]", 
     FractionBox[
      RowBox[{"Im", "(", 
       RowBox[{
        SubscriptBox["H", 
         RowBox[{"{", 
          RowBox[{"j", ",", "i"}], "}"}]], " ", 
        SubscriptBox[
         RowBox[{"G", ".", "\[CapitalGamma]", ".", 
          TemplateBox[{"G"},
           "ConjugateTranspose"]}], 
         RowBox[{"{", 
          RowBox[{"i", ",", "j"}], "}"}]]}], ")"}], "\[Pi]"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "67567736-2373-4b45-8744-b15ade7211f0"]
}], "Notes",
 CellID->1960620856,ExpressionUUID->"ab7569df-a3fe-2b4a-a4c6-062c5e45806f"],

Cell[TextData[{
 "The vector field weights each bond by its actual displacement:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[ScriptCapitalJ]", "i"], "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"j", "=", "1"}], 
       SubscriptBox["N", "S"]], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["r", "j"], "-", 
         SubscriptBox["r", "i"]}], ")"}], " ", 
       SubscriptBox["J", 
        RowBox[{"{", 
         RowBox[{"i", ",", "j"}], "}"}]]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "a8d40b3e-4181-ff4e-bfe1-af2f82058348"]
}], "Notes",
 CellID->2008460265,ExpressionUUID->"7c4d9cb4-8976-834d-adcf-24105fb4703f"]
}, Closed]],

