Cell[TextData[{
 "Uses the reverse-ordered final Green column from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CentralBlockGreens"]], 
    "paclet:TBMethod/ref/CentralBlockGreens", "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9b444a64-5350-bb43-9842-140806aff9e5"],
 " in ",
 Cell[BoxData["\"\<LCDV\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "50803ae2-471e-ff4e-adb3-8191cb8b7b05"],
 " mode. The point ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "291f4566-4ed4-0846-94ef-02ccc8555287"],
 " and Hamiltonian blocks use original layer order."
}], "Notes",
 CellID->250304435,ExpressionUUID->"b9f1f69d-91f7-d948-a046-1d446be25c12"],

Cell[TextData[{
 "Returns pairs of the form ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["coordinate", "TI"], ",", 
    StyleBox["vector", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4b87ac1e-61cf-b145-9f5f-ae4b056cb0f8"],
 ". Sites with no stored current entries may be absent."
}], "Notes",
 CellID->1122257432,ExpressionUUID->"f2bd5882-285b-7e4e-b088-9198f2ffcdc2"],

Cell[TextData[{
 "The internal ",
 Cell[BoxData[
  StyleBox["projection", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2bd08684-cdae-1e40-a34b-f39fc88ce78a"],
 " must match the degrees of freedom per site. The normalization contains ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "\[Pi]"], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "48cf7e12-0341-a34a-8270-e95dc36b2091"],
 "; no explicit charge or ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "d27222d5-4000-674d-9130-c2351dca707a"],
 " factor is inserted."
}], "Notes",
 CellID->1998930538,ExpressionUUID->"8d3829aa-16cf-0041-99c1-25fef27f9bb3"],

Cell["\<\
The internal coordinate helper has overlapping input patterns for a device \
containing exactly two sites. Use care with that case in the current \
implementation.\
\>", "Notes",
 CellID->477771191,ExpressionUUID->"97102fa3-e006-9841-8980-698ea5f98327"],

Cell[TextData[{
 "For one scalar internal state and identity projection, the bond-current \
convention is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["J", 
      RowBox[{"{", 
       RowBox[{"i", ",", "j"}], "}"}]], "\[LongEqual]", 
     FractionBox[
      RowBox[{"Im", "(", 
       RowBox[{
        SubscriptBox["H", 
         RowBox[{"{", 
          RowBox[{"j", ",", "i"}], "}"}]], " ", 
        SubscriptBox[
         RowBox[{"G", ".", "\[CapitalGamma]", ".", 
          TemplateBox[{"G"},
           "ConjugateTranspose"]}], 
         RowBox[{"{", 
          RowBox[{"i", ",", "j"}], "}"}]]}], ")"}], "\[Pi]"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "bc9af8bb-92f0-0c46-919f-38ca511f2a6e"]
}], "Notes",
 CellID->617921900,ExpressionUUID->"8ee5575e-aaea-3640-9aaf-c45fd2734009"],

Cell[TextData[{
 "The vector field weights each bond by its actual displacement:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[ScriptCapitalJ]", "i"], "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"j", "=", "1"}], 
       SubscriptBox["N", "S"]], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["r", "j"], "-", 
         SubscriptBox["r", "i"]}], ")"}], " ", 
       SubscriptBox["J", 
        RowBox[{"{", 
         RowBox[{"i", ",", "j"}], "}"}]]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "cf758830-decc-314a-b9ba-1f3644f73f81"]
}], "Notes",
 CellID->1430821638,ExpressionUUID->"6f59ee41-b797-0347-9052-d529c5bf37ee"]
}, Closed]],

