Cell[TextData[{
 "Uses the reverse-ordered final Green column from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CentralBlockGreens"]], 
    "paclet:TBMethod/ref/CentralBlockGreens", "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "00ab09ca-f251-cc4e-b5de-36d29a82fd5c"],
 " in ",
 Cell[BoxData["\"\<LCDV\>\""], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"9e81d5ae-d709-6d4b-ac9d-aa9fea9f84e8"],
 " mode. The point ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7873da93-96a5-3640-843d-31bf26afca4a"],
 " and Hamiltonian blocks use original layer order."
}], "Notes",
 CellID->342573492,ExpressionUUID->"a14f0232-343a-584e-abf8-1a2a72fe0bc9"],

Cell[TextData[{
 "Returns pairs of the form ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"coordinate", ",", " ", "vector"}], "}"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"d203ec3c-e413-8e45-9517-a796ea00b129"],
 ". Sites with no stored current entries may be absent."
}], "Notes",
 CellID->505404231,ExpressionUUID->"471b9ce2-08f6-e44b-a9ce-3b01f6f6425d"],

Cell[TextData[{
 "The internal ",
 Cell[BoxData[
  StyleBox["projection", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c874d9c2-59ca-7043-88b5-ae8ca6b1d51a"],
 " must match the degrees of freedom per site. The normalization contains ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "\[Pi]"], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "ebc5385f-c3df-1947-a965-a6f4d852d451"],
 "; no explicit charge or ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "fc8d59e8-4024-624a-9d3f-36a5f345fbf8"],
 " factor is inserted."
}], "Notes",
 CellID->1448017945,ExpressionUUID->"ee6bf278-5458-f24b-b9cc-d9bbd92102e7"],

Cell["\<\
The internal coordinate helper has overlapping input patterns for a device \
containing exactly two sites. Use care with that case in the current \
implementation.\
\>", "Notes",
 CellID->206069314,ExpressionUUID->"1ddb413b-e628-1547-8052-3f1ed8d614e6"],

Cell[TextData[{
 "For one scalar internal state and identity projection, the bond-current \
convention is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["J", 
      RowBox[{"{", 
       RowBox[{"i", ",", "j"}], "}"}]], "\[LongEqual]", 
     FractionBox[
      RowBox[{"Im", "(", 
       RowBox[{
        SubscriptBox["H", 
         RowBox[{"{", 
          RowBox[{"j", ",", "i"}], "}"}]], " ", 
        SubscriptBox[
         RowBox[{"G", ".", "\[CapitalGamma]", ".", 
          TemplateBox[{"G"},
           "ConjugateTranspose"]}], 
         RowBox[{"{", 
          RowBox[{"i", ",", "j"}], "}"}]]}], ")"}], "\[Pi]"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "12ec2072-4169-2748-98c0-584124bb3ecb"]
}], "Notes",
 CellID->1287134766,ExpressionUUID->"3691cf32-0489-f447-a10a-59dd8deee654"],

Cell[TextData[{
 "The vector field weights each bond by its actual displacement:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[ScriptCapitalJ]", "i"], "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"j", "=", "1"}], 
       SubscriptBox["N", "S"]], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["r", "j"], "-", 
         SubscriptBox["r", "i"]}], ")"}], " ", 
       SubscriptBox["J", 
        RowBox[{"{", 
         RowBox[{"i", ",", "j"}], "}"}]]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "d41c07b7-299d-f046-b7f7-202ece03609f"]
}], "Notes",
 CellID->740788654,ExpressionUUID->"2b322882-df2a-a943-9fca-657046230246"]
}, Closed]],

