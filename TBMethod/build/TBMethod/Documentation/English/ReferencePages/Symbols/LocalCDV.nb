Cell["\<\
Uses the reverse-ordered final Green column from CentralBlockGreens[..., \
\"LCDV\"]. The point Association and Hamiltonian blocks are in original layer \
order.\
\>", "Notes",
 CellID->254192091,ExpressionUUID->"586cff9c-6404-7942-b41f-6e06c1fe60a4"],

Cell["\<\
Returns coordinate\[Dash]vector pairs {{point1, current1}, ...}; sites with \
no stored current entries may be absent.\
\>", "Notes",
 CellID->1493553257,ExpressionUUID->"9d23f722-8d5e-9e41-80fb-6201ea77b824"],

Cell["\<\
The internal projection must match the degrees of freedom per site. The \
implementation includes a 1/Pi normalization and does not multiply by an \
explicit charge or hbar.\
\>", "Notes",
 CellID->1472962094,ExpressionUUID->"1aee66e9-2aed-544a-ab77-9f634b38165b"],

Cell["\<\
The internal coordinate helper has overlapping input patterns for a device \
containing exactly two sites; use care with that case in the current \
implementation.\
\>", "Notes",
 CellID->1508076910,ExpressionUUID->"03b990f1-cb9a-6b40-a458-0fa8679cadf4"]
}, Closed]],

