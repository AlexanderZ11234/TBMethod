Cell[TextData[{
 "The scattering-region layers form an ordered ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e66740a8-b9af-4541-814a-477d4b5e343e"],
 ". Its last layer is the lead-contact layer. The underlying hopping cutoff \
must have head ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Real"]], "paclet:ref/Real"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6c53c453-1a83-f14c-b839-acd1677507af"],
 "."
}], "Notes",
 CellID->1285025454,ExpressionUUID->"e786dfe1-44a5-454a-b833-4f2981d91b74"],

