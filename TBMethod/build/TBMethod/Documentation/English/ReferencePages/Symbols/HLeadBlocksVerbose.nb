Cell["\<\
The result is {h0, h1, v}. h0 has rows and columns in leadCell0; h1 has rows \
in leadCell0 and columns in leadCell1; v has rows in the last CSR layer and \
columns in leadCell0.\
\>", "Notes",
 CellID->358956602,ExpressionUUID->"9cec4785-f094-564f-8a4e-ca2ded5a3c37"],

Cell[TextData[{
 "The scattering-region layers are an ordered association; the last layer is \
the lead-contact layer. The underlying hopping cutoff must be a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Real"]], "paclet:ref/Real"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "51d33f6a-565d-244e-8beb-054d4de043d2"],
 "."
}], "Notes",
 CellID->1390789939,ExpressionUUID->"26393b2b-5be3-6a41-9df3-0441b979516a"],

Cell["\<\
Requires at least two CSR layers. Checks that leadCell0 does not couple to \
the penultimate layer and leadCell1 does not couple to the last layer, and \
prints leadName in diagnostics.\
\>", "Notes",
 CellID->308190017,ExpressionUUID->"41ec9e7e-6732-c649-87cc-abf73f7b9c7b"]
}, Closed]],

