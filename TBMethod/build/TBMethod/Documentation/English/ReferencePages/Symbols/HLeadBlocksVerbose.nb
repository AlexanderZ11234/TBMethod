Cell[BoxData[{
 RowBox[{
  RowBox[{"layers", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"1", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"0.", ",", "0."}], "}"}], "}"}]}], ",", 
     RowBox[{"2", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1.", ",", "0."}], "}"}], "}"}]}], ",", 
     RowBox[{"3", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"2.", ",", "0."}], "}"}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hop", "=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rf", ",", "ri"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          TemplateBox[{
            RowBox[{"rf", "-", "ri"}]},
           "Norm"], "<", "0.001"}], ",", "0.", ",", 
         RowBox[{"-", "1."}]}], "]"}], "}"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lead", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"3.", ",", "0."}], "}"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"4.", ",", "0."}], "}"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"HLeadBlocksVerbose", "[", 
  RowBox[{
  "layers", ",", "hop", ",", "1.01", ",", "lead", ",", "\"\<right\>\""}], 
  "]"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->261244708,ExpressionUUID->"3ee069cd-3a88-7d49-a4a5-1b886037312a"],

