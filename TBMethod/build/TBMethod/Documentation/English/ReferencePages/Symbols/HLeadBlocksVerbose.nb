 RowBox[{
  RowBox[{"hop", "=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rf", ",", "ri"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          TemplateBox[{
            RowBox[{"rf", "-", "ri"}]},
           "Norm"], "<", "0.001"}], ",", "0.", ",", 
         RowBox[{"-", "1."}]}], "]"}], "}"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
