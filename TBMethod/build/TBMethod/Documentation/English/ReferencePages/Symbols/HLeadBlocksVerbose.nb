Cell[TextData[{
 "The scattering-region layers form an ordered ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dece8f4b-d899-7c46-a7e2-e4259c3237c1"],
 ". Its last layer is the lead-contact layer. The underlying hopping cutoff \
must have head ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Real"]], "paclet:ref/Real"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
