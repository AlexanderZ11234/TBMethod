Cell["\<\
Attach a one-orbital chain lead to the final layer of a three-site scattering \
region.\
\>", "ExampleText",
 CellID->1692263984,ExpressionUUID->"f93ee8bb-4db3-094b-8438-ce67c5a3300e"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1815154555,ExpressionUUID->"a89ef7b6-59a4-8d4f-b9b7-b32f234e1538"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"layers", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"1", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"0.`", ",", "0.`"}], "}"}], "}"}]}], ",", 
     RowBox[{"2", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1.`", ",", "0.`"}], "}"}], "}"}]}], ",", 
     RowBox[{"3", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"2.`", ",", "0.`"}], "}"}], "}"}]}]}], "]"}]}], ";", 
  RowBox[{"hop", "=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rf", ",", "ri"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          TemplateBox[{
            RowBox[{"rf", "-", "ri"}]},
           "Norm"], "<", "0.001`"}], ",", "0.`", ",", 
         RowBox[{"-", "1.`"}]}], "]"}], "}"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"lead", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"3.`", ",", "0.`"}], "}"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"4.`", ",", "0.`"}], "}"}], "}"}]}], "}"}]}], ";", 
  RowBox[{"result", "=", 
   RowBox[{"HLeadBlocksVerbose", "[", 
    RowBox[{
    "layers", ",", "hop", ",", "1.01`", ",", "lead", ",", "\"\<right\>\""}], 
    "]"}]}], ";", "result"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->1089953542,ExpressionUUID->"23dbb31d-52eb-d349-b48e-47df78573261"],

