Cell["\<\
Contracts the hopping column index with the modulation internal-row index, \
adds the identity contraction with the additive tensor, and flattens the \
result into a matrix.\
\>", "Notes",
 CellID->1034830838,ExpressionUUID->"1ca59eb4-c038-3546-a773-e997a2cbc998"],

Cell[TextData[{
 "Inputs are the two tensors returned by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PhotonBlocksTensor"]], 
    "paclet:TBMethod/ref/PhotonBlocksTensor", "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "141db543-796c-ad46-a449-6ecb533cc4a5"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NPhotonBlocksTensor"]], 
    "paclet:TBMethod/ref/NPhotonBlocksTensor", "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "24b3156c-ed2c-e640-bf94-c1e6c0aff428"],
 ". Internal indices precede photon indices in the resulting basis ordering."
}], "Notes",
 CellID->1554817559,ExpressionUUID->"5f11da3a-de51-1842-96e6-71237baa01fb"]
}, Closed]],

