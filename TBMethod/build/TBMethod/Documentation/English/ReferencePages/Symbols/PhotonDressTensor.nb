Cell["\<\
Contracts the hopping column index with the modulation internal-row index, \
adds the identity contraction with the additive tensor, and flattens the \
result into a matrix.\
\>", "Notes",
 CellID->1104707903,ExpressionUUID->"38d4cdcb-bdd2-d444-9dce-cbee18c02f77"],

Cell["\<\
Inputs are the two tensors returned by PhotonBlocksTensor or \
NPhotonBlocksTensor. Internal indices precede photon indices in the resulting \
basis ordering.\
\>", "Notes",
 CellID->1123320576,ExpressionUUID->"3e252f9c-ca54-a84d-b243-30500cd08c36"]
}, Closed]],

