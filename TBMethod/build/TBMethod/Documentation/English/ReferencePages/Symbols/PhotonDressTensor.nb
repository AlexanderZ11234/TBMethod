Cell[BoxData[
 RowBox[{
  RowBox[{"modulation", "=", 
   RowBox[{"Function", "[", 
    RowBox[{"angle", ",", 
     RowBox[{
      RowBox[{"Cos", "[", "angle", "]"}], " ", 
      RowBox[{"PauliMatrix", "[", "3", "]"}]}]}], "]"}]}], ";", 
  RowBox[{"blocks", "=", 
   RowBox[{
    RowBox[{"PhotonBlocksTensor", "[", 
     RowBox[{"modulation", ",", "2.`", ",", "1"}], "]"}], "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1.`", ",", "0.`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.`", ",", "0.`"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"result", "=", 
   RowBox[{"PhotonDressTensor", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "0", "]"}], ",", "blocks"}], "]"}]}], ";", 
  "result"}]], "Input",
