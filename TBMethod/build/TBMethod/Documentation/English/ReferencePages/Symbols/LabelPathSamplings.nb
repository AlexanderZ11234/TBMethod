Cell["\<\
pathData is {samples, vertexMarkers}, as returned by PathSample. labels is a \
nonempty list of strings or OverBar expressions.\
\>", "Notes",
 CellID->219620259,ExpressionUUID->"97f1e814-3311-ac46-b262-5f83ed975cc0"],

Cell["\<\
With one label per marker except the terminal marker, only the actual initial \
and internal vertices are labelled. With one label per marker, the terminal \
label is placed on the last available sample, one index before the omitted \
terminal vertex.\
\>", "Notes",
 CellID->1403914727,ExpressionUUID->"8c29b250-d93f-6649-8b87-cb80e9c6b4f5"],

Cell[TextData[{
 "Additional arguments and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Callout"]], "paclet:ref/Callout"},
