Cell["\<\
Calculate energy and state-norm pairs at two samples in parallel.\
\>", "ExampleText",
 CellID->212362707,ExpressionUUID->"f80ce791-c7ea-3741-a07b-f194976b1f9c"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->336012159,ExpressionUUID->"c0af7b8e-d084-b84c-815c-99babba335ec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"$KernelCount", "\[Equal]", "0"}], ",", 
    RowBox[{"LaunchKernels", "[", "2", "]"}]}], "]"}], ";", 
  RowBox[{"ParallelNeeds", "[", "\"\<TBMethod`\>\"", "]"}], ";", 
  RowBox[{"Clear", "[", "h", "]"}], ";", 
  RowBox[{
   RowBox[{"h", "[", "k_", "]"}], ":=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "1.`"}], "-", "k"}], ",", 
      RowBox[{"1.`", "\[VeryThinSpace]", "+", "k"}]}], "}"}], "]"}]}], ";", 
  RowBox[{"DistributeDefinitions", "[", "h", "]"}], ";", 
  RowBox[{"result", "=", 
   RowBox[{"ParallelEigenspectralData", "[", 
    RowBox[{"h", ",", 
     RowBox[{"{", 
      RowBox[{"0.`", ",", "1.`"}], "}"}], ",", 
     RowBox[{
      RowBox[{"Total", "[", 
       SuperscriptBox[
        RowBox[{"Abs", "[", "#1", "]"}], "2"], "]"}], "&"}]}], "]"}]}], ";", 
  "result"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->1266696714,ExpressionUUID->"483844ed-f73e-9b4e-bc65-889c620f5240"],

Cell[BoxData[
 RowBox[{"{", 
