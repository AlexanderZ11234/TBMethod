      RowBox[{
       RowBox[{"-", "1."}], "-", "k"}], ",", 
      RowBox[{"1.", "\[VeryThinSpace]", "+", "k"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
