Cell[TextData[{
 "Each lead matrix is transformed independently:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     OverscriptBox[
      SubscriptBox["\[CapitalSigma]", "p"], "\"\<~\>\""], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["U", "p"], ".", 
      SubscriptBox["\[CapitalSigma]", "p"], ".", 
      TemplateBox[{
        RowBox[{"(", 
          SubscriptBox["U", "p"], ")"}]},
       "ConjugateTranspose"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "682c1e1c-63ff-694f-8ddd-f45eecd25505"]
}], "Notes",
 CellID->1657100456,ExpressionUUID->"eb28da4b-93ad-cf47-a898-50b634cfce52"]
}, Closed]],

