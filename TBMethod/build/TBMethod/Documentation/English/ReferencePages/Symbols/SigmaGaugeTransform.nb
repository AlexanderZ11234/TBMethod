Cell[TextData[{
 "Each lead matrix is transformed independently:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     OverscriptBox[
      SubscriptBox["\[CapitalSigma]", "p"], "\"\<~\>\""], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["U", "p"], ".", 
      SubscriptBox["\[CapitalSigma]", "p"], ".", 
      TemplateBox[{
        RowBox[{"(", 
          SubscriptBox["U", "p"], ")"}]},
       "ConjugateTranspose"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "be41597c-54ae-e144-9a70-3587c04fd7c4"]
}], "Notes",
