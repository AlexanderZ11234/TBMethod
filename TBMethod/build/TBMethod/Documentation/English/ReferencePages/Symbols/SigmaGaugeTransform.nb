Cell[BoxData[
 RowBox[{
  RowBox[{"u", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.`", ",", "1.`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1.`", ",", "0.`"}], "}"}]}], "}"}]}], ";", 
  RowBox[{"sigma", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "0.1`"}], " ", "\[ImaginaryI]"}], ",", 
      RowBox[{
       RowBox[{"-", "0.2`"}], " ", "\[ImaginaryI]"}]}], "}"}], "]"}]}], ";", 
  RowBox[{"result", "=", 
   RowBox[{
    RowBox[{"SigmaGaugeTransform", "[", 
