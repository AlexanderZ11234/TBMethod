Cell[TextData[{
 "Each lead matrix is transformed independently:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     OverscriptBox[
      SubscriptBox["\[CapitalSigma]", "p"], "\"\<~\>\""], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["U", "p"], ".", 
      SubscriptBox["\[CapitalSigma]", "p"], ".", 
      TemplateBox[{
        RowBox[{"(", 
          SubscriptBox["U", "p"], ")"}]},
       "ConjugateTranspose"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "42031788-3aa0-af4a-96ca-6a9d4d845f91"]
}], "Notes",
 CellID->1314071811,ExpressionUUID->"0ddebd8f-3e02-834a-a077-2d24bd266ca1"]
}, Closed]],

