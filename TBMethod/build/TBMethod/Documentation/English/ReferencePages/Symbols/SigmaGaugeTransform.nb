Cell[TextData[{
 "Each lead matrix is transformed independently:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     OverscriptBox[
      SubscriptBox["\[CapitalSigma]", "p"], "\"\<~\>\""], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["U", "p"], ".", 
      SubscriptBox["\[CapitalSigma]", "p"], ".", 
      TemplateBox[{
        RowBox[{"(", 
          SubscriptBox["U", "p"], ")"}]},
       "ConjugateTranspose"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "c1693d90-36bc-ad4b-aeff-a0731355c2f7"]
}], "Notes",
