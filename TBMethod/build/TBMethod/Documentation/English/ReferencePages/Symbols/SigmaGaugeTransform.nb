Cell["\<\
Each unitary transformation acts on its corresponding lead self-energy.\
\>", "Notes",
 CellID->378507403,ExpressionUUID->"20897d11-0585-e14f-8e12-8b707b2a11b9"],

Cell["\<\
Each unitary and self-energy pair must have compatible dimensions. The two \
lists must have equal lengths.\
\>", "Notes",
 CellID->1610367052,ExpressionUUID->"09af7867-5ac8-fa41-bf73-a2ceb9e3a267"],

Cell[TextData[{
 "Each lead matrix is transformed independently:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     OverscriptBox[
      SubscriptBox["\[CapitalSigma]", "p"], "\"\<~\>\""], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["U", "p"], ".", 
      SubscriptBox["\[CapitalSigma]", "p"], ".", 
      TemplateBox[{
        RowBox[{"(", 
          SubscriptBox["U", "p"], ")"}]},
       "ConjugateTranspose"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "b7bec911-7035-7745-bd72-028ea9430033"]
}], "Notes",
 CellID->1601759826,ExpressionUUID->"1e177146-49d1-054d-8f71-8c83c5ccba7c"]
}, Closed]],

