Cell[TextData[{
 "The default ",
 Cell[BoxData[
  StyleBox["stateFunction", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3c3066d3-1e19-4042-b8ee-89497aedaac8"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Identity"]], "paclet:ref/Identity"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c32ad13a-44ce-aa42-98f3-07ae33704377"],
 ", so each sample produces a list of ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["energy", "TI"], ",", 
