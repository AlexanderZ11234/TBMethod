Cell[TextData[{
 "The default ",
 Cell[BoxData[
  StyleBox["stateFunction", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6910836a-d118-ba4e-a838-1913ab8c3576"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Identity"]], "paclet:ref/Identity"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "83d0f287-508e-7c48-b6bd-8bf286e6c0ba"],
 ", so each sample produces a list of ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["energy", "TI"], ",", 
    StyleBox["eigenvector", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "98c2032d-776d-c74f-87d2-11c530b9997f"],
 " pairs."
}], "Notes",
 CellID->1297138717,ExpressionUUID->"55675b57-eb9a-254a-917b-55ab46c8d6c7"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["stateFunction", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b3fef888-09e6-324a-a01f-4ae0fb8b0916"],
 " acts on each eigenvector. For example, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Total"]], "paclet:ref/Total"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    SuperscriptBox[
     RowBox[{
      TemplateBox[{
        Cell[
         TextData["Abs"]], "paclet:ref/Abs"},
       "RefLink",
       BaseStyle->{"InlineFormula"}], "[", "#1", "]"}], "4"], "]"}], "&"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "abe28f78-a539-5b4f-b2b4-bd6f9a9088cc"],
 " gives its inverse participation ratio when the state is normalized."
}], "Notes",
 CellID->1876941562,ExpressionUUID->"954f3f84-ef9c-c145-820b-be630e30443f"],

