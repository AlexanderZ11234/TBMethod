Cell["\<\
The default stateFunction is Identity, so each sample produces a list of \
{energy, eigenvector} pairs.\
\>", "Notes",
 CellID->481730149,ExpressionUUID->"676ad442-8d7d-a943-aacb-8e8db50dd3fd"],

Cell["\<\
stateFunction acts on each eigenvector; for example, Total[Abs[#]^4]& gives \
its inverse participation ratio when the state is normalized.\
\>", "Notes",
 CellID->700154093,ExpressionUUID->"9c103d2b-ca3f-6c46-b75d-352aa4e48426"],

Cell["\<\
The output is grouped by sample, unlike the band-by-sample matrix returned by \
BandData.\
\>", "Notes",
 CellID->1836101567,ExpressionUUID->"76fda475-82e5-e849-a81d-9a762672b999"],

Cell[TextData[{
 "To request n eigenpairs unambiguously, provide the state function \
explicitly before n. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigensystem"]], "paclet:ref/Eigensystem"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "327d7a20-807c-6141-8200-5013b7efd512"],
 " options are accepted and Method -> \"Direct\" is supplied internally."
}], "Notes",
 CellID->343050926,ExpressionUUID->"f618e7e5-e4bc-7e49-ae95-ee55f6e0c798"]
}, Closed]],

