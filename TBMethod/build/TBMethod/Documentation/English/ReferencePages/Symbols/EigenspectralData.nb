Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1347385250,ExpressionUUID->"2c90d0a0-9e45-b044-b94c-52431f356b22"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", "h", "]"}], ";", 
  RowBox[{
   RowBox[{"h", "[", "k_", "]"}], ":=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "1.`"}], "-", "k"}], ",", 
      RowBox[{"1.`", "\[VeryThinSpace]", "+", "k"}]}], "}"}], "]"}]}], ";", 
  RowBox[{"result", "=", 
   RowBox[{"EigenspectralData", "[", 
    RowBox[{"h", ",", 
     RowBox[{"{", 
      RowBox[{"0.`", ",", "1.`"}], "}"}], ",", 
     RowBox[{
      RowBox[{"Total", "[", 
       SuperscriptBox[
        RowBox[{"Abs", "[", "#1", "]"}], "2"], "]"}], "&"}]}], "]"}]}], ";", 
  "result"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->1126314391,ExpressionUUID->"170e61b1-29a3-a34e-a063-75083724200d"],

Cell[BoxData[
 RowBox[{"{", 
