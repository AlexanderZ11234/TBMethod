 " pairs."
}], "Notes",
 CellID->1477896377,ExpressionUUID->"0405e02a-bb67-344c-8094-e15caa94dc89"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["stateFunction", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c182b2c3-505d-434d-9587-36cf39fffc4b"],
 " acts on each eigenvector. For example, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Total"]], "paclet:ref/Total"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    SuperscriptBox[
     RowBox[{
      TemplateBox[{
        Cell[
         TextData["Abs"]], "paclet:ref/Abs"},
       "RefLink",
       BaseStyle->{"InlineFormula"}], "[", "#1", "]"}], "4"], "]"}], "&"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d6b803ae-c0dd-f34b-a44c-bd15f70f6a11"],
 " gives its inverse participation ratio when the state is normalized."
}], "Notes",
 CellID->223274253,ExpressionUUID->"2165df7e-d300-6a42-8921-bc32402f2da4"],

