     RowBox[{"{", 
      RowBox[{"1.`", ",", "1.`"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "2.`"}], ",", "1.`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2.`", ",", "1.`"}], "}"}]}], "}"}]}], "}"}]], "Output",
