Cell[TextData[{
 "The default ",
 Cell[BoxData[
  StyleBox["stateFunction", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "252e7b14-03ca-7f44-8232-bd2e42890c68"],
