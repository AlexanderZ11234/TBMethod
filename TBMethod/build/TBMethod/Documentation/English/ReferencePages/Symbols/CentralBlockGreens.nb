Cell[TextData[{
 "The block lists must satisfy ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Length"]], "paclet:ref/Length"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    StyleBox["lowerBlocks", "TI"], "]"}], "\[Equal]", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       Cell[
        TextData["Length"]], "paclet:ref/Length"},
      "RefLink",
      BaseStyle->{"InlineFormula"}], "[", 
     StyleBox["diagonalBlocks", "TI"], "]"}], "-", "1"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0763ae6f-ac4c-0d41-9495-88351afde1ea"],
 ". Every self-energy acts on the last layer."
}], "Notes",
 CellID->301038039,ExpressionUUID->"43037e85-1e4c-4242-aeeb-e701d798ce44"],

Cell[TextData[{
 "The default ",
 Cell[BoxData[
  StyleBox["mode", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2f336523-1a83-7d41-85f5-d2980a41b2ce"],
 " is ",
 Cell[BoxData["\"\<T\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9fa351cf-c716-a54b-bd74-d9f8bc98a2c8"],
 ", which returns only the last diagonal Green block."
}], "Notes",
 CellID->1791639270,ExpressionUUID->"ff5ede33-0608-5043-8317-e2708b583bc3"],

Cell[TextData[{
 "Modes ",
 Cell[BoxData["\"\<LDOS\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0f3d00df-f146-234c-9b01-4a6344f7133f"],
 " and ",
 Cell[BoxData["\"\<LCDV\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bab77b0c-f4d0-f442-a1d4-d0f5dfa8c23e"],
 " return the final block column in reverse layer order, beginning with its \
last diagonal block."
}], "Notes",
 CellID->612920964,ExpressionUUID->"fdc2a0f0-1051-da44-a8ed-54d45d128e27"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  StyleBox["upperBlocks", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "211193b0-2444-3147-8aaa-2ece1cb65131"],
 " is omitted, the upper off-diagonal blocks are ",
