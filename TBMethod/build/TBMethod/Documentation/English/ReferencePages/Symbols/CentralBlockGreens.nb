Cell[TextData[{
 "The block lists must satisfy ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Length"]], "paclet:ref/Length"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    StyleBox["lowerBlocks", "TI"], "]"}], "\[Equal]", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       Cell[
        TextData["Length"]], "paclet:ref/Length"},
      "RefLink",
      BaseStyle->{"InlineFormula"}], "[", 
     StyleBox["diagonalBlocks", "TI"], "]"}], "-", "1"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "778c1aa0-ba57-f04e-8619-0591eec3510f"],
 ". Every self-energy acts on the last layer."
}], "Notes",
 CellID->301038039,ExpressionUUID->"2302e2c5-b6de-1644-9ae7-4f41b7e15247"],

Cell[TextData[{
 "The default ",
 Cell[BoxData[
  StyleBox["mode", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9051f275-b947-cd43-8884-49755cff9c43"],
 " is ",
 Cell[BoxData["\"\<T\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "79a3b13e-0026-f14c-b93b-c530e6a2c2bb"],
 ", which returns only the last diagonal Green block."
}], "Notes",
 CellID->1791639270,ExpressionUUID->"d38976af-f8dd-d84a-93b1-a0fcf27de2a9"],

Cell[TextData[{
 "Modes ",
 Cell[BoxData["\"\<LDOS\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dab6cdf5-d8a4-c64d-b5ea-459eef1bc10a"],
 " and ",
 Cell[BoxData["\"\<LCDV\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cb1ce0eb-9934-7344-abdf-7d3b64d72f0e"],
 " return the final block column in reverse layer order, beginning with its \
last diagonal block."
}], "Notes",
 CellID->612920964,ExpressionUUID->"b927cf2f-679b-ae41-b5c5-b971d7ddf8da"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  StyleBox["upperBlocks", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8e396b8c-cfca-604d-8696-11dee5eebcbe"],
 " is omitted, the upper off-diagonal blocks are ",
