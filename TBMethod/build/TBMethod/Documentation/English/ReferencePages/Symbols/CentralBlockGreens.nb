Cell["\<\
There must be one fewer off-diagonal block than diagonal blocks; all sigmas \
act on the last layer.\
\>", "Notes",
 CellID->901896020,ExpressionUUID->"105a3ac8-600f-4049-ad29-6a8db5e999ac"],

Cell["\<\
The default mode \"T\" returns only the last diagonal Green block.\
\>", "Notes",
 CellID->351730159,ExpressionUUID->"5d4414e5-322a-a641-b942-dd896e499fcb"],

Cell["\<\
Modes \"LDOS\" and \"LCDV\" return the final block column in reverse layer \
order: {Gnn, G(n-1)n, ..., G1n}.\
\>", "Notes",
 CellID->433178129,ExpressionUUID->"a6271e2c-74c3-3c48-8e04-7ddcdf6efac4"],

Cell["\<\
Upper blocks default to the conjugate transposes of the lower blocks.\
\>", "Notes",
 CellID->1080183084,ExpressionUUID->"9eb0979d-6181-1942-ba33-a9898f60d01f"]
}, Closed]],

