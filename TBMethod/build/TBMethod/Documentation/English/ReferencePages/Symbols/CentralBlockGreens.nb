Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   TagBox["D",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "ad49a768-2eaa-dc43-bd1e-4af0744358ea"],
 " denote the diagonal block of the inverse Green matrix, including contact \
self-energies only on the final layer:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["D", "j"], "\[LongEqual]", 
     RowBox[{
      RowBox[{"z", " ", "\[DoubleStruckCapitalI]"}], "-", 
      SubscriptBox["H", 
       RowBox[{"{", 
        RowBox[{"j", ",", "j"}], "}"}]], "-", 
      RowBox[{
       TemplateBox[{
         RowBox[{"j", ",", "N"}]},
        "KroneckerDeltaSeq"], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"p", "=", "1"}], 
         SubscriptBox["N", "L"]], 
        SubscriptBox["\[CapitalSigma]", "p"]}]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "779d8a5a-bc51-3248-a52f-0cde90539d1e"]
}], "Notes",
 CellID->661528300,ExpressionUUID->"52736a8b-3efb-9c40-9ad6-b4662b40a002"],

Cell[TextData[{
 "The forward recursion for the left-connected Green blocks is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["F", "j"], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{"(", 
         RowBox[{
           SubscriptBox["D", "j"], "-", 
           RowBox[{
             SubscriptBox["H", 
              RowBox[{"{", 
                RowBox[{"j", ",", 
                  RowBox[{"j", "-", "1"}]}], "}"}]], ".", 
             SubscriptBox["F", 
              RowBox[{"j", "-", "1"}]], ".", 
             SubscriptBox["H", 
              RowBox[{"{", 
                RowBox[{
                  RowBox[{"j", "-", "1"}], ",", "j"}], "}"}]]}]}], ")"}]},
      "Inverse"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "3810f723-8688-6042-8307-13bf6b809f9b"]
}], "Notes",
 CellID->809142187,ExpressionUUID->"c6dc3480-df6e-d64d-b59e-b6862c8f0c90"]
}, Closed]],

