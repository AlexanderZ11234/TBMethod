Cell[TextData[{
 "The block lists must satisfy ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Length"]], "paclet:ref/Length"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    StyleBox["lowerBlocks", "TI"], "]"}], "\[Equal]", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       Cell[
        TextData["Length"]], "paclet:ref/Length"},
      "RefLink",
      BaseStyle->{"InlineFormula"}], "[", 
     StyleBox["diagonalBlocks", "TI"], "]"}], "-", "1"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ed564914-82b3-eb49-9fd2-c8ce1cc28ed7"],
 ". Every self-energy acts on the last layer."
}], "Notes",
 CellID->301038039,ExpressionUUID->"7e126ec4-905f-5a4c-bda7-2aefac6c7c66"],

Cell[TextData[{
 "The default ",
 Cell[BoxData[
  StyleBox["mode", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3adf0ddc-4255-1f42-9219-cd70b32c7759"],
 " is ",
 Cell[BoxData["\"\<T\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "41d37bc5-e86e-0146-877a-e58afb273251"],
 ", which returns only the last diagonal Green block."
}], "Notes",
 CellID->1791639270,ExpressionUUID->"cf266d71-5001-de4f-88a2-0f872a3e5d99"],

Cell[TextData[{
 "Modes ",
 Cell[BoxData["\"\<LDOS\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "251bd56c-2922-4d4e-9940-454962dda3d8"],
 " and ",
 Cell[BoxData["\"\<LCDV\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "17db682c-f3a7-8747-9e65-f1cae4426d61"],
 " return the final block column in reverse layer order, beginning with its \
last diagonal block."
}], "Notes",
 CellID->612920964,ExpressionUUID->"1e088ebf-6ba9-894f-af07-bb28b00a430f"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  StyleBox["upperBlocks", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
