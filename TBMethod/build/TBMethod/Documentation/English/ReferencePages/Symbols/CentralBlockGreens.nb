Cell[TextData[{
 "The block lists must satisfy ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Length"]], "paclet:ref/Length"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    StyleBox["lowerBlocks", "TI"], "]"}], "\[Equal]", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       Cell[
        TextData["Length"]], "paclet:ref/Length"},
      "RefLink",
      BaseStyle->{"InlineFormula"}], "[", 
     StyleBox["diagonalBlocks", "TI"], "]"}], "-", "1"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "db0aab83-75a5-ff47-94c2-667bad3b6cf9"],
 ". Every self-energy acts on the last layer."
}], "Notes",
 CellID->447058316,ExpressionUUID->"83371ee1-f5e1-8c43-808e-0313fa668172"],

Cell[TextData[{
 "The default ",
 Cell[BoxData[
  StyleBox["mode", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a152dc8c-1dbe-424b-ab8a-bea294419517"],
 " is ",
