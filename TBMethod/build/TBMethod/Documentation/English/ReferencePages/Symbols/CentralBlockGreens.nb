  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e241e8e5-c506-d244-88e8-b31a4d79c3ce"],
 ", which returns only the last diagonal Green block."
}], "Notes",
 CellID->1084169808,ExpressionUUID->"d382cac1-7ce9-3144-acb9-05821ca74158"],

Cell[TextData[{
 "Modes ",
 Cell[BoxData["\"\<LDOS\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f9fd6de6-73a6-a642-be40-28c21e348450"],
 " and ",
