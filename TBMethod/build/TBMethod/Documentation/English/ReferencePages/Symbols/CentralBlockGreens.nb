Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   TagBox["D",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "de596014-6678-9043-ad90-e008142f274d"],
 " denote the diagonal block of the inverse Green matrix, including contact \
self-energies only on the final layer:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["D", "j"], "\[LongEqual]", 
     RowBox[{
      RowBox[{"z", " ", "\[DoubleStruckCapitalI]"}], "-", 
      SubscriptBox["H", 
       RowBox[{"{", 
        RowBox[{"j", ",", "j"}], "}"}]], "-", 
      RowBox[{
       TemplateBox[{
         RowBox[{"j", ",", "N"}]},
        "KroneckerDeltaSeq"], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"p", "=", "1"}], 
         SubscriptBox["N", "L"]], 
        SubscriptBox["\[CapitalSigma]", "p"]}]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "ca3fd0ea-8aeb-d44c-b77e-2f129f1897e6"]
}], "Notes",
 CellID->1628977580,ExpressionUUID->"8729980d-bfe0-b746-ab6d-b13db46f3284"],

Cell[TextData[{
 "The forward recursion for the left-connected Green blocks is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["F", "j"], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{"(", 
         RowBox[{
           SubscriptBox["D", "j"], "-", 
           RowBox[{
             SubscriptBox["H", 
              RowBox[{"{", 
                RowBox[{"j", ",", 
                  RowBox[{"j", "-", "1"}]}], "}"}]], ".", 
             SubscriptBox["F", 
              RowBox[{"j", "-", "1"}]], ".", 
             SubscriptBox["H", 
              RowBox[{"{", 
                RowBox[{
                  RowBox[{"j", "-", "1"}], ",", "j"}], "}"}]]}]}], ")"}]},
      "Inverse"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "734082ac-f603-a749-b32a-3b1605bc8548"]
}], "Notes",
 CellID->1293772939,ExpressionUUID->"785bb322-c9ab-ac43-9ff0-0017676266f9"]
}, Closed]],

