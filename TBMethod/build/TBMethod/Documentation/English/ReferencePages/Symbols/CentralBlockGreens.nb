Cell["\<\
There must be one fewer off-diagonal block than diagonal blocks. Every \
self-energy acts on the last layer.\
\>", "Notes",
 CellID->623991363,ExpressionUUID->"317d3c0c-1c47-6e4e-a490-29850b166de2"],

Cell[TextData[{
 "The default mode ",
 Cell[BoxData["\"\<T\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "30f2f92b-573d-fb42-8120-31f05762f30c"],
 " returns only the last diagonal Green block."
}], "Notes",
 CellID->419118877,ExpressionUUID->"807cc07b-4c90-5740-a616-800a08fb37f6"],

Cell[TextData[{
 "Modes ",
 Cell[BoxData["\"\<LDOS\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "451d8116-763f-e449-a32a-cc9d57dff951"],
 Cell[BoxData["and"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c4282784-c808-5243-a440-dedc050ec924"],
 Cell[BoxData["\"\<LCDV\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "10f9be8c-e499-b440-97a4-223c38b2bbbd"],
 " return the final block column in reverse layer order, beginning with its \
last diagonal block."
}], "Notes",
 CellID->1977762705,ExpressionUUID->"2d1aea08-8717-be43-9128-f85e7a2926a2"],

Cell["\<\
Upper off-diagonal blocks default to the conjugate transposes of the \
corresponding lower blocks.\
\>", "Notes",
 CellID->1350103236,ExpressionUUID->"3a854d3d-1437-2445-b2dc-44f160f2f985"],

Cell[TextData[{
 "Let D denote the diagonal block of the inverse Green matrix, including \
contact self-energies only on the final layer:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["D", "j"], "\[LongEqual]", 
     RowBox[{
      RowBox[{"z", " ", "\[DoubleStruckCapitalI]"}], "-", 
      SubscriptBox["H", 
       RowBox[{"{", 
        RowBox[{"j", ",", "j"}], "}"}]], "-", 
      RowBox[{
       TemplateBox[{
         RowBox[{"j", ",", "N"}]},
        "KroneckerDeltaSeq"], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"p", "=", "1"}], 
         SubscriptBox["N", "L"]], 
        SubscriptBox["\[CapitalSigma]", "p"]}]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "65d41aa9-a7b9-a34d-bbfc-1cad23da2cf3"]
}], "Notes",
 CellID->1773517785,ExpressionUUID->"92b23bea-629a-d84a-840c-3337246282ec"],

Cell[TextData[{
 "The forward recursion for the left-connected Green blocks is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["F", "j"], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{"(", 
         RowBox[{
           SubscriptBox["D", "j"], "-", 
           RowBox[{
             SubscriptBox["H", 
              RowBox[{"{", 
                RowBox[{"j", ",", 
                  RowBox[{"j", "-", "1"}]}], "}"}]], ".", 
             SubscriptBox["F", 
              RowBox[{"j", "-", "1"}]], ".", 
             SubscriptBox["H", 
              RowBox[{"{", 
                RowBox[{
                  RowBox[{"j", "-", "1"}], ",", "j"}], "}"}]]}]}], ")"}]},
      "Inverse"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "b24f1923-fc9f-4544-8e33-94d12eca93b0"]
}], "Notes",
 CellID->316222477,ExpressionUUID->"29e4130f-99ed-cd48-80ce-53bcfb45da0a"]
}, Closed]],

