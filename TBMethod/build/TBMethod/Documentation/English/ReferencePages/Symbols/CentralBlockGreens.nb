  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bab97548-47f2-c944-b398-4dd9058146e7"],
 "."
}], "Notes",
 CellID->229708614,ExpressionUUID->"51b7b01b-577d-e54d-b88c-c76c7c295220"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   TagBox["D",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "4805c092-f67c-3648-95f3-5a28303441ed"],
 " denote the diagonal block of the inverse Green matrix, including contact \
self-energies only on the final layer:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["D", "j"], "\[LongEqual]", 
     RowBox[{
      RowBox[{"z", " ", "\[DoubleStruckCapitalI]"}], "-", 
      SubscriptBox["H", 
       RowBox[{"{", 
        RowBox[{"j", ",", "j"}], "}"}]], "-", 
      RowBox[{
       TemplateBox[{
         RowBox[{"j", ",", "N"}]},
        "KroneckerDeltaSeq"], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"p", "=", "1"}], 
         SubscriptBox["N", "L"]], 
        SubscriptBox["\[CapitalSigma]", "p"]}]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "33819031-1cba-0541-a725-97d555dfe272"]
}], "Notes",
 CellID->1628977580,ExpressionUUID->"8c09edec-a692-0c4c-a0da-8d6562c0fc19"],

Cell[TextData[{
 "The forward recursion for the left-connected Green blocks is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["F", "j"], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{"(", 
         RowBox[{
           SubscriptBox["D", "j"], "-", 
           RowBox[{
             SubscriptBox["H", 
              RowBox[{"{", 
                RowBox[{"j", ",", 
                  RowBox[{"j", "-", "1"}]}], "}"}]], ".", 
             SubscriptBox["F", 
              RowBox[{"j", "-", "1"}]], ".", 
             SubscriptBox["H", 
              RowBox[{"{", 
                RowBox[{
                  RowBox[{"j", "-", "1"}], ",", "j"}], "}"}]]}]}], ")"}]},
      "Inverse"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "6783fc6d-4172-d145-a659-99a0e3584a99"]
}], "Notes",
 CellID->1293772939,ExpressionUUID->"b9197bee-1f98-f842-ab61-9e8d106063e3"]
}, Closed]],

