Cell[TextData[{
 "The block lists must satisfy ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"Length", "[", "lowerBlocks", "]"}], " ", "==", " ", 
   RowBox[{
    RowBox[{"Length", "[", "diagonalBlocks", "]"}], " ", "-", " ", "1"}]}]], 
  "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"83e8d03c-45de-1f41-bf6e-a762e2378910"],
 ". Every self-energy acts on the last layer."
}], "Notes",
 CellID->404268781,ExpressionUUID->"16f6ad2f-b75b-0545-af85-7d47413deaa0"],

Cell[TextData[{
 "The default ",
 Cell[BoxData[
  StyleBox["mode", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "93756f43-ce48-5d44-a458-3b94807746c0"],
 " is ",
 Cell[BoxData["\"\<T\>\""], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"d5b55b5e-6600-be48-93ee-835c2cec882a"],
 ", which returns only the last diagonal Green block."
}], "Notes",
 CellID->787572541,ExpressionUUID->"afad8453-a9a6-d547-9f5f-d65e8ebd3c89"],

Cell[TextData[{
 "Modes ",
 Cell[BoxData["\"\<LDOS\>\""], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"2ca86ac9-92ee-a940-a50b-251bd8a306f7"],
 " and ",
 Cell[BoxData["\"\<LCDV\>\""], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"7abfa823-c55a-ec4e-9053-4bb0fdc2523c"],
 " return the final block column in reverse layer order, beginning with its \
last diagonal block."
}], "Notes",
 CellID->1445346572,ExpressionUUID->"344daa30-b091-1147-837d-11e1098b7781"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  StyleBox["upperBlocks", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bb6e2cf2-3d17-7141-9fc7-c36eb4fe03ef"],
 " is omitted, the upper off-diagonal blocks are ",
 Cell[BoxData[
  RowBox[{"ConjugateTranspose", " ", "/@", " ", "lowerBlocks"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"b8c6c87c-3b56-1144-adf4-62cbcb49576c"],
 "."
}], "Notes",
 CellID->1203487489,ExpressionUUID->"bc288e36-5053-d344-8249-141f732b180c"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   TagBox["D",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "89deecee-f994-924d-aefa-868e199fe46d"],
 " denote the diagonal block of the inverse Green matrix, including contact \
self-energies only on the final layer:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["D", "j"], "\[LongEqual]", 
     RowBox[{
      RowBox[{"z", " ", "\[DoubleStruckCapitalI]"}], "-", 
      SubscriptBox["H", 
       RowBox[{"{", 
        RowBox[{"j", ",", "j"}], "}"}]], "-", 
      RowBox[{
       TemplateBox[{
         RowBox[{"j", ",", "N"}]},
        "KroneckerDeltaSeq"], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"p", "=", "1"}], 
         SubscriptBox["N", "L"]], 
        SubscriptBox["\[CapitalSigma]", "p"]}]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "65126ba5-5a40-3d41-9005-3fbcb9de3072"]
}], "Notes",
 CellID->1846420730,ExpressionUUID->"73601ea5-8c5e-d440-b934-207fdf87e7cb"],

Cell[TextData[{
 "The forward recursion for the left-connected Green blocks is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["F", "j"], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{"(", 
         RowBox[{
           SubscriptBox["D", "j"], "-", 
           RowBox[{
             SubscriptBox["H", 
              RowBox[{"{", 
                RowBox[{"j", ",", 
                  RowBox[{"j", "-", "1"}]}], "}"}]], ".", 
             SubscriptBox["F", 
              RowBox[{"j", "-", "1"}]], ".", 
             SubscriptBox["H", 
              RowBox[{"{", 
                RowBox[{
                  RowBox[{"j", "-", "1"}], ",", "j"}], "}"}]]}]}], ")"}]},
      "Inverse"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "0927f10d-6922-184d-83c1-004114e3dbd1"]
}], "Notes",
 CellID->1314080008,ExpressionUUID->"b63c190b-99c7-504b-bba2-f2b07120b164"]
}, Closed]],

