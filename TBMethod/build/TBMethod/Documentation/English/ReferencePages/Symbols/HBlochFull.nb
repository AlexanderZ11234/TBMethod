Cell[TextData[{
 "Every supplied displacement is included explicitly:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"H", "(", "k", ")"}], "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"j", "=", "1"}], "M"], 
      RowBox[{
       RowBox[{"exp", "(", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         RowBox[{
          SubscriptBox["R", "j"], ".", "k"}]}], ")"}], " ", 
       SubscriptBox["H", 
        SubscriptBox["R", "j"]]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "f8b3cc62-c6f0-1641-9c58-f26456e3a67c"]
}], "Notes",
 CellID->1691088016,ExpressionUUID->"6403b45a-12d5-584d-8dbd-7f82f567fdbe"]
}, Closed]],

