Cell[TextData[{
 "Every supplied displacement is included explicitly:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"H", "(", "k", ")"}], "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"j", "=", "1"}], "M"], 
      RowBox[{
       RowBox[{"exp", "(", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         RowBox[{
          SubscriptBox["R", "j"], ".", "k"}]}], ")"}], " ", 
       SubscriptBox["H", 
        SubscriptBox["R", "j"]]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "c5f92f86-0719-0647-bc74-2f80709c1c1a"]
}], "Notes",
 CellID->1691088016,ExpressionUUID->"28f42ab7-d2ff-2e43-9bfa-b91b8cafc0e6"]
}, Closed]],

