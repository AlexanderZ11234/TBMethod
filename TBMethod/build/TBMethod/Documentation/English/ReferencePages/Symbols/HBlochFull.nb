Cell[TextData[{
 "Every supplied displacement is included explicitly:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"H", "(", "k", ")"}], "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"j", "=", "1"}], "M"], 
      RowBox[{
       RowBox[{"exp", "(", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         RowBox[{
          SubscriptBox["R", "j"], ".", "k"}]}], ")"}], " ", 
       SubscriptBox["H", 
        SubscriptBox["R", "j"]]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "c48253df-43e5-2b43-8214-eeab46708d27"]
}], "Notes",
 CellID->991122322,ExpressionUUID->"e52b45e6-ac88-2f4f-8b94-cc33f1b4de1f"]
}, Closed]],

