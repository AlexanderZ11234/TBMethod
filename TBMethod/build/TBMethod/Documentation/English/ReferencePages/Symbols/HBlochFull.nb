Cell[TextData[{
 "Every supplied displacement is included explicitly:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"H", "(", "k", ")"}], "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"j", "=", "1"}], "M"], 
      RowBox[{
       RowBox[{"exp", "(", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         RowBox[{
          SubscriptBox["R", "j"], ".", "k"}]}], ")"}], " ", 
       SubscriptBox["H", 
        SubscriptBox["R", "j"]]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "b2465e23-167d-3749-91eb-5f609e176491"]
}], "Notes",
 CellID->180445708,ExpressionUUID->"7d7a7059-b2f3-8e4a-8bc0-7d7e82e54081"]
}, Closed]],

