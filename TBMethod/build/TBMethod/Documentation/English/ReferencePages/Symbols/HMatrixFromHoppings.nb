Cell["\<\
Rows refer to finalPoints and columns refer to initialPoints. hopping[rf, ri] \
must return a consistently sized matrix for the internal degrees of freedom.\
\>", "Notes",
 CellID->1402744529,ExpressionUUID->"ed694da5-cb2d-7447-9f66-c584f3fb7742"],

Cell[TextData[{
 "The distance argument must have head ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Real"]], "paclet:ref/Real"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "32444aab-62c4-c04a-be62-a722a8a2ef08"],
 ", for example 1.01 rather than the exact integer 1. Only pairs within this \
Euclidean cutoff are evaluated."
}], "Notes",
 CellID->515133461,ExpressionUUID->"4eccc19d-6281-8843-8106-ebaa23a13deb"],

Cell["\<\
Point sets may contain coordinate lists or rules label -> coordinates; labels \
are passed to the hopping function when present. Point sets must be nonempty.\
\
\>", "Notes",
 CellID->798161771,ExpressionUUID->"c259d7f8-cbd3-1648-9679-5dad44d26576"],

Cell[TextData[{
 "For unlabeled sites, the site-to-site matrix block is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["H", 
      RowBox[{"{", 
       RowBox[{"i", ",", "j"}], "}"}]], "\[LongEqual]", 
     RowBox[{"(", 
      TagBox[GridBox[{
         {"\[Piecewise]", GridBox[{
            {
             RowBox[{"t", "(", 
              RowBox[{
               SubscriptBox["r", "i"], ",", 
               SubscriptBox["r", "j"]}], ")"}], 
             RowBox[{
              TemplateBox[{
                RowBox[{
                  SubscriptBox["r", "i"], "-", 
                  SubscriptBox["r", "j"]}]},
               "Norm"], "\[LessEqual]", "d"}]},
            {"0", 
             TagBox["True",
              "PiecewiseDefault",
              AutoDelete->True]}
           },
           AllowedDimensions->{2, Automatic},
           Editable->True,
           GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
           GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
           GridBoxSpacings->{"Columns" -> {
