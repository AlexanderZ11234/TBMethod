Cell[TextData[{
 Cell[BoxData[
  RowBox[{"HMatrixFromHoppings", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["fpts",
       FontSlant->"Italic"], ",", " ", 
      StyleBox["ipts",
       FontSlant->"Italic"]}], 
     StyleBox["}",
      FontSlant->"Italic"]}], ",", " ", 
    StyleBox["tfunc",
     FontSlant->"Italic"], ",", " ", 
    SubscriptBox[
     StyleBox["d",
      FontSlant->"Italic"], "up"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0ce2acb9-3385-fd48-a4b7-3922e211fc74"],
 " constructs the real-space tight-binding Hamiltonian matrix from two sets \
of points (",
 Cell[BoxData[
  StyleBox["fpts",
   FontSlant->"Italic"]],ExpressionUUID->
  "c2132834-1ed5-0846-acf9-c2b2674f3fc5"],
 " and ",
 Cell[BoxData[
  StyleBox["ipts",
   FontSlant->"Italic"]],ExpressionUUID->
  "231b6632-94c4-684e-af8f-574ca1802054"],
 ") and a given hopping function ",
 Cell[BoxData[
  StyleBox["tfunc",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f4bbc0e6-a76a-6443-82c3-543fc63d7765"],
 " depending on the coordinates of one pair of points, within the space \
distance upper limit ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["d",
    FontSlant->"Italic"], "up"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7cdb453e-1467-f441-b141-59ff4db73d35"],
 ".\n",
 Cell[BoxData[
  RowBox[{"HMatrixFromHoppings", "[", 
   RowBox[{
    StyleBox["pts",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["tfunc",
     FontSlant->"Italic"], ",", " ", 
    SubscriptBox[
     StyleBox["d",
      FontSlant->"Italic"], "up"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fc2a0a4d-6df0-0c44-9c41-f47b109997f0"],
 " does the same thing within one set of points ",
 Cell[BoxData[
  StyleBox["pts",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "16a42529-eb02-f441-b426-73088b655225"],
 "."
}], "ExampleText",
 CellID->272985237,ExpressionUUID->"2fb78a79-76bb-e64b-92c9-5458a82a7d01"],

