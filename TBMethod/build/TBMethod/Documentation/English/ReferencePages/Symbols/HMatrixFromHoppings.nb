Cell[TextData[{
 Cell[BoxData[
  RowBox[{"HMatrixFromHoppings", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["fpts",
       FontSlant->"Italic"], ",", " ", 
      StyleBox["ipts",
       FontSlant->"Italic"]}], 
     StyleBox["}",
      FontSlant->"Italic"]}], ",", " ", 
    StyleBox["tfunc",
     FontSlant->"Italic"], ",", " ", 
    SubscriptBox[
     StyleBox["d",
      FontSlant->"Italic"], "up"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "951fec1c-514f-174b-8ac4-987e89f99cf9"],
 " constructs the real-space tight-binding Hamiltonian matrix from two sets \
of points (",
 Cell[BoxData[
  StyleBox["fpts",
   FontSlant->"Italic"]],ExpressionUUID->
  "0b552586-2dc3-4842-afe1-a4bf8390be8a"],
 " and ",
 Cell[BoxData[
  StyleBox["ipts",
   FontSlant->"Italic"]],ExpressionUUID->
  "8cfbaf5b-fbea-2d44-a9fd-834814e1512d"],
 ") and a given hopping function ",
 Cell[BoxData[
  StyleBox["tfunc",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e99c6895-f69c-7e44-934e-8566675373e7"],
 " depending on the coordinates of one pair of points, within the space \
distance upper limit ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["d",
    FontSlant->"Italic"], "up"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "aac24204-d8c7-0146-89dc-757fd2990c41"],
 ".\n",
 Cell[BoxData[
  RowBox[{"HMatrixFromHoppings", "[", 
   RowBox[{
    StyleBox["pts",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["tfunc",
     FontSlant->"Italic"], ",", " ", 
    SubscriptBox[
     StyleBox["d",
      FontSlant->"Italic"], "up"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "416cbfac-ee16-c041-b71c-6927a5a7a102"],
 " does the same thing within one set of points ",
 Cell[BoxData[
  StyleBox["pts",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "52d6e8dc-9396-b149-ab74-febcf9cbf131"],
 "."
}], "ExampleText",
 CellID->272985237,ExpressionUUID->"04d0cd6a-eca4-3346-a994-5bb03bb4e0a7"],

