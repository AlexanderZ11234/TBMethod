Cell[TextData[{
 Cell[BoxData[
  RowBox[{"HMatrixFromHoppings", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["fpts",
       FontSlant->"Italic"], ",", " ", 
      StyleBox["ipts",
       FontSlant->"Italic"]}], 
     StyleBox["}",
      FontSlant->"Italic"]}], ",", " ", 
    StyleBox["tfunc",
     FontSlant->"Italic"], ",", " ", 
    SubscriptBox[
     StyleBox["d",
      FontSlant->"Italic"], "up"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "622fdc4d-37c2-a34f-b5f1-ac8b7a208ee1"],
 " constructs the real-space tight-binding Hamiltonian matrix from two sets \
of points (",
 Cell[BoxData[
  StyleBox["fpts",
   FontSlant->"Italic"]],ExpressionUUID->
  "e92f06a4-74fb-4048-a7b3-eb48a46fc452"],
 " and ",
 Cell[BoxData[
  StyleBox["ipts",
   FontSlant->"Italic"]],ExpressionUUID->
  "11a78db4-6dc3-c34e-998d-5b0f37e2fc38"],
 ") and a given hopping function ",
 Cell[BoxData[
  StyleBox["tfunc",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c2019069-310c-ba40-bd5f-7d30220f5811"],
 " depending on the coordinates of one pair of points, within the space \
distance upper limit ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["d",
    FontSlant->"Italic"], "up"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5e1a3232-a010-b54f-a284-742be2482ebc"],
 ".\n",
 Cell[BoxData[
  RowBox[{"HMatrixFromHoppings", "[", 
   RowBox[{
    StyleBox["pts",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["tfunc",
     FontSlant->"Italic"], ",", " ", 
    SubscriptBox[
     StyleBox["d",
      FontSlant->"Italic"], "up"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ad81cd9a-f7a6-a54d-8baf-02860cd26f38"],
 " does the same thing within one set of points ",
 Cell[BoxData[
  StyleBox["pts",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a33ebf14-0281-0b4a-a360-4dd30d293804"],
 "."
}], "ExampleText",
 CellID->272985237,ExpressionUUID->"2bea3455-4c6f-b84d-b0b6-b1b9132f11f2"],

