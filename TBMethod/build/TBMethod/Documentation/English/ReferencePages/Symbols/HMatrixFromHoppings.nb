Cell[TextData[{
 Cell[BoxData[
  RowBox[{"HMatrixFromHoppings", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["fpts",
       FontSlant->"Italic"], ",", " ", 
      StyleBox["ipts",
       FontSlant->"Italic"]}], 
     StyleBox["}",
      FontSlant->"Italic"]}], ",", " ", 
    StyleBox["tfunc",
     FontSlant->"Italic"], ",", " ", 
    SubscriptBox[
     StyleBox["d",
      FontSlant->"Italic"], "up"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bea208dc-46b8-7c4a-b992-2668db33adef"],
 " constructs the real-space tight-binding Hamiltonian matrix from two sets \
of points (",
 Cell[BoxData[
  StyleBox["fpts",
   FontSlant->"Italic"]],ExpressionUUID->
  "e6318679-d88f-e942-bd50-2fbc1688b4c0"],
 " and ",
 Cell[BoxData[
  StyleBox["ipts",
   FontSlant->"Italic"]],ExpressionUUID->
  "7c94bddf-ea56-7247-ba6f-0620ddac3e22"],
 ") and a given hopping function ",
 Cell[BoxData[
  StyleBox["tfunc",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0924dc56-1f5a-6540-965e-d05e89e1ff3d"],
 " depending on the coordinates of one pair of points, within the space \
distance upper limit ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["d",
    FontSlant->"Italic"], "up"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7aba1b0b-77db-d14a-952b-8b5a81eefef7"],
 ".\n",
 Cell[BoxData[
  RowBox[{"HMatrixFromHoppings", "[", 
   RowBox[{
    StyleBox["pts",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["tfunc",
     FontSlant->"Italic"], ",", " ", 
    SubscriptBox[
     StyleBox["d",
      FontSlant->"Italic"], "up"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dbe62c42-b852-814f-9d8d-7752cd6c631f"],
 " does the same thing within one set of points ",
 Cell[BoxData[
  StyleBox["pts",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "18cc883d-59b9-c549-acd1-e794e316265b"],
 "."
}], "ExampleText",
 CellID->272985237,ExpressionUUID->"507d392e-6e82-fb4c-b3c2-1dbf3b24fa64"],

