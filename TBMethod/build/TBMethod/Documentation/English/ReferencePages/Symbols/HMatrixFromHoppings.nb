 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["H", 
      RowBox[{"{", 
       RowBox[{"i", ",", "j"}], "}"}]], "\[LongEqual]", 
     RowBox[{"(", 
      TagBox[GridBox[{
         {"\[Piecewise]", GridBox[{
            {
             RowBox[{"t", "(", 
              RowBox[{
               SubscriptBox["r", "i"], ",", 
               SubscriptBox["r", "j"]}], ")"}], 
             RowBox[{
              TemplateBox[{
                RowBox[{
                  SubscriptBox["r", "i"], "-", 
                  SubscriptBox["r", "j"]}]},
               "Norm"], "\[LessEqual]", "d"}]},
            {"0", 
             TagBox["True",
              "PiecewiseDefault",
              AutoDelete->True]}
