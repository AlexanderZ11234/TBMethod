Cell[TextData[{
 Cell[BoxData[
  RowBox[{"HMatrixFromHoppings", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["fpts",
       FontSlant->"Italic"], ",", " ", 
      StyleBox["ipts",
       FontSlant->"Italic"]}], 
     StyleBox["}",
      FontSlant->"Italic"]}], ",", " ", 
    StyleBox["tfunc",
     FontSlant->"Italic"], ",", " ", 
    SubscriptBox[
     StyleBox["d",
      FontSlant->"Italic"], "up"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7db6a053-e46e-184e-b978-713a68e2dc6a"],
 " constructs the real-space tight-binding Hamiltonian matrix from two sets \
of points (",
 Cell[BoxData[
  StyleBox["fpts",
   FontSlant->"Italic"]],ExpressionUUID->
  "3a500d37-9685-a34a-9ace-b1b23a9f8c44"],
 " and ",
 Cell[BoxData[
  StyleBox["ipts",
   FontSlant->"Italic"]],ExpressionUUID->
  "805a2d9f-16ac-a44c-b8ca-8f0b81701be6"],
 ") and a given hopping function ",
 Cell[BoxData[
  StyleBox["tfunc",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6aff212e-a855-5449-9bea-aafa3422c8da"],
 " depending on the coordinates of one pair of points, within the space \
distance upper limit ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["d",
    FontSlant->"Italic"], "up"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "48fd6160-e7e7-2c40-b38c-086324d5f253"],
 ".\n",
 Cell[BoxData[
  RowBox[{"HMatrixFromHoppings", "[", 
   RowBox[{
    StyleBox["pts",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["tfunc",
     FontSlant->"Italic"], ",", " ", 
    SubscriptBox[
     StyleBox["d",
      FontSlant->"Italic"], "up"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e5fbaccc-43ab-2848-9733-42cf549cd652"],
 " does the same thing within one set of points ",
 Cell[BoxData[
  StyleBox["pts",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e1766a9a-97cb-9e44-97c4-d979307c8577"],
 "."
}], "ExampleText",
 CellID->272985237,ExpressionUUID->"5001c979-ac0a-6949-8644-2e99d992166c"],

