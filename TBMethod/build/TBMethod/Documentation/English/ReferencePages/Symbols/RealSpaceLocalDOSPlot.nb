Cell[TextData[{
 "Site weights sum squared eigenvector amplitudes over internal states. Only \
weights satisfying ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["w", "i"], ">", 
    FractionBox["1", 
     SuperscriptBox["10", "4"]]}], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "917ac39e-e59f-2b42-ae4b-4cc5bf1ab2e1"],
 " are retained."
}], "Notes",
 CellID->427071155,ExpressionUUID->"b66c6965-466b-7740-8588-e2d6a0f67b70"],

Cell[TextData[{
 "The input must satisfy ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Length"]], "paclet:ref/Length"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    StyleBox["eigenvector", "TI"], "]"}], "\[Equal]", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       Cell[
        TextData["Length"]], "paclet:ref/Length"},
      "RefLink",
      BaseStyle->{"InlineFormula"}], "[", 
     StyleBox["points", "TI"], "]"}], " ", 
