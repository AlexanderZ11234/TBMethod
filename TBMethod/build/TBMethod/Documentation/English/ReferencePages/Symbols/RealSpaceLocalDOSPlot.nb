Cell[TextData[{
 "Site weights sum squared eigenvector amplitudes over internal states. Only \
weights satisfying ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["w", "i"], ">", 
    FractionBox["1", 
     SuperscriptBox["10", "4"]]}], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "95a465de-de96-2a4e-940c-8cf92bb26641"],
 " are retained."
}], "Notes",
 CellID->1805112382,ExpressionUUID->"f353f4f1-a58a-2247-876a-10e5a467931a"],

Cell[TextData[{
 "The input must satisfy ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"Length", "[", "eigenvector", "]"}], " ", "==", " ", 
   RowBox[{
    RowBox[{"Length", "[", "points", "]"}], " ", "internalDimension"}]}]], 
  "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"ece43fa7-f91c-4f40-a8e9-de118dc22044"],
 ". Three-dimensional coordinates are projected onto the first two \
coordinates and combined by position."
}], "Notes",
 CellID->1255369707,ExpressionUUID->"bfb0a351-fa85-f040-8785-9f21cb393e81"],

Cell[TextData[{
 "The output includes a convex-hull outline and an energy label. ",
