Cell[TextData[{
 "Site weights sum squared eigenvector amplitudes over internal states. Only \
weights satisfying ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["w", "i"], ">", 
    FractionBox["1", 
     SuperscriptBox["10", "4"]]}], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "c11e23d9-c92b-9543-a6df-65e5ae38600d"],
 " are retained."
}], "Notes",
 CellID->427071155,ExpressionUUID->"0d502677-6fb6-e54b-b308-4a0898ca9357"],

Cell[TextData[{
 "The input must satisfy ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Length"]], "paclet:ref/Length"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    StyleBox["eigenvector", "TI"], "]"}], "\[Equal]", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       Cell[
        TextData["Length"]], "paclet:ref/Length"},
      "RefLink",
      BaseStyle->{"InlineFormula"}], "[", 
     StyleBox["points", "TI"], "]"}], " ", 
    StyleBox["internalDimension", "TI"]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6507d067-1753-bc40-bd45-37535dcca3fa"],
 ". Three-dimensional coordinates are projected onto the first two \
coordinates and combined by position."
}], "Notes",
 CellID->1887620986,ExpressionUUID->"41575928-9b2f-c24e-991a-285c89be3044"],

