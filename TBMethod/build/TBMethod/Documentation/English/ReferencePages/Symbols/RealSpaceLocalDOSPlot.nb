Cell[TextData[{
 "Site weights sum squared eigenvector amplitudes over internal states. Only \
weights satisfying ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["w", "i"], ">", 
    FractionBox["1", 
     SuperscriptBox["10", "4"]]}], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "91089f11-b245-d941-b969-ba04611d149f"],
 " are retained."
}], "Notes",
 CellID->1825804447,ExpressionUUID->"82dd7bce-d7dd-5d48-a907-bd0608201a82"],

Cell[TextData[{
 "The input must satisfy ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Length"]], "paclet:ref/Length"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    StyleBox["eigenvector", "TI"], "]"}], "\[Equal]", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       Cell[
        TextData["Length"]], "paclet:ref/Length"},
      "RefLink",
      BaseStyle->{"InlineFormula"}], "[", 
     StyleBox["points", "TI"], "]"}], " ", 
    StyleBox["internalDimension", "TI"]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9bd7040c-0f58-6d4d-b1b5-41bb759f1e9a"],
 ". Three-dimensional coordinates are projected onto the first two \
coordinates and combined by position."
}], "Notes",
 CellID->2093594469,ExpressionUUID->"a67c5293-e9d2-434e-91a6-d98240f7e3d1"],

