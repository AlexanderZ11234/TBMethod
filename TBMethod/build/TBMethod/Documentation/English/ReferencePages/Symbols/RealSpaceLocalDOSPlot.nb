Cell[TextData[{
 "Site weights sum squared eigenvector amplitudes over internal states. Only \
weights satisfying ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["w", "i"], ">", 
    FractionBox["1", 
     SuperscriptBox["10", "4"]]}], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "d1eb1d8f-5ec3-d142-b20f-0e2a768eab79"],
 " are retained."
}], "Notes",
 CellID->427071155,ExpressionUUID->"1650f9f6-a2cd-a449-ba18-d623bb34b4b0"],

Cell[TextData[{
 "The input must satisfy ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Length"]], "paclet:ref/Length"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    StyleBox["eigenvector", "TI"], "]"}], "\[Equal]", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       Cell[
        TextData["Length"]], "paclet:ref/Length"},
      "RefLink",
      BaseStyle->{"InlineFormula"}], "[", 
     StyleBox["points", "TI"], "]"}], " ", 
    StyleBox["internalDimension", "TI"]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fdf76371-789d-0240-ad92-3d703e1429ad"],
 ". Three-dimensional coordinates are projected onto the first two \
coordinates and combined by position."
}], "Notes",
 CellID->1887620986,ExpressionUUID->"95e60817-8588-8047-aebf-836200490052"],

