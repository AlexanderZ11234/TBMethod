Cell[TextData[{
 "The string option ",
 Cell[BoxData["\"\<StateFunction\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "543fe46c-1218-6247-a789-91d6e844c793"],
 " defaults to ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Total"]], "paclet:ref/Total"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    SuperscriptBox[
     RowBox[{
      TemplateBox[{
        Cell[
         TextData["Abs"]], "paclet:ref/Abs"},
       "RefLink",
       BaseStyle->{"InlineFormula"}], "[", "#1", "]"}], "4"], "]"}], "&"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "99cebd3d-ab8c-3f48-b6f9-d8942ce319ad"],
 ", the inverse participation ratio of a normalized state."
}], "Notes",
 CellID->1337439450,ExpressionUUID->"ebce4935-fbab-da42-bd74-e7a2214165b0"],

Cell[TextData[{
 Cell[BoxData["\"\<StateFunction\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8beb3f72-3f90-8447-a063-49806bb72ffd"],
 " must be an anonymous ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Function"]], "paclet:ref/Function"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2f7a026f-eda7-3b49-a5ba-0bc035205871"],
 " or a nonempty list of anonymous functions, matching ",
 Cell[BoxData["_Function"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ddfec406-cbd0-6f4e-89a7-641a4c48f1ce"],
 " or ",
 Cell[BoxData[
  RowBox[{"{", "__Function", "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "31d74799-1384-f04a-8c15-89dbd6bb98d9"],
 ". Named functions do not match these implementation checks."
}], "Notes",
 CellID->1068202585,ExpressionUUID->"5a4aabb8-38a4-304f-bc0a-1d6e25dade5e"],

Cell[TextData[{
 "With one state function, the output is grouped by sample and contains ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["energy", "TI"], ",", 
    StyleBox["weight", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "24bc9a29-a78d-1b46-9f34-17edb3e9bfca"],
 " pairs. With several functions, the outer index selects the state \
function."
}], "Notes",
 CellID->1226759553,ExpressionUUID->"972512ab-c013-c744-bac9-b8ef6bb57fbb"],

Cell[TextData[{
 "Omitting ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "665e97fa-0435-9e46-adcc-690fe4658e1d"],
 " requests the matrix dimension. Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigensystem"]], "paclet:ref/Eigensystem"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2fbc3160-b1a1-2243-bca6-1329140fc1a2"],
 " are filtered and passed through; the implementation supplies ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Method"]], "paclet:ref/Method"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{"\"\<Arnoldi\>\"", ",", 
     RowBox[{"\"\<MaxIterations\>\"", "\[Rule]", "\[Infinity]"}]}], "}"}]}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8ec3ee16-0beb-ef40-8551-d301ebcc4bc5"],
 "."
}], "Notes",
 CellID->749399711,ExpressionUUID->"55cf05f4-3929-014c-906d-f33f700e3017"],

Cell[TextData[{
 "For a small full-spectrum calculation, use ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Method"]], "paclet:ref/Method"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", "\"\<Direct\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7e34b0a5-1878-eb4f-afa5-36389a806063"],
 " to avoid requesting the complete spectrum from the default Arnoldi \
solver."
}], "Notes",
 CellID->544592705,ExpressionUUID->"370dc0ec-2f7d-f44d-ad3c-cdf6b003bc11"],

Cell[TextData[{
 "For a normalized eigenstate, the default weight is its inverse \
participation ratio:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"IPR", "(", "\[Psi]", ")"}], "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"a", "=", "1"}], "d"], 
      SuperscriptBox[
       TemplateBox[{
         SubscriptBox["\[Psi]", "a"]},
        "Abs"], "4"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "a885f54b-809b-f743-8b45-c86dca8a16e7"]
}], "Notes",
 CellID->666836071,ExpressionUUID->"72a2c22f-90dc-964a-9b96-8ef1d39bf907"]
}, Closed]],

