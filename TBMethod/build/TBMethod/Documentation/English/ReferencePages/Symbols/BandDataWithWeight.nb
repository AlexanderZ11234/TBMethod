Cell[TextData[{
 "For a normalized eigenstate, the default weight is its inverse \
participation ratio:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"IPR", "(", "\[Psi]", ")"}], "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"a", "=", "1"}], "d"], 
      SuperscriptBox[
       TemplateBox[{
         SubscriptBox["\[Psi]", "a"]},
        "Abs"], "4"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "b1020f3c-4f4f-3b49-9d8e-cd82e932d592"]
}], "Notes",
 CellID->1743083582,ExpressionUUID->"e3921017-25a7-2444-8d94-32f742b932dc"]
}, Closed]],

