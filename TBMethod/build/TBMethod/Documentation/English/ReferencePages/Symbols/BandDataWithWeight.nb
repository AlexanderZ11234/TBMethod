Cell[TextData[{
 "With one state function, the output is grouped by sample and contains ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["energy", "TI"], ",", 
    StyleBox["weight", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1c8eeef6-a2be-924e-93ae-bc257146b953"],
 " pairs. With several functions, the outer index selects the state \
function."
}], "Notes",
 CellID->927933780,ExpressionUUID->"ca2a3a12-aa17-8e42-acae-bfa15448627d"],

