Cell[TextData[{
 "For a normalized eigenstate, the default weight is its inverse \
participation ratio:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"IPR", "(", "\[Psi]", ")"}], "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"a", "=", "1"}], "d"], 
      SuperscriptBox[
       TemplateBox[{
         SubscriptBox["\[Psi]", "a"]},
        "Abs"], "4"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "bab2c1b9-6eac-a04e-9ab5-7ccfab775e65"]
}], "Notes",
 CellID->787646386,ExpressionUUID->"d6908f01-5fb7-374a-922c-f45bac8c80e7"]
}, Closed]],

