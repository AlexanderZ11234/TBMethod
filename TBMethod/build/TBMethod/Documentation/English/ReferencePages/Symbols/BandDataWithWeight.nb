Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "h", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "k_", "]"}], ":=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "4."}], "-", "k"}], ",", 
      RowBox[{"-", "2."}], ",", "1.", ",", 
      RowBox[{"5.", "\[VeryThinSpace]", "+", "k"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"BandDataWithWeight", "[", 
  RowBox[{"h", ",", 
   RowBox[{"{", 
    RowBox[{"0.", ",", "0.5"}], "}"}], ",", 
   RowBox[{"Method", "\[Rule]", "\"\<Direct\>\""}]}], "]"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->554519731,ExpressionUUID->"fdccca3c-9608-ef45-8302-f57928ebe281"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4.`"}], ",", "1.`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "2.`"}], ",", "1.`"}], "}"}], ",", 
     RowBox[{"{", 
