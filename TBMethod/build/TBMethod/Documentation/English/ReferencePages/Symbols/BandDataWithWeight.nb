Cell[TextData[{
 "The string option ",
 Cell[BoxData["\"\<StateFunction\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6f772f97-5fe2-1644-8f12-2d8354fb89d8"],
 " defaults to ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Total"]], "paclet:ref/Total"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    SuperscriptBox[
     RowBox[{
      TemplateBox[{
        Cell[
         TextData["Abs"]], "paclet:ref/Abs"},
       "RefLink",
       BaseStyle->{"InlineFormula"}], "[", "#1", "]"}], "4"], "]"}], "&"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "224041f4-fe16-2344-ab9e-a6b58bc98e0f"],
 ", the inverse participation ratio of a normalized state."
}], "Notes",
 CellID->1337439450,ExpressionUUID->"158eed1c-b8d9-cc4d-8414-c90bb9ed3f3b"],

Cell[TextData[{
 Cell[BoxData["\"\<StateFunction\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b0f5f316-0238-ff41-ad5e-46c889379003"],
 " must be an anonymous ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Function"]], "paclet:ref/Function"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d3ab0693-598e-0944-b59e-f46d9e36afec"],
 " or a nonempty list of anonymous functions, matching ",
 Cell[BoxData["_Function"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "25eed0f4-e8bc-0643-8432-56409796c39f"],
 " or ",
 Cell[BoxData[
  RowBox[{"{", "__Function", "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "167cc661-6504-f046-84d4-4dc38f9e2ab3"],
 ". Named functions do not match these implementation checks."
}], "Notes",
 CellID->1068202585,ExpressionUUID->"f6e98458-1feb-e94e-8513-44322044ae3d"],

Cell[TextData[{
 "With one state function, the output is grouped by sample and contains ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["energy", "TI"], ",", 
    StyleBox["weight", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c6918301-3741-bf47-9caf-5b9030e8366c"],
 " pairs. With several functions, the outer index selects the state \
function."
}], "Notes",
 CellID->1226759553,ExpressionUUID->"f3da9e47-afc0-154a-9e2a-f0cbb3178e2d"],

Cell[TextData[{
 "Omitting ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "74977ad8-976e-874b-a123-33455356d26b"],
 " requests the matrix dimension. Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigensystem"]], "paclet:ref/Eigensystem"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e380edf2-2d38-f941-8fc0-5ca31d81f014"],
 " are filtered and passed through; the implementation supplies ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Method"]], "paclet:ref/Method"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{"\"\<Arnoldi\>\"", ",", 
     RowBox[{"\"\<MaxIterations\>\"", "\[Rule]", "\[Infinity]"}]}], "}"}]}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c859e06d-f3d3-5c42-ac99-ee92f97dd194"],
 "."
}], "Notes",
 CellID->749399711,ExpressionUUID->"4e50f900-7335-e542-8fcd-bc2379509375"],

Cell[TextData[{
 "For a small full-spectrum calculation, use ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Method"]], "paclet:ref/Method"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", "\"\<Direct\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d14d3222-6be4-0040-82b1-65f2e5801e95"],
 " to avoid requesting the complete spectrum from the default Arnoldi \
solver."
}], "Notes",
 CellID->544592705,ExpressionUUID->"afa0432a-f6dc-0041-919e-6309377839cc"],

Cell[TextData[{
 "For a normalized eigenstate, the default weight is its inverse \
participation ratio:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"IPR", "(", "\[Psi]", ")"}], "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"a", "=", "1"}], "d"], 
      SuperscriptBox[
       TemplateBox[{
         SubscriptBox["\[Psi]", "a"]},
        "Abs"], "4"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "915428e1-1077-fb43-9759-91ee02528b33"]
}], "Notes",
 CellID->666836071,ExpressionUUID->"bd091bb0-9ee7-5b41-956c-2b726162ab69"]
}, Closed]],

