Cell["\<\
The string option \"StateFunction\" defaults to Total[Abs[#]^4]&, the inverse \
participation ratio of a normalized state.\
\>", "Notes",
 CellID->1287415495,ExpressionUUID->"27488a56-ef13-074b-a307-f294e65a2d38"],

Cell[TextData[{
 "\"StateFunction\" must be an anonymous ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Function"]], "paclet:ref/Function"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1532c7f0-9ee3-0c4a-8096-5fa348428f4b"],
 " or a nonempty list of anonymous functions; named functions do not match \
this option's implementation checks."
}], "Notes",
 CellID->794154072,ExpressionUUID->"d9bc6305-f4da-1d45-89ae-5f28262a5e76"],

Cell["\<\
With one state function, the output is grouped by sample and contains \
{energy, weight} pairs; with several functions, the output is grouped first \
by state function.\
\>", "Notes",
 CellID->587677429,ExpressionUUID->"2a377aa7-a658-264a-8bfd-4a1a27c9225c"],

Cell[TextData[{
 "Omitting n requests the matrix dimension. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigensystem"]], "paclet:ref/Eigensystem"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4fbeeb97-96f9-dd4a-a379-5f8f74a99d23"],
 " options are filtered and passed through; the implementation supplies \
Method -> {\"Arnoldi\", \"MaxIterations\" -> Infinity}."
}], "Notes",
 CellID->908758607,ExpressionUUID->"bea7e015-4ccf-4740-b59f-76e3df96c831"],

Cell[TextData[{
 "For a normalized eigenstate, the default weight is its inverse \
participation ratio:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"IPR", "(", "\[Psi]", ")"}], "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"a", "=", "1"}], "d"], 
      SuperscriptBox[
       TemplateBox[{
         SubscriptBox["\[Psi]", "a"]},
        "Abs"], "4"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "14cdcd7a-bf54-b249-bd89-59f1487f7e0b"]
}], "Notes",
 CellID->831249892,ExpressionUUID->"63afc704-eb4b-1249-854a-07f5546d7a97"]
}, Closed]],

