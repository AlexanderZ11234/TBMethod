 CellID->1426226421,ExpressionUUID->"f434cdc7-bf76-fe42-b6f4-f0c253bb3dfe"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "h", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "k_", "]"}], ":=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "4."}], "-", "k"}], ",", 
      RowBox[{"-", "2."}], ",", "1.", ",", 
      RowBox[{"5.", "\[VeryThinSpace]", "+", "k"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"BandDataWithWeight", "[", 
  RowBox[{"h", ",", 
   RowBox[{"{", 
    RowBox[{"0.", ",", "0.5"}], "}"}], ",", 
   RowBox[{"Method", "\[Rule]", "\"\<Direct\>\""}]}], "]"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->554519731,ExpressionUUID->"4fba2aba-7201-e54a-8926-54ca4dbc7386"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4.`"}], ",", "1.`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
