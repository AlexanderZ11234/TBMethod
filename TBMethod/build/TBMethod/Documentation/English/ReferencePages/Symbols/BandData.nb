Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", "h", "]"}], ";", 
  RowBox[{
   RowBox[{"h", "[", "k_", "]"}], ":=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "1.`"}], "-", "k"}], ",", 
      RowBox[{"1.`", "\[VeryThinSpace]", "+", "k"}]}], "}"}], "]"}]}], ";", 
  RowBox[{"result", "=", 
   RowBox[{"BandData", "[", 
    RowBox[{"h", ",", 
     RowBox[{"{", 
      RowBox[{"0.`", ",", "0.5`", ",", "1.`"}], "}"}]}], "]"}]}], ";", 
  "result"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->925490288,ExpressionUUID->"d685ffce-8886-7348-83ba-848a3930895d"],

Cell[BoxData[
