Cell["\<\
Projects site coordinates onto the normalized normalVector, rescales the \
resulting range to [-1, 1] and applies Sign[x] Abs[x]^power.\
\>", "Notes",
 CellID->1971217886,ExpressionUUID->"514cb850-69fc-ca47-80ad-349ddd4b1351"],

Cell["\<\
Repeats each diagonal weight for every internal degree of freedom and returns \
a sparse matrix.\
\>", "Notes",
 CellID->287073866,ExpressionUUID->"b5b6f359-c9a3-6a43-85c0-5406ebdab359"],

Cell["\<\
Points may carry labels. The normal vector must be nonzero, and projected \
coordinates must span a nonzero range.\
\>", "Notes",
 CellID->1697644502,ExpressionUUID->"7cea7d8a-84a2-3c44-b8d5-a8d38b5552ee"],

Cell["\<\
Opposite edges receive opposite signs; cancellation can occur for a state \
occupying both edges equally.\
\>", "Notes",
 CellID->1405338128,ExpressionUUID->"f2ffcd4a-6483-554e-92a7-cf4487c56cc0"]
}, Closed]],

