Cell[BoxData[
 RowBox[{
  RowBox[{"ParallelNeeds", "[", "\"\<TBMethod`\>\"", "]"}], ";", 
  RowBox[{"crystal", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.`", ",", "0.`"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"0.`", ",", "0.`"}], "}"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1.`", ",", "0.`"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1.`", ",", "0.`"}], "}"}], "}"}]}]}], "]"}]}], ";", 
  RowBox[{"hop", "=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rf", ",", "ri"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          TemplateBox[{
            RowBox[{"rf", "-", "ri"}]},
           "Norm"], "<", "0.001`"}], ",", "0.`", ",", 
         RowBox[{"-", "1.`"}]}], "]"}], "}"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"result", "=", 
   RowBox[{"ParallelHMatricesRealSpace", "[", 
    RowBox[{"crystal", ",", "hop", ",", "1.01`"}], "]"}]}], ";", 
  "result"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->1479819089,ExpressionUUID->"bb8d2682-a1ca-4343-a150-122082b83430"],

