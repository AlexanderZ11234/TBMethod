Cell["\<\
crystal is an ordered association displacement -> cellPoints. The first value \
supplies the reference initial cell, so place the home cell first.\
\>", "Notes",
 CellID->1521506695,ExpressionUUID->"62c77232-0cd5-3245-888a-9d2b072fa50f"],

Cell["\<\
The returned association preserves displacement keys. Each value is a \
Hamiltonian block with rows belonging to that cell and columns belonging to \
the reference cell.\
\>", "Notes",
 CellID->187762101,ExpressionUUID->"01e5671c-49f4-284c-ae4f-8aca512ff9cf"],

Cell["Use a real-valued distance cutoff such as 1.01.", "Notes",
 CellID->945996726,ExpressionUUID->"b469b74d-71d5-1646-b222-99ea541bf451"],

Cell["Each block uses ParallelHMatrixFromHoppings.", "Notes",
 CellID->568147157,ExpressionUUID->"272028d4-f150-b642-a3ad-1312d1e35d66"]
}, Closed]],

