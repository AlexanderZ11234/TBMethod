Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RegionPolarSample", "[", 
   RowBox[{Cell["reg",
     FontSlant->"Italic",ExpressionUUID->
     "ad2fd246-e8ea-4f44-ac4f-4c1ea016f088"], ",", " ", Cell[TextData[
    StyleBox["\[Rho]num",
     FontSlant->"Italic"]],ExpressionUUID->
     "ddfee02f-c383-b749-a69d-316cc094e51b"], ",", " ", Cell[TextData[
    StyleBox["\[Phi]rat",
     FontSlant->"Italic"]],ExpressionUUID->
     "0244fb2e-a8b3-2e4c-a74f-dc7ab81b5826"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9c56a657-f949-3a43-bd92-4ee340264f20"],
 "  samples a 2D region ",
 Cell[BoxData[Cell["reg",
   FontSlant->"Italic",ExpressionUUID->
   "e3c04dff-1819-5647-861a-89dd2b01286d"]],ExpressionUUID->
  "e94813d4-cab9-6c4f-bc7d-a9a50d5bd02d"],
 " in the polar coordinate style from its center, where ",
 Cell[BoxData[Cell[TextData[StyleBox["\[Rho]num",
   FontSlant->"Italic"]],ExpressionUUID->
   "750b5f01-7824-9743-9649-5ef1744806b2"]],ExpressionUUID->
  "cc615528-9293-314e-9745-1a1166468345"],
 " is the sampling number in the radial direction and ",
 Cell[BoxData[Cell[TextData[StyleBox["\[Phi]rat",
   FontSlant->"Italic"]],ExpressionUUID->
   "256f7073-b6c7-2847-9db8-15a3734febf0"]],ExpressionUUID->
  "f6b7bbd2-8051-5240-8e13-1ee22149b7b7"],
 " is the ratio of samplings in the azimuthal direction to the base number \
two."
}], "ExampleText",
 CellID->803019282,ExpressionUUID->"71d7f10d-e9d6-4842-b2b0-0b8d5240078a"],

