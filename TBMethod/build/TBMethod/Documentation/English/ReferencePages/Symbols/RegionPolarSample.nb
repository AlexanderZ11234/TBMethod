Cell[TextData[{
 "The implementation uses ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PolygonCoordinates"]], "paclet:ref/PolygonCoordinates"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3b0662c1-fe78-8949-bcfa-c3407ad2e45f"],
 " and a fixed center ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0.", ",", "0."}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f05d5845-db46-fe49-be56-eefb43d41a42"],
 ". Use an origin-centered two-dimensional polygon whose vertices can be \
ordered by polar angle."
}], "Notes",
 CellID->724847621,ExpressionUUID->"08ea270e-7479-8642-b46f-6e4a9b8a40c8"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["nRadial", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b53cdc9f-b70d-1b49-8d3a-eb274551e45e"],
 " should be a positive integer and ",
 Cell[BoxData[
  StyleBox["angularScale", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "439197b7-70ac-9743-9d20-3870e5216ff5"],
 " must be positive. The origin itself is omitted."
}], "Notes",
 CellID->1496318420,ExpressionUUID->"0645a9fc-10a2-5844-8a11-ff2ab49eb0cc"],

Cell[TextData[{
 "The radial construction returns ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"nRadial", "+", "1"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "009d8656-dd31-fd47-bdbe-34e79ef2a00b"],
 " loops: scales ",
 Cell[BoxData[
  FormBox[
   TagBox[
    FractionBox["1", "nRadial"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "f2ef8819-0828-ca45-8f1e-a67078385296"],
 " through ",
 Cell[BoxData[
  FormBox[
   TagBox["1",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "316d6e52-4f82-bc42-958a-177bc9873dc9"],
 ", followed by an additional outer-boundary loop. The two outer loops have \
the same radius but different sampling densities."
}], "Notes",
 CellID->814360286,ExpressionUUID->"0407a26b-3e93-9441-b247-9092d57ce985"],

Cell[TextData[{
 "For loop index ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cda575f5-d6a8-464f-bf56-9f5ab68c2e6c"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PathSample"]], "paclet:TBMethod/ref/PathSample", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3f38a75d-9dbc-3e47-96ed-5a523c26e5b5"],
 " uses ",
 Cell[BoxData[
  RowBox[{"1", "+", 
