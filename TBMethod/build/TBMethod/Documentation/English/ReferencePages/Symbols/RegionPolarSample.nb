Cell[TextData[{
 "The implementation uses ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PolygonCoordinates"]], "paclet:ref/PolygonCoordinates"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fc191d08-d1bc-e249-ba06-f7569bf436ec"],
 " and a fixed center ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0.", ",", " ", "0."}], "}"}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"0f5385c9-23b1-c042-ad06-8873e546ce2e"],
 ". Use an origin-centered two-dimensional polygon whose vertices can be \
ordered by polar angle."
}], "Notes",
 CellID->1253632353,ExpressionUUID->"83b0a2b7-2526-794f-9e44-3d3a9f5493c0"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["nRadial", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4899770b-f7d7-c642-9b6d-9dc413557d97"],
 " should be a positive integer and ",
 Cell[BoxData[
  StyleBox["angularScale", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "faf866d4-6bb2-e84c-8300-0453afe8aeb5"],
 " must be positive. The origin itself is omitted."
}], "Notes",
 CellID->1919411362,ExpressionUUID->"8b822c9b-12dd-3442-b61c-2b40f792f30b"],

Cell[TextData[{
 "The radial construction returns ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"nRadial", "+", "1"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "38658ee7-7353-ca48-826f-c9929295ccdb"],
 " loops: scales ",
 Cell[BoxData[
  FormBox[
   TagBox[
    FractionBox["1", "nRadial"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "48a2f659-3793-7547-9c93-73c02e88d15d"],
 " through ",
 Cell[BoxData[
  FormBox[
   TagBox["1",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "62d41611-024c-a547-8f42-66af7a5ff57f"],
 ", followed by an additional outer-boundary loop. The two outer loops have \
the same radius but different sampling densities."
}], "Notes",
 CellID->2025409615,ExpressionUUID->"142d2202-0956-3742-9c2c-22d75ba7ebd4"],

Cell[TextData[{
 "For loop index ",
