Cell[TextData[{
 "The implementation uses ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PolygonCoordinates"]], "paclet:ref/PolygonCoordinates"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b939940a-3fbf-c049-9218-5ca72907d830"],
 " and a fixed center ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0.", ",", "0."}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9f222836-0542-d542-b547-514787ba747d"],
 ". Use an origin-centered two-dimensional polygon whose vertices can be \
ordered by polar angle."
}], "Notes",
 CellID->229573119,ExpressionUUID->"3c08bd73-59ac-fc4d-88c9-333f38f154dc"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["nRadial", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b426402c-6bba-8445-8f51-d1cfdd31b3a8"],
 " should be a positive integer and ",
 Cell[BoxData[
  StyleBox["angularScale", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ccf182e3-fd9c-8c45-887c-555d5d83b33e"],
 " must be positive. The origin itself is omitted."
}], "Notes",
 CellID->1001264819,ExpressionUUID->"9fd90984-8f7e-444e-9873-714313b7c3e2"],

Cell[TextData[{
 "The radial construction returns ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"nRadial", "+", "1"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "ca62e1ac-30ed-2c4e-b408-0c5d87bf8e14"],
 " loops: scales ",
 Cell[BoxData[
  FormBox[
   TagBox[
    FractionBox["1", "nRadial"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "08030d14-eb0c-e94e-9ccb-af4c202b1c18"],
 " through ",
 Cell[BoxData[
  FormBox[
   TagBox["1",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "31176e24-c16a-8244-bd89-6bc7b6ad5017"],
 ", followed by an additional outer-boundary loop. The two outer loops have \
the same radius but different sampling densities."
}], "Notes",
 CellID->1830466294,ExpressionUUID->"17b776ab-9be7-1b44-bbc0-a50dedf48c0b"],

Cell[TextData[{
 "For loop index ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "efafbe72-3626-8848-ae1c-d7ea8df0e5c2"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PathSample"]], "paclet:TBMethod/ref/PathSample", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cde9cc6a-f6e2-0d40-920f-2e4d32ec13f6"],
 " uses ",
 Cell[BoxData[
  RowBox[{"1", "+", 
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Ceiling"]], "paclet:ref/Ceiling"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    RowBox[{
     StyleBox["angularScale", "TI"], " ", 
     StyleBox["j", "TI"]}], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b27944b3-513e-474a-93ca-9c22ca97f13a"],
 " subdivisions on its shortest polygon side. Each loop omits the repeated \
closing vertex."
}], "Notes",
 CellID->447052853,ExpressionUUID->"ad8bdaf0-560c-2e40-bd83-c71e1971b786"],

Cell[TextData[{
 "The returned list of loops can be used for ",
