Cell["\<\
Set up the first Brillouin zone of a triangular lattice as the region to be \
sampled\
\>", "ExampleText",
 CellID->92843988,ExpressionUUID->"19dd33f6-cd81-9442-a0fd-0623bc7fd7dd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{"1", "//", "N"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vasbasis", "=", 
   RowBox[{"a", 
    SqrtBox["3"], 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"-", 
          SqrtBox["3"]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         SqrtBox["3"]}], "}"}]}], "}"}], "/", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"vbsbasis", "=", 
  RowBox[{"ReciprocalVectors", "[", "vasbasis", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"fbzfig", "=", 
  RowBox[{"FirstBrillouinZonePlot", "[", "vbsbasis", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"fbzreg", "=", 
  RowBox[{"FirstBrillouinZoneRegion", "[", "vbsbasis", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Region", "[", "fbzreg", "]"}]}], "Input",
 CellProlog:>Get["TBMethod`"],
 CellLabel->"In[1]:=",
