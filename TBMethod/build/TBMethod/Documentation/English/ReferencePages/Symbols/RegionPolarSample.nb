Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RegionPolarSample", "[", 
   RowBox[{Cell["reg",
     FontSlant->"Italic",ExpressionUUID->
     "191c3ade-21d2-914d-b563-e61c3fa0b0b2"], ",", " ", Cell[TextData[
    StyleBox["\[Rho]num",
     FontSlant->"Italic"]],ExpressionUUID->
     "b9daed56-e739-454d-8b37-57ac424c3b5f"], ",", " ", Cell[TextData[
    StyleBox["\[Phi]rat",
     FontSlant->"Italic"]],ExpressionUUID->
     "f9f7ba15-ed7c-9b44-ad45-d15d8a798189"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7e893a37-281e-7145-add7-7f630a9f0d9e"],
 "  samples a 2D region ",
 Cell[BoxData[Cell["reg",
   FontSlant->"Italic",ExpressionUUID->
   "b8b56f3e-b0d4-a640-9a77-026547663fe9"]],ExpressionUUID->
  "94e676a6-d27a-fe45-98b0-5ce1b1cc0af0"],
 " in the polar coordinate style from its center, where ",
 Cell[BoxData[Cell[TextData[StyleBox["\[Rho]num",
   FontSlant->"Italic"]],ExpressionUUID->
   "3e2994cd-1c7c-a643-9654-88700011d06f"]],ExpressionUUID->
  "f30c485a-ef9e-d942-8f1d-7e21e1bc9743"],
 " is the sampling number in the radial direction and ",
 Cell[BoxData[Cell[TextData[StyleBox["\[Phi]rat",
   FontSlant->"Italic"]],ExpressionUUID->
   "f30329f8-9728-6d40-82fe-4710313e21ba"]],ExpressionUUID->
  "f25e6ebe-69fb-9041-b9a8-7fa931b88293"],
 " is the ratio of samplings in the azimuthal direction to the base number \
two."
}], "ExampleText",
 CellID->803019282,ExpressionUUID->"0260d570-a4c1-a34f-87c4-042a5b4887a2"],

