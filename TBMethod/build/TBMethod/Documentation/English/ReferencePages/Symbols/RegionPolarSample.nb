Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RegionPolarSample", "[", 
   RowBox[{Cell["reg",
     FontSlant->"Italic",ExpressionUUID->
     "672ef7e8-6b09-6e4e-be24-2eaee71cdffe"], ",", " ", Cell[TextData[
    StyleBox["\[Rho]num",
     FontSlant->"Italic"]],ExpressionUUID->
     "b5e3b17a-3a5d-e241-86c4-531282febffd"], ",", " ", Cell[TextData[
    StyleBox["\[Phi]rat",
     FontSlant->"Italic"]],ExpressionUUID->
     "07df87a5-8601-0c43-92c9-2d422f81ffa6"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a8863746-e6f6-5843-bd80-634a22f1c4b5"],
 "  samples a 2D region ",
 Cell[BoxData[Cell["reg",
   FontSlant->"Italic",ExpressionUUID->
   "943281e8-6eb7-9e4b-a77e-314a9292cbe1"]],ExpressionUUID->
  "ca29558d-a969-154b-a661-c60ac82cd47d"],
 " in the polar coordinate style from its center, where ",
 Cell[BoxData[Cell[TextData[StyleBox["\[Rho]num",
   FontSlant->"Italic"]],ExpressionUUID->
   "d7797e32-951e-6444-9359-0672945d3886"]],ExpressionUUID->
  "77266322-ce09-c841-bfff-0336d71abc81"],
 " is the sampling number in the radial direction and ",
 Cell[BoxData[Cell[TextData[StyleBox["\[Phi]rat",
   FontSlant->"Italic"]],ExpressionUUID->
   "265449c4-d9e1-5449-a944-968651dcaf15"]],ExpressionUUID->
  "fe50dea6-2fe5-d042-be2a-29f517569de5"],
 " is the ratio of samplings in the azimuthal direction to the base number \
two."
}], "ExampleText",
 CellID->803019282,ExpressionUUID->"7d6d3f8f-69b3-c940-8b1e-85c58258bcd3"],

