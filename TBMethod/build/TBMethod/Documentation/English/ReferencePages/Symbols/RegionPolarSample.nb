Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RegionPolarSample", "[", 
   RowBox[{Cell["reg",
     FontSlant->"Italic",ExpressionUUID->
     "0861a237-ce62-5b47-a3a8-3cc003e4b6a9"], ",", " ", Cell[TextData[
    StyleBox["\[Rho]num",
     FontSlant->"Italic"]],ExpressionUUID->
     "c1361616-b1c6-f647-8b91-1fa2183f0cce"], ",", " ", Cell[TextData[
    StyleBox["\[Phi]rat",
     FontSlant->"Italic"]],ExpressionUUID->
     "c0f2e9d3-6a90-ca43-850d-d202a5c0170c"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ef3800db-34a2-1d4b-b3e5-75e6fc7c1c29"],
 "  samples a 2D region ",
 Cell[BoxData[Cell["reg",
   FontSlant->"Italic",ExpressionUUID->
   "2e57a9a7-f54e-574c-8e0a-bd1664bd74cb"]],ExpressionUUID->
  "8a690fd8-a980-de48-85d8-3b64455c74fc"],
 " in the polar coordinate style from its center, where ",
 Cell[BoxData[Cell[TextData[StyleBox["\[Rho]num",
   FontSlant->"Italic"]],ExpressionUUID->
   "f8decc22-068a-7342-b1a0-2e3f4fd3fc35"]],ExpressionUUID->
  "72ea295e-b145-2142-bc3f-3ebe1f6d5a17"],
 " is the sampling number in the radial direction and ",
 Cell[BoxData[Cell[TextData[StyleBox["\[Phi]rat",
   FontSlant->"Italic"]],ExpressionUUID->
   "bf9a3e5a-e87c-a443-b8f7-c4bbd8c2e1cf"]],ExpressionUUID->
  "d15c4b52-42cc-384c-bc40-119c1d06ff00"],
 " is the ratio of samplings in the azimuthal direction to the base number \
two."
}], "ExampleText",
 CellID->803019282,ExpressionUUID->"58d9a533-a466-6749-9e91-7f16dc47c9e7"],

Cell[TextData[{
 "The 2D region ",
 Cell[BoxData[Cell["reg",
