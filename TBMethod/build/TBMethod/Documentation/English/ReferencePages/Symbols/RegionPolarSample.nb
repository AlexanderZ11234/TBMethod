Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RegionPolarSample", "[", 
   RowBox[{Cell["reg",
     FontSlant->"Italic",ExpressionUUID->
     "0a4af5e5-7ca7-6046-b2cb-d53f63d7347d"], ",", " ", Cell[TextData[
    StyleBox["\[Rho]num",
     FontSlant->"Italic"]],ExpressionUUID->
     "8939b77d-b34d-8f49-b2f6-9be9883e0001"], ",", " ", Cell[TextData[
    StyleBox["\[Phi]rat",
     FontSlant->"Italic"]],ExpressionUUID->
     "a7ca4dcf-8bb8-0349-9407-ea8eb19a43bb"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c3517540-a665-694b-98f6-959426f4fd5c"],
 "  samples a 2D region ",
 Cell[BoxData[Cell["reg",
   FontSlant->"Italic",ExpressionUUID->
   "e26b142f-8507-b542-af1a-f595ae2d3b3b"]],ExpressionUUID->
  "88a3d659-87e8-3a45-80dd-24fcdd53d6f9"],
 " in the polar coordinate style from its center, where ",
 Cell[BoxData[Cell[TextData[StyleBox["\[Rho]num",
   FontSlant->"Italic"]],ExpressionUUID->
   "2a41d32e-753b-3542-b1f3-90b31cba897c"]],ExpressionUUID->
  "6d385662-9182-5a44-92db-f9f23290a9a0"],
 " is the sampling number in the radial direction and ",
 Cell[BoxData[Cell[TextData[StyleBox["\[Phi]rat",
   FontSlant->"Italic"]],ExpressionUUID->
   "b07f0cd6-b3ec-6e4d-aead-dd0902e01f3a"]],ExpressionUUID->
  "9c70a445-4843-ee42-a782-3b7e9ba0efcc"],
 " is the ratio of samplings in the azimuthal direction to the base number \
two."
}], "ExampleText",
 CellID->803019282,ExpressionUUID->"e088bfeb-3cb6-924d-a699-97a1cd62b796"],

