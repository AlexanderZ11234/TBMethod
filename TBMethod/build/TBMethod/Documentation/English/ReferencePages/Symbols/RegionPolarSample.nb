Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RegionPolarSample", "[", 
   RowBox[{Cell["reg",
     FontSlant->"Italic",ExpressionUUID->
     "56cc175a-ec02-0a4b-ac41-96dced4441b1"], ",", " ", Cell[TextData[
    StyleBox["\[Rho]num",
     FontSlant->"Italic"]],ExpressionUUID->
     "e588f1cd-aae7-2c47-ae2f-f9aa6345a2f6"], ",", " ", Cell[TextData[
    StyleBox["\[Phi]rat",
     FontSlant->"Italic"]],ExpressionUUID->
     "155387f7-eb56-3147-b894-b39ca8eb8cb4"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1352d9d6-8e25-2d42-aeb7-199238a171fd"],
 "  samples a 2D region ",
 Cell[BoxData[Cell["reg",
   FontSlant->"Italic",ExpressionUUID->
   "bf2419db-218c-0b4e-8492-74f5cbc5498d"]],ExpressionUUID->
  "428090dd-7c2b-4e4f-8889-22adeb6a8bce"],
 " in the polar coordinate style from its center, where ",
 Cell[BoxData[Cell[TextData[StyleBox["\[Rho]num",
   FontSlant->"Italic"]],ExpressionUUID->
   "de19b365-08d5-ac47-8252-517a7645cc35"]],ExpressionUUID->
  "58336bf3-8f05-2942-b8c6-83ceff3400c1"],
 " is the sampling number in the radial direction and ",
 Cell[BoxData[Cell[TextData[StyleBox["\[Phi]rat",
   FontSlant->"Italic"]],ExpressionUUID->
   "111fb63e-06c2-d541-aa10-857a8e64e547"]],ExpressionUUID->
  "228520f1-8840-4342-be12-51bc300f7e6b"],
 " is the ratio of samplings in the azimuthal direction to the base number \
two."
}], "ExampleText",
 CellID->803019282,ExpressionUUID->"5a5a9b6a-3c79-e143-ae09-965109fccb41"],

