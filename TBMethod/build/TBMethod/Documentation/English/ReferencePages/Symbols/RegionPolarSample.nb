Cell[TextData[{
 "The implementation uses ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PolygonCoordinates"]], "paclet:ref/PolygonCoordinates"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2ad3f4c3-9257-6d40-82a1-9e16ea644e6a"],
 " and a fixed center ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0.", ",", "0."}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2c28466b-7bfc-a74c-bdd2-be16e3df32d2"],
 ". Use an origin-centered two-dimensional polygon whose vertices can be \
ordered by polar angle."
}], "Notes",
 CellID->724847621,ExpressionUUID->"3ba8fccd-4142-9246-8da1-6c1eb78202e9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["nRadial", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8c175214-9f51-a241-81e3-a1b3cadac20a"],
 " should be a positive integer and ",
 Cell[BoxData[
  StyleBox["angularScale", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "451f14b5-d2eb-f747-8b56-3f41a19ad897"],
 " must be positive. The origin itself is omitted."
}], "Notes",
 CellID->1496318420,ExpressionUUID->"9b6f7818-7c5e-c443-8d99-a63e0beef150"],

Cell[TextData[{
 "The radial construction returns ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"nRadial", "+", "1"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "9ebc1acf-1260-654b-9f4a-bc1b13946697"],
 " loops: scales ",
 Cell[BoxData[
  FormBox[
   TagBox[
    FractionBox["1", "nRadial"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "b7901e7a-382c-ce49-a21f-f005270b22f1"],
 " through ",
 Cell[BoxData[
  FormBox[
   TagBox["1",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "95e02d77-cdd1-c741-9e12-3267385be451"],
 ", followed by an additional outer-boundary loop. The two outer loops have \
the same radius but different sampling densities."
}], "Notes",
 CellID->814360286,ExpressionUUID->"30a07a3d-6238-4f44-b475-905fb0ac6da4"],

Cell[TextData[{
 "For loop index ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "77d4d9a2-c7b1-914a-9ed4-e622e87b5cfa"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PathSample"]], "paclet:TBMethod/ref/PathSample", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "79026048-df9f-e84e-bd2d-97ec09b8a2ff"],
 " uses ",
 Cell[BoxData[
  RowBox[{"1", "+", 
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Ceiling"]], "paclet:ref/Ceiling"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    RowBox[{
     StyleBox["angularScale", "TI"], " ", 
