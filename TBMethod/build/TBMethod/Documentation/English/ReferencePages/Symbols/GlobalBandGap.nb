Cell["\<\
The conduction-band minimum and valence-band maximum may occur at different \
samples. A negative returned gap indicates sampled band overlap.\
\>", "Notes",
 CellID->736885936,ExpressionUUID->"69a6148c-0e4a-1742-beb4-afb41e1bf323"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["n", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "162b4203-6d9d-3942-b862-669332f0458c"],
 " must satisfy ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"1", "\[LessEqual]", "n", "<", "dim"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "2d912688-7a7a-dc4d-8323-6ae7fc659ae3"],
 ", where ",
 Cell[BoxData[
  StyleBox["dim", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4e9dac3f-2cb9-1f49-a48d-323f67703a36"],
 " is the Hamiltonian matrix dimension."
}], "Notes",
 CellID->1535882616,ExpressionUUID->"ea3e9fd4-bb32-9d45-b2b0-d08f9f3fc45e"],

Cell[TextData[{
 "This is an estimate over the supplied sample points. Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigenvalues"]], "paclet:ref/Eigenvalues"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  ScriptLevel->0,
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "509ca4be-ec76-3842-985d-5ae4f80d33fa"],
 " are accepted, with ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Direct\>\""}]], "InlineCode",
  ScriptLevel->0,
  ShowStringCharacters->True,
  FontFamily->"Source Code Pro",
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"9f507648-7844-ed47-b72d-2941dadaea7d"],
 " supplied internally."
}], "Notes",
 CellID->1507072325,ExpressionUUID->"1dc95b0e-5638-2d4f-a990-7b9693f5f1e4"],

Cell[TextData[{
 "For the supplied sample set, the indirect gap is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[CapitalDelta]", "indirect"], "\[LongEqual]", 
     RowBox[{
      RowBox[{
       SubscriptBox["Min", 
        RowBox[{"k", "\[Element]", "\[ScriptCapitalK]"}]], "(", 
       RowBox[{
        SubscriptBox["\[ExponentialE]", 
         RowBox[{"n", "+", "1"}]], "(", "k", ")"}], ")"}], "-", 
      RowBox[{
       SubscriptBox["Max", 
        RowBox[{"k", "\[Element]", "\[ScriptCapitalK]"}]], "(", 
       RowBox[{
        SubscriptBox["\[ExponentialE]", "n"], "(", "k", ")"}], ")"}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "3cfb28f7-285e-d34d-ac16-aeb2078fd49f"]
}], "Notes",
 CellID->1739805740,ExpressionUUID->"651dc775-f3f0-e546-ba4a-391fbae0b7f9"]
}, Closed]],

