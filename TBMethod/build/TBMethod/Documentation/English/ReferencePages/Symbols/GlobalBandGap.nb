Cell["\<\
samples must be a nonempty list of real scalar values or real coordinate \
lists; exact integer samples do not match this implementation's pattern.\
\>", "Notes",
 CellID->449193884,ExpressionUUID->"1616f7ae-8a84-914b-bba9-512de32f6da4"],

Cell["\<\
Computes Min[E[n+1]] - Max[E[n]] after sorting eigenvalues separately at each \
sample. A negative value indicates sampled band overlap.\
\>", "Notes",
 CellID->933821666,ExpressionUUID->"0ee4bcd9-3a16-4b4b-ae4e-50467ecfedde"],

Cell["\<\
n lies between 1 and matrixDimension-1. The two extrema may occur at \
different samples, in contrast to LocalBandGap.\
\>", "Notes",
 CellID->1176459718,ExpressionUUID->"79e7d9c5-716d-9f44-bc93-c00fb7c9c653"],

Cell["\<\
This is an estimate over the supplied points. Eigenvalues options are \
accepted and Method -> \"Direct\" is supplied internally.\
\>", "Notes",
 CellID->714099464,ExpressionUUID->"816a1177-96d4-954b-80d5-d915d62112ee"]
}, Closed]],

