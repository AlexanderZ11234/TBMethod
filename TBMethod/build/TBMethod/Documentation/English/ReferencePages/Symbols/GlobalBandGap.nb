Cell["\<\
The conduction-band minimum and valence-band maximum may occur at different \
samples. A negative returned gap indicates sampled band overlap.\
\>", "Notes",
 CellID->1031166967,ExpressionUUID->"9d5af334-a816-8e4a-9d34-baeb166d27f4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c85eb32a-5ece-b548-8d53-b3f3d93a63ed"],
 " must satisfy ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"1", "\[LessEqual]", "n", "<", "dim"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "0a2d0fac-9875-254c-9bf9-5e199a3edede"],
 ", where ",
 Cell[BoxData[
  StyleBox["dim", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fcfeced6-d279-a045-afe9-0dba1f805511"],
 " is the Hamiltonian matrix dimension."
}], "Notes",
 CellID->873139108,ExpressionUUID->"38adcfff-5440-3d45-aef0-d69ea0009cd4"],

Cell[TextData[{
 "This is an estimate over the supplied sample points. Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigenvalues"]], "paclet:ref/Eigenvalues"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "854178da-2a7a-da4d-8902-33a217f24bb0"],
 " are accepted, with ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Method"]], "paclet:ref/Method"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", "\"\<Direct\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "51b42724-4fb7-4047-ae83-899436f091ef"],
 " supplied internally."
}], "Notes",
 CellID->1433078681,ExpressionUUID->"0b94dee9-4121-0942-a0c8-1c66487ec156"],

Cell[TextData[{
 "For the supplied sample set, the indirect gap is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[CapitalDelta]", "indirect"], "\[LongEqual]", 
     RowBox[{
      RowBox[{
       SubscriptBox["Min", 
        RowBox[{"k", "\[Element]", "\[ScriptCapitalK]"}]], "(", 
       RowBox[{
        SubscriptBox["\[ExponentialE]", 
         RowBox[{"n", "+", "1"}]], "(", "k", ")"}], ")"}], "-", 
      RowBox[{
       SubscriptBox["Max", 
        RowBox[{"k", "\[Element]", "\[ScriptCapitalK]"}]], "(", 
       RowBox[{
        SubscriptBox["\[ExponentialE]", "n"], "(", "k", ")"}], ")"}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "5a682385-7468-e04e-b3f5-1bff81ada8c9"]
}], "Notes",
 CellID->1671978707,ExpressionUUID->"218153aa-35d9-fc46-9f3e-3b6742346309"]
}, Closed]],

