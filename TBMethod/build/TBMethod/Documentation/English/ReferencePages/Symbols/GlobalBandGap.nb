Cell["\<\
The conduction-band minimum and valence-band maximum may occur at different \
samples. A negative returned gap indicates sampled band overlap.\
\>", "Notes",
 CellID->489225778,ExpressionUUID->"e91f06f1-1ba3-c148-8dbc-97f2062ae39a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["n", "TI",
   FontFamily->"Times",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4194aa30-0018-6c41-ada0-22c512ff12a1"],
 " must lie between ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "21da370c-39f9-c140-a2a8-b4720e27095e"],
 " and one less than the matrix dimension."
}], "Notes",
 CellID->316834828,ExpressionUUID->"d58039c4-291c-c244-9e7b-94b97796cb04"],

Cell[TextData[{
 "This is an estimate over the supplied sample points. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
