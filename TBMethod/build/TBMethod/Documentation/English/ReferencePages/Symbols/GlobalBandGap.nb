Cell["\<\
The conduction-band minimum and valence-band maximum may occur at different \
samples. A negative returned gap indicates sampled band overlap.\
\>", "Notes",
 CellID->1031166967,ExpressionUUID->"cb58a135-e2be-6241-97ac-3254102f976a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c4ef5194-f624-c84e-901e-f0aba439ab34"],
 " must satisfy ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"1", "\[LessEqual]", "n", "<", "dim"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "9f03e30d-0f90-8340-b0fd-3fc26fa27181"],
 ", where ",
 Cell[BoxData[
  StyleBox["dim", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dc8341db-48f7-b544-8c45-0fadfb4b01e7"],
 " is the Hamiltonian matrix dimension."
}], "Notes",
 CellID->873139108,ExpressionUUID->"350ae0dd-3a17-104a-ac55-42cc6bfa394e"],

Cell[TextData[{
 "This is an estimate over the supplied sample points. Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigenvalues"]], "paclet:ref/Eigenvalues"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7978381a-51b9-de47-8bfc-c0fbb1963bc9"],
 " are accepted, with ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Method"]], "paclet:ref/Method"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", "\"\<Direct\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e7867734-fc0d-6e41-8533-810a05fe2f51"],
 " supplied internally."
}], "Notes",
 CellID->1433078681,ExpressionUUID->"4bde8db2-3e5b-7747-a276-87a452e666c6"],

Cell[TextData[{
 "For the supplied sample set, the indirect gap is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[CapitalDelta]", "indirect"], "\[LongEqual]", 
     RowBox[{
      RowBox[{
       SubscriptBox["Min", 
        RowBox[{"k", "\[Element]", "\[ScriptCapitalK]"}]], "(", 
       RowBox[{
        SubscriptBox["\[ExponentialE]", 
         RowBox[{"n", "+", "1"}]], "(", "k", ")"}], ")"}], "-", 
      RowBox[{
       SubscriptBox["Max", 
        RowBox[{"k", "\[Element]", "\[ScriptCapitalK]"}]], "(", 
       RowBox[{
        SubscriptBox["\[ExponentialE]", "n"], "(", "k", ")"}], ")"}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "6c6291b4-a88b-ba45-933b-f323ab31c996"]
}], "Notes",
 CellID->1671978707,ExpressionUUID->"bd31d15e-82f8-2f42-abe6-b0921c0e1826"]
}, Closed]],

