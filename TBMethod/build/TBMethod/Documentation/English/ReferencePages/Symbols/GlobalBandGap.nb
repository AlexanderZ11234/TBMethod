Cell[TextData[{
 Cell[BoxData[
  StyleBox["samples", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bab5766d-3759-fe49-993e-5673e51025b5"],
 " must be a nonempty list of real scalar values or real coordinate lists, \
matching ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"{", "__Real", "}"}], "|", "_Real"}], ")"}], ".."}], "}"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "86f614e4-3029-3549-8743-fa44c4249db6"],
 ". Exact integer samples do not match this input pattern."
}], "Notes",
 CellID->761929032,ExpressionUUID->"7224f57e-9c85-8e41-b834-6498d45ec65e"],

Cell["\<\
The conduction-band minimum and valence-band maximum may occur at different \
samples. A negative returned gap indicates sampled band overlap.\
\>", "Notes",
 CellID->1031166967,ExpressionUUID->"3b06ef27-4b0c-8c45-bc13-cc41e9dd0de3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a6edeba8-bb3a-9e49-be66-6404fc1ae792"],
 " must satisfy ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"1", "\[LessEqual]", "n", "<", "dim"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "d9ddcd69-1ce0-c541-bf10-9200f71108b2"],
 ", where ",
 Cell[BoxData[
  StyleBox["dim", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "65c18c0f-cd94-e648-b5a0-24958bbc08ba"],
 " is the Hamiltonian matrix dimension."
}], "Notes",
 CellID->873139108,ExpressionUUID->"f77ac6af-289c-c94f-9ac8-a867a6f15f4d"],

Cell[TextData[{
 "This is an estimate over the supplied sample points. Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigenvalues"]], "paclet:ref/Eigenvalues"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dabb4734-af73-e240-914a-9717703daf36"],
 " are accepted, with ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Method"]], "paclet:ref/Method"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", "\"\<Direct\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d543f14a-cfbe-9d4c-a9f8-7f0eaca6ecab"],
 " supplied internally."
}], "Notes",
 CellID->1433078681,ExpressionUUID->"3c02080a-0d15-0c4c-b7c0-3d0b368f07dd"],

Cell[TextData[{
 "For the supplied sample set, the indirect gap is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[CapitalDelta]", "indirect"], "\[LongEqual]", 
     RowBox[{
      RowBox[{
       SubscriptBox["Min", 
        RowBox[{"k", "\[Element]", "\[ScriptCapitalK]"}]], "(", 
       RowBox[{
        SubscriptBox["\[ExponentialE]", 
         RowBox[{"n", "+", "1"}]], "(", "k", ")"}], ")"}], "-", 
      RowBox[{
       SubscriptBox["Max", 
        RowBox[{"k", "\[Element]", "\[ScriptCapitalK]"}]], "(", 
       RowBox[{
        SubscriptBox["\[ExponentialE]", "n"], "(", "k", ")"}], ")"}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "a8bb6f12-e9b0-7b41-9acf-b02ad8af7384"]
}], "Notes",
 CellID->1671978707,ExpressionUUID->"1a59513e-e495-cc45-9cc4-453235a3cead"]
}, Closed]],

