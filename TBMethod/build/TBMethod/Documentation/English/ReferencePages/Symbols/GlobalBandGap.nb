Cell[TextData[{
 "For the supplied sample set, the indirect gap is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[CapitalDelta]", "indirect"], "\[LongEqual]", 
     RowBox[{
      RowBox[{
       SubscriptBox["Min", 
        RowBox[{"k", "\[Element]", "\[ScriptCapitalK]"}]], "(", 
       RowBox[{
        SubscriptBox["\[ExponentialE]", 
         RowBox[{"n", "+", "1"}]], "(", "k", ")"}], ")"}], "-", 
      RowBox[{
       SubscriptBox["Max", 
        RowBox[{"k", "\[Element]", "\[ScriptCapitalK]"}]], "(", 
       RowBox[{
        SubscriptBox["\[ExponentialE]", "n"], "(", "k", ")"}], ")"}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "c3e7fc4f-7b41-0646-860a-aa7df9baa9c5"]
}], "Notes",
 CellID->1441105246,ExpressionUUID->"c991eb08-d747-c34b-ba9d-9009d45b4651"]
}, Closed]],

