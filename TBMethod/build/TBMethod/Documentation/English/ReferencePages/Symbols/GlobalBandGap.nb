Cell["\<\
The conduction-band minimum and valence-band maximum may occur at different \
samples. A negative returned gap indicates sampled band overlap.\
\>", "Notes",
 CellID->617302835,ExpressionUUID->"554f2d27-b3fd-4b47-bc59-cc9f88fbde51"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ab1949d8-ea51-524a-acb1-89a4b60cb6cc"],
 " must satisfy ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"1", "\[LessEqual]", "n", "<", "dim"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "aae273b1-1d13-8e49-bd46-9c8be1d9a335"],
 ", where ",
 Cell[BoxData[
  StyleBox["dim", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c0d601c0-2d5a-f246-aa0c-c91898c4932b"],
 " is the Hamiltonian matrix dimension."
}], "Notes",
 CellID->821462851,ExpressionUUID->"2f25e069-25f5-504e-99e9-61bd7088f87f"],

Cell[TextData[{
 "This is an estimate over the supplied sample points. Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigenvalues"]], "paclet:ref/Eigenvalues"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fb686e8a-8851-744d-8ee0-4c5000dd030c"],
 " are accepted, with ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Method"]], "paclet:ref/Method"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", "\"\<Direct\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b7ee8ef4-9039-6449-a64c-0cafaecfaf02"],
 " supplied internally."
}], "Notes",
 CellID->1815025881,ExpressionUUID->"ae195f39-0ff3-4643-b003-1899372ab727"],

Cell[TextData[{
 "For the supplied sample set, the indirect gap is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[CapitalDelta]", "indirect"], "\[LongEqual]", 
     RowBox[{
      RowBox[{
       SubscriptBox["Min", 
        RowBox[{"k", "\[Element]", "\[ScriptCapitalK]"}]], "(", 
       RowBox[{
        SubscriptBox["\[ExponentialE]", 
         RowBox[{"n", "+", "1"}]], "(", "k", ")"}], ")"}], "-", 
      RowBox[{
       SubscriptBox["Max", 
        RowBox[{"k", "\[Element]", "\[ScriptCapitalK]"}]], "(", 
       RowBox[{
        SubscriptBox["\[ExponentialE]", "n"], "(", "k", ")"}], ")"}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "c249282f-5f1e-be47-b569-482d95397c34"]
}], "Notes",
 CellID->274793503,ExpressionUUID->"9cf177f0-2557-1d48-a20d-f8263ee23445"]
}, Closed]],

