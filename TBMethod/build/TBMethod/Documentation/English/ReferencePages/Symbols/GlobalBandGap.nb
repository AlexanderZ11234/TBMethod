  RowBox[{"{", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"{", "__Real", "}"}], "|", "_Real"}], ")"}], ".."}], "}"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "95202560-bf87-1141-a9c1-c61e2efa0c58"],
 ". Exact integer samples do not match this input pattern."
}], "Notes",
