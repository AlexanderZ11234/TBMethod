Cell[TextData[{
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "91825082-8919-f74d-ad4d-45ca56e2344d"],
 " is an integer from ",
 Cell[BoxData["0"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5cc55645-cf2c-cb42-901c-548e74347153"],
 " through ",
 Cell[BoxData["8"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f3008133-4ea2-8f4d-8141-a52717e801eb"],
 ". Index ",
 Cell[BoxData["0"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f9890ed2-736c-4844-b639-1afa9eea9817"],
 " returns the 3 by 3 identity; indices ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1afc8993-6250-5a4c-a491-a61d945b55a7"],
 " through ",
 Cell[BoxData["8"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "893ee201-c03d-f243-b498-8e83802eba65"],
 " return the conventional traceless generators."
}], "Notes",
