Cell["\<\
i is an integer from 0 through 8. Index 0 returns the 3 by 3 identity; \
indices 1 through 8 return the conventional traceless generators.\
\>", "Notes",
 CellID->1712405880,ExpressionUUID->"3eafc6df-df85-5148-825c-7eecaf6ec820"],

Cell[TextData[{
 "The function is Listable and returns ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SparseArray"]], "paclet:ref/SparseArray"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0160bcfe-d225-0046-8efc-8fe805c45a16"],
 " matrices. The generators use Tr[lambda_i . lambda_j] = 2 delta_ij for \
indices 1 through 8."
}], "Notes",
 CellID->1612531345,ExpressionUUID->"6fc051d5-199d-7b48-a605-342dd5114bd6"]
}, Closed]],

