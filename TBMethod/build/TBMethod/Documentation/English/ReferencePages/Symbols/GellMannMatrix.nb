Cell[TextData[{
 "The function has attribute ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Listable"]], "paclet:ref/Listable"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b00c9206-6174-ec49-b717-a3054b508139"],
 " and returns ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SparseArray"]], "paclet:ref/SparseArray"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8039ac9c-4e38-ec40-84b2-84524d398a46"],
 " matrices. For generator indices ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"1", "\[LessEqual]", "i", "\[LessEqual]", "8"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "891e0d3c-f1ee-164e-a7c4-9f33da18da09"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"1", "\[LessEqual]", "j", "\[LessEqual]", "8"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "180bbd37-1c19-a84f-a214-5c5fca426a2a"],
 ", the normalization is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"Tr", "[", 
      RowBox[{
       SubscriptBox["\[Lambda]", "i"], ".", 
       SubscriptBox["\[Lambda]", "j"]}], "]"}], "\[LongEqual]", 
     RowBox[{"2", " ", 
      TemplateBox[{
        RowBox[{"i", ",", "j"}]},
       "KroneckerDeltaSeq"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "13cbf934-2462-9c4c-8db2-599e3282aab3"],
