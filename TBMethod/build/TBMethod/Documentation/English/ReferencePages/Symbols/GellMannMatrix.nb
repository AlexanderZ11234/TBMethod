Cell[TextData[{
 "The function has attribute ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Listable"]], "paclet:ref/Listable"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6ba9848f-3ae9-3e45-bf32-73012c3f591b"],
 " and returns ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SparseArray"]], "paclet:ref/SparseArray"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a8823887-432d-ec4e-92f8-dd4cdd5006b6"],
 " matrices. For generator indices ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"1", "\[LessEqual]", "i", "\[LessEqual]", "8"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "17a153ad-875a-d645-ad6d-2b7d4c6791c6"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"1", "\[LessEqual]", "j", "\[LessEqual]", "8"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "b8347f44-744c-0549-b51a-e513c2c593aa"],
 ", the normalization is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"Tr", "[", 
      RowBox[{
       SubscriptBox["\[Lambda]", "i"], ".", 
       SubscriptBox["\[Lambda]", "j"]}], "]"}], "\[LongEqual]", 
     RowBox[{"2", " ", 
      TemplateBox[{
        RowBox[{"i", ",", "j"}]},
       "KroneckerDeltaSeq"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "04382ae6-e2c7-c145-94e3-26fa0a4a8b28"],
