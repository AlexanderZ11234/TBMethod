Cell[TextData[{
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "444e1b33-fc68-324d-8683-5e64638a0b16"],
 " is an integer from ",
