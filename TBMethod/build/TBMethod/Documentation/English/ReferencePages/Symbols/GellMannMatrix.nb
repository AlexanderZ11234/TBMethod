Cell[TextData[{
 "The function has attribute ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Listable"]], "paclet:ref/Listable"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "506f9aa3-016d-444b-bb6a-651d924d2c83"],
 " and returns ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SparseArray"]], "paclet:ref/SparseArray"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "29209798-3fe6-974e-8448-140e05e47247"],
 " matrices. For generator indices ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"1", "\[LessEqual]", "i", "\[LessEqual]", "8"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "22e41f32-1180-7b48-82b7-797ddc6d4b3e"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"1", "\[LessEqual]", "j", "\[LessEqual]", "8"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "8062d8c9-369c-1649-a5b0-b261fa8bb40e"],
 ", the normalization is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"Tr", "[", 
      RowBox[{
       SubscriptBox["\[Lambda]", "i"], ".", 
       SubscriptBox["\[Lambda]", "j"]}], "]"}], "\[LongEqual]", 
     RowBox[{"2", " ", 
      TemplateBox[{
        RowBox[{"i", ",", "j"}]},
       "KroneckerDeltaSeq"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "a1b5adf3-0e61-b94e-913f-39dff7714ceb"],
