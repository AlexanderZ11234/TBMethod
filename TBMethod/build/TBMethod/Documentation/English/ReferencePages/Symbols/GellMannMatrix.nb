Cell[TextData[{
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "280d5835-a5f6-d943-bd81-de2ca2763054"],
 " is an integer from ",
 Cell[BoxData["0"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "af56d839-ae73-654e-a144-c5b412bd1999"],
 " through ",
 Cell[BoxData["8"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2b870a27-837a-bb44-9e64-62eb524787aa"],
 ". Index ",
 Cell[BoxData["0"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5d99dc64-f5f3-ce4d-9242-c047f1b39da3"],
 " returns the 3 by 3 identity; indices ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "91e1fcc7-cd65-c846-a54e-f7dbd3bc6cfe"],
 " through ",
 Cell[BoxData["8"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "71a9ae77-dbb1-144f-98f1-b0dc6aff3518"],
 " return the conventional traceless generators."
}], "Notes",
