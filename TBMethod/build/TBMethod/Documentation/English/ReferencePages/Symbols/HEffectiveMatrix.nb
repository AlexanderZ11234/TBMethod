  RowBox[{
   StyleBox["s", "TI"], "\[Rule]", "1"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f26a281c-7d42-7e48-8d0d-34f7ffde1afa"],
