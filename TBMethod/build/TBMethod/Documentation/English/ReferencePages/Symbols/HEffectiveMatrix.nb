Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"hamiltonian", "=", 
   RowBox[{"Function", "[", 
    RowBox[{"q", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"q", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
        "]"}], " ", 
       RowBox[{"PauliMatrix", "[", "1", "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"Cos", "[", 
          RowBox[{"q", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
           "]"}]}], ")"}], " ", 
       RowBox[{"PauliMatrix", "[", "3", "]"}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"HEffectiveMatrix", "[", 
  RowBox[{"hamiltonian", ",", 
   RowBox[{"{", "kx", "}"}], ",", 
   RowBox[{"{", "0", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", "2"}], "]"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->467500974,ExpressionUUID->"bed8cb4e-69e5-c348-80a9-e2b5b8677c74"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{
    RowBox[{"{", "1", "}"}], "\[Rule]", "kx"}], ",", 
   RowBox[{
    RowBox[{"{", "3", "}"}], "\[Rule]", 
    FractionBox[
     SuperscriptBox["kx", "2"], "2"]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->409687189,ExpressionUUID->"d4825339-9f22-e74c-a372-11fc2ab99100"]
