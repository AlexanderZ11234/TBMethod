Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"hamiltonian", "=", 
   RowBox[{"Function", "[", 
    RowBox[{"q", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"q", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
        "]"}], " ", 
       RowBox[{"PauliMatrix", "[", "1", "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"Cos", "[", 
          RowBox[{"q", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
           "]"}]}], ")"}], " ", 
       RowBox[{"PauliMatrix", "[", "3", "]"}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"HEffectiveMatrix", "[", 
  RowBox[{"hamiltonian", ",", 
   RowBox[{"{", "kx", "}"}], ",", 
   RowBox[{"{", "0", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", "1"}], "]"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->1617713490,ExpressionUUID->"896dc975-207d-fa43-8e2d-225e3a49db02"],

