Cell[BoxData[{
 RowBox[{
  RowBox[{"hamiltonian", "=", 
   RowBox[{"Function", "[", 
    RowBox[{"q", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"q", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
        "]"}], " ", 
       RowBox[{"PauliMatrix", "[", "1", "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"Cos", "[", 
          RowBox[{"q", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
           "]"}]}], ")"}], " ", 
       RowBox[{"PauliMatrix", "[", "3", "]"}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"HEffectiveMatrix", "[", 
  RowBox[{"hamiltonian", ",", 
   RowBox[{"{", "kx", "}"}], ",", 
   RowBox[{"{", "0", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", "2"}], "]"}]}], "Input",
 CellLabel->"In[2]:=",
