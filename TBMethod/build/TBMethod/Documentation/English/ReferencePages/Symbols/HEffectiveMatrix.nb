Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"hamiltonian", "=", 
   RowBox[{"Function", "[", 
    RowBox[{"q", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"q", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
        "]"}], " ", 
       RowBox[{"PauliMatrix", "[", "1", "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"Cos", "[", 
          RowBox[{"q", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
           "]"}]}], ")"}], " ", 
       RowBox[{"PauliMatrix", "[", "3", "]"}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"HEffectiveMatrix", "[", 
  RowBox[{"hamiltonian", ",", 
   RowBox[{"{", "kx", "}"}], ",", 
   RowBox[{"{", "0", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", "1"}], "]"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->193165705,ExpressionUUID->"f1b1fe38-bf1c-8a46-a6d2-63e1f039ee41"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
