  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->308538297,ExpressionUUID->"78c0f585-177a-3b44-bf15-233085de6ac8"]
}, Open  ]]
}, Open  ]]
