Cell["Linearize a two-band Hamiltonian around zero momentum.", "ExampleText",
 CellID->1113782017,ExpressionUUID->"4d15d377-0f91-0541-9c18-745fa1920472"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->203650736,ExpressionUUID->"48fbc6c6-13a1-894e-b06e-f575a906ffc1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"hamiltonian", "=", 
   RowBox[{"Function", "[", 
    RowBox[{"q", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"q", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
        "]"}], " ", 
       RowBox[{"PauliMatrix", "[", "1", "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"Cos", "[", 
          RowBox[{"q", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
           "]"}]}], ")"}], " ", 
       RowBox[{"PauliMatrix", "[", "3", "]"}]}]}]}], "]"}]}], ";", 
  RowBox[{"result", "=", 
   RowBox[{"HEffectiveMatrix", "[", 
    RowBox[{"hamiltonian", ",", 
     RowBox[{"{", "kx", "}"}], ",", 
     RowBox[{"{", "0", "}"}], ",", 
     RowBox[{"{", "2", "}"}], ",", "1"}], "]"}]}], ";", "result"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->1951964941,ExpressionUUID->"afbb6bc7-da03-6e49-9263-ee410d33ee9e"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"{", "1", "}"}], "\[Rule]", "kx"}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->1721802613,ExpressionUUID->"3a536226-b055-1b4f-9e4d-c59af9093346"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

