Cell[TextData[{
 "For displacement ",
 Cell[BoxData[
  FormBox[
   TagBox["r",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "4275babd-1ab3-5f48-9a53-fd3f671cfe91"],
 ", the phase factor is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", 
      RowBox[{"r", ".", "k"}]}], ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "e8de65ff-dc17-b24f-9f28-833754c4f5f4"],
 " and its derivative in direction ",
 Cell[BoxData[
  FormBox[
   TagBox["a",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "87cab257-cdea-454e-9559-2961f86fb55e"],
 " is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", 
     SubscriptBox["r", "a"], " ", 
     RowBox[{"exp", "(", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", 
       RowBox[{"r", ".", "k"}]}], ")"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "5b8281a7-6153-cc42-a7aa-20003235985e"],
 "."
}], "Notes",
 CellID->1907465542,ExpressionUUID->"b06d47ea-9103-fb4d-8624-1bcfcfaf3121"],

