Cell["\<\
Returns {H, V}, with V[[a]] equal to the derivative of H with respect to \
k[[a]]. No factor of 1/hbar is inserted.\
\>", "Notes",
 CellID->1705953416,ExpressionUUID->"fe7aa2ba-6f72-8040-bb69-6add0fe33a9a"],

Cell["Uses Exp[-I r.k] and derivatives -I r[[a]] Exp[-I r.k].", "Notes",
 CellID->1878703824,ExpressionUUID->"41718000-7b06-644f-9d4f-4e16947a1c94"],

Cell["\<\
All displacement entries must be supplied explicitly; reverse hoppings are \
not generated.\
\>", "Notes",
 CellID->564047468,ExpressionUUID->"66ad8c71-5c9e-bc4d-9a73-5795f0b198d6"]
}, Closed]],

