Cell["\<\
Returns {H, V}, with V[[a]] equal to the derivative of H with respect to \
k[[a]]. No factor of 1/hbar is inserted.\
\>", "Notes",
 CellID->410521240,ExpressionUUID->"50b519e1-e544-a147-a779-d414baf49f0b"],

Cell["Uses Exp[-I r.k] and derivatives -I r[[a]] Exp[-I r.k].", "Notes",
 CellID->134102078,ExpressionUUID->"8fa94b6f-0272-2844-b404-917b82743976"],

Cell["\<\
All displacement entries must be supplied explicitly; reverse hoppings are \
not generated.\
\>", "Notes",
 CellID->382669285,ExpressionUUID->"54bec015-50db-2a4a-a640-d5011fab2a60"]
}, Closed]],

