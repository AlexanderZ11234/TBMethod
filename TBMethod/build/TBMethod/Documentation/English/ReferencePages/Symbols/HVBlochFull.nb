Cell[TextData[{
 "For displacement ",
 Cell[BoxData[
  FormBox[
   TagBox["r",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "8f2cca47-a538-6a43-8941-259de8320434"],
 ", the phase factor is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", 
      RowBox[{"r", ".", "k"}]}], ")"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "2382fec8-2d0f-0248-b590-5fe6eb5ce71e"],
 " and its derivative in direction ",
 Cell[BoxData[
  FormBox[
   TagBox["a",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "0a175d23-5a77-2943-a1d1-6d22327f6ac5"],
 " is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", 
