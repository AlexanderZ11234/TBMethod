Cell["\<\
Load the package, construct a one-orbital chain, and inspect its band \
dispersion. All examples are deliberately small and can be evaluated directly \
in this notebook.\
\>", "TechNoteText",
 CellID->503142897,ExpressionUUID->"25a2023f-9125-f04b-a590-aeaaaa5d1684"],

Cell[CellGroupData[{

Cell["Load the package", "TechNoteSection",
 CellID->1033707654,ExpressionUUID->"347acb21-b27c-8346-ad78-502cd4bcb10c"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellID->1277863203,ExpressionUUID->"84d76dd2-c1dd-fa4b-bbea-8e2488202e44"],

Cell["\<\
Press F1 while the cursor is on an exported TBMethod symbol to open its \
reference page. Examples are ordinary evaluatable input cells; use \
Shift+Enter to run one.\
\>", "TechNoteText",
 CellID->1936894138,ExpressionUUID->"63091eea-e11d-2347-969d-962c874059a7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A one-dimensional Bloch Hamiltonian", "TechNoteSection",
 CellID->1795423687,ExpressionUUID->"4b854719-f2c9-7b41-ad5a-ff2009a1416b"],

Cell["\<\
The first association entry is the onsite matrix. Subsequent entries give one \
orientation of each hopping; HBloch adds its Hermitian conjugate. Use sparse \
matrices for the association values.\
\>", "TechNoteText",
 CellID->878941149,ExpressionUUID->"6a9fc14e-f809-c34a-afd1-30c0293f37cd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hoppings", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", "0", "}"}], "\[Rule]", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"{", 
        RowBox[{"{", "0.", "}"}], "}"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"{", "1", "}"}], "\[Rule]", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"-", "1."}], "}"}], "}"}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "h", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "k_", "]"}], ":=", 
   RowBox[{"HBloch", "[", 
    RowBox[{"k", ",", "hoppings"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"k", ",", 
     RowBox[{"Normal", "[", 
      RowBox[{"h", "[", 
       RowBox[{"{", "k", "}"}], "]"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", 
     RowBox[{"{", 
      RowBox[{"0.", ",", 
       FractionBox["\[Pi]", "2"], ",", "\[Pi]"}], "}"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellID->1606439122,ExpressionUUID->"d74e13e9-5f55-7d48-ab70-1e0305c76697"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Calculate and display the band", "TechNoteSection",
 CellID->1399813861,ExpressionUUID->"09985ce6-d5cf-324c-ba61-5ee2c13b04c3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"momenta", "=", 
   RowBox[{"List", "/@", 
    RowBox[{"Subdivide", "[", 
     RowBox[{
      RowBox[{"-", "\[Pi]"}], ",", "\[Pi]", ",", "40"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bands", "=", 
   RowBox[{"BandData", "[", 
    RowBox[{"h", ",", "momenta"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"BandPlot", "[", 
  RowBox[{"bands", ",", 
   RowBox[{"{", 
    RowBox[{"\"\<-Pi\>\"", ",", "\"\<0\>\"", ",", "\"\<Pi\>\""}], "}"}], ",", 
   
   RowBox[{"{", 
    RowBox[{"1", ",", "21", ",", "41"}], "}"}]}], "]"}]}], "Input",
 CellID->550035165,ExpressionUUID->"ba0748c5-35ee-5442-91e0-74a8a536db16"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A central-region Green's function", "TechNoteSection",
 CellID->116782866,ExpressionUUID->"803c5b3a-0080-2347-ad73-ccb068ab0623"],

Cell["\<\
Use a positive imaginary energy part for the retarded resolvent. \
Self-energies supplied to CentralGreen have the full central-region matrix \
dimensions.\
\>", "TechNoteText",
 CellID->1246232739,ExpressionUUID->"56ba4cb8-dcad-0f4c-a8e2-ac76cb33db10"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"energy", "=", 
   RowBox[{"0.2", "\[VeryThinSpace]", "+", 
    RowBox[{"0.05", " ", "\[ImaginaryI]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hCentral", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.", ",", 
        RowBox[{"-", "1."}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1."}], ",", "0."}], "}"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sigma", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "0.1"}], " ", "\[ImaginaryI]"}], ",", "0."}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.", ",", 
        RowBox[{
         RowBox[{"-", "0.1"}], " ", "\[ImaginaryI]"}]}], "}"}]}], "}"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"CentralGreen", "[", 
    RowBox[{"energy", ",", "hCentral", ",", 
     RowBox[{"{", "sigma", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Chop", "[", 
  RowBox[{"Normal", "[", 
   RowBox[{"g", ".", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"energy", " ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "-", "hCentral", "-", 
      "sigma"}], ")"}]}], "]"}], "]"}]}], "Input",
 CellID->1333492040,ExpressionUUID->"8116fd6f-bdc9-004b-80e2-9be9622b3538"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Parallel calculations", "TechNoteSection",
 CellID->1646988205,ExpressionUUID->"6b8c1f62-ecfc-bb4c-bb05-4312bb1d8f69"],

Cell["\<\
Choose a kernel count appropriate to your workstation. Loading the package on \
subkernels is required before using the Parallel-prefixed functions.\
\>", "TechNoteText",
 CellID->545699857,ExpressionUUID->"2ce221bd-1345-b249-a6f1-16ca63c01c04"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"LaunchKernels", "[", "2", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ParallelNeeds", "[", "\"\<TBMethod`\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ParallelBandData", "[", 
  RowBox[{"h", ",", "momenta"}], "]"}]}], "Input",
 CellID->901399628,ExpressionUUID->"9d95fa0d-cf38-e243-bb0c-cd108e279c4d"],

Cell[TextData[ButtonBox["TBMethod function guide",
 BaseStyle->"Link",
 ButtonData->"paclet:TBMethod/guide/TBMethod"]], "TechNoteText",
 CellID->733575704,ExpressionUUID->"cf3a0b2d-b311-284b-b953-2a2ad5a982a8"]
}, Open  ]]
}, Open  ]],

