Cell["\<\
Load the package, construct a one-orbital chain, and inspect its band \
dispersion. All examples are deliberately small and can be evaluated directly \
in this notebook.\
\>", "TechNoteText",
 CellID->1628335950,ExpressionUUID->"02a2829e-2c9d-f045-b67a-5c3e3a8f502c"],

Cell[CellGroupData[{

Cell["Load the package", "TechNoteSection",
 CellID->474455920,ExpressionUUID->"7e8076fc-f684-ae4e-92ff-d53cdaf3db23"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellID->316199613,ExpressionUUID->"847576aa-a75c-1740-959f-3da2f1c53089"],

Cell["\<\
Press F1 while the cursor is on an exported TBMethod symbol to open its \
reference page. Examples are ordinary evaluatable input cells; use \
Shift+Enter to run one.\
\>", "TechNoteText",
 CellID->118379117,ExpressionUUID->"89dd963e-b731-9946-9af1-47489af80a23"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A one-dimensional Bloch Hamiltonian", "TechNoteSection",
 CellID->1706606336,ExpressionUUID->"382ed4e1-0d02-ec4e-87cb-73b6716f71de"],

Cell["\<\
The first association entry is the onsite matrix. Subsequent entries give one \
orientation of each hopping; HBloch adds its Hermitian conjugate. Use sparse \
matrices for the association values.\
\>", "TechNoteText",
 CellID->2067035990,ExpressionUUID->"a17f47e0-401f-6242-a149-a17fece95a62"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hoppings", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", "0", "}"}], "\[Rule]", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"{", 
        RowBox[{"{", "0.", "}"}], "}"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"{", "1", "}"}], "\[Rule]", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"-", "1."}], "}"}], "}"}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "h", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "k_", "]"}], ":=", 
   RowBox[{"HBloch", "[", 
    RowBox[{"k", ",", "hoppings"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"k", ",", 
     RowBox[{"Normal", "[", 
      RowBox[{"h", "[", 
       RowBox[{"{", "k", "}"}], "]"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", 
     RowBox[{"{", 
      RowBox[{"0.", ",", 
       FractionBox["\[Pi]", "2"], ",", "\[Pi]"}], "}"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellID->801847630,ExpressionUUID->"a6155a42-6ec7-c548-9d39-587818dd7e49"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Calculate and display the band", "TechNoteSection",
 CellID->1890635217,ExpressionUUID->"6de8a544-eb2d-5540-b64a-168201561f37"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"momenta", "=", 
   RowBox[{"List", "/@", 
    RowBox[{"Subdivide", "[", 
     RowBox[{
      RowBox[{"-", "\[Pi]"}], ",", "\[Pi]", ",", "40"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bands", "=", 
   RowBox[{"BandData", "[", 
    RowBox[{"h", ",", "momenta"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"BandPlot", "[", 
  RowBox[{"bands", ",", 
   RowBox[{"{", 
    RowBox[{"\"\<-Pi\>\"", ",", "\"\<0\>\"", ",", "\"\<Pi\>\""}], "}"}], ",", 
   
   RowBox[{"{", 
    RowBox[{"1", ",", "21", ",", "41"}], "}"}]}], "]"}]}], "Input",
 CellID->1386438342,ExpressionUUID->"a85cae07-74ab-214d-a08d-7f640c495b50"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A central-region Green's function", "TechNoteSection",
 CellID->1678588410,ExpressionUUID->"9fecd078-66b7-3340-be86-38285db9b68c"],

Cell["\<\
Use a positive imaginary energy part for the retarded resolvent. \
Self-energies supplied to CentralGreen have the full central-region matrix \
dimensions.\
\>", "TechNoteText",
 CellID->1197839168,ExpressionUUID->"4a56d400-eb6b-8841-9664-478209ae3376"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"energy", "=", 
   RowBox[{"0.2", "\[VeryThinSpace]", "+", 
    RowBox[{"0.05", " ", "\[ImaginaryI]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hCentral", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.", ",", 
        RowBox[{"-", "1."}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1."}], ",", "0."}], "}"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sigma", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "0.1"}], " ", "\[ImaginaryI]"}], ",", "0."}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.", ",", 
        RowBox[{
         RowBox[{"-", "0.1"}], " ", "\[ImaginaryI]"}]}], "}"}]}], "}"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"CentralGreen", "[", 
    RowBox[{"energy", ",", "hCentral", ",", 
     RowBox[{"{", "sigma", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Chop", "[", 
  RowBox[{"Normal", "[", 
   RowBox[{"g", ".", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"energy", " ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "-", "hCentral", "-", 
      "sigma"}], ")"}]}], "]"}], "]"}]}], "Input",
 CellID->369644262,ExpressionUUID->"aee6ecb1-37c2-964f-84d0-fc04bd478aeb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Parallel calculations", "TechNoteSection",
 CellID->1268840238,ExpressionUUID->"4facfdcc-7aa2-3745-84bd-0c407954c42d"],

Cell["\<\
Choose a kernel count appropriate to your workstation. Loading the package on \
subkernels is required before using the Parallel-prefixed functions.\
\>", "TechNoteText",
 CellID->975337267,ExpressionUUID->"6098c3bc-c11c-7241-9b38-0c31560dbba2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"LaunchKernels", "[", "2", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ParallelNeeds", "[", "\"\<TBMethod`\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ParallelBandData", "[", 
  RowBox[{"h", ",", "momenta"}], "]"}]}], "Input",
 CellID->141856261,ExpressionUUID->"276042e0-2b5a-ea49-85ae-7e088b3b5c5d"],

Cell[TextData[ButtonBox["TBMethod function guide",
 BaseStyle->"Link",
 ButtonData->"paclet:TBMethod/guide/TBMethod"]], "TechNoteText",
 CellID->2023171034,ExpressionUUID->"8a05a72a-de12-ea4f-baf5-5e4a83817876"]
}, Open  ]]
}, Open  ]],

