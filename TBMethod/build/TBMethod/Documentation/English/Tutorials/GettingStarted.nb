Cell["\<\
Load the package, construct a one-orbital chain, and inspect its band \
dispersion. All examples are deliberately small and can be evaluated directly \
in this notebook.\
\>", "TechNoteText",
 CellID->2084636343,ExpressionUUID->"639e9090-4cfe-b24d-8ea2-71a4264c025c"],

Cell[CellGroupData[{

Cell["Load the package", "TechNoteSection",
 CellID->2025593072,ExpressionUUID->"e59b262f-3e40-5b45-bd54-ce753d542efd"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellID->899539881,ExpressionUUID->"1d17dd98-1770-4744-acfa-5e24761588ea"],

Cell["\<\
Press F1 while the cursor is on an exported TBMethod symbol to open its \
reference page. Examples are ordinary evaluatable input cells; use \
Shift+Enter to run one.\
\>", "TechNoteText",
 CellID->1386696042,ExpressionUUID->"39cddf6e-5738-7a41-81f5-223138325879"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A one-dimensional Bloch Hamiltonian", "TechNoteSection",
 CellID->538303269,ExpressionUUID->"f3eccc9b-09d3-734b-8e40-381ff026ad2c"],

Cell["\<\
The first association entry is the onsite matrix. Subsequent entries give one \
orientation of each hopping; HBloch adds its Hermitian conjugate. Use sparse \
matrices for the association values.\
\>", "TechNoteText",
 CellID->1563371468,ExpressionUUID->"abc4cccd-6a0b-ad4e-8c14-335dbac9068d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hoppings", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", "0", "}"}], "\[Rule]", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"{", 
        RowBox[{"{", "0.", "}"}], "}"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"{", "1", "}"}], "\[Rule]", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"-", "1."}], "}"}], "}"}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "h", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "k_", "]"}], ":=", 
   RowBox[{"HBloch", "[", 
    RowBox[{"k", ",", "hoppings"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"k", ",", 
     RowBox[{"Normal", "[", 
      RowBox[{"h", "[", 
       RowBox[{"{", "k", "}"}], "]"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", 
     RowBox[{"{", 
      RowBox[{"0.", ",", 
       FractionBox["\[Pi]", "2"], ",", "\[Pi]"}], "}"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellID->1026310839,ExpressionUUID->"8acfaa67-8738-dd40-82b8-3278253fe1c5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Calculate and display the band", "TechNoteSection",
 CellID->1093391302,ExpressionUUID->"4c4499f3-0a74-404e-a08e-d22cab650a18"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"momenta", "=", 
   RowBox[{"List", "/@", 
    RowBox[{"Subdivide", "[", 
     RowBox[{
      RowBox[{"-", "\[Pi]"}], ",", "\[Pi]", ",", "40"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bands", "=", 
   RowBox[{"BandData", "[", 
    RowBox[{"h", ",", "momenta"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"BandPlot", "[", 
  RowBox[{"bands", ",", 
   RowBox[{"{", 
    RowBox[{"\"\<-Pi\>\"", ",", "\"\<0\>\"", ",", "\"\<Pi\>\""}], "}"}], ",", 
   
   RowBox[{"{", 
    RowBox[{"1", ",", "21", ",", "41"}], "}"}]}], "]"}]}], "Input",
 CellID->418396022,ExpressionUUID->"57c802d5-20ff-6b41-8a1a-02318d8d8712"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A central-region Green's function", "TechNoteSection",
 CellID->1159372123,ExpressionUUID->"fe7f57c8-30e5-2d4d-aa74-9c922b83694a"],

Cell["\<\
Use a positive imaginary energy part for the retarded resolvent. \
Self-energies supplied to CentralGreen have the full central-region matrix \
dimensions.\
\>", "TechNoteText",
 CellID->537783212,ExpressionUUID->"4a0d6d82-605d-c54d-a085-70bf0468b6a6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"energy", "=", 
   RowBox[{"0.2", "\[VeryThinSpace]", "+", 
    RowBox[{"0.05", " ", "\[ImaginaryI]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hCentral", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.", ",", 
        RowBox[{"-", "1."}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1."}], ",", "0."}], "}"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sigma", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "0.1"}], " ", "\[ImaginaryI]"}], ",", "0."}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.", ",", 
        RowBox[{
         RowBox[{"-", "0.1"}], " ", "\[ImaginaryI]"}]}], "}"}]}], "}"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"CentralGreen", "[", 
    RowBox[{"energy", ",", "hCentral", ",", 
     RowBox[{"{", "sigma", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Chop", "[", 
  RowBox[{"Normal", "[", 
   RowBox[{"g", ".", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"energy", " ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "-", "hCentral", "-", 
      "sigma"}], ")"}]}], "]"}], "]"}]}], "Input",
 CellID->1801928524,ExpressionUUID->"bbb5f01d-b992-db40-ba11-4dee11dd118f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Parallel calculations", "TechNoteSection",
 CellID->1087177084,ExpressionUUID->"707d9907-37de-e945-a502-86c0e86b78f9"],

Cell["\<\
Choose a kernel count appropriate to your workstation. Loading the package on \
subkernels is required before using the Parallel-prefixed functions.\
\>", "TechNoteText",
 CellID->966477130,ExpressionUUID->"854467a1-f9f7-6a44-8488-da757446b4f6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"LaunchKernels", "[", "2", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ParallelNeeds", "[", "\"\<TBMethod`\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ParallelBandData", "[", 
  RowBox[{"h", ",", "momenta"}], "]"}]}], "Input",
 CellID->1608381578,ExpressionUUID->"4da31fe7-b5a5-9e40-9da2-c944b4753adc"],

Cell[TextData[ButtonBox["TBMethod function guide",
 BaseStyle->"Link",
 ButtonData->"paclet:TBMethod/guide/TBMethod"]], "TechNoteText",
 CellID->1477612116,ExpressionUUID->"6434c854-1c48-aa42-ae0f-88b2c0a3cf3e"]
}, Open  ]]
}, Open  ]],

