Cell["\<\
Load the package, construct a one-orbital chain, and inspect its band \
dispersion. All examples are deliberately small and can be evaluated directly \
in this notebook.\
\>", "TechNoteText",
 CellID->1975681404,ExpressionUUID->"25845d91-b150-9b41-b38c-3e0e77c98238"],

Cell[CellGroupData[{

Cell["Load the package", "TechNoteSection",
 CellID->1238537435,ExpressionUUID->"13ab2fec-2840-2948-aebf-2d48a8735b79"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellID->907759818,ExpressionUUID->"44864c92-20ef-9b49-ba73-9b984e4a8019"],

Cell["\<\
Press F1 while the cursor is on an exported TBMethod symbol to open its \
reference page. Examples are ordinary evaluatable input cells; use \
Shift+Enter to run one.\
\>", "TechNoteText",
 CellID->1832987748,ExpressionUUID->"35ab613e-1318-0c48-8824-6aa82c5fc4c2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A one-dimensional Bloch Hamiltonian", "TechNoteSection",
 CellID->806294729,ExpressionUUID->"94ce7d00-fdd8-a847-82fb-f0018ef1d39f"],

Cell["\<\
The first association entry is the onsite matrix. Subsequent entries give one \
orientation of each hopping; HBloch adds its Hermitian conjugate. Use sparse \
matrices for the association values.\
\>", "TechNoteText",
 CellID->1922894369,ExpressionUUID->"957f2667-674b-9147-a13b-a89b042f0dff"],

Cell[BoxData[
 RowBox[{
  RowBox[{"hoppings", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", "0", "}"}], "\[Rule]", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"{", 
        RowBox[{"{", "0.`", "}"}], "}"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"{", "1", "}"}], "\[Rule]", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"-", "1.`"}], "}"}], "}"}], "]"}]}]}], "]"}]}], ";", 
  RowBox[{"Clear", "[", "h", "]"}], ";", 
  RowBox[{
   RowBox[{"h", "[", "k_", "]"}], ":=", 
   RowBox[{"HBloch", "[", 
    RowBox[{"k", ",", "hoppings"}], "]"}]}], ";", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"k", ",", 
      RowBox[{"Normal", "[", 
       RowBox[{"h", "[", 
        RowBox[{"{", "k", "}"}], "]"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", 
      RowBox[{"{", 
       RowBox[{"0.`", ",", 
        FractionBox["\[Pi]", "2"], ",", "\[Pi]"}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellID->1137666460,ExpressionUUID->"e66f7b51-8636-1a48-a5c6-19817378beb1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Calculate and display the band", "TechNoteSection",
 CellID->1123750866,ExpressionUUID->"e3644aaf-3eb5-4b44-b726-581fe9b48685"],

Cell[BoxData[
 RowBox[{
  RowBox[{"momenta", "=", 
   RowBox[{"List", "/@", 
    RowBox[{"Subdivide", "[", 
     RowBox[{
      RowBox[{"-", "\[Pi]"}], ",", "\[Pi]", ",", "40"}], "]"}]}]}], ";", 
  RowBox[{"bands", "=", 
   RowBox[{"BandData", "[", 
    RowBox[{"h", ",", "momenta"}], "]"}]}], ";", 
  RowBox[{"BandPlot", "[", 
   RowBox[{"bands", ",", 
    RowBox[{"{", 
     RowBox[{"\"\<-Pi\>\"", ",", "\"\<0\>\"", ",", "\"\<Pi\>\""}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "21", ",", "41"}], "}"}]}], "]"}]}]], "Input",
 CellID->224828836,ExpressionUUID->"fca50b23-0edb-b142-b0f5-74807dcedae7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A central-region Green's function", "TechNoteSection",
 CellID->302267665,ExpressionUUID->"44339d29-d09e-9540-b82c-c21f6a860e4f"],

Cell["\<\
Use a positive imaginary energy part for the retarded resolvent. \
Self-energies supplied to CentralGreen have the full central-region matrix \
dimensions.\
\>", "TechNoteText",
 CellID->150789733,ExpressionUUID->"1c70617e-b4df-2e4e-aaf3-c5e79812f506"],

Cell[BoxData[
 RowBox[{
  RowBox[{"energy", "=", 
   RowBox[{"0.2`", "\[VeryThinSpace]", "+", 
    RowBox[{"0.05`", " ", "\[ImaginaryI]"}]}]}], ";", 
  RowBox[{"hCentral", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.`", ",", 
        RowBox[{"-", "1.`"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1.`"}], ",", "0.`"}], "}"}]}], "}"}], "]"}]}], ";", 
  RowBox[{"sigma", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "0.1`"}], " ", "\[ImaginaryI]"}], ",", "0.`"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.`", ",", 
        RowBox[{
         RowBox[{"-", "0.1`"}], " ", "\[ImaginaryI]"}]}], "}"}]}], "}"}], 
    "]"}]}], ";", 
  RowBox[{"g", "=", 
   RowBox[{"CentralGreen", "[", 
    RowBox[{"energy", ",", "hCentral", ",", 
     RowBox[{"{", "sigma", "}"}]}], "]"}]}], ";", 
  RowBox[{"Chop", "[", 
   RowBox[{"Normal", "[", 
    RowBox[{"g", ".", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"energy", " ", 
        RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "-", "hCentral", "-", 
       "sigma"}], ")"}]}], "]"}], "]"}]}]], "Input",
 CellID->157715703,ExpressionUUID->"8e8a78aa-4b91-f54a-9353-f12a3acd19be"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Parallel calculations", "TechNoteSection",
 CellID->1779948289,ExpressionUUID->"2684ff36-2def-5a46-a749-d52064178628"],

Cell["\<\
Choose a kernel count appropriate to your workstation. Loading the package on \
subkernels is required before using the Parallel-prefixed functions.\
\>", "TechNoteText",
 CellID->1624031615,ExpressionUUID->"2896f9ef-49b1-854c-8d04-d9e88ad9347f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LaunchKernels", "[", "2", "]"}], ";", 
  RowBox[{"ParallelNeeds", "[", "\"\<TBMethod`\>\"", "]"}], ";", 
  RowBox[{"ParallelBandData", "[", 
   RowBox[{"h", ",", "momenta"}], "]"}]}]], "Input",
 CellID->1105997702,ExpressionUUID->"4238b49b-592d-aa43-9e4b-1b2df6856502"],

Cell[TextData[ButtonBox["TBMethod function guide",
 BaseStyle->"Link",
 ButtonData->"paclet:TBMethod/guide/TBMethod"]], "TechNoteText",
 CellID->1270707720,ExpressionUUID->"d1115dfe-7dc8-4a4a-9e4d-32fb20ec5dd3"]
}, Open  ]]
}, Open  ]],

