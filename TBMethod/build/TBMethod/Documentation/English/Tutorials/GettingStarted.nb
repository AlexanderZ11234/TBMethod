Cell["\<\
Load the package, construct a one-orbital chain, and inspect its band \
dispersion. All examples are deliberately small and can be evaluated directly \
in this notebook.\
\>", "TechNoteText",
 CellID->1752415699,ExpressionUUID->"22a2025a-2ddb-d844-be4f-332d8113db27"],

Cell[CellGroupData[{

Cell["Load the package", "TechNoteSection",
 CellID->281029105,ExpressionUUID->"ed98440f-a04e-b546-a9a8-89790d4f785c"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellID->1902672607,ExpressionUUID->"344ecee3-ff4e-a741-8e04-dd8e18b9c7e7"],

Cell["\<\
Press F1 while the cursor is on an exported TBMethod symbol to open its \
reference page. Examples are ordinary evaluatable input cells; use \
Shift+Enter to run one.\
\>", "TechNoteText",
 CellID->1507458875,ExpressionUUID->"55ce3730-33b4-284e-b0f7-40d57882a7bc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A one-dimensional Bloch Hamiltonian", "TechNoteSection",
 CellID->1519429240,ExpressionUUID->"bdc35e1e-bf49-e94b-b9e6-1ea10a53ea7f"],

Cell["\<\
The first association entry is the onsite matrix. Subsequent entries give one \
orientation of each hopping; HBloch adds its Hermitian conjugate. Use sparse \
matrices for the association values.\
\>", "TechNoteText",
 CellID->862415594,ExpressionUUID->"0f8b193f-2e23-d343-ac1d-878b9a20c09e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hoppings", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", "0", "}"}], "\[Rule]", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"{", 
        RowBox[{"{", "0.", "}"}], "}"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"{", "1", "}"}], "\[Rule]", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"-", "1."}], "}"}], "}"}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "h", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "k_", "]"}], ":=", 
   RowBox[{"HBloch", "[", 
    RowBox[{"k", ",", "hoppings"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"k", ",", 
     RowBox[{"Normal", "[", 
      RowBox[{"h", "[", 
       RowBox[{"{", "k", "}"}], "]"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", 
     RowBox[{"{", 
      RowBox[{"0.", ",", 
       FractionBox["\[Pi]", "2"], ",", "\[Pi]"}], "}"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellID->1463727602,ExpressionUUID->"e8df70f0-a850-ad4a-a79e-b7f11157cf24"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Calculate and display the band", "TechNoteSection",
 CellID->1101464713,ExpressionUUID->"98b25a0b-4b8c-bd43-98d5-be18774f054d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"momenta", "=", 
   RowBox[{"List", "/@", 
    RowBox[{"Subdivide", "[", 
     RowBox[{
      RowBox[{"-", "\[Pi]"}], ",", "\[Pi]", ",", "40"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bands", "=", 
   RowBox[{"BandData", "[", 
    RowBox[{"h", ",", "momenta"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"BandPlot", "[", 
  RowBox[{"bands", ",", 
   RowBox[{"{", 
    RowBox[{"\"\<-Pi\>\"", ",", "\"\<0\>\"", ",", "\"\<Pi\>\""}], "}"}], ",", 
   
   RowBox[{"{", 
    RowBox[{"1", ",", "21", ",", "41"}], "}"}]}], "]"}]}], "Input",
 CellID->131078957,ExpressionUUID->"7fa8a227-b310-554c-b237-8d35bd26242b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A central-region Green's function", "TechNoteSection",
 CellID->1563325188,ExpressionUUID->"7a037e41-741e-774a-b455-1a0d8430b337"],

Cell["\<\
Use a positive imaginary energy part for the retarded resolvent. \
Self-energies supplied to CentralGreen have the full central-region matrix \
dimensions.\
\>", "TechNoteText",
 CellID->650362763,ExpressionUUID->"ae7d3161-b0d4-434c-92e1-52c5379a2d79"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"energy", "=", 
   RowBox[{"0.2", "\[VeryThinSpace]", "+", 
    RowBox[{"0.05", " ", "\[ImaginaryI]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hCentral", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.", ",", 
        RowBox[{"-", "1."}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1."}], ",", "0."}], "}"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sigma", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "0.1"}], " ", "\[ImaginaryI]"}], ",", "0."}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.", ",", 
        RowBox[{
         RowBox[{"-", "0.1"}], " ", "\[ImaginaryI]"}]}], "}"}]}], "}"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"CentralGreen", "[", 
    RowBox[{"energy", ",", "hCentral", ",", 
     RowBox[{"{", "sigma", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Chop", "[", 
  RowBox[{"Normal", "[", 
   RowBox[{"g", ".", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"energy", " ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "-", "hCentral", "-", 
      "sigma"}], ")"}]}], "]"}], "]"}]}], "Input",
 CellID->1790026013,ExpressionUUID->"e231eef0-fa85-b24f-b6e0-40b4313c65bd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Parallel calculations", "TechNoteSection",
 CellID->1819787587,ExpressionUUID->"8676627e-9449-fa48-b366-72edf644b02c"],

Cell["\<\
Choose a kernel count appropriate to your workstation. Loading the package on \
subkernels is required before using the Parallel-prefixed functions.\
\>", "TechNoteText",
 CellID->1602644575,ExpressionUUID->"80ccc383-3bf3-334a-ab59-0723a7ccde42"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"LaunchKernels", "[", "2", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ParallelNeeds", "[", "\"\<TBMethod`\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ParallelBandData", "[", 
  RowBox[{"h", ",", "momenta"}], "]"}]}], "Input",
 CellID->972976161,ExpressionUUID->"231114b7-4cef-a046-9396-a68d18d899aa"],

Cell[TextData[ButtonBox["TBMethod function guide",
 BaseStyle->"Link",
 ButtonData->"paclet:TBMethod/guide/TBMethod"]], "TechNoteText",
 CellID->1904415489,ExpressionUUID->"7eb7baff-1f2f-7641-bd83-e6adb1c5994f"]
}, Open  ]]
}, Open  ]],

