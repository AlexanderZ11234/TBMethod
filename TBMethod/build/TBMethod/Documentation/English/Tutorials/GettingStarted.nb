Cell["\<\
Load the package, construct a one-orbital chain, and inspect its band \
dispersion. All examples are deliberately small and can be evaluated directly \
in this notebook.\
\>", "TechNoteText",
 CellID->1628335950,ExpressionUUID->"61c6e486-a21e-2547-9c32-68a77bf637ab"],

Cell[CellGroupData[{

Cell["Load the package", "TechNoteSection",
 CellID->474455920,ExpressionUUID->"a26f5ac5-289f-db4d-8e43-4962907c57e8"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellID->316199613,ExpressionUUID->"9f08e65a-5880-c34e-9268-2d2e2fe83342"],

Cell["\<\
Press F1 while the cursor is on an exported TBMethod symbol to open its \
reference page. Examples are ordinary evaluatable input cells; use \
Shift+Enter to run one.\
\>", "TechNoteText",
 CellID->118379117,ExpressionUUID->"4d3500e4-bb75-c144-bfa2-e269e766b823"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A one-dimensional Bloch Hamiltonian", "TechNoteSection",
 CellID->1706606336,ExpressionUUID->"0cd49ce3-63cb-9047-bc0a-b4b85c900b6a"],

Cell["\<\
The first association entry is the onsite matrix. Subsequent entries give one \
orientation of each hopping; HBloch adds its Hermitian conjugate. Use sparse \
matrices for the association values.\
\>", "TechNoteText",
 CellID->2067035990,ExpressionUUID->"fa3aaecf-0073-cf4b-a0c1-bb4be23d4295"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hoppings", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", "0", "}"}], "\[Rule]", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"{", 
        RowBox[{"{", "0.", "}"}], "}"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"{", "1", "}"}], "\[Rule]", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"-", "1."}], "}"}], "}"}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "h", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "k_", "]"}], ":=", 
   RowBox[{"HBloch", "[", 
    RowBox[{"k", ",", "hoppings"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"k", ",", 
     RowBox[{"Normal", "[", 
      RowBox[{"h", "[", 
       RowBox[{"{", "k", "}"}], "]"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", 
     RowBox[{"{", 
      RowBox[{"0.", ",", 
       FractionBox["\[Pi]", "2"], ",", "\[Pi]"}], "}"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellID->801847630,ExpressionUUID->"e9e7b759-517e-d843-ba2c-dd8b8f06b893"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Calculate and display the band", "TechNoteSection",
 CellID->1890635217,ExpressionUUID->"23c08df7-2f0a-c34c-8298-e35ded53ad29"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"momenta", "=", 
   RowBox[{"List", "/@", 
    RowBox[{"Subdivide", "[", 
     RowBox[{
      RowBox[{"-", "\[Pi]"}], ",", "\[Pi]", ",", "40"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bands", "=", 
   RowBox[{"BandData", "[", 
    RowBox[{"h", ",", "momenta"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"BandPlot", "[", 
  RowBox[{"bands", ",", 
   RowBox[{"{", 
    RowBox[{"\"\<-Pi\>\"", ",", "\"\<0\>\"", ",", "\"\<Pi\>\""}], "}"}], ",", 
   
   RowBox[{"{", 
    RowBox[{"1", ",", "21", ",", "41"}], "}"}]}], "]"}]}], "Input",
 CellID->1386438342,ExpressionUUID->"a4e682ab-e3f3-f94f-a9df-d38dd7c2996b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A central-region Green's function", "TechNoteSection",
 CellID->1678588410,ExpressionUUID->"99b6d7f0-50b6-5645-aa62-d1385b4fe52d"],

Cell["\<\
Use a positive imaginary energy part for the retarded resolvent. \
Self-energies supplied to CentralGreen have the full central-region matrix \
dimensions.\
\>", "TechNoteText",
 CellID->1197839168,ExpressionUUID->"deb158c9-5bb3-8741-92ce-66ccaaba226f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"energy", "=", 
   RowBox[{"0.2", "\[VeryThinSpace]", "+", 
    RowBox[{"0.05", " ", "\[ImaginaryI]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hCentral", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.", ",", 
        RowBox[{"-", "1."}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1."}], ",", "0."}], "}"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sigma", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "0.1"}], " ", "\[ImaginaryI]"}], ",", "0."}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.", ",", 
        RowBox[{
         RowBox[{"-", "0.1"}], " ", "\[ImaginaryI]"}]}], "}"}]}], "}"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"CentralGreen", "[", 
    RowBox[{"energy", ",", "hCentral", ",", 
     RowBox[{"{", "sigma", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Chop", "[", 
  RowBox[{"Normal", "[", 
   RowBox[{"g", ".", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"energy", " ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "-", "hCentral", "-", 
      "sigma"}], ")"}]}], "]"}], "]"}]}], "Input",
 CellID->369644262,ExpressionUUID->"678d0fb3-d110-6241-b95f-179f1595a0a2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Parallel calculations", "TechNoteSection",
 CellID->1268840238,ExpressionUUID->"78cf8ea4-cd25-f445-8d62-5c7c1c26e7d9"],

Cell["\<\
Choose a kernel count appropriate to your workstation. Loading the package on \
subkernels is required before using the Parallel-prefixed functions.\
\>", "TechNoteText",
 CellID->975337267,ExpressionUUID->"f4e7550c-8fb7-7349-a685-eef88e67cafe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"LaunchKernels", "[", "2", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ParallelNeeds", "[", "\"\<TBMethod`\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ParallelBandData", "[", 
  RowBox[{"h", ",", "momenta"}], "]"}]}], "Input",
 CellID->141856261,ExpressionUUID->"e724fecf-e5a2-c44e-9d7e-95c78dccb63f"],

Cell[TextData[ButtonBox["TBMethod function guide",
 BaseStyle->"Link",
 ButtonData->"paclet:TBMethod/guide/TBMethod"]], "TechNoteText",
 CellID->2023171034,ExpressionUUID->"3198f044-7c41-c94a-8457-555668a54238"]
}, Open  ]]
}, Open  ]],

