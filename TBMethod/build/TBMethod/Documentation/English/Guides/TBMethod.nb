Cell[CellGroupData[{

Cell["TBMethod", "GuideTitle",
 CellID->2091899336,ExpressionUUID->"a1d4db0c-bac4-5d48-88d5-fa359e621ab8"],

Cell["\<\
TBMethod supports tight-binding model construction, eigenspectra and \
topological characterization, lattice Green's function transport \
calculations, and visualization. Load all four subpackages with \
Needs[\"TBMethod`\"].\
\>", "GuideAbstract",
 CellID->1516896072,ExpressionUUID->"a18b3ae8-5d4b-d546-9fea-6fb75e5b1476"],

Cell["\t", "GuideDelimiterSubsection",ExpressionUUID->"4cdb1998-480c-9049-b041-11742dfc7afd"]
}, Open  ]],

