Cell[CellGroupData[{

Cell["TBMethod", "GuideTitle",
 CellID->1333229336,ExpressionUUID->"fee909a7-1162-b745-b475-4aee3e088cc5"],

Cell["\<\
TBMethod supports tight-binding model construction, eigenspectra and \
topological characterization, lattice Green's function transport \
calculations, and visualization. Load all four subpackages with \
Needs[\"TBMethod`\"].\
\>", "GuideAbstract",
 CellID->316522802,ExpressionUUID->"6ee32dac-7835-544c-8866-713338f8e50d"],

Cell["\t", "GuideDelimiterSubsection",ExpressionUUID->"8e8fadf2-d9f4-8340-93bd-b91ae3210d97"]
}, Open  ]],

