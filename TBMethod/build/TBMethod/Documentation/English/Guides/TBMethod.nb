Cell[CellGroupData[{

Cell["TBMethod", "GuideTitle",
 CellID->1423967512,ExpressionUUID->"8c31aebc-7603-8448-8934-40e260c154e8"],

Cell["\<\
TBMethod supports tight-binding model construction, eigenspectra and \
topological characterization, lattice Green's function transport \
calculations, and visualization. Load all four subpackages with \
Needs[\"TBMethod`\"].\
\>", "GuideAbstract",
 CellID->1351700485,ExpressionUUID->"16f2767c-0bb9-bb46-9699-82f834a3b7de"],

Cell["\t", "GuideDelimiterSubsection",ExpressionUUID->"08e8287f-6b49-6a49-b1f6-f4090a358664"]
}, Open  ]],

