Cell[CellGroupData[{

Cell["TBMethod", "GuideTitle",
 CellID->1101398190,ExpressionUUID->"21f79092-2c48-0f46-b680-042547c83247"],

Cell["\<\
TBMethod supports tight-binding model construction, eigenspectra and \
topological characterization, lattice Green's function transport \
calculations, and visualization. Load all four subpackages with \
Needs[\"TBMethod`\"].\
\>", "GuideAbstract",
 CellID->122103090,ExpressionUUID->"e257f310-ecfa-2646-8346-bf5a3c2974e4"],

Cell["\t", "GuideDelimiterSubsection",ExpressionUUID->"227820d5-0df7-3b43-9a67-20fbfae3f947"]
}, Open  ]],

