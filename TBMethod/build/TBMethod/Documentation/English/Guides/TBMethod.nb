Cell[CellGroupData[{

Cell["TBMethod", "GuideTitle",
 CellID->181186501,ExpressionUUID->"861c3261-9bde-2142-ab8d-2845c5574cf1"],

Cell["\<\
TBMethod supports tight-binding model construction, eigenspectra and \
topological characterization, lattice Green's function transport \
calculations, and visualization. Load all four subpackages with \
Needs[\"TBMethod`\"].\
\>", "GuideAbstract",
 CellID->121017363,ExpressionUUID->"8896ebb7-1c7c-9c4a-a356-56f2bbc39c64"],

Cell["\t", "GuideDelimiterSubsection",ExpressionUUID->"d93a8cf9-43c5-2a48-83a0-b2ddb335b34e"]
}, Open  ]],

