Cell[TextData[{
 "Returns a list of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ab835be4-a97e-934a-8342-5024341fa9ec"],
