       RowBox[{"{", 
        RowBox[{"2.", ",", "0."}], "}"}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hop", "=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rf", ",", "ri"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
