}], "Notes",
 CellID->672588424,ExpressionUUID->"91541b85-c0ea-6f47-9939-2a0a165ca6b3"],

Cell["\<\
Inputs must already use mutually consistent charge, flux, and length units. \
No physical constants are inserted.\
\>", "Notes",
 CellID->635828166,ExpressionUUID->"35423fe6-ef73-264a-929b-f63db410fc69"],

Cell[TextData[{
 "The three-dimensional symmetric-gauge phase convention is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{
       SubscriptBox["r", "f"], ",", 
       SubscriptBox["r", "i"]}], ")"}], "\[LongEqual]", 
     RowBox[{"exp", "(", 
      RowBox[{"\[ImaginaryI]", " ", "\[Pi]", " ", 
       TemplateBox[{
         RowBox[{"{", 
           RowBox[{
             SubscriptBox["r", "f"], ",", "B", ",", 
             SubscriptBox["r", "i"]}], "}"}]},
        "Det"]}], ")"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "db89f985-389f-f84a-9ed6-881fa1995265"]
}], "Notes",
 CellID->589727258,ExpressionUUID->"576c0403-eeaa-c246-9c7e-c9cbbb789329"]
}, Closed]],

