Cell[BoxData[{
 RowBox[{
  RowBox[{"layers", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"1", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"0.", ",", "0."}], "}"}], "}"}]}], ",", 
     RowBox[{"2", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1.", ",", "0."}], "}"}], "}"}]}], ",", 
     RowBox[{"3", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"2.", ",", "0."}], "}"}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hop", "=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rf", ",", "ri"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          TemplateBox[{
            RowBox[{"rf", "-", "ri"}]},
           "Norm"], "<", "0.001"}], ",", "0.", ",", 
         RowBox[{"-", "1."}]}], "]"}], "}"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lead", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"3.", ",", "0."}], "}"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"4.", ",", "0."}], "}"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"HLeadBlocksVerbose", "[", 
  RowBox[{
  "layers", ",", "hop", ",", "1.01", ",", "lead", ",", "\"\<right\>\""}], 
  "]"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->277716255,ExpressionUUID->"3ac1666d-61ee-d941-a834-b8851872b0c9"],

