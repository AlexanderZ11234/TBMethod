Cell["\<\
The shift uses the arithmetic mean of the coordinates, with equal weight for \
every supplied site.\
\>", "Notes",
 CellID->1824594074,ExpressionUUID->"ca7a7c85-fdf9-7343-8727-60d173d61362"],

Cell[TextData[{
 "Accepts a list of coordinate lists or labeled coordinate ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Rule"]], "paclet:ref/Rule"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "aa9f639a-d927-bd4d-8dea-4dd0609c4569"],
 " expressions. Rule labels are preserved."
}], "Notes",
