Cell[TextData[{
 "The site centroid is shifted to the origin:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SuperscriptBox[
      SubscriptBox["r", "j"], "\[Prime]",
      MultilineFunction->None], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["r", "j"], "-", 
      FractionBox[
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], "N"], 
        SubscriptBox["r", "i"]}], "N"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "de2a393b-81ce-064b-bf53-95ff22e09f63"]
}], "Notes",
 CellID->816018165,ExpressionUUID->"2965a312-7a5f-5e42-8c96-f158c5d89d6f"]
}, Closed]],

