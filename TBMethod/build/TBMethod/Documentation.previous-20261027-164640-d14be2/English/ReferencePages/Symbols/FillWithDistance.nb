Cell[TextData[{
 "A branch is selected when ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     TemplateBox[{
       RowBox[{"d", "-", "shellDistance"}]},
      "Abs"], "<", "tolerance"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "0538b967-c661-114e-bc17-d295ea115692"],
