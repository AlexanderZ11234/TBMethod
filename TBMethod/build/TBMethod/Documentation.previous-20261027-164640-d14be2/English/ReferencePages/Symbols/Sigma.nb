Cell[TextData[{
 "The implementation returns a zero sparse matrix when ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["v", "TI"], 
     TemplateBox[{}, "Frobenius", 
      InterpretationFunction -> ("\"Frobenius\""& )]},
    "Norm2"], "<", 
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Im"]], "paclet:ref/Im"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    StyleBox["z", "TI"], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "87eb1b37-9773-1145-9800-010c46b4e97f"],
 ". Use a positive broadening sufficiently small relative to the interface \
coupling."
}], "Notes",
 CellID->1636845328,ExpressionUUID->"c06aeaf4-ce78-4e4e-a473-ad87427ed4a1"],

Cell[TextData[{
 "For an ordinary Hermitian interface, the self-energy is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"\[CapitalSigma]", "(", "z", ")"}], "\[LongEqual]", 
     RowBox[{"V", ".", 
      RowBox[{
       SubscriptBox["g", "s"], "(", "z", ")"}], ".", 
      TemplateBox[{"V"},
       "ConjugateTranspose"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "eb83bcaa-4bb9-044e-920e-994fa4a0735e"]
}], "Notes",
 CellID->1053615207,ExpressionUUID->"c458c51b-7a62-734e-95d8-2512e94334ba"]
}, Closed]],

