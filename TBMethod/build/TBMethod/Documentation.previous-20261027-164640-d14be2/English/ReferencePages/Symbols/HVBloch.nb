Cell["\<\
The first association entry is onsite. Remaining entries represent one \
orientation of each hopping pair, and their Hermitian conjugates are added.\
\>", "Notes",
 CellID->479762790,ExpressionUUID->"09fe5c1b-4028-d542-b8d4-76b372fdd359"],

Cell[TextData[{
 "Association values must be ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SparseArray"]], "paclet:ref/SparseArray"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "458dcaec-ed53-7c42-a752-984d0c50f71e"],
 " matrices."
}], "Notes",
 CellID->1757513221,ExpressionUUID->"b9afc25a-b98b-6a43-9cb0-cb4622578011"],

Cell[TextData[{
 "The returned derivative matrices use momentum derivatives without an \
additional ",
 Cell[BoxData[
  FormBox[
   TagBox[
    FractionBox["1", "\[HBar]"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "4f2eff0f-fec5-684e-ad3b-27594eb334ee"],
 " factor:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["V", "\[Alpha]"], "(", "k", ")"}], "\[LongEqual]", 
     FractionBox[
      RowBox[{"\[PartialD]", 
       RowBox[{"H", "(", "k", ")"}]}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["k", "\[Alpha]"]}],
      MultilineFunction->None]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "1d1d93ab-6783-8e4c-a8a6-51af6301aa00"]
}], "Notes",
 CellID->1975633825,ExpressionUUID->"5dfcdb0f-4e94-fa45-9539-eadbd5347c8d"]
}, Closed]],

