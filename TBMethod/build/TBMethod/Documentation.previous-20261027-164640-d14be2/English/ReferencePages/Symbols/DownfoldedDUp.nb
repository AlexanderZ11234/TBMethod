Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"crystal", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.", ",", "0."}], "}"}], "\[Rule]", 
