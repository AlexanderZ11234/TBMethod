Cell[TextData[{
 Cell[BoxData[
  StyleBox["crystal", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "24656091-7527-5c44-aa34-cacc96c24efb"],
 " is a nonempty association of cell translations with site-coordinate lists. \
The coordinates in its first cell supply the basis positions and site \
ordering. Labeled sites of the form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["label", "TI"], "\[Rule]", 
   StyleBox["position", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e32d2a20-6f9a-bf4e-8b7c-210ac34711a4"],
 " are also accepted."
}], "Notes",
 CellID->802271024,ExpressionUUID->"5db7e158-b4ed-6a42-9a86-23610bf680a8"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["effectiveHoppings", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7802eaf2-b40b-e040-b82f-3060809f5700"],
 " maps displacement vectors to square hopping matrices. Each matrix must \
have equal internal dimension per site and a matrix size divisible by the \
number of basis sites."
}], "Notes",
 CellID->1016644864,ExpressionUUID->"225854a2-a8d8-9d49-bb03-3cfdcd3575cf"],

Cell["\<\
Every supplied displacement is examined, including the zero displacement. The \
matrix is partitioned into site-to-site internal blocks, and only retained \
blocks contribute distances.\
\>", "Notes",
 CellID->1802124139,ExpressionUUID->"feff259a-6348-a44c-a72e-fc7196a1511e"],

Cell[TextData[{
 "The string-named option ",
 Cell[BoxData[
  RowBox[{"\"\<ZeroThreshold\>\"", "\[Rule]", "0.00001"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ef21d01e-ae33-0446-bf83-e6ce19f513b3"],
 " is the default. A numeric block is discarded when the largest absolute \
value of its entries is less than or equal to this threshold."
}], "Notes",
 CellID->427449942,ExpressionUUID->"7850aed0-d293-b84c-b170-31d5ca75cc1e"],

Cell[TextData[{
 "For a nonnumeric block, all entries must satisfy ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PossibleZeroQ"]], "paclet:ref/PossibleZeroQ"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8489d224-1124-554c-a2f2-11380060ce9c"],
 " for the block to be discarded. A symbolic entry that cannot be recognized \
as zero keeps its block."
}], "Notes",
 CellID->1180593144,ExpressionUUID->"28b492ed-ca85-8649-bcf8-a827900e0257"],

Cell[TextData[{
 "The return value is a nonnegative distance when at least one block is \
retained. An empty hopping association, or one with no retained blocks, \
returns ",
 Cell[BoxData[
  RowBox[{"-", "\[Infinity]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9710cae6-0ee1-4c4b-a90c-967f3e04f861"],
 "."
}], "Notes",
 CellID->635529244,ExpressionUUID->"2eea48bf-a61a-574d-81a9-a086372826bf"],

Cell["\<\
The current interface takes no original-hoppings association or original \
distance cutoff. It measures the supplied association directly, including \
bonds within displacement keys that were already present before downfolding.\
\>", "Notes",
 CellID->1339785259,ExpressionUUID->"fc6f9619-0e03-bb44-9639-af4fdd268e3f"],

Cell[TextData[{
 "For each retained block from site ",
 Cell[BoxData[
  FormBox[
   TagBox["j",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "92a2559a-2de5-424e-9035-eb406d726d52"],
 " to site ",
 Cell[BoxData[
  FormBox[
   TagBox["i",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "cb3b2198-adae-ee4e-836f-c20f76ab1dd8"],
 ", the distance uses basis-position vectors ",
 Cell[BoxData[
  FormBox[
   TagBox[
    StyleBox[
     SubscriptBox["r", "i"],
     StripOnInput->False,
     FontWeight->"Bold",
     FontSlant->"Italic"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "64b3cbef-081b-684c-8fac-3181a8a54933"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    StyleBox[
     SubscriptBox["r", "j"],
     StripOnInput->False,
     FontWeight->"Bold",
     FontSlant->"Italic"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "ff1f9e82-e2fd-f14f-a672-0dcff2990de9"],
 " and displacement ",
 Cell[BoxData[
  FormBox[
   TagBox[
    StyleBox["R",
     StripOnInput->False,
     FontWeight->"Bold",
     FontSlant->"Italic"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "d1102d62-9a03-c141-95ff-6c8ff6ab5a3e"],
 ". The result is the maximum of these distances:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["d", 
      RowBox[{"{", 
       RowBox[{"i", ",", "j"}], "}"}]], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{
         StyleBox[
          SubscriptBox["r", "i"], FontWeight -> "Bold", FontSlant -> "Italic",
           StripOnInput -> False], "+", 
         StyleBox[
         "R", FontWeight -> "Bold", FontSlant -> "Italic", StripOnInput -> 
          False], "-", 
         StyleBox[
          SubscriptBox["r", "j"], FontWeight -> "Bold", FontSlant -> "Italic",
           StripOnInput -> False]}]},
      "Norm"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "7b15b67f-fadf-7b46-bb1a-9387d7ce3917"]
}], "Notes",
 CellID->387888782,ExpressionUUID->"f1aff380-2f9f-c347-8cb6-d796a6a01c4f"]
}, Closed]],

