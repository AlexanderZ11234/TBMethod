Cell[TextData[{
 "The string option ",
 Cell[BoxData["\"\<StateFunction\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ba634023-e5f3-7349-9cf3-fec5e35fdf3e"],
 " defaults to ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Total"]], "paclet:ref/Total"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    SuperscriptBox[
     RowBox[{
      TemplateBox[{
        Cell[
         TextData["Abs"]], "paclet:ref/Abs"},
       "RefLink",
       BaseStyle->{"InlineFormula"}], "[", "#1", "]"}], "4"], "]"}], "&"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7cb13b33-571a-6241-96d8-e98e4dc335d8"],
 ", the inverse participation ratio of a normalized state."
}], "Notes",
 CellID->1337439450,ExpressionUUID->"db05e73d-57f6-c942-87ed-3d099dce92e7"],

Cell[TextData[{
 Cell[BoxData["\"\<StateFunction\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "25323943-bc93-bd47-b7ea-27a4d63de598"],
 " must be an anonymous ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Function"]], "paclet:ref/Function"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "25832921-e00e-1f4c-94bb-ac2e060d54c8"],
 " or a nonempty list of anonymous functions, matching ",
 Cell[BoxData["_Function"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "37683a85-cc15-ef4e-b4c1-f761d7981f98"],
 " or ",
 Cell[BoxData[
  RowBox[{"{", "__Function", "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bbb63e69-7f83-e04c-8eaa-472da6da58b3"],
 ". Named functions do not match these implementation checks."
}], "Notes",
 CellID->1068202585,ExpressionUUID->"71ad1d49-aa20-b54d-aacd-771c666bb44f"],

Cell[TextData[{
 "With one state function, the output is grouped by sample and contains ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["energy", "TI"], ",", 
    StyleBox["weight", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e5626ad2-087b-514e-b9f6-696789c7a3a1"],
 " pairs. With several functions, the outer index selects the state \
function."
}], "Notes",
 CellID->1226759553,ExpressionUUID->"f8974121-54dc-ad47-95a1-25dee146936c"],

Cell[TextData[{
 "Omitting ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a1913140-51fb-634c-abb1-1d46f3a84acf"],
 " requests the matrix dimension. Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigensystem"]], "paclet:ref/Eigensystem"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "26083b6a-cc1e-394a-a757-87aa67121227"],
 " are filtered and passed through; the implementation supplies ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Method"]], "paclet:ref/Method"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{"\"\<Arnoldi\>\"", ",", 
     RowBox[{"\"\<MaxIterations\>\"", "\[Rule]", "\[Infinity]"}]}], "}"}]}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d2459311-7f7d-d541-ab8f-462f04dea098"],
 "."
}], "Notes",
 CellID->749399711,ExpressionUUID->"ea9ef27a-3f0c-aa43-a854-f9d4aea40cce"],

Cell[TextData[{
 "For a small full-spectrum calculation, use ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Method"]], "paclet:ref/Method"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", "\"\<Direct\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dd9da193-3f2c-f44f-8671-2e23f8d9c9bf"],
 " to avoid requesting the complete spectrum from the default Arnoldi \
solver."
}], "Notes",
 CellID->544592705,ExpressionUUID->"5042f871-110c-0348-88f1-61e802f97e7a"],

Cell[TextData[{
 "For a normalized eigenstate, the default weight is its inverse \
participation ratio:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"IPR", "(", "\[Psi]", ")"}], "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"a", "=", "1"}], "d"], 
      SuperscriptBox[
       TemplateBox[{
         SubscriptBox["\[Psi]", "a"]},
        "Abs"], "4"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "3619c655-5f8b-034b-a3a4-69b8e403da71"]
}], "Notes",
 CellID->666836071,ExpressionUUID->"bbeadc71-88ed-654b-a659-fd028f75f13d"]
}, Closed]],

