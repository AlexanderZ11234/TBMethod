  RowBox[{
   StyleBox["s", "TI"], "\[Rule]", "1"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9686708e-ccec-324d-8088-1ce390f61d4f"],
 ". The default order is ",
