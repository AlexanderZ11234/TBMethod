  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4a4f601d-806e-3240-8754-439c333b67a4"],
 "."
}], "Notes",
 CellID->1781316908,ExpressionUUID->"981b7ae2-b03d-5745-b2d9-67d7815e5711"],

Cell[TextData[{
