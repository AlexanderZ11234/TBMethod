Cell["\<\
The internal projector is applied to each site-diagonal Green block, and the \
contributions are summed over device sites.\
\>", "Notes",
 CellID->1496710216,ExpressionUUID->"ea536fea-ec78-a94a-a5f9-c7cb5ec09f10"],

Cell["\<\
The shortest form uses the lead onsite block as the device Hamiltonian.\
\>", "Notes",
 CellID->191698548,ExpressionUUID->"2754ba26-1b63-054b-a3ef-ea458401a7f1"],

Cell[TextData[{
 "The default ",
 Cell[BoxData[
  StyleBox["mode", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "75fd72c4-e82e-2a47-9f90-916fa6170160"],
 " is ",
 Cell[BoxData["3"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4b983d70-d897-d544-b1de-b3b0098cdfbe"],
 "; only ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "361fb901-aed2-0f40-a18f-f9f57f7a8cfc"],
 ", ",
 Cell[BoxData["2"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9d7473fb-77db-ff4e-8065-69ffe9f1ca00"],
 ", and ",
 Cell[BoxData["3"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1a467c0d-7003-0a40-8e0e-2be80b250bfd"],
 " are accepted by this wrapper."
}], "Notes",
 CellID->1025210888,ExpressionUUID->"b9a50d7e-3105-1b48-8479-e717edf308e4"],

Cell[TextData[{
 "The projected spectral density, summed over the device sites, is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["\[Rho]", "P"], "(", "\[Epsilon]", ")"}], "\[LongEqual]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"Im", "(", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"a", "=", "1"}], 
          SubscriptBox["N", "S"]], 
         RowBox[{"Tr", "[", 
          RowBox[{"P", ".", 
           RowBox[{
            SubscriptBox["G", 
             RowBox[{"{", 
              RowBox[{"a", ",", "a"}], "}"}]], "(", 
            RowBox[{"\[Epsilon]", "+", 
             RowBox[{"\[ImaginaryI]", " ", "\[Eta]"}]}], ")"}]}], "]"}]}], 
        ")"}], "\[Pi]"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "07cdabd5-4c24-1d43-b073-ef8b90d6d744"]
}], "Notes",
 CellID->273300904,ExpressionUUID->"07bc4eed-3531-b74b-929f-673f959f8c7f"]
}, Closed]],

