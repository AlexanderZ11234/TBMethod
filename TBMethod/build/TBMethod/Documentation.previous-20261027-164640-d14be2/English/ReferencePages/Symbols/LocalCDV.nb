Cell[TextData[{
 "Uses the reverse-ordered final Green column from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CentralBlockGreens"]], 
    "paclet:TBMethod/ref/CentralBlockGreens", "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8880b04d-861f-fc49-98e9-c391c74d32e3"],
 " in ",
 Cell[BoxData["\"\<LCDV\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "690c3372-580a-ee4a-98a4-f7c889c26aa1"],
 " mode. The point ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "290fd0d3-11cf-4748-803d-bf184dc85c9a"],
 " and Hamiltonian blocks use original layer order."
}], "Notes",
 CellID->250304435,ExpressionUUID->"4e9c7daf-48d0-bc4f-9e60-e41c6fe4f431"],

Cell[TextData[{
 "Returns pairs of the form ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["coordinate", "TI"], ",", 
    StyleBox["vector", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7bb458c7-3391-c94c-b2a4-3b486088f8a0"],
 ". Sites with no stored current entries may be absent."
}], "Notes",
 CellID->1122257432,ExpressionUUID->"5290bb67-c6c1-f344-9882-cff5da0cb2ce"],

Cell[TextData[{
 "The internal ",
 Cell[BoxData[
  StyleBox["projection", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f2deae8f-02ec-de4a-94a6-a9763947027e"],
 " must match the degrees of freedom per site. The normalization contains ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "\[Pi]"], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "3365bf25-56a5-6c42-bc81-250664f39db1"],
 "; no explicit charge or ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "07b717e1-a091-1642-a7e6-6ae05b3f4c09"],
 " factor is inserted."
}], "Notes",
 CellID->1998930538,ExpressionUUID->"08bb7760-dc42-404f-8b11-2f763483326b"],

Cell["\<\
The internal coordinate helper has overlapping input patterns for a device \
containing exactly two sites. Use care with that case in the current \
implementation.\
\>", "Notes",
 CellID->477771191,ExpressionUUID->"5982f9be-2299-fc4f-93ac-dcadd2c972e1"],

Cell[TextData[{
 "For one scalar internal state and identity projection, the bond-current \
convention is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["J", 
      RowBox[{"{", 
       RowBox[{"i", ",", "j"}], "}"}]], "\[LongEqual]", 
     FractionBox[
      RowBox[{"Im", "(", 
       RowBox[{
        SubscriptBox["H", 
         RowBox[{"{", 
          RowBox[{"j", ",", "i"}], "}"}]], " ", 
        SubscriptBox[
         RowBox[{"G", ".", "\[CapitalGamma]", ".", 
          TemplateBox[{"G"},
           "ConjugateTranspose"]}], 
         RowBox[{"{", 
          RowBox[{"i", ",", "j"}], "}"}]]}], ")"}], "\[Pi]"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "d229183f-db74-3b41-8316-0f69d4965aa5"]
}], "Notes",
 CellID->617921900,ExpressionUUID->"0d38bfac-2e98-9a4a-9359-8805d0008c34"],

Cell[TextData[{
 "The vector field weights each bond by its actual displacement:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[ScriptCapitalJ]", "i"], "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"j", "=", "1"}], 
       SubscriptBox["N", "S"]], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["r", "j"], "-", 
         SubscriptBox["r", "i"]}], ")"}], " ", 
       SubscriptBox["J", 
        RowBox[{"{", 
         RowBox[{"i", ",", "j"}], "}"}]]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "2e73f655-c03c-f248-ac59-3a698d0e12f7"]
}], "Notes",
 CellID->1430821638,ExpressionUUID->"8b484dcf-c4a2-1f41-8d30-86fbbe134f58"]
}, Closed]],

