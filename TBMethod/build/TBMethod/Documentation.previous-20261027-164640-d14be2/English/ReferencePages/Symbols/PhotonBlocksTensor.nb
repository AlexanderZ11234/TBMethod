Cell[TextData[{
 Cell[BoxData[
  StyleBox["matrixModulation", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ae61994b-6f1f-f942-a07d-9fa700bace7f"],
 " is a periodic matrix-valued function of a dimensionless angle. Its \
dimensions are inferred by evaluating ",
 Cell[BoxData[
  RowBox[{
   StyleBox["matrixModulation", "TI"], "[", "0.123", "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8d588a67-e59d-c94c-b6d5-b8e180e431cc"],
 "."
}], "Notes",
 CellID->1565103609,ExpressionUUID->"decd501f-17fd-ac49-bcf0-468a783046d5"],

Cell[TextData[{
 "Returns two rank-4 tensors with axes ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["internalRow", "TI"], ",", 
    StyleBox["internalColumn", "TI"], ",", 
    StyleBox["photonRow", "TI"], ",", 
    StyleBox["photonColumn", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b42fe8d6-33ee-b44f-8ae1-8c058783fef2"],
 ". Photon indices run from ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"-", "m"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "9c9c0df8-1680-3e4e-b507-12ae5d8ac6b4"],
 " through ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7fbf5d28-d0e0-574d-9e2c-5454562bb567"],
 "."
}], "Notes",
 CellID->123957955,ExpressionUUID->"b707487d-dc04-0b46-af3a-e1e30d0a2a24"],

Cell[TextData[{
 "For distinct sites, the first tensor contains Fourier coefficients at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["columnIndex", "TI"], "-", 
   StyleBox["rowIndex", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f1efb99c-f9cb-5945-9b13-50244d4627c7"],
 " and the second is zero. For coincident sites, the first is the \
internal/photon identity tensor and the second includes the Fourier tensor \
and a diagonal photon-energy shift of ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"-", "n"}], " ", "\[Omega]"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "9e39ddb1-32bd-184f-929e-a8ceab358e80"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TagBox["n",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "ed8687a6-ad2e-c944-856a-26104e0ef85f"],
 " is the photon index."
}], "Notes",
 CellID->1061837692,ExpressionUUID->"df9a47c5-cfc6-6446-a54f-3091c3cc0d75"],

Cell[TextData[{
 "Coincidence is detected using a distance threshold of ",
 Cell[BoxData["0.00001"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "729b60ed-5ee5-0c4e-8360-fae0f86f77d7"],
 ". Combine the tensors with ",
