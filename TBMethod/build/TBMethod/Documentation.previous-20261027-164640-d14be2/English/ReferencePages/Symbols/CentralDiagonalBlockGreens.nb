      SubscriptBox["F", "j"], "+", 
      RowBox[{
       SubscriptBox["F", "j"], ".", 
       SubscriptBox["H", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"j", "+", "1"}]}], "}"}]], ".", 
       SubscriptBox["G", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"j", "+", "1"}], ",", 
          RowBox[{"j", "+", "1"}]}], "}"}]], ".", 
       SubscriptBox["H", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"j", "+", "1"}], ",", "j"}], "}"}]], ".", 
       SubscriptBox["F", "j"]}]}]}],
