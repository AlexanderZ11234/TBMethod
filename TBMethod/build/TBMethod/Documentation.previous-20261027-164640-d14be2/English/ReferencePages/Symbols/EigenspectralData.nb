Cell[TextData[{
 "The default ",
 Cell[BoxData[
  StyleBox["stateFunction", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "323ad78b-534d-d94a-bb99-9ebfad4d085e"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Identity"]], "paclet:ref/Identity"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "024b827b-e4a8-cd47-8831-2abbea54ee70"],
 ", so each sample produces a list of ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["energy", "TI"], ",", 
    StyleBox["eigenvector", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f9a2b5fc-3fc6-084c-aa13-53820cd96bf4"],
 " pairs."
}], "Notes",
 CellID->1477896377,ExpressionUUID->"197fbc8d-1de5-5341-a632-fc66d50fd098"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["stateFunction", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5fd008e2-da4e-434a-babe-fc3f3fa8864e"],
 " acts on each eigenvector. For example, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Total"]], "paclet:ref/Total"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    SuperscriptBox[
     RowBox[{
      TemplateBox[{
        Cell[
         TextData["Abs"]], "paclet:ref/Abs"},
       "RefLink",
       BaseStyle->{"InlineFormula"}], "[", "#1", "]"}], "4"], "]"}], "&"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bf80b568-7b00-4f43-90c0-b6a65c81d76b"],
 " gives its inverse participation ratio when the state is normalized."
}], "Notes",
 CellID->223274253,ExpressionUUID->"c936d1bd-af8d-b24f-a11e-b1e2439ab8dc"],

