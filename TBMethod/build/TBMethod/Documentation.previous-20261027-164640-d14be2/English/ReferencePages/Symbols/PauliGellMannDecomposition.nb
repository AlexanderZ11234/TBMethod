Cell[TextData[{
 "For two internal factors, let ",
 Cell[BoxData[
  FormBox[
   TagBox["T",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "7192609b-939a-464c-b316-345c83ac23a7"],
 " denote the corresponding Pauli or Gell-Mann basis, including its identity \
element. The coefficient association represents",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"M", "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"a", "=", "0"}], 
       RowBox[{
        SubsuperscriptBox["d", "1", "2"], "-", "1"}]], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"b", "=", "0"}], 
        RowBox[{
         SubsuperscriptBox["d", "2", "2"], "-", "1"}]], 
       RowBox[{
        SubscriptBox["c", 
         RowBox[{"{", 
          RowBox[{"a", ",", "b"}], "}"}]], " ", 
        RowBox[{
         SubscriptBox["T", "a"], "\[CircleTimes]", 
         SubscriptBox["T", "b"]}]}]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "e3ad6844-4c77-b34c-a781-d0342034e7d3"]
}], "Notes",
 CellID->1206843542,ExpressionUUID->"92d72913-e4a2-264b-80b5-68b34dff0bf0"]
}, Closed]],

