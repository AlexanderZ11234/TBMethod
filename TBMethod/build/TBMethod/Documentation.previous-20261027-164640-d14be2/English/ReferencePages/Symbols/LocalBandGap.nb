Cell[TextData[{
 Cell[BoxData[
  StyleBox["samples", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "90946544-3ba7-2e40-9bf9-ab62ad74bf28"],
 " must be a nonempty list of real scalar values or real coordinate lists, \
matching ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"{", "__Real", "}"}], "|", "_Real"}], ")"}], ".."}], "}"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ca8eb948-1d5a-a34c-91e0-2fe22b82f5d6"],
 ". Exact integer samples do not match this input pattern."
}], "Notes",
 CellID->1255766907,ExpressionUUID->"d32965bc-a4f7-2640-8c47-0423e3bd0c99"],

Cell[TextData[{
 "At each sample, the full eigenvalue list is sorted before the adjacent-band \
difference is formed. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Chop"]], "paclet:ref/Chop"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "88195ccc-ecd2-8448-bddb-c92f6e897f26"],
 " is applied to numerical residues."
}], "Notes",
 CellID->1922543684,ExpressionUUID->"6113d8c4-1139-fb43-895b-c71285b4b09c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1fad3f79-9bc7-7c41-9cc4-d1ffd49ceaca"],
 " must satisfy ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"1", "\[LessEqual]", "n", "<", "dim"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "8ca9188a-1594-774e-998a-a628be7dd361"],
 ", where ",
 Cell[BoxData[
  StyleBox["dim", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "50bfbc62-b6b4-dc49-b05a-1cb1957ebba1"],
 " is the Hamiltonian matrix dimension."
}], "Notes",
 CellID->364713176,ExpressionUUID->"4c9487c3-1655-ef4e-8c9a-8148c21239be"],

Cell[TextData[{
 "This is an estimate over the supplied sample points. Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigenvalues"]], "paclet:ref/Eigenvalues"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e8d385e1-c660-2749-9165-9081d39d995e"],
 " are accepted, with ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Method"]], "paclet:ref/Method"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", "\"\<Direct\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d0bc4708-79e5-db4c-8349-f4fd2e8206f5"],
 " supplied internally."
}], "Notes",
 CellID->1925145700,ExpressionUUID->"5931ea74-e275-054c-b02e-deb2e4e02ab5"],

Cell[TextData[{
 "For the supplied sample set, the direct gap is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[CapitalDelta]", "direct"], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["Min", 
       RowBox[{"k", "\[Element]", "\[ScriptCapitalK]"}]], "(", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[ExponentialE]", 
         RowBox[{"n", "+", "1"}]], "(", "k", ")"}], "-", 
       RowBox[{
        SubscriptBox["\[ExponentialE]", "n"], "(", "k", ")"}]}], ")"}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "83da6d33-533f-984f-803d-ba4a5689c0cf"]
}], "Notes",
 CellID->2076599254,ExpressionUUID->"840d90c2-baf7-714f-b9b4-9a9adfd4c6b9"]
}, Closed]],

