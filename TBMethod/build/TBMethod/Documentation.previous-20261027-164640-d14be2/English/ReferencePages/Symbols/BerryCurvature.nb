Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "83e3b1cb-c6bd-fa45-84d2-4c7bac28dfa2"],
 " returns the Hamiltonian, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["velocities", "TI"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "db1f8cfd-9a7e-ca49-b2b8-5d9562d60c22"],
 " returns its derivative-matrix list, and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["hv", "TI"], "[", 
