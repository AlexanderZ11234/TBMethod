  "b6340cc9-4e9f-474b-9d7a-2af450188f5e"],
 Cell[BoxData[
  TemplateBox[{1},
   "Spacer1"]],ExpressionUUID->"af4a43e2-8692-8946-b111-135c32318a7e"],
 "Additional Examples",
 "\[NonBreakingSpace]\[NonBreakingSpace]",
 Cell["(1)", "ExampleCount",ExpressionUUID->
  "b125e8c1-537c-324d-8ea4-49f10745d45f"]
}], "ExampleSection", "ExampleSection",
 WholeCellGroupOpener->True,
 CacheGraphics->False,
 CellID->1517609642,ExpressionUUID->"782c7c50-3e7d-8245-a31b-7953b2a23a7b"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"BerryCurvature", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox[
       SubscriptBox["k", "x"],
       FontSlant->"Italic"], ",", " ", 
      StyleBox[
       SubscriptBox["k", "y"],
       FontSlant->"Italic"]}], "}"}], ",", " ", 
    StyleBox["H",
     FontSlant->"Italic"], ",", " ", 
    SubscriptBox[
     StyleBox["n",
      FontSlant->"Italic"], "F"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5b98b430-f594-c24c-a030-09e0e443e0d5"],
 " calculates the Berry curvature ",
 Cell[BoxData[
  StyleBox["\[CapitalOmega]",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "37bd3421-efda-9e4d-830d-f6a122bdb033"],
 " for a (at least locally) gapped Bloch Hamiltonian ",
 Cell[BoxData[
  StyleBox["H",
   FontSlant->"Italic"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a4333bb7-7113-274c-b758-a3ac11c7609a"],
 " at the lattice momentum point ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox[
     SubscriptBox["k", "x"],
     FontSlant->"Italic"], ",", 
    StyleBox[
     SubscriptBox["k", "y"],
     FontSlant->"Italic"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c3e6c000-867c-1542-99eb-4028d059990f"],
 " in the first Brillouin zone, with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n",
    FontSlant->"Italic"], "F"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e5c86c9c-9984-7b47-b616-234351aa252e"],
 " states occupied."
}], "ExampleText",
 CellID->40067621,ExpressionUUID->"f286fd9f-aca1-454c-a582-8510e43e9865"],

Cell[TextData[{
 "The Bloch Hamiltonian is a map ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["H",
     FontSlant->"Italic"], 
    StyleBox[":",
     FontSlant->"Plain"], 
    StyleBox[" ",
     FontSlant->"Plain"], 
    SuperscriptBox[
     StyleBox[
      TemplateBox[{},
       "Reals"],
      FontSlant->"Plain"], "2"]}], "\[Rule]", " ", 
   SuperscriptBox[
    FormBox[
     TemplateBox[{},
      "Complexes"],
     TraditionalForm], 
    RowBox[{
     StyleBox["n",
      FontSlant->"Italic"], " ", "\[Times]", " ", 
     StyleBox["n",
      FontSlant->"Italic"]}]]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "399b46ff-90f3-454b-9f9e-d1da1b31426b"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n",
    FontSlant->"Italic"], 
   StyleBox["\[Element]",
    FontSlant->"Plain"], 
   SuperscriptBox[
    StyleBox["\[DoubleStruckCapitalZ]",
     FontSlant->"Plain"], "+"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a163444b-5ca7-af45-aba7-f16e2f164016"],
 " is the band number."
}], "ExampleText",
 CellID->221447166,ExpressionUUID->"f1079d26-216b-d043-8f18-92924a7e54ba"],

Cell["Load the package", "ExampleText",
 CellID->11904999,ExpressionUUID->"34025126-aff0-154c-bcb3-d00108fc0ab0"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<TBMethod`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->226833854,ExpressionUUID->"7c93ad5f-556e-aa44-bb99-06780b39ff34"],

Cell["This constructs a modified Qi-Wu-Zhang model", "ExampleText",
 CellID->129563622,ExpressionUUID->"b0ac5bbf-a3e0-9843-bcbd-ed55c56fd50d"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "HQWZ", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"HQWZ", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"kx_", ",", "ky_"}], "}"}], ",", 
    RowBox[{"{", "M_", "}"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sin", "[", "kx", "]"}], ",", 
     RowBox[{"Sin", "[", "ky", "]"}], ",", 
     RowBox[{"M", "-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Cos", "[", "kx", "]"}], "+", 
        RowBox[{"Cos", "[", "ky", "]"}]}], ")"}]}]}], "}"}], ".", 
   RowBox[{"PauliMatrix", "[", 
    RowBox[{"Range", "[", "3", "]"}], "]"}]}]}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->532933989,ExpressionUUID->"593bc7a3-e09f-f444-9258-cf3add3b57a5"],

Cell[TextData[{
 "This evaluates the Berry curvature of the model above with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["M",
    FontSlant->"Italic"], "=", 
   RowBox[{"-", "1"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8afdc0d9-9c6c-b04f-b96f-1b11c18208aa"],
 " at the \[CapitalGamma] point and with one band occupied (",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n",
     FontSlant->"Italic"], "F"], "=", "1"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d5f6f45b-ee34-ec46-9f09-852568aa8986"],
 ")"
}], "ExampleText",
 CellID->32212198,ExpressionUUID->"1e49ddee-14af-9b42-909f-ec70236f258a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"M", ",", "nF", ",", "\[CapitalOmega]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"M", ",", "nF"}], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalOmega]", "[", "vk_", "]"}], ":=", 
  RowBox[{"BerryCurvature", "[", 
   RowBox[{"vk", ",", 
    RowBox[{
     RowBox[{"HQWZ", "[", 
      RowBox[{"#", ",", 
       RowBox[{"{", "M", "}"}]}], "]"}], "&"}], ",", "nF"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"\[CapitalOmega]", "[", 
  RowBox[{"{", 
   RowBox[{".0", ",", ".0"}], "}"}], "]"}]}], "Input",
 CellLabel->"In[3]:=",
 CellID->771853870,ExpressionUUID->"2e907083-8f77-e041-bb3c-8d2aec8fc0d6"],

Cell[BoxData[
 RowBox[{"-", "0.05555555555555536`"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->18576078,ExpressionUUID->"fa59370f-2af3-7843-b6c5-b2821313a28b"]
}, Open  ]],

Cell[TextData[{
 "We know that the above state is a Chern insulator with a Chern number ",
 Cell[BoxData[
  RowBox[{"\[ScriptCapitalC]", "=", "1"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8afe7275-ca22-394c-a336-18145ab10670"],
 ", and codes below approximates the corresponding result"
}], "ExampleText",
 CellID->685608477,ExpressionUUID->"2c692dfd-c969-9f44-acac-7eab2a8ae5cb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"nmesh", "=", "500"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vkmesh", "=", 
    RowBox[{"Tuples", "[", 
     RowBox[{
      RowBox[{"Subdivide", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1."}], "\[Pi]"}], ",", "\[Pi]", ",", "nmesh"}], "]"}], 
      ",", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalOmega]data", "=", 
    RowBox[{"ParallelTable", "[", 
     RowBox[{
      RowBox[{"Append", "[", 
       RowBox[{"vk", ",", 
        RowBox[{"\[CapitalOmega]", "[", "vk", "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"vk", ",", "vkmesh"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot3D", "[", "\[CapitalOmega]data", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  FractionBox["1", 
   RowBox[{"2", "\[Pi]"}]], 
  SuperscriptBox[
   RowBox[{"(", 
    FractionBox[
     RowBox[{"2", "\[Pi]"}], 
     RowBox[{"nmesh", "+", "1"}]], ")"}], "2"], 
  RowBox[{"Total", "[", 
   RowBox[{"\[CapitalOmega]data", "\[LeftDoubleBracket]", 
    RowBox[{";;", ",", "3"}], "\[RightDoubleBracket]"}], "]"}]}]}], "Input",
 CellLabel->"In[4]:=",
 CellID->155520695,ExpressionUUID->"be93d1da-a745-4c48-8d54-832179a60c6c"],

