 CellLabel->"In[1]:=",
 CellID->166281335,ExpressionUUID->"8104f094-75dc-a243-86f4-c7e51a98eb26"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"h", ",", "v", ",", "hv"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "k_", "]"}], ":=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"k", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], " ", 
      RowBox[{"PauliMatrix", "[", "1", "]"}]}], "+", 
     RowBox[{
      RowBox[{"k", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], " ", 
      RowBox[{"PauliMatrix", "[", "2", "]"}]}], "+", 
     RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"v", "[", "k_", "]"}], ":=", 
   RowBox[{"N", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "1", "]"}], ",", 
      RowBox[{"PauliMatrix", "[", "2", "]"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hv", "[", "k_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"h", "[", "k", "]"}], ",", 
     RowBox[{"v", "[", "k", "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"BerryCurvature", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0.", ",", "0."}], "}"}], ",", "h", ",", "1"}], "]"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->2097861297,ExpressionUUID->"fa08e903-1f35-ef4d-bdab-f007837d572a"],

Cell[BoxData["0.5`"], "Output",
 CellLabel->"Out[2]=",
 CellID->2044228564,ExpressionUUID->"4d084e1f-9560-c14c-b6df-39fed5327665"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  DynamicBox[ToBoxes[
    If[CurrentValue[
       EvaluationCell[], "CellGroupOpen"] =!= Closed, 
