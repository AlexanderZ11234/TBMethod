  "Openers" -> {
   "PrimaryExamplesSection" -> Open, "ExampleSection" -> {"0" -> Open}, 
    "AllOptsTable" -> Closed}, "NewStyles" -> True, 
  "CitationPopupData" -> $Failed, "ShowCitation" -> False, "HasOptions" -> 
  True, "RootCaptions" -> "", "HeaderCoreAreaLink" -> {}, 
  "Metadata" -> {
   "built" -> "{2026, 10, 26, 16, 54, 12.7140933}", 
    "history" -> {"", "", "", ""}, "context" -> "TBMethod`EigenSpect`", 
    "keywords" -> {"BerryCurvature tight binding TBMethod"}, 
    "specialkeywords" -> {}, "tutorialcollectionlinks" -> {}, "index" -> True,
     "label" -> "T B Method Symbol", "language" -> "en", "paclet" -> 
    "TBMethod", "status" -> "None", "summary" -> 
    "BerryCurvature[{h, velocities}, filling][k] computes the occupied-band \
Berry curvature at momentum k from the Hamiltonian and its momentum \
derivatives. BerryCurvature[{h, velocities}, filling, {alpha, beta}][k] \
computes the component specified by derivative directions alpha and beta. \
BerryCurvature[{h, velocities}, q, filling, {alpha, beta}][k] inserts the \
symmetrized observable current associated with q into the first derivative \
direction. BerryCurvature[hv, filling, {alpha, beta}][k] uses a combined \
function hv that returns the Hamiltonian and its derivative matrices. \
BerryCurvature[hv, q, filling, {alpha, beta}][k] uses the combined \
Hamiltonian\\[Dash]derivative function and an observable-current insertion. \
BerryCurvature[k, h, filling] estimates the two-dimensional Berry curvature \
by backward finite differences of h.", "synonyms" -> {}, "tabletags" -> {}, 
    "title" -> "BerryCurvature", "titlemodifier" -> "", "metadescription" -> 
    "", "windowtitle" -> "BerryCurvature", "type" -> "Symbol", "uri" -> 
    "TBMethod/ref/BerryCurvature", "WorkflowDockedCell" -> ""}, 
  "SearchTextTranslated" -> ""},
