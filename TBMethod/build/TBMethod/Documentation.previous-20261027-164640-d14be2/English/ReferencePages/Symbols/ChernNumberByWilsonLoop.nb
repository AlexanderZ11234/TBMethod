Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4e7f432e-8fe4-bc4a-8556-c041b2b0885e"],
 " returns a Hermitian Hamiltonian. The positive integer ",
