Cell["\<\
Each plaquette loop is closed internally. Its orientation affects the \
determinant phase and the sign of the returned sum.\
\>", "Notes",
 CellID->277435572,ExpressionUUID->"59e3e25e-0b3a-3b46-996d-6ad6079fd7a6"],

Cell["\<\
A meaningful Chern estimate requires a consistent oriented covering of the \
relevant closed momentum space and a separated occupied subspace. The \
function does not validate orientation, convergence, or integrality.\
\>", "Notes",
 CellID->1233611759,ExpressionUUID->"b984dc91-4031-a34d-a08c-f35ec0da0f2c"],

Cell[TextData[{
 "Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Eigensystem"]], "paclet:ref/Eigensystem"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "217665ec-1d15-5445-9ccd-c8ffd5820a13"],
 " are accepted, with ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Method"]], "paclet:ref/Method"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "\[Rule]", "\"\<Direct\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "03d3f89a-ec78-9f4e-9228-92c422b29aab"],
 " supplied internally."
}], "Notes",
 CellID->859100748,ExpressionUUID->"3131c297-8e8f-5347-981f-1333c31db52d"],

Cell[TextData[{
 "For each oriented plaquette, let ",
 Cell[BoxData[
  FormBox[
   TagBox["W",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "3f6e8254-199e-0f47-aabc-ab72e5cc628b"],
 " denote the ordered product of occupied-state overlap matrices. The \
returned sum is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"C", "\[LongEqual]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"p", "=", "1"}], 
         SubscriptBox["N", "P"]], 
        RowBox[{"arg", "(", 
         TemplateBox[{
           SubscriptBox["W", "p"]},
          "Det"], ")"}]}], 
       RowBox[{"2", " ", "\[Pi]"}]]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "d0a97218-fd58-8b47-af36-eeafd985970f"]
}], "Notes",
 CellID->514161825,ExpressionUUID->"c543898d-b67f-7346-8315-406de131ce3d"]
}, Closed]],

