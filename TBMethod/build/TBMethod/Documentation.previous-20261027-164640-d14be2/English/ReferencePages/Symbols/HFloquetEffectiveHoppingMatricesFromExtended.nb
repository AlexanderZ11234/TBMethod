Cell[TextData[{
 "Accepts an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c5b75479-6c08-5844-9b37-8147bdebb01d"],
 " with entries ",
 Cell[BoxData[
  RowBox[{
   StyleBox["displacement", "TI"], "\[Rule]", 
   StyleBox["extendedHoppingMatrix", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5a7b7317-1b67-3148-bf91-dbec846cb0c2"],
 ", or the two-list layered scattering-region block representation. Every \
matrix uses internal-major, photon-minor ordering with ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"2", " ", "m"}], "+", "1"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "7ffba0d6-62ff-b043-b8c6-dfc06632fdd9"],
 " photon sectors."
}], "Notes",
 CellID->870078728,ExpressionUUID->"aa319f0b-50f1-674a-a96b-a64cbb8ebcf9"],

Cell["\<\
For displacement associations, block multiplication adds displacement \
vectors. Supply a complete directed-hopping association when needed to \
represent a Hermitian model.\
\>", "Notes",
 CellID->483172806,ExpressionUUID->"38016648-0146-1745-b9e9-7c5498ecf8e5"],

Cell[TextData[{
 "For scattering-region input, block multiplication contracts layer indices. \
If the effective result contains nonzero couplings between nonadjacent \
layers, the implementation emits a message and returns ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Failed"]], "paclet:ref/$Failed"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fa1bf297-610a-3a46-98d1-b43432238237"],
 " because the two-list form cannot represent them."
}], "Notes",
 CellID->342267340,ExpressionUUID->"95189cc7-778b-a442-bd13-4f2bbf89e5b6"],

Cell[TextData[{
 "The options ",
