Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"omega", "=", "10."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h0", "=", 
   RowBox[{
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "3", "]"}], ",", 
      RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}], "+", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "0", "]"}], ",", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{
        RowBox[{"-", "omega"}], " ", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "]"}]}], "]"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h1", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"PauliMatrix", "[", "0", "]"}], "5"]}], ",", 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hops", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", "0", "}"}], "\[Rule]", "h0"}], ",", 
     RowBox[{
      RowBox[{"{", "1", "}"}], "\[Rule]", "h1"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"-", "1"}], "}"}], "\[Rule]", "h1"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"HFloquetEffectiveHoppingMatricesFromExtended", "[", 
   RowBox[{"omega", ",", "1"}], "]"}], "[", "hops", "]"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->1789369685,ExpressionUUID->"3bc19c6a-6cb8-484c-8ea4-2eab25a5fed1"],

