Cell["\<\
Downfold a two-layer block-tridiagonal Hamiltonian in the same photon \
ordering.\
\>", "ExampleText",
 CellID->607248877,ExpressionUUID->"4f8caf60-7508-1746-ae80-76c8c10518a1"],

