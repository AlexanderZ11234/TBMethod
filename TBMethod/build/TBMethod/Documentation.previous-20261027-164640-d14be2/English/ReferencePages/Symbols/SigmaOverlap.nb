Cell[TextData[{
 "At complex energy, the two interface factors contain the same ",
 Cell[BoxData[
  FormBox[
   TagBox["z",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "12c09d96-a31c-7146-88c9-8c913b8c2956"],
 ":",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"\[CapitalSigma]", "(", "z", ")"}], "\[LongEqual]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"V", "-", 
        RowBox[{"z", " ", "S"}]}], ")"}], ".", 
      RowBox[{
       SubscriptBox["g", "s"], "(", "z", ")"}], ".", 
      RowBox[{"(", 
       RowBox[{
        TemplateBox[{"V"},
         "ConjugateTranspose"], "-", 
        RowBox[{"z", " ", 
         TemplateBox[{"S"},
          "ConjugateTranspose"]}]}], ")"}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "8fa098b0-1745-f749-81fd-c74742da5e07"]
}], "Notes",
 CellID->546351578,ExpressionUUID->"66c5853f-56c3-a043-a302-6b68746101ab"]
}, Closed]],

