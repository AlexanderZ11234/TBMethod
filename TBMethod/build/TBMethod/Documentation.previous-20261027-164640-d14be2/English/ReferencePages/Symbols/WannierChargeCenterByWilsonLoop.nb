Cell["\<\
The path is closed internally by connecting the final occupied subspace back \
to the first; a repeated endpoint is optional.\
\>", "Notes",
 CellID->562497456,ExpressionUUID->"9d0e37e5-0e80-714a-8b04-197cf20e093d"],

Cell[TextData[{
 "The package multiplies eigenphases by ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"-", 
     FractionBox["1", "\[Pi]"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "aa56e5cb-b00e-374f-bc4e-5be4d18c5f5e"],
 ", as shown below. This differs by a factor of two from conventions \
expressed in units of ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"2", " ", "\[Pi]"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "d9c64348-ae59-6a4d-939f-d6a0e2058b13"],
 "."
}], "Notes",
 CellID->1620805162,ExpressionUUID->"f1c23953-2c53-094b-9e57-e95cc09f2090"],

Cell["\<\
A separated occupied subspace and a sufficiently dense path are needed for a \
stable result.\
\>", "Notes",
 CellID->1674627728,ExpressionUUID->"39d492af-618e-8844-bb34-71c451268499"],

Cell[TextData[{
 "Options for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
