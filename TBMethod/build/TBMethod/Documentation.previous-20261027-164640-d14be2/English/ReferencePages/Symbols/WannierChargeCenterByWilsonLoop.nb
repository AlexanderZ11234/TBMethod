Cell[TextData[{
 "If the eigenvalues of the occupied-subspace Wilson product are denoted by \
",
 Cell[BoxData[
  FormBox[
   TagBox["\[Lambda]",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "7d9998d6-dbd5-9b40-87b0-6058437ec23b"],
 ", the normalization used here is",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[Nu]", "j"], "\[LongEqual]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"arg", "(", 
        RowBox[{
         SubscriptBox["\[Lambda]", "j"], "(", "W", ")"}], ")"}], "\[Pi]"]}]}],
    
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "550de6cf-9cf6-3140-91e4-b0956c4cc621"]
}], "Notes",
 CellID->1768337914,ExpressionUUID->"f41ad793-8d64-9e4a-b65a-18276cd9cc92"]
}, Closed]],

