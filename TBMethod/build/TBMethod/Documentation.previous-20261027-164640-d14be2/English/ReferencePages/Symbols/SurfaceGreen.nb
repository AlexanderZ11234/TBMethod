Cell[TextData[{
 "For retarded boundary conditions, use a complex energy ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "57f01ea7-250f-ad40-a172-325b014160a2"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Im", "(", "z", ")"}], ">", "0"}], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "add85984-3b16-9f4b-bbee-bc44452f70ea"],
 "."
}], "Notes",
 CellID->521869274,ExpressionUUID->"1ac36d9e-6179-b743-9223-4fae1eb754df"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["h0", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "27b81a86-253f-0744-a076-e586ed3fffc2"],
 " is the onsite block, and ",
 Cell[BoxData[
  StyleBox["h1", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d4503b55-bdc0-3641-bd20-d6ebe324c4c7"],
 " couples neighboring principal layers. The optional reverse coupling ",
 Cell[BoxData[
  StyleBox["h1upper", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ac2f875d-3fef-d744-97ed-9f7ebd358ecc"],
 " defaults to ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["h1", "TI"]},
   "ConjugateTranspose"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e98ed670-8a78-7347-9d78-0292c97fea20"],
 "."
}], "Notes",
 CellID->2099493439,ExpressionUUID->"a993b060-def3-ef4c-987d-ca39b9c79142"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["mode", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "086ee18c-946a-1e4a-9b9f-33876c0cc14b"],
 " argument is required: ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f369b383-9384-5f48-90fa-57fea718ab43"],
 " uses iterative decimation; ",
 Cell[BoxData["2"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2767361f-b5fa-0b4e-b344-f13ed5367b1a"],
 " and ",
 Cell[BoxData["3"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9ed0e9fc-35ab-3b42-9523-c9df7b8af10a"],
 " use transfer matrices; ",
 Cell[BoxData["4"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ff8ef21c-bb2a-364e-b63f-6be3c3033018"],
 " and ",
 Cell[BoxData["5"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2e42c6af-307c-f54c-9a21-84935dadc402"],
 " regularize the hopping by singular value decomposition."
}], "Notes",
 CellID->514891894,ExpressionUUID->"b2659d4e-cedb-3f4c-80e3-1f4a6261af03"],

Cell[TextData[{
 "Modes ",
 Cell[BoxData["2"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "433c38e9-7d39-1048-962c-090729647f08"],
 " and ",
 Cell[BoxData["4"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4fe3251c-f00d-2e4a-98e4-6862c7492d48"],
 " invert a hopping block. Modes ",
 Cell[BoxData["3"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d5316310-9422-de48-bb02-1fb8a7850893"],
 " and ",
 Cell[BoxData["5"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d543741f-9453-ec41-b856-52e9a3978fdf"],
 " use a generalized eigenproblem."
}], "Notes",
 CellID->132384878,ExpressionUUID->"18171521-61f7-e84d-91a5-83fd213844f7"],

Cell[TextData[{
 "The string-named option ",
 Cell[BoxData[
  RowBox[{"\"\<\[Delta]SVD\>\"", "\[Rule]", "1.*^-7"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6731ad7e-5039-7d44-8db9-9af062614404"],
 " sets the relative singular-value floor in modes ",
 Cell[BoxData["4"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2521c3d3-2da6-c74b-8414-558acdf86c19"],
 " and ",
 Cell[BoxData["5"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5b378411-bfdb-cb4f-a327-8d677675ffb3"],
 "."
}], "Notes",
 CellID->971957590,ExpressionUUID->"a01e4b66-efe4-6346-abc6-89619b723294"],

Cell[TextData[{
 "With the default Hermitian-conjugate reverse coupling, the surface matrix \
satisfies",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["g", "s"], "(", "z", ")"}], "\[LongEqual]", 
     TemplateBox[{
       RowBox[{"(", 
         RowBox[{
           RowBox[{"z", " ", "\[DoubleStruckCapitalI]"}], "-", 
           SubscriptBox["h", "0"], "-", 
           RowBox[{
             SubscriptBox["h", "1"], ".", 
             RowBox[{
               SubscriptBox["g", "s"], "(", "z", ")"}], ".", 
             TemplateBox[{
               RowBox[{"(", 
                 SubscriptBox["h", "1"], ")"}]}, "ConjugateTranspose", 
              SyntaxForm -> SuperscriptBox]}]}], ")"}]},
      "Inverse"]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "6ac2bbb3-7808-c848-8377-2ad814fb45fe"]
}], "Notes",
 CellID->1440010226,ExpressionUUID->"4e58d5f8-9ff7-2b41-b690-c7064031bb35"]
}, Closed]],

