Cell[TextData[{
 "The function has attribute ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Listable"]], "paclet:ref/Listable"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "430b0d9c-9806-e74d-83f9-83703105913e"],
 " and returns ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SparseArray"]], "paclet:ref/SparseArray"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ae899235-d382-d74b-8fcf-ed21a35053a8"],
 " matrices. For generator indices ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"1", "\[LessEqual]", "i", "\[LessEqual]", "8"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "cefc25e9-451b-fd43-8f02-64fda25d605c"],
 " and ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"1", "\[LessEqual]", "j", "\[LessEqual]", "8"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "f16f740b-8981-9045-9e1b-cec1680229ed"],
 ", the normalization is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"Tr", "[", 
      RowBox[{
       SubscriptBox["\[Lambda]", "i"], ".", 
       SubscriptBox["\[Lambda]", "j"]}], "]"}], "\[LongEqual]", 
     RowBox[{"2", " ", 
      TemplateBox[{
        RowBox[{"i", ",", "j"}]},
       "KroneckerDeltaSeq"]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "e007bcd9-51ea-ba4c-a8f9-f9a61b20df07"],
