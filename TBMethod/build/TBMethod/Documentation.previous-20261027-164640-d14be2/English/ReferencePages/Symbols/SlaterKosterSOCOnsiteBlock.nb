Cell[TextData[{
 "Includes two spin components for each orbital, giving dimension ",
 Cell[BoxData["8"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ca6dba06-6e15-7245-8ff5-a19ce3d4e026"],
 " for ",
 Cell[BoxData["\"\<sp\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d386b56a-eb67-fa47-a6f3-e63d7be9365e"],
 " and ",
 Cell[BoxData["18"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fe39b9c5-3af0-4540-9eb4-58886c036762"],
 " for ",
 Cell[BoxData["\"\<spd\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a2f82fb4-a8f8-2340-ad6f-7bba880f8a4e"],
 ". The s-orbital spin block is zero."
}], "Notes",
 CellID->1472582740,ExpressionUUID->"4c220e93-c396-6b46-bda8-4dce59f9ec37"],

Cell[TextData[{
 "The orbital ordering matches ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SlaterKosterHoppingBlock"]], 
    "paclet:TBMethod/ref/SlaterKosterHoppingBlock", "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "79b399f3-460a-d04d-add0-f4257e967291"],
 ". Each orbital is followed immediately by its two spin components."
}], "Notes",
 CellID->964407041,ExpressionUUID->"b0083592-79bf-3442-8b43-a766d116510f"],

Cell[TextData[{
 "The supplied p and d coefficients multiply explicit orbital matrices \
tensored with Pauli spin matrices. Choose the coefficients according to this \
convention when comparing with spin matrices written as ",
 Cell[BoxData[
  FormBox[
   TagBox[
    FractionBox[
     SubscriptBox["\[Sigma]", "a"], "2"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "01079c1c-4a5b-954a-9665-f3c190e45f30"],
 ", or ",
 Cell[BoxData[
  FractionBox[
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["PauliMatrix"]], "paclet:ref/PauliMatrix"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    StyleBox["a", "TI"], "]"}], "2"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cb8c8ce7-290e-1748-9f7a-15710052101c"],
 " in Wolfram Language syntax."
}], "Notes",
 CellID->1148321335,ExpressionUUID->"50eb9900-ef0a-154e-83c5-73713f6aff19"]
}, Closed]],

