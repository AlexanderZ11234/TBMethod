Cell[TextData[{
 "The real-valued ",
 Cell[BoxData[
  StyleBox["distance", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "da663054-29fc-5541-be2d-b0a198f351f7"],
 " is the site-to-adatom search radius. ",
 Cell[BoxData[
  StyleBox["selectedIndices", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "66f0175e-bf5c-4d43-ad52-b2da45b53849"],
 " is an integer or a list of integers indexing ",
 Cell[BoxData[
  StyleBox["adatomPositions", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a69dab55-07f8-ed47-9884-cdd53a44a17a"],
 "."
}], "Notes",
 CellID->518426637,ExpressionUUID->"3e24eeed-d548-6b42-9089-8d03db801f0b"],

Cell[TextData[{
 "The default labels are ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", "0"}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a9ddad2d-b099-6d42-a870-b0432ba69e80"],
 "; the default boundary condition is ",
 Cell[BoxData["\"\<PBC\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f0520330-44d9-2249-9e1f-09c65df7041a"],
 ". The value ",
 Cell[BoxData["\"\<OBC\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7558e998-8499-c340-92ca-f6a10caa3e2e"],
 " selects ordinary Euclidean matching of reference adatom positions."
}], "Notes",
 CellID->1677790818,ExpressionUUID->"eebe3b5d-a91d-884a-a359-79e4deb49dd1"],

Cell[TextData[{
 "For ",
 Cell[BoxData["\"\<PBC\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1cd885d6-0685-fc47-aea0-fdda9446854e"],
 ", reference-adatom equivalence uses fractional coordinates modulo lattice \
translations. Site neighborhoods are then found by a coordinate \
nearest-neighbor search."
}], "Notes",
 CellID->136601759,ExpressionUUID->"8437d8dd-e816-d04b-8989-fa6fb08f6b80"],

Cell[TextData[{
 "For unlabeled points, returns a list of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["label", "TI"], "\[Rule]", 
   StyleBox["coordinates", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "69583cc8-bc98-fd4e-8b7d-70a147ad9fec"],
 " rules. For existing rule labels, appends the new label to the existing \
label information."
}], "Notes",
 CellID->1498294465,ExpressionUUID->"cb0899ce-e089-e044-b8a8-2ca418c2fd2d"]
}, Closed]],

