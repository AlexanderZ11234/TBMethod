Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"$KernelCount", "\[Equal]", "0"}], ",", 
    RowBox[{"LaunchKernels", "[", "2", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ParallelNeeds", "[", "\"\<TBMethod`\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "h", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "k_", "]"}], ":=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "4."}], "-", "k"}], ",", 
      RowBox[{"-", "2."}], ",", "1.", ",", 
      RowBox[{"5.", "\[VeryThinSpace]", "+", "k"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DistributeDefinitions", "[", "h", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ParallelBandDataWithWeight", "[", 
  RowBox[{"h", ",", 
   RowBox[{"{", 
    RowBox[{"0.", ",", "0.5"}], "}"}], ",", 
   RowBox[{"Method", "\[Rule]", "\"\<Direct\>\""}]}], "]"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->1868489109,ExpressionUUID->"ccb8bdeb-9f63-484a-88d0-233ddc87008b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4.`"}], ",", "1.`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "2.`"}], ",", "1.`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1.`", ",", "1.`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"5.`", ",", "1.`"}], "}"}]}], "}"}], ",", 
