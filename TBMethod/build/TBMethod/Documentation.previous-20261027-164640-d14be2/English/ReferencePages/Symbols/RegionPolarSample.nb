Cell[TextData[{
 "The implementation uses ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PolygonCoordinates"]], "paclet:ref/PolygonCoordinates"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "57db98a5-b251-0841-80e4-b526aa13d812"],
 " and a fixed center ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0.", ",", "0."}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "47beb720-c373-744d-bc7f-50f7f6d68b37"],
 ". Use an origin-centered two-dimensional polygon whose vertices can be \
ordered by polar angle."
}], "Notes",
 CellID->724847621,ExpressionUUID->"cd952b2d-5abb-fa4c-af9c-0a27894da437"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["nRadial", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6b383b90-42a9-9c4d-b491-7a61b524fb7c"],
 " should be a positive integer and ",
 Cell[BoxData[
  StyleBox["angularScale", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f95fe059-bbda-2244-91ff-60b6b004df6c"],
 " must be positive. The origin itself is omitted."
}], "Notes",
 CellID->1496318420,ExpressionUUID->"3c250f72-59b3-dc40-9620-a2dd5f7e9463"],

Cell[TextData[{
 "The radial construction returns ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"nRadial", "+", "1"}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "d2f91cac-9987-3b4e-9a41-2f937dcfa3aa"],
 " loops: scales ",
 Cell[BoxData[
  FormBox[
   TagBox[
    FractionBox["1", "nRadial"],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "6055d077-67ed-f443-b4d6-d133cd76e37c"],
 " through ",
 Cell[BoxData[
  FormBox[
   TagBox["1",
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "08912c9a-116b-8948-89d3-c6198ef8183c"],
 ", followed by an additional outer-boundary loop. The two outer loops have \
the same radius but different sampling densities."
}], "Notes",
 CellID->814360286,ExpressionUUID->"06399598-eaac-3e40-b5ac-970022de7aeb"],

Cell[TextData[{
 "For loop index ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "83446ff0-c756-0345-8c80-68e8bef528bb"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PathSample"]], "paclet:TBMethod/ref/PathSample", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7fe42f56-1d28-204e-96b2-61a11cf81691"],
 " uses ",
 Cell[BoxData[
  RowBox[{"1", "+", 
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["Ceiling"]], "paclet:ref/Ceiling"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
