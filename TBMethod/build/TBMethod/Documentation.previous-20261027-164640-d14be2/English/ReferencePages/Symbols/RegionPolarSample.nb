Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RegionPolarSample", "[", 
   RowBox[{Cell["reg",
     FontSlant->"Italic",ExpressionUUID->
     "670f83e8-5f66-5c43-9d09-31ca036bfb48"], ",", " ", Cell[TextData[
    StyleBox["\[Rho]num",
     FontSlant->"Italic"]],ExpressionUUID->
     "487d81fe-06df-3b48-9832-120827227bb0"], ",", " ", Cell[TextData[
    StyleBox["\[Phi]rat",
     FontSlant->"Italic"]],ExpressionUUID->
     "f0a25223-224d-4a4e-85e6-7f3e02645b18"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "272c9a95-60a2-fc4c-987b-367d8d9ff92d"],
 "  samples a 2D region ",
 Cell[BoxData[Cell["reg",
   FontSlant->"Italic",ExpressionUUID->
   "34ed254b-2a9b-9b43-bb1f-e843053c1cf3"]],ExpressionUUID->
  "996ebab8-c397-6b42-9abd-0b2bac07bee4"],
 " in the polar coordinate style from its center, where ",
 Cell[BoxData[Cell[TextData[StyleBox["\[Rho]num",
   FontSlant->"Italic"]],ExpressionUUID->
   "571e2cff-9598-a54f-a5b6-0ed95e8d7b73"]],ExpressionUUID->
  "fc36fab1-2458-2d4e-9043-76f45c800a18"],
 " is the sampling number in the radial direction and ",
 Cell[BoxData[Cell[TextData[StyleBox["\[Phi]rat",
   FontSlant->"Italic"]],ExpressionUUID->
   "34dba02d-bb49-934a-bd2c-19925ca62f8c"]],ExpressionUUID->
  "d3807a8c-f114-9141-a163-eda6b4931c67"],
 " is the ratio of samplings in the azimuthal direction to the base number \
two."
}], "ExampleText",
 CellID->803019282,ExpressionUUID->"44ec91e8-6699-6c49-a6c7-88378000c3c4"],

