Cell[TextData[{
 "Every supplied displacement is included explicitly:",
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"H", "(", "k", ")"}], "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"j", "=", "1"}], "M"], 
      RowBox[{
       RowBox[{"exp", "(", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         RowBox[{
          SubscriptBox["R", "j"], ".", "k"}]}], ")"}], " ", 
       SubscriptBox["H", 
        SubscriptBox["R", "j"]]}]}]}],
    HoldForm], TraditionalForm]], "InlineMath",
  ScriptLevel->0,
  FontSize->14,
  FractionBoxOptions->{BaseStyle->{ScriptLevel -> 0}},ExpressionUUID->
  "8f826b2a-67cf-c94b-b5c9-72b0da538b59"]
}], "Notes",
 CellID->1691088016,ExpressionUUID->"abe2cb4b-bc1b-4b42-a781-73dc1f59fc37"]
}, Closed]],

