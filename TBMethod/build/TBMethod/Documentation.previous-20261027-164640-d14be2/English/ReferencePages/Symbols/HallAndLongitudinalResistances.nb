Cell["\<\
Source and drain must be the first and final leads. The source comments \
describe lead order from left to right and from top to bottom for four-, \
five-, and six-terminal layouts.\
\>", "Notes",
 CellID->2092995480,ExpressionUUID->"237f952a-7fcf-a84c-8e31-f9b9b2a1122a"],

Cell[TextData[{
 "All lead self-energies act on the final device layer. ",
 Cell[BoxData[
  RowBox[{"\"\<SigmaMode\>\"", "\[Rule]", "3"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "216c6544-6a08-1f41-bd71-ff62dcd86335"],
 " selects the algorithm used by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Sigma"]], "paclet:TBMethod/ref/Sigma", 
    "TBMethod Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4147b0c7-a834-3044-811d-f39af40d2882"],
 "."
}], "Notes",
 CellID->1203852458,ExpressionUUID->"c12f8b81-647e-0945-a20a-837cc8272995"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<SigmaTransform\>\"", "\[Rule]", 
   TemplateBox[{
     Cell[
      TextData["Identity"]], "paclet:ref/Identity"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "734e6697-e7d9-8f4f-9e32-4ad1ca455f4e"],
 " leaves the self-energy list unchanged before the Green-function \
calculation. ",
 Cell[BoxData[
  RowBox[{"\"\<GreenTransform\>\"", "\[Rule]", 
   TemplateBox[{
     Cell[
      TextData["Identity"]], "paclet:ref/Identity"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2d677442-e99b-264e-9a9c-224a866ff2f7"],
 " leaves the final diagonal Green block unchanged before evaluating \
transmissions."
}], "Notes",
 CellID->1473777614,ExpressionUUID->"2121bd2a-17a8-d249-bf60-30221dad4fd8"],

Cell[TextData[{
 "Returns ",
