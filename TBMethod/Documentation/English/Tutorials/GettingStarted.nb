  Cell["Getting Started with TBMethod", "Title", CellID -> 331033606], 
  Cell["Load the package, construct a one-orbital chain, and inspect its band \
dispersion. All examples are deliberately small and can be evaluated directly \
in this notebook.", "Text", CellID -> 1628335950], 
  Cell["Load the package", "Section", CellID -> 474455920], 
  Cell[BoxData[RowBox[{"Needs", "[", "\"TBMethod`\"", "]"}]], "Input", 
   CellID -> 316199613], Cell["Press F1 while the cursor is on an exported \
TBMethod symbol to open its reference page. Examples are ordinary evaluatable \
input cells; use Shift+Enter to run one.", "Text", CellID -> 118379117], 
  Cell["A one-dimensional Bloch Hamiltonian", "Section", 
   CellID -> 1706606336], Cell["The first association entry is the onsite \
matrix. Subsequent entries give one orientation of each hopping; HBloch adds \
its Hermitian conjugate. Use sparse matrices for the association values.", 
   "Text", CellID -> 2067035990], 
  Cell[BoxData[RowBox[{RowBox[{"hoppings", "=", 
        RowBox[{"Association", "[", RowBox[{RowBox[{RowBox[{"{", "0", "}"}], 
              "\[Rule]", RowBox[{"SparseArray", "[", RowBox[{"{", 
                  RowBox[{"{", "0.", "}"}], "}"}], "]"}]}], ",", 
            RowBox[{RowBox[{"{", "1", "}"}], "\[Rule]", RowBox[{
                "SparseArray", "[", RowBox[{"{", RowBox[{"{", RowBox[
                     {"-", "1."}], "}"}], "}"}], "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", RowBox[{"Clear", "[", "h", "]"}], ";", 
      "\[IndentingNewLine]", RowBox[{RowBox[{"h", "[", "k_", "]"}], ":=", 
        RowBox[{"HBloch", "[", RowBox[{"k", ",", "hoppings"}], "]"}]}], ";", 
      "\[IndentingNewLine]", RowBox[{"Table", "[", 
        RowBox[{RowBox[{"{", RowBox[{"k", ",", RowBox[{"Normal", "[", 
                RowBox[{"h", "[", RowBox[{"{", "k", "}"}], "]"}], "]"}]}], 
            "}"}], ",", RowBox[{"{", RowBox[{"k", ",", RowBox[{"{", 
                RowBox[{"0.", ",", FractionBox["\[Pi]", "2"], ",", "\[Pi]"}], 
                "}"}]}], "}"}]}], "]"}]}]], "Input", CellID -> 801847630], 
  Cell["Calculate and display the band", "Section", CellID -> 1890635217], 
  Cell[BoxData[RowBox[{RowBox[{"momenta", "=", 
        RowBox[{"List", "/@", RowBox[{"Subdivide", "[", 
            RowBox[{RowBox[{"-", "\[Pi]"}], ",", "\[Pi]", ",", "40"}], 
            "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"bands", "=", RowBox[{"BandData", "[", 
          RowBox[{"h", ",", "momenta"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"BandPlot", "[", RowBox[{"bands", ",", 
          RowBox[{"{", RowBox[{"\"-Pi\"", ",", "\"0\"", ",", "\"Pi\""}], 
            "}"}], ",", RowBox[{"{", RowBox[{"1", ",", "21", ",", "41"}], 
            "}"}]}], "]"}]}]], "Input", CellID -> 1386438342], 
  Cell["A central-region Green's function", "Section", CellID -> 1678588410], 
  Cell["Use a positive imaginary energy part for the retarded resolvent. \
Self-energies supplied to CentralGreen have the full central-region matrix \
dimensions.", "Text", CellID -> 1197839168], 
  Cell[BoxData[RowBox[{RowBox[{"energy", "=", 
        RowBox[{RowBox[{"0.2", "\[VeryThinSpace]"}], "+", 
          RowBox[{"0.05", " ", "\[ImaginaryI]"}]}]}], ";", 
      "\[IndentingNewLine]", RowBox[{"hCentral", "=", 
        RowBox[{"SparseArray", "[", RowBox[{"{", RowBox[
             {RowBox[{"{", RowBox[{"0.", ",", RowBox[{"-", "1."}]}], "}"}], 
              ",", RowBox[{"{", RowBox[{RowBox[{"-", "1."}], ",", "0."}], 
                "}"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"sigma", "=", RowBox[{"SparseArray", "[", 
          RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{RowBox[
                     {"-", "0.1"}], " ", "\[ImaginaryI]"}], ",", "0."}], 
                "}"}], ",", RowBox[{"{", RowBox[{"0.", ",", RowBox[
                   {RowBox[{"-", "0.1"}], " ", "\[ImaginaryI]"}]}], "}"}]}], 
            "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"g", "=", RowBox[{"CentralGreen", "[", 
          RowBox[{"energy", ",", "hCentral", ",", RowBox[{"{", "sigma", 
              "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Chop", "[", RowBox[{"Normal", "[", 
          RowBox[{"g", ".", RowBox[{"(", RowBox[{RowBox[{"energy", " ", 
                  RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "-", 
                "hCentral", "-", "sigma"}], ")"}]}], "]"}], "]"}]}]], 
   "Input", CellID -> 369644262], Cell["Parallel calculations", "Section", 
   CellID -> 1268840238], Cell["Choose a kernel count appropriate to your \
workstation. Loading the package on subkernels is required before using the \
Parallel-prefixed functions.", "Text", CellID -> 975337267], 
  Cell[BoxData[RowBox[{RowBox[{"LaunchKernels", "[", "2", "]"}], ";", 
      "\[IndentingNewLine]", RowBox[{"ParallelNeeds", "[", "\"TBMethod`\"", 
        "]"}], ";", "\[IndentingNewLine]", RowBox[{"ParallelBandData", "[", 
        RowBox[{"h", ",", "momenta"}], "]"}]}]], "Input", 
   CellID -> 141856261], 
  Cell[TextData[{ButtonBox["TBMethod function guide", BaseStyle -> "Link", 
      ButtonData -> "paclet:TBMethod/guide/TBMethod"]}], "Text", 
