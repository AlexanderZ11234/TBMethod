  Cell[CellGroupData[{Cell["DownfoldedDUp", "ObjectName", 
      CellID -> 184391470], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{RowBox[{ButtonBox["DownfoldedDUp", BaseStyle -> 
                "Link", ButtonData -> "paclet:TBMethod/ref/DownfoldedDUp"], 
              "[", StyleBox["crystal", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], "]"}], "[", StyleBox[
             "effectiveHoppings", "TI", FontFamily -> "Times", 
             FontSlant -> "Italic"], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", "returns the longest distance associated with a \
retained site-to-site block in ", Cell[BoxData[StyleBox["effectiveHoppings", 
           "TI", FontFamily -> "Times", FontSlant -> "Italic"]], 
         "InlineFormula"], ".", "\n", Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{RowBox[{ButtonBox["DownfoldedDUp", BaseStyle -> 
                "Link", ButtonData -> "paclet:TBMethod/ref/DownfoldedDUp"], 
              "[", RowBox[{StyleBox["crystal", "TI", FontFamily -> "Times", 
                 FontSlant -> "Italic"], ",", StyleBox["opts", "TI", 
                 FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}], "[", 
            StyleBox["effectiveHoppings", "TI", FontFamily -> "Times", 
             FontSlant -> "Italic"], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", "uses option settings ", 
        Cell[BoxData[StyleBox["opts", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], 
        " to determine which hopping blocks are retained."}], "Usage", 
      CellID -> 565359051], 
     Cell[TextData[{Cell[BoxData[StyleBox["crystal", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " is a nonempty association of \
cell translations with site-coordinate lists. The coordinates in its first \
cell supply the basis positions and site ordering. Labeled sites of the form \
", Cell[BoxData[RowBox[{StyleBox["label", "TI"], "\[Rule]", 
            StyleBox["position", "TI"]}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " are also accepted."}], "Notes", 
      CellID -> 802271024], 
     Cell[TextData[{Cell[BoxData[StyleBox["effectiveHoppings", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " maps \
displacement vectors to square hopping matrices. Each matrix must have equal \
internal dimension per site and a matrix size divisible by the number of \
basis sites."}], "Notes", CellID -> 1016644864], 
     Cell[TextData[{"Every supplied displacement is examined, including the \
zero displacement. The matrix is partitioned into site-to-site internal \
blocks, and only retained blocks contribute distances."}], "Notes", 
      CellID -> 1802124139], Cell[TextData[{"The string-named option ", 
        Cell[BoxData[RowBox[{"\"ZeroThreshold\"", "\[Rule]", "0.00001"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " is the default. \
A numeric block is discarded when the largest absolute value of its entries \
is less than or equal to this threshold."}], "Notes", CellID -> 427449942], 
     Cell[TextData[{"For a nonnumeric block, all entries must satisfy ", 
        Cell[BoxData[ButtonBox["PossibleZeroQ", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/PossibleZeroQ"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " for the block to be discarded. A \
symbolic entry that cannot be recognized as zero keeps its block."}], 
      "Notes", CellID -> 1180593144], 
     Cell[TextData[{"The return value is a nonnegative distance when at least \
one block is retained. An empty hopping association, or one with no retained \
blocks, returns ", Cell[BoxData[RowBox[{"-", "\[Infinity]"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 635529244], Cell[TextData[{"The current interface takes no \
original-hoppings association or original distance cutoff. It measures the \
supplied association directly, including bonds within displacement keys that \
were already present before downfolding."}], "Notes", CellID -> 1339785259], 
     Cell[TextData[{"For each retained block from site ", 
        Cell[BoxData[FormBox[TagBox["j", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], " to site ", 
        Cell[BoxData[FormBox[TagBox["i", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], 
        ", the distance uses basis-position vectors ", 
        Cell[BoxData[FormBox[TagBox[StyleBox[SubscriptBox["r", "i"], 
             FontWeight -> "Bold", FontSlant -> "Italic", StripOnInput -> 
              False], HoldForm], TraditionalForm]], "InlineMath", 
         ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], " and ", 
        Cell[BoxData[FormBox[TagBox[StyleBox[SubscriptBox["r", "j"], 
             FontWeight -> "Bold", FontSlant -> "Italic", StripOnInput -> 
              False], HoldForm], TraditionalForm]], "InlineMath", 
         ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], " and displacement ", 
        Cell[BoxData[FormBox[TagBox[StyleBox["R", FontWeight -> "Bold", 
             FontSlant -> "Italic", StripOnInput -> False], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], 
        ". The result is the maximum of these distances:", 
        "\[LineSeparator]", Cell[BoxData[FormBox[
           TagBox[RowBox[{SubscriptBox["d", RowBox[{"{", RowBox[{"i", ",", 
                   "j"}], "}"}]], "\[LongEqual]", TemplateBox[{
                RowBox[{StyleBox[SubscriptBox["r", "i"], FontWeight -> 
                    "Bold", FontSlant -> "Italic", StripOnInput -> False], 
                  "+", StyleBox["R", FontWeight -> "Bold", FontSlant -> 
                    "Italic", StripOnInput -> False], "-", StyleBox[
                   SubscriptBox["r", "j"], FontWeight -> "Bold", FontSlant -> 
                    "Italic", StripOnInput -> False]}]}, "Norm"]}], 
            HoldForm], TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FontSize -> 14, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 387888782]}, Open]], 
