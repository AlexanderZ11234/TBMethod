  Cell[CellGroupData[{Cell["ParallelHMatricesRealSpace", "ObjectName", 
      CellID -> 818824728], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["ParallelHMatricesRealSpace", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/ParallelHMatricesRealSpace"], "[", 
            RowBox[{StyleBox["crystal", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["hopping", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"], ",", 
              StyleBox["distance", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"]}], "]"}]], "InlineFormula"], " \[LineSeparator]", "\
constructs an association of hopping matrices from translated crystal cells \
to the first cell."}], "Usage", CellID -> 879804918], 
     Cell[TextData[{Cell[BoxData[StyleBox["crystal", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " is an ordered ", 
        Cell[BoxData[ButtonBox["Association", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Association"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " with entries of the form ", 
        Cell[BoxData[RowBox[{StyleBox["displacement", "TI"], "\[Rule]", 
            StyleBox["cellPoints", "TI"]}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], ". Its first value supplies the \
reference initial cell, so put the home cell first."}], "Notes", 
      CellID -> 241301547], Cell[TextData[{"The returned association \
preserves displacement keys. Each matrix has rows belonging to that cell and \
columns belonging to the reference cell."}], "Notes", CellID -> 1921691752], 
     Cell[TextData[{"Use a real-valued distance cutoff such as ", 
        Cell[BoxData["1.01"], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], "."}], "Notes", CellID -> 102348902], 
     Cell[TextData[{"Each block uses ", 
        Cell[BoxData[ButtonBox["ParallelHMatrixFromHoppings", 
           BaseStyle -> "Link", ButtonData -> 
            "paclet:TBMethod/ref/ParallelHMatrixFromHoppings"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 610009571]}, Open]], 
