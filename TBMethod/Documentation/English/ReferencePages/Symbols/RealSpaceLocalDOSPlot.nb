                  StyleBox["eigenvector", "TI", FontFamily -> "Times", 
                   FontSlant -> "Italic"]}], "}"}], ",", StyleBox["points", 
               "TI", FontFamily -> "Times", FontSlant -> "Italic"], ",", 
              StyleBox["internalDimension", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"]}], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", "sums the probabilities over ", 
        Cell[BoxData[StyleBox["internalDimension", "TI", FontFamily -> 
            "Times", FontSlant -> "Italic"]], "InlineFormula"], 
        " internal states per site.", "\n", Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["RealSpaceLocalDOSPlot", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/RealSpaceLocalDOSPlot"], "[", 
            RowBox[{RowBox[{"{", RowBox[{StyleBox["energy", "TI", 
                   FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                  StyleBox["eigenvector", "TI", FontFamily -> "Times", 
                   FontSlant -> "Italic"]}], "}"}], ",", StyleBox["points", 
               "TI", FontFamily -> "Times", FontSlant -> "Italic"], ",", 
              StyleBox["internalDimension", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["radiusScale", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", 
        "scales the displayed disk radii by ", 
        Cell[BoxData[StyleBox["radiusScale", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], "."}], "Usage", 
      CellID -> 1648503470], 
     Cell[TextData[{Cell[BoxData[StyleBox["points", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " may be plain coordinate lists or labeled coordinate rules."}], 
      "Notes", CellID -> 1586667161], 
     Cell[TextData[{"Site weights sum squared eigenvector amplitudes over \
internal states. Only weights satisfying ", 
        Cell[BoxData[FormBox[RowBox[{SubscriptBox["w", "i"], ">", 
             FractionBox["1", SuperscriptBox["10", "4"]]}], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], 
        " are retained."}], "Notes", CellID -> 427071155], 
     Cell[TextData[{"The input must satisfy ", 
        Cell[BoxData[RowBox[{RowBox[{ButtonBox["Length", BaseStyle -> "Link", 
               ButtonData -> "paclet:ref/Length"], "[", StyleBox[
               "eigenvector", "TI"], "]"}], "\[Equal]", 
            RowBox[{RowBox[{ButtonBox["Length", BaseStyle -> "Link", 
                 ButtonData -> "paclet:ref/Length"], "[", StyleBox["points", 
                 "TI"], "]"}], " ", StyleBox["internalDimension", "TI"]}]}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], ". \
Three-dimensional coordinates are projected onto the first two coordinates \
and combined by position."}], "Notes", CellID -> 1887620986], 
     Cell[TextData[
       {"The output includes a convex-hull outline and an energy label. ", 
        Cell[BoxData[StyleBox["radiusScale", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " scales disk radii."}], "Notes", 
      CellID -> 991820141], Cell[TextData[{"The defaults are ", 
        Cell[BoxData[RowBox[{StyleBox["internalDimension", "TI"], "=", 
