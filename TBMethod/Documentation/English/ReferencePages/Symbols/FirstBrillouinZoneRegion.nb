         "InlineFormula"], " through ", Cell[BoxData[StyleBox["n", "TI", 
           FontFamily -> "Times", FontSlant -> "Italic"]], "InlineFormula"], 
        "."}], "Usage", CellID -> 1623900384], 
     Cell[TextData[{Cell[BoxData[StyleBox["reciprocalBasis", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " contains \
