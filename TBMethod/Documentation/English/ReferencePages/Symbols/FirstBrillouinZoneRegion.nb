", Cell[BoxData[RowBox[{"{", RowBox[{"2", ",", "2"}], "}"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " or ", 
        Cell[BoxData[RowBox[{"{", RowBox[{"3", ",", "3"}], "}"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ". The implementation requires ", 
        Cell[BoxData[RowBox[{RowBox[{ButtonBox["Precision", BaseStyle -> 
                "Link", ButtonData -> "paclet:ref/Precision"], "[", 
              StyleBox["reciprocalBasis", "TI"], "]"}], "\[Equal]", 
            "\[Infinity]"}]], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], "."}], "Notes", CellID -> 394344956], 
     Cell[TextData[{Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " defaults to ", 
        Cell[BoxData["2"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ". Lattice points with each integer coefficient between ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{"-", "n"}], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], " and ", 
        Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " are used to construct a Voronoi mesh."}], "Notes", 
      CellID -> 644481539], Cell[TextData[{"Returns the full-dimensional mesh \
primitive whose centroid has distance less than ", 
        Cell[BoxData[FormBox[TagBox[FractionBox["1", SuperscriptBox["10", 
              "5"]], HoldForm], TraditionalForm]], "InlineMath", 
         ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], 
        " from the origin. For strongly skewed bases, increase ", 
        Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " and check that the zone has converged."}], "Notes", 
      CellID -> 397213223]}, Open]], 
