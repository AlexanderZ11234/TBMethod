     Cell[TextData[{"Uses ", Cell[BoxData[
          "CompiledFunctionTools`CompilePrint"], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " and checks whether its printed representation contains ", 
        Cell[BoxData["\"MainEvaluate\""], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        ". Load the required context with ", 
        Cell[BoxData[RowBox[{ButtonBox["Needs", BaseStyle -> "Link", 
             ButtonData -> "paclet:ref/Needs"], "[", 
            "\"CompiledFunctionTools`\"", "]"}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " before calling it."}], "Notes", 
      CellID -> 1972826901], 
     Cell[TextData[{"Echoes and returns a diagnostic string containing ", 
        Cell[BoxData[ButtonBox["True", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/True"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " or ", 
        Cell[BoxData[ButtonBox["False", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/False"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], ". The embedded Boolean reports \
whether this string-based check found no ", 
        Cell[BoxData[StyleBox["MainEvaluate", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " call; it is not a proof of numerical correctness or performance."}]\
, "Notes", CellID -> 1345322927]}, Open]], 
