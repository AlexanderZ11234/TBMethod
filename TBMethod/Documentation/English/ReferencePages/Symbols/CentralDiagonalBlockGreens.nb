             "TI"]}]], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        "."}], "Notes", CellID -> 631567139], 
     Cell[TextData[{"Given the left-connected Green blocks ", 
        Cell[BoxData[FormBox[TagBox["F", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], 
        " from the forward recursion, the backward recursion is", 
        "\[LineSeparator]", Cell[BoxData[FormBox[
           TagBox[RowBox[{SubscriptBox["G", RowBox[{"{", RowBox[{"j", ",", 
                   "j"}], "}"}]], "\[LongEqual]", RowBox[{SubscriptBox["F", 
                 "j"], "+", RowBox[{SubscriptBox["F", "j"], ".", SubscriptBox[
                   "H", RowBox[{"{", RowBox[{"j", ",", RowBox[{"j", "+", 
                         "1"}]}], "}"}]], ".", SubscriptBox["G", RowBox[
                    {"{", RowBox[{RowBox[{"j", "+", "1"}], ",", RowBox[
                        {"j", "+", "1"}]}], "}"}]], ".", SubscriptBox["H", 
                   RowBox[{"{", RowBox[{RowBox[{"j", "+", "1"}], ",", "j"}], 
                     "}"}]], ".", SubscriptBox["F", "j"]}]}]}], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, FontSize -> 14, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 1578336900]}, Open]], 
