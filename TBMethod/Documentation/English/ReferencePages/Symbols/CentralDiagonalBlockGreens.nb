               FontSlant -> "Italic"]}], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", 
        "computes all diagonal Green blocks in the original layer order.", 
        "\n", Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["CentralDiagonalBlockGreens", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/CentralDiagonalBlockGreens"], "[", 
