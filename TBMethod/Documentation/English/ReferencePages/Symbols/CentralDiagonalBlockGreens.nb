                 ButtonData -> "paclet:ref/Length"], "[", StyleBox[
                 "diagonalBlocks", "TI"], "]"}], "-", "1"}]}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 206331983], Cell[TextData[{"All self-energies act on the \
final layer. Diagonal Green blocks are returned in the original layer order."}\
], "Notes", CellID -> 1466008639], 
     Cell[TextData[{"When ", Cell[BoxData[StyleBox["upperBlocks", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " is omitted, the upper blocks are ", 
        Cell[BoxData[RowBox[{ButtonBox["ConjugateTranspose", 
