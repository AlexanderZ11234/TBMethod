  Cell[CellGroupData[{Cell["LocalCDV", "ObjectName", CellID -> 877382179], 
     Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{RowBox[{ButtonBox["LocalCDV", BaseStyle -> 
                "Link", ButtonData -> "paclet:TBMethod/ref/LocalCDV"], "[", 
              RowBox[{StyleBox["projection", "TI", FontFamily -> "Times", 
                 FontSlant -> "Italic"], ",", StyleBox["layeredPoints", "TI", 
                 FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}], "[", 
            RowBox[{StyleBox["lastColumnGreens", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["sigmas", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"], ",", 
              RowBox[{"{", RowBox[{StyleBox["diagonalBlocks", "TI", 
                   FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                  StyleBox["lowerBlocks", "TI", FontFamily -> "Times", 
                   FontSlant -> "Italic"]}], "}"}]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "computes a local \
current-density vector field from layered Green-function blocks."}], "Usage", 
      CellID -> 998420801], 
     Cell[TextData[{"Uses the reverse-ordered final Green column from ", 
        Cell[BoxData[ButtonBox["CentralBlockGreens", BaseStyle -> "Link", 
           ButtonData -> "paclet:TBMethod/ref/CentralBlockGreens"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " in ", 
        Cell[BoxData["\"LCDV\""], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], " mode. The point ", 
        Cell[BoxData[ButtonBox["Association", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Association"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " and Hamiltonian blocks use original layer order."}], "Notes", 
      CellID -> 250304435], Cell[TextData[{"Returns pairs of the form ", 
        Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["coordinate", "TI"], ",", 
              StyleBox["vector", "TI"]}], "}"}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        ". Sites with no stored current entries may be absent."}], "Notes", 
      CellID -> 1122257432], Cell[TextData[{"The internal ", 
        Cell[BoxData[StyleBox["projection", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " must match the degrees of \
freedom per site. The normalization contains ", 
        Cell[BoxData[FormBox[FractionBox["1", "\[Pi]"], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], "; no explicit charge or ", 
        Cell[BoxData[FormBox["\[HBar]", TraditionalForm]], "InlineMath", 
         ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], " factor is inserted."}], 
      "Notes", CellID -> 1998930538], 
     Cell[TextData[{"The internal coordinate helper has overlapping input \
patterns for a device containing exactly two sites. Use care with that case \
in the current implementation."}], "Notes", CellID -> 477771191], 
     Cell[TextData[{"For one scalar internal state and identity projection, \
the bond-current convention is", "\[LineSeparator]", 
        Cell[BoxData[FormBox[TagBox[RowBox[{SubscriptBox["J", RowBox[
                {"{", RowBox[{"i", ",", "j"}], "}"}]], "\[LongEqual]", 
              FractionBox[RowBox[{"Im", "(", RowBox[{SubscriptBox["H", 
                    RowBox[{"{", RowBox[{"j", ",", "i"}], "}"}]], " ", 
                   SubscriptBox[RowBox[{"G", ".", "\[CapitalGamma]", ".", 
                      TemplateBox[{"G"}, "ConjugateTranspose", SyntaxForm -> 
                        SuperscriptBox]}], RowBox[{"{", RowBox[{"i", ",", 
                        "j"}], "}"}]]}], ")"}], "\[Pi]"]}], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, FontSize -> 14, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 617921900], 
     Cell[TextData[
       {"The vector field weights each bond by its actual displacement:", 
        "\[LineSeparator]", Cell[BoxData[FormBox[
           TagBox[RowBox[{SubscriptBox["\[ScriptCapitalJ]", "i"], 
              "\[LongEqual]", RowBox[{UnderoverscriptBox["\[Sum]", 
                 RowBox[{"j", "=", "1"}], SubscriptBox["N", "S"]], 
                RowBox[{RowBox[{"(", RowBox[{SubscriptBox["r", "j"], "-", 
                      SubscriptBox["r", "i"]}], ")"}], " ", SubscriptBox["J", 
                   RowBox[{"{", RowBox[{"i", ",", "j"}], "}"}]]}]}]}], 
            HoldForm], TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FontSize -> 14, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 1430821638]}, Open]], 
