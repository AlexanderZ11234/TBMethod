  Cell[CellGroupData[{Cell["ParallelBandData", "ObjectName", 
      CellID -> 688889192], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["ParallelBandData", BaseStyle -> 
              "Link", ButtonData -> "paclet:TBMethod/ref/ParallelBandData"], 
            "[", RowBox[{StyleBox["h", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["samples", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", 
        "collects the sorted eigenvalues of ", 
        Cell[BoxData[StyleBox["h", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], " at each sample, with \
one output list per band, evaluating samples in parallel.", "\n", 
        Cell["   ", "ModInfo"], Cell[BoxData[
          RowBox[{ButtonBox["ParallelBandData", BaseStyle -> "Link", 
             ButtonData -> "paclet:TBMethod/ref/ParallelBandData"], "[", 
            RowBox[{StyleBox["h", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", StyleBox["samples", "TI", FontFamily -> 
                "Times", FontSlant -> "Italic"], ",", StyleBox["n", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "retains the ", 
        Cell[BoxData[StyleBox["n", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], 
        " eigenvalues selected by ", Cell[BoxData[ButtonBox["Eigenvalues", 
           BaseStyle -> "Link", ButtonData -> "paclet:ref/Eigenvalues"]], 
         "InlineFormula"], " at each sample.", "\n", Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["ParallelBandData", BaseStyle -> 
              "Link", ButtonData -> "paclet:TBMethod/ref/ParallelBandData"], 
            "[", RowBox[{RowBox[{"{", RowBox[{StyleBox["h", "TI", 
                   FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                  StyleBox["s", "TI", FontFamily -> "Times", FontSlant -> 
                    "Italic"]}], "}"}], ",", StyleBox["samples", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", 
        "solves the generalized eigenvalue problem for the Hamiltonian ", 
        Cell[BoxData[StyleBox["h", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], " and overlap matrix ", 
        Cell[BoxData[StyleBox["s", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], ".", "\n", 
        Cell["   ", "ModInfo"], Cell[BoxData[
          RowBox[{ButtonBox["ParallelBandData", BaseStyle -> "Link", 
             ButtonData -> "paclet:TBMethod/ref/ParallelBandData"], "[", 
            RowBox[{RowBox[{"{", RowBox[{StyleBox["h", "TI", FontFamily -> 
                    "Times", FontSlant -> "Italic"], ",", StyleBox["s", "TI", 
                   FontFamily -> "Times", FontSlant -> "Italic"]}], "}"}], 
              ",", StyleBox["samples", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["n", "TI", FontFamily -> 
                "Times", FontSlant -> "Italic"]}], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", "retains ", 
        Cell[BoxData[StyleBox["n", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], 
        " eigenvalues from each generalized eigenvalue problem."}], "Usage", 
      CellID -> 467003829], 
     Cell[TextData[{"Uses ", Cell[BoxData[ButtonBox["ParallelMap", 
           BaseStyle -> "Link", ButtonData -> "paclet:ref/ParallelMap"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " over ", 
        Cell[BoxData[StyleBox["samples", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " and otherwise follows ", 
        Cell[BoxData[ButtonBox["BandData", BaseStyle -> "Link", 
           ButtonData -> "paclet:TBMethod/ref/BandData"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], ", including its band-by-sample \
output arrangement and generalized-overlap forms."}], "Notes", 
      CellID -> 746742796], 
     Cell[TextData[{"Load TBMethod on the subkernels with ", 
        Cell[BoxData[RowBox[{ButtonBox["ParallelNeeds", BaseStyle -> "Link", 
             ButtonData -> "paclet:ref/ParallelNeeds"], "[", "\"TBMethod`\"", 
            "]"}]], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " and make any user-defined model available there."}], "Notes", 
      CellID -> 1347881072], 
     Cell[TextData[
       {"Eigenvalues are sorted independently at each sample. Options for ", 
        Cell[BoxData[ButtonBox["Eigenvalues", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Eigenvalues"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " are accepted, and ", 
        Cell[BoxData[RowBox[{ButtonBox["Method", BaseStyle -> "Link", 
             ButtonData -> "paclet:ref/Method"], "\[Rule]", "\"Direct\""}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " is supplied internally."}], "Notes", CellID -> 320157073], 
     Cell[TextData[{"The example launches two kernels only if no kernels are \
already running."}], "Notes", CellID -> 168256369]}, Open]], 
