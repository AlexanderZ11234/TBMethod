  Cell[CellGroupData[{Cell["AdaptivePartition", "ObjectName", 
      CellID -> 148279516], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["AdaptivePartition", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/AdaptivePartition"], "[", 
            RowBox[{RowBox[{"{", RowBox[{StyleBox["leadContactPoints", "TI", 
                   FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                  StyleBox["scatteringPoints", "TI", FontFamily -> "Times", 
                   FontSlant -> "Italic"]}], "}"}], ",", StyleBox["distance", 
               "TI", FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "partition a scattering \
region into layers according to distance from its lead contacts."}], "Usage", 
      CellID -> 1375695933], 
     Cell[TextData[{"Starts from scattering sites within ", 
        Cell[BoxData[StyleBox["distance", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " of ", 
        Cell[BoxData[StyleBox["leadContactPoints", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " and expands through geometric nearest-neighbor connections."}], 
      "Notes", CellID -> 161975985], 
     Cell[TextData[{"Returns an association of point lists ordered from the \
deepest reachable layer to the lead-contact layer. Preserve this order when \
constructing scattering-region blocks."}], "Notes", CellID -> 1755072335], 
     Cell[TextData[{"Only the component reachable from the lead contacts is \
included. Verify that the total returned site count equals the intended \
scattering-region site count."}], "Notes", CellID -> 753707919], 
     Cell[TextData[{"Coordinates may be labeled with ", 
        Cell[BoxData[ButtonBox["Rule", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Rule"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " expressions; the geometric search uses their coordinate values."}], 
      "Notes", CellID -> 611523879]}, Open]], 
  Cell[CellGroupData[{Cell["Examples", "PrimaryExamplesSection", 
      CellID -> 393673186], Cell[TextData[{"Layer a three-site chain starting \
from a contact adjacent to its rightmost site."}], "ExampleText", 
      CellID -> 1466152197], 
     Cell[BoxData[RowBox[{"Needs", "[", "\"TBMethod`\"", "]"}]], "Input", 
      CellID -> 736461287], Cell[CellGroupData[
