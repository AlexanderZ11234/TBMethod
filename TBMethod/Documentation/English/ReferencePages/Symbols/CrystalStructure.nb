        Cell[BoxData[ButtonBox["Association", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Association"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " with entries ", 
        Cell[BoxData[RowBox[{StyleBox["displacement", "TI"], "\[Rule]", 
            StyleBox["translatedBasis", "TI"]}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " in the supplied cell order."}], 
      "Notes", CellID -> 1895840999], 
     Cell[TextData[{Cell[BoxData[StyleBox["atomicBasis", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " may contain coordinate lists or ", 
