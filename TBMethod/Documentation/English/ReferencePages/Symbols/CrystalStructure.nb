            "[", RowBox[{StyleBox["latticeVectors", "TI", FontFamily -> 
                "Times", FontSlant -> "Italic"], ",", StyleBox["atomicBasis", 
               "TI", FontFamily -> "Times", FontSlant -> "Italic"], ",", 
              StyleBox["cellIndices", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"]}], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", "generates translated crystal cells from lattice \
