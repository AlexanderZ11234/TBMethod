      CellID -> 283329242], Cell[TextData[{"Rows of ", 
        Cell[BoxData[StyleBox["latticeVectors", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " are the real-space lattice vectors. Each cell displacement is ", 
        Cell[BoxData[RowBox[{StyleBox["cellIndex", "TI"], ".", 
            StyleBox["latticeVectors", "TI"]}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 426287070], 
     Cell[TextData[{Cell[BoxData[StyleBox["cellIndices", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " must be a list \
