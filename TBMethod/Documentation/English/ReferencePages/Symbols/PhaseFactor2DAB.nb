  Cell[CellGroupData[{Cell["PhaseFactor2DAB", "ObjectName", 
      CellID -> 902413684], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{RowBox[{ButtonBox["PhaseFactor2DAB", 
               BaseStyle -> "Link", ButtonData -> 
                "paclet:TBMethod/ref/PhaseFactor2DAB"], "[", 
              RowBox[{StyleBox["Bz", "TI", FontFamily -> "Times", 
                 FontSlant -> "Italic"], ",", StyleBox["angle", "TI", 
                 FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}], "[", 
            RowBox[{StyleBox["finalPoint", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["initialPoint", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "computes a Peierls phase for \
a perpendicular magnetic field in a gauge adapted to an in-plane translation \
direction."}], "Usage", CellID -> 1585642647], 
     Cell[TextData[{"The in-plane gauge direction is ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{"n", "\[LongEqual]", 
              RowBox[{"{", RowBox[{RowBox[{"cos", "(", "\[Alpha]", ")"}], 
                  ",", RowBox[{"sin", "(", "\[Alpha]", ")"}], ",", "0"}], 
                "}"}]}], HoldForm], TraditionalForm]], "InlineMath", 
         ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], ", where ", 
        Cell[BoxData[FormBox[TagBox["\[Alpha]", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], " is ", 
        Cell[BoxData[StyleBox["angle", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], ". Two- or three-component \
coordinates are accepted; planar points are padded with a zero third \
coordinate."}], "Notes", CellID -> 1898331836], 
     Cell[TextData[{"For final and initial endpoints ", 
        Cell[BoxData[FormBox[TagBox[SubscriptBox["r", "f"], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], " and ", 
        Cell[BoxData[FormBox[TagBox[SubscriptBox["r", "i"], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], 
        ", respectively, the phase is ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{"exp", "(", RowBox[{
                "\[ImaginaryI]", " ", "\[Pi]", " ", RowBox[
                 {RowBox[{"(", RowBox[{SubscriptBox["r", "f"], "-", 
                      SubscriptBox["r", "i"]}], ")"}], ".", "n"}], " ", 
                RowBox[{RowBox[{RowBox[{"(", RowBox[{SubscriptBox["r", "f"], 
                        "+", SubscriptBox["r", "i"]}], ")"}], "\[Cross]", 
                    RowBox[{"{", RowBox[{"0", ",", "0", ",", SubscriptBox[
                         "B", "z"]}], "}"}]}], ".", "n"}]}], ")"}], 
            HoldForm], TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], ". Inputs \
must use consistent charge, flux, and length units; no physical constants are \
inserted."}], "Notes", CellID -> 569640563], 
     Cell[TextData[
       {"Reversing the two real endpoint arguments conjugates the phase when \
", Cell[BoxData[StyleBox["Bz", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " and ", 
        Cell[BoxData[StyleBox["angle", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " are real."}], "Notes", 
      CellID -> 2037849913]}, Open]], 
