  Cell[CellGroupData[{Cell["HFloquetEffectiveBlochMatrixFromExtended", 
      "ObjectName", CellID -> 1369068275], 
     Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{RowBox[{ButtonBox[
               "HFloquetEffectiveBlochMatrixFromExtended", BaseStyle -> 
                "Link", ButtonData -> "paclet:TBMethod/ref/HFloquetEffectiveB\
lochMatrixFromExtended"], "[", RowBox[{StyleBox["omega", "TI", FontFamily -> 
                  "Times", FontSlant -> "Italic"], ",", StyleBox["m", "TI", 
                 FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}], "[", 
            StyleBox["extendedHamiltonian", "TI", FontFamily -> "Times", 
             FontSlant -> "Italic"], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", "computes a van Vleck effective Hamiltonian from \
an extended Floquet matrix."}], "Usage", CellID -> 1103981318], 
     Cell[TextData[{Cell[BoxData[StyleBox["m", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " is a nonnegative photon cutoff, with ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{RowBox[{"2", " ", "m"}], "+", 
              "1"}], HoldForm], TraditionalForm]], "InlineMath", 
         ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], " photon states for every \
internal state. The matrix uses internal-major, photon-minor ordering."}], 
      "Notes", CellID -> 1905633193], 
     Cell[TextData[{"Extracts harmonics through order ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{"2", " ", "m"}], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], " from the \
extended matrix. The zero harmonic is the central photon diagonal block."}], 
      "Notes", CellID -> 1537857241], 
     Cell[TextData[{"The option ", Cell[BoxData["\"ExpansionOrder\""], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " defaults to ", 
        Cell[BoxData["1"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " and accepts ", Cell[BoxData["1"], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " or ", Cell[BoxData["2"], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], ". The option ", 
        Cell[BoxData["\"ReturnComponents\""], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " defaults to ", 
        Cell[BoxData[ButtonBox["False", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/False"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], "; ", 
        Cell[BoxData[ButtonBox["True", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/True"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " returns an association with keys ", Cell[BoxData["\"Order0\""], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " and ", 
        Cell[BoxData["\"Order1\""], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], ", and, at second order, ", 
        Cell[BoxData["\"Order2Pure\""], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " and ", 
        Cell[BoxData["\"Order2Mixed\""], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 1597340439], 
     Cell[TextData[{"The expansion contains denominators ", 
        Cell[BoxData[FormBox[TagBox["\[Omega]", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], " and ", 
        Cell[BoxData[FormBox[TagBox[SuperscriptBox["\[Omega]", "2"], 
            HoldForm], TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], ", so ", 
        Cell[BoxData[StyleBox["omega", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " must be nonzero. This \
high-frequency approximation requires physical convergence checks for the \
chosen driven model."}], "Notes", CellID -> 174682120], 
     Cell[TextData[
       {"At first order, the implemented high-frequency expansion is", 
        "\[LineSeparator]", Cell[BoxData[FormBox[
           TagBox[RowBox[{SubscriptBox["H", "eff"], "\[LongEqual]", 
              RowBox[{SubscriptBox["H", "0"], "+", RowBox[{UnderoverscriptBox[
                   "\[Sum]", RowBox[{"l", "=", "1"}], SubscriptBox["l", 
                    "max"]], FractionBox[RowBox[{RowBox[{SubscriptBox["H", 
                        RowBox[{"-", "l"}]], ".", SubscriptBox["H", "l"]}], 
                     "-", RowBox[{SubscriptBox["H", "l"], ".", SubscriptBox[
                        "H", RowBox[{"-", "l"}]]}]}], RowBox[{"l", " ", 
                     "\[Omega]"}]]}]}]}], HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FontSize -> 14, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 956325310]}, Open]], 
  Cell[CellGroupData[{Cell["Examples", "PrimaryExamplesSection", 
      CellID -> 666545439], Cell[TextData[{"An undriven two-level Hamiltonian \
is recovered from its three-sector Floquet representation."}], "ExampleText", 
