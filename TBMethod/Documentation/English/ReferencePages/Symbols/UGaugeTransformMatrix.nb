     Cell[TextData[{Cell[BoxData[StyleBox["points", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " contains two-dimensional coordinate lists or rules of the form ", 
        Cell[BoxData[RowBox[{StyleBox["label", "TI"], "\[Rule]", 
            StyleBox["coordinates", "TI"]}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        ". Each site phase is tensored with the internal identity matrix."}], 
      "Notes", CellID -> 1351751408], 
     Cell[TextData[{"The site phase is ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{"exp", "(", RowBox[{
                "\[ImaginaryI]", " ", RowBox[{"\[Chi]", "(", RowBox[
                   {"x", ",", "y"}], ")"}]}], ")"}], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], ", with ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{RowBox[{"\[Chi]", "(", 
                RowBox[{"x", ",", "y"}], ")"}], "\[LongEqual]", 
              RowBox[{"2", " ", "\[Pi]", " ", "B", " ", RowBox[
                 {"(", RowBox[{RowBox[{"x", " ", "y", " ", RowBox[
                       {SuperscriptBox["sin", "2"], "(", "\[Alpha]", ")"}]}], 
                    "+", RowBox[{FractionBox["1", "4"], " ", RowBox[
                       {"(", RowBox[{SuperscriptBox["x", "2"], "-", 
                          SuperscriptBox["y", "2"]}], ")"}], " ", RowBox[
                       {"sin", "(", RowBox[{"2", " ", "\[Alpha]"}], 
                        ")"}]}]}], ")"}]}]}], HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], ", where ", 
        Cell[BoxData[FormBox[TagBox["\[Alpha]", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], " is ", 
        Cell[BoxData[StyleBox["angle", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 1754560481], Cell[TextData[{"The result uses site-major \
ordering, with the internal degrees of freedom contiguous at each site."}], 
      "Notes", CellID -> 2052677712]}, Open]], 
