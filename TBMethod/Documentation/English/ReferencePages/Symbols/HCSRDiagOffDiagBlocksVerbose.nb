           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], 
        ". Nonadjacent-layer couplings are not included."}], "Notes", 
      CellID -> 1584242267], Cell[TextData[{"For a single layer, this \
