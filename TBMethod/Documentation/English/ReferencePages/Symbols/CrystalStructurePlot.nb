  Cell[CellGroupData[{Cell["CrystalStructurePlot", "ObjectName", 
      CellID -> 487323491], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["CrystalStructurePlot", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/CrystalStructurePlot"], "[", 
            RowBox[{StyleBox["latticeVectors", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["crystalStructure", 
               "TI", FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "displays ", 
        Cell[BoxData[StyleBox["crystalStructure", "TI", FontFamily -> 
            "Times", FontSlant -> "Italic"]], "InlineFormula"], 
        " together with its lattice vectors and Voronoi-cell outlines.", 
        "\n", Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["CrystalStructurePlot", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/CrystalStructurePlot"], "[", 
            RowBox[{StyleBox["latticeVectors", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["crystalStructure", 
               "TI", FontFamily -> "Times", FontSlant -> "Italic"], ",", 
              StyleBox["cellRange", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"]}], "]"}]], "InlineFormula"], " \[LineSeparator]", 
        "uses the specified range of surrounding lattice cells.", "\n", 
        Cell["   ", "ModInfo"], Cell[BoxData[
          RowBox[{ButtonBox["CrystalStructurePlot", BaseStyle -> "Link", 
             ButtonData -> "paclet:TBMethod/ref/CrystalStructurePlot"], "[", 
            RowBox[{StyleBox["latticeVectors", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["crystalStructure", 
               "TI", FontFamily -> "Times", FontSlant -> "Italic"], ",", 
              StyleBox["cellRange", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", StyleBox["cellType", "TI", FontFamily -> 
                "Times", FontSlant -> "Italic"]}], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", 
        "uses Voronoi cells or basis parallelepipeds according to ", 
        Cell[BoxData[StyleBox["cellType", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], "."}], "Usage", 
      CellID -> 279458002], 
     Cell[TextData[{Cell[BoxData[StyleBox["latticeVectors", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " must have dimensions ", 
        Cell[BoxData[RowBox[{"{", RowBox[{"2", ",", "2"}], "}"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " or ", 
        Cell[BoxData[RowBox[{"{", RowBox[{"3", ",", "3"}], "}"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ", with lattice vectors as rows."}], "Notes", CellID -> 1515166452], 
     Cell[TextData[{Cell[BoxData[StyleBox["crystalStructure", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " is an ", 
        Cell[BoxData[ButtonBox["Association", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Association"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " from lattice translation vectors to site lists, as returned by ", 
        Cell[BoxData[ButtonBox["CrystalStructure", BaseStyle -> "Link", 
           ButtonData -> "paclet:TBMethod/ref/CrystalStructure"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ". Labeled site rules are accepted."}], "Notes", 
      CellID -> 1784921507], 
     Cell[TextData[{Cell[BoxData[StyleBox["cellType", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " is ", 
        Cell[BoxData["\"Voronoi\""], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], " by default; ", Cell[BoxData["\"Unit\""], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " selects parallelepiped unit cells. ", 
        Cell[BoxData[StyleBox["cellRange", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " defaults to ", 
        Cell[BoxData["2"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " and controls the surrounding lattice used for cell outlines."}], 
      "Notes", CellID -> 2097549534], 
     Cell[TextData[{"Options are filtered separately for ", 
        Cell[BoxData[ButtonBox["ListPlot", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/ListPlot"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " or ", 
        Cell[BoxData[ButtonBox["ListPointPlot3D", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/ListPointPlot3D"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], ", for ", 
        Cell[BoxData[ButtonBox["Graphics", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Graphics"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " or ", 
        Cell[BoxData[ButtonBox["Graphics3D", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Graphics3D"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], ", and for ", 
        Cell[BoxData[ButtonBox["Show", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Show"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 714410740]}, Open]], 
