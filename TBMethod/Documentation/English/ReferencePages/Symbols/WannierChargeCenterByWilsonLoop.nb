  Cell[CellGroupData[{Cell["WannierChargeCenterByWilsonLoop", "ObjectName", 
      CellID -> 1046194512], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["WannierChargeCenterByWilsonLoop", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/WannierChargeCenterByWilsonLoop"], "[", 
            RowBox[{StyleBox["h", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", StyleBox["momenta", "TI", FontFamily -> 
                "Times", FontSlant -> "Italic"], ",", StyleBox["nOccupied", 
               "TI", FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "computes occupied-subspace \
Wilson-loop eigenphases along a closed momentum path."}], "Usage", 
      CellID -> 732761466], 
     Cell[TextData[{Cell[BoxData[RowBox[{StyleBox["h", "TI"], "[", 
            StyleBox["k", "TI"], "]"}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " returns a Hermitian Hamiltonian. The ", 
        Cell[BoxData[StyleBox["nOccupied", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " lowest-energy eigenstates are \
retained after sorting at each sample."}], "Notes", CellID -> 685223655], 
     Cell[TextData[{"The path is closed internally by connecting the final \
occupied subspace back to the first; a repeated endpoint is optional."}], 
      "Notes", CellID -> 562497456], 
     Cell[TextData[{"The package multiplies eigenphases by ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{"-", FractionBox["1", "\[Pi]"]}], 
            HoldForm], TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], ", as \
shown below. This differs by a factor of two from conventions expressed in \
units of ", Cell[BoxData[FormBox[TagBox[RowBox[{"2", " ", "\[Pi]"}], 
            HoldForm], TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], "."}], 
      "Notes", CellID -> 1620805162], 
     Cell[TextData[{"A separated occupied subspace and a sufficiently dense \
path are needed for a stable result."}], "Notes", CellID -> 1674627728], 
     Cell[TextData[{"Options for ", Cell[BoxData[ButtonBox["Eigensystem", 
           BaseStyle -> "Link", ButtonData -> "paclet:ref/Eigensystem"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " are accepted, with ", Cell[BoxData[
          RowBox[{ButtonBox["Method", BaseStyle -> "Link", ButtonData -> 
              "paclet:ref/Method"], "\[Rule]", "\"Direct\""}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " supplied internally."}], "Notes", CellID -> 2042240001], 
     Cell[TextData[{"If the eigenvalues of the occupied-subspace Wilson \
product are denoted by ", Cell[BoxData[FormBox[TagBox["\[Lambda]", HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], 
        ", the normalization used here is", "\[LineSeparator]", 
        Cell[BoxData[FormBox[TagBox[RowBox[{SubscriptBox["\[Nu]", "j"], 
              "\[LongEqual]", RowBox[{"-", FractionBox[RowBox[{"arg", "(", 
                   RowBox[{SubscriptBox["\[Lambda]", "j"], "(", "W", ")"}], 
                   ")"}], "\[Pi]"]}]}], HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FontSize -> 14, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 1768337914]}, Open]], 
  Cell[CellGroupData[{Cell["Examples", "PrimaryExamplesSection", 
