  Cell[CellGroupData[{Cell["LocalBandGap", "ObjectName", 
      CellID -> 242087250], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["LocalBandGap", BaseStyle -> "Link", 
             ButtonData -> "paclet:TBMethod/ref/LocalBandGap"], "[", 
            RowBox[{StyleBox["h", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", StyleBox["samples", "TI", FontFamily -> 
                "Times", FontSlant -> "Italic"], ",", StyleBox["n", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "returns the smallest direct \
gap between bands n and n+1 over a finite sample set."}], "Usage", 
      CellID -> 117932486], 
     Cell[TextData[{Cell[BoxData[StyleBox["samples", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " must be a nonempty list of real \
scalar values or real coordinate lists, matching ", 
        Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"(", RowBox[
                 {RowBox[{"{", "__Real", "}"}], "|", "_Real"}], ")"}], 
              ".."}], "}"}]], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], 
        ". Exact integer samples do not match this input pattern."}], 
      "Notes", CellID -> 1255766907], 
     Cell[TextData[{"At each sample, the full eigenvalue list is sorted \
before the adjacent-band difference is formed. ", 
        Cell[BoxData[ButtonBox["Chop", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Chop"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " is applied to numerical residues."}], "Notes", 
      CellID -> 1922543684], 
     Cell[TextData[{Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " must satisfy ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{"1", "\[LessEqual]", "n", "<", 
              "dim"}], HoldForm], TraditionalForm]], "InlineMath", 
         ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], ", where ", 
        Cell[BoxData[StyleBox["dim", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " is the Hamiltonian matrix dimension."}], "Notes", 
      CellID -> 364713176], 
     Cell[TextData[
       {"This is an estimate over the supplied sample points. Options for ", 
        Cell[BoxData[ButtonBox["Eigenvalues", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Eigenvalues"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " are accepted, with ", 
        Cell[BoxData[RowBox[{ButtonBox["Method", BaseStyle -> "Link", 
             ButtonData -> "paclet:ref/Method"], "\[Rule]", "\"Direct\""}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " supplied internally."}], "Notes", CellID -> 1925145700], 
     Cell[TextData[{"For the supplied sample set, the direct gap is", 
        "\[LineSeparator]", Cell[BoxData[FormBox[
           TagBox[RowBox[{SubscriptBox["\[CapitalDelta]", "direct"], 
              "\[LongEqual]", RowBox[{SubscriptBox["Min", RowBox[
                  {"k", "\[Element]", "\[ScriptCapitalK]"}]], "(", 
                RowBox[{RowBox[{SubscriptBox["\[ExponentialE]", RowBox[
                      {"n", "+", "1"}]], "(", "k", ")"}], "-", RowBox[
                   {SubscriptBox["\[ExponentialE]", "n"], "(", "k", ")"}]}], 
                ")"}]}], HoldForm], TraditionalForm]], "InlineMath", 
         ScriptLevel -> 0, FontSize -> 14, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 2076599254]}, Open]], 
  Cell[CellGroupData[{Cell["Examples", "PrimaryExamplesSection", 
      CellID -> 1054220022], Cell[TextData[{"A common scalar energy shift \
leaves the direct two-band gap equal to two."}], "ExampleText", 
