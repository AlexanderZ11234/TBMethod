  Cell[CellGroupData[{Cell["HallAndLongitudinalResistances", "ObjectName", 
      CellID -> 455319175], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["HallAndLongitudinalResistances", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/HallAndLongitudinalResistances"], "[", 
            RowBox[{StyleBox["z", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", StyleBox["deviceBlocks", "TI", FontFamily -> 
                "Times", FontSlant -> "Italic"], ",", StyleBox["leadBlocks", 
               "TI", FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "computes transverse and \
longitudinal resistances for the supported multiterminal ordering."}], 
      "Usage", CellID -> 674202405], 
     Cell[TextData[{"Source and drain must be the first and final leads. The \
source comments describe lead order from left to right and from top to bottom \
for four-, five-, and six-terminal layouts."}], "Notes", 
      CellID -> 2092995480], 
     Cell[TextData[{"All lead self-energies act on the final device layer. ", 
        Cell[BoxData[RowBox[{"\"SigmaMode\"", "\[Rule]", "3"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " selects the algorithm used by ", 
        Cell[BoxData[ButtonBox["Sigma", BaseStyle -> "Link", 
           ButtonData -> "paclet:TBMethod/ref/Sigma"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 1203852458], 
     Cell[TextData[{Cell[BoxData[RowBox[{"\"SigmaTransform\"", "\[Rule]", 
            ButtonBox["Identity", BaseStyle -> "Link", ButtonData -> 
              "paclet:ref/Identity"]}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " leaves the self-energy list \
unchanged before the Green-function calculation. ", 
        Cell[BoxData[RowBox[{"\"GreenTransform\"", "\[Rule]", 
            ButtonBox["Identity", BaseStyle -> "Link", ButtonData -> 
              "paclet:ref/Identity"]}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " leaves the final diagonal Green \
block unchanged before evaluating transmissions."}], "Notes", 
      CellID -> 1473777614], Cell[TextData[{"Returns ", 
        Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["RH", "TI"], ",", 
              StyleBox["RL", "TI"]}], "}"}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], ". The implementation returns ", 
        Cell[BoxData[RowBox[{"{", RowBox[{"\"NaN\"", ",", "\"NaN\""}], 
            "}"}]], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " when its condition estimate exceeds ", 
        Cell[BoxData[FormBox[SuperscriptBox["10", "7"], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], "."}], "Notes", 
      CellID -> 1213864026], Cell[TextData[{"The implementation reads ", 
        Cell[BoxData[RowBox[{RowBox[{ButtonBox["LUDecomposition", 
               BaseStyle -> "Link", ButtonData -> 
                "paclet:ref/LUDecomposition"], "[", StyleBox["matrix", "TI"], 
              "]"}], "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], ". Compatibility \
with kernels returning a three-part decomposition must be checked. The \
example is a small ring fixture rather than a realistic Hall-bar geometry."}]\
, "Notes", CellID -> 1735016971]}, Open]], 
  Cell[CellGroupData[{Cell["Examples", "PrimaryExamplesSection", 
      CellID -> 1678346189], 
     Cell[TextData[
       {
        "Compute the resistance pair for a small five-contact ring fixture."}]\
, "ExampleText", CellID -> 782591439], 
     Cell[BoxData[RowBox[{"Needs", "[", "\"TBMethod`\"", "]"}]], "Input", 
      CellID -> 1045856795], Cell[CellGroupData[
       {Cell[BoxData[RowBox[{RowBox[{"z", "=", RowBox[{RowBox[{"0.2", 
                  "\[VeryThinSpace]"}], "+", RowBox[{"0.01", " ", 
                  "\[ImaginaryI]"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"hRing", "=", RowBox[{"Table", "[", RowBox[
                 {RowBox[{"Which", "[", RowBox[{RowBox[{RowBox[{"Mod", "[", 
                          RowBox[{RowBox[{"i", "-", "j"}], ",", "5"}], "]"}], 
                        "\[Equal]", "1"}], ",", RowBox[{"-", RowBox[{"Exp", 
                          "[", RowBox[{"0.2", " ", "\[ImaginaryI]"}], 
                          "]"}]}], ",", RowBox[{RowBox[{"Mod", "[", RowBox[
                          {RowBox[{"j", "-", "i"}], ",", "5"}], "]"}], 
                        "\[Equal]", "1"}], ",", RowBox[{"-", RowBox[{"Exp", 
                          "[", RowBox[{RowBox[{"-", "0.2"}], " ", 
                          "\[ImaginaryI]"}], "]"}]}], ",", "True", ",", 
                      "0."}], "]"}], ",", RowBox[{"{", RowBox[{"i", ",", 
                      "5"}], "}"}], ",", RowBox[{"{", RowBox[{"j", ",", 
                      "5"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"blocks", "=", RowBox[{"{", RowBox[{RowBox[{"{", 
                    RowBox[{"hRing", ",", "hRing"}], "}"}], ",", 
                  RowBox[{"{", RowBox[{RowBox[{"-", "0.3"}], " ", RowBox[
                       {"IdentityMatrix", "[", "5", "]"}]}], "}"}]}], 
                "}"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"leads", "=", RowBox[{"Table", "[", RowBox[
                 {RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"{", "0.", "}"}], 
                        "}"}], ",", RowBox[{"{", RowBox[{"{", RowBox[{"-", 
                          "1."}], "}"}], "}"}], ",", RowBox[{"List", "/@", 
                        RowBox[{"(", RowBox[{RowBox[{"-", "0.5"}], " ", 
                          RowBox[{"UnitVector", "[", RowBox[{"5", ",", "j"}], 
                          "]"}]}], ")"}]}]}], "}"}], ",", RowBox[
                   {"{", RowBox[{"j", ",", "5"}], "}"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", RowBox[{"HallAndLongitudinalResistances", 
              "[", RowBox[{"z", ",", "blocks", ",", "leads", ",", 
