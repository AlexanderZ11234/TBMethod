  Cell[CellGroupData[{Cell["HEffectiveMatrix", "ObjectName", 
      CellID -> 291803092], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["HEffectiveMatrix", BaseStyle -> 
              "Link", ButtonData -> "paclet:TBMethod/ref/HEffectiveMatrix"], 
            "[", RowBox[{StyleBox["h", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["deltaK", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"], ",", 
              StyleBox["k0", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", StyleBox["dimensions", "TI", FontFamily -> 
                "Times", FontSlant -> "Italic"]}], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", 
        "returns the first-order Taylor approximation of ", 
        Cell[BoxData[StyleBox["h", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], " about ", 
        Cell[BoxData[StyleBox["k0", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], 
        " as Pauli/Gell-Mann coefficients.", "\n", Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["HEffectiveMatrix", BaseStyle -> 
              "Link", ButtonData -> "paclet:TBMethod/ref/HEffectiveMatrix"], 
            "[", RowBox[{StyleBox["h", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["deltaK", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"], ",", 
              StyleBox["k0", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", StyleBox["dimensions", "TI", FontFamily -> 
                "Times", FontSlant -> "Italic"], ",", StyleBox["order", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "retains terms through the \
specified Taylor order in the momentum increment ", 
        Cell[BoxData[StyleBox["deltaK", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], "."}], "Usage", 
      CellID -> 1658988633], Cell[TextData[{"Expands ", 
        Cell[BoxData[RowBox[{StyleBox["h", "TI"], "[", 
            RowBox[{RowBox[{StyleBox["s", "TI"], " ", StyleBox["deltaK", 
                 "TI"]}], "+", StyleBox["k0", "TI"]}], "]"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " in the single scale parameter ", 
        Cell[BoxData[FormBox[TagBox["s", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], 
        " through the requested total order, then applies ", 
        Cell[BoxData[RowBox[{StyleBox["s", "TI"], "\[Rule]", "1"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ". The default order is ", Cell[BoxData["1"], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 1781316908], 
     Cell[TextData[{Cell[BoxData[StyleBox["dimensions", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " is the ordered list of internal factors, each ", 
        Cell[BoxData["2"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " or ", Cell[BoxData["3"], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], ", required by ", 
        Cell[BoxData[ButtonBox["PauliGellMannDecomposition", 
           BaseStyle -> "Link", ButtonData -> 
            "paclet:TBMethod/ref/PauliGellMannDecomposition"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], ". Returns a \
coefficient association rather than the effective matrix itself."}], "Notes", 
      CellID -> 925556770], Cell[TextData[{"Applies ", 
        Cell[BoxData[ButtonBox["ComplexExpand", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/ComplexExpand"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        ", so symbolic momentum components are treated as real. Use ", 
        Cell[BoxData[ButtonBox["PauliGellMannAbstract", BaseStyle -> "Link", 
           ButtonData -> "paclet:TBMethod/ref/PauliGellMannAbstract"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " and ", 
