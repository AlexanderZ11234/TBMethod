  Cell[CellGroupData[{Cell["RibbonBulkBoundaryOperator", "ObjectName", 
      CellID -> 841952245], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["RibbonBulkBoundaryOperator", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/RibbonBulkBoundaryOperator"], "[", 
            RowBox[{StyleBox["points", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["normalVector", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "constructs a diagonal \
operator measuring signed transverse position in a ribbon with two internal \
states per site.", "\n", Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["RibbonBulkBoundaryOperator", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/RibbonBulkBoundaryOperator"], "[", 
            RowBox[{StyleBox["points", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["normalVector", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"], ",", 
              StyleBox["internalDimension", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"]}], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", "uses ", 
        Cell[BoxData[StyleBox["internalDimension", "TI", FontFamily -> 
            "Times", FontSlant -> "Italic"]], "InlineFormula"], 
        " internal states per site.", "\n", Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["RibbonBulkBoundaryOperator", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/RibbonBulkBoundaryOperator"], "[", 
            RowBox[{StyleBox["points", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["normalVector", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"], ",", 
              StyleBox["internalDimension", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["power", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", 
        "raises the magnitude of the rescaled transverse coordinate to ", 
        Cell[BoxData[StyleBox["power", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], 
        " while preserving its sign."}], "Usage", CellID -> 855560201], 
     Cell[TextData[{"Projects site coordinates onto the normalized ", 
        Cell[BoxData[StyleBox["normalVector", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        ", rescales the projected coordinates to ", 
        Cell[BoxData[FormBox[RowBox[{RowBox[{"-", "1"}], "\[LessEqual]", "x", 
             "\[LessEqual]", "1"}], TraditionalForm]], "InlineMath", 
         ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], ", and applies ", 
        Cell[BoxData[FormBox[RowBox[{TemplateBox[{"x"}, "Sign"], " ", 
             SuperscriptBox[TemplateBox[{"x"}, "Abs"], "power"]}], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], "."}], 
      "Notes", CellID -> 1118673121], 
     Cell[TextData[{"Repeats each diagonal weight ", 
        Cell[BoxData[StyleBox["internalDimension", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " times and returns a ", 
        Cell[BoxData[ButtonBox["SparseArray", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/SparseArray"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " matrix."}], "Notes", 
      CellID -> 1251119685], Cell[TextData[{"Points may carry labels. The \
normal vector must be nonzero, and projected coordinates must span a nonzero \
range."}], "Notes", CellID -> 1548334420], 
     Cell[TextData[{"Opposite edges receive opposite signs; cancellation can \
occur for a state occupying both edges equally."}], "Notes", 
      CellID -> 1757527947]}, Open]], 
