     Cell[TextData[{"For scalar modulation, the photon-space matrix entries \
follow the Fourier convention", "\[LineSeparator]", 
        Cell[BoxData[FormBox[TagBox[RowBox[{SubscriptBox["A", RowBox[
                {"{", RowBox[{"m", ",", "n"}], "}"}]], "\[LongEqual]", 
              FractionBox[RowBox[{SubsuperscriptBox["\[Integral]", 
                  RowBox[{"-", "\[Pi]"}], "\[Pi]"], RowBox[
                  {RowBox[{RowBox[{"f", "(", "\[Phi]", ")"}], " ", RowBox[
                      {"exp", "(", RowBox[{"\[ImaginaryI]", " ", RowBox[
                          {"(", RowBox[{"m", "-", "n"}], ")"}], " ", 
                         "\[Phi]"}], ")"}]}], RowBox[{"\[DifferentialD]", 
                     "\[Phi]"}]}]}], RowBox[{"2", " ", "\[Pi]"}]]}], 
            HoldForm], TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FontSize -> 14, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 1605166728], 
     Cell[TextData[{"The additional photon-energy diagonal has entries", 
        "\[LineSeparator]", Cell[BoxData[FormBox[
           TagBox[RowBox[{SubscriptBox["D", RowBox[{"{", RowBox[{"m", ",", 
                   "n"}], "}"}]], "\[LongEqual]", RowBox[{RowBox[{"-", "m"}], 
                " ", "\[Omega]", " ", TemplateBox[{RowBox[{"m", ",", "n"}]}, 
                 "KroneckerDeltaSeq"]}]}], HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FontSize -> 14, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 1395370047]}, Open]], 
