         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], "."}], 
      "Notes", CellID -> 1945641892], 
     Cell[TextData[{"For distinct sites, returns ", 
        Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["fourierModulationMatrix", 
               "TI"], ",", StyleBox["zeroMatrix", "TI"]}], "}"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ". For coincident sites, returns ", 
        Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["identityMatrix", "TI"], 
              ",", RowBox[{StyleBox["fourierModulationMatrix", "TI"], "-", 
                RowBox[{StyleBox["omega", "TI"], " ", RowBox[{ButtonBox[
                     "DiagonalMatrix", BaseStyle -> "Link", ButtonData -> 
                      "paclet:ref/DiagonalMatrix"], "[", RowBox[
                     {ButtonBox["Range", BaseStyle -> "Link", ButtonData -> 
                        "paclet:ref/Range"], "[", RowBox[{RowBox[{"-", 
                          StyleBox["m", "TI"]}], ",", StyleBox["m", "TI"]}], 
                      "]"}], "]"}]}]}]}], "}"}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        ". Coincidence uses a distance threshold of ", 
        Cell[BoxData["0.00001"], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], "."}], "Notes", CellID -> 183868259], 
     Cell[TextData[{"The matrix entry with photon indices ", 
        Cell[BoxData[FormBox[TagBox["p", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], " and ", 
        Cell[BoxData[FormBox[TagBox["q", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], 
        " uses the Fourier coefficient at ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{"q", "-", "p"}], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], 
        ". On nonzero-length bonds the vector-potential forms use ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{"exp", "(", RowBox[{
                "\[ImaginaryI]", " ", "A", " ", RowBox[{RowBox[{"(", 
                    RowBox[{SubscriptBox["r", "f"], "-", SubscriptBox["r", 
                       "i"]}], ")"}], ".", RowBox[{"a", "(", "\[Phi]", 
                    ")"}]}]}], ")"}], HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], ", where ", 
        Cell[BoxData[FormBox[TagBox["A", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], " is ", 
        Cell[BoxData[StyleBox["amplitude", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " and ", 
