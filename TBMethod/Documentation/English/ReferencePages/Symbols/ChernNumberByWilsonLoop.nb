  Cell[CellGroupData[{Cell["ChernNumberByWilsonLoop", "ObjectName", 
      CellID -> 622333116], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["ChernNumberByWilsonLoop", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/ChernNumberByWilsonLoop"], "[", 
            RowBox[{StyleBox["h", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", RowBox[{"{", RowBox[{StyleBox["momenta", 
                   "TI", FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                  StyleBox["plaquettePositions", "TI", FontFamily -> "Times", 
                   FontSlant -> "Italic"]}], "}"}], ",", StyleBox[
               "nOccupied", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"]}], "]"}]], "InlineFormula"], " \[LineSeparator]", "\
sums determinant phases of occupied-state Wilson loops over oriented \
momentum-space plaquettes."}], "Usage", CellID -> 878531362], 
     Cell[TextData[{Cell[BoxData[RowBox[{StyleBox["h", "TI"], "[", 
            StyleBox["k", "TI"], "]"}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " returns a Hermitian Hamiltonian. The positive integer ", 
        Cell[BoxData[StyleBox["nOccupied", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " selects its lowest-energy eigenstates after sorting."}], "Notes", 
      CellID -> 1918164110], 
     Cell[TextData[{"The second argument has the form returned by ", 
        Cell[BoxData[ButtonBox["PlaquetteRegionPartitionComplex", 
           BaseStyle -> "Link", ButtonData -> 
            "paclet:TBMethod/ref/PlaquetteRegionPartitionComplex"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ". Each plaquette selector is an ", 
        Cell[BoxData[ButtonBox["Extract", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Extract"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " position for its ordered vertex \
states; a triangle with vertex indices ", Cell[BoxData[StyleBox["i", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], ", ", 
        Cell[BoxData[StyleBox["j", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], ", and ", 
        Cell[BoxData[StyleBox["k", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " uses ", 
        Cell[BoxData[RowBox[{"{", RowBox[{"{", RowBox[{StyleBox["i", "TI"], 
                ",", StyleBox["j", "TI"], ",", StyleBox["k", "TI"]}], "}"}], 
            "}"}]], "InlineFormula", FontFamily -> "Source Sans Pro"], "."}], 
      "Notes", CellID -> 438364596], 
     Cell[TextData[{"Each plaquette loop is closed internally. Its \
orientation affects the determinant phase and the sign of the returned sum."}]\
, "Notes", CellID -> 277435572], Cell[TextData[{"A meaningful Chern estimate \
requires a consistent oriented covering of the relevant closed momentum space \
and a separated occupied subspace. The function does not validate \
orientation, convergence, or integrality."}], "Notes", CellID -> 1233611759], 
     Cell[TextData[{"Options for ", Cell[BoxData[ButtonBox["Eigensystem", 
           BaseStyle -> "Link", ButtonData -> "paclet:ref/Eigensystem"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " are accepted, with ", Cell[BoxData[
          RowBox[{ButtonBox["Method", BaseStyle -> "Link", ButtonData -> 
              "paclet:ref/Method"], "\[Rule]", "\"Direct\""}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " supplied internally."}], "Notes", CellID -> 859100748], 
     Cell[TextData[{"For each oriented plaquette, let ", 
        Cell[BoxData[FormBox[TagBox["W", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], " denote the ordered product of \
occupied-state overlap matrices. The returned sum is", "\[LineSeparator]", 
        Cell[BoxData[FormBox[TagBox[RowBox[{"C", "\[LongEqual]", 
              RowBox[{"-", FractionBox[RowBox[{UnderoverscriptBox["\[Sum]", 
                    RowBox[{"p", "=", "1"}], SubscriptBox["N", "P"]], 
                   RowBox[{"arg", "(", TemplateBox[{SubscriptBox["W", "p"]}, 
                      "Det"], ")"}]}], RowBox[{"2", " ", "\[Pi]"}]]}]}], 
            HoldForm], TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FontSize -> 14, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 514161825]}, Open]], 
  Cell[CellGroupData[{Cell["Examples", "PrimaryExamplesSection", 
