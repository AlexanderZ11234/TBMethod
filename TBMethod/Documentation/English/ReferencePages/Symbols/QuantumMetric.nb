             FontFamily -> "Times", FontSlant -> "Italic"], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "computes the first diagonal \
component of the occupied-band quantum metric at ", 
        Cell[BoxData[StyleBox["k", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], ".", "\n", 
        Cell["   ", "ModInfo"], Cell[BoxData[
          RowBox[{RowBox[{ButtonBox["QuantumMetric", BaseStyle -> "Link", 
               ButtonData -> "paclet:TBMethod/ref/QuantumMetric"], "[", 
              RowBox[{RowBox[{"{", RowBox[{StyleBox["h", "TI", FontFamily -> 
                      "Times", FontSlant -> "Italic"], ",", StyleBox[
                     "velocities", "TI", FontFamily -> "Times", FontSlant -> 
                      "Italic"]}], "}"}], ",", StyleBox["filling", "TI", 
                 FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                RowBox[{"{", RowBox[{StyleBox["alpha", "TI", FontFamily -> 
                      "Times", FontSlant -> "Italic"], ",", StyleBox["beta", 
                     "TI", FontFamily -> "Times", FontSlant -> "Italic"]}], 
                  "}"}]}], "]"}], "[", StyleBox["k", "TI", FontFamily -> 
              "Times", FontSlant -> "Italic"], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", 
        "computes the component specified by derivative directions ", 
        Cell[BoxData[StyleBox["alpha", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], " and ", 
        Cell[BoxData[StyleBox["beta", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], ".", "\n", 
        Cell["   ", "ModInfo"], Cell[BoxData[
          RowBox[{RowBox[{ButtonBox["QuantumMetric", BaseStyle -> "Link", 
               ButtonData -> "paclet:TBMethod/ref/QuantumMetric"], "[", 
              RowBox[{RowBox[{"{", RowBox[{StyleBox["h", "TI", FontFamily -> 
                      "Times", FontSlant -> "Italic"], ",", StyleBox[
                     "velocities", "TI", FontFamily -> "Times", FontSlant -> 
                      "Italic"]}], "}"}], ",", StyleBox["q", "TI", 
                 FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                StyleBox["filling", "TI", FontFamily -> "Times", FontSlant -> 
                  "Italic"], ",", RowBox[{"{", RowBox[{StyleBox["alpha", 
                     "TI", FontFamily -> "Times", FontSlant -> "Italic"], 
                    ",", StyleBox["beta", "TI", FontFamily -> "Times", 
                     FontSlant -> "Italic"]}], "}"}]}], "]"}], "[", 
            StyleBox["k", "TI", FontFamily -> "Times", FontSlant -> 
              "Italic"], "]"}]], "InlineFormula"], " \[LineSeparator]", 
        "uses the symmetrized observable current associated with ", 
        Cell[BoxData[StyleBox["q", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], 
        " in the first direction.", "\n", Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{RowBox[{ButtonBox["QuantumMetric", BaseStyle -> 
                "Link", ButtonData -> "paclet:TBMethod/ref/QuantumMetric"], 
              "[", RowBox[{StyleBox["hv", "TI", FontFamily -> "Times", 
                 FontSlant -> "Italic"], ",", StyleBox["filling", "TI", 
                 FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                RowBox[{"{", RowBox[{StyleBox["alpha", "TI", FontFamily -> 
                      "Times", FontSlant -> "Italic"], ",", StyleBox["beta", 
                     "TI", FontFamily -> "Times", FontSlant -> "Italic"]}], 
                  "}"}]}], "]"}], "[", StyleBox["k", "TI", FontFamily -> 
              "Times", FontSlant -> "Italic"], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", "uses a combined function ", 
        Cell[BoxData[StyleBox["hv", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], 
        " that returns the Hamiltonian and its derivative matrices.", "\n", 
        Cell["   ", "ModInfo"], Cell[BoxData[
          RowBox[{RowBox[{ButtonBox["QuantumMetric", BaseStyle -> "Link", 
               ButtonData -> "paclet:TBMethod/ref/QuantumMetric"], "[", 
              RowBox[{StyleBox["hv", "TI", FontFamily -> "Times", 
