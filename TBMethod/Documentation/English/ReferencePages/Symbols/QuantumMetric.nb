                 FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                StyleBox["filling", "TI", FontFamily -> "Times", FontSlant -> 
                  "Italic"], ",", RowBox[{"{", RowBox[{StyleBox["alpha", 
                     "TI", FontFamily -> "Times", FontSlant -> "Italic"], 
                    ",", StyleBox["beta", "TI", FontFamily -> "Times", 
                     FontSlant -> "Italic"]}], "}"}]}], "]"}], "[", 
            StyleBox["k", "TI", FontFamily -> "Times", FontSlant -> 
              "Italic"], "]"}]], "InlineFormula"], " \[LineSeparator]", "uses \
the combined Hamiltonian\[Dash]derivative function and an observable-current \
insertion."}], "Usage", CellID -> 1477374411], 
     Cell[TextData[{Cell[BoxData[RowBox[{StyleBox["h", "TI"], "[", 
            StyleBox["k", "TI"], "]"}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " returns a Hermitian Hamiltonian and ", 
        Cell[BoxData[RowBox[{StyleBox["velocities", "TI"], "[", 
            StyleBox["k", "TI"], "]"}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " returns its derivative-matrix list. Alternatively, ", 
        Cell[BoxData[RowBox[{StyleBox["hv", "TI"], "[", StyleBox["k", "TI"], 
            "]"}]], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " returns ", Cell[BoxData[RowBox[{"{", RowBox[
             {RowBox[{StyleBox["h", "TI"], "[", StyleBox["k", "TI"], "]"}], 
              ",", RowBox[{StyleBox["velocities", "TI"], "[", StyleBox["k", 
                 "TI"], "]"}]}], "}"}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 414763077], 
     Cell[TextData[{"The default derivative directions are ", 
        Cell[BoxData[RowBox[{"{", RowBox[{"1", ",", "1"}], "}"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], ", selecting the \
first diagonal metric component. Direction indices are one-based."}], 
      "Notes", CellID -> 923052976], 
     Cell[TextData[{"A positive integer ", 
        Cell[BoxData[StyleBox["filling", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " counts occupied low-energy states. A real ", 
        Cell[BoxData[StyleBox["filling", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " is a Fermi energy; use a real number such as ", 
        Cell[BoxData["0."], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], " to distinguish it from a band count."}], 
      "Notes", CellID -> 617522257], 
     Cell[TextData[{"The optional observable matrix ", 
        Cell[BoxData[StyleBox["q", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " produces the symmetrized current shown below. The special value ", 
        Cell[BoxData["1"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " gives the ordinary metric."}], "Notes", CellID -> 1763080235], 
     Cell[TextData[{"An empty or completely occupied spectrum returns ", 
        Cell[BoxData["0."], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], ". Degeneracies across the filling require care \
because energy differences are squared in the denominator."}], "Notes", 
      CellID -> 828318854], Cell[TextData[{"Options for ", 
        Cell[BoxData[ButtonBox["Eigensystem", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Eigensystem"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " are accepted, with ", 
        Cell[BoxData[RowBox[{ButtonBox["Method", BaseStyle -> "Link", 
             ButtonData -> "paclet:ref/Method"], "\[Rule]", "\"Direct\""}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " supplied internally."}], "Notes", CellID -> 1396012936], 
     Cell[TextData[{"With the same occupied-to-unoccupied ordering as ", 
        Cell[BoxData[ButtonBox["BerryCurvature", BaseStyle -> "Link", 
           ButtonData -> "paclet:TBMethod/ref/BerryCurvature"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ", the component is", "\[LineSeparator]", 
        Cell[BoxData[FormBox[TagBox[RowBox[{SubscriptBox["g", RowBox[
                {"{", RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}]], 
              "\[LongEqual]", RowBox[{"Re", "(", RowBox[{UnderoverscriptBox[
                   "\[Sum]", RowBox[{"n", "=", "1"}], SubscriptBox["N", 
                    "occ"]], RowBox[{UnderoverscriptBox["\[Sum]", RowBox[
                      {"m", "=", RowBox[{SubscriptBox["N", "occ"], "+", 
                         "1"}]}], SubscriptBox["N", "bands"]], FractionBox[
                     RowBox[{SubscriptBox["j", RowBox[{"{", RowBox[
                          {"\[Alpha]", ",", "m", ",", "n"}], "}"}]], " ", 
                       SubscriptBox["v", RowBox[{"{", RowBox[{"\[Beta]", ",", 
                          "n", ",", "m"}], "}"}]]}], SuperscriptBox[
                      RowBox[{"(", RowBox[{SubscriptBox["\[Epsilon]", "m"], 
                          "-", SubscriptBox["\[Epsilon]", "n"]}], ")"}], 
                      "2"]]}]}], ")"}]}], HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FontSize -> 14, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 1076402731], 
     Cell[TextData[{"The first-direction observable-current insertion is", 
        "\[LineSeparator]", Cell[BoxData[FormBox[
           TagBox[RowBox[{SubscriptBox["j", "\[Alpha]"], "\[LongEqual]", 
              RowBox[{FractionBox["1", "2"], " ", RowBox[{"(", RowBox[
                   {RowBox[{"Q", ".", SubscriptBox["v", "\[Alpha]"]}], "+", 
                    RowBox[{SubscriptBox["v", "\[Alpha]"], ".", "Q"}]}], 
                  ")"}]}]}], HoldForm], TraditionalForm]], "InlineMath", 
         ScriptLevel -> 0, FontSize -> 14, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 2062345893]}, Open]], 
