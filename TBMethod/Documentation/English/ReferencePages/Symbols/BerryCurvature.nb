            StyleBox["k", "TI", FontFamily -> "Times", FontSlant -> 
              "Italic"], "]"}]], "InlineFormula"], " \[LineSeparator]", "uses \
the combined Hamiltonian\[Dash]derivative function and an observable-current \
insertion.", "\n", Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["BerryCurvature", BaseStyle -> "Link", 
             ButtonData -> "paclet:TBMethod/ref/BerryCurvature"], "[", 
            RowBox[{StyleBox["k", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", StyleBox["h", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["filling", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "estimates the \
two-dimensional Berry curvature by backward finite differences of ", 
        Cell[BoxData[StyleBox["h", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], "."}], "Usage", 
      CellID -> 1487148641], 
     Cell[TextData[{Cell[BoxData[RowBox[{StyleBox["h", "TI"], "[", 
            StyleBox["k", "TI"], "]"}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " returns the Hamiltonian, ", 
        Cell[BoxData[RowBox[{StyleBox["velocities", "TI"], "[", 
            StyleBox["k", "TI"], "]"}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " returns its derivative-matrix list, and ", 
        Cell[BoxData[RowBox[{StyleBox["hv", "TI"], "[", StyleBox["k", "TI"], 
            "]"}]], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " returns ", Cell[BoxData[RowBox[{"{", RowBox[
             {RowBox[{StyleBox["h", "TI"], "[", StyleBox["k", "TI"], "]"}], 
              ",", RowBox[{StyleBox["velocities", "TI"], "[", StyleBox["k", 
                 "TI"], "]"}]}], "}"}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 519106924], 
     Cell[TextData[{"In the curried forms, a positive integer ", 
        Cell[BoxData[StyleBox["filling", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " selects that many lowest-energy bands. A real ", 
        Cell[BoxData[StyleBox["filling", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " selects energies at or below the Fermi energy; use ", 
        Cell[BoxData["0."], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], " to specify zero Fermi energy."}], "Notes", 
      CellID -> 1471248794], 
     Cell[TextData[{"The default derivative directions are ", 
        Cell[BoxData[RowBox[{"{", RowBox[{"1", ",", "2"}], "}"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ". A supplied observable matrix ", Cell[BoxData[StyleBox["q", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " produces the symmetrized current shown below; the special value ", 
        Cell[BoxData["1"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " selects the ordinary derivative."}], "Notes", CellID -> 894119330], 
     Cell[TextData[{"The curried forms return ", Cell[BoxData["0."], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " for an empty or completely occupied spectrum."}], "Notes", 
      CellID -> 142705011], Cell[TextData[{"In the uncurried form, ", 
        Cell[BoxData[StyleBox["k", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " must be a two-component numeric \
vector. Exact coordinates such as ", 
        Cell[BoxData[RowBox[{"{", RowBox[{"0", ",", "0"}], "}"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " and ", 
        Cell[BoxData[RowBox[{"{", RowBox[{FractionBox[StyleBox["\[Pi]", 
                "TI"], "2"], ",", "0"}], "}"}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " are accepted, as are approximate \
coordinates. This form estimates two-dimensional derivatives using a \
backward-difference step of ", Cell[BoxData[FormBox[
           TagBox[FractionBox["1", SuperscriptBox["10", "7"]], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], ". \
Degeneracies across the filling can make the Kubo denominator singular."}], 
      "Notes", CellID -> 1944383923], 
     Cell[TextData[{"Options for ", Cell[BoxData[ButtonBox["Eigensystem", 
           BaseStyle -> "Link", ButtonData -> "paclet:ref/Eigensystem"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " are accepted, with ", Cell[BoxData[
          RowBox[{ButtonBox["Method", BaseStyle -> "Link", ButtonData -> 
              "paclet:ref/Method"], "\[Rule]", "\"Direct\""}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " supplied internally."}], "Notes", CellID -> 426154102], 
     Cell[TextData[{"With occupied states indexed by ", 
        Cell[BoxData[FormBox[TagBox["n", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], " and unoccupied states by ", 
        Cell[BoxData[FormBox[TagBox["m", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], 
        ", the implemented convention is", "\[LineSeparator]", 
        Cell[BoxData[FormBox[TagBox[RowBox[{SubscriptBox["\[CapitalOmega]", 
               RowBox[{"{", RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}]], 
              "\[LongEqual]", RowBox[{"2", " ", RowBox[{"Im", "(", 
                  RowBox[{UnderoverscriptBox["\[Sum]", RowBox[{"n", "=", 
                       "1"}], SubscriptBox["N", "occ"]], RowBox[
                     {UnderoverscriptBox["\[Sum]", RowBox[{"m", "=", RowBox[
                          {SubscriptBox["N", "occ"], "+", "1"}]}], 
                       SubscriptBox["N", "bands"]], FractionBox[RowBox[
                        {SubscriptBox["j", RowBox[{"{", RowBox[{"\[Alpha]", 
                          ",", "m", ",", "n"}], "}"}]], " ", SubscriptBox[
                          "v", RowBox[{"{", RowBox[{"\[Beta]", ",", "n", ",", 
                          "m"}], "}"}]]}], SuperscriptBox[RowBox[{"(", 
                          RowBox[{SubscriptBox["\[Epsilon]", "m"], "-", 
                          SubscriptBox["\[Epsilon]", "n"]}], ")"}], 
                        "2"]]}]}], ")"}]}]}], HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FontSize -> 14, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 1554334274], 
     Cell[TextData[{"The observable-current insertion is", 
        "\[LineSeparator]", Cell[BoxData[FormBox[
           TagBox[RowBox[{SubscriptBox["j", "\[Alpha]"], "\[LongEqual]", 
              RowBox[{FractionBox["1", "2"], " ", RowBox[{"(", RowBox[
                   {RowBox[{"Q", ".", SubscriptBox["v", "\[Alpha]"]}], "+", 
                    RowBox[{SubscriptBox["v", "\[Alpha]"], ".", "Q"}]}], 
                  ")"}]}]}], HoldForm], TraditionalForm]], "InlineMath", 
         ScriptLevel -> 0, FontSize -> 14, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 1808814977]}, Open]], 
