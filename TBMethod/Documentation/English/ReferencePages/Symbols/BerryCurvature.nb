             FontFamily -> "Times", FontSlant -> "Italic"], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", 
        "computes the occupied-band Berry curvature at momentum ", 
        Cell[BoxData[StyleBox["k", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], 
        " from the Hamiltonian and its momentum derivatives.", "\n", 
        Cell["   ", "ModInfo"], Cell[BoxData[
