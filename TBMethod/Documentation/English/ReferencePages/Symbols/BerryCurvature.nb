                        {"PauliMatrix", "[", "2", "]"}]}], "+", RowBox[
                      {"PauliMatrix", "[", "3", "]"}]}], "]"}]}], ";", 
               "\[IndentingNewLine]", RowBox[{RowBox[{"v", "[", "k_", "]"}], 
                 ":=", RowBox[{"N", "[", RowBox[{"{", RowBox[{RowBox[
                        {"PauliMatrix", "[", "1", "]"}], ",", RowBox[
                        {"PauliMatrix", "[", "2", "]"}]}], "}"}], "]"}]}], 
               ";", "\[IndentingNewLine]", RowBox[{RowBox[{"hv", "[", "k_", 
                   "]"}], ":=", RowBox[{"{", RowBox[{RowBox[{"h", "[", "k", 
                       "]"}], ",", RowBox[{"v", "[", "k", "]"}]}], "}"}]}], 
               ";", "\[IndentingNewLine]", RowBox[{"BerryCurvature", "[", 
                 RowBox[{RowBox[{"{", RowBox[{"0.", ",", "0."}], "}"}], ",", 
                   "h", ",", "1"}], "]"}]}]], "Input", CellID -> 2097861297], 
           Cell[BoxData["0.5`"], "Output", CellID -> 2044228564]}, Open]]}, 
       Open]]}, Open]], 
  Cell[CellGroupData[{Cell["More Examples", "ExtendedExamplesSection", 
      CellTags -> "ExtendedExamples", CellID -> 385754681], 
     Cell[CellGroupData[{Cell["Additional Examples", "ExampleSection", 
         CellID -> 1517609642], Cell[TextData[{Cell["   ", "ModInfo", 
            ExpressionUUID -> "6b9b6543-f432-4b10-824a-38250cf04c31"], 
           Cell[BoxData[RowBox[{"BerryCurvature", "[", RowBox[
                {RowBox[{"{", RowBox[{StyleBox[SubscriptBox["k", "x"], 
                      FontSlant -> "Italic"], ",", " ", StyleBox[SubscriptBox[
                       "k", "y"], FontSlant -> "Italic"]}], "}"}], ",", " ", 
                 StyleBox["H", FontSlant -> "Italic"], ",", " ", SubscriptBox[
                  StyleBox["n", FontSlant -> "Italic"], "F"]}], "]"}]], 
            "InlineFormula", ExpressionUUID -> 
             "350963c7-8e78-4d63-bf02-d43443ea170b"], 
           " calculates the Berry curvature ", 
           Cell[BoxData[StyleBox["\[CapitalOmega]", FontSlant -> "Italic"]], 
            "InlineFormula", ExpressionUUID -> 
             "c651998f-809c-4c3b-b4da-d28a19045c0b"], 
           " for a (at least locally) gapped Bloch Hamiltonian ", 
           Cell[BoxData[StyleBox["H", FontSlant -> "Italic"]], 
            "InlineFormula", ExpressionUUID -> 
             "4e7815b6-05c7-4bf8-84e3-1985a93ddc88"], 
           " at the lattice momentum point ", 
           Cell[BoxData[RowBox[{"{", RowBox[{StyleBox[SubscriptBox["k", "x"], 
                  FontSlant -> "Italic"], ",", StyleBox[SubscriptBox["k", 
                   "y"], FontSlant -> "Italic"]}], "}"}]], "InlineFormula", 
            ExpressionUUID -> "804d942a-9690-43ea-8d2f-0ddb6376e89d"], 
           " in the first Brillouin zone, with ", 
           Cell[BoxData[SubscriptBox[StyleBox["n", FontSlant -> "Italic"], 
              "F"]], "InlineFormula", ExpressionUUID -> 
             "aaceda69-1053-4496-bb09-90dd74af7ff4"], " states occupied."}], 
         "ExampleText", CellChangeTimes -> {{3.84889356242402*^9, 
            3.8488935715713778*^9}}, CellID -> 40067621, 
         ExpressionUUID -> "d51ffeee-8781-46a4-b2de-8e6852ac5fcc"], 
        Cell[TextData[{"The Bloch Hamiltonian is a map ", 
           Cell[BoxData[RowBox[{RowBox[{StyleBox["H", FontSlant -> "Italic"], 
                 StyleBox[":", FontSlant -> "Plain"], StyleBox[" ", 
                  FontSlant -> "Plain"], SuperscriptBox[StyleBox[TemplateBox[
                    {}, "Reals"], FontSlant -> "Plain"], "2"]}], "\[Rule]", 
               " ", SuperscriptBox[FormBox[TemplateBox[{}, "Complexes"], 
                 TraditionalForm], RowBox[{StyleBox["n", FontSlant -> 
                    "Italic"], " ", "\[Times]", " ", StyleBox["n", 
                   FontSlant -> "Italic"]}]]}]], "InlineFormula", 
            ExpressionUUID -> "f7ef3a6b-41c4-41e7-8777-d7b95832637a"], 
           ", where ", Cell[BoxData[RowBox[{StyleBox["n", FontSlant -> 
                 "Italic"], StyleBox["\[Element]", FontSlant -> "Plain"], 
               SuperscriptBox[StyleBox["\[DoubleStruckCapitalZ]", 
                 FontSlant -> "Plain"], "+"]}]], "InlineFormula", 
            ExpressionUUID -> "3dd87052-e76b-472c-bfd5-d475a22fa136"], 
           " is the band number."}], "ExampleText", CellChangeTimes -> 
          {3.8488935811531334*^9, {3.84889551839277*^9, 
            3.848895566928236*^9}}, CellID -> 221447166, 
         ExpressionUUID -> "c4288469-22bb-4bd2-a769-3dff1cf5edd3"], 
        Cell["Load the package", "ExampleText", CellChangeTimes -> 
          {3.8488928798782196*^9}, CellID -> 11904999, ExpressionUUID -> 
          "54c07daf-46d2-4044-a2d0-bb0d82229061"], 
        Cell[BoxData[RowBox[{"Needs", "[", "\"TBMethod`\"", "]"}]], "Input", 
         CellLabel -> "In[3]:=", CellID -> 226833854, ExpressionUUID -> 
          "7dfa98e9-05e5-472f-9898-26df08dd41c4"], 
        Cell["This constructs a modified Qi-Wu-Zhang model", "ExampleText", 
         CellChangeTimes -> {{3.8488937732707853*^9, 3.848893786635746*^9}, 
           {3.848893838258828*^9, 3.8488938475716667*^9}, 
           {3.848894817709978*^9, 3.8488948360699005*^9}}, 
         CellID -> 129563622, ExpressionUUID -> 
          "897a5f1c-5bc0-4758-80de-fea81208e9f2"], 
        Cell[BoxData[{RowBox[{"Clear", "[", "HQWZ", "]"}], 
           "\[IndentingNewLine]", RowBox[{RowBox[{"HQWZ", "[", RowBox[
                {RowBox[{"{", RowBox[{"kx_", ",", "ky_"}], "}"}], ",", 
                 RowBox[{"{", "M_", "}"}]}], "]"}], ":=", 
             RowBox[{RowBox[{"{", RowBox[{RowBox[{"Sin", "[", "kx", "]"}], 
                   ",", RowBox[{"Sin", "[", "ky", "]"}], ",", RowBox[
                    {"M", "-", RowBox[{"(", RowBox[{RowBox[{"Cos", "[", "kx", 
                          "]"}], "+", RowBox[{"Cos", "[", "ky", "]"}]}], 
                       ")"}]}]}], "}"}], ".", RowBox[{"PauliMatrix", "[", 
                 RowBox[{"Range", "[", "3", "]"}], "]"}]}]}]}], "Input", 
         CellChangeTimes -> {{3.8488937895920935*^9, 3.8488938197245607*^9}, 
           {3.848893853022169*^9, 3.848893929941546*^9}, 
           {3.8488939667499905*^9, 3.848893970764954*^9}, 
           {3.8488942275662575*^9, 3.8488943168381057*^9}, 
           {3.848894803981759*^9, 3.848894809678508*^9}, 
           {3.848894844289544*^9, 3.8488948482786674*^9}}, 
         CellLabel -> "In[45]:=", CellID -> 532933989, ExpressionUUID -> 
          "4fe38875-dd4f-4252-a4dc-4a784adb4221"], 
        Cell[TextData[
          {"This evaluates the Berry curvature of the model above with ", 
           Cell[BoxData[RowBox[{StyleBox["M", FontSlant -> "Italic"], "=", 
               RowBox[{"-", "1"}]}]], "InlineFormula", FormatType -> 
             StandardForm, ExpressionUUID -> 
             "1d67e6d7-ee1b-4b6c-8133-82d22bc3ac96"], 
           " at the \[CapitalGamma] point and with one band occupied (", 
           Cell[BoxData[RowBox[{SubscriptBox[StyleBox["n", FontSlant -> 
                  "Italic"], "F"], "=", "1"}]], "InlineFormula", 
            FormatType -> StandardForm, ExpressionUUID -> 
             "f11c132d-b78c-4fcd-ac16-07d4b98e580e"], ")"}], "ExampleText", 
         CellChangeTimes -> {{3.8488949256782436*^9, 3.8488950020857353*^9}, 
           {3.848895594789983*^9, 3.848895604904991*^9}}, CellID -> 32212198, 
         ExpressionUUID -> "cb377ca2-c450-4e9b-b57b-60f191a21392"], 
        Cell[CellGroupData[{Cell[BoxData[{RowBox[{"Clear", "[", 
                RowBox[{"M", ",", "nF", ",", "\[CapitalOmega]"}], "]"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"{", RowBox[
                     {"M", ",", "nF"}], "}"}], "=", RowBox[{"{", RowBox[
                     {RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ";", 
                "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"\[CapitalOmega]", "[", "vk_", "]"}], ":=", 
                RowBox[{"BerryCurvature", "[", RowBox[{"vk", ",", RowBox[
                     {RowBox[{"HQWZ", "[", RowBox[{"#", ",", RowBox[{"{", 
                          "M", "}"}]}], "]"}], "&"}], ",", "nF"}], "]"}]}], 
              "\[IndentingNewLine]", RowBox[{"\[CapitalOmega]", "[", 
                RowBox[{"{", RowBox[{".0", ",", ".0"}], "}"}], "]"}]}], 
