             "93492339-640c-4aac-8ab2-cc0f5c3c51cf"]}, Open]], 
        Cell[TextData[{"We know that the above state is a Chern insulator \
with a Chern number ", Cell[BoxData[RowBox[{"\[ScriptCapitalC]", "=", "1"}]], 
            "InlineFormula", ExpressionUUID -> 
             "a9dcdf50-149b-4564-865e-079dd390aeb1"], 
           ", and codes below approximates the corresponding result"}], 
         "ExampleText", CellChangeTimes -> {{3.848895033397382*^9, 
            3.8488951134780607*^9}, {3.8488983368177214*^9, 
            3.8488983383692474*^9}}, CellID -> 685608477, 
         ExpressionUUID -> "44021321-5465-4565-86cd-10765d797b71"], 
        Cell[CellGroupData[{Cell[BoxData[{RowBox[{RowBox[{"nmesh", "=", 
                  "500"}], ";", "\[IndentingNewLine]"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"vkmesh", "=", 
                  RowBox[{"Tuples", "[", RowBox[{RowBox[{"Subdivide", "[", 
                        RowBox[{RowBox[{RowBox[{"-", "1."}], "\[Pi]"}], ",", 
                          "\[Pi]", ",", "nmesh"}], "]"}], ",", "2"}], 
                    "]"}]}], ";", "\[IndentingNewLine]"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"\[CapitalOmega]data", 
                  "=", RowBox[{"ParallelTable", "[", RowBox[{RowBox[
