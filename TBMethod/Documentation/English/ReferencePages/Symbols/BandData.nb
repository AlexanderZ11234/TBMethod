  Cell[CellGroupData[{Cell["BandData", "ObjectName", CellID -> 1146029128], 
     Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["BandData", BaseStyle -> "Link", 
             ButtonData -> "paclet:TBMethod/ref/BandData"], "[", 
            RowBox[{StyleBox["h", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", StyleBox["samples", "TI", FontFamily -> 
                "Times", FontSlant -> "Italic"]}], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", "collects the sorted eigenvalues of ", 
        Cell[BoxData[StyleBox["h", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], 
        " at each sample, with one output list per band.", "\n", 
        Cell["   ", "ModInfo"], Cell[BoxData[
          RowBox[{ButtonBox["BandData", BaseStyle -> "Link", 
             ButtonData -> "paclet:TBMethod/ref/BandData"], "[", 
            RowBox[{StyleBox["h", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", StyleBox["samples", "TI", FontFamily -> 
                "Times", FontSlant -> "Italic"], ",", StyleBox["n", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "retains the ", 
        Cell[BoxData[StyleBox["n", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], 
        " eigenvalues selected by ", Cell[BoxData[ButtonBox["Eigenvalues", 
           BaseStyle -> "Link", ButtonData -> "paclet:ref/Eigenvalues"]], 
         "InlineFormula"], " at each sample.", "\n", Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["BandData", BaseStyle -> "Link", 
             ButtonData -> "paclet:TBMethod/ref/BandData"], "[", 
            RowBox[{RowBox[{"{", RowBox[{StyleBox["h", "TI", FontFamily -> 
                    "Times", FontSlant -> "Italic"], ",", StyleBox["s", "TI", 
                   FontFamily -> "Times", FontSlant -> "Italic"]}], "}"}], 
              ",", StyleBox["samples", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"]}], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", 
        "solves the generalized eigenvalue problem for the Hamiltonian ", 
        Cell[BoxData[StyleBox["h", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], " and overlap matrix ", 
        Cell[BoxData[StyleBox["s", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], ".", "\n", 
        Cell["   ", "ModInfo"], Cell[BoxData[
          RowBox[{ButtonBox["BandData", BaseStyle -> "Link", 
             ButtonData -> "paclet:TBMethod/ref/BandData"], "[", 
            RowBox[{RowBox[{"{", RowBox[{StyleBox["h", "TI", FontFamily -> 
                    "Times", FontSlant -> "Italic"], ",", StyleBox["s", "TI", 
                   FontFamily -> "Times", FontSlant -> "Italic"]}], "}"}], 
              ",", StyleBox["samples", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["n", "TI", FontFamily -> 
                "Times", FontSlant -> "Italic"]}], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", "retains ", 
        Cell[BoxData[StyleBox["n", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], 
        " eigenvalues from each generalized eigenvalue problem."}], "Usage", 
      CellID -> 1319283534], 
     Cell[TextData[{Cell[BoxData[RowBox[{StyleBox["h", "TI"], "[", 
            StyleBox["k", "TI"], "]"}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " returns the Hamiltonian matrix at sample ", 
        Cell[BoxData[StyleBox["k", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], ". ", 
        Cell[BoxData[StyleBox["samples", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " may contain scalar parameters or momentum vectors."}], "Notes", 
      CellID -> 1631186814], Cell[TextData[{"The output has one row per \
retained band and one column per sample. Eigenvalues are sorted separately at \
each sample, so bands are ordered by energy rather than tracked through \
crossings."}], "Notes", CellID -> 619330966], 
     Cell[TextData[{"The ", Cell[BoxData[RowBox[
           {"{", RowBox[{StyleBox["h", "TI"], ",", StyleBox["s", "TI"]}], 
            "}"}]], "InlineFormula", FontFamily -> "Source Sans Pro"], " form \
solves the generalized eigenvalue problem with overlap matrix ", 
        Cell[BoxData[RowBox[{StyleBox["s", "TI"], "[", StyleBox["k", "TI"], 
            "]"}]], "InlineFormula", FontFamily -> "Source Sans Pro"], "."}], 
      "Notes", CellID -> 1013882837], 
     Cell[TextData[{Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " is passed to ", 
        Cell[BoxData[ButtonBox["Eigenvalues", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Eigenvalues"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], ". Options for ", 
        Cell[BoxData[ButtonBox["Eigenvalues", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Eigenvalues"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " are accepted, and ", 
        Cell[BoxData[RowBox[{ButtonBox["Method", BaseStyle -> "Link", 
             ButtonData -> "paclet:ref/Method"], "\[Rule]", "\"Direct\""}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " is supplied internally."}], "Notes", CellID -> 108075650]}, Open]], 
