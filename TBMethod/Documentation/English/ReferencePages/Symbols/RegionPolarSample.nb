  Cell[CellGroupData[{Cell["RegionPolarSample", "ObjectName", 
      CellID -> 642952508], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["RegionPolarSample", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/RegionPolarSample"], "[", 
            RowBox[{StyleBox["polygon", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["nRadial", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"], ",", 
              StyleBox["angularScale", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"]}], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", "samples a polygonal region on concentric \
polygonal loops with increasing angular resolution."}], "Usage", 
      CellID -> 621058022], Cell[TextData[{"The implementation uses ", 
        Cell[BoxData[ButtonBox["PolygonCoordinates", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/PolygonCoordinates"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " and a fixed center ", 
        Cell[BoxData[RowBox[{"{", RowBox[{"0.", ",", "0."}], "}"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], ". Use an \
origin-centered two-dimensional polygon whose vertices can be ordered by \
polar angle."}], "Notes", CellID -> 724847621], 
     Cell[TextData[{Cell[BoxData[StyleBox["nRadial", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " should be a positive integer and ", 
        Cell[BoxData[StyleBox["angularScale", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " must be positive. The origin itself is omitted."}], "Notes", 
      CellID -> 1496318420], 
     Cell[TextData[{"The radial construction returns ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{"nRadial", "+", "1"}], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], 
        " loops: scales ", Cell[BoxData[FormBox[TagBox[FractionBox["1", 
             "nRadial"], HoldForm], TraditionalForm]], "InlineMath", 
         ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], " through ", 
        Cell[BoxData[FormBox[TagBox["1", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], ", followed by an additional \
outer-boundary loop. The two outer loops have the same radius but different \
sampling densities."}], "Notes", CellID -> 814360286], 
     Cell[TextData[{"For loop index ", Cell[BoxData[StyleBox["j", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], ", ", 
        Cell[BoxData[ButtonBox["PathSample", BaseStyle -> "Link", 
           ButtonData -> "paclet:TBMethod/ref/PathSample"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " uses ", 
        Cell[BoxData[RowBox[{"1", "+", RowBox[{ButtonBox["Ceiling", 
               BaseStyle -> "Link", ButtonData -> "paclet:ref/Ceiling"], "[", 
              RowBox[{StyleBox["angularScale", "TI"], " ", StyleBox["j", 
                 "TI"]}], "]"}]}]], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], " subdivisions on its shortest polygon side. \
Each loop omits the repeated closing vertex."}], "Notes", 
      CellID -> 1536416833], 
     Cell[TextData[{"The returned list of loops can be used for ", 
        Cell[BoxData[ButtonBox["WannierChargeCenterByWilsonLoop", 
           BaseStyle -> "Link", ButtonData -> 
            "paclet:TBMethod/ref/WannierChargeCenterByWilsonLoop"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], ". Nonconvex \
polygons or regions not centered at the origin require checking the actual \
sample geometry."}], "Notes", CellID -> 1902177179]}, Open]], 
