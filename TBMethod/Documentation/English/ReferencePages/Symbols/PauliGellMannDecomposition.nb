              "paclet:TBMethod/ref/PauliGellMannDecomposition"], "[", 
            RowBox[{StyleBox["matrix", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["dimensions", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "expand a matrix in a \
tensor-product basis of Pauli and Gell-Mann matrices."}], "Usage", 
      CellID -> 877752609], 
     Cell[TextData[{Cell[BoxData[StyleBox["dimensions", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " is a list of ", 
        Cell[BoxData["2"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " and/or ", Cell[BoxData["3"], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " specifying the ordered internal \
tensor factors. Their product must match the square matrix dimension."}], 
      "Notes", CellID -> 2065372481], 
     Cell[TextData[{"Returns an ", Cell[BoxData[ButtonBox["Association", 
           BaseStyle -> "Link", ButtonData -> "paclet:ref/Association"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " with entries ", 
        Cell[BoxData[RowBox[{StyleBox["indexVector", "TI"], "\[Rule]", 
            StyleBox["coefficient", "TI"]}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], ", using indices ", 
        Cell[BoxData["0"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " through ", Cell[BoxData["3"], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " for a dimension-2 factor and ", 
        Cell[BoxData["0"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " through ", Cell[BoxData["8"], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " for a dimension-3 factor. Zero \
entries are omitted by the sparse representation."}], "Notes", 
      CellID -> 299780568], Cell[TextData[{"Index ", Cell[BoxData["0"], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " denotes the \
identity in either factor. Coefficients are simplified with ", 
        Cell[BoxData[ButtonBox["FullSimplify", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/FullSimplify"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 1603983058], Cell[TextData[{"For two internal factors, let ", 
        Cell[BoxData[FormBox[TagBox["T", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], " denote the corresponding \
Pauli or Gell-Mann basis, including its identity element. The coefficient \
association represents", "\[LineSeparator]", 
        Cell[BoxData[FormBox[TagBox[RowBox[{"M", "\[LongEqual]", 
              RowBox[{UnderoverscriptBox["\[Sum]", RowBox[{"a", "=", "0"}], 
                 RowBox[{SubsuperscriptBox["d", "1", "2"], "-", "1"}]], 
                RowBox[{UnderoverscriptBox["\[Sum]", RowBox[{"b", "=", "0"}], 
                   RowBox[{SubsuperscriptBox["d", "2", "2"], "-", "1"}]], 
                  RowBox[{SubscriptBox["c", RowBox[{"{", RowBox[{"a", ",", 
                         "b"}], "}"}]], " ", RowBox[{SubscriptBox["T", "a"], 
                      "\[CircleTimes]", SubscriptBox["T", "b"]}]}]}]}]}], 
            HoldForm], TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FontSize -> 14, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 1206843542]}, Open]], 
