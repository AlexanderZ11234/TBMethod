               FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "gives the symmetric-gauge \
Peierls phase for a magnetic field in an arbitrary direction."}], "Usage", 
      CellID -> 1713259257], 
     Cell[TextData[{"The scalar-field form embeds the planar endpoints at ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{"z", "\[LongEqual]", "0"}], 
            HoldForm], TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], 
        " and places the field along the third direction."}], "Notes", 
      CellID -> 540802353], 
     Cell[TextData[
       {"The implemented sign convention is for electron charge ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{"q", "\[LongEqual]", 
              RowBox[{"-", "e"}]}], HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], ", with ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{"e", ">", "0"}], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], ". The \
determinant in the formula below has the final endpoint, field vector, and \
initial endpoint as its rows, in that order."}], "Notes", 
      CellID -> 123325016], Cell[TextData[{"Inputs must already use mutually \
consistent charge, flux, and length units. No additional physical constants \
are inserted."}], "Notes", CellID -> 1061714274], 
     Cell[TextData[{"For a real magnetic field and real endpoints, reversing \
the endpoint order or reversing the field gives the complex-conjugate phase. \
Zero field or coincident endpoints give ", Cell[BoxData["1"], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 1783113998], 
     Cell[TextData[
       {"The symmetric-gauge phase uses the electron sign convention. Here ", 
        Cell[BoxData[FormBox[TagBox[SubscriptBox[StyleBox["r", 
              FontWeight -> "Bold", FontSlant -> "Italic", StripOnInput -> 
               False], StyleBox["f", FontSlant -> "Plain", StripOnInput -> 
               False]], HoldForm], TraditionalForm]], "InlineMath", 
         ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], " and ", 
        Cell[BoxData[FormBox[TagBox[SubscriptBox[StyleBox["r", 
              FontWeight -> "Bold", FontSlant -> "Italic", StripOnInput -> 
               False], StyleBox["i", FontSlant -> "Plain", StripOnInput -> 
               False]], HoldForm], TraditionalForm]], "InlineMath", 
         ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], 
        " are the final and initial position vectors, and ", 
        Cell[BoxData[FormBox[TagBox[StyleBox["B", FontWeight -> "Bold", 
             FontSlant -> "Italic", StripOnInput -> False], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], 
        " is the magnetic-field vector:", "\[LineSeparator]", 
        Cell[BoxData[FormBox[TagBox[RowBox[{RowBox[{"u", "(", RowBox[
                 {SubscriptBox[StyleBox["r", FontWeight -> "Bold", 
                    FontSlant -> "Italic", StripOnInput -> False], 
                   StyleBox["f", FontSlant -> "Plain", StripOnInput -> 
                     False]], ",", SubscriptBox[StyleBox["r", FontWeight -> 
                     "Bold", FontSlant -> "Italic", StripOnInput -> False], 
                   StyleBox["i", FontSlant -> "Plain", StripOnInput -> 
                     False]]}], ")"}], "\[LongEqual]", RowBox[{"exp", "(", 
                RowBox[{RowBox[{"-", StyleBox["\[ImaginaryI]", FontSlant -> 
                      "Plain", StripOnInput -> False]}], " ", StyleBox[
                   "\[Pi]", FontSlant -> "Plain", StripOnInput -> False], 
                  " ", TemplateBox[{RowBox[{"{", RowBox[{SubscriptBox[
                         StyleBox["r", FontWeight -> "Bold", FontSlant -> 
                          "Italic", StripOnInput -> False], StyleBox["f", 
                          FontSlant -> "Plain", StripOnInput -> False]], ",", 
                        StyleBox["B", FontWeight -> "Bold", FontSlant -> 
                          "Italic", StripOnInput -> False], ",", SubscriptBox[
                         StyleBox["r", FontWeight -> "Bold", FontSlant -> 
                          "Italic", StripOnInput -> False], StyleBox["i", 
                          FontSlant -> "Plain", StripOnInput -> False]]}], 
                      "}"}]}, "Det"]}], ")"}]}], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, FontSize -> 14, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 1317230952]}, Open]], 
