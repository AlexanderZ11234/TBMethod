                "}"}]}], "]"}]], "InlineFormula"], " \[LineSeparator]", "give\
s the Peierls phase for a perpendicular magnetic field and two planar \
endpoints.", "\n", Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{RowBox[{ButtonBox["PhaseFactor3DAB", 
               BaseStyle -> "Link", ButtonData -> 
                "paclet:TBMethod/ref/PhaseFactor3DAB"], "[", RowBox[{"{", 
