  Cell[CellGroupData[{Cell["PauliGellMannAbstract", "ObjectName", 
      CellID -> 1748956047], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["PauliGellMannAbstract", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/PauliGellMannAbstract"], "[", 
            RowBox[{StyleBox["coefficients", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["dimensions", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "express a Pauli/Gell-Mann \
coefficient association as a compact symbolic tensor-product sum."}], 
      "Usage", CellID -> 1980198770], 
     Cell[TextData[{Cell[BoxData[StyleBox["coefficients", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " is the association returned by ", 
        Cell[BoxData[ButtonBox["PauliGellMannDecomposition", 
           BaseStyle -> "Link", ButtonData -> 
            "paclet:TBMethod/ref/PauliGellMannDecomposition"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], ". ", 
        Cell[BoxData[StyleBox["dimensions", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " specifies the same ordered tensor factors, each ", 
        Cell[BoxData["2"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " or ", Cell[BoxData["3"], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], "."}], "Notes", CellID -> 2076401271], 
     Cell[TextData[{"The symbolic result uses string heads ", 
        Cell[BoxData["\"\[Sigma]\""], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " and ", 
        Cell[BoxData["\"\[Lambda]\""], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " for Pauli and Gell-Mann factors, and ", 
        Cell[BoxData[ButtonBox["CircleTimes", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/CircleTimes"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " for tensor products. It is not a matrix representation."}], 
      "Notes", CellID -> 500354353]}, Open]], 
  Cell[CellGroupData[{Cell["Examples", "PrimaryExamplesSection", 
      CellID -> 1466526345], Cell[TextData[{"Represent 2 identity + 3 sigma-x \
symbolically and verify its matrix meaning."}], "ExampleText", 
      CellID -> 1354302753], 
     Cell[BoxData[RowBox[{"Needs", "[", "\"TBMethod`\"", "]"}]], "Input", 
      CellID -> 742443245], Cell[CellGroupData[
       {Cell[BoxData[RowBox[{RowBox[{"coefficients", "=", 
