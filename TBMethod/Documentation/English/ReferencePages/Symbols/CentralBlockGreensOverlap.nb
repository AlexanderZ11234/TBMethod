        Cell[BoxData[RowBox[{ButtonBox["CentralBlockGreensOverlap", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/CentralBlockGreensOverlap"], "[", 
            RowBox[{StyleBox["z", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", RowBox[{"{", RowBox[{StyleBox[
                   "hamiltonianBlocks", "TI", FontFamily -> "Times", 
                   FontSlant -> "Italic"], ",", StyleBox["overlapBlocks", 
                   "TI", FontFamily -> "Times", FontSlant -> "Italic"]}], 
                "}"}], ",", StyleBox["sigmas", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"]}], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", "computes the final contact Green block of a \
layered device in a nonorthogonal basis.", "\n", Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["CentralBlockGreensOverlap", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/CentralBlockGreensOverlap"], "[", 
            RowBox[{StyleBox["z", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", RowBox[{"{", RowBox[{StyleBox[
                   "hamiltonianBlocks", "TI", FontFamily -> "Times", 
                   FontSlant -> "Italic"], ",", StyleBox["overlapBlocks", 
                   "TI", FontFamily -> "Times", FontSlant -> "Italic"]}], 
                "}"}], ",", StyleBox["sigmas", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["mode", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", 
        "returns the contact block or the final block column according to ", 
        Cell[BoxData[StyleBox["mode", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], "."}], "Usage", 
      CellID -> 811086705], 
     Cell[TextData[{Cell[BoxData[StyleBox["hamiltonianBlocks", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " and ", 
        Cell[BoxData[StyleBox["overlapBlocks", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " must have matching block dimensions and layer order."}], "Notes", 
      CellID -> 177688561], 
     Cell[TextData[{"All ", Cell[BoxData[StyleBox["sigmas", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " are attached to the last layer. The default mode ", 
        Cell[BoxData["\"T\""], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], " returns its diagonal block; ", 
        Cell[BoxData["\"LDOS\""], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], " and ", Cell[BoxData["\"LCDV\""], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " return the final column in reverse layer order."}], "Notes", 
      CellID -> 1204569600], Cell[TextData[{"At complex energy, the \
transformed upper overlap coupling is computed separately, preserving ", 
        Cell[BoxData[FormBox["z", TraditionalForm]], "InlineMath", 
         ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], " rather than ", 
        Cell[BoxData[FormBox[TemplateBox[{"z"}, "Conjugate", 
            SyntaxForm -> SuperscriptBox], TraditionalForm]], "InlineMath", 
         ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], "."}], "Notes", 
      CellID -> 434901824]}, Open]], 
