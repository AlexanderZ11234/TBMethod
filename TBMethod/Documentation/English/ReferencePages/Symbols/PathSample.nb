  Cell[CellGroupData[{Cell["PathSample", "ObjectName", CellID -> 1039010045], 
     Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["PathSample", BaseStyle -> "Link", 
             ButtonData -> "paclet:TBMethod/ref/PathSample"], "[", 
            RowBox[{StyleBox["vertices", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["nleast", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "samples a piecewise straight \
path with a common approximate spacing and returns sample-index markers for \
its vertices."}], "Usage", CellID -> 126213490], 
     Cell[TextData[{Cell[BoxData[StyleBox["vertices", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " contains at \
least three numeric coordinate vectors of the same dimension. Consecutive \
vertices must be distinct; the implementation does not handle zero-length \
segments."}], "Notes", CellID -> 1087090892], 
     Cell[TextData[{Cell[BoxData[StyleBox["nleast", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " is a positive integer giving the \
number of subdivisions on the shortest segment. Other subdivision counts are \
computed as ", Cell[BoxData[RowBox[{ButtonBox["Floor", BaseStyle -> "Link", 
             ButtonData -> "paclet:ref/Floor"], "[", FractionBox[
             RowBox[{StyleBox["nleast", "TI"], " ", StyleBox["length", 
                "TI"]}], StyleBox["shortestLength", "TI"]], "]"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 1032985669], Cell[TextData[{"Returns ", 
        Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["samples", "TI"], ",", 
              StyleBox["vertexMarkers", "TI"]}], "}"}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], ". Each segment contributes its \
initial point but omits its endpoint, so internal vertices appear once and \
the last vertex is omitted."}], "Notes", CellID -> 201865253], 
     Cell[TextData[{Cell[BoxData[StyleBox["vertexMarkers", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " starts at ", 
        Cell[BoxData["1"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ". Its last marker is ", Cell[BoxData[
          RowBox[{RowBox[{ButtonBox["Length", BaseStyle -> "Link", 
               ButtonData -> "paclet:ref/Length"], "[", StyleBox["samples", 
               "TI"], "]"}], "+", "1"}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        ", representing the omitted terminal vertex."}], "Notes", 
      CellID -> 535904038]}, Open]], 
