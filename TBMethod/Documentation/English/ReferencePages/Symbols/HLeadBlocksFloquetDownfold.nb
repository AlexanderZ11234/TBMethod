                  RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", RowBox[{"h1", "=", RowBox[{
                "KroneckerProduct", "[", RowBox[{RowBox[{"-", FractionBox[
                     RowBox[{"PauliMatrix", "[", "0", "]"}], "5"]}], ",", 
                  RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", RowBox[{"v", "=", RowBox[{
