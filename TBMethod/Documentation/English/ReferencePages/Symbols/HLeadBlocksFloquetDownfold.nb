  Cell[CellGroupData[{Cell["HLeadBlocksFloquetDownfold", "ObjectName", 
      CellID -> 1732063868], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{RowBox[{ButtonBox["HLeadBlocksFloquetDownfold", 
               BaseStyle -> "Link", ButtonData -> 
                "paclet:TBMethod/ref/HLeadBlocksFloquetDownfold"], "[", 
              RowBox[{StyleBox["omega", "TI", FontFamily -> "Times", 
                 FontSlant -> "Italic"], ",", StyleBox["m", "TI", 
                 FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                StyleBox["csrBlocks", "TI", FontFamily -> "Times", 
                 FontSlant -> "Italic"]}], "]"}], "[", 
            RowBox[{"{", RowBox[{StyleBox["h0", "TI", FontFamily -> "Times", 
                 FontSlant -> "Italic"], ",", StyleBox["h1", "TI", 
                 FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                StyleBox["v", "TI", FontFamily -> "Times", FontSlant -> 
                  "Italic"]}], "}"}], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", "project extended lead blocks to photon sector \
zero, with an optional interface micromotion correction."}], "Usage", 
      CellID -> 911075498], Cell[TextData[{"Projects the lead onsite block ", 
        Cell[BoxData[StyleBox["h0", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " and intercell block ", 
        Cell[BoxData[StyleBox["h1", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " onto their photon-zero sectors. \
Projects the scattering-region-to-lead coupling ", 
        Cell[BoxData[StyleBox["v", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " onto photon zero on both sides."}], "Notes", CellID -> 1374124735], 
     Cell[TextData[
       {"Input matrices use internal-major, photon-minor ordering with ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{RowBox[{"2", " ", "m"}], "+", 
              "1"}], HoldForm], TraditionalForm]], "InlineMath", 
         ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], " photon sectors. The result is \
the three-element lead block list for the reduced space."}], "Notes", 
      CellID -> 223562227], Cell[TextData[{"The options are ", 
        Cell[BoxData[RowBox[{"\"ExpansionOrder\"", "\[Rule]", "1"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " and ", 
        Cell[BoxData[RowBox[{"\"MicromotionCorrection\"", "\[Rule]", 
            ButtonBox["False", BaseStyle -> "Link", ButtonData -> 
              "paclet:ref/False"]}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        ". The coupling correction is applied only when the order is ", 
        Cell[BoxData["2"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " and micromotion correction is ", 
        Cell[BoxData[ButtonBox["True", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/True"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], ". ", 
        Cell[BoxData[StyleBox["csrBlocks", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " supplies the extended \
scattering-region blocks used by that correction."}], "Notes", 
      CellID -> 1916914075], Cell[TextData[{"The default behavior is \
projection. Use the effective-Hamiltonian routines when van Vleck corrections \
to the Hamiltonian blocks themselves are required."}], "Notes", 
      CellID -> 194227000]}, Open]], 
  Cell[CellGroupData[{Cell["Examples", "PrimaryExamplesSection", 
      CellID -> 444169966], Cell[TextData[{"Project a static lead with three \
photon sectors down to its two internal states."}], "ExampleText", 
      CellID -> 1582073237], 
     Cell[BoxData[RowBox[{"Needs", "[", "\"TBMethod`\"", "]"}]], "Input", 
      CellID -> 1736969630], Cell[CellGroupData[
       {Cell[BoxData[RowBox[{RowBox[{"h0", "=", RowBox[{"KroneckerProduct", 
