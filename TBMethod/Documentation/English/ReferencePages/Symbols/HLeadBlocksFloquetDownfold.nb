                  RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", RowBox[{"csrBlocks", "=", RowBox[{"{", 
                RowBox[{RowBox[{"{", RowBox[{"h0", ",", "h0"}], "}"}], ",", 
                  RowBox[{"{", "h1", "}"}]}], "}"}]}], ";", 
            "\[IndentingNewLine]", RowBox[
             {RowBox[{"HLeadBlocksFloquetDownfold", "[", RowBox[{"10.", ",", 
