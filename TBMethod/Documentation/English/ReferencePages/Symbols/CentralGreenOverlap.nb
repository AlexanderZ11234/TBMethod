  Cell[CellGroupData[{Cell["CentralGreenOverlap", "ObjectName", 
      CellID -> 1907883747], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["CentralGreenOverlap", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/CentralGreenOverlap"], "[", 
            RowBox[{StyleBox["z", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", RowBox[{"{", RowBox[{StyleBox["h", "TI", 
                   FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                  StyleBox["s", "TI", FontFamily -> "Times", FontSlant -> 
                    "Italic"]}], "}"}], ",", StyleBox["sigmas", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", 
        "computes the full device Green matrix with Hamiltonian ", 
        Cell[BoxData[StyleBox["h", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], ", overlap matrix ", 
        Cell[BoxData[StyleBox["s", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], 
        ", and contact self-energies ", Cell[BoxData[StyleBox["sigmas", "TI", 
           FontFamily -> "Times", FontSlant -> "Italic"]], "InlineFormula"], 
        ".", "\n", Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["CentralGreenOverlap", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/CentralGreenOverlap"], "[", 
            RowBox[{StyleBox["z", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", RowBox[{"{", RowBox[{StyleBox["h", "TI", 
                   FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                  StyleBox["s", "TI", FontFamily -> "Times", FontSlant -> 
                    "Italic"]}], "}"}], ",", StyleBox["sigmas", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"], ",", 
              StyleBox["method", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"]}], "]"}]], "InlineFormula"], " \[LineSeparator]", 
        "uses the specified matrix-inversion method."}], "Usage", 
      CellID -> 1204333937], 
     Cell[TextData[{Cell[BoxData[StyleBox["h", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " and ", 
        Cell[BoxData[StyleBox["s", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " are the Hamiltonian and overlap \
matrices in the full device basis. Self-energies must use that same basis."}]\
, "Notes", CellID -> 1281205981], 
     Cell[TextData[{"The default matrix-inversion ", 
        Cell[BoxData[StyleBox["method", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " is ", Cell[BoxData["1"], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], ", as in ", 
        Cell[BoxData[ButtonBox["CentralGreen", BaseStyle -> "Link", 
           ButtonData -> "paclet:TBMethod/ref/CentralGreen"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 496775348], Cell[TextData[{"The shared overlap-transform \
dispatcher can confuse full-device matrix pairs of dimensions ", 
        Cell[BoxData[RowBox[{"{", RowBox[{"2", ",", "2"}], "}"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " or ", 
        Cell[BoxData[RowBox[{"{", RowBox[{"3", ",", "3"}], "}"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " with lead-block \
input. The basic example uses four sites to avoid this implementation \
ambiguity."}], "Notes", CellID -> 753217971], 
     Cell[TextData[{"The overlap matrix enters the device resolvent as", 
        "\[LineSeparator]", Cell[BoxData[FormBox[
           TagBox[RowBox[{RowBox[{SubscriptBox["G", "C"], "(", "z", ")"}], 
              "\[LongEqual]", TemplateBox[{RowBox[{"(", RowBox[
                   {RowBox[{"z", " ", SubscriptBox["S", "C"]}], "-", 
                    SubscriptBox["H", "C"], "-", RowBox[{UnderoverscriptBox[
                       "\[Sum]", RowBox[{"p", "=", "1"}], SubscriptBox["N", 
                        "L"]], RowBox[{SubscriptBox["\[CapitalSigma]", "p"], 
                        "(", "z", ")"}]}]}], ")"}]}, "Inverse", SyntaxForm -> 
                SuperscriptBox]}], HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FontSize -> 14, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 630808478]}, Open]], 
