        Cell[BoxData[StyleBox["g", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " must be expressed in the same contact or full-device basis."}], 
      "Notes", CellID -> 1998499455], 
     Cell[TextData[{"The broadening is formed from the anti-Hermitian part of \
each self-energy. The elementwise imaginary part alone is insufficient for a \
general matrix."}], "Notes", CellID -> 1678029938], 
     Cell[TextData[{"The routine performs no real-part extraction or \
clipping. Negligible numerical imaginary residues may remain."}], "Notes", 
      CellID -> 1812717797], 
     Cell[TextData[{"The broadening matrix of contact ", 
        Cell[BoxData[FormBox[TagBox["p", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], " is", "\[LineSeparator]", 
        Cell[BoxData[FormBox[TagBox[RowBox[{SubscriptBox["\[CapitalGamma]", 
               "p"], "\[LongEqual]", RowBox[{"\[ImaginaryI]", " ", 
                RowBox[{"(", RowBox[{SubscriptBox["\[CapitalSigma]", "p"], 
                    "-", TemplateBox[{RowBox[{"(", SubscriptBox[
                         "\[CapitalSigma]", "p"], ")"}]}, 
                     "ConjugateTranspose", SyntaxForm -> SuperscriptBox]}], 
                  ")"}]}]}], HoldForm], TraditionalForm]], "InlineMath", 
         ScriptLevel -> 0, FontSize -> 14, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 1917040987], Cell[TextData[{"The transmission convention is", 
        "\[LineSeparator]", Cell[BoxData[FormBox[
           TagBox[RowBox[{SubscriptBox["T", RowBox[{"{", RowBox[{"p", ",", 
                   "q"}], "}"}]], "\[LongEqual]", RowBox[{"Tr", "[", 
                RowBox[{SubscriptBox["\[CapitalGamma]", "p"], ".", "G", ".", 
                  SubscriptBox["\[CapitalGamma]", "q"], ".", TemplateBox[
                   {"G"}, "ConjugateTranspose", SyntaxForm -> 
                    SuperscriptBox]}], "]"}]}], HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FontSize -> 14, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 341516211]}, Open]], 
