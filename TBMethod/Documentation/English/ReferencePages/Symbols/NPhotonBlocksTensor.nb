  Cell[CellGroupData[{Cell["NPhotonBlocksTensor", "ObjectName", 
      CellID -> 1465087534], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{RowBox[{ButtonBox["NPhotonBlocksTensor", 
               BaseStyle -> "Link", ButtonData -> 
                "paclet:TBMethod/ref/NPhotonBlocksTensor"], "[", 
              RowBox[{StyleBox["matrixModulation", "TI", FontFamily -> 
                  "Times", FontSlant -> "Italic"], ",", StyleBox["omega", 
                 "TI", FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                StyleBox["m", "TI", FontFamily -> "Times", FontSlant -> 
                  "Italic"]}], "]"}], "[", RowBox[{StyleBox["finalPoint", 
               "TI", FontFamily -> "Times", FontSlant -> "Italic"], ",", 
              StyleBox["initialPoint", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"]}], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", "constructs Floquet photon factors for a \
matrix-valued periodic modulation."}], "Usage", CellID -> 105936412], 
     Cell[TextData[{Cell[BoxData[StyleBox["matrixModulation", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " is a periodic \
matrix-valued function of a dimensionless angle. Its dimensions are inferred \
by evaluating ", Cell[BoxData[RowBox[{StyleBox["matrixModulation", "TI"], 
            "[", "0.123", "]"}]], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], "."}], "Notes", CellID -> 1228670679], 
     Cell[TextData[{"Returns two rank-4 tensors with axes ", 
        Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["internalRow", "TI"], ",", 
              StyleBox["internalColumn", "TI"], ",", StyleBox["photonRow", 
               "TI"], ",", StyleBox["photonColumn", "TI"]}], "}"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ". Photon indices run from ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{"-", "m"}], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], 
        " through ", Cell[BoxData[StyleBox["m", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 615513377], Cell[TextData[{"For distinct sites, the first \
tensor contains Fourier coefficients at ", 
        Cell[BoxData[RowBox[{StyleBox["columnIndex", "TI"], "-", 
            StyleBox["rowIndex", "TI"]}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " and the second is zero. For \
coincident sites, the first is the internal/photon identity tensor and the \
second includes the Fourier tensor and a diagonal photon-energy shift of ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{RowBox[{"-", "n"}], " ", 
              "\[Omega]"}], HoldForm], TraditionalForm]], "InlineMath", 
         ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], ", where ", 
        Cell[BoxData[FormBox[TagBox["n", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], " is the photon index."}], 
      "Notes", CellID -> 1983556313], 
     Cell[TextData[{"Coincidence is detected using a distance threshold of ", 
        Cell[BoxData["0.00001"], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], ". Combine the tensors with ", 
        Cell[BoxData[ButtonBox["PhotonDressTensor", BaseStyle -> "Link", 
           ButtonData -> "paclet:TBMethod/ref/PhotonDressTensor"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 1869727160], 
     Cell[TextData[{"Uses ", Cell[BoxData[ButtonBox["NIntegrate", 
           BaseStyle -> "Link", ButtonData -> "paclet:ref/NIntegrate"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " with ", 
        Cell[BoxData[RowBox[{ButtonBox["AccuracyGoal", BaseStyle -> "Link", 
             ButtonData -> "paclet:ref/AccuracyGoal"], "\[Rule]", "10"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " and ", 
        Cell[BoxData[RowBox[{ButtonBox["Method", BaseStyle -> "Link", 
             ButtonData -> "paclet:ref/Method"], "\[Rule]", 
            "\"LocalAdaptive\""}]], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], ". Other ", 
        Cell[BoxData[ButtonBox["NIntegrate", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/NIntegrate"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " options are accepted."}], 
      "Notes", CellID -> 1318089710]}, Open]], 
