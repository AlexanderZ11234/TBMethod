  Cell[CellGroupData[{Cell["HBloch", "ObjectName", CellID -> 366325748], 
     Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["HBloch", BaseStyle -> "Link", 
             ButtonData -> "paclet:TBMethod/ref/HBloch"], "[", 
            RowBox[{StyleBox["k", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", StyleBox["hoppingMatrices", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "constructs a Bloch \
Hamiltonian and add the Hermitian-conjugate reverse hoppings automatically."}]\
, "Usage", CellID -> 1888852741], 
     Cell[TextData[{Cell[BoxData[StyleBox["hoppingMatrices", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " must be an ", 
        Cell[BoxData[ButtonBox["Association", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Association"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " with numeric displacement-vector keys and ", 
        Cell[BoxData[ButtonBox["SparseArray", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/SparseArray"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " matrix values."}], "Notes", 
      CellID -> 1908614060], Cell[TextData[{"The first association entry is \
the onsite block and receives no phase factor. Supply one representative of \
each reverse-hopping pair among the remaining entries."}], "Notes", 
      CellID -> 833778179], Cell[TextData[{"The phase convention uses the \
negative displacement\[Dash]momentum dot product. Hermitian-conjugate reverse \
hoppings are added automatically, as shown in the formula below."}], "Notes", 
      CellID -> 1309970293], Cell[TextData[{"With one orientation supplied \
for each nonzero displacement, the convention is", "\[LineSeparator]", 
        Cell[BoxData[FormBox[TagBox[RowBox[{RowBox[{"H", "(", "k", ")"}], 
              "\[LongEqual]", RowBox[{SubscriptBox["H", "0"], "+", 
                RowBox[{UnderoverscriptBox["\[Sum]", RowBox[{"j", "=", "1"}], 
                   "M"], RowBox[{"(", RowBox[{RowBox[{RowBox[{"exp", "(", 
                          RowBox[{RowBox[{"-", "\[ImaginaryI]"}], " ", 
                          RowBox[{SubscriptBox["R", "j"], ".", "k"}]}], 
                          ")"}], " ", SubscriptBox["H", SubscriptBox["R", 
                          "j"]]}], "+", RowBox[{RowBox[{"exp", "(", RowBox[
                          {"\[ImaginaryI]", " ", RowBox[{SubscriptBox["R", 
                          "j"], ".", "k"}]}], ")"}], " ", TemplateBox[
                         {RowBox[{"(", SubscriptBox["H", SubscriptBox["R", 
                          "j"]], ")"}]}, "ConjugateTranspose", SyntaxForm -> 
                          SuperscriptBox]}]}], ")"}]}]}]}], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, FontSize -> 14, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 1669970690]}, Open]], 
