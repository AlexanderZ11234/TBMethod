                         FontSlant -> "Italic"], "1"], "\[Rule]", 
                       SubscriptBox[StyleBox["h", FontSlant -> "Italic"], 
                        "10"]}], ",", "...", ",", RowBox[{SubscriptBox[
                        StyleBox["a", FontWeight -> "Bold", FontSlant -> 
                          "Italic"], StyleBox["i", FontSlant -> "Italic"]], 
                       "\[Rule]", SubscriptBox[StyleBox["h", FontSlant -> 
                          "Italic"], StyleBox[RowBox[{StyleBox["i", 
                          FontSlant -> "Italic"], "0"}]]]}], ",", "..."}], 
                   "\[RightAssociation]"}]}], "]"}]], "InlineFormula", 
            ExpressionUUID -> "244f8092-e026-4012-b41d-7f290f0c4a7f"], 
           " constructs the reciprocal-space Bloch Hamiltonian matrix."}], 
         "ExampleText", CellChangeTimes -> {{3.849319340795717*^9, 
            3.8493195028596964*^9}, {3.849320480797045*^9, 
            3.8493204981724234*^9}}, CellID -> 153566697, 
         ExpressionUUID -> "257bba06-eb02-4d4d-b245-ae95dddb37eb"], 
        Cell[TextData[{"Vector ", Cell[BoxData[StyleBox["k", 
              FontWeight -> "Bold", FontSlant -> "Italic"]], "InlineFormula", 
            FormatType -> StandardForm, ExpressionUUID -> 
             "736d0795-aecb-454a-87b0-dbdd034376ad"], 
           " has the same dimension as those of lattice vectors ", 
           Cell[BoxData[SubscriptBox[StyleBox["a", FontWeight -> "Bold", 
               FontSlant -> "Italic"], "i"]], "InlineFormula", 
            FormatType -> StandardForm, ExpressionUUID -> 
             "465f55f6-fc0f-4121-b7bd-ba757ed20461"], "s."}], "ExampleText", 
         CellChangeTimes -> {{3.849319543904489*^9, 3.8493195980971284*^9}}, 
         CellID -> 80053754, ExpressionUUID -> 
          "7018c9af-1bad-48fd-8e83-222bd9347eae"], 
        Cell[TextData[{Cell[BoxData[RowBox[{SubscriptBox[StyleBox["a", 
                 FontWeight -> "Bold", FontSlant -> "Italic"], "0"], "=", 
               StyleBox["0", FontWeight -> "Bold"]}]], "InlineFormula", 
            FormatType -> StandardForm, ExpressionUUID -> 
             "4e43c169-201c-4f16-9706-02c27e6d79a8"], 
           " is the zero vector, and ", Cell[BoxData[SubscriptBox[
              StyleBox["h", FontSlant -> "Italic"], "00"]], "InlineFormula", 
            FormatType -> StandardForm, ExpressionUUID -> 
             "8a8b7f91-f8a2-4cd4-a924-b6ffbbfe14be"], 
           " is the Hermitian intra-primitive-cell hopping matrix."}], 
         "ExampleText", CellChangeTimes -> {{3.8493196169965253*^9, 
            3.849319695714407*^9}}, CellID -> 35926267, 
         ExpressionUUID -> "18c317ee-329b-431a-bb0b-be3bf85b8267"], 
        Cell[TextData[{Cell[BoxData[RowBox[{SubscriptBox[StyleBox["a", 
                 FontWeight -> "Bold", FontSlant -> "Italic"], StyleBox["i", 
                 FontSlant -> "Italic"]], RowBox[{"(", RowBox[
                  {StyleBox["i", FontSlant -> "Italic"], "\[NotEqual]", 
                   "0"}], ")"}]}]], "InlineFormula", ExpressionUUID -> 
             "8ddaca5d-adfd-4e2d-aa44-3f752fd1d9c4"], "s are the \
corresponding lattice vectors for neighbor cells, and the inter-cell hopping \
matrices ", Cell[BoxData[SubscriptBox[StyleBox["h", FontSlant -> "Italic"], 
              StyleBox[RowBox[{StyleBox["i", FontSlant -> "Italic"], 
                 "0"}]]]], "InlineFormula", ExpressionUUID -> 
             "6d6a2e22-745c-4046-8aca-754ac8882818"], 
           "s are usually non-Hermitian."}], "ExampleText", 
         CellChangeTimes -> {{3.8493197099481773*^9, 3.8493202609462337*^9}, 
           {3.885696813094784*^9, 3.885696813200449*^9}}, CellID -> 71249355, 
         ExpressionUUID -> "e8eafef3-934b-455a-97a2-389b498d1b39"], 
        Cell[TextData[{Cell[BoxData[RowBox[{SubscriptBox[StyleBox["a", 
                 FontWeight -> "Bold", FontSlant -> "Italic"], StyleBox["i", 
                 FontSlant -> "Italic"]], RowBox[{"(", RowBox[
                  {StyleBox["i", FontSlant -> "Italic"], "\[NotEqual]", 
                   "0"}], ")"}]}]], "InlineFormula", FormatType -> 
             StandardForm, ExpressionUUID -> 
             "3c4f7c45-2a4b-4239-8bb4-28100f51d011"], 
           "s can be divide into two groups so that for any ", 
           Cell[BoxData[SubscriptBox[StyleBox["a", FontWeight -> "Bold", 
               FontSlant -> "Italic"], StyleBox["i", FontSlant -> 
                "Italic"]]], "InlineFormula", FormatType -> StandardForm, 
            ExpressionUUID -> "aab82405-091f-4845-b651-3448fca4d599"], 
           " in one group, its addition inverse ", 
           Cell[BoxData[RowBox[{SubscriptBox[StyleBox["a", FontWeight -> 
                  "Bold", FontSlant -> "Italic"], RowBox[{StyleBox["i", 
                   FontSlant -> "Italic"], "'"}]], "=", RowBox[
                {"-", SubscriptBox[StyleBox["a", FontWeight -> "Bold", 
                   FontSlant -> "Italic"], StyleBox["i", FontSlant -> 
                    "Italic"]]}]}]], "InlineFormula", FormatType -> 
             StandardForm, ExpressionUUID -> 
             "0fbe8f88-d503-4fd5-ab5f-6c4ccceea731"], 
           " is in the other group. And for ", 
           Cell[BoxData[ButtonBox["HBloch", BaseStyle -> "Link", 
              ButtonData -> "paclet:TBMethod/ref/HBloch"]], "InlineFormula", 
            ExpressionUUID -> "9f9e5b2e-6cd7-4f6c-90f2-74d3e4491311"], 
           " only one of those two groups of ", 
           Cell[BoxData[SubscriptBox[StyleBox["a", FontWeight -> "Bold", 
               FontSlant -> "Italic"], StyleBox["i", FontSlant -> 
                "Italic"]]], "InlineFormula", FormatType -> StandardForm, 
            ExpressionUUID -> "89a6a5af-be07-41b7-bf4d-2f70d98aafc0"], "s \
should be included, because the constituents for the inverse vectors are to \
be automatically taken care of by ", ButtonBox["ConjugateTranspose", 
            BaseStyle -> "Link", ButtonData -> 
             "paclet:ref/ConjugateTranspose"], "."}], "ExampleText", 
         CellChangeTimes -> {{3.8493197099481773*^9, 3.849320272727532*^9}, 
           {3.849320383434455*^9, 3.849320385368745*^9}, 
