     Cell[CellGroupData[{Cell["Additional Examples", "ExampleSection", 
         CellID -> 1815369910], Cell[TextData[{Cell["   ", "ModInfo", 
            ExpressionUUID -> "2fd5c614-4ebe-49e0-a797-2c60e21bb0a9"], 
           Cell[BoxData[RowBox[{"HBloch", "[", RowBox[{StyleBox["k", 
                  FontWeight -> "Bold", FontSlant -> "Italic"], ",", " ", 
                 RowBox[{"\[LeftAssociation]", RowBox[{RowBox[{SubscriptBox[
                        StyleBox["a", FontWeight -> "Bold", FontSlant -> 
                          "Italic"], "0"], "\[Rule]", SubscriptBox[StyleBox[
                         "h", FontSlant -> "Italic"], "00"]}], ",", 
