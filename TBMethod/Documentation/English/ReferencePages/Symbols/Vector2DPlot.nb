  Cell[CellGroupData[{Cell["Vector2DPlot", "ObjectName", 
      CellID -> 290573934], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["Vector2DPlot", BaseStyle -> "Link", 
             ButtonData -> "paclet:TBMethod/ref/Vector2DPlot"], "[", 
            StyleBox["vectorData", "TI", FontFamily -> "Times", 
             FontSlant -> "Italic"], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", 
        "displays a two-dimensional vector field over a density background."}]\
, "Usage", CellID -> 602186402], 
     Cell[TextData[{"Wraps ", Cell[BoxData[ButtonBox["ListVectorDensityPlot", 
           BaseStyle -> "Link", ButtonData -> 
            "paclet:ref/ListVectorDensityPlot"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " and forwards its options."}], 
      "Notes", CellID -> 1847046254], 
     Cell[TextData[{"The default styling includes ", 
        Cell[BoxData[RowBox[{ButtonBox["VectorScaling", BaseStyle -> "Link", 
             ButtonData -> "paclet:ref/VectorScaling"], "\[Rule]", 
            "\"Log\""}]], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ", ", Cell[BoxData[RowBox[{ButtonBox["VectorMarkers", 
             BaseStyle -> "Link", ButtonData -> "paclet:ref/VectorMarkers"], 
            "\[Rule]", "\"PinDart\""}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], ", and ", 
        Cell[BoxData[RowBox[{ButtonBox["ColorFunction", BaseStyle -> "Link", 
             ButtonData -> "paclet:ref/ColorFunction"], "\[Rule]", 
            "\"SunsetColors\""}]], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], "."}], "Notes", CellID -> 1606361636], 
     Cell[TextData[{"For explicit coordinates, use pairs of the form ", 
        Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"{", RowBox[
                 {StyleBox["x", "TI"], ",", StyleBox["y", "TI"]}], "}"}], 
              ",", RowBox[{"{", RowBox[{StyleBox["vx", "TI"], ",", 
                  StyleBox["vy", "TI"]}], "}"}]}], "}"}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], ", compatible with ", 
        Cell[BoxData[ButtonBox["ListVectorDensityPlot", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/ListVectorDensityPlot"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 236066917]}, Open]], 
