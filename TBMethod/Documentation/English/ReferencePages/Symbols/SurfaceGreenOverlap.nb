           ButtonData -> "paclet:TBMethod/ref/SurfaceGreen"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 499599101], Cell[TextData[{"The nonorthogonal lead satisfies \
the corresponding surface resolvent equation", "\[LineSeparator]", 
        Cell[BoxData[FormBox[TagBox[RowBox[{RowBox[{SubscriptBox["g", "s"], 
                "(", "z", ")"}], "\[LongEqual]", TemplateBox[{RowBox[
                 {"(", RowBox[{RowBox[{"z", " ", SubscriptBox["s", "0"]}], 
                    "-", SubscriptBox["h", "0"], "-", RowBox[{RowBox[
                       {"(", RowBox[{SubscriptBox["h", "1"], "-", RowBox[
                          {"z", " ", SubscriptBox["s", "1"]}]}], ")"}], ".", 
                      RowBox[{SubscriptBox["g", "s"], "(", "z", ")"}], ".", 
                      RowBox[{"(", RowBox[{TemplateBox[{RowBox[{"(", 
                          SubscriptBox["h", "1"], ")"}]}, 
                          "ConjugateTranspose", SyntaxForm -> 
                          SuperscriptBox], "-", RowBox[{"z", " ", TemplateBox[
                          {RowBox[{"(", SubscriptBox["s", "1"], ")"}]}, 
                          "ConjugateTranspose", SyntaxForm -> 
                          SuperscriptBox]}]}], ")"}]}]}], ")"}]}, "Inverse", 
               SyntaxForm -> SuperscriptBox]}], HoldForm], TraditionalForm]], 
