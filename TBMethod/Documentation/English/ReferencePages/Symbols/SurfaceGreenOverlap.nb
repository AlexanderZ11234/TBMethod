        Cell[BoxData[StyleBox["s0", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], " and ", 
        Cell[BoxData[StyleBox["s1", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], ".", "\n", 
        Cell["   ", "ModInfo"], Cell[BoxData[
