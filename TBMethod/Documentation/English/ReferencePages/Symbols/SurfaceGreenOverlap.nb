             ButtonData -> "paclet:TBMethod/ref/SurfaceGreenOverlap"], "[", 
            RowBox[{StyleBox["z", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[
                     {StyleBox["h0", "TI", FontFamily -> "Times", 
                       FontSlant -> "Italic"], ",", StyleBox["h1", "TI", 
                       FontFamily -> "Times", FontSlant -> "Italic"]}], 
                    "}"}], ",", RowBox[{"{", RowBox[{StyleBox["s0", "TI", 
                       FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                      StyleBox["s1", "TI", FontFamily -> "Times", 
                       FontSlant -> "Italic"]}], "}"}]}], "}"}], ",", 
              StyleBox["mode", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"]}], "]"}]], "InlineFormula"], " \[LineSeparator]", 
        "uses the specified surface-Green algorithm."}], "Usage", 
      CellID -> 610620466], 
     Cell[TextData[{Cell[BoxData[StyleBox["s0", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " and ", 
        Cell[BoxData[StyleBox["s1", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " are the onsite and interlayer overlap blocks, matching ", 
        Cell[BoxData[StyleBox["h0", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " and ", 
        Cell[BoxData[StyleBox["h1", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " in size."}], "Notes", 
      CellID -> 1847050706], Cell[TextData[{"The energy-dependent upper and \
lower transformed hoppings are retained separately at complex energy. The \
upper coupling is not formed by conjugating the already transformed lower \
coupling."}], "Notes", CellID -> 108704371], 
     Cell[TextData[{"The default ", Cell[BoxData[StyleBox["mode", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " is ", 
        Cell[BoxData["3"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ". Algorithms and the singular-value regularization option follow ", 
