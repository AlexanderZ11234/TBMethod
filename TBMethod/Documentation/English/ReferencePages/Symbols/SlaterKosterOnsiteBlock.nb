  Cell[CellGroupData[{Cell["SlaterKosterOnsiteBlock", "ObjectName", 
      CellID -> 202125671], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{RowBox[{ButtonBox["SlaterKosterOnsiteBlock", 
               BaseStyle -> "Link", ButtonData -> 
                "paclet:TBMethod/ref/SlaterKosterOnsiteBlock"], "[", 
              "\"sp\"", "]"}], "[", RowBox[{"{", RowBox[{StyleBox["sEnergy", 
                 "TI", FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                StyleBox["pEnergy", "TI", FontFamily -> "Times", FontSlant -> 
                  "Italic"]}], "}"}], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", 
        "constructs the onsite block for one s orbital and three p orbitals."\
, "\n", Cell["   ", "ModInfo"], Cell[BoxData[
          RowBox[{RowBox[{ButtonBox["SlaterKosterOnsiteBlock", BaseStyle -> 
                "Link", ButtonData -> 
                "paclet:TBMethod/ref/SlaterKosterOnsiteBlock"], "[", 
              "\"spd\"", "]"}], "[", RowBox[{"{", RowBox[{StyleBox["sEnergy", 
                 "TI", FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                StyleBox["pEnergy", "TI", FontFamily -> "Times", FontSlant -> 
                  "Italic"], ",", StyleBox["dEnergy", "TI", FontFamily -> 
                  "Times", FontSlant -> "Italic"]}], "}"}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", 
        "includes the five d orbitals."}], "Usage", CellID -> 847009473], 
     Cell[TextData[{"The ", Cell[BoxData["\"sp\""], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " block uses the ordered orbitals ", 
        Cell[BoxData[FormBox[TagBox["s", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], ", ", 
        Cell[BoxData[FormBox[TagBox[SubscriptBox["p", "x"], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], ", ", 
        Cell[BoxData[FormBox[TagBox[SubscriptBox["p", "y"], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], ", ", 
        Cell[BoxData[FormBox[TagBox[SubscriptBox["p", "z"], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], 
        " and has dimension ", Cell[BoxData["4"], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], ". The ", Cell[BoxData["\"spd\""], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " block appends five d orbitals and has dimension ", 
        Cell[BoxData["9"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        "."}], "Notes", CellID -> 918559893], 
     Cell[TextData[
       {"The d-orbital order used by the companion hopping implementation is \
", Cell[BoxData[FormBox[TagBox[SubscriptBox["d", RowBox[{"x", " ", "y"}]], 
            HoldForm], TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], ", ", 
        Cell[BoxData[FormBox[TagBox[SubscriptBox["d", 
             RowBox[{"y", " ", "z"}]], HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], ", ", 
        Cell[BoxData[FormBox[TagBox[SubscriptBox["d", 
             RowBox[{"z", " ", "x"}]], HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], ", ", 
        Cell[BoxData[FormBox[TagBox[SubscriptBox["d", 
             RowBox[{SuperscriptBox["x", "2"], "-", SuperscriptBox["y", 
                "2"]}]], HoldForm], TraditionalForm]], "InlineMath", 
         ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], ", and ", 
        Cell[BoxData[FormBox[TagBox[SubscriptBox["d", 
             RowBox[{RowBox[{"3", " ", SuperscriptBox["z", "2"]}], "-", 
               SuperscriptBox["r", "2"]}]], HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], ". Every orbital within a shell \
receives the same supplied onsite energy."}], "Notes", CellID -> 180934810], 
     Cell[TextData[{"These blocks contain orbital energies only. Add spin \
degrees of freedom and spin\[Dash]orbit coupling separately when required."}]\
, "Notes", CellID -> 788329342]}, Open]], 
