  Cell[CellGroupData[{Cell["BandDataWithWeight", "ObjectName", 
      CellID -> 665386840], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["BandDataWithWeight", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/BandDataWithWeight"], "[", 
            RowBox[{StyleBox["h", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", StyleBox["samples", "TI", FontFamily -> 
                "Times", FontSlant -> "Italic"]}], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", 
        "pairs each energy with a state weight at each sample.", "\n", 
        Cell["   ", "ModInfo"], Cell[BoxData[
          RowBox[{ButtonBox["BandDataWithWeight", BaseStyle -> "Link", 
             ButtonData -> "paclet:TBMethod/ref/BandDataWithWeight"], "[", 
            RowBox[{StyleBox["h", "TI", FontFamily -> "Times", FontSlant -> 
