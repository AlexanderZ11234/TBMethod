               FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "retains ", 
        Cell[BoxData[StyleBox["n", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], 
        " selected eigenpairs at each sample."}], "Usage", 
      CellID -> 1145250093], Cell[TextData[{"The string option ", 
        Cell[BoxData["\"StateFunction\""], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " defaults to ", 
        Cell[BoxData[RowBox[{RowBox[{ButtonBox["Total", BaseStyle -> "Link", 
               ButtonData -> "paclet:ref/Total"], "[", SuperscriptBox[RowBox[
                {ButtonBox["Abs", BaseStyle -> "Link", ButtonData -> 
                   "paclet:ref/Abs"], "[", "#1", "]"}], "4"], "]"}], "&"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ", the inverse participation ratio of a normalized state."}], 
      "Notes", CellID -> 1337439450], 
     Cell[TextData[{Cell[BoxData["\"StateFunction\""], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " must be an anonymous ", 
        Cell[BoxData[ButtonBox["Function", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Function"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " or a nonempty list of anonymous functions, matching ", 
        Cell[BoxData["_Function"], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], " or ", 
        Cell[BoxData[RowBox[{"{", "__Function", "}"}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        ". Named functions do not match these implementation checks."}], 
      "Notes", CellID -> 1068202585], 
     Cell[TextData[
       {"With one state function, the output is grouped by sample and \
contains ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["energy", "TI"], ",", 
              StyleBox["weight", "TI"]}], "}"}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " pairs. With several functions, \
the outer index selects the state function."}], "Notes", 
      CellID -> 1226759553], Cell[TextData[{"Omitting ", 
        Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " requests the matrix dimension. Options for ", 
        Cell[BoxData[ButtonBox["Eigensystem", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Eigensystem"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " are filtered and passed through; the implementation supplies ", 
        Cell[BoxData[RowBox[{ButtonBox["Method", BaseStyle -> "Link", 
             ButtonData -> "paclet:ref/Method"], "\[Rule]", 
            RowBox[{"{", RowBox[{"\"Arnoldi\"", ",", RowBox[
                 {"\"MaxIterations\"", "\[Rule]", "\[Infinity]"}]}], 
              "}"}]}]], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        "."}], "Notes", CellID -> 749399711], 
     Cell[TextData[{"For a small full-spectrum calculation, use ", 
        Cell[BoxData[RowBox[{ButtonBox["Method", BaseStyle -> "Link", 
             ButtonData -> "paclet:ref/Method"], "\[Rule]", "\"Direct\""}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " to avoid \
requesting the complete spectrum from the default Arnoldi solver."}], 
      "Notes", CellID -> 544592705], 
     Cell[TextData[{"For a normalized eigenstate, the default weight is its \
inverse participation ratio:", "\[LineSeparator]", 
        Cell[BoxData[FormBox[TagBox[RowBox[{RowBox[{"IPR", "(", "\[Psi]", 
                ")"}], "\[LongEqual]", RowBox[{UnderoverscriptBox["\[Sum]", 
                 RowBox[{"a", "=", "1"}], "d"], SuperscriptBox[TemplateBox[
                  {SubscriptBox["\[Psi]", "a"]}, "Abs"], "4"]}]}], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, FontSize -> 14, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 666836071]}, Open]], 
