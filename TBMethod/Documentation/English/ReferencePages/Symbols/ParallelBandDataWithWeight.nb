        " selected eigenpairs at each sample."}], "Usage", 
      CellID -> 1894242271], Cell[TextData[{"Follows ", 
        Cell[BoxData[ButtonBox["BandDataWithWeight", BaseStyle -> "Link", 
           ButtonData -> "paclet:TBMethod/ref/BandDataWithWeight"]], 
