  Cell[CellGroupData[{Cell["HallAndLongitudinalConductances", "ObjectName", 
      CellID -> 214647366], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["HallAndLongitudinalConductances", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/HallAndLongitudinalConductances"], "[", 
            RowBox[{StyleBox["z", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", StyleBox["deviceBlocks", "TI", FontFamily -> 
                "Times", FontSlant -> "Italic"], ",", StyleBox["leadBlocks", 
               "TI", FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "converts the supported \
device Hall and longitudinal resistances into conductances."}], "Usage", 
      CellID -> 206770004], 
     Cell[TextData[{"Uses ", Cell[BoxData[ButtonBox[
           "HallAndLongitudinalResistances", BaseStyle -> "Link", 
           ButtonData -> 
            "paclet:TBMethod/ref/HallAndLongitudinalResistances"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " with the same lead ordering and options."}], "Notes", 
      CellID -> 1577296851], 
     Cell[TextData[{"No additional conductance-unit factor is applied."}], 
      "Notes", CellID -> 246974084], 
     Cell[TextData[{"The same ", Cell[BoxData[ButtonBox["LUDecomposition", 
           BaseStyle -> "Link", ButtonData -> "paclet:ref/LUDecomposition"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " compatibility limitation as in ", 
        Cell[BoxData[ButtonBox["HallAndLongitudinalResistances", 
           BaseStyle -> "Link", ButtonData -> 
            "paclet:TBMethod/ref/HallAndLongitudinalResistances"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " applies. Zero \
or nonnumeric resistance pairs cannot be converted meaningfully."}], "Notes", 
      CellID -> 1165545688], 
     Cell[TextData[{"The conversion applied to the resistance pair is", 
        "\[LineSeparator]", Cell[BoxData[FormBox[
           TagBox[RowBox[{RowBox[{"{", RowBox[{SubscriptBox["\[Sigma]", 
                   "xy"], ",", SubscriptBox["\[Sigma]", "xx"]}], "}"}], 
              "\[LongEqual]", FractionBox[RowBox[{"{", RowBox[
                  {RowBox[{"-", SubscriptBox["R", "H"]}], ",", SubscriptBox[
                    "R", "L"]}], "}"}], RowBox[{SubsuperscriptBox["R", "H", 
                  "2"], "+", SubsuperscriptBox["R", "L", "2"]}]]}], 
            HoldForm], TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FontSize -> 14, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 1303169301]}, Open]], 
  Cell[CellGroupData[{Cell["Examples", "PrimaryExamplesSection", 
      CellID -> 1642823728], 
     Cell[TextData[
       {"Check the conversion identity on a five-contact ring fixture."}], 
      "ExampleText", CellID -> 547228601], 
     Cell[BoxData[RowBox[{"Needs", "[", "\"TBMethod`\"", "]"}]], "Input", 
      CellID -> 591556759], Cell[CellGroupData[
       {Cell[BoxData[RowBox[{RowBox[{"z", "=", RowBox[{RowBox[{"0.2", 
                  "\[VeryThinSpace]"}], "+", RowBox[{"0.01", " ", 
                  "\[ImaginaryI]"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"hRing", "=", RowBox[{"Table", "[", RowBox[
                 {RowBox[{"Which", "[", RowBox[{RowBox[{RowBox[{"Mod", "[", 
                          RowBox[{RowBox[{"i", "-", "j"}], ",", "5"}], "]"}], 
                        "\[Equal]", "1"}], ",", RowBox[{"-", RowBox[{"Exp", 
                          "[", RowBox[{"0.2", " ", "\[ImaginaryI]"}], 
                          "]"}]}], ",", RowBox[{RowBox[{"Mod", "[", RowBox[
                          {RowBox[{"j", "-", "i"}], ",", "5"}], "]"}], 
                        "\[Equal]", "1"}], ",", RowBox[{"-", RowBox[{"Exp", 
                          "[", RowBox[{RowBox[{"-", "0.2"}], " ", 
                          "\[ImaginaryI]"}], "]"}]}], ",", "True", ",", 
                      "0."}], "]"}], ",", RowBox[{"{", RowBox[{"i", ",", 
                      "5"}], "}"}], ",", RowBox[{"{", RowBox[{"j", ",", 
                      "5"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"blocks", "=", RowBox[{"{", RowBox[{RowBox[{"{", 
                    RowBox[{"hRing", ",", "hRing"}], "}"}], ",", 
                  RowBox[{"{", RowBox[{RowBox[{"-", "0.3"}], " ", RowBox[
                       {"IdentityMatrix", "[", "5", "]"}]}], "}"}]}], 
                "}"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"leads", "=", RowBox[{"Table", "[", RowBox[
                 {RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"{", "0.", "}"}], 
                        "}"}], ",", RowBox[{"{", RowBox[{"{", RowBox[{"-", 
                          "1."}], "}"}], "}"}], ",", RowBox[{"List", "/@", 
                        RowBox[{"(", RowBox[{RowBox[{"-", "0.5"}], " ", 
                          RowBox[{"UnitVector", "[", RowBox[{"5", ",", "j"}], 
                          "]"}]}], ")"}]}]}], "}"}], ",", RowBox[
                   {"{", RowBox[{"j", ",", "5"}], "}"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", RowBox[{"r", "=", RowBox[{
                "HallAndLongitudinalResistances", "[", RowBox[{"z", ",", 
                  "blocks", ",", "leads", ",", RowBox[{"\"SigmaMode\"", 
                    "\[Rule]", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"HallAndLongitudinalConductances", "[", RowBox[{"z", ",", 
                "blocks", ",", "leads", ",", RowBox[{"\"SigmaMode\"", 
                  "\[Rule]", "1"}]}], "]"}]}]], "Input", 
