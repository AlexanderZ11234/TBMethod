  Cell[CellGroupData[{Cell["HCSRBlocksAndersonDisordered", "ObjectName", 
      CellID -> 157670012], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{RowBox[{RowBox[{ButtonBox[
                 "HCSRBlocksAndersonDisordered", BaseStyle -> "Link", 
                 ButtonData -> 
                  "paclet:TBMethod/ref/HCSRBlocksAndersonDisordered"], "[", 
                StyleBox["n", "TI", FontFamily -> "Times", FontSlant -> 
                  "Italic"], "]"}], "[", RowBox[{StyleBox["width", "TI", 
                 FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                StyleBox["internalMatrix", "TI", FontFamily -> "Times", 
                 FontSlant -> "Italic"]}], "]"}], "[", 
            RowBox[{"{", RowBox[{StyleBox["diagonalBlocks", "TI", 
                 FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                StyleBox["lowerBlocks", "TI", FontFamily -> "Times", 
                 FontSlant -> "Italic"]}], "}"}], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", "generates ", 
        Cell[BoxData[StyleBox["n", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], " realizations of \
independent onsite Anderson disorder in the specified internal channel.", 
        "\n", Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{RowBox[{RowBox[{ButtonBox[
                 "HCSRBlocksAndersonDisordered", BaseStyle -> "Link", 
                 ButtonData -> 
                  "paclet:TBMethod/ref/HCSRBlocksAndersonDisordered"], "[", 
                StyleBox["n", "TI", FontFamily -> "Times", FontSlant -> 
                  "Italic"], "]"}], "[", RowBox[{StyleBox["widths", "TI", 
                 FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                StyleBox["internalMatrices", "TI", FontFamily -> "Times", 
                 FontSlant -> "Italic"]}], "]"}], "[", 
            RowBox[{"{", RowBox[{StyleBox["diagonalBlocks", "TI", 
                 FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                StyleBox["lowerBlocks", "TI", FontFamily -> "Times", 
                 FontSlant -> "Italic"]}], "}"}], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", "combines independently sampled disorder \
channels with the corresponding widths and internal matrices."}], "Usage", 
      CellID -> 1250182390], Cell[TextData[{"Returns a list of ", 
        Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " scattering-region block pairs; ", 
        Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " defaults to ", 
        Cell[BoxData["1"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ". The input representation requires nonempty diagonal- and \
lower-block lists."}], "Notes", CellID -> 1400439078], 
     Cell[TextData[{"Each disorder channel adds ", 
        Cell[BoxData[RowBox[{ButtonBox["KroneckerProduct", BaseStyle -> 
              "Link", ButtonData -> "paclet:ref/KroneckerProduct"], "[", 
            RowBox[{StyleBox["siteDiagonalRandomMatrix", "TI"], ",", 
              StyleBox["internalMatrix", "TI"]}], "]"}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " to every diagonal block. Site \
amplitudes are independently sampled from the continuous uniform distribution \
specified by ", Cell[BoxData[RowBox[{ButtonBox["RandomReal", 
             BaseStyle -> "Link", ButtonData -> "paclet:ref/RandomReal"], 
            "[", RowBox[{"{", RowBox[{RowBox[{"-", FractionBox[StyleBox[
                    "width", "TI"], "2"]}], ",", FractionBox[StyleBox[
                  "width", "TI"], "2"]}], "}"}], "]"}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        ". Lower off-diagonal blocks are preserved."}], "Notes", 
      CellID -> 810674417], Cell[TextData[{"For several channels, ", 
        Cell[BoxData[StyleBox["widths", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " and ", 
        Cell[BoxData[StyleBox["internalMatrices", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " must have the same length. All \
internal matrices should have the same dimension compatible with the site \
ordering."}], "Notes", CellID -> 1262669055], 
     Cell[TextData[{"Set ", Cell[BoxData[ButtonBox["SeedRandom", 
           BaseStyle -> "Link", ButtonData -> "paclet:ref/SeedRandom"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ", optionally inside ", Cell[BoxData[ButtonBox["BlockRandom", 
           BaseStyle -> "Link", ButtonData -> "paclet:ref/BlockRandom"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ", when reproducible disorder examples or tests are needed."}], 
      "Notes", CellID -> 1991790482]}, Open]], 
