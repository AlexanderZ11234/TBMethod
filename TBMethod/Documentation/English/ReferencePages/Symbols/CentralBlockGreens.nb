  Cell[CellGroupData[{Cell["CentralBlockGreens", "ObjectName", 
      CellID -> 376056468], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["CentralBlockGreens", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/CentralBlockGreens"], "[", 
            RowBox[{StyleBox["z", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", RowBox[{"{", RowBox[{StyleBox[
                   "diagonalBlocks", "TI", FontFamily -> "Times", 
                   FontSlant -> "Italic"], ",", StyleBox["lowerBlocks", "TI", 
                   FontFamily -> "Times", FontSlant -> "Italic"]}], "}"}], 
              ",", StyleBox["sigmas", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"]}], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", "computes the final contact block of the Green \
matrix of a layered device.", "\n", Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["CentralBlockGreens", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/CentralBlockGreens"], "[", 
            RowBox[{StyleBox["z", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", RowBox[{"{", RowBox[{StyleBox[
                   "diagonalBlocks", "TI", FontFamily -> "Times", 
                   FontSlant -> "Italic"], ",", StyleBox["lowerBlocks", "TI", 
                   FontFamily -> "Times", FontSlant -> "Italic"]}], "}"}], 
              ",", StyleBox["sigmas", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["mode", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", 
        "returns the contact block or the final block column according to ", 
        Cell[BoxData[StyleBox["mode", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], ".", "\n", 
        Cell["   ", "ModInfo"], Cell[BoxData[
          RowBox[{ButtonBox["CentralBlockGreens", BaseStyle -> "Link", 
             ButtonData -> "paclet:TBMethod/ref/CentralBlockGreens"], "[", 
            RowBox[{StyleBox["z", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", RowBox[{"{", RowBox[{StyleBox[
                   "diagonalBlocks", "TI", FontFamily -> "Times", 
                   FontSlant -> "Italic"], ",", StyleBox["lowerBlocks", "TI", 
                   FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                  StyleBox["upperBlocks", "TI", FontFamily -> "Times", 
                   FontSlant -> "Italic"]}], "}"}], ",", StyleBox["sigmas", 
               "TI", FontFamily -> "Times", FontSlant -> "Italic"], ",", 
              StyleBox["mode", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"]}], "]"}]], "InlineFormula"], " \[LineSeparator]", 
        "uses explicitly supplied upper off-diagonal blocks."}], "Usage", 
      CellID -> 1115856493], Cell[TextData[{"The block lists must satisfy ", 
        Cell[BoxData[RowBox[{RowBox[{ButtonBox["Length", BaseStyle -> "Link", 
               ButtonData -> "paclet:ref/Length"], "[", StyleBox[
               "lowerBlocks", "TI"], "]"}], "\[Equal]", 
            RowBox[{RowBox[{ButtonBox["Length", BaseStyle -> "Link", 
                 ButtonData -> "paclet:ref/Length"], "[", StyleBox[
                 "diagonalBlocks", "TI"], "]"}], "-", "1"}]}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ". Every self-energy acts on the last layer."}], "Notes", 
      CellID -> 301038039], Cell[TextData[{"The default ", 
        Cell[BoxData[StyleBox["mode", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " is ", Cell[BoxData["\"T\""], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ", which returns only the last diagonal Green block."}], "Notes", 
      CellID -> 1791639270], 
     Cell[TextData[{"Modes ", Cell[BoxData["\"LDOS\""], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " and ", Cell[BoxData["\"LCDV\""], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " return the \
final block column in reverse layer order, beginning with its last diagonal \
block."}], "Notes", CellID -> 612920964], 
     Cell[TextData[{"When ", Cell[BoxData[StyleBox["upperBlocks", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " is omitted, the upper off-diagonal blocks are ", 
        Cell[BoxData[RowBox[{ButtonBox["ConjugateTranspose", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:ref/ConjugateTranspose"], "/@", StyleBox["lowerBlocks", 
             "TI"]}]], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        "."}], "Notes", CellID -> 229708614], 
     Cell[TextData[{"Let ", Cell[BoxData[FormBox[TagBox["D", HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], " denote \
the diagonal block of the inverse Green matrix, including contact \
self-energies only on the final layer:", "\[LineSeparator]", 
        Cell[BoxData[FormBox[TagBox[RowBox[{SubscriptBox["D", "j"], 
              "\[LongEqual]", RowBox[{RowBox[{"z", " ", 
                  "\[DoubleStruckCapitalI]"}], "-", SubscriptBox["H", 
                 RowBox[{"{", RowBox[{"j", ",", "j"}], "}"}]], "-", 
                RowBox[{TemplateBox[{RowBox[{"j", ",", "N"}]}, 
                   "KroneckerDeltaSeq"], " ", RowBox[{UnderoverscriptBox[
                     "\[Sum]", RowBox[{"p", "=", "1"}], SubscriptBox["N", 
                      "L"]], SubscriptBox["\[CapitalSigma]", "p"]}]}]}]}], 
            HoldForm], TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FontSize -> 14, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 1628977580], 
     Cell[TextData[
       {"The forward recursion for the left-connected Green blocks is", 
        "\[LineSeparator]", Cell[BoxData[FormBox[
           TagBox[RowBox[{SubscriptBox["F", "j"], "\[LongEqual]", 
              TemplateBox[{RowBox[{"(", RowBox[{SubscriptBox["D", "j"], "-", 
                    RowBox[{SubscriptBox["H", RowBox[{"{", RowBox[{"j", ",", 
                          RowBox[{"j", "-", "1"}]}], "}"}]], ".", 
                      SubscriptBox["F", RowBox[{"j", "-", "1"}]], ".", 
                      SubscriptBox["H", RowBox[{"{", RowBox[{RowBox[{"j", 
                          "-", "1"}], ",", "j"}], "}"}]]}]}], ")"}]}, 
               "Inverse", SyntaxForm -> SuperscriptBox]}], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, FontSize -> 14, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 1293772939]}, Open]], 
