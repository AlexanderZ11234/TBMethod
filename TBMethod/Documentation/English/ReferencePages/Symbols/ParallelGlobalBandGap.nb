                 {SubscriptBox["\[ExponentialE]", RowBox[{"n", "+", "1"}]], 
                  "(", "k", ")"}], ")"}], "-", RowBox[{SubscriptBox["Max", 
                 RowBox[{"k", "\[Element]", "\[ScriptCapitalK]"}]], "(", 
                RowBox[{SubscriptBox["\[ExponentialE]", "n"], "(", "k", 
                  ")"}], ")"}]}], HoldForm], TraditionalForm]], "InlineMath", 
