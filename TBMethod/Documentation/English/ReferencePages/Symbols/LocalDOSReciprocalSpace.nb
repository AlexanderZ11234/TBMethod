        Cell[BoxData[FormBox[FractionBox["1", SuperscriptBox["10", "4"]], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], "."}], 
      "Notes", CellID -> 646883894], 
     Cell[TextData[{"The internal projector is applied to each site-diagonal \
Green block, and the contributions are summed over device sites."}], "Notes", 
      CellID -> 1496710216], Cell[TextData[{"The shortest form uses the lead \
onsite block as the device Hamiltonian."}], "Notes", CellID -> 191698548], 
     Cell[TextData[{"The default ", Cell[BoxData[StyleBox["mode", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " is ", 
        Cell[BoxData["3"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        "; only ", Cell[BoxData["1"], "InlineFormula", 
