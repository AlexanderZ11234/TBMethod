         "InlineFormula", FontFamily -> "Source Sans Pro"], ", and ", 
        Cell[BoxData["3"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " are accepted by this wrapper."}], "Notes", CellID -> 1025210888], 
     Cell[TextData[
       {"The projected spectral density, summed over the device sites, is", 
        "\[LineSeparator]", Cell[BoxData[FormBox[
           TagBox[RowBox[{RowBox[{SubscriptBox["\[Rho]", "P"], "(", 
                "\[Epsilon]", ")"}], "\[LongEqual]", RowBox[{"-", 
                FractionBox[RowBox[{"Im", "(", RowBox[{UnderoverscriptBox[
                      "\[Sum]", RowBox[{"a", "=", "1"}], SubscriptBox["N", 
                       "S"]], RowBox[{"Tr", "[", RowBox[{"P", ".", RowBox[
                          {SubscriptBox["G", RowBox[{"{", RowBox[{"a", ",", 
                          "a"}], "}"}]], "(", RowBox[{"\[Epsilon]", "+", 
                          RowBox[{"\[ImaginaryI]", " ", "\[Eta]"}]}], 
                          ")"}]}], "]"}]}], ")"}], "\[Pi]"]}]}], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, FontSize -> 14, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 273300904]}, Open]], 
