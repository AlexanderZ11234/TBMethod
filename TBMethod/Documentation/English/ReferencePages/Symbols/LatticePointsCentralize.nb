  Cell[CellGroupData[{Cell["LatticePointsCentralize", "ObjectName", 
      CellID -> 320911026], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["LatticePointsCentralize", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/LatticePointsCentralize"], "[", 
            StyleBox["points", "TI", FontFamily -> "Times", 
             FontSlant -> "Italic"], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", "translate a set of atomic coordinates so that \
its arithmetic centroid is the origin."}], "Usage", CellID -> 1292467788], 
     Cell[TextData[{"The shift uses the arithmetic mean of the coordinates, \
with equal weight for every supplied site."}], "Notes", 
      CellID -> 1824594074], 
     Cell[TextData[
       {"Accepts a list of coordinate lists or labeled coordinate ", 
        Cell[BoxData[ButtonBox["Rule", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Rule"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " expressions. Rule labels are preserved."}], "Notes", 
      CellID -> 434557377], 
     Cell[TextData[{"The site centroid is shifted to the origin:", 
        "\[LineSeparator]", Cell[BoxData[FormBox[
           TagBox[RowBox[{SuperscriptBox[SubscriptBox["r", "j"], "\[Prime]", 
               MultilineFunction -> None], "\[LongEqual]", 
              RowBox[{SubscriptBox["r", "j"], "-", FractionBox[RowBox[
                  {UnderoverscriptBox["\[Sum]", RowBox[{"i", "=", "1"}], 
                    "N"], SubscriptBox["r", "i"]}], "N"]}]}], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, FontSize -> 14, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 816018165]}, Open]], 
