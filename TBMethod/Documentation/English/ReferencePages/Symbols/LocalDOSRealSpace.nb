  Cell[CellGroupData[{Cell["LocalDOSRealSpace", "ObjectName", 
      CellID -> 1164528286], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{RowBox[{ButtonBox["LocalDOSRealSpace", 
               BaseStyle -> "Link", ButtonData -> 
                "paclet:TBMethod/ref/LocalDOSRealSpace"], "[", 
              RowBox[{StyleBox["projection", "TI", FontFamily -> "Times", 
                 FontSlant -> "Italic"], ",", StyleBox["layeredPoints", "TI", 
                 FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}], "[", 
            RowBox[{StyleBox["lastColumnGreens", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["sigmas", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "computes contact-induced \
local spectral density at the sites of a layered device."}], "Usage", 
      CellID -> 1436998157], 
     Cell[TextData[{Cell[BoxData[StyleBox["projection", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " acts on each \
site's internal degrees of freedom, such as spin. Use ", 
        Cell[BoxData[RowBox[{"{", RowBox[{"{", "1.", "}"}], "}"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " for one scalar orbital."}], "Notes", CellID -> 1672080127], 
     Cell[TextData[{Cell[BoxData[StyleBox["lastColumnGreens", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " is the reverse-ordered final block column returned by ", 
        Cell[BoxData[ButtonBox["CentralBlockGreens", BaseStyle -> "Link", 
           ButtonData -> "paclet:TBMethod/ref/CentralBlockGreens"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " in ", 
        Cell[BoxData["\"LDOS\""], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], " mode."}], "Notes", CellID -> 1451184590], 
     Cell[TextData[{Cell[BoxData[StyleBox["layeredPoints", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " is an ", 
        Cell[BoxData[ButtonBox["Association", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Association"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " of layer keys to site \
coordinates in original layer order. The result appends a density to each \
coordinate."}], "Notes", CellID -> 1098559863], 
     Cell[TextData[{"The broadening matrix is formed from the sum of the \
supplied contacts. At finite artificial broadening, this contact-induced \
density need not equal the full density from the imaginary part of the \
retarded resolvent."}], "Notes", CellID -> 434940544], 
     Cell[TextData[{"For site block ", 
        Cell[BoxData[FormBox[TagBox["a", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], " and internal projector ", 
        Cell[BoxData[FormBox[TagBox["P", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], 
        ", the contact-induced density is", "\[LineSeparator]", 
        Cell[BoxData[FormBox[TagBox[RowBox[{SubscriptBox["\[Rho]", "a"], 
              "\[LongEqual]", FractionBox[RowBox[{"Tr", "[", RowBox[
                  {"P", ".", RowBox[{"(", SubscriptBox[RowBox[{"G", ".", 
                        "\[CapitalGamma]", ".", TemplateBox[{"G"}, 
                         "ConjugateTranspose", SyntaxForm -> 
                          SuperscriptBox]}], RowBox[{"{", RowBox[{"a", ",", 
                          "a"}], "}"}]], ")"}]}], "]"}], RowBox[{"2", " ", 
                 "\[Pi]"}]]}], HoldForm], TraditionalForm]], "InlineMath", 
         ScriptLevel -> 0, FontSize -> 14, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 1699798895]}, Open]], 
