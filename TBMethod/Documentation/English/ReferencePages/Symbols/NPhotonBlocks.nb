                    StyleBox["omega", "TI", FontFamily -> "Times", 
                     FontSlant -> "Italic"]}], "}"}], ",", StyleBox["m", 
                 "TI", FontFamily -> "Times", FontSlant -> "Italic"]}], 
              "]"}], "[", RowBox[{StyleBox["finalPoint", "TI", FontFamily -> 
                "Times", FontSlant -> "Italic"], ",", StyleBox[
               "initialPoint", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"]}], "]"}]], "InlineFormula"], " \[LineSeparator]", 
        "uses unit vector-potential amplitude."}], "Usage", 
      CellID -> 788168594], Cell[TextData[{Cell[BoxData[StyleBox["m", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " sets photon indices from ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{"-", "m"}], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], 
        " through ", Cell[BoxData[StyleBox["m", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        "; the photon-space dimension is ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{RowBox[{"2", " ", "m"}], "+", 
              "1"}], HoldForm], TraditionalForm]], "InlineMath", 
         ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], ". ", 
        Cell[BoxData[StyleBox["modulation", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " is a function of a dimensionless angle with period ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{"2", " ", "\[Pi]"}], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], "."}], 
      "Notes", CellID -> 1852611768], 
     Cell[TextData[{"For distinct sites, returns ", 
        Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["fourierModulationMatrix", 
               "TI"], ",", StyleBox["zeroMatrix", "TI"]}], "}"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ". For coincident sites, returns ", 
        Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["identityMatrix", "TI"], 
              ",", RowBox[{StyleBox["fourierModulationMatrix", "TI"], "-", 
                RowBox[{StyleBox["omega", "TI"], " ", RowBox[{ButtonBox[
                     "DiagonalMatrix", BaseStyle -> "Link", ButtonData -> 
                      "paclet:ref/DiagonalMatrix"], "[", RowBox[
                     {ButtonBox["Range", BaseStyle -> "Link", ButtonData -> 
                        "paclet:ref/Range"], "[", RowBox[{RowBox[{"-", 
                          StyleBox["m", "TI"]}], ",", StyleBox["m", "TI"]}], 
                      "]"}], "]"}]}]}]}], "}"}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        ". Coincidence uses a distance threshold of ", 
        Cell[BoxData["0.00001"], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], "."}], "Notes", CellID -> 532591749], 
     Cell[TextData[{"The matrix entry with photon indices ", 
        Cell[BoxData[FormBox[TagBox["p", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], " and ", 
        Cell[BoxData[FormBox[TagBox["q", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], 
        " uses the Fourier coefficient at ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{"q", "-", "p"}], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], 
        ". On nonzero-length bonds the vector-potential forms use ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{"exp", "(", RowBox[{
                "\[ImaginaryI]", " ", "A", " ", RowBox[{RowBox[{"(", 
                    RowBox[{SubscriptBox["r", "f"], "-", SubscriptBox["r", 
                       "i"]}], ")"}], ".", RowBox[{"a", "(", "\[Phi]", 
                    ")"}]}]}], ")"}], HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], ", where ", 
        Cell[BoxData[FormBox[TagBox["A", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], " is ", 
        Cell[BoxData[StyleBox["amplitude", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " and ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{"a", "(", "\[Phi]", ")"}], 
            HoldForm], TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], " is the \
supplied vector potential. Their onsite modulation is zero."}], "Notes", 
      CellID -> 220804949], 
     Cell[TextData[{"The two-element vector-potential form assumes amplitude \
", Cell[BoxData["1"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ". Use ", Cell[BoxData[ButtonBox["PhotonDress", BaseStyle -> "Link", 
           ButtonData -> "paclet:TBMethod/ref/PhotonDress"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " to combine these factors with a bare hopping matrix."}], "Notes", 
      CellID -> 1582315678], 
     Cell[TextData[{"Fourier coefficients are computed by ", 
        Cell[BoxData[ButtonBox["NIntegrate", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/NIntegrate"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], ", using ", 
        Cell[BoxData[RowBox[{ButtonBox["AccuracyGoal", BaseStyle -> "Link", 
             ButtonData -> "paclet:ref/AccuracyGoal"], "\[Rule]", "10"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " and ", 
        Cell[BoxData[RowBox[{ButtonBox["Method", BaseStyle -> "Link", 
             ButtonData -> "paclet:ref/Method"], "\[Rule]", 
            "\"LocalAdaptive\""}]], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], ". Other ", 
        Cell[BoxData[ButtonBox["NIntegrate", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/NIntegrate"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " options are accepted."}], 
      "Notes", CellID -> 510255594]}, Open]], 
