               "TI", FontFamily -> "Times", FontSlant -> "Italic"], ",", 
              StyleBox["initialPoint", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"]}], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", "numerically computes photon-space modulation \
and additive blocks with photon indices from ", 
        Cell[BoxData[RowBox[{"-", "m"}]], "InlineFormula"], " through ", 
        Cell[BoxData[StyleBox["m", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], ".", "\n", 
        Cell["   ", "ModInfo"], Cell[BoxData[
          RowBox[{RowBox[{ButtonBox["NPhotonBlocks", BaseStyle -> "Link", 
               ButtonData -> "paclet:TBMethod/ref/NPhotonBlocks"], "[", 
              RowBox[{RowBox[{"{", RowBox[{StyleBox["amplitude", "TI", 
                     FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                    StyleBox["vectorPotential", "TI", FontFamily -> "Times", 
                     FontSlant -> "Italic"], ",", StyleBox["omega", "TI", 
                     FontFamily -> "Times", FontSlant -> "Italic"]}], "}"}], 
                ",", StyleBox["m", "TI", FontFamily -> "Times", FontSlant -> 
                  "Italic"]}], "]"}], "[", RowBox[{StyleBox["finalPoint", 
               "TI", FontFamily -> "Times", FontSlant -> "Italic"], ",", 
              StyleBox["initialPoint", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"]}], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", "constructs the scalar Peierls modulation from a \
time-dependent vector potential and its amplitude.", "\n", 
        Cell["   ", "ModInfo"], Cell[BoxData[
          RowBox[{RowBox[{ButtonBox["NPhotonBlocks", BaseStyle -> "Link", 
               ButtonData -> "paclet:TBMethod/ref/NPhotonBlocks"], "[", 
              RowBox[{RowBox[{"{", RowBox[{StyleBox["vectorPotential", "TI", 
