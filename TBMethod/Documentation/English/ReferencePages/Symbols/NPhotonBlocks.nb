        Cell[BoxData[RowBox[{RowBox[{ButtonBox["NPhotonBlocks", BaseStyle -> 
                "Link", ButtonData -> "paclet:TBMethod/ref/NPhotonBlocks"], 
              "[", RowBox[{StyleBox["modulation", "TI", FontFamily -> 
