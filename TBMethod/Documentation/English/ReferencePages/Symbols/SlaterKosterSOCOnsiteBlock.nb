  Cell[CellGroupData[{Cell["SlaterKosterSOCOnsiteBlock", "ObjectName", 
      CellID -> 517335683], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{RowBox[{ButtonBox["SlaterKosterSOCOnsiteBlock", 
               BaseStyle -> "Link", ButtonData -> 
                "paclet:TBMethod/ref/SlaterKosterSOCOnsiteBlock"], "[", 
              "\"sp\"", "]"}], "[", RowBox[{"{", StyleBox["lambdaP", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"], "}"}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "constructs the onsite \
spin\[Dash]orbit block in the s\[Dash]p orbital basis.", "\n", 
        Cell["   ", "ModInfo"], Cell[BoxData[
          RowBox[{RowBox[{ButtonBox["SlaterKosterSOCOnsiteBlock", 
               BaseStyle -> "Link", ButtonData -> 
                "paclet:TBMethod/ref/SlaterKosterSOCOnsiteBlock"], "[", 
              "\"spd\"", "]"}], "[", RowBox[{"{", RowBox[{StyleBox["lambdaP", 
                 "TI", FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                StyleBox["lambdaD", "TI", FontFamily -> "Times", FontSlant -> 
                  "Italic"]}], "}"}], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", 
        "uses separate p- and d-orbital spin\[Dash]orbit strengths."}], 
      "Usage", CellID -> 1849515528], 
     Cell[TextData[
       {"Includes two spin components for each orbital, giving dimension ", 
        Cell[BoxData["8"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " for ", Cell[BoxData["\"sp\""], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " and ", Cell[BoxData["18"], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " for ", 
        Cell[BoxData["\"spd\""], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], ". The s-orbital spin block is zero."}], 
      "Notes", CellID -> 1472582740], 
     Cell[TextData[{"The orbital ordering matches ", 
        Cell[BoxData[ButtonBox["SlaterKosterHoppingBlock", 
           BaseStyle -> "Link", ButtonData -> 
            "paclet:TBMethod/ref/SlaterKosterHoppingBlock"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ". Each orbital is followed immediately by its two spin components."}]\
, "Notes", CellID -> 964407041], Cell[TextData[{"The supplied p and d \
coefficients multiply explicit orbital matrices tensored with Pauli spin \
matrices. Choose the coefficients according to this convention when comparing \
with spin matrices written as ", Cell[BoxData[FormBox[
           TagBox[FractionBox[SubscriptBox["\[Sigma]", "a"], "2"], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], ", or ", 
        Cell[BoxData[FractionBox[RowBox[{ButtonBox["PauliMatrix", 
              BaseStyle -> "Link", ButtonData -> "paclet:ref/PauliMatrix"], 
             "[", StyleBox["a", "TI"], "]"}], "2"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " in Wolfram Language syntax."}], 
      "Notes", CellID -> 1148321335]}, Open]], 
