  Cell[CellGroupData[{Cell["SurfaceGreen", "ObjectName", 
      CellID -> 1733857213], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["SurfaceGreen", BaseStyle -> "Link", 
             ButtonData -> "paclet:TBMethod/ref/SurfaceGreen"], "[", 
            RowBox[{StyleBox["z", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", RowBox[{"{", RowBox[{StyleBox["h0", "TI", 
                   FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                  StyleBox["h1", "TI", FontFamily -> "Times", FontSlant -> 
                    "Italic"]}], "}"}], ",", StyleBox["mode", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "computes the surface Green \
matrix of a semi-infinite periodic lead using the specified algorithm.", 
        "\n", Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["SurfaceGreen", BaseStyle -> "Link", 
             ButtonData -> "paclet:TBMethod/ref/SurfaceGreen"], "[", 
            RowBox[{StyleBox["z", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", RowBox[{"{", RowBox[{StyleBox["h0", "TI", 
                   FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                  StyleBox["h1", "TI", FontFamily -> "Times", FontSlant -> 
                    "Italic"], ",", StyleBox["h1upper", "TI", FontFamily -> 
                    "Times", FontSlant -> "Italic"]}], "}"}], ",", 
              StyleBox["mode", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"]}], "]"}]], "InlineFormula"], " \[LineSeparator]", "\
uses an explicit upper interlayer coupling instead of the conjugate transpose \
of ", Cell[BoxData[StyleBox["h1", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], "."}], "Usage", 
      CellID -> 1242366342], 
     Cell[TextData[
       {"For retarded boundary conditions, use a complex energy ", 
        Cell[BoxData[StyleBox["z", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " with ", 
        Cell[BoxData[FormBox[RowBox[{RowBox[{"Im", "(", "z", ")"}], ">", 
             "0"}], TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], "."}], 
      "Notes", CellID -> 521869274], 
     Cell[TextData[{Cell[BoxData[StyleBox["h0", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " is the onsite block, and ", 
        Cell[BoxData[StyleBox["h1", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " couples neighboring principal \
layers. The optional reverse coupling ", 
        Cell[BoxData[StyleBox["h1upper", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " defaults to ", 
        Cell[BoxData[TemplateBox[{StyleBox["h1", "TI"]}, 
           "ConjugateTranspose", SyntaxForm -> SuperscriptBox]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 2099493439], 
     Cell[TextData[{"The ", Cell[BoxData[StyleBox["mode", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " argument is required: ", Cell[BoxData["1"], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " uses iterative decimation; ", 
        Cell[BoxData["2"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " and ", Cell[BoxData["3"], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], " use transfer matrices; ", 
        Cell[BoxData["4"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " and ", Cell[BoxData["5"], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], 
        " regularize the hopping by singular value decomposition."}], 
      "Notes", CellID -> 514891894], 
     Cell[TextData[{"Modes ", Cell[BoxData["2"], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " and ", Cell[BoxData["4"], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " invert a hopping block. Modes ", Cell[BoxData["3"], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " and ", 
        Cell[BoxData["5"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " use a generalized eigenproblem."}], "Notes", CellID -> 132384878], 
     Cell[TextData[{"The string-named option ", 
        Cell[BoxData[RowBox[{"\"\[Delta]SVD\"", "\[Rule]", "1.*^-7"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " sets the relative singular-value floor in modes ", 
        Cell[BoxData["4"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " and ", Cell[BoxData["5"], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], "."}], "Notes", CellID -> 971957590], 
     Cell[TextData[{"With the default Hermitian-conjugate reverse coupling, \
the surface matrix satisfies", "\[LineSeparator]", 
        Cell[BoxData[FormBox[TagBox[RowBox[{RowBox[{SubscriptBox["g", "s"], 
                "(", "z", ")"}], "\[LongEqual]", TemplateBox[{RowBox[
                 {"(", RowBox[{RowBox[{"z", " ", "\[DoubleStruckCapitalI]"}], 
                    "-", SubscriptBox["h", "0"], "-", RowBox[{SubscriptBox[
                       "h", "1"], ".", RowBox[{SubscriptBox["g", "s"], "(", 
                        "z", ")"}], ".", TemplateBox[{RowBox[{"(", 
                          SubscriptBox["h", "1"], ")"}]}, 
                       "ConjugateTranspose", SyntaxForm -> 
                        SuperscriptBox]}]}], ")"}]}, "Inverse", SyntaxForm -> 
                SuperscriptBox]}], HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FontSize -> 14, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 1440010226]}, Open]], 
  Cell[CellGroupData[{Cell["Examples", "PrimaryExamplesSection", 
      CellID -> 1176389718], Cell[TextData[{"Check the analytic surface \
resolvent of a unit-hopping chain at a purely imaginary energy."}], 
