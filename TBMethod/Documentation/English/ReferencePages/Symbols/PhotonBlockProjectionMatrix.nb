         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], 
        ", where ", Cell[BoxData[FormBox[TagBox["N", HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], " is ", 
        Cell[BoxData[RowBox[{ButtonBox["Length", BaseStyle -> "Link", 
             ButtonData -> "paclet:ref/Length"], "[", StyleBox["points", 
             "TI"], "]"}]], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], "."}], "Notes", CellID -> 271465488], 
     Cell[TextData[{"Only ", Cell[BoxData[RowBox[{ButtonBox["Length", 
