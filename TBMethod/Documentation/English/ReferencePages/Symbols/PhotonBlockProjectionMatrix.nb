        " \[LineSeparator]", "constructs the projector onto ", 
        Cell[BoxData[StyleBox["photonIndex", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], 
        " for one internal state per site.", "\n", Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{RowBox[{ButtonBox["PhotonBlockProjectionMatrix", 
               BaseStyle -> "Link", ButtonData -> 
                "paclet:TBMethod/ref/PhotonBlockProjectionMatrix"], "[", 
