                 FontSlant -> "Italic"], ",", StyleBox["m", "TI", 
                 FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                StyleBox["internalDimension", "TI", FontFamily -> "Times", 
                 FontSlant -> "Italic"]}], "]"}], "[", 
            StyleBox["photonIndex", "TI", FontFamily -> "Times", 
             FontSlant -> "Italic"], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", 
        "includes the specified number of internal states per site."}], 
      "Usage", CellID -> 1952031015], 
     Cell[TextData[{Cell[BoxData[StyleBox["m", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " is a nonnegative integer, and ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{RowBox[{"-", "m"}], 
              "\[LessEqual]", "photonIndex", "\[LessEqual]", "m"}], 
            HoldForm], TraditionalForm]], "InlineMath", ScriptLevel -> 0, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}], 
        ". The internal dimension defaults to ", Cell[BoxData["1"], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 1050859725], Cell[TextData[{"Returns the site/internal \
identity tensored with the single-sector photon projector. Its total matrix \
