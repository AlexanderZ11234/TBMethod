  Cell[CellGroupData[{Cell["BottIndex", "ObjectName", CellID -> 509630691], 
     Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{RowBox[{ButtonBox["BottIndex", BaseStyle -> 
                "Link", ButtonData -> "paclet:TBMethod/ref/BottIndex"], "[", 
              RowBox[{StyleBox["unitBasis", "TI", FontFamily -> "Times", 
                 FontSlant -> "Italic"], ",", StyleBox["points", "TI", 
                 FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                StyleBox["chiralOperator", "TI", FontFamily -> "Times", 
                 FontSlant -> "Italic"], ",", StyleBox["generator", "TI", 
                 FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}], "[", 
            StyleBox["hamiltonian", "TI", FontFamily -> "Times", 
             FontSlant -> "Italic"], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", "computes the chiral real-space Bott expression \
for the supplied coordinate-dependent ", 
        Cell[BoxData[StyleBox["generator", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], ".", "\n", 
        Cell["   ", "ModInfo"], Cell[BoxData[
          RowBox[{RowBox[{ButtonBox["BottIndex", BaseStyle -> "Link", 
               ButtonData -> "paclet:TBMethod/ref/BottIndex"], "[", 
              RowBox[{StyleBox["unitBasis", "TI", FontFamily -> "Times", 
                 FontSlant -> "Italic"], ",", StyleBox["points", "TI", 
                 FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                StyleBox["chiralOperator", "TI", FontFamily -> "Times", 
                 FontSlant -> "Italic"], ",", RowBox[{"{", RowBox[
                   {StyleBox["generator1", "TI", FontFamily -> "Times", 
                     FontSlant -> "Italic"], ",", StyleBox["generator2", 
                     "TI", FontFamily -> "Times", FontSlant -> "Italic"]}], 
                  "}"}]}], "]"}], "[", StyleBox["hamiltonian", "TI", 
             FontFamily -> "Times", FontSlant -> "Italic"], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "computes the corresponding \
expression separately for each generator."}], "Usage", CellID -> 881107262], 
     Cell[TextData[
       {
        "The curried setup converts each point to lattice coordinates using "\
, Cell[BoxData[RowBox[{ButtonBox["LinearSolve", BaseStyle -> "Link", 
             ButtonData -> "paclet:ref/LinearSolve"], "[", 
            RowBox[{TemplateBox[{StyleBox["unitBasis", "TI"]}, "Transpose", 
               SyntaxForm -> SuperscriptBox], ",", StyleBox["point", "TI"]}], 
            "]"}]], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ". The coordinate-dependent ", Cell[BoxData[StyleBox["generator", 
           "TI"]], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " must return a matrix."}], "Notes", CellID -> 964787833], 
     Cell[TextData[
       {"The Hamiltonian is transformed to the sorted eigenbasis of ", 
        Cell[BoxData[StyleBox["chiralOperator", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        ". The extracted square off-diagonal block has dimension ", 
        Cell[BoxData[RowBox[{"2", " ", RowBox[{ButtonBox["Length", 
               BaseStyle -> "Link", ButtonData -> "paclet:ref/Length"], "[", 
              StyleBox["points", "TI"], "]"}]}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        ", so the intended full Hamiltonian dimension is ", 
        Cell[BoxData[RowBox[{"4", " ", RowBox[{ButtonBox["Length", 
               BaseStyle -> "Link", ButtonData -> "paclet:ref/Length"], "[", 
              StyleBox["points", "TI"], "]"}]}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 584931601], 
     Cell[TextData[{"A ", Cell[BoxData[ButtonBox[
           "SingularValueDecomposition", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/SingularValueDecomposition"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " of this block \
supplies its unitary polar factor. The coordinate unitary is assembled from \
block-diagonal matrices of ", Cell[BoxData[RowBox[{ButtonBox["MatrixExp", 
             BaseStyle -> "Link", ButtonData -> "paclet:ref/MatrixExp"], "[", 
            RowBox[{"2", " ", StyleBox["\[Pi]", "TI"], " ", "\[ImaginaryI]", 
              " ", RowBox[{StyleBox["generator", "TI"], "[", StyleBox[
                 "coord", "TI"], "]"}]}], "]"}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 1662175858], 
     Cell[TextData[
       {"A list of generators returns one value per generator and uses ", 
        Cell[BoxData[ButtonBox["ParallelTable", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/ParallelTable"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " to construct the coordinate blocks."}], "Notes", 
      CellID -> 1276499139], Cell[TextData[{"The single-generator example \
uses a gapped trivial chiral model and runs serially. A physical invariant \
requires compatible chiral sectors, generator dimensions, boundary \
conditions, and a nonsingular relevant block."}], "Notes", 
      CellID -> 343227520], 
     Cell[TextData[{"For the polar-unitary off-diagonal block ", 
        Cell[BoxData[FormBox[TagBox["Q", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], " and the position unitary ", 
        Cell[BoxData[FormBox[TagBox["M", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], 
        ", the implemented expression is", "\[LineSeparator]", 
        Cell[BoxData[FormBox[TagBox[RowBox[{"B", "\[LongEqual]", 
              FractionBox[RowBox[{"Tr", "[", RowBox[{"MatrixLog", "[", 
                   RowBox[{"M", ".", "Q", ".", TemplateBox[{"M"}, 
                      "ConjugateTranspose", SyntaxForm -> SuperscriptBox], 
                     ".", TemplateBox[{"Q"}, "ConjugateTranspose", 
                      SyntaxForm -> SuperscriptBox]}], "]"}], "]"}], RowBox[
                {"2", " ", "\[Pi]", " ", "\[ImaginaryI]"}]]}], HoldForm], 
           TraditionalForm]], "InlineMath", ScriptLevel -> 0, FontSize -> 14, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 1710664003]}, Open]], 
