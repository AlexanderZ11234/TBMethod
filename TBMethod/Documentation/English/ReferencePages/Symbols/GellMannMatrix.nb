      CellID -> 701993898], Cell[TextData[{Cell[BoxData[StyleBox["i", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " is an integer from ", Cell[BoxData["0"], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " through ", 
        Cell[BoxData["8"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ". Index ", Cell[BoxData["0"], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " returns the 3 by 3 identity; indices ", Cell[BoxData["1"], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " through ", 
        Cell[BoxData["8"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " return the conventional traceless generators."}], "Notes", 
      CellID -> 413058611], Cell[TextData[{"The function has attribute ", 
        Cell[BoxData[ButtonBox["Listable", BaseStyle -> "Link", 
