              "\[LessEqual]", "8"}], HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], ", the normalization is ", 
        Cell[BoxData[FormBox[TagBox[RowBox[{RowBox[{"Tr", "[", 
                RowBox[{SubscriptBox["\[Lambda]", "i"], ".", SubscriptBox[
                   "\[Lambda]", "j"]}], "]"}], "\[LongEqual]", 
