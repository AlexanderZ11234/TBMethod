  Cell[CellGroupData[{Cell["CentralGreen", "ObjectName", 
      CellID -> 405811856], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["CentralGreen", BaseStyle -> "Link", 
             ButtonData -> "paclet:TBMethod/ref/CentralGreen"], "[", 
            RowBox[{StyleBox["z", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", StyleBox["h", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["sigmas", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "computes the full Green \
matrix of the finite device with Hamiltonian ", 
        Cell[BoxData[StyleBox["h", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], 
        " and contact self-energies ", Cell[BoxData[StyleBox["sigmas", "TI", 
           FontFamily -> "Times", FontSlant -> "Italic"]], "InlineFormula"], 
        ".", "\n", Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["CentralGreen", BaseStyle -> "Link", 
             ButtonData -> "paclet:TBMethod/ref/CentralGreen"], "[", 
            RowBox[{StyleBox["z", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", StyleBox["h", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["sigmas", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"], ",", 
              StyleBox["method", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"]}], "]"}]], "InlineFormula"], " \[LineSeparator]", 
        "uses the specified matrix-inversion method."}], "Usage", 
      CellID -> 1364984597], Cell[TextData[{"All contact self-energy matrices \
must be embedded in the same full device basis as ", 
        Cell[BoxData[StyleBox["h", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 1525942347], Cell[TextData[{"The default ", 
        Cell[BoxData[StyleBox["method", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " is ", Cell[BoxData["1"], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], ", which uses ", 
        Cell[BoxData[ButtonBox["LinearSolve", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/LinearSolve"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " with ", 
        Cell[BoxData[RowBox[{ButtonBox["Method", BaseStyle -> "Link", 
             ButtonData -> "paclet:ref/Method"], "\[Rule]", 
            "\"Multifrontal\""}]], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], "."}], "Notes", CellID -> 610096078], 
     Cell[TextData[{Cell[BoxData[StyleBox["method", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " can also be ", 
        Cell[BoxData["2"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ", which invokes a QR-based helper. The basic example checks ", 
        Cell[BoxData[RowBox[{StyleBox["method", "TI"], "=", "1"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 880966984], Cell[TextData[{"The full device resolvent is", 
        "\[LineSeparator]", Cell[BoxData[FormBox[
           TagBox[RowBox[{RowBox[{SubscriptBox["G", "C"], "(", "z", ")"}], 
              "\[LongEqual]", TemplateBox[{RowBox[{"(", RowBox[
                   {RowBox[{"z", " ", "\[DoubleStruckCapitalI]"}], "-", 
                    SubscriptBox["H", "C"], "-", RowBox[{UnderoverscriptBox[
                       "\[Sum]", RowBox[{"p", "=", "1"}], SubscriptBox["N", 
                        "L"]], RowBox[{SubscriptBox["\[CapitalSigma]", "p"], 
                        "(", "z", ")"}]}]}], ")"}]}, "Inverse", SyntaxForm -> 
                SuperscriptBox]}], HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FontSize -> 14, 
         FractionBoxOptions -> {BaseStyle -> {ScriptLevel -> 0}}]}], "Notes", 
      CellID -> 1078576532]}, Open]], 
