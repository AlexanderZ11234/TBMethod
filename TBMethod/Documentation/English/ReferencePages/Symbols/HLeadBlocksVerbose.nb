  Cell[CellGroupData[{Cell["HLeadBlocksVerbose", "ObjectName", 
      CellID -> 934006428], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["HLeadBlocksVerbose", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/HLeadBlocksVerbose"], "[", 
            RowBox[{StyleBox["layers", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["hopping", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"], ",", 
              StyleBox["distance", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", RowBox[{"{", RowBox[{StyleBox["leadCell0", 
                   "TI", FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                  StyleBox["leadCell1", "TI", FontFamily -> "Times", 
                   FontSlant -> "Italic"]}], "}"}], ",", StyleBox["leadName", 
               "TI", FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "constructs a lead onsite \
block, intercell hopping block, and coupling from the lead to the scattering \
region."}], "Usage", CellID -> 1702860382], 
     Cell[TextData[{"The result is ", 
        Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["h0", "TI"], ",", 
              StyleBox["h1", "TI"], ",", StyleBox["v", "TI"]}], "}"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], ". ", 
        Cell[BoxData[StyleBox["h0", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " has rows and columns in ", 
        Cell[BoxData[StyleBox["leadCell0", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], "; ", 
        Cell[BoxData[StyleBox["h1", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " has rows in ", 
        Cell[BoxData[StyleBox["leadCell0", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " and columns in ", 
        Cell[BoxData[StyleBox["leadCell1", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], "; ", 
        Cell[BoxData[StyleBox["v", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " has rows in the last scattering-region layer and columns in ", 
        Cell[BoxData[StyleBox["leadCell0", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 1075062458], 
     Cell[TextData[{"The scattering-region layers form an ordered ", 
        Cell[BoxData[ButtonBox["Association", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Association"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], ". Its last layer is the \
lead-contact layer. The underlying hopping cutoff must have head ", 
        Cell[BoxData[ButtonBox["Real", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Real"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 1285025454], 
     Cell[TextData[
       {"Requires at least two scattering-region layers. Checks that ", 
        Cell[BoxData[StyleBox["leadCell0", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " does not couple to the penultimate layer and ", 
        Cell[BoxData[StyleBox["leadCell1", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " does not couple to the last layer. Diagnostic messages include ", 
        Cell[BoxData[StyleBox["leadName", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 1447032686]}, Open]], 
  Cell[CellGroupData[{Cell["Examples", "PrimaryExamplesSection", 
