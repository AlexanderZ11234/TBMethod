        Cell[BoxData[RowBox[{ButtonBox["ParallelEigenspectralData", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/ParallelEigenspectralData"], "[", 
            RowBox[{StyleBox["h", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", StyleBox["samples", "TI", FontFamily -> 
                "Times", FontSlant -> "Italic"], ",", StyleBox[
               "stateFunction", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"]}], "]"}]], "InlineFormula"], " \[LineSeparator]", 
        "replaces each eigenvector by the value of ", 
        Cell[BoxData[StyleBox["stateFunction", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], " applied to it.", 
        "\n", Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["ParallelEigenspectralData", 
