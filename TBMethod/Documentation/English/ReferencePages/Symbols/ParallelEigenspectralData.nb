         "InlineFormula"], " before applying ", 
        Cell[BoxData[StyleBox["stateFunction", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], "."}], "Usage", 
      CellID -> 2072724042], 
     Cell[TextData[{"Returns the same sample-by-sample list of ", 
        Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["energy", "TI"], ",", 
              RowBox[{StyleBox["stateFunction", "TI"], "[", StyleBox[
                 "eigenvector", "TI"], "]"}]}], "}"}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " pairs as ", 
        Cell[BoxData[ButtonBox["EigenspectralData", BaseStyle -> "Link", 
           ButtonData -> "paclet:TBMethod/ref/EigenspectralData"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], ", using ", 
        Cell[BoxData[ButtonBox["ParallelMap", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/ParallelMap"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " over the samples."}], "Notes", 
      CellID -> 344848874], Cell[TextData[{"The default ", 
        Cell[BoxData[StyleBox["stateFunction", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " is ", 
        Cell[BoxData[ButtonBox["Identity", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Identity"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], ". Supply it explicitly before ", 
        Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " when selecting a subset of eigenpairs."}], "Notes", 
      CellID -> 614821458], Cell[TextData[{"Load TBMethod on subkernels and \
