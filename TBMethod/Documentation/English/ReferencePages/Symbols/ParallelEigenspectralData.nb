        " \[LineSeparator]", "retains the ", 
        Cell[BoxData[StyleBox["n", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], 
        " eigenpairs selected by ", Cell[BoxData[ButtonBox["Eigensystem", 
