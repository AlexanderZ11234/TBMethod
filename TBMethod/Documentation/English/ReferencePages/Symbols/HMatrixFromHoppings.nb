  Cell[CellGroupData[{Cell["HMatrixFromHoppings", "ObjectName", 
      CellID -> 1186834649], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["HMatrixFromHoppings", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/HMatrixFromHoppings"], "[", 
            RowBox[{RowBox[{"{", RowBox[{StyleBox["finalPoints", "TI", 
                   FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                  StyleBox["initialPoints", "TI", FontFamily -> "Times", 
                   FontSlant -> "Italic"]}], "}"}], ",", StyleBox["hopping", 
               "TI", FontFamily -> "Times", FontSlant -> "Italic"], ",", 
              StyleBox["distance", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"]}], "]"}]], "InlineFormula"], " \[LineSeparator]", "\
constructs a real-space tight-binding Hamiltonian block from a hopping \
function and two point sets."}], "Usage", CellID -> 1148010228], 
     Cell[TextData[{"Rows refer to ", Cell[BoxData[StyleBox["finalPoints", 
           "TI"]], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " and columns to ", Cell[BoxData[StyleBox["initialPoints", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], ". ", 
        Cell[BoxData[RowBox[{StyleBox["hopping", "TI"], "[", 
            RowBox[{StyleBox["rf", "TI"], ",", StyleBox["ri", "TI"]}], 
            "]"}]], "InlineFormula", FontFamily -> "Source Sans Pro"], " must \
return a consistently sized matrix for the internal degrees of freedom."}], 
      "Notes", CellID -> 1583177457], 
     Cell[TextData[{"The ", Cell[BoxData[StyleBox["distance", "TI"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " argument must have head ", Cell[BoxData[ButtonBox["Real", 
           BaseStyle -> "Link", ButtonData -> "paclet:ref/Real"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], ", for example ", 
        Cell[BoxData["1.01"], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], " rather than the exact integer ", 
        Cell[BoxData["1"], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ". Only pairs within this Euclidean cutoff are evaluated."}], 
      "Notes", CellID -> 922591677], 
     Cell[TextData[
       {"Point sets may contain coordinate lists or rules of the form ", 
        Cell[BoxData[RowBox[{StyleBox["label", "TI"], "\[Rule]", 
            StyleBox["coordinates", "TI"]}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], ". Labels are passed to the \
hopping function when present. Point sets must be nonempty."}], "Notes", 
      CellID -> 2008333616], 
     Cell[TextData[{"For unlabeled sites, the site-to-site matrix block is", 
