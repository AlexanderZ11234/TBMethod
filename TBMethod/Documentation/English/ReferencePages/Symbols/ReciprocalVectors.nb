     Cell[TextData[{Cell[BoxData[StyleBox["basis", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " is a nonsingular matrix with dimensions ", 
        Cell[BoxData[RowBox[{"{", RowBox[{"2", ",", "2"}], "}"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " or ", 
        Cell[BoxData[RowBox[{"{", RowBox[{"3", ",", "3"}], "}"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        "; its rows are real-space lattice vectors."}], "Notes", 
      CellID -> 582207367], Cell[TextData[{"The output uses the same \
row-vector convention. Matching and distinct basis vectors satisfy the \
duality relation below."}], "Notes", CellID -> 133085853], 
     Cell[TextData[{"The two-dimensional implementation embeds the basis in \
three dimensions and removes the auxiliary direction."}], "Notes", 
      CellID -> 851042939], 
     Cell[TextData[{"Writing the input and output basis vectors as rows of ", 
        Cell[BoxData[FormBox[TagBox["A", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], " and ", 
        Cell[BoxData[FormBox[TagBox["B", HoldForm], TraditionalForm]], 
         "InlineMath", ScriptLevel -> 0, FractionBoxOptions -> 
          {BaseStyle -> {ScriptLevel -> 0}}], ", respectively,", 
        "\[LineSeparator]", Cell[BoxData[FormBox[
           TagBox[RowBox[{RowBox[{"A", ".", TemplateBox[{"B"}, "Transpose", 
                 SyntaxForm -> SuperscriptBox]}], "\[LongEqual]", 
