  Cell[CellGroupData[{Cell["PlaquetteRegionPartitionComplex", "ObjectName", 
      CellID -> 1817587500], Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{ButtonBox["PlaquetteRegionPartitionComplex", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:TBMethod/ref/PlaquetteRegionPartitionComplex"], "[", 
            StyleBox["region", "TI", FontFamily -> "Times", 
             FontSlant -> "Italic"], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", "triangulates a region and returns mesh \
coordinates and plaquette selectors for Wilson-loop calculations."}], 
      "Usage", CellID -> 1815744568], 
     Cell[TextData[{"Calls ", Cell[BoxData[ButtonBox["TriangulateMesh", 
           BaseStyle -> "Link", ButtonData -> "paclet:ref/TriangulateMesh"]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], " and returns ", 
        Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{ButtonBox[
                 "MeshCoordinates", BaseStyle -> "Link", ButtonData -> 
                  "paclet:ref/MeshCoordinates"], "[", StyleBox["mesh", "TI"], 
                "]"}], ",", StyleBox["plaquettePositions", "TI"]}], "}"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        ", with cells converted to selectors suitable for ", 
        Cell[BoxData[ButtonBox["Extract", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Extract"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " in ", 
        Cell[BoxData[ButtonBox["ChernNumberByWilsonLoop", 
           BaseStyle -> "Link", ButtonData -> 
            "paclet:TBMethod/ref/ChernNumberByWilsonLoop"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 1898939382], Cell[TextData[{"For a two-dimensional triangular \
mesh, a plaquette with coordinate indices ", 
        Cell[BoxData[StyleBox["i", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], ", ", 
        Cell[BoxData[StyleBox["j", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], ", and ", 
        Cell[BoxData[StyleBox["k", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " is represented as ", 
        Cell[BoxData[RowBox[{"{", RowBox[{"{", RowBox[{StyleBox["i", "TI"], 
                ",", StyleBox["j", "TI"], ",", StyleBox["k", "TI"]}], "}"}], 
            "}"}]], "InlineFormula", FontFamily -> "Source Sans Pro"], "."}], 
      "Notes", CellID -> 1013052754], 
     Cell[TextData[{"The supplied default is ", 
        Cell[BoxData[RowBox[{ButtonBox["MaxCellMeasure", BaseStyle -> "Link", 
             ButtonData -> "paclet:ref/MaxCellMeasure"], "\[Rule]", 
            RowBox[{"{", RowBox[{StyleBox["d", "TI"], "\[Rule]", 
                RowBox[{RowBox[{ButtonBox["RegionMeasure", BaseStyle -> 
                      "Link", ButtonData -> "paclet:ref/RegionMeasure"], "[", 
                    StyleBox["region", "TI"], "]"}], " ", SuperscriptBox[
                   "0.1", StyleBox["d", "TI"]]}]}], "}"}]}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], ", where ", 
        Cell[BoxData[RowBox[{StyleBox["d", "TI"], "=", 
            RowBox[{ButtonBox["RegionDimension", BaseStyle -> "Link", 
               ButtonData -> "paclet:ref/RegionDimension"], "[", 
              StyleBox["region", "TI"], "]"}]}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], ". Options for ", 
        Cell[BoxData[ButtonBox["TriangulateMesh", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/TriangulateMesh"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " are accepted, with ", 
        Cell[BoxData[RowBox[{ButtonBox["Method", BaseStyle -> "Link", 
             ButtonData -> "paclet:ref/Method"], "\[Rule]", 
            "\"ConstrainedQuality\""}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " supplied internally."}], 
      "Notes", CellID -> 1436380143], 
     Cell[TextData[{"The function also uses ", 
        Cell[BoxData[ButtonBox["Echo", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Echo"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " to display a mesh visualization \
labelled with vertex and plaquette counts. Its one-dimensional branch \
combines all cell indices into a single selector."}], "Notes", 
      CellID -> 1775091455]}, Open]], 
