  Cell[CellGroupData[{Cell["AdatomLabel", "ObjectName", CellID -> 833588900], 
     Cell[TextData[{Cell["   ", "ModInfo"], 
        Cell[BoxData[RowBox[{RowBox[{ButtonBox["AdatomLabel", BaseStyle -> 
                "Link", ButtonData -> "paclet:TBMethod/ref/AdatomLabel"], 
              "[", RowBox[{StyleBox["latticeVectors", "TI", FontFamily -> 
                  "Times", FontSlant -> "Italic"], ",", StyleBox["distance", 
                 "TI", FontFamily -> "Times", FontSlant -> "Italic"]}], 
              "]"}], "[", RowBox[{StyleBox["points", "TI", FontFamily -> 
                "Times", FontSlant -> "Italic"], ",", StyleBox[
               "adatomPositions", "TI", FontFamily -> "Times", FontSlant -> 
                "Italic"], ",", StyleBox["selectedIndices", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"]}], "]"}]], 
         "InlineFormula"], " \[LineSeparator]", "labels the selected sites \
according to whether an adatom lies within ", 
        Cell[BoxData[StyleBox["distance", "TI", FontFamily -> "Times", 
           FontSlant -> "Italic"]], "InlineFormula"], 
        ", using periodic boundary conditions.", "\n", 
        Cell["   ", "ModInfo"], Cell[BoxData[
          RowBox[{RowBox[{ButtonBox["AdatomLabel", BaseStyle -> "Link", 
               ButtonData -> "paclet:TBMethod/ref/AdatomLabel"], "[", 
              RowBox[{StyleBox["latticeVectors", "TI", FontFamily -> "Times", 
                 FontSlant -> "Italic"], ",", StyleBox["distance", "TI", 
                 FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                RowBox[{"{", RowBox[{StyleBox["affectedLabel", "TI", 
                     FontFamily -> "Times", FontSlant -> "Italic"], ",", 
                    StyleBox["otherLabel", "TI", FontFamily -> "Times", 
                     FontSlant -> "Italic"]}], "}"}], ",", StyleBox[
                 "boundaryCondition", "TI", FontFamily -> "Times", 
                 FontSlant -> "Italic"]}], "]"}], "[", 
            RowBox[{StyleBox["points", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"], ",", StyleBox["adatomPositions", "TI", 
               FontFamily -> "Times", FontSlant -> "Italic"], ",", 
              StyleBox["selectedIndices", "TI", FontFamily -> "Times", 
               FontSlant -> "Italic"]}], "]"}]], "InlineFormula"], 
        " \[LineSeparator]", "uses the specified two labels and periodic or \
open boundary conditions."}], "Usage", CellID -> 1234521098], 
     Cell[TextData[{"The real-valued ", Cell[BoxData[StyleBox["distance", 
           "TI"]], "InlineFormula", FontFamily -> "Source Sans Pro"], 
        " is the site-to-adatom search radius. ", 
        Cell[BoxData[StyleBox["selectedIndices", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], 
        " is an integer or a list of integers indexing ", 
        Cell[BoxData[StyleBox["adatomPositions", "TI"]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], "."}], "Notes", 
      CellID -> 518426637], Cell[TextData[{"The default labels are ", 
        Cell[BoxData[RowBox[{"{", RowBox[{"1", ",", "0"}], "}"}]], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], 
        "; the default boundary condition is ", Cell[BoxData["\"PBC\""], 
         "InlineFormula", FontFamily -> "Source Sans Pro"], ". The value ", 
        Cell[BoxData["\"OBC\""], "InlineFormula", FontFamily -> 
          "Source Sans Pro"], " selects ordinary Euclidean matching of \
reference adatom positions."}], "Notes", CellID -> 1677790818], 
     Cell[TextData[{"For ", Cell[BoxData["\"PBC\""], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], ", reference-adatom equivalence \
uses fractional coordinates modulo lattice translations. Site neighborhoods \
are then found by a coordinate nearest-neighbor search."}], "Notes", 
      CellID -> 136601759], 
     Cell[TextData[{"For unlabeled points, returns a list of ", 
        Cell[BoxData[RowBox[{StyleBox["label", "TI"], "\[Rule]", 
            StyleBox["coordinates", "TI"]}]], "InlineFormula", 
         FontFamily -> "Source Sans Pro"], " rules. For existing rule labels, \
appends the new label to the existing label information."}], "Notes", 
      CellID -> 1498294465]}, Open]], 
